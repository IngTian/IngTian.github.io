{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // UNUSED CODE IS A GATE'S JOB, NOT A REVIEWER'S. `astro/tsconfigs/strict` does not turn these two on;
    // Astro's `strictest` would, with `noUncheckedIndexedAccess` and `exactOptionalPropertyTypes`, each a
    // real refactor of src/lib, so the two cheap flags are taken alone. PER FILE ONLY: an export no module
    // imports is a public API to the compiler, so dead exports still need a grep (CLAUDE.md: a test is not
    // a consumer). A leading underscore exempts a parameter: rename to `_x` rather than suppress.
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    // AD-HOC SCRATCH PROBES ARE NOT THE PROJECT: the verification loop's throwaway tmp_* files and .tmp-*
    // directories are half-written by design, and a gate whose output is their noise gets ignored.
    "tmp_*",
    ".tmp-*"
  ]
  // No "jsx"/"jsxImportSource" override: there is no island, so Astro's base defaults apply.
}
