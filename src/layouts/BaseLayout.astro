---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import CornerNav from '../components/CornerNav.astro';
import { name, roles, links } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Line shown on the descent veil for this page. */
  veilLine?: string;
  /** Play the veil on a FRESH load of this page? (Transitions always play it.) */
  veilOnLoad?: boolean;
  /**
   * How the corner nav picks its (light-theme) text color:
   *  - 'scroll' (default): flip dark→paper by the descent fraction behind it
   *    (home & /art ride the full dawn→night gradient).
   *  - 'light': pin to dark text — for pages that stay pale top-to-bottom in
   *    light theme (/research is a reading page and never sinks to dark).
   * In DARK theme the text is always light regardless, so this only matters
   * for the light theme.
   */
  navZone?: 'scroll' | 'light';
  /** Set on non-content routes (404): emit robots=noindex and skip canonical. */
  noindex?: boolean;
  /**
   * Does THIS page actually render text in the accent face (Fraunces)? If it
   * does, say so and the two Fraunces files get `rel=preload`. See the long
   * note next to <Font> below for why this is a per-page decision rather than
   * a global one — and why the answer is not "just drop the preload".
   */
  preloadAccent?: boolean;
}

const {
  title = 'Ing Tian — Quant Researcher · Portfolio Optimization',
  description = 'Ing Tian (Zeying Tian) — quant researcher in portfolio optimization and incoming Operations Research PhD at the University of Toronto. Also a full-stack software and ML engineer. Toronto.',
  veilLine = 'a researcher by day',
  veilOnLoad = false,
  navZone = 'scroll',
  noindex = false,
  preloadAccent = false,
} = Astro.props;

// Per-page canonical + og:url. Astro.site is 'https://ingtian.github.io';
// resolve the current path against it so each route advertises its OWN URL
// (previously every page hardcoded the homepage — wrong for /research, /art,
// /projects social shares + canonicalization). new URL(...).href normalizes
// the trailing slash for us. The 404 route skips canonical (it's noindex).
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// JSON-LD Person — the one structured-data type a personal portfolio benefits
// from, built from the résumé data so it never drifts from the visible content.
// Emitted once per page (it describes the person, not the page). links[] carries
// the profile URLs used for sameAs.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: `${name.first} ${name.last}`,
  url: Astro.site?.href,
  jobTitle: roles,
  sameAs: [
    links.find((l) => l.label === 'GitHub')?.href,
    links.find((l) => l.label === 'LinkedIn')?.href,
  ].filter((h): h is string => Boolean(h)),
  alumniOf: 'McGill University',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Theme init — runs synchronously BEFORE first paint so there's no flash of
        the wrong theme. Resolves: explicit saved choice (localStorage) first,
        else the visitor's OS preference (prefers-color-scheme). Only 'dark' sets
        the attribute; light is the default (no attribute).

        Also re-applies on astro:after-swap: View Transitions replace <html> with
        the incoming page's markup (which has NO data-theme — it's runtime-set),
        so without this the theme would reset to light on every navigation. The
        listener fires before the new page paints, so there's no flash. The
        toggle in the corner nav writes localStorage and flips the attribute
        live; this keeps it stuck across page changes. */}
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var saved = localStorage.getItem('theme'); // 'dark' | 'light' | null
            var dark = saved ? saved === 'dark'
                             : matchMedia('(prefers-color-scheme: dark)').matches;
            if (dark) document.documentElement.dataset.theme = 'dark';
            else document.documentElement.removeAttribute('data-theme');
          } catch (e) {}
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    {/* Favicons. SVG for crisp browser tabs; PNG fallbacks because Google Search
        renders a RASTER favicon (it does not use the SVG) — the 48px is its
        baseline, the 192/512 cover higher-DPI surfaces and PWA installs. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://ingtian.github.io/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ing Tian — Quant Researcher · Portfolio Optimization" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://ingtian.github.io/og-card.png" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    {/* --ff-* are astro:fonts' own variables, deliberately NOT the site's --font-display/-body/-mono
        role tokens — pointing them at the same names meant our stylesheet overrode astro:fonts and no
        webfont rendered anywhere. See the long note in astro.config.mjs. The role tokens are built
        from these in global.css's @theme. */}
    {/* TWO FAMILIES: Inter is gone and the body face is the system UI stack, so there is nothing to load for
        it. Both remaining faces are LOCAL files (see astro.config.mjs), so these emit @font-face rules and
        preload hints for files Astro copies out of src/ rather than anything fetched at build time.

        FRAUNCES' PRELOAD IS PER PAGE, and both halves of that are load-bearing.

        Do NOT simply delete it. It looked obviously droppable once Fraunces became the accent face rather than
        the display face — nothing above the fold waits for it. But a page that USES it downloads the file
        either way, and without the preload it is discovered late in the critical chain: measured three times
        on a production build, FCP went 1956ms -> 2333ms for identical bytes. Late and unannounced is worse
        than early and announced.

        But it does not belong on every page either, which is what it used to do. `grep -rn -- --font-accent src`
        finds exactly three consuming FILES — sections/Work.astro (so the homepage), research.astro and
        writing/[...slug].astro — plus the token's own definition in global.css and this comment.

        THE DOUBLE DASH IN THAT COMMAND IS NOT PEDANTRY, and it is why the token is spelled `--font-accent` —
        with its leading dashes — everywhere in this comment. Tailwind v4's scanner harvests utility candidates
        from source text WITHOUT parsing it, so it cannot tell a comment from markup: an earlier version of this
        line spelled the pattern without the dashes, and that one token made Tailwind emit the corresponding
        font-family utility (the token's name minus the dashes, set to `var(--font-accent)`) into the shared
        stylesheet on all nine pages — a class no element anywhere carried, 0 files matching it in dist. 44 bytes
        of dead CSS on every page, generated by a comment about not shipping bytes nobody needs. Proved both
        ways: putting the dashless token back reproduces both the rule and the stylesheet's content hash, and the
        double-dash form restores byte-identical output. So when a comment here needs to name a utility class,
        write the CSS variable with its dashes or describe it — never the bare class name. The other six routes — /writing, /projects, /experience, /art, /404 and
        the proto pages — were fetching 82,184 bytes (36,560 + 45,624: the roman and the italic) at the
        HIGHEST priority, ahead of their own content, for a face no rule on them ever asks for. A preload for
        an unused resource is worse than no preload: it is bandwidth spent competing with the bytes that do
        get painted.

        The @font-face rules themselves are NOT gated — <Font> always emits data.css, so --ff-fraunces stays
        resolvable everywhere and any page that later grows an accent rule still renders it (just discovered
        normally). Only the <link rel=preload> tags are conditional. Verified from dist: the three opted-in
        routes carry two preload links each, the other six carry zero, and all nine still carry the Fraunces
        @font-face block. */}
    <Font cssVariable="--ff-fraunces" preload={preloadAccent} />
    <Font cssVariable="--ff-jetbrains" />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {/* Persistent top-right nav + theme toggle — global (all pages), so contact
        actions and the light/dark switch are always reachable. Rendered here
        (not per-page) means it survives View Transitions as part of the shell.
        navZone tells it how to pick light-theme text color per page. */}
    <CornerNav navZone={navZone} />
    {/* "The Descent" loader: a night veil covering the page wipes DOWNWARD off
        the bottom to reveal it. It plays on every home<->/art navigation, and on
        a fresh load only when this page opts in (veilOnLoad) — so entering the
        home page directly shows no veil, but the gallery (and all transitions)
        do. Each page carries its own line. transform/opacity only; gated behind
        prefers-reduced-motion (finished state = uncovered page). */}
    <div
      class="descent-veil"
      aria-hidden="true"
      data-veil
      data-veil-on-load={veilOnLoad ? 'true' : 'false'}
    >
      <span class="descent-veil__line">{veilLine}</span>
    </div>
  </body>
</html>

<style is:global>
  .descent-veil {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #1d1b16, #16140f);
    /* default: parked off the bottom — so with no JS / reduced-motion the page
       is simply shown, never covered. .is-playing covers then wipes down. */
    transform: translateY(100%);
  }
  .descent-veil__line {
    font-family: var(--font-display), Georgia, serif;
    font-style: italic;
    font-size: clamp(18px, 3vw, 26px);
    color: rgba(239, 233, 221, 0.5);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* is-playing forces the covering state statically (flash-free even before
       the first animation frame), then the wipe animation drives it DOWN off
       the bottom; fill-mode forwards holds it cleared. */
    .descent-veil.is-playing {
      transform: translateY(0);
      animation: descent-veil-wipe 1.1s cubic-bezier(0.7, 0, 0.2, 1) forwards;
    }
    .descent-veil.is-playing .descent-veil__line {
      animation: descent-veil-fade 0.55s ease forwards;
    }
    @keyframes descent-veil-wipe {
      from { transform: translateY(0); }
      to   { transform: translateY(100%); }
    }
    @keyframes descent-veil-fade {
      from { opacity: 0.5; }
      to   { opacity: 0; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .descent-veil { display: none; }
  }
</style>

<script is:inline>
  // Synchronous (parses before first paint) so a fresh opted-in load covers
  // with NO flash. `__descentVeilInit` (on window, which survives view
  // transitions) tells a fresh load apart from a transition re-run, so this and
  // the after-swap listener below never double-fire.
  (function () {
    function play() {
      var v = document.querySelector('[data-veil]');
      if (!v) return;
      v.classList.remove('is-playing');
      void v.offsetWidth; // restart the animation
      v.classList.add('is-playing');
    }
    window.__descentVeilPlay = play;
    if (!window.__descentVeilInit) {
      window.__descentVeilInit = true; // first load only
      var v = document.querySelector('[data-veil]');
      if (v && v.dataset.veilOnLoad === 'true') play(); // only /art opts in
    }
    // else: a transition re-run — the after-swap listener handles it.
  })();
</script>

<script>
  // Persists across view transitions (module scripts run once). Plays the
  // destination page's veil on every client-side navigation (both directions).
  document.addEventListener('astro:after-swap', () => {
    (window as unknown as { __descentVeilPlay?: () => void }).__descentVeilPlay?.();
  });
</script>
