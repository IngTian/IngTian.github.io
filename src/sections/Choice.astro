---
// src/sections/Choice.astro
// SLIDE 1 OF 3 — THE CHOICE. Six names you recognise, thousands you do not, and what happens when people
// decide.
//
// The owner's plan: "3 slides, thousands of tickers, thousands of constraints, and the last slide animate a
// 3D route in a Bellman propagation of many that we highlight as our goal." This is the first: what the
// decision IS, and that there is an enormous amount of it.
//
// It replaces the old Lesson + Moment pair. Both were trying to be "how hard is this decision", so the second
// re-established what the first had already earned — and four slides in an identical register read as four
// walls of the same wall. This one keeps what worked (the outcome fan, the real tickers, the news) and drops
// the duplication.
//
// THE FAN IS STILL THE ARGUMENT: forty-eight people, one year, the same six headlines, outcomes from 0.85x to
// 1.34x. Same news, different reflexes. Everything is computed at build time from lib/scenario.ts (32 tests,
// seeded PRNG — the project bans Math.random() at paint time and a shimmering fan would be the worst possible
// violation of it).
import { TICKER_GLYPHS, type TickerGlyphKey } from '../data/tickerGlyphs';
import { INSTRUMENTS, NEWS, TRADER_COUNT, DESK_DISCLAIMER, FUND } from '../data/desk';
import { buildWorld, makeTraders, runTrader, runSystematic, dispersion, landmarks, WEEKS } from '../lib/scenario';
import { humanCount, multiPeriodVars } from '../lib/problemSize';

const world = buildWorld(INSTRUMENTS, NEWS);
const paths = makeTraders(TRADER_COUNT).map((t) => runTrader(t, world, INSTRUMENTS, NEWS));
const sys = runSystematic(world, INSTRUMENTS);
const spread = dispersion(paths);
const marks = landmarks(paths);
const markIndex = new Map(marks.map((m, i) => [m.index, i]));

const bigVars = multiPeriodVars(FUND.tickers, FUND.periods);

const allValues = [...paths.flatMap((p) => p.values), ...sys.values];
const lo = Math.min(...allValues);
const hi = Math.max(...allValues);
const VW = 1000, VH = 300;
const poly = (values: readonly number[]) =>
  values.map((v, i) => `${((i / WEEKS) * VW).toFixed(1)},${(VH - ((v - lo) / (hi - lo || 1)) * VH).toFixed(1)}`).join(' ');
const yOf = (v: number) => VH - ((v - lo) / (hi - lo || 1)) * VH;
const xOfWeek = (w: number) => (w / WEEKS) * VW;
const CELL = 3;
---
<section id="choice" class="ch" aria-labelledby="ch-heading">
  <div class="ch-paper">
    <div class="ch-inner">
      <p class="ch-kicker">1 / 3 · the choice</p>

      <div class="ch-split">
        <div class="ch-say">
          <h2 id="ch-heading" class="ch-head">Every month, decide how much of each to own.</h2>

          <!-- The six names, then the multiplication. Concrete first, scale second: a reader has to hold
               something familiar before "three thousand" means anything. -->
          <ul class="ch-names">
            {INSTRUMENTS.map((inst) => {
              const g = TICKER_GLYPHS[inst.glyph as TickerGlyphKey];
              return (
                <li>
                  <svg class="ch-glyph" viewBox={`0 0 ${g.w * CELL} ${g.h * CELL}`}
                       width={g.w * CELL} height={g.h * CELL} aria-hidden="true" shape-rendering="crispEdges">
                    {g.cells.map((c) => <rect x={c.x * CELL} y={c.y * CELL} width={CELL} height={CELL} />)}
                  </svg>
                  <span class="ch-tick">{inst.ticker}</span>
                </li>
              );
            })}
          </ul>

          <p class="ch-scale">
            Six is a teaching example. A real book holds <strong>{humanCount(FUND.tickers)}</strong> names and
            revisits every one of them <strong>{FUND.periods}</strong> times a year —
            <strong>{humanCount(bigVars)}</strong> weights to choose, and each one changes what the next choice
            costs.
          </p>

          <p class="ch-news-head">And the year does not sit still</p>
          <ol class="ch-news">
            {NEWS.map((n) => <li><span class="ch-wk">wk {n.week}</span>{n.headline}</li>)}
          </ol>
        </div>

        <!-- The fan: what actually happened, forty-eight times. -->
        <figure class="ch-fig">
          <p class="ch-fig-head">{TRADER_COUNT} people · one year · the same headlines</p>
          <svg class="ch-chart" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none" role="img"
               aria-label={`Forty-eight portfolio paths over one year, ending between ${spread.worst.toFixed(2)} and ${spread.best.toFixed(2)} times the starting capital.`}>
            <line class="ch-base" x1="0" y1={yOf(1)} x2={VW} y2={yOf(1)} />
            {world.newsWeeks.map((w) => <line class="ch-newsline" x1={xOfWeek(w)} y1="0" x2={xOfWeek(w)} y2={VH} />)}
            {paths.map((p, i) => (
              <polyline class:list={['ch-path', markIndex.has(i) && 'is-mark']}
                        data-mark={markIndex.has(i) ? markIndex.get(i) : undefined}
                        points={poly(p.values)} />
            ))}
          </svg>

          <div class="ch-callout" data-callout aria-live="polite">
            {marks.map((m, i) => (
              <p class="ch-call" data-call={i}>
                <span class="ch-call-label">{m.label}</span>
                <span class="ch-call-body">
                  ended at <strong>{paths[m.index].final.toFixed(2)}×</strong>, worst fall{' '}
                  <strong>{(paths[m.index].maxDrawdown * 100).toFixed(0)}%</strong>
                </span>
              </p>
            ))}
          </div>

          <p class="ch-punch">
            Nobody was foolish. They read the same six headlines and reacted differently, and that alone spread
            the year from <strong>{spread.worst.toFixed(2)}×</strong> to <strong>{spread.best.toFixed(2)}×</strong>,
            with falls as deep as <strong>{(spread.worstDrawdown * 100).toFixed(0)}%</strong>. The deciding is
            the hard part — and there is a great deal of it.
          </p>
          <figcaption class="ch-cap">{DESK_DISCLAIMER}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .ch { position: relative; z-index: 1; width: 100vw; margin-left: calc(50% - 50vw); --deck-lead: 0px; }
  .ch-paper {
    --c-bg: #c4b7a1; --c-edge: rgba(74,66,54,0.26); --c-ink: #1f1b14;
    --c-soft: #423b30; --c-faint: #6a6153; --c-accent: #7c5522; --c-fan: rgba(66,59,48,0.28);
    background: var(--c-bg);
    border-top: 1px solid var(--c-edge); border-bottom: 1px solid var(--c-edge);
    padding: clamp(30px, 4vh, 62px) 0;
  }
  :global(html[data-theme='dark']) .ch-paper {
    --c-bg: #14161a; --c-edge: rgba(184,177,161,0.14); --c-ink: #dce1dc;
    --c-soft: #a8b0a9; --c-faint: #6d746e; --c-accent: #7fc9a0; --c-fan: rgba(168,176,169,0.24);
  }
  .ch-inner {
    padding-left: clamp(150px, 9.5vw, 190px); padding-right: clamp(20px, 2.4vw, 52px); box-sizing: border-box;
  }
  @media (max-width: 1099px) { .ch-inner { padding-left: clamp(28px, 6vw, 80px); } }

  .ch-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--c-accent); margin: 0 0 14px;
  }
  /* No divider rule, and the fan gets the larger share. See Rules.astro for the measurement that drove this:
     the descent piece gives its drawing 35.7% of the slide with no rule between text and figure, and that is
     the difference between "the drawing is the slide" and "a chart sits in the right column". */
  .ch-split {
    display: grid; grid-template-columns: 36fr 64fr; gap: 0 clamp(24px, 3vw, 56px); align-items: center;
  }
  .ch-fig { margin: 0; }
  @media (max-width: 1100px) {
    .ch-split { grid-template-columns: 1fr; gap: 4vh 0; }
    .ch-fig { padding-top: 4vh; border-top: 1px solid var(--c-edge); }
  }

  .ch-head {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(24px, 2.4vw, 38px); line-height: 1.16;
    color: var(--c-ink); margin: 0 0 clamp(16px, 2.2vh, 26px); max-width: 26ch; letter-spacing: -0.012em;
  }

  .ch-names { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .ch-names li { display: inline-flex; align-items: center; gap: 6px; }
  .ch-glyph { display: block; }
  .ch-glyph rect { fill: var(--c-accent); }
  .ch-tick { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em; color: var(--c-ink); }

  .ch-scale {
    font-size: clamp(13.5px, 1vw, 15px); line-height: 1.62; color: var(--c-soft);
    margin: clamp(14px, 1.8vh, 22px) 0 0; max-width: 44ch;
  }
  .ch-scale strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--c-accent);
    font-variant-numeric: tabular-nums;
  }

  .ch-news-head {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--c-faint); margin: clamp(16px, 2.2vh, 26px) 0 8px;
  }
  .ch-news { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .ch-news li {
    font-size: 11.5px; line-height: 1.42; color: var(--c-soft);
    display: grid; grid-template-columns: 5ch 1fr; gap: 0 9px;
  }
  .ch-wk { font-family: var(--font-mono); font-size: 9.5px; color: var(--c-accent); }

  .ch-fig-head {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--c-faint); margin: 0 0 10px;
  }
  /* The fan is the argument, so it gets real height. At 280px forty-eight paths compressed into a strip and
     the dispersion — the whole point — was hard to read. */
  .ch-chart { width: 100%; height: clamp(260px, 44vh, 460px); display: block; }
  .ch-base {
    stroke: var(--c-faint); stroke-width: 1; stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke; opacity: 0.6;
  }
  .ch-newsline { stroke: var(--c-accent); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0.22; }
  .ch-path {
    fill: none; stroke: var(--c-fan); stroke-width: 1; vector-effect: non-scaling-stroke;
    stroke-linejoin: round; opacity: 0.5;
  }
  .ch-path.is-lit { stroke: var(--c-ink); stroke-width: 2.2; opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .ch-path { transition: stroke .5s ease, stroke-width .5s ease, opacity .5s ease; }
  }

  .ch-callout { position: relative; margin: 8px 0 0; min-height: 2.6em; }
  .ch-call {
    margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0 12px; align-items: baseline;
    position: absolute; inset: 0; opacity: 0;
  }
  .ch-call.is-shown { opacity: 1; position: relative; }
  @media (prefers-reduced-motion: no-preference) { .ch-call { transition: opacity .45s ease; } }
  /* No JS: show every readout in flow, which is the finished state rather than a blank strip. */
  :global(html.no-fan-js) .ch-call { position: relative; opacity: 1; margin-bottom: 5px; }
  :global(html.no-fan-js) .ch-callout { min-height: 0; }
  .ch-call-label {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--c-faint); white-space: nowrap;
  }
  .ch-call-body { font-size: clamp(12.5px, 0.92vw, 14px); line-height: 1.5; color: var(--c-soft); }
  .ch-call-body strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--c-ink); font-variant-numeric: tabular-nums;
  }

  .ch-punch {
    font-size: clamp(13px, 0.98vw, 14.5px); line-height: 1.6; color: var(--c-soft);
    margin: clamp(10px, 1.4vh, 16px) 0 0; max-width: 66ch;
    padding-top: clamp(10px, 1.4vh, 14px); border-top: 1px solid var(--c-edge);
  }
  .ch-punch strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--c-ink); font-variant-numeric: tabular-nums;
  }
  .ch-cap {
    font-size: 10.5px; line-height: 1.45; color: var(--c-faint);
    margin: 8px 0 0; max-width: 66ch; font-style: italic;
  }
</style>

<script>
  // Highlight the three landmark paths in turn. Sequential rather than all at once: three lit curves is one
  // blur, three in sequence is three separate realisations of "that could have been me".
  //
  // Progressive enhancement in the safe direction — html.no-fan-js (added here, cleared once this runs) makes
  // the CSS show every readout, so a JS failure leaves the fan and all three labels visible.
  document.documentElement.classList.add('no-fan-js');

  function initFan(): (() => void) | null {
    const section = document.querySelector<HTMLElement>('#choice');
    if (!section) return null;
    const marks = Array.from(section.querySelectorAll<SVGPolylineElement>('[data-mark]'));
    const calls = Array.from(section.querySelectorAll<HTMLElement>('[data-call]'));
    if (!marks.length || !calls.length) return null;
    document.documentElement.classList.remove('no-fan-js');

    const ordered = [...marks].sort((a, b) => Number(a.dataset.mark) - Number(b.dataset.mark));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      for (const el of ordered) el.classList.add('is-lit');
      for (const el of calls) el.classList.add('is-shown');
      return null;
    }

    let step = 0;
    let timer = 0;
    const show = (i: number) => {
      ordered.forEach((el, k) => el.classList.toggle('is-lit', k === i));
      calls.forEach((el, k) => el.classList.toggle('is-shown', k === i));
    };
    show(0);
    const advance = () => { step = (step + 1) % ordered.length; show(step); };

    // Only while on screen: an aria-live region mutating off-screen is noise for a screen reader.
    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !timer) timer = window.setInterval(advance, 2600);
      else if (!visible && timer) { window.clearInterval(timer); timer = 0; }
    }, { threshold: 0.3 });
    io.observe(section);

    return () => { window.clearInterval(timer); io.disconnect(); };
  }

  let teardown: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = initFan();
  });
</script>
