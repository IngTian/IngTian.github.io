---
// src/sections/Choice.astro
// SLIDE 1 OF 3 — WHAT THE WORDS MEAN, defined by one example rather than by prose.
//
// The owner: "I prefer saying it out loud with 'What is multi-period blablabla?' … it's best illustrated with
// an example. Very concrete example. Maybe we can't even state this in one slide. Maybe we can first explain
// what is portfolio optimization?"
//
// THE AUDIT THAT MADE THIS NECESSARY. The previous version of this slide opened with "Every month, decide how
// much of each to own" — which ASSUMES the concept. Grepping the built page confirmed nothing anywhere said
// what a portfolio is, what optimising one means, or what "multi-period" adds. A reader with no finance
// background had no way in, which is fatal for the one slide that is supposed to let them in.
//
// AND IT DOES FIT ON ONE SLIDE, but only because the EXAMPLE does the defining and the prose only labels what
// is already on screen. Three beats over ONE object — a hundred pounds in a bar:
//    1. a portfolio IS this            -> the bar divides four ways
//    2. optimising it is choosing      -> the same bar, split three other ways, with what each is worth after
//                                         one piece of news
//    3. multi-period is choosing again -> the bar re-divided, month after month, paying to change
// The object never changes; only what is being said about it does. That is what keeps it one slide instead of
// three, and it is the same trick the descent piece uses — one drawing, text in its negative space.
//
// £100 rather than percentages, deliberately: a share of an unnamed total is an abstraction, and a hundred
// pounds split four ways is something anyone can hold in their head.
//
// Arithmetic in lib/split.ts (20 tests, including the assertion that the three alternatives give three
// DIFFERENT outcomes — if they did not, "optimising is choosing" would be an empty claim).
import { TICKER_GLYPHS, type TickerGlyphKey } from '../data/tickerGlyphs';
import { BEATS, HOLDINGS, SPLITS, EVENT, DEFINE_DISCLAIMER } from '../data/define';
import { afterEvent, changePct, segments } from '../lib/split';

const opening = HOLDINGS.map((h) => h.weight);
const openingSegs = segments(opening);
const openingAfter = afterEvent(opening, EVENT.moves);

// Each alternative with what it is worth after the event — computed, never typed.
const alts = SPLITS.map((s) => ({
  ...s,
  segs: segments(s.weights),
  value: afterEvent(s.weights, EVENT.moves),
  change: changePct(s.weights, EVENT.moves),
}));

// The months of beat 3: the same split re-chosen. Declared rather than solved — this slide is defining the
// word, and the actual optimisation is what slide 3 shows.
const MONTHS = [
  { label: 'Jan', weights: [40, 25, 20, 15] },
  { label: 'Feb', weights: [30, 25, 20, 25] },
  { label: 'Mar', weights: [22, 22, 21, 35] },
  { label: 'Apr', weights: [34, 24, 18, 24] },
  { label: 'May', weights: [42, 22, 16, 20] },
].map((m) => ({ ...m, segs: segments(m.weights) }));

const CELL = 3;
---
<section id="choice" class="ch" aria-labelledby="ch-heading">
  <div class="ch-paper">
    <div class="ch-inner">
      <p class="ch-kicker">1 / 3</p>
      <h2 id="ch-heading" class="ch-head">What is multi-period portfolio optimization?</h2>

      <!-- Beats LEFT, the object RIGHT — the definition and its illustration read together, and the object
           gets the larger share. Stacking them left the right half of the slide empty and pushed the money bar
           below the fold of attention. -->
      <div class="ch-body">
      <!-- THE THREE BEATS. Each is a question a stranger would actually ask, answered against the same
           object. The reveal is sequential so the definition builds; with no JS all three show at once,
           which is the finished state and still reads in order. -->
      <ol class="ch-beats">
        {BEATS.map((b, i) => (
          <li class="ch-beat" data-beat={i}>
            <p class="ch-ask">{b.ask}</p>
            <p class="ch-say">{b.say}</p>
          </li>
        ))}
      </ol>

      <div class="ch-stage">
        <!-- BEAT 1: the portfolio, as one bar of money divided four ways. -->
        <figure class="ch-panel" data-panel="0">
          <p class="ch-panel-head">£100, split four ways</p>
          <div class="ch-bar ch-bar--big" role="img"
               aria-label={HOLDINGS.map((h) => `${h.weight} pounds in ${h.plain}`).join(', ')}>
            {openingSegs.map((seg, i) => (
              <span class:list={['ch-seg', `ch-seg--${i}`]} style={`left:${seg.start}%;width:${seg.width}%`}></span>
            ))}
          </div>
          <ul class="ch-legend">
            {HOLDINGS.map((h, i) => {
              const g = TICKER_GLYPHS[h.glyph as TickerGlyphKey];
              return (
                <li>
                  <span class:list={['ch-swatch', `ch-seg--${i}`]} aria-hidden="true"></span>
                  <svg class="ch-glyph" viewBox={`0 0 ${g.w * CELL} ${g.h * CELL}`}
                       width={g.w * CELL} height={g.h * CELL} aria-hidden="true" shape-rendering="crispEdges">
                    {g.cells.map((c) => <rect x={c.x * CELL} y={c.y * CELL} width={CELL} height={CELL} />)}
                  </svg>
                  <span class="ch-money">£{h.weight}</span>
                  <span class="ch-what">{h.plain}</span>
                  <span class="ch-tick">{h.ticker}</span>
                </li>
              );
            })}
          </ul>
          <p class="ch-panel-foot">That is a portfolio. Nothing more — a decision about where money sits.</p>
        </figure>

        <!-- BEAT 2: the same money, split differently, and what one piece of news does to each. -->
        <figure class="ch-panel" data-panel="1">
          <p class="ch-panel-head">
            <span class="ch-when">{EVENT.when}</span> {EVENT.what}
          </p>
          <ul class="ch-alts">
            <li class="ch-alt is-yours">
              <span class="ch-alt-label">your split</span>
              <span class="ch-bar" aria-hidden="true">
                {openingSegs.map((seg, i) => (
                  <span class:list={['ch-seg', `ch-seg--${i}`]} style={`left:${seg.start}%;width:${seg.width}%`}></span>
                ))}
              </span>
              <span class="ch-alt-val">£{openingAfter.toFixed(0)}</span>
            </li>
            {alts.map((a) => (
              <li class="ch-alt">
                <span class="ch-alt-label">{a.label}</span>
                <span class="ch-bar" aria-hidden="true">
                  {a.segs.map((seg, i) => (
                    <span class:list={['ch-seg', `ch-seg--${i}`]} style={`left:${seg.start}%;width:${seg.width}%`}></span>
                  ))}
                </span>
                <span class="ch-alt-val">£{a.value.toFixed(0)}</span>
                <span class="ch-alt-note">{a.note}</span>
              </li>
            ))}
          </ul>
          <p class="ch-panel-foot">
            Same hundred pounds, same news, and it is worth anywhere from
            <strong>£{Math.min(...alts.map((a) => a.value)).toFixed(0)}</strong> to
            <strong>£{Math.max(...alts.map((a) => a.value)).toFixed(0)}</strong> afterwards. Choosing the
            split is the optimisation.
          </p>
        </figure>

        <!-- BEAT 3: and you choose again. The same bar, month after month. -->
        <figure class="ch-panel" data-panel="2">
          <p class="ch-panel-head">And then you choose again</p>
          <ul class="ch-months">
            {MONTHS.map((m) => (
              <li>
                <span class="ch-month-label">{m.label}</span>
                <span class="ch-bar" aria-hidden="true">
                  {m.segs.map((seg, i) => (
                    <span class:list={['ch-seg', `ch-seg--${i}`]} style={`left:${seg.start}%;width:${seg.width}%`}></span>
                  ))}
                </span>
              </li>
            ))}
          </ul>
          <p class="ch-panel-foot">
            Every month the world has moved and the split is wrong again — and every change costs you
            something to make. That is the <em>multi-period</em> part: not one decision, but a sequence of
            them, each one starting from wherever the last one left you.
          </p>
        </figure>
      </div>

      </div>

      <p class="ch-cap">{DEFINE_DISCLAIMER}</p>
    </div>
  </div>
</section>

<style>
  .ch { position: relative; z-index: 1; width: 100vw; margin-left: calc(50% - 50vw); --deck-lead: 0px; }
  .ch-paper {
    --c-bg: #c4b7a1; --c-edge: rgba(74,66,54,0.26); --c-ink: #1f1b14;
    --c-soft: #423b30; --c-faint: #6a6153; --c-accent: #7c5522;
    /* Four holding colours, from the palette only: the accent, two ink tones, and the indigo. No new hues —
       the site allows exactly one saturated colour in light theme and it is the seal, which is reserved. */
    --c-h0: #7c5522; --c-h1: #9a8353; --c-h2: #5d6472; --c-h3: #b9a880;
    background: var(--c-bg);
    border-top: 1px solid var(--c-edge); border-bottom: 1px solid var(--c-edge);
    padding: clamp(28px, 3.6vh, 56px) 0;
  }
  :global(html[data-theme='dark']) .ch-paper {
    --c-bg: #14161a; --c-edge: rgba(184,177,161,0.14); --c-ink: #dce1dc;
    --c-soft: #a8b0a9; --c-faint: #6d746e; --c-accent: #7fc9a0;
    --c-h0: #7fc9a0; --c-h1: #5f9b7c; --c-h2: #6b7686; --c-h3: #a9b4a5;
  }
  .ch-inner {
    padding-left: clamp(150px, 9.5vw, 190px); padding-right: clamp(20px, 2.4vw, 52px); box-sizing: border-box;
  }
  @media (max-width: 1099px) { .ch-inner { padding-left: clamp(28px, 6vw, 80px); } }

  .ch-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--c-accent); margin: 0 0 12px;
  }
  /* THE QUESTION, said out loud, as the owner asked. Largest thing on the slide because it is what the slide
     answers. */
  .ch-head {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(26px, 2.8vw, 46px); line-height: 1.1;
    color: var(--c-ink); margin: 0 0 clamp(18px, 2.4vh, 32px); max-width: 30ch;
    letter-spacing: -0.014em; text-wrap: balance;
  }

  /* The beats sit left, the object right — but the beats are a LIST, not a column of prose: each is dim until
     its turn, so the definition reads as three steps rather than a wall. */
  .ch-beats { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(12px, 1.8vh, 20px); }
  .ch-beat { opacity: 0.3; max-width: 46ch; }
  .ch-beat.is-on { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .ch-beat { transition: opacity .5s ease; } }
  :global(html.no-define-js) .ch-beat { opacity: 1; }

  .ch-ask {
    font-family: var(--font-display); font-size: clamp(16px, 1.4vw, 21px); line-height: 1.3;
    color: var(--c-ink); margin: 0 0 4px;
  }
  .ch-say { font-size: clamp(13px, 0.98vw, 14.5px); line-height: 1.6; color: var(--c-soft); margin: 0; }

  /* THE OBJECT. One stage, three panels stacked in it — only one visible at a time, so the money bar is the
     same object being spoken about three ways rather than three different figures. */
  .ch-stage { position: relative; margin: clamp(20px, 2.8vh, 36px) 0 0; min-height: clamp(240px, 34vh, 400px); }
  .ch-panel { position: absolute; inset: 0; margin: 0; opacity: 0; pointer-events: none; }
  .ch-panel.is-on { opacity: 1; pointer-events: auto; }
  @media (prefers-reduced-motion: no-preference) { .ch-panel { transition: opacity .5s ease; } }
  /* No JS: show the FIRST panel, which is the definition's starting point, and let the beats read as text. */
  :global(html.no-define-js) .ch-panel { position: relative; inset: auto; opacity: 0; }
  :global(html.no-define-js) .ch-panel[data-panel='0'] { opacity: 1; }

  .ch-panel-head {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em;
    color: var(--c-faint); margin: 0 0 12px; text-transform: uppercase;
  }
  .ch-when { color: var(--c-accent); }
  .ch-panel-foot {
    font-size: clamp(12.5px, 0.95vw, 14px); line-height: 1.6; color: var(--c-soft);
    margin: clamp(12px, 1.8vh, 18px) 0 0; max-width: 62ch;
  }
  .ch-panel-foot strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--c-ink); font-variant-numeric: tabular-nums;
  }
  .ch-panel-foot em { font-style: italic; color: var(--c-ink); }

  /* THE BAR: one hundred pounds, divided. The whole definition rests on this being obviously ONE thing cut
     into parts rather than four separate things. */
  .ch-bar {
    position: relative; display: block; width: 100%; height: 14px;
    background: color-mix(in srgb, var(--c-faint) 18%, transparent);
    border-radius: 2px; overflow: hidden;
  }
  .ch-bar--big { height: clamp(34px, 4.4vh, 52px); border-radius: 3px; }
  .ch-seg { position: absolute; top: 0; bottom: 0; display: block; }
  .ch-seg--0 { background: var(--c-h0); }
  .ch-seg--1 { background: var(--c-h1); }
  .ch-seg--2 { background: var(--c-h2); }
  .ch-seg--3 { background: var(--c-h3); }
  @media (prefers-reduced-motion: no-preference) {
    /* The bar re-dividing between months is the visual of "choosing again", so the segments move rather than
       cut. Transform-only would be ideal but left/width on an absolutely-positioned child does not reflow
       anything outside the bar, so it stays cheap. */
    .ch-seg { transition: left .6s cubic-bezier(.2,.7,.3,1), width .6s cubic-bezier(.2,.7,.3,1); }
  }

  .ch-legend {
    list-style: none; margin: clamp(12px, 1.8vh, 18px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px clamp(16px, 2vw, 32px);
  }
  .ch-legend li { display: grid; grid-template-columns: auto auto auto 1fr auto; align-items: center; gap: 0 9px; }
  .ch-swatch { width: 9px; height: 9px; border-radius: 1px; display: block; }
  .ch-glyph { display: block; }
  .ch-glyph rect { fill: var(--c-faint); }
  .ch-money {
    font-family: var(--font-mono); font-size: 13.5px; color: var(--c-ink); font-variant-numeric: tabular-nums;
  }
  .ch-what { font-size: 12.5px; color: var(--c-soft); }
  .ch-tick { font-family: var(--font-mono); font-size: 9.5px; color: var(--c-faint); letter-spacing: 0.06em; }

  /* BEAT 2: the alternatives, each a bar and a number. */
  .ch-alts { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(9px, 1.4vh, 14px); }
  .ch-alt {
    display: grid; grid-template-columns: 11ch minmax(0, 1fr) 5ch; align-items: center;
    gap: 2px clamp(10px, 1.4vw, 20px);
  }
  .ch-alt.is-yours .ch-alt-label { color: var(--c-accent); }
  .ch-alt-label { font-family: var(--font-mono); font-size: 10.5px; color: var(--c-soft); letter-spacing: 0.04em; }
  .ch-alt-val {
    font-family: var(--font-mono); font-size: 14px; color: var(--c-ink);
    font-variant-numeric: tabular-nums; text-align: right;
  }
  .ch-alt-note { grid-column: 2 / -1; font-size: 11px; line-height: 1.4; color: var(--c-faint); }

  /* BEAT 3: the same bar, month after month. */
  .ch-months { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(8px, 1.2vh, 12px); }
  .ch-months li { display: grid; grid-template-columns: 4ch minmax(0, 1fr); align-items: center; gap: 0 clamp(10px, 1.4vw, 18px); }
  .ch-month-label { font-family: var(--font-mono); font-size: 10px; color: var(--c-accent); letter-spacing: 0.06em; }

  .ch-cap {
    font-size: 10.5px; line-height: 1.45; color: var(--c-faint);
    margin: clamp(12px, 1.8vh, 20px) 0 0; max-width: 62ch; font-style: italic;
  }

  /* Beats beside the object, so the definition and its illustration are read together and the money bar sits
     where the eye already is. The object takes the larger share — same principle as the other slides: the
     drawing is the subject, not an aside. */
  @media (min-width: 1101px) {
    .ch-body {
      display: grid; grid-template-columns: 33fr 67fr;
      gap: 0 clamp(26px, 3vw, 56px); align-items: center;
    }
    /* The stage no longer needs the vertical gap that separated it from stacked beats. */
    .ch-stage { margin-top: 0; }
  }
</style>

<script>
  // THE DEFINITION BUILDS: beat 1, beat 2, beat 3, then it holds and repeats. Sequential because a definition
  // is an ORDER — what a portfolio is, then what optimising means, then what multi-period adds — and showing
  // all three at once is a wall of text that a reader has to sort themselves.
  //
  // Safe direction for progressive enhancement: html.no-define-js (added here, cleared once this runs) shows
  // every beat at full strength and the first panel, so a JS failure leaves a readable definition rather than
  // a dim list and an empty stage.
  document.documentElement.classList.add('no-define-js');

  function initDefine(): (() => void) | null {
    const section = document.querySelector<HTMLElement>('#choice');
    if (!section) return null;
    const beats = Array.from(section.querySelectorAll<HTMLElement>('[data-beat]'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-panel]'));
    if (beats.length !== panels.length || !beats.length) return null;
    document.documentElement.classList.remove('no-define-js');

    const show = (i: number) => {
      beats.forEach((el, k) => el.classList.toggle('is-on', k === i));
      panels.forEach((el, k) => el.classList.toggle('is-on', k === i));
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Finished state: every beat legible, first panel shown. No sequence.
      for (const el of beats) el.classList.add('is-on');
      panels[0].classList.add('is-on');
      return null;
    }

    let step = 0;
    let timer = 0;
    show(0);
    const advance = () => {
      step = (step + 1) % beats.length;
      show(step);
      // Hold longest on the last beat: it is the one the slide is named after.
      window.clearTimeout(timer);
      timer = window.setTimeout(advance, step === beats.length - 1 ? 6200 : 4600);
    };

    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !timer) timer = window.setTimeout(advance, 4600);
      else if (!visible && timer) { window.clearTimeout(timer); timer = 0; }
    }, { threshold: 0.3 });
    io.observe(section);

    return () => { window.clearTimeout(timer); io.disconnect(); };
  }

  let teardown: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = initDefine();
  });
</script>
