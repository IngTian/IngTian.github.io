---
// src/sections/Moment.astro
// THE CONCRETE MOMENT — one desk, one morning, a calendar you can see, and the question.
//
// The owner: "seems like a little bit abrupt from above to how would you invest. the how would you invest is
// still lacking concreteness… consider a more concrete setting, like we have XXX news coming out next week,
// we have XXX coming out after that, in the long run i know this company is facing XXX pressure. at this
// moment, how do you decide the best positions given that you are allowed to reweight? also, you need to
// consider the reweight costs from slippage etc. might good to make a visual to explain this."
//
// So this slide is a briefing, and the question comes last. The reader gets the book they are holding, the
// three things on the calendar, and the slow pressure underneath — then "what do you hold on Monday?" has a
// shape, and the honest answer is that it is not obvious. That is the point: the difficulty is felt before it
// is explained.
//
// THE SLIPPAGE VISUAL is on the right, because it is the constraint that makes the question hard rather than
// merely open. Trimming a large position costs the spread plus impact that grows with how fast you move —
// so "just reduce risk before the event" is not free, and the break-even line shows where the cost eats the
// edge that motivated the trade.
//
// Maths in lib/decisionTree.ts (pure, 27 tests). Copy in data/moment.ts. Everything computed at build time.
import { TICKER_GLYPHS, type TickerGlyphKey } from '../data/tickerGlyphs';
import {
  BOOK, CALENDAR, STRUCTURAL, MOMENT_QUESTION, MOMENT_LEDE, MOMENT_DISCLAIMER, SLIPPAGE, TREE,
} from '../data/moment';
import {
  costCurve, breakEvenParticipation, reweightCost, buildTree, pathOf, countsByDepth,
} from '../lib/decisionTree';

// THE TREE lives here rather than on the "why it is hard" slide, because it is THIS decision one step
// further on: the calendar above says there will be three more decision points, and the tree is what that
// actually means. Every node is a state of the book, every edge a reweight, and the bottom row is every book
// you could be holding by the end. It answers "you didn't surface countless decisions you make in the multi
// period setting" by drawing them instead of counting them in prose.
const tree = buildTree(TREE.branch, TREE.depths);
const rowCounts = countsByDepth(tree);
// One stated route — trim, hold, add, hold — so a reader can follow a single thread inside the fan. Stated
// rather than random: the project bans Math.random() at paint time.
const highlight = pathOf(tree, [0, 1, 2, 1]);
const highlightIds = new Set(highlight.map((n) => `${n.depth}:${n.index}`));
const TW = 520, TH = 150;
const tx = (x: number) => x * TW;
const ty = (y: number) => 10 + y * (TH - 20);

const curve = costCurve(48, 1, SLIPPAGE.spreadBp, SLIPPAGE.impactBp);
const breakEven = breakEvenParticipation(SLIPPAGE.edgeBp, SLIPPAGE.spreadBp, SLIPPAGE.impactBp);
const maxBp = Math.max(...curve.map((c) => c.costBp), SLIPPAGE.edgeBp) * 1.08;

// Two concrete quotes for the copy: the cost of moving fast versus slow.
const fastBp = reweightCost(1, SLIPPAGE.spreadBp, SLIPPAGE.impactBp, 0.6) * 10000;
const slowBp = reweightCost(1, SLIPPAGE.spreadBp, SLIPPAGE.impactBp, 0.05) * 10000;

const CW = 420, CH = 210;
const px = (p: number) => (p / 1) * CW;
const py = (bp: number) => CH - (bp / maxBp) * CH;
const CELL = 3;
---
<section id="moment" class="mo" aria-labelledby="mo-heading">
  <div class="mo-paper">
    <div class="mo-inner">
      <p class="mo-kicker">A Monday morning</p>

      <div class="mo-split">
        <!-- LEFT: the book, the calendar, the pressure, then the question. -->
        <div class="mo-brief">
          <p class="mo-sub">What you are holding</p>
          <ul class="mo-book">
            {BOOK.map((h) => {
              const g = TICKER_GLYPHS[h.glyph as TickerGlyphKey];
              return (
                <li class="mo-holding">
                  <svg
                    class="mo-glyph"
                    viewBox={`0 0 ${g.w * CELL} ${g.h * CELL}`}
                    width={g.w * CELL} height={g.h * CELL}
                    aria-hidden="true" shape-rendering="crispEdges"
                  >
                    {g.cells.map((c) => (
                      <rect x={c.x * CELL} y={c.y * CELL} width={CELL} height={CELL} />
                    ))}
                  </svg>
                  <span class="mo-tick">{h.ticker}</span>
                  <!-- The weight as a bar AND a number: the bar makes concentration visible at a glance,
                       which is the fact that makes the calendar below frightening. -->
                  <span class="mo-bar" aria-hidden="true">
                    <span class="mo-bar-fill" style={`width:${(h.weight / 24) * 100}%`}></span>
                  </span>
                  <span class="mo-weight">{h.weight}%</span>
                  <span class="mo-stance">{h.stance}</span>
                </li>
              );
            })}
          </ul>

          <p class="mo-sub mo-sub--cal">What you already know is coming</p>
          <ol class="mo-cal">
            {CALENDAR.map((c) => (
              <li class="mo-cal-item">
                <span class="mo-when">{c.when}</span>
                <span class="mo-what">{c.what}</span>
                <span class="mo-hits">
                  {c.hits.map((t) => <span class="mo-chip">{t}</span>)}
                </span>
                <span class="mo-two">{c.twoSided}</span>
              </li>
            ))}
          </ol>

          <p class="mo-struct">
            <span class="mo-struct-head">{STRUCTURAL.head}</span>
            {STRUCTURAL.body}
          </p>
        </div>

        <!-- RIGHT: the question, and the cost of acting on it. -->
        <div class="mo-ask">
          <h2 id="mo-heading" class="mo-question">{MOMENT_QUESTION}</h2>
          <p class="mo-lede">{MOMENT_LEDE}</p>

          <figure class="mo-fig">
            <figcaption class="mo-fig-head">
              <span class="mo-fig-title">{SLIPPAGE.tradeLabel}</span>
              <span class="mo-fig-sub">{SLIPPAGE.notional} · {SLIPPAGE.advLabel}</span>
            </figcaption>

            <svg
              class="mo-chart" viewBox={`0 0 ${CW} ${CH}`} preserveAspectRatio="none"
              role="img"
              aria-label={`Trading cost against how fast the position is moved: about ${slowBp.toFixed(0)} basis points spread over a week, rising to about ${fastBp.toFixed(0)} basis points if moved in a morning. The expected edge is ${SLIPPAGE.edgeBp} basis points.`}
            >
              <!-- The edge you think the trade is worth. Above this line, the trade destroys value. -->
              <line class="mo-edge" x1="0" y1={py(SLIPPAGE.edgeBp)} x2={CW} y2={py(SLIPPAGE.edgeBp)} />
              <text class="mo-edge-tag" x="6" y={py(SLIPPAGE.edgeBp) - 6}>your edge · {SLIPPAGE.edgeBp}bp</text>

              <!-- THE COST CURVE. Concave, because impact grows with the square root of participation —
                   which is the visual signature worth drawing: the first slice of urgency is cheap, the
                   last is not. -->
              <polyline
                class="mo-cost"
                points={curve.map((c) => `${px(c.participation).toFixed(1)},${py(c.costBp).toFixed(1)}`).join(' ')}
              />

              {breakEven !== null && breakEven > 0 && breakEven <= 1 && (
                <>
                  <line class="mo-be" x1={px(breakEven)} y1={py(SLIPPAGE.edgeBp)} x2={px(breakEven)} y2={CH} />
                  <circle class="mo-be-dot" cx={px(breakEven)} cy={py(SLIPPAGE.edgeBp)} r="3.5" />
                </>
              )}
            </svg>

            <div class="mo-axis">
              <span>patient · days</span>
              <span>urgent · one session</span>
            </div>

            <p class="mo-read">
              Spread the trade over a week and it costs about <strong>{slowBp.toFixed(0)}bp</strong>. Do it in
              one session and it costs about <strong>{fastBp.toFixed(0)}bp</strong> — more than the
              {' '}{SLIPPAGE.edgeBp}bp you thought the trade was worth.
              {breakEven !== null && breakEven > 0 && (
                <> Past <strong>{(breakEven * 100).toFixed(0)}%</strong> of a day's volume you are paying more
                than the idea is worth.</>
              )}
            </p>
            <p class="mo-note">{SLIPPAGE.note}</p>
          </figure>

          <!-- AND THEN IT HAPPENS AGAIN. The calendar above promises three more decision points; this is what
               that means. Drawn small and stated large: 81 books here, astronomically more in the real
               problem, which is the bridge into the next slide. -->
          <figure class="mo-tree-fig">
            <p class="mo-tree-head">And you will decide again, from wherever this leaves you</p>
            <svg
              class="mo-tree" viewBox={`0 0 ${TW} ${TH}`} preserveAspectRatio="xMidYMid meet"
              role="img"
              aria-label={`A decision tree: ${TREE.branch} possible actions at each of ${TREE.depths} decision points, branching to ${tree.leaves} possible portfolios by the end of the calendar.`}
            >
              {tree.edges.map((e) => {
                const lit = highlightIds.has(`${e.from.depth}:${e.from.index}`)
                  && highlightIds.has(`${e.to.depth}:${e.to.index}`);
                return (
                  <line
                    class:list={['mo-branch', lit && 'is-lit']}
                    x1={tx(e.from.x)} y1={ty(e.from.y)} x2={tx(e.to.x)} y2={ty(e.to.y)}
                  />
                );
              })}
              {tree.nodes.map((n) => (
                <circle
                  class:list={['mo-node', highlightIds.has(`${n.depth}:${n.index}`) && 'is-lit']}
                  cx={tx(n.x)} cy={ty(n.y)} r={n.depth === 0 ? 3 : 1.8}
                />
              ))}
            </svg>
            <div class="mo-tree-rows">
              {TREE.decisionLabels.map((label, i) => (
                <span class="mo-tree-row">
                  <span class="mo-row-when">{label}</span>
                  <span class="mo-row-count">{rowCounts[i + 1]}</span>
                </span>
              ))}
            </div>
            <figcaption class="mo-tree-cap">
              {TREE.actionLabels.join(' / ')} at each of {TREE.depths} points is
              {' '}<strong>{tree.leaves}</strong> possible books. {TREE.note}
            </figcaption>
          </figure>

          <p class="mo-disclaimer">{MOMENT_DISCLAIMER}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mo {
    position: relative; z-index: 1;
    width: 100vw; margin-left: calc(50% - 50vw);
    --deck-lead: 0px;
  }
  .mo-paper {
    --mo-bg: #c4b7a1;
    --mo-edge: rgba(74, 66, 54, 0.26);
    --mo-ink: #1f1b14;
    --mo-ink-soft: #423b30;
    --mo-ink-faint: #6a6153;
    --mo-accent: #7c5522;
    background: var(--mo-bg);
    border-top: 1px solid var(--mo-edge);
    border-bottom: 1px solid var(--mo-edge);
    padding: clamp(28px, 3.6vh, 56px) 0;
  }
  :global(html[data-theme='dark']) .mo-paper {
    --mo-bg: #14161a;
    --mo-edge: rgba(184, 177, 161, 0.14);
    --mo-ink: #dce1dc;
    --mo-ink-soft: #a8b0a9;
    --mo-ink-faint: #6d746e;
    --mo-accent: #7fc9a0;
  }
  .mo-inner {
    padding-left: clamp(150px, 9.5vw, 190px);
    padding-right: clamp(20px, 2.4vw, 52px);
    box-sizing: border-box;
  }
  @media (max-width: 1099px) { .mo-inner { padding-left: clamp(28px, 6vw, 80px); } }

  .mo-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--mo-accent); margin: 0 0 12px;
  }
  .mo-sub {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--mo-ink-faint); margin: 0 0 10px;
  }
  .mo-sub--cal { margin-top: clamp(14px, 1.8vh, 22px); }

  .mo-split {
    display: grid; grid-template-columns: 52fr 48fr;
    gap: 0 clamp(26px, 3.2vw, 60px);
    align-items: start;
  }
  .mo-ask { border-left: 1px solid var(--mo-edge); padding-left: clamp(26px, 3.2vw, 60px); }
  @media (max-width: 1100px) {
    .mo-split { grid-template-columns: 1fr; gap: 4vh 0; }
    .mo-ask { border-left: 0; padding-left: 0; padding-top: 4vh; border-top: 1px solid var(--mo-edge); }
  }

  /* THE BOOK: glyph, ticker, a weight bar, the number, and one line of stance. The bar is what makes the
     concentration legible — 24% in one name reads instantly as a bar and not at all as a figure in a list. */
  .mo-book { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .mo-holding {
    display: grid;
    grid-template-columns: auto auto minmax(40px, 1fr) auto;
    align-items: center; gap: 2px clamp(8px, 1vw, 14px);
  }
  .mo-glyph { display: block; grid-row: span 2; }
  .mo-glyph rect { fill: var(--mo-accent); }
  .mo-tick {
    font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.03em; color: var(--mo-ink);
  }
  .mo-bar {
    display: block; height: 5px; background: color-mix(in srgb, var(--mo-ink-faint) 22%, transparent);
    border-radius: 1px; overflow: hidden;
  }
  .mo-bar-fill { display: block; height: 100%; background: var(--mo-accent); opacity: 0.8; }
  .mo-weight {
    font-family: var(--font-mono); font-size: 12px; color: var(--mo-ink-soft);
    font-variant-numeric: tabular-nums; text-align: right;
  }
  .mo-stance {
    grid-column: 2 / -1; font-size: 11.5px; line-height: 1.4; color: var(--mo-ink-faint);
  }

  /* THE CALENDAR: when, what, who it hits, and why it is two-sided. The last part is what stops this being
     a to-do list — every item cuts both ways, which is why there is no obvious trade. */
  .mo-cal { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .mo-cal-item {
    display: grid; grid-template-columns: auto 1fr; gap: 2px clamp(10px, 1.2vw, 16px);
    align-items: baseline;
  }
  .mo-when {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: var(--mo-accent);
    white-space: nowrap;
  }
  .mo-what { font-size: 13px; line-height: 1.4; color: var(--mo-ink); }
  .mo-hits { grid-column: 2; display: flex; gap: 5px; flex-wrap: wrap; margin: 2px 0; }
  .mo-chip {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.06em;
    color: var(--mo-ink-soft); border: 1px solid var(--mo-edge); border-radius: 2px; padding: 1px 5px;
  }
  .mo-two { grid-column: 2; font-size: 11.5px; line-height: 1.45; color: var(--mo-ink-faint); }

  .mo-struct {
    margin: clamp(12px, 1.6vh, 18px) 0 0; font-size: 12px; line-height: 1.55; color: var(--mo-ink-soft);
    padding-top: clamp(10px, 1.4vh, 14px); border-top: 1px solid var(--mo-edge);
  }
  .mo-struct-head {
    display: block; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--mo-accent); margin-bottom: 5px;
  }

  /* THE QUESTION, largest thing on the slide — it is what the briefing exists to make land. */
  .mo-question {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(26px, 2.6vw, 42px); line-height: 1.1;
    color: var(--mo-ink); margin: 0; letter-spacing: -0.015em;
  }
  .mo-lede {
    font-size: clamp(13px, 0.95vw, 14.5px); line-height: 1.6; color: var(--mo-ink-soft);
    margin: 12px 0 0; max-width: 48ch;
  }

  .mo-fig { margin: clamp(14px, 2vh, 22px) 0 0; }
  .mo-fig-head { display: grid; gap: 2px; margin: 0 0 8px; }
  .mo-fig-title {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--mo-ink);
  }
  .mo-fig-sub { font-family: var(--font-mono); font-size: 9.5px; color: var(--mo-ink-faint); }

  .mo-chart { width: 100%; height: clamp(120px, 17vh, 180px); display: block; }
  .mo-edge {
    stroke: var(--mo-ink-faint); stroke-width: 1; stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
  }
  .mo-edge-tag {
    font-family: var(--font-mono); font-size: 9px; fill: var(--mo-ink-faint);
  }
  .mo-cost {
    fill: none; stroke: var(--mo-accent); stroke-width: 2.2;
    vector-effect: non-scaling-stroke; stroke-linejoin: round;
  }
  .mo-be {
    stroke: var(--mo-ink-faint); stroke-width: 1; stroke-dasharray: 2 3;
    vector-effect: non-scaling-stroke; opacity: 0.7;
  }
  .mo-be-dot { fill: var(--mo-accent); }

  .mo-axis {
    display: flex; justify-content: space-between; margin: 4px 0 0;
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--mo-ink-faint);
  }

  .mo-read {
    font-size: clamp(12.5px, 0.92vw, 14px); line-height: 1.55; color: var(--mo-ink-soft);
    margin: clamp(10px, 1.4vh, 14px) 0 0; max-width: 52ch;
  }
  .mo-read strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--mo-ink);
    font-variant-numeric: tabular-nums;
  }
  .mo-note {
    font-size: 12px; line-height: 1.5; color: var(--mo-ink-faint);
    margin: 8px 0 0; max-width: 52ch;
  }
  /* THE TREE, small and dense — it is a texture that says "this keeps happening", not a diagram to be read
     node by node. The row labels sit beneath as a strip so each depth is named and counted. */
  .mo-tree-fig {
    margin: clamp(12px, 1.8vh, 20px) 0 0;
    padding-top: clamp(10px, 1.4vh, 16px);
    border-top: 1px solid var(--mo-edge);
  }
  .mo-tree-head {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--mo-ink-faint); margin: 0 0 8px;
  }
  .mo-tree { width: 100%; height: clamp(80px, 11vh, 120px); display: block; }
  .mo-branch {
    stroke: var(--mo-ink-faint); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0.3;
  }
  .mo-branch.is-lit { stroke: var(--mo-accent); stroke-width: 2; opacity: 1; }
  .mo-node { fill: var(--mo-ink-faint); opacity: 0.5; }
  .mo-node.is-lit { fill: var(--mo-accent); opacity: 1; }

  .mo-tree-rows {
    display: flex; justify-content: space-between; gap: 8px; margin: 5px 0 0; flex-wrap: wrap;
  }
  .mo-tree-row { display: grid; gap: 0; }
  .mo-row-when {
    font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--mo-accent); white-space: nowrap;
  }
  .mo-row-count {
    font-family: var(--font-mono); font-size: 10.5px; color: var(--mo-ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .mo-tree-cap {
    font-size: 11.5px; line-height: 1.5; color: var(--mo-ink-faint);
    margin: 7px 0 0; max-width: 58ch;
  }
  .mo-tree-cap strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--mo-ink);
    font-variant-numeric: tabular-nums;
  }

  .mo-disclaimer {
    font-size: 10.5px; line-height: 1.45; color: var(--mo-ink-faint);
    margin: clamp(10px, 1.4vh, 16px) 0 0; max-width: 60ch; font-style: italic;
  }
</style>
