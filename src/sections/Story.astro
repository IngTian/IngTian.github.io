---
// src/sections/Story.astro
// THE EDITORIAL that explains the descent graph, in two columns on a paper ground.
//
// The owner's brief: "after the descent line, a section explaining ourselves, incl. why we transition
// into quants… the section explains the graph literally. You maybe even can get creative, try 2
// columns etc." And the register: the earlier "forty-two sentences" sketch read like a good journal
// spread, but its CONTENT was photograph notes — "after all we are not an artist". So this keeps that
// typographic register and puts the actual subject in it.
//
// WHY A PAPER GROUND. The rest of the homepage is a sky you descend through. This section is the one
// place that stops and talks, so it gets a different surface: an editorial paper panel, full-bleed,
// with the sky visible above and below it. That is also the elegant thing the owner picked out about
// the light theme, and the panel colour is chosen per theme rather than shared.
//
// Every number here is COMPUTED at build time from the same field the graph draws, so the prose and
// the picture cannot drift apart. Nothing is hand-typed.
//
// THE PANEL NOW WRAPS THE GRAPH TOO. The owner: "in the descent one climb section, you might want to
// completely turn off the fluid background and use the paper editorial background." That is one
// slide — the picture and the words that read it — so it is one surface, and DescentPath renders as
// a <slot> inside this panel rather than as a sibling floating on the sky. Turning the fluid off
// behind it is done by the panel being opaque, not by touching the fluid layer: the sky keeps
// running above and below, and this slide simply sits on paper.
import { STORY, STORY_CODA, STORY_FIGURES } from '../data/story';
import { trajectoryFacts, WAYPOINTS } from '../lib/trajectory';
import { curvature } from '../lib/sensitivity';
import { discoveryOf } from '../lib/knowledge';

const facts = trajectoryFacts();
const swe = WAYPOINTS.find((w) => w.label.includes('Senior SWE'))!;
const phd = WAYPOINTS.find((w) => w.label.includes('PhD'))!;
const inBasin = curvature(swe.x, swe.y).signal;
const onDescent = curvature(phd.x, phd.y).signal;
const discovery = discoveryOf(facts.globalBasin.x, facts.globalBasin.y);

// Fill the figures from the real measurements.
const figures = STORY_FIGURES.map((f) => {
  if (f.label === 'feedback ratio') return { ...f, value: `${Math.round(onDescent / inBasin)}×` };
  if (f.label === 'climb to leave') return { ...f, value: `+${facts.climbRequired.toFixed(2)}` };
  return { ...f, value: String(discovery?.blindStops ?? 0) };
});
---
<section id="story" class="story" aria-labelledby="story-heading">
  <div class="story-paper">
    <!-- The graph, on the same paper. Passed in as a slot so this component owns the surface and the
         ink tokens, and DescentPath stays a self-contained piece that inherits them. -->
    <div class="story-figure-slot">
      <slot />

      <!-- WHAT IS BELOW, NAMED. The hero carries a "scroll" cue and the tagline slide reveals the
           descent beneath it, but the graph slide ended with nothing — in a deck, where each slide
           fills the screen, an unmarked bottom edge reads as the end of the page. This names the next
           slide rather than just gesturing down: the reader learns the graph HAS an explanation.
           A real link, so it works without the deck (and for keyboard). -->
      <a class="story-next" href="#story-heading">
        <span class="story-next-label">Why the climb</span>
        <span class="story-next-arrow" aria-hidden="true"></span>
      </a>
    </div>

    <div class="story-inner">
      <h2 id="story-heading" class="story-title">Why the climb</h2>

      <div class="story-cols">
        {STORY.map((col) => (
          <div class="story-col">
            <p class="story-kicker">{col.kicker}</p>
            <p class="story-lead">{col.lead}</p>
            {col.body.map((para) => <p class="story-body">{para}</p>)}
          </div>
        ))}
      </div>

      <!-- The numbers the prose leans on, so a reader can check them against the graph above. -->
      <dl class="story-figures">
        {figures.map((f) => (
          <div class="story-figure">
            <dt>{f.value}</dt>
            <dd><span class="story-figure-label">{f.label}</span>{f.note}</dd>
          </div>
        ))}
      </dl>

      <p class="story-coda">{STORY_CODA}</p>
    </div>
  </div>
</section>

<style>
  /* Full-bleed, so the paper panel is a surface the page passes through rather than a card sitting
     on the sky. No vertical padding: the panel itself must reach the section's edges, or a band of
     sky shows above and below it and the "turn the fluid off here" reads as a floating card.
     z-index lifts it over the SkyWash and .descent::after washes (both z-index:-1), so the fluid is
     completely hidden behind this slide rather than tinting the paper. */
  .story {
    position: relative;
    z-index: 1;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  /* THE PAPER GROUND. Two different colours by theme rather than one shared value:
     - light: a warm bone/oat that reads as printed stock against the luminous sky, NOT the same
       --paper as the text colour (which would vanish);
     - dark: a cool near-black slate a shade above --bg, so the panel is felt rather than seen. */
  .story-paper {
    /* DARKER THAN THE FIRST DRAFT, and this was measured rather than eyeballed. The owner: "in the
       light theme it might be better to have a darker background for the two bottom tabs, because when
       you pass the tagline the fluid is already mildly warm-dark, so getting back to full light is a
       sharp contrast."
       Sampled at the seam, light theme: the sky just above reads rgb(115,115,123), luminance 0.173,
       while the old #efe7d8 panel was 0.805 — a 4.5x jump at the boundary, which is exactly the snap
       back to full light he describes. This tone (0.482) more than halves it to 2.4x while keeping the
       ink at 8.7:1, far above the 4.5:1 floor. A toned printing stock rather than bright paper. */
    --story-bg: #c4b7a1;
    --story-edge: rgba(74, 66, 54, 0.26);
    --story-ink: #1f1b14;
    --story-ink-soft: #423b30;
    --story-ink-faint: #6a6153;
    --story-accent: #7c5522;
    /* The graph's own ink, dark-on-paper. The canvas reads these (see DescentPath) because its
       default tokens — --paper, --ink-3..5 — are LIGHT inks chosen for the dark sky, and on a light
       paper ground they render invisible. Same reason the panel can't reuse --paper as a background. */
    /* Darker than before to hold up on the toned ground: the old values were chosen against a near-white
       panel, and a 0.72-alpha mid-grey on 0.48 luminance stock loses the faint contour dots. */
    --story-line: rgba(46, 40, 31, 0.8);
    --story-line-soft: rgba(72, 64, 52, 0.7);

    background: var(--story-bg);
    border-top: 1px solid var(--story-edge);
    border-bottom: 1px solid var(--story-edge);
    padding: 9vh 0;
  }
  :global(html[data-theme='dark']) .story-paper {
    --story-bg: #14161a;
    --story-edge: rgba(184, 177, 161, 0.14);
    --story-ink: #dce1dc;
    --story-ink-soft: #a8b0a9;
    --story-ink-faint: #6d746e;
    --story-accent: #7fc9a0;
    --story-line: rgba(214, 220, 214, 0.66);
    --story-line-soft: rgba(160, 168, 161, 0.5);
  }

  /* The PROSE keeps a measure — long lines are unreadable, and this is a journal spread. It shares the
     graph's LEFT EDGE rather than being centred: the two are one slide, and a centred text block under
     a left-aligned drawing reads as two unrelated pieces. Centring also put the prose at x=260 while
     the graph began at x=43, which is what made the graph look pushed against the boundary. */
  .story-inner {
    width: 100%;
    margin: 0;
    padding-left: clamp(96px, 8.5vw, 168px);
    padding-right: clamp(16px, 2vw, 40px);
    box-sizing: border-box;
    max-width: none;
  }
  /* The prose itself keeps a comfortable measure inside that full-width box. */
  .story-cols, .story-figures, .story-coda, .story-title { max-width: 1300px; }

  /* The GRAPH does not. It is the showpiece and it was too small inside the text measure, so it spans
     the panel edge to edge; only enough side padding to keep the outermost labels off the edge. The
     header text inside it keeps the prose measure (see DescentPath), so the widening moves the DRAWING,
     not the reading.
     --deck-lead is read by the deck controller: the air above this slide's resting position. It is a
     custom property rather than scroll-margin-top because the deck scrolls with window.scrollTo(),
     which ignores scroll-margin — the title was coming to rest against the browser chrome. */
  .story-figure-slot {
    --deck-lead: 60px;
    width: 100%;
    /* INDENTED PAST THE RAIL, not merely padded off the viewport edge. Measured before this: the
       drawing began at x=43 while the fixed Toc occupies x=34..86 — they overlapped, which is why the
       graph read as jammed against the left boundary. The left inset now clears the rail with room to
       breathe; the right stays tight so the extra space goes to the DRAWING rather than to margin. */
    padding-left: clamp(96px, 8.5vw, 168px);
    padding-right: clamp(16px, 2vw, 40px);
    box-sizing: border-box;
    /* The gap below must exceed the LEAD PLUS whatever the slot is short of a full screen, or the next
       slide bleeds into this one's resting view. The stop sits 60px above the slot's top, so the
       viewport reaches 60px further down than the slot does; the stage is also deliberately shorter
       than the slide (leaving room for the cue), which adds to the shortfall.
       Measured at 1700x1050: slot 819px, rest at 1989, viewport reaches 3039 — and the editorial began
       at 2994, i.e. 45px inside the graph slide. Sized to clear both terms with room to spare. */
    margin: 0 0 max(22vh, 230px);
  }
  /* The editorial gets the same air when the deck rests on it. */
  .story-inner { --deck-lead: 60px; }

  /* ── THE "MORE BELOW" CUE, at the foot of the graph slide.
     Centred on the slide rather than the drawing, and low enough to read as an edge marker instead of a
     caption. Quiet by default; the arrow bobs under no-preference exactly like the hero's cue. */
  .story-next {
    position: absolute;
    left: 50%; bottom: 1.4vh;
    transform: translateX(-50%);
    display: inline-flex; flex-direction: column; align-items: center; gap: 7px;
    text-decoration: none;
    color: var(--story-ink-soft);
    z-index: 3;
    /* Its own ground. The drawing now spans the full slide, so the cue sits ON the contour dots and was
       unreadable against them — measured by eye against the settled frame, where "WHY THE CLIMB" ran
       straight through a band of ink. A soft pad of the panel colour clears just enough room without
       reading as a button. */
    padding: 10px 18px 8px;
    border-radius: 3px;
    background: radial-gradient(60% 60% at 50% 50%,
      color-mix(in srgb, var(--story-bg) 96%, transparent) 40%,
      color-mix(in srgb, var(--story-bg) 0%, transparent) 100%);
  }
  .story-next-label {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
  }
  /* A chevron from two borders — no glyph, no asset, and it inherits the ink. */
  .story-next-arrow {
    width: 8px; height: 8px;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
  }
  .story-next:hover { color: var(--story-ink); }
  .story-next:focus-visible { outline: 2px solid var(--story-accent); outline-offset: 6px; border-radius: 2px; }

  @media (prefers-reduced-motion: no-preference) {
    .story-next-arrow { animation: story-next-bob 2.6s ease-in-out 1s infinite; }
    @keyframes story-next-bob {
      0%, 100% { opacity: 0.55; transform: rotate(45deg) translate(0, 0); }
      50%      { opacity: 1;    transform: rotate(45deg) translate(3px, 3px); }
    }
  }
  /* The slot is the positioning context for the cue. */
  .story-figure-slot { position: relative; }

  .story-title {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(30px, 3.8vw, 54px);
    color: var(--story-ink); margin: 0 0 5vh;
    letter-spacing: -0.01em;
  }

  /* Two columns, because the piece IS a comparison: where I was, against where the signal was. A
     single measure makes the reader reconstruct that pairing themselves. */
  .story-cols {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0 clamp(32px, 5vw, 88px);
  }
  .story-col + .story-col {
    border-left: 1px solid var(--story-edge);
    padding-left: clamp(32px, 5vw, 88px);
  }
  @media (max-width: 860px) {
    .story-cols { grid-template-columns: 1fr; gap: 6vh 0; }
    .story-col + .story-col { border-left: 0; padding-left: 0; }
  }

  .story-kicker {
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--story-accent); margin: 0 0 18px;
  }
  /* ── TYPE SCALED UP to the proto-sketches register, which is the style the owner preferred.
     That sketch pulled its two focal sentences out at 34px on a 44px line (see lib/sketches/batch1.ts
     — the "forty-two sentences" frame, the only one that measured as not reading empty). The lead was
     26px here, which is a subtitle rather than a focal sentence. Now it tops out at 34px on a 1.32
     line, and the body follows to 17px: a journal spread's body is not a UI label. */
  .story-lead {
    font-family: var(--font-display); font-size: clamp(21px, 2.3vw, 34px);
    line-height: 1.32; color: var(--story-ink); margin: 0 0 26px;
    text-wrap: balance;
  }
  .story-body {
    font-size: clamp(15px, 1.15vw, 17px); line-height: 1.75; color: var(--story-ink-soft);
    margin: 0 0 18px; max-width: 52ch;
  }
  .story-body:last-child { margin-bottom: 0; }

  /* The figures: a measured row, mono, so they read as readings rather than as pull-quotes. */
  .story-figures {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 clamp(24px, 4vw, 64px);
    margin: 7vh 0 0; padding-top: 4vh; border-top: 1px solid var(--story-edge);
  }
  .story-figure dt {
    font-family: var(--font-mono); font-size: clamp(26px, 3vw, 40px);
    color: var(--story-accent); line-height: 1;
  }
  .story-figure dd {
    margin: 14px 0 0; font-size: 14px; line-height: 1.6; color: var(--story-ink-faint);
  }
  .story-figure-label {
    display: block; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--story-ink-soft); margin-bottom: 7px;
  }
  @media (max-width: 700px) {
    .story-figures { grid-template-columns: 1fr; gap: 4vh 0; }
  }

  .story-coda {
    margin: 7vh 0 0; max-width: 62ch;
    font-family: var(--font-display); font-style: italic;
    font-size: clamp(19px, 1.9vw, 26px); line-height: 1.55; color: var(--story-ink);
  }
</style>
