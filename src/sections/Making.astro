---
// src/sections/Making.astro
// WRITINGS AND PROJECTS — one slide, deliberately the quieter of the two.
//
// The owner's brief: "for projects, they are less important for a quant. So we will spend one tab
// listing my writings (coming next) and my projects."
//
// That ordering is the design. For a quant-research reader, code is supporting evidence rather than the
// headline — so this slide is smaller in every dimension than the research slide before it: no display-
// size question, tighter type, and the whole thing sized to what it actually has to say. Writings come
// first because they are the thing being promised; projects follow as things that already exist.
//
// WHAT KEEPS IT OFF THE RÉSUMÉ: each project leads with WHAT IT IS AND WHY IT EXISTS, in one sentence,
// not with a stack list or a date. The stack is available on /projects for anyone who wants it. "It
// exists in the world" is a different claim from "I was employed."
import { projects } from '../data/profile';
import { WRITINGS_PROMISE, WRITINGS_TOPICS, MAKING_INTRO } from '../data/making';

// One line per project, taken from its own tagline — the data already says the useful thing.
const shown = projects.slice(0, 3);
---
<section id="making" class="mk" aria-labelledby="mk-heading">
  <div class="mk-paper">
    <div class="mk-inner">
      <h2 id="mk-heading" class="mk-title">Writing, and things built</h2>
      <p class="mk-intro">{MAKING_INTRO}</p>

      <div class="mk-cols">
        <!-- WRITINGS FIRST: the thing being promised, stated honestly as not-yet-here. An empty
             promise is still more useful than a fake list, and the site's rule is honesty over
             flourish — so this says "coming" plainly and names what it will cover. -->
        <div class="mk-col">
          <div class="mk-col-head">
            <p class="mk-col-kicker">Writing</p>
            <span class="mk-tag">coming</span>
          </div>
          <p class="mk-promise">{WRITINGS_PROMISE}</p>
          <ul class="mk-topics">
            {WRITINGS_TOPICS.map((t) => <li>{t}</li>)}
          </ul>
        </div>

        <!-- PROJECTS SECOND, and briefly: one line each, then the door. -->
        <div class="mk-col">
          <div class="mk-col-head">
            <p class="mk-col-kicker">Built</p>
          </div>
          <ul class="mk-projects">
            {shown.map((p) => (
              <li class="mk-project">
                <span class="mk-project-name">{p.name}</span>
                <span class="mk-project-line">{p.tagline}</span>
              </li>
            ))}
          </ul>
          <a class="mk-link" href="/projects">
            All projects
            <span class="mk-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mk {
    position: relative;
    z-index: 1;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    --deck-lead: 0px;
  }

  .mk-paper {
    --mk-bg: #c4b7a1;
    --mk-edge: rgba(74, 66, 54, 0.26);
    --mk-ink: #1f1b14;
    --mk-ink-soft: #423b30;
    --mk-ink-faint: #6a6153;
    --mk-accent: #7c5522;

    background: var(--mk-bg);
    border-top: 1px solid var(--mk-edge);
    border-bottom: 1px solid var(--mk-edge);
    padding: clamp(60px, 9vh, 120px) 0;
  }
  :global(html[data-theme='dark']) .mk-paper {
    --mk-bg: #14161a;
    --mk-edge: rgba(184, 177, 161, 0.14);
    --mk-ink: #dce1dc;
    --mk-ink-soft: #a8b0a9;
    --mk-ink-faint: #6d746e;
    --mk-accent: #7fc9a0;
  }

  /* Same left edge as the other paper slides, clearing the fixed Toc rail (see Inquiry.astro for the
     measurement that set this value). */
  .mk-inner {
    padding-left: clamp(150px, 9.5vw, 190px);
    padding-right: clamp(20px, 2.4vw, 52px);
    box-sizing: border-box;
  }
  @media (max-width: 1099px) {
    .mk-inner { padding-left: clamp(28px, 6vw, 80px); }
  }

  /* SMALLER THAN THE RESEARCH SLIDE, on purpose: for a quant reader this is supporting evidence, and
     the hierarchy should say so. The research question runs to 40px; this title stops at 32. */
  .mk-title {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(24px, 2vw, 32px);
    line-height: 1.24; color: var(--mk-ink); margin: 0;
    letter-spacing: -0.005em;
  }
  .mk-intro {
    font-size: clamp(14.5px, 1vw, 16px); line-height: 1.7; color: var(--mk-ink-faint);
    margin: clamp(14px, 1.8vh, 22px) 0 0; max-width: 58ch;
  }

  .mk-cols {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0 clamp(32px, 4vw, 80px);
    margin: clamp(34px, 4.5vh, 58px) 0 0;
  }
  .mk-col + .mk-col {
    border-left: 1px solid var(--mk-edge);
    padding-left: clamp(32px, 4vw, 80px);
  }
  @media (max-width: 900px) {
    .mk-cols { grid-template-columns: 1fr; gap: 5vh 0; }
    .mk-col + .mk-col { border-left: 0; padding-left: 0; padding-top: 5vh; border-top: 1px solid var(--mk-edge); }
  }

  .mk-col-head { display: flex; align-items: baseline; gap: 12px; margin: 0 0 16px; }
  .mk-col-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--mk-accent); margin: 0;
  }
  /* "coming" as a real tag, not a parenthetical — it is a status, and stating it plainly is the site's
     honesty rule (the PhD is "incoming" everywhere for the same reason). */
  .mk-tag {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--mk-ink-faint);
    border: 1px solid var(--mk-edge); border-radius: 2px; padding: 2px 7px;
  }

  .mk-promise {
    font-family: var(--font-display); font-style: italic;
    font-size: clamp(16px, 1.3vw, 20px); line-height: 1.5;
    color: var(--mk-ink); margin: 0; max-width: 44ch;
  }
  .mk-topics {
    list-style: none; margin: clamp(16px, 2vh, 24px) 0 0; padding: 0;
    display: grid; gap: 9px;
  }
  .mk-topics li {
    font-size: 14px; line-height: 1.55; color: var(--mk-ink-soft);
    padding-left: 16px; position: relative;
  }
  /* A hairline dash rather than a bullet glyph — quieter, and it matches the section rules. */
  .mk-topics li::before {
    content: ""; position: absolute; left: 0; top: 0.68em;
    width: 8px; height: 1px; background: var(--mk-accent); opacity: 0.75;
  }

  .mk-projects { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(16px, 2vh, 22px); }
  .mk-project { display: grid; gap: 5px; }
  .mk-project-name {
    font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.02em; color: var(--mk-ink);
  }
  .mk-project-line {
    font-size: 14px; line-height: 1.62; color: var(--mk-ink-soft); max-width: 48ch;
  }

  .mk-link {
    display: inline-flex; align-items: baseline; gap: 9px;
    margin: clamp(20px, 2.6vh, 30px) 0 0;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; text-decoration: none;
    color: var(--mk-accent);
    border-bottom: 1px solid currentColor; padding-bottom: 3px;
  }
  .mk-arrow { transition: transform .28s cubic-bezier(.2,.7,.3,1); }
  @media (hover: hover) {
    .mk-link:hover .mk-arrow { transform: translateX(5px); }
  }
  .mk-link:focus-visible { outline: 2px solid var(--mk-accent); outline-offset: 4px; }
</style>
