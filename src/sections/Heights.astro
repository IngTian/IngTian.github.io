---
import { name, roles, rolesSub, phd, bio, links } from '../data/profile';
import { PAGES } from '../data/nav';
import TerrainHero from '../components/TerrainHero.astro';

// Build the bio as HTML with the "strong" phrases wrapped in medium weight.
// Plain string replace is safe here: content is static and trusted (our own data).
const strongify = (s: string) => {
  let out = s;
  for (const phrase of bio.strong) {
    out = out.replace(phrase, `<strong class="font-medium text-ink-2">${phrase}</strong>`);
  }
  return out;
};

// THE BIO IS SPLIT AT ITS FIRST CLAUSE, and only so the PHONE can stop after it.
// Measured against 17 portfolios at 390x664: no surveyed site puts a bio on screen one, and this one's
// 37-word paragraph was 39 of the 73 words a phone visitor met before scrolling (karpathy's bio starts at
// screen 4.1 of 16.2; joshwcomeau's is behind the hamburger). The remainder is not deleted — it is wrapped
// in a span that goes sr-only inside the phone query, so mobile-first indexing still reads every word
// (Google indexes visually-hidden responsive content; what it refuses is content that needs a tap to load)
// and a screen reader on a phone still hears the whole paragraph.
// THE SPAN IS LAYOUT-NEUTRAL ON DESKTOP, and that was verified rather than assumed: with the wrapper
// stripped back out in the live page, the paragraph's six line rows keep the same top, height, left and right
// to the pixel, in both themes, at 1440x900. An extra element boundary splits a line into two client rects
// without moving any of it.
// Split on the raw text BEFORE the strong-wrapping rather than on the built HTML: the wrapper is a tag with
// an attribute, and searching a comma inside markup is the kind of thing that breaks the day someone adds a
// class list with a comma in it. (A `strong` phrase that straddled the comma would simply not be emphasised —
// neither of the two does, and both halves are wrapped independently.)
const bioClauseEnd = bio.text.indexOf(',');
const bioHtml =
  bioClauseEnd < 0
    ? strongify(bio.text)
    : `${strongify(bio.text.slice(0, bioClauseEnd))}<span class="bio-rest">${strongify(bio.text.slice(bioClauseEnd))}</span>`;

// THE PHONE INDEX — the site's own page set plus the CV, imported rather than retyped so a sixth page
// appears here the day it appears in the nav. profile.ts owns the CV's URL for the same reason.
const cvHref = links.find((l) => l.label === 'Download CV')?.href ?? '/cv.pdf';
---
<section id="heights" class="relative min-h-[108vh] px-[7vw] pb-[12vh]">
  <TerrainHero />
  <!-- legibility: soft paper fades behind the name (bottom-left) and bio (top-right) -->
  <div class="hero-legibility" aria-hidden="true"></div>

  <!-- about-me, floated top-right; the empty diagonal to the name IS the composition -->
  <div class="hero-bio absolute top-[22vh] right-[7vw] max-w-[32ch] text-right">
    <p class="font-body text-ink-2/90 leading-[1.6] text-[clamp(13px,1.25vw,15.5px)]" set:html={bioHtml}></p>
  </div>

  <!-- name anchored bottom-left -->
  <div class="hero-rise absolute bottom-[16vh] left-[7vw] max-w-[88vw]">
    <h1 class="font-display text-ink-1 leading-[0.9] tracking-[-0.02em] text-[clamp(64px,12vw,132px)]"
        style="font-variation-settings:'opsz' 144,'SOFT' 60; text-shadow: 0 1px 18px rgba(22,20,15,0.06);">
      {name.first} <em class="italic text-ink-3 font-medium">{name.last}</em>
    </h1>
    <p class="font-display italic text-ink-3 mt-5 text-[clamp(15px,2.2vw,21px)]">{roles}</p>
    <p class="font-mono uppercase tracking-[0.22em] text-ink-3/90 mt-2.5 text-[11px]">{phd} &nbsp;·&nbsp; {rolesSub}</p>

    <!-- THE TAGLINE, directly under the role line. The owner: "maybe put A researcher by day tag line
         underneath the Quant Researcher · Portfolio Optimization."
         It now reads as the third beat of one introduction — who I am, what I work on, how I spend the day —
         instead of a line floating in the opposite corner. It is still two real LINKS, but they are no longer
         load-bearing navigation: the corner nav carries the page set at all times, so per the owner "the click
         stays an easter egg". That is what the marker-wash and underline affordances below are for — a reward
         for the curious rather than the only door in. -->
    <p class="hero-doors-line font-display italic text-ink-3 leading-[1.5] mt-4 text-[clamp(13.5px,1.35vw,17px)]">
      <a class="research-link" href="/research">A researcher by day</a>, <a class="art-link" href="/art">an artist by night</a>,<br />
      and a mathematician at heart.
    </p>
  </div>

  <!-- ── THE INDEX, ON SCREEN ONE. PHONE ONLY (display:none by default, switched on in the phone query). ──
       Measured, not guessed: on an iPhone 14 the homepage put exactly TWO links on the first screen, and both
       were camouflaged inside the tagline sentence ("A researcher by day" / "an artist by night"); the other
       eight sat at a median depth of 93% — the foot of a 5.93-screen scroll. Meanwhile the corner nav, which
       carries the real page set, collapses to a hamburger on a phone, so on the first screen there was
       nothing to tap and nothing that even looked tappable. The two patterns that work on a phone are an
       INDEX (leerob puts 13 of 15 links on screen one; Boyd's homepage IS 15 links and does not scroll;
       Chimero's IS a six-item menu) or chunked cards that are each a link out. This is the index.
       It does NOT replace the corner nav — that one is on every route and every scroll position. This is the
       homepage's answer to "where can I go" at the moment the visitor first asks it.
       Real markup rather than a JS enhancement, deliberately: the hamburger needs JavaScript to open, so a
       phone with JS off has no navigation at all today. These six links work without it.
       The tagline above keeps its two links as the easter egg the owner asked for ("the click stays an easter
       egg") — they are no longer the only door. -->
  <nav class="hero-index" aria-label="Site pages">
    <ul>
      {PAGES.map((p) => (
        <li><a href={p.href}>{p.label}</a></li>
      ))}
      {/* The CV is the one destination that is not a page, and the one a recruiter is most likely to want.
          Last in the row so the site's hierarchy still reads research-first, marked by an accent hairline and
          the download glyph rather than by a filled button — a solid accent chip would be the loudest thing
          in the hero, and the hero is a composition. */}
      <li>
        <a class="hx-cv" href={cvHref} target="_blank" rel="noopener noreferrer" aria-label="Download CV"
          >CV<span class="hx-arrow" aria-hidden="true">↓</span></a
        >
      </li>
    </ul>
  </nav>

  <div class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 font-mono text-ink-4 text-[11px] tracking-[0.2em]">scroll</div>
</section>

<style>
  /* ── THE DOORWAY AFFORDANCES, moved here with the links themselves. Both are real navigation and each
     announces itself differently: an ochre marker wash sweeps behind "researcher by day", an underline
     draws under "artist by night". Transform-only, and the reduced-motion state shows them statically so
     the affordance is never lost. */
  /* Quiet doorway: ink text with an underline that draws in from the left on
     hover/focus. No color shift (the seal stays reserved for the seal mark). */
  .art-link {
    color: inherit;
    text-decoration: none;
    position: relative;
    white-space: nowrap;
  }
  .art-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.06em;
    width: 100%;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .art-link:hover::after,
  .art-link:focus-visible::after { transform: scaleX(1); }
  /* keyboard focus stays visible even where transitions are reduced */
  .art-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 2px; }
  /* reduced motion / no animation-timeline: show the underline statically so
     the affordance is never lost, just without the draw-in sweep */
  @media (prefers-reduced-motion: reduce) {
    .art-link::after { transition: none; }
    .art-link:hover::after, .art-link:focus-visible::after { transform: scaleX(1); }
  }

  /* The "day" doorway → /research. A DIFFERENT affordance from the artist
     underline: a soft ochre highlighter wash sweeps in BEHIND the words on
     hover/focus (like a marker stroke), then the text rides on top. Transform-
     only; the seal red stays reserved. */
  .research-link {
    color: inherit;
    text-decoration: none;
    position: relative;
    white-space: nowrap;
    isolation: isolate; /* keep the wash's z-index local to this link */
  }
  .research-link::before {
    content: "";
    position: absolute;
    left: -0.12em;
    right: -0.12em;
    bottom: 0.02em;
    height: 0.62em;        /* a marker stripe over the lower part of the text */
    background: var(--ochre);
    opacity: 0.34;
    border-radius: 1px;
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.42s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .research-link:hover::before,
  .research-link:focus-visible::before { transform: scaleX(1); }
  .research-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .research-link::before { transition: none; }
    .research-link:hover::before, .research-link:focus-visible::before { transform: scaleX(1); }
  }

  /* ── A ONE-TIME HINT that the two phrases are doors.
     Both already have hover affordances — an ochre marker wash on "day", an underline draw on
     "night" — but neither ANNOUNCES itself, so a visitor who never hovers never learns they are
     links. This plays each affordance once, in sequence, shortly after the line scrolls in, and then
     leaves them alone: an invitation rather than an animation. Transform-only, and it never runs
     under reduced motion (where both affordances are already shown statically). */
  @media (prefers-reduced-motion: no-preference) {
    .research-link::before {
      animation: hint-wash 3.2s cubic-bezier(0.2, 0.7, 0.2, 1) 1.1s 1 both;
    }
    .art-link::after {
      animation: hint-underline 3.2s cubic-bezier(0.2, 0.7, 0.2, 1) 2.0s 1 both;
    }
    /* Hover must win over the hint at any point, including mid-play. */
    .research-link:hover::before, .research-link:focus-visible::before,
    .art-link:hover::after, .art-link:focus-visible::after { animation: none; }

    @keyframes hint-wash {
      0%   { transform: scaleX(0); }
      22%  { transform: scaleX(1); }
      62%  { transform: scaleX(1); }
      100% { transform: scaleX(0); }
    }
    @keyframes hint-underline {
      0%   { transform: scaleX(0); }
      22%  { transform: scaleX(1); }
      62%  { transform: scaleX(1); }
      100% { transform: scaleX(0); }
    }
  }

  /* The quant line: same voice as the tagline, a step down in size and weight. Generous space above
     so it reads as a second beat rather than a subtitle glued to the line. */
  /* TerrainHero is position:absolute inset:0 z-0; keep text above it. */
  #heights .hero-rise, #heights .hero-bio { position: absolute; z-index: 2; }
  .hero-legibility {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      /* name halo, bottom-left. Pulled up to 74% and tightened so the wash
         reaches fully transparent (~94% of the box) BEFORE the #heights bottom
         edge (108vh). Otherwise it was still ~0.12 opaque at the box boundary
         and got clipped in a straight horizontal line — that hard cut read as
         a faint divider at the hero/interlude seam.
         Uses --paper so it lifts the LIGHT text on the pale dawn; dark themes
         override below to a soft DARKEN behind the now-light text instead. */
      radial-gradient(40% 26% at 22% 74%, color-mix(in oklab, var(--paper) 85%, transparent), transparent 66%),
      radial-gradient(30% 22% at 82% 22%, color-mix(in oklab, var(--paper) 70%, transparent), transparent 72%);
  }
  /* Dark themes: the halo must DARKEN behind the light hero text, not brighten
     — a paper blob on a night sky would be a glaring smear. Swap to a soft
     near-black veil at the same anchor points. */
  :global(html[data-theme='dark']) .hero-legibility {
    background:
      radial-gradient(44% 30% at 22% 74%, color-mix(in oklab, var(--bg) 62%, transparent), transparent 68%),
      radial-gradient(34% 24% at 82% 22%, color-mix(in oklab, var(--bg) 46%, transparent), transparent 74%);
  }

  /* THE PHONE INDEX IS OFF EVERYWHERE BY DEFAULT. This is the one new rule outside a phone query, and it has
     to be: a phone-only element must be hidden by the rule that applies when no media query matches, so a
     desktop renders nothing at all rather than relying on a query to take it away. display:none also keeps
     the six links out of the desktop tab order and out of its accessibility tree, which is the part a
     screenshot would never show. The phone query below turns it into a flex row. */
  .hero-index { display: none; }

  /* Mobile: a diagonal can't hold — collapse to a single LEFT-aligned stack
     (bio under the name), never re-centered. Static flow replaces the absolute
     positioning below the sm breakpoint. */
  /* THE SHORT-VIEWPORT CASE IS A PHONE TOO — it is the same phone, turned sideways. The stack below is keyed
     on width alone, so a landscape iPhone (844x390, 932x430) fell through it and got the DESKTOP hero: two
     absolutely-positioned blocks placed for a tall screen, on a viewport 390px tall. The bio then printed
     straight across the "Ing Tian" wordmark — the one case on the site where the owner's word "scrambled" was
     literally true, rather than a frosted overlap.
     Height is the right test rather than `orientation: landscape`: what breaks the diagonal composition is
     not being wider than tall, it is not having the vertical room for a name above a bio. A short desktop
     window has the same problem and now gets the same answer. 520px is the measured floor — the desktop hero
     needs roughly that much to place both blocks without them meeting. */
  @media (max-width: 640px), (max-height: 520px) {
    /* padding-top CLEARS THE CORNER NAV, and without it the site's own name was unreadable. This column is
       justify-content: flex-end, so when its content is taller than min-height the overflow goes out of the TOP
       — and on a small phone it does. Measured at 320x568: the h1 sat at y=32..90 while the nav capsule, wrapped
       to two rows, occupies y=12..80, so 48 of the name's 58px were behind it and "Ing Tian" was legible only
       from the g's descender. Dark theme identical.
       Padding rather than switching to flex-start: it fixes BOTH cases. When the content overflows, the box grows
       and the name starts below the padding; when it fits, flex-end still parks the block at the foot of the
       screen, which is the hero's intended composition. */
    #heights { display: flex; flex-direction: column; justify-content: flex-end; gap: 1.75rem; padding-top: 96px; padding-bottom: 16vh; }
    #heights .hero-bio,
    #heights .hero-rise { position: static; inset: auto; max-width: 100%; text-align: left; right: auto; }
    #heights .hero-bio { order: 2; }
    #heights .hero-rise { order: 1; }
    /* A WASH TUNED TO THE STACKED HERO, rather than none at all. The desktop halos are placed for the desktop
       composition — one at 22% 74% for a name at bottom-left, one top-right for the bio — and mean nothing once
       the hero becomes a single column, which is why they were switched off here. But switching them off left the
       terrain as the only thing between the dots and the type, and the review found the 11px mono identity line
       ("INCOMING PHD · UNIVERSITY OF TORONTO · FULL-STACK SDE / MLE") largely obliterated by the dense dot
       cluster that runs straight through it. That line carries the incoming PhD, which the site's hierarchy
       treats as load-bearing, so it cannot be atmosphere's to lose.
       Lowering the canvas alone was not enough — measured at 0.32 the line was still broken up — so this is a
       vertical band of paper across the middle, where every piece of hero text sits, fading out top and bottom so
       the terrain still reads as terrain above and below it. */
    #heights .hero-legibility {
      display: block;
      background: linear-gradient(
        180deg,
        transparent 0%,
        color-mix(in oklab, var(--paper) 62%, transparent) 14%,
        color-mix(in oklab, var(--paper) 62%, transparent) 82%,
        transparent 100%
      );
    }
    /* THE SAME BAND, DARKENING, FOR THE DARK THEME — and it must be written HERE, at this specificity, or it
       does nothing. This was the worst bug on the phone: in dark theme every hero line except "Ing" measured
       1.1-1.6:1 against the rendered pixels ("Tian" 1.12, the role line 1.18, the whole bio ~1.6) — a
       light-grey fog, on the FIRST SCREEN, for anyone whose phone is in dark mode. Since the theme follows
       prefers-color-scheme, that is most people.
       The cause was not a missing rule but a losing one. The dark override above is
       `html[data-theme='dark'] .hero-legibility` = (0,2,0), while the phone band is `#heights
       .hero-legibility` = (1,1,0). The ID wins, so on a phone the PAPER band painted over the dark page and
       under the light text, collapsing both to the same luminance. The text colours were never wrong:
       rgb(220,225,220) on rgb(22,25,29) is about 10:1 — the wash sat between them.
       Adding #heights here makes this (1,2,0), and it is placed after the rule it overrides, because at equal
       specificity source order decides and getting that backwards has silently cost this project several
       fixes. Darkens rather than brightens, matching what the desktop dark halo already does behind light
       text. Measured after: every hero run >= 4.5:1. */
    :global(html[data-theme='dark']) #heights .hero-legibility {
      background: linear-gradient(
        180deg,
        transparent 0%,
        color-mix(in oklab, var(--bg) 72%, transparent) 14%,
        color-mix(in oklab, var(--bg) 72%, transparent) 82%,
        transparent 100%
      );
    }
    #heights .terrain-canvas { opacity: 0.4; }
  }

  /* ══════════════════════════════════════════════════════════════════════════════════════════════════════
     THE PHONE HERO: FIVE TYPE SIZES, ONE INDEX, AND A BIO THAT STOPS AT ITS FIRST CLAUSE.

     Width-only, and separate from the block above on purpose. That one is `(max-width: 640px), (max-height:
     520px)` because a landscape phone breaks the diagonal composition the same way a portrait one does — but
     `max-height: 520px` also matches a SHORT DESKTOP WINDOW, and the type scale and the index below are phone
     decisions, not short-window decisions. Putting them here keeps a 1440x500 window byte-identical to
     production, which is the standing rule for this round.
     Written AFTER the block it overrides, because at equal specificity source order decides and getting that
     backwards has silently cost this project several fixes.

     WHY ANY OF THIS. Measured across 17 portfolios in real WebKit at 390x664: this hero was not too WORDY —
     the page is 5.93 screens, a third below the 15-site median — it was too LOUD and too SMALL AT ONCE. A
     64px name over a 13px tagline is a 4.9x jump inside 480px of screen, and 21 distinct font sizes render on
     the page where Chimero uses one and Pentagram three. That contrast, not the word count, is what reads as
     "way too many texts". The measured ceiling for a name in those 17 sites is 36px (brittanychiang 36,
     tobiasahlin 34); every type-led site sets body at 16-17px with zero variance.
     So the hero now uses exactly three of the five scale sizes plus the mono kicker:
        36 name  ·  22 role  ·  16 prose  ·  11 mono kicker.
     ══════════════════════════════════════════════════════════════════════════════════════════════════════ */
  @media (max-width: 640px) {
    /* THE NAME, AT THE MEASURED CEILING. A flat 36px rather than a re-clamped `clamp(36px, 12vw, …)`: 12vw is
       46.8px at 390 and 51.6px at 430, so the min would never bind on the phones that matter, and the desktop
       utility class stays untouched so its rendering cannot drift. Loses ~25px of height (57.6 → 32.4 at
       line-height 0.9), which is most of what pays for the index row. */
    #heights h1 { font-size: var(--ph-name); }
    /* The role — the scale's section size, one step down from the name instead of four. Its own line-height,
       because at 22px the inherited body leading opened a gap that read as a paragraph break.
       `text-wrap: balance` is not a nicety here: at 22px the line wraps, and the greedy break put "Quant
       Researcher · Portfolio" over a one-word "Optimization" (measured 282px + 130px at 390 and at 430).
       Balanced it breaks at the "·" instead — 190px + 222px, the two halves of the title kept whole — at the
       same two-line height of 52px. Older WebKits that do not support it simply keep the greedy break. */
    #heights .hero-rise > p:first-of-type {
      font-size: var(--ph-section);
      line-height: 1.18;
      text-wrap: balance;
    }
    /* The tagline, off 13.5px small print and onto the body size — it is the one editorial line on the page
       and it was the smallest prose in the hero. */
    #heights .hero-doors-line { font-size: var(--ph-body); }
    /* (The 11px mono identity line is left exactly as it is: it is a kicker, and 11px mono is the one size
       the phone scale allows below 13px.) */

    /* THE BIO STOPS AFTER ITS FIRST CLAUSE — sr-only, not deleted. Tailwind's own sr-only pattern (1px box +
       clip-path) rather than display:none, so the sentence stays in the accessibility tree and a phone screen
       reader still hears the whole paragraph. Absolutely positioned, so it cannot affect the line box it came
       out of; its containing block is #heights (position:relative), and at 1px square with the clip applied
       it can never contribute overflow.
       `:global()` IS LOAD-BEARING, and the first version of this rule did nothing without it: the span is
       injected through `set:html`, so Astro never stamps it with the component's [data-astro-cid-…]
       attribute, and a plainly-written `#heights .bio-rest` compiles to a selector that cannot match it.
       Measured before the fix: the remainder still printed, and the bio still filled four lines at 390px. */
    #heights .hero-bio :global(.bio-rest) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* ── THE INDEX ROW ──
       order: 3 puts it after the name block (1) and the bio clause (2), which is both the composition the
       owner asked for — name, role, one line, then the doors — and the right ergonomics: it lands in the
       bottom third of the screen, where a thumb already is. */
    /* z-index: 2 IS NOT DECORATION — without it the row measured 2.17:1 and looked like a ghost.
       #heights is `display: flex` here, so its children are FLEX ITEMS, and z-index applies to a flex item
       even at position:static. That is how `.hero-rise` / `.hero-bio` keep their z-index:2 from the desktop
       rule after the phone block resets them to static, and it is what lifts them above the terrain canvas
       (positioned, z 0) and the paper legibility band (positioned, z 1) — both of which otherwise paint AFTER
       in-flow content and therefore over it. A new flex item with z-index:auto lands underneath both: measured
       in WebKit at 390px, the "Research" label's darkest rendered pixel was rgb(163,156,148) against
       rgb(47,43,36) as declared, i.e. 2.17:1 where the bio one line above it was 11.21:1. With z-index:2 it
       measures 11.2:1. Nothing about the declared colours was wrong; the paint order was. */
    #heights .hero-index { display: block; order: 3; z-index: 2; }
    #heights .hero-index ul {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    #heights .hero-index li { display: flex; }
    /* 44px MINIMUM, which is Apple's guideline and the same floor the corner nav's phone rows were measured
       to. min-height rather than vertical padding so a wrapped label can never shrink the target. */
    #heights .hero-index a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 14px;
      border-radius: 999px;
      border: 1px solid color-mix(in oklab, var(--ink-3) 34%, transparent);
      /* Its own faint paper frost, so a label never has to compete with the terrain dots. It is not
         redundant with the legibility band above: that band starts fading at 82% of the section, which at
         390x664 is y=544, and the row runs y=462..558 — its second line sits in the fade. Measured with the
         frost: 11.2:1 light, 14.5:1 dark. */
      background: color-mix(in oklab, var(--paper) 58%, transparent);
      color: var(--ink-2);
      font-family: var(--font-body);
      font-size: var(--ph-body);
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
      transition: border-color 0.3s ease, background-color 0.3s ease, color 0.3s ease;
      -webkit-tap-highlight-color: color-mix(in oklab, var(--ochre) 26%, transparent);
    }
    #heights .hero-index .hx-cv { border-color: color-mix(in oklab, var(--ochre) 62%, transparent); }
    #heights .hero-index .hx-arrow { margin-left: 6px; opacity: 0.65; }
    /* Touch feedback, and a real focus ring for keyboard/switch access. Colour only — nothing here animates
       a filter or a layout property. */
    #heights .hero-index a:active {
      background: color-mix(in oklab, var(--ochre) 26%, var(--paper));
      border-color: var(--ochre);
      color: var(--ink-1);
    }
    #heights .hero-index a:focus-visible {
      outline: 2px solid var(--ochre);
      outline-offset: 2px;
      color: var(--ink-1);
    }

