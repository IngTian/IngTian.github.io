---
import { name, roles, rolesSub, phd, bio } from '../data/profile';
import TerrainHero from '../components/TerrainHero.astro';

// Build the bio as HTML with the "strong" phrases wrapped in medium weight.
// Plain string replace is safe here: content is static and trusted (our own data).
let bioHtml = bio.text;
for (const phrase of bio.strong) {
  bioHtml = bioHtml.replace(phrase, `<strong class="font-medium text-ink-2">${phrase}</strong>`);
}
---
<section id="heights" class="relative min-h-[108vh] px-[7vw] pb-[12vh]">
  <TerrainHero />
  <!-- legibility: soft paper fades behind the name (bottom-left) and bio (top-right) -->
  <div class="hero-legibility" aria-hidden="true"></div>

  <!-- about-me, floated top-right; the empty diagonal to the name IS the composition -->
  <div class="hero-bio absolute top-[22vh] right-[7vw] max-w-[32ch] text-right">
    <p class="font-body text-ink-2/90 leading-[1.6] text-[clamp(13px,1.25vw,15.5px)]" set:html={bioHtml}></p>
  </div>

  <!-- name anchored bottom-left -->
  <div class="hero-rise absolute bottom-[16vh] left-[7vw] max-w-[88vw]">
    <h1 class="font-display text-ink-1 leading-[0.9] tracking-[-0.02em] text-[clamp(64px,12vw,132px)]"
        style="font-variation-settings:'opsz' 144,'SOFT' 60; text-shadow: 0 1px 18px rgba(22,20,15,0.06);">
      {name.first} <em class="italic text-ink-3 font-medium">{name.last}</em>
    </h1>
    <p class="font-display italic text-ink-3 mt-5 text-[clamp(15px,2.2vw,21px)]">{roles}</p>
    <p class="font-mono uppercase tracking-[0.22em] text-ink-3/90 mt-2.5 text-[11px]">{phd} &nbsp;·&nbsp; {rolesSub}</p>

    <!-- THE TAGLINE, directly under the role line. The owner: "maybe put A researcher by day tag line
         underneath the Quant Researcher · Portfolio Optimization."
         It now reads as the third beat of one introduction — who I am, what I work on, how I spend the day —
         instead of a line floating in the opposite corner. It is still two real LINKS, but they are no longer
         load-bearing navigation: the corner nav carries the page set at all times, so per the owner "the click
         stays an easter egg". That is what the marker-wash and underline affordances below are for — a reward
         for the curious rather than the only door in. -->
    <p class="hero-doors-line font-display italic text-ink-3 leading-[1.5] mt-4 text-[clamp(13.5px,1.35vw,17px)]">
      <a class="research-link" href="/research">A researcher by day</a>, <a class="art-link" href="/art">an artist by night</a>,<br />
      and a mathematician at heart.
    </p>
  </div>

  <div class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 font-mono text-ink-4 text-[11px] tracking-[0.2em]">scroll</div>
</section>

<style>
  /* ── THE DOORWAY AFFORDANCES, moved here with the links themselves. Both are real navigation and each
     announces itself differently: an ochre marker wash sweeps behind "researcher by day", an underline
     draws under "artist by night". Transform-only, and the reduced-motion state shows them statically so
     the affordance is never lost. */
  /* Quiet doorway: ink text with an underline that draws in from the left on
     hover/focus. No color shift (the seal stays reserved for the seal mark). */
  .art-link {
    color: inherit;
    text-decoration: none;
    position: relative;
    white-space: nowrap;
  }
  .art-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.06em;
    width: 100%;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .art-link:hover::after,
  .art-link:focus-visible::after { transform: scaleX(1); }
  /* keyboard focus stays visible even where transitions are reduced */
  .art-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 2px; }
  /* reduced motion / no animation-timeline: show the underline statically so
     the affordance is never lost, just without the draw-in sweep */
  @media (prefers-reduced-motion: reduce) {
    .art-link::after { transition: none; }
    .art-link:hover::after, .art-link:focus-visible::after { transform: scaleX(1); }
  }

  /* The "day" doorway → /research. A DIFFERENT affordance from the artist
     underline: a soft ochre highlighter wash sweeps in BEHIND the words on
     hover/focus (like a marker stroke), then the text rides on top. Transform-
     only; the seal red stays reserved. */
  .research-link {
    color: inherit;
    text-decoration: none;
    position: relative;
    white-space: nowrap;
    isolation: isolate; /* keep the wash's z-index local to this link */
  }
  .research-link::before {
    content: "";
    position: absolute;
    left: -0.12em;
    right: -0.12em;
    bottom: 0.02em;
    height: 0.62em;        /* a marker stripe over the lower part of the text */
    background: var(--ochre);
    opacity: 0.34;
    border-radius: 1px;
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.42s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .research-link:hover::before,
  .research-link:focus-visible::before { transform: scaleX(1); }
  .research-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .research-link::before { transition: none; }
    .research-link:hover::before, .research-link:focus-visible::before { transform: scaleX(1); }
  }

  /* ── A ONE-TIME HINT that the two phrases are doors.
     Both already have hover affordances — an ochre marker wash on "day", an underline draw on
     "night" — but neither ANNOUNCES itself, so a visitor who never hovers never learns they are
     links. This plays each affordance once, in sequence, shortly after the line scrolls in, and then
     leaves them alone: an invitation rather than an animation. Transform-only, and it never runs
     under reduced motion (where both affordances are already shown statically). */
  @media (prefers-reduced-motion: no-preference) {
    .research-link::before {
      animation: hint-wash 3.2s cubic-bezier(0.2, 0.7, 0.2, 1) 1.1s 1 both;
    }
    .art-link::after {
      animation: hint-underline 3.2s cubic-bezier(0.2, 0.7, 0.2, 1) 2.0s 1 both;
    }
    /* Hover must win over the hint at any point, including mid-play. */
    .research-link:hover::before, .research-link:focus-visible::before,
    .art-link:hover::after, .art-link:focus-visible::after { animation: none; }

    @keyframes hint-wash {
      0%   { transform: scaleX(0); }
      22%  { transform: scaleX(1); }
      62%  { transform: scaleX(1); }
      100% { transform: scaleX(0); }
    }
    @keyframes hint-underline {
      0%   { transform: scaleX(0); }
      22%  { transform: scaleX(1); }
      62%  { transform: scaleX(1); }
      100% { transform: scaleX(0); }
    }
  }

  /* The quant line: same voice as the tagline, a step down in size and weight. Generous space above
     so it reads as a second beat rather than a subtitle glued to the line. */
  /* TerrainHero is position:absolute inset:0 z-0; keep text above it. */
  #heights .hero-rise, #heights .hero-bio { position: absolute; z-index: 2; }
  .hero-legibility {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      /* name halo, bottom-left. Pulled up to 74% and tightened so the wash
         reaches fully transparent (~94% of the box) BEFORE the #heights bottom
         edge (108vh). Otherwise it was still ~0.12 opaque at the box boundary
         and got clipped in a straight horizontal line — that hard cut read as
         a faint divider at the hero/interlude seam.
         Uses --paper so it lifts the LIGHT text on the pale dawn; dark themes
         override below to a soft DARKEN behind the now-light text instead. */
      radial-gradient(40% 26% at 22% 74%, color-mix(in oklab, var(--paper) 85%, transparent), transparent 66%),
      radial-gradient(30% 22% at 82% 22%, color-mix(in oklab, var(--paper) 70%, transparent), transparent 72%);
  }
  /* Dark themes: the halo must DARKEN behind the light hero text, not brighten
     — a paper blob on a night sky would be a glaring smear. Swap to a soft
     near-black veil at the same anchor points. */
  :global(html[data-theme='dark']) .hero-legibility {
    background:
      radial-gradient(44% 30% at 22% 74%, color-mix(in oklab, var(--bg) 62%, transparent), transparent 68%),
      radial-gradient(34% 24% at 82% 22%, color-mix(in oklab, var(--bg) 46%, transparent), transparent 74%);
  }

  /* Mobile: a diagonal can't hold — collapse to a single LEFT-aligned stack
     (bio under the name), never re-centered. Static flow replaces the absolute
     positioning below the sm breakpoint. */
  @media (max-width: 640px) {
    #heights { display: flex; flex-direction: column; justify-content: flex-end; gap: 1.75rem; padding-bottom: 16vh; }
    #heights .hero-bio,
    #heights .hero-rise { position: static; inset: auto; max-width: 100%; text-align: left; right: auto; }
    #heights .hero-bio { order: 2; }
    #heights .hero-rise { order: 1; }
    #heights .hero-legibility { display: none; }
    #heights .terrain-canvas { opacity: 0.5; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-rise { animation: hero-rise 1.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .hero-bio  { animation: hero-rise 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both; }
    @keyframes hero-rise {
      from { opacity: 0; transform: translate3d(0, 16px, 0); }
      to   { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    .scroll-cue { animation: cue-bob 2.6s ease-in-out 1.4s infinite; }
    @keyframes cue-bob {
      0%, 100% { opacity: 0.5; transform: translate(-50%, 0); }
      50%      { opacity: 1;   transform: translate(-50%, 6px); }
    }
  }
</style>
