---
// src/sections/Lesson.astro
// SLIDE 1 — WHAT THE TOPIC IS. Assets with pixel marks, one big question, then candidate strategies with
// their actual multi-period paths.
//
// The owner's layout, verbatim: "the slide opens with a handful of assets, each with pixel art images, then
// followed by a Big question, 'How would you invest?' then these moves on to the left, on the right you can
// show a few strategies and their prospective return curve etc."
//
// And the correction that reshaped the content: "seems like we didnt bake in multi period at all for the
// examples." Right — the previous version offered four FIXED MIXES, which is a one-shot choice, the exact
// thing multi-period optimisation is not. Each candidate here is a RULE that decides again every period and
// pays for changing its mind, and the curves are what those rules actually produce (lib/multiperiod.ts,
// 28 tests).
//
// WHAT THE CURVES SHOW, and why it is not a flattering result. Measured in this declared world: buying only
// equities ends HIGHEST at 1.35x — and pays a 22% drawdown to get there, while the optimised rule ends at
// 1.26x with 0.5%. The honest lesson is that the highest curve is not automatically the one you want, and
// the copy says exactly that. A test asserts the naive rule wins on raw return, so this cannot quietly drift
// into "mine is best".
//
// The cow is a VOICE in a pill (the existing easter-egg idiom), never a drawn animal — three attempts at
// hand-authored illustration have been rejected on this project.
import { ASSET_GLYPHS, type AssetGlyphKey } from '../data/assetGlyphs';
import { TOY_ASSETS, PERIOD_RETURNS, runRule, finalValue, realisedVol, maxDrawdown } from '../lib/multiperiod';
import { RULES, COST_PER_TURNOVER } from '../data/rules';
import { COW_LINES } from '../data/lesson';

// Everything is computed at BUILD time — the return table is declared, so the paths are deterministic and
// the client ships numbers rather than a solver.
const paths = RULES.map((r) => {
  const path = runRule(r, PERIOD_RETURNS, COST_PER_TURNOVER);
  return {
    key: r.key,
    label: r.label,
    gloss: r.gloss,
    isTarget: !!r.isTarget,
    final: finalValue(path),
    vol: realisedVol(path),
    dd: maxDrawdown(path),
    // Screen-space polyline for an inline SVG sparkline, computed here so the client draws nothing.
    points: path,
  };
});

// One shared scale across all four sparklines, or they cannot be compared.
const lo = Math.min(1, ...paths.flatMap((p) => p.points.map((q) => q.value)));
const hi = Math.max(...paths.flatMap((p) => p.points.map((q) => q.value)));
const SW = 100, SH = 30;
const spark = (pts: { t: number; value: number }[]) => {
  const tMax = pts[pts.length - 1].t || 1;
  return pts
    .map((q) => {
      const x = (q.t / tMax) * SW;
      const y = SH - ((q.value - lo) / (hi - lo || 1)) * SH;
      return `${x.toFixed(2)},${y.toFixed(2)}`;
    })
    .join(' ');
};

const CELL = 3;   // px per pixel-art cell
---
<section id="lesson" class="ls" aria-labelledby="ls-heading">
  <div class="ls-paper">
    <div class="ls-inner">
      <div class="ls-split">
        <!-- LEFT: the assets, then the question. This is the reading order the owner asked for — you meet
             the ingredients before you are asked what to do with them. -->
        <div class="ls-ask">
          <p class="ls-kicker">The topic</p>

          <ul class="ls-assets">
            {TOY_ASSETS.map((a) => {
              const g = ASSET_GLYPHS[a.key as AssetGlyphKey];
              return (
                <li class="ls-asset">
                  <!-- The pixel mark: a matrix of cells compiled from data (lib/pixels.ts), rendered as
                       rects. Not a drawing — a diagram of what the asset does. -->
                  <svg
                    class="ls-glyph"
                    viewBox={`0 0 ${g.w * CELL} ${g.h * CELL}`}
                    width={g.w * CELL}
                    height={g.h * CELL}
                    aria-hidden="true"
                    shape-rendering="crispEdges"
                  >
                    {g.cells.map((c) => (
                      <rect x={c.x * CELL} y={c.y * CELL} width={CELL} height={CELL} />
                    ))}
                  </svg>
                  <span class="ls-asset-name">{a.label}</span>
                  <span class="ls-asset-num">{Math.round(a.mu * 100)}% <span class="ls-dim">return</span></span>
                  <span class="ls-asset-num">{Math.round(a.sigma * 100)}% <span class="ls-dim">swing</span></span>
                </li>
              );
            })}
          </ul>
          <p class="ls-illus">Illustrative long-run figures, rounded — the shape of the problem, not anyone’s results.</p>

          <!-- THE BIG QUESTION. -->
          <h2 id="ls-heading" class="ls-question">How would you invest?</h2>
          <p class="ls-lede">
            And then — because the year does not end — how would you change it next period, knowing every
            change costs you {(COST_PER_TURNOVER * 10000).toFixed(0)}bp of whatever you move?
          </p>

          <div class="ls-cow">
            <button
              type="button"
              class="ls-cow-btn"
              data-cow
              data-lines={JSON.stringify(COW_LINES)}
              aria-live="polite"
            >
              <span class="ls-cow-mark" aria-hidden="true">◕</span>
              <span class="ls-cow-say" data-cow-say>{COW_LINES[0]}</span>
            </button>
            <span class="ls-cow-hint" aria-hidden="true">ask again</span>
          </div>
        </div>

        <!-- RIGHT: four rules, each with the path it actually produces. -->
        <div class="ls-answers">
          <p class="ls-kicker">Four rules, twelve periods, same world</p>
          <ul class="ls-rules">
            {paths.map((p) => (
              <li class:list={['ls-rule', p.isTarget && 'is-target']}>
                <div class="ls-rule-head">
                  <span class="ls-rule-name">{p.label}</span>
                  <svg class="ls-spark" viewBox={`0 0 ${SW} ${SH}`} preserveAspectRatio="none" aria-hidden="true">
                    <polyline points={spark(p.points)} />
                  </svg>
                  <span class="ls-rule-final">{p.final.toFixed(2)}×</span>
                </div>
                <p class="ls-rule-gloss">{p.gloss}</p>
                <p class="ls-rule-stats">
                  <span>worst fall <strong>{(p.dd * 100).toFixed(1)}%</strong></span>
                  <span>swing <strong>{(p.vol * 100).toFixed(1)}%</strong></span>
                </p>
              </li>
            ))}
          </ul>
          <p class="ls-punch">
            The tallest curve is not the answer. Buying only equities ends highest and falls
            {' '}{(Math.abs(paths[0].dd) * 100).toFixed(0)}% on the way; the optimised rule gives up a little
            to fall {(Math.abs(paths[3].dd) * 100).toFixed(1)}%. Which one is right depends on what you can
            survive — and that is a question with a mathematical answer.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ls {
    position: relative; z-index: 1;
    width: 100vw; margin-left: calc(50% - 50vw);
    --deck-lead: 0px;
  }
  .ls-paper {
    --ls-bg: #c4b7a1;
    --ls-edge: rgba(74, 66, 54, 0.26);
    --ls-ink: #1f1b14;
    --ls-ink-soft: #423b30;
    --ls-ink-faint: #6a6153;
    --ls-accent: #7c5522;
    background: var(--ls-bg);
    border-top: 1px solid var(--ls-edge);
    border-bottom: 1px solid var(--ls-edge);
    padding: clamp(38px, 5.4vh, 80px) 0;
  }
  :global(html[data-theme='dark']) .ls-paper {
    --ls-bg: #14161a;
    --ls-edge: rgba(184, 177, 161, 0.14);
    --ls-ink: #dce1dc;
    --ls-ink-soft: #a8b0a9;
    --ls-ink-faint: #6d746e;
    --ls-accent: #7fc9a0;
  }
  .ls-inner {
    padding-left: clamp(150px, 9.5vw, 190px);
    padding-right: clamp(20px, 2.4vw, 52px);
    box-sizing: border-box;
  }
  @media (max-width: 1099px) { .ls-inner { padding-left: clamp(28px, 6vw, 80px); } }

  .ls-split {
    display: grid; grid-template-columns: 44fr 56fr;
    gap: 0 clamp(28px, 3.4vw, 68px);
    align-items: start;
  }
  .ls-answers { border-left: 1px solid var(--ls-edge); padding-left: clamp(28px, 3.4vw, 68px); }
  @media (max-width: 1040px) {
    .ls-split { grid-template-columns: 1fr; gap: 4vh 0; }
    .ls-answers { border-left: 0; padding-left: 0; padding-top: 4vh; border-top: 1px solid var(--ls-edge); }
  }

  .ls-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--ls-accent); margin: 0 0 16px;
  }

  /* THE ASSETS: pixel mark, name, and its two numbers, in a four-column grid so the figures align down. */
  .ls-assets { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ls-asset {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 0 clamp(10px, 1.2vw, 20px);
  }
  .ls-glyph { display: block; }
  .ls-glyph rect { fill: var(--ls-accent); }
  .ls-asset-name {
    font-family: var(--font-display); font-weight: 500; font-size: 16px; color: var(--ls-ink);
  }
  .ls-asset-num {
    font-family: var(--font-mono); font-size: 13px; color: var(--ls-ink-soft);
    font-variant-numeric: tabular-nums; text-align: right; min-width: 8ch;
  }
  .ls-dim { color: var(--ls-ink-faint); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; }
  .ls-illus {
    font-size: 11.5px; line-height: 1.5; color: var(--ls-ink-faint);
    margin: 12px 0 0; max-width: 46ch; font-style: italic;
  }

  /* THE BIG QUESTION — the largest thing on the slide, because it is the thing being asked. */
  .ls-question {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(30px, 3.2vw, 52px); line-height: 1.1;
    color: var(--ls-ink); margin: clamp(22px, 3vh, 40px) 0 0;
    letter-spacing: -0.015em;
  }
  .ls-lede {
    font-size: clamp(14px, 1.05vw, 16px); line-height: 1.68; color: var(--ls-ink-soft);
    margin: 14px 0 0; max-width: 44ch;
  }

  .ls-cow { display: flex; align-items: center; gap: 10px; margin: clamp(16px, 2.2vh, 26px) 0 0; flex-wrap: wrap; }
  .ls-cow-btn {
    display: inline-flex; align-items: baseline; gap: 9px;
    font: inherit; cursor: pointer; text-align: left;
    background: color-mix(in srgb, var(--ls-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--ls-accent) 42%, transparent);
    border-radius: 999px; padding: 7px 15px;
    color: var(--ls-ink);
  }
  .ls-cow-mark { color: var(--ls-accent); font-size: 12px; line-height: 1; }
  .ls-cow-say { font-family: var(--font-display); font-style: italic; font-size: 14.5px; line-height: 1.4; }
  @media (hover: hover) {
    .ls-cow-btn { transition: background-color .28s, border-color .28s; }
    .ls-cow-btn:hover { background: color-mix(in srgb, var(--ls-accent) 20%, transparent); }
  }
  .ls-cow-btn:focus-visible { outline: 2px solid var(--ls-accent); outline-offset: 3px; }
  .ls-cow-hint {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ls-ink-faint);
  }

  /* THE RULES, each with the path it produces. */
  .ls-rules { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(12px, 1.6vh, 18px); }
  .ls-rule { padding-bottom: clamp(12px, 1.6vh, 18px); border-bottom: 1px solid color-mix(in srgb, var(--ls-edge) 60%, transparent); }
  .ls-rule:last-of-type { border-bottom: 0; padding-bottom: 0; }
  .ls-rule-head {
    display: grid; grid-template-columns: 1fr auto auto;
    align-items: center; gap: 0 clamp(12px, 1.4vw, 22px);
  }
  .ls-rule-name {
    font-family: var(--font-display); font-weight: 500; font-size: 15.5px; color: var(--ls-ink);
  }
  /* The sparkline: one shared scale across all four, or they could not be compared. */
  .ls-spark { width: clamp(90px, 11vw, 150px); height: 30px; display: block; }
  .ls-spark polyline {
    fill: none; stroke: var(--ls-ink-faint); stroke-width: 1.4;
    vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round;
  }
  .is-target .ls-spark polyline { stroke: var(--ls-accent); stroke-width: 2.2; }
  .ls-rule-final {
    font-family: var(--font-mono); font-size: 15px; color: var(--ls-ink-soft);
    font-variant-numeric: tabular-nums; min-width: 5ch; text-align: right;
  }
  .is-target .ls-rule-final { color: var(--ls-accent); }
  .is-target .ls-rule-name { color: var(--ls-ink); }
  .ls-rule-gloss {
    font-size: 13px; line-height: 1.55; color: var(--ls-ink-soft); margin: 5px 0 0; max-width: 56ch;
  }
  .ls-rule-stats {
    display: flex; gap: 0 clamp(14px, 1.6vw, 26px); margin: 5px 0 0;
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--ls-ink-faint);
  }
  .ls-rule-stats strong { color: var(--ls-ink-soft); font-weight: 400; }

  .ls-punch {
    font-size: clamp(13.5px, 1vw, 15px); line-height: 1.65; color: var(--ls-ink-soft);
    margin: clamp(16px, 2.2vh, 26px) 0 0; max-width: 62ch;
    padding-top: clamp(12px, 1.6vh, 18px); border-top: 1px solid var(--ls-edge);
  }
</style>

<script>
  // The cow cycles: its lines are the naive questions a reader is already asking, so it should be able to
  // ask the next one. Clicking advances it; it also advances slowly while on screen so the affordance
  // announces itself, and that timer stops for good on the first click and never runs under reduced motion.
  function initCow(): (() => void) | null {
    const btn = document.querySelector<HTMLButtonElement>('[data-cow]');
    const say = document.querySelector<HTMLElement>('[data-cow-say]');
    if (!btn || !say) return null;

    let lines: string[] = [];
    try { lines = JSON.parse(btn.dataset.lines || '[]'); } catch { lines = []; }
    if (lines.length < 2) return null;

    let i = 0;
    let timer = 0;
    const advance = () => { i = (i + 1) % lines.length; say.textContent = lines[i]; };
    const onClick = () => { window.clearInterval(timer); timer = 0; advance(); };
    btn.addEventListener('click', onClick);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return () => { btn.removeEventListener('click', onClick); };

    const section = btn.closest('#lesson');
    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !timer) timer = window.setInterval(advance, 6200);
      else if (!visible && timer) { window.clearInterval(timer); timer = 0; }
    }, { threshold: 0.4 });
    if (section) io.observe(section);

    return () => {
      btn.removeEventListener('click', onClick);
      window.clearInterval(timer);
      io.disconnect();
    };
  }

  let cowTeardown: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cowTeardown?.();
    cowTeardown = initCow();
  });
</script>
