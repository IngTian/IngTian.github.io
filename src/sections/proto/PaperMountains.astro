---
// PaperMountains (PROTOTYPE) — "the mountain is fine, maybe add a little bit of
// particle style to it."
//
// So this does NOT rewrite the editorial content zone. It wraps the REAL
// Mountains section verbatim and adds exactly two things:
//   1. the mote field, confined to this zone (motes are legible here because the
//      sky is already grey ink — see components/proto/MoteField.astro)
//   2. a folio / running head, matching the other leaves
//
// The wrapper is position:relative so MoteField's inset:0 resolves to the whole
// Mountains block; .mtn content is z-index:10 so the motes stay behind the text.
import Mountains from '../Mountains.astro';
import MoteField from '../../components/proto/MoteField.astro';
---
<div class="mtn-zone relative">
  <MoteField />
  <p class="folio">
    <span class="folio-num">III</span><span class="folio-em">—</span><span>The story so far</span>
  </p>
  <Mountains />
</div>

<style>
  .mtn-zone { position: relative; }

  /* Folio sits in the left margin of the content zone, aligned with the section's
     own 7vw gutter. Absolute so it doesn't disturb Mountains' internal rhythm. */
  .folio {
    position: absolute;
    top: 7vh;
    left: 7vw;
    z-index: 10;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    /* Mountains rides the DARK part of the descent and uses paper-coloured text. */
    color: color-mix(in oklab, var(--paper) 42%, transparent);
    display: flex;
    align-items: center;
  }
  .folio-num { color: var(--seal); }
  .folio-em  { margin: 0 0.7em; opacity: 0.5; }
  @media (max-width: 1023px) { .folio { display: none; } }
</style>
