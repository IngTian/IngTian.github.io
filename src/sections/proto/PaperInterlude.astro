---
// PaperInterlude (PROTOTYPE) — the tagline as a true editorial PULL-QUOTE.
// Copy of sections/Interlude.astro with print craft added:
//   · real HANGING PUNCTUATION — the opening quote hangs OUTSIDE the text block's
//     left edge (absolutely positioned, not an inline glyph that would shove the
//     first line right)
//   · an attribution rule beneath, the way a printed pull-quote is closed
//   · a folio for this leaf
// The two doorway links (/research, /art) and their distinct hover affordances
// are preserved exactly — they're shipped behaviour, not decoration.
---
<section id="interlude" class="relative min-h-[78vh] flex items-center justify-center px-[8vw]">
  <p class="folio absolute top-[8vh] left-[7vw]">
    <span class="folio-num">II</span><span class="folio-em">—</span><span>Interlude</span>
  </p>

  <figure class="quote-fig">
    <!-- Hanging open quote: outside the measure, so the text edge stays true. -->
    <span class="hang" aria-hidden="true">&ldquo;</span>
    <blockquote class="statement max-w-[20ch] text-center font-display italic text-ink-2 leading-[1.35] text-[clamp(24px,3.6vw,40px)]">
      <a class="research-link" href="/research">A researcher by day</a>, <a class="art-link" href="/art">an artist by night</a>, and a mathematician at heart.
    </blockquote>
    <figcaption class="attrib">
      <span class="attrib-rule" aria-hidden="true"></span>
      <span class="attrib-text">the descent</span>
    </figcaption>
  </figure>
</section>

<style>
  .quote-fig { position: relative; margin: 0; display: flex; flex-direction: column; align-items: center; }

  /* ── HANGING PUNCTUATION ──────────────────────────────────────────────────
     A real compositor hangs the quote in the margin so the TEXT edge, not the
     punctuation, defines the measure. Absolute positioning is the only honest
     way to do that in CSS — an inline glyph would indent the first line. */
  .hang {
    position: absolute;
    left: -0.62em;
    top: -0.30em;
    font-family: var(--font-display), Georgia, serif;
    font-size: clamp(56px, 8vw, 104px);
    line-height: 1;
    color: color-mix(in oklab, var(--ochre) 62%, transparent);
    font-variation-settings: 'opsz' 144, 'SOFT' 80;
    pointer-events: none;
    user-select: none;
  }
  @media (max-width: 640px) { .hang { left: -0.3em; font-size: 46px; } }

  blockquote.statement { margin: 0; quotes: none; }

  /* ── Attribution rule — closes the quote like a printed page. ──────────── */
  .attrib { display: flex; align-items: center; gap: 0.85rem; margin-top: 2.1rem; }
  .attrib-rule {
    display: block; width: clamp(28px, 5vw, 54px); height: 1px;
    background: color-mix(in oklab, var(--ink-3) 55%, transparent);
  }
  .attrib-text {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase;
    color: color-mix(in oklab, var(--ink-3) 80%, transparent);
  }

  .folio {
    z-index: 2;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase;
    color: color-mix(in oklab, var(--ink-3) 82%, transparent);
    display: flex; align-items: center;
  }
  .folio-num { color: var(--seal); }
  .folio-em  { margin: 0 0.7em; opacity: 0.5; }
  @media (max-width: 640px) { .folio { display: none; } }

  /* ── Shipped doorway affordances, preserved verbatim ──────────────────── */
  .art-link { color: inherit; text-decoration: none; position: relative; white-space: nowrap; }
  .art-link::after {
    content: ""; position: absolute; left: 0; bottom: -0.06em; width: 100%; height: 1px;
    background: currentColor; opacity: 0.7; transform: scaleX(0); transform-origin: left center;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .art-link:hover::after,
  .art-link:focus-visible::after { transform: scaleX(1); }
  .art-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .art-link::after { transition: none; }
    .art-link:hover::after, .art-link:focus-visible::after { transform: scaleX(1); }
  }

  .research-link { color: inherit; text-decoration: none; position: relative; white-space: nowrap; isolation: isolate; }
  .research-link::before {
    content: ""; position: absolute; left: -0.12em; right: -0.12em; bottom: 0.02em; height: 0.62em;
    background: var(--ochre); opacity: 0.34; border-radius: 1px; z-index: -1;
    transform: scaleX(0); transform-origin: left center;
    transition: transform 0.42s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .research-link:hover::before,
  .research-link:focus-visible::before { transform: scaleX(1); }
  .research-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .research-link::before { transition: none; }
    .research-link:hover::before, .research-link:focus-visible::before { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .statement, .hang, .attrib {
      animation: statement-in linear both;
      animation-timeline: view();
      animation-range: entry 5% cover 38%;
    }
    @keyframes statement-in {
      from { opacity: 0.15; transform: translate3d(0, 28px, 0); }
      to   { opacity: 1;    transform: translate3d(0, 0, 0); }
    }
  }
</style>
