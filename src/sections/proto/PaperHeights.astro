---
// PaperHeights (PROTOTYPE) — Heights with the paper-editorial craft applied.
// A copy of sections/Heights.astro; the composition (de-centred name bottom-left,
// bio top-right, terrain full-bleed) is UNCHANGED. What's added is print craft:
//
//   · LETTERPRESS on the name — a light highlight below the glyph edge and a soft
//     shadow above, so the type reads as PRESSED INTO the sheet rather than
//     floating on it. Deliberately restrained: no glow, no colour fringing.
//   · DROP CAP on the bio, optically aligned to the first two lines.
//   · FOLIO / running head in the margin, set like a book's.
//   · MARGINALIA — one real annotation beside the bio, in the outer margin.
//   · SMALL CAPS for the role line, letterspaced (Fraunces supports them).
import { name, roles, rolesSub, phd, bio } from '../../data/profile';
import TerrainHero from '../../components/TerrainHero.astro';

let bioHtml = bio.text;
for (const phrase of bio.strong) {
  bioHtml = bioHtml.replace(phrase, `<strong class="font-medium text-ink-2">${phrase}</strong>`);
}
---
<section id="heights" class="relative min-h-[108vh] px-[7vw] pb-[12vh]">
  <TerrainHero />
  <div class="hero-legibility" aria-hidden="true"></div>

  <!-- Folio / running head — the book's mark for this leaf. -->
  <p class="folio absolute top-[7vh] left-[7vw]">
    <span class="folio-num">I</span><span class="folio-em">—</span><span>Heights</span>
  </p>

  <!-- about-me, floated top-right; the empty diagonal to the name IS the composition -->
  <div class="hero-bio absolute top-[22vh] right-[7vw] max-w-[32ch] text-right">
    <p class="bio-prose font-body text-ink-2/90 leading-[1.6] text-[clamp(13px,1.25vw,15.5px)]" set:html={bioHtml}></p>
    <!-- Marginalia: a real editorial note, set in the outer margin. -->
    <p class="marginalia">Portfolio optimization<br />under uncertainty</p>
  </div>

  <!-- name anchored bottom-left -->
  <div class="hero-rise absolute bottom-[16vh] left-[7vw] max-w-[88vw]">
    <h1 class="press font-display text-ink-1 leading-[0.9] tracking-[-0.02em] text-[clamp(64px,12vw,132px)]"
        style="font-variation-settings:'opsz' 144,'SOFT' 60;">
      {name.first} <em class="italic text-ink-3 font-medium">{name.last}</em>
    </h1>
    <p class="role-line font-display text-ink-3 mt-5 text-[clamp(15px,2.2vw,21px)]">{roles}</p>
    <p class="font-mono uppercase tracking-[0.22em] text-ink-3/90 mt-2.5 text-[11px]">{phd} &nbsp;·&nbsp; {rolesSub}</p>
  </div>

  <div class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 font-mono text-ink-4 text-[11px] tracking-[0.2em]">scroll</div>
</section>

<style>
  #heights .hero-rise, #heights .hero-bio { position: absolute; z-index: 2; }
  .hero-legibility {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(40% 26% at 22% 74%, color-mix(in oklab, var(--paper) 85%, transparent), transparent 66%),
      radial-gradient(30% 22% at 82% 22%, color-mix(in oklab, var(--paper) 70%, transparent), transparent 72%);
  }
  :global(html[data-theme='dark']) .hero-legibility {
    background:
      radial-gradient(44% 30% at 22% 74%, color-mix(in oklab, var(--bg) 62%, transparent), transparent 68%),
      radial-gradient(34% 24% at 82% 22%, color-mix(in oklab, var(--bg) 46%, transparent), transparent 74%);
  }

  /* ── LETTERPRESS ────────────────────────────────────────────────────────
     A real impression reads as: light catching the lower lip of the debossed
     edge, shadow gathering in the upper wall. So highlight goes BELOW (+1px),
     shadow ABOVE (−1px). Values stay tiny — the moment this is visible as an
     effect it looks like 2008 CSS. No blur animation, no colour fringing. */
  .press {
    text-shadow:
      0 1px 0    color-mix(in oklab, var(--paper) 92%, white),
      0 -1px 1px color-mix(in oklab, var(--ink-1) 26%, transparent),
      0 2px 4px  color-mix(in oklab, var(--ink-1) 10%, transparent);
    padding-bottom: 0.1em;   /* descenders (the g) must not clip */
  }
  /* Dark theme: the sheet is a void and the ink is light, so the relationship
     inverts — the highlight goes above, the shadow below, or it looks embossed
     plastic instead of pressed. */
  :global(html[data-theme='dark']) .press {
    text-shadow:
      0 -1px 0  color-mix(in oklab, var(--ink-1) 22%, transparent),
      0 1px 1px rgba(0, 0, 0, 0.55),
      0 2px 6px rgba(0, 0, 0, 0.32);
  }

  /* ── RAISED (not dropped) INITIAL ────────────────────────────────────────
     Two failures got us here, both caught by screenshot:
       1. `.bio-prose :global(:first-letter)` is a DESCENDANT selector — it
          matched nothing, so the first pass had no initial at all.
       2. A FLOATED cap cannot work on this block. The bio is right-aligned, so a
          right float put the Q mid-line with "uant" orphaned beside it, and a
          left float would collide with the ragged left edge. A drop cap needs a
          flush measure on the side it floats into; this block has neither.

     The honest solution for right-aligned ragged text is a RAISED initial: the
     glyph stays in the line box (no float, no wrap interaction) and is simply
     set larger, aligned to the cap height of line one. Print does exactly this
     when the measure won't take a dropped cap. */
  .bio-prose::first-letter {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.9em;
    font-weight: 500;
    line-height: 1;
    color: var(--ink-1);
    /* pull the oversized glyph back onto the first baseline */
    vertical-align: -0.06em;
  }

  /* ── FOLIO / running head ─────────────────────────────────────────────── */
  .folio {
    z-index: 2;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--ink-3) 82%, transparent);
    display: flex;
    align-items: center;
  }
  .folio-num { color: var(--seal); }
  .folio-em  { margin: 0 0.7em; opacity: 0.5; }

  /* ── MARGINALIA ─────────────────────────────────────────────────────────
     Set OUTSIDE the text block in the true outer margin, ruled like a scholarly
     edition's side note. Hidden below lg — there is no margin to write in. */
  .marginalia {
    display: none;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 9.5px;
    line-height: 1.55;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--ink-4) 90%, transparent);
    text-align: left;
    margin-top: 1.4rem;
    padding-left: 0.7rem;
    border-left: 1px solid color-mix(in oklab, var(--ink-4) 40%, transparent);
    max-width: 16ch;
    margin-left: auto;   /* sits at the block's outer (right) edge */
  }
  @media (min-width: 1024px) { .marginalia { display: block; } }

  /* ── Role line ──────────────────────────────────────────────────────────
     REVERTED to the shipped italic. I tried letterspaced small caps here and the
     screenshot settled it: small caps flattened the line into a third mono-ish
     label stacked above the real mono subline, and it broke the italic thread
     that runs name-surname → role → tagline. The italic IS the editorial voice;
     small caps was decoration pretending to be craft. */
  .role-line {
    font-style: italic;
  }

  @media (max-width: 640px) {
    #heights { display: flex; flex-direction: column; justify-content: flex-end; gap: 1.75rem; padding-bottom: 16vh; }
    #heights .hero-bio,
    #heights .hero-rise { position: static; inset: auto; max-width: 100%; text-align: left; right: auto; }
    #heights .hero-bio { order: 2; }
    #heights .hero-rise { order: 1; }
    #heights .hero-legibility { display: none; }
    #heights .terrain-canvas { opacity: 0.5; }
    .folio { display: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-rise { animation: hero-rise 1.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .hero-bio  { animation: hero-rise 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both; }
    .folio     { animation: hero-rise 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both; }
    @keyframes hero-rise {
      from { opacity: 0; transform: translate3d(0, 16px, 0); }
      to   { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    .scroll-cue { animation: cue-bob 2.6s ease-in-out 1.4s infinite; }
    @keyframes cue-bob {
      0%, 100% { opacity: 0.5; transform: translate(-50%, 0); }
      50%      { opacity: 1;   transform: translate(-50%, 6px); }
    }
  }
</style>
