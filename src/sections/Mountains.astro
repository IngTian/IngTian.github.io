---
import ProjectCard from '../components/ProjectCard.astro';
import { researchInterests, publications, timeline, awards, projects } from '../data/profile';

// ── Selected writing: the featured paper (RL-BHRP) is promoted from a citation
// line to a feature block (display title, one-line gloss, two headline stats);
// the rest stay quiet author-date citations. ──
const featured = publications.find((p) => p.featured);
const restPubs = publications.filter((p) => !p.featured);
const stat1 = featured?.results?.[0];                                   // ~120% compounded
const sharpe = featured?.metrics?.rows.find((r) => /sharpe/i.test(r.metric));

// ── Selected experience: curated, not enumerated (portfolio-design norm is 3–5
// on-page roles + a linked CV). Four flagship anchors carry a one-line impact
// clause and a seal-red node; the 2021 TikTok intern NESTS under the Senior role
// (same employer, one story); everything else collapses to a compact "Elsewhere"
// line. The PhD leads (identity), EA sits directly under it as the CURRENT role,
// then the research-adjacent + strongest-brand anchors — quant-first, but the
// present-tense job isn't buried in the tail. Flagship rows matched to timeline[]
// by a title needle so profile.ts stays the single source of content. ──
const find = (needle: string) => timeline.find((e) => e.title.includes(needle));
const flags = [
  { e: find('Incoming PhD'),             marquee: 'Multi-period portfolio optimization · advised by Roy H. Kwon' },
  { e: find('Electronic Arts'),          marquee: 'Recommendation systems · dual-tower retrieval & ranking · Go · Kafka / NATS' },
  { e: find('Freelance'),                marquee: 'End-to-end quant trading system · authored the RL-BHRP paper' },
  { e: find('Senior Software Engineer'), marquee: '$200M creative spend · 50k QPS · Exceptional review',
    nested: timeline.find((e) => e.title.includes('SDE Intern') && !!e.sub?.includes('Shanghai')) },
].filter((f) => f.e);
// The compact tail — everything not a flagship anchor or the nested intern.
const flagTitles = new Set(flags.flatMap((f) => [f.e!.title, f.nested?.title]).filter(Boolean));
const elsewhere = timeline.filter((e) => !flagTitles.has(e.title));
---
<section id="mountains" class="relative px-[7vw] py-[14vh]">
  <!-- On lg+ (where the left-margin Toc rail is present) the whole content zone
       indents right as ONE block, sharing a single left edge with breathing room
       from the rail so the two verticals (rail + descent spine) don't crowd. The
       inset is viewport-relative via clamp() — scales with screen size and honours
       browser zoom — not a fixed device pixel. Mobile keeps full width (no rail). -->
  <div class="mtn relative z-10 max-w-[920px] mx-auto">
    <p class="font-mono text-[11px] tracking-[0.24em] uppercase text-paper/55">The story so far</p>
    <h2 class="font-display italic text-[26px] sm:text-[30px] text-paper mt-3 leading-snug">
      A quant who reasons in structure,<br />an engineer who makes the math run.
    </h2>

    <!-- Research interests — teaser; full themed list lives on /research -->
    <h3 class="font-mono text-[11px] tracking-[0.24em] uppercase text-paper/45 mt-14 mb-3">
      Research interests
    </h3>
    <ul class="flex flex-wrap gap-x-3 gap-y-2.5 max-w-[760px]" data-ri>
      {researchInterests.map((it) => (
        <li>
          <button
            type="button"
            class="ri-pill font-mono text-[12px] border rounded-full px-3.5 py-1.5"
            aria-expanded="false"
            aria-controls="ri-gloss"
            data-gloss={it.gloss}
          >
            {it.label}
          </button>
        </li>
      ))}
    </ul>
    <div class="ri-gloss-wrap" data-ri-gloss-wrap>
      <p id="ri-gloss" class="ri-gloss" aria-live="polite"></p>
    </div>
    <a href="/research" class="research-more inline-block mt-5 font-mono text-[12px] text-ochre/90 no-underline">
      Read the research →
    </a>

    <!-- ── Selected writing — featured paper block + quiet citations ──── -->
    <h3 class="font-mono text-[11px] tracking-[0.24em] uppercase text-paper/45 mt-16 mb-4">Selected writing</h3>
    {featured && (
      <a href="/research" class="feature group block no-underline">
        <div class="feature-body">
          <p class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-ochre/80">{featured.subject ?? 'Featured'}</p>
          <h4 class="font-display text-[22px] sm:text-[25px] leading-[1.28] text-paper mt-2 group-hover:text-ochre transition-colors">{featured.title}.</h4>
          {featured.takeaway && <p class="font-body text-[14px] leading-[1.65] text-paper/70 mt-3 max-w-[62ch]">{featured.takeaway}</p>}
          <div class="mt-5 flex flex-wrap gap-x-12 gap-y-4">
            {stat1 && (<div><div class="font-display text-[30px] leading-none text-paper">{stat1.value}</div><div class="font-mono text-[10.5px] tracking-[0.04em] text-paper/50 mt-1.5">wealth compounded · OOS ’20–’25</div></div>)}
            {sharpe && (<div><div class="font-display text-[30px] leading-none text-paper">{sharpe.values[0]}</div><div class="font-mono text-[10.5px] tracking-[0.04em] text-paper/50 mt-1.5">Sharpe · vs {sharpe.values[1]} / {sharpe.values[2]}</div></div>)}
          </div>
          <p class="font-mono text-[12px] text-ochre/90 mt-6">Read the research →</p>
        </div>
      </a>
    )}
    {restPubs.length > 0 && (
      <div class="mt-8 border-t border-paper/12">
        {restPubs.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <Tag
              href={p.href}
              target={p.href ? '_blank' : undefined}
              rel={p.href ? 'noopener noreferrer' : undefined}
              class:list={['group block py-4 border-b border-paper/8 no-underline', p.href && 'transition-colors']}
            >
              <p class="pub-cite text-[14px] leading-[1.7] text-paper/75">
                <span class="font-mono text-[12.5px] text-paper/85">{p.authors}</span>{' '}
                <span class="font-mono text-[12.5px] text-paper/55">({p.year}).</span>{' '}
                <span class="font-display group-hover:text-ochre transition-colors">{p.title}.</span>{' '}
                <span class="font-display italic text-paper/55">{p.venue}.</span>
                {p.href && <span class="font-mono not-italic text-ochre"> ↗</span>}
              </p>
            </Tag>
          );
        })}
      </div>
    )}

    <!-- ── Selected experience — curated, threaded on the descent spine ─── -->
    <div class="flex items-baseline justify-between mt-16 mb-6">
      <h3 class="font-mono text-[11px] tracking-[0.24em] uppercase text-paper/45">Selected experience</h3>
      <a href="/cv.pdf" class="cv-link font-mono text-[11px] text-paper/45 no-underline">Full history → CV</a>
    </div>
    <ol class="spine">
      {flags.map(({ e, marquee, nested }) => (
        <li class="node node-flag">
          <span class="dot" aria-hidden="true"></span>
          <div class="font-mono text-[11.5px] text-paper/45 pt-0.5">{e!.period}</div>
          <div class="min-w-0">
            <h4 class="text-[18px] font-semibold text-paper">{e!.title}</h4>
            <p class="font-mono text-[12px] text-ochre/85 mt-1.5">{marquee}</p>
            <p class="text-[13px] text-paper/65 mt-1.5 leading-relaxed">{e!.detail}</p>
            {nested && (
              <p class="nested text-[12.5px] text-paper/45 mt-3 pl-3">
                <span class="font-mono text-[11px] text-paper/40">{nested.period}</span>
                {' · '}<span class="text-paper/60">{nested.title.replace(' · TikTok', '')}</span>
                {nested.sub && <span class="text-paper/35"> — {nested.sub}</span>}
              </p>
            )}
          </div>
        </li>
      ))}
      <li class="node node-tail">
        <span class="dot" aria-hidden="true"></span>
        <div class="font-mono text-[11.5px] text-paper/40 pt-0.5">Elsewhere</div>
        <ul class="min-w-0 flex flex-col gap-1.5 pt-0.5">
          {elsewhere.map((e) => (
            <li class="text-[13px] text-paper/55">
              <span class="font-mono text-[11px] text-paper/35 mr-2">{e.period}</span>
              {e.title}
            </li>
          ))}
        </ul>
      </li>
    </ol>

    <!-- Projects — shipped artifacts (a teaser; full list lives on /projects).
         Placed after Experience so engineering stays a clear second to research. -->
    {projects.length > 0 && (
      <>
        <h3 class="font-mono text-[11px] tracking-[0.24em] uppercase text-paper/45 mt-16 mb-3">Projects</h3>
        <div class="max-w-[760px]">
          <ProjectCard project={projects[0]} variant="teaser" headingLevel={4} />
        </div>
        <a href="/projects" class="projects-more inline-block mt-5 font-mono text-[12px] text-ochre/90 no-underline">
          {projects.length > 1 ? 'See all projects →' : 'More on the project →'}
        </a>
      </>
    )}

    <!-- ── Recognition ──────────────────────────────────────────────── -->
    <div class="mt-16">
      <h3 class="font-mono text-[11px] tracking-[0.24em] uppercase text-paper/45">Recognition</h3>
      <ul class="mt-4 flex flex-col gap-2.5">
        {awards.map((a) => (
          <li class="flex items-baseline gap-4 text-[13px]">
            <span class="font-mono text-[11px] text-paper/45 w-[56px] shrink-0">{a.year}</span>
            <span class="text-paper/75">{a.title}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* ── Content-zone indent. Viewport-relative (clamp in rem/vw), NOT a fixed
     device pixel: 0 below the lg breakpoint (mobile/tablet — no Toc rail), then
     a fluid inset that grows gently with width and honours browser zoom (rem
     base). The whole zone shares this single left edge, clear of the Toc. ── */
  @media (min-width: 1024px) {
    .mtn { padding-left: clamp(2.5rem, 4vw, 5rem); }
  }

  .research-more, .projects-more { transition: color 0.3s, letter-spacing 0.3s; }
  @media (hover: hover) {
    .research-more:hover, .projects-more:hover { color: var(--ochre); letter-spacing: 0.02em; }
  }

  /* ── Selected-writing feature block: the paper reads as an object, not a
     footnote — a bordered card with a left ochre keyline, the same static glass
     material as the ProjectCard (blur is baked, never animated — taste rule). ── */
  .feature {
    display: block; position: relative; border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    background: rgba(220, 225, 220, 0.035);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .feature::before {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--ochre); opacity: 0.85;
  }
  .feature-body { padding: 26px 30px 24px; }
  @media (hover: hover) {
    .feature { transition: border-color .3s, background-color .3s, transform .3s cubic-bezier(.2,.7,.3,1); }
    .feature:hover { border-color: rgba(200, 163, 106, 0.5); background: rgba(200, 163, 106, 0.06); transform: translateY(-2px); }
  }
  /* Hanging indent on the quiet citations — the shape of a references line. */
  .pub-cite { text-indent: -1.4em; padding-left: 1.4em; }

  /* ── The descent spine: a single vertical line; each role hangs off it as a
     node. Flagship nodes get a seal-red dot + impact clause; the tail is one
     hollow tick. The line literally thins toward the past — the Descent. ── */
  .spine { position: relative; margin-left: 6px; }
  .spine::before {
    content: ""; position: absolute; left: 5px; top: 6px; bottom: 6px; width: 1px;
    background: linear-gradient(180deg, transparent, rgba(239,233,221,0.22) 8%, rgba(239,233,221,0.22) 92%, transparent);
  }
  .node {
    position: relative; display: grid; grid-template-columns: 96px 1fr; gap: 0 22px;
    padding: 0 0 26px 26px;
  }
  .node .dot {
    position: absolute; left: 1px; top: 7px; width: 9px; height: 9px; border-radius: 50%;
    background: var(--bg); border: 1px solid rgba(239,233,221,0.3);
  }
  /* Flagship node: a HOLLOW seal ring, a touch more air below.
     Was a solid seal disc inside a 3px seal-tinted halo — four of those stacked
     vertically is ~5x the saturated pixel area the mark needs, and it spent the
     light theme's ONE saturated colour on résumé furniture. The ring keeps the
     seal's hue and meaning at a fraction of the area, and makes the spine a
     single vocabulary: seal ring (flagship) → dim ring (tail).

     Sized 10px with a 2px ring, MEASURED not guessed: at the 9px base a 1.5px
     border rounds to 1px, leaving the seal at only ~40% of the disc and the dark
     fill dominant — the mark read as a near-black dot with a red rim, i.e. the
     seal had stopped registering. 2px of 10px puts the ring at ~64%, so seal is
     the mark's colour again while total saturated area stays far under the old
     solid-disc-plus-halo. The fill is a seal-tinted ink rather than raw --bg, so
     the centre reads as part of the mark instead of a hole punched in it. */
  .node-flag .dot {
    width: 10px; height: 10px; left: 0.5px;
    background: color-mix(in oklab, var(--seal) 26%, var(--bg));
    border: 2px solid var(--seal);
  }
  .node-flag { padding-bottom: 34px; }

  /* Nested same-employer stint (the 2021 TikTok intern under Senior): a hair-line
     ruled sub-entry, so promotion reads as one story, not two rows. */
  .nested { position: relative; }
  .nested::before {
    content: ""; position: absolute; left: 0; top: 0.15em; bottom: 0.15em; width: 1px;
    background: rgba(239,233,221,0.18);
  }

  /* The tail node — quietest point of the spine: hollow tick, no prose. */
  .node-tail { padding-bottom: 6px; }
  .node-tail .dot { background: var(--bg); border-color: rgba(239,233,221,0.28); }

  /* CV escape hatch — a quiet text link, not a button. */
  .cv-link { transition: color .3s; }
  @media (hover: hover) { .cv-link:hover { color: var(--ochre); } }

  /* Responsive: the spine's fixed date column collapses on narrow screens so a
     long period string never crushes the content. */
  @media (max-width: 480px) {
    .node { grid-template-columns: 1fr; gap: 2px 0; padding-left: 22px; }
  }

  /* ── Research-interest pills — frosted-glass buttons that open a one-line
     gloss on click; the OPEN pill carries the vermilion seal dot. Static blur
     (baked), theme-following like the ProjectCard / CornerNav. ── */
  .ri-pill {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    color: var(--paper);
    border-color: rgba(255, 255, 255, 0.26);
    background-color: rgba(22, 20, 15, 0.12);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
    transition: color 0.35s, border-color 0.35s, background-color 0.35s,
                box-shadow 0.35s, transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  :global(html[data-theme='dark']) .ri-pill {
    color: var(--paper);
    border-color: rgba(220, 225, 220, 0.14);
    background-color: rgba(220, 225, 220, 0.05);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 4px 14px -8px rgba(0, 0, 0, 0.5);
  }
  @media (hover: hover) {
    .ri-pill:hover {
      border-color: rgba(200, 163, 106, 0.7);
      background-color: rgba(200, 163, 106, 0.16);
    }
  }
  .ri-pill::before {
    content: '';
    flex: 0 0 auto;
    width: 0;
    height: 6px;
    border-radius: 50%;
    background: var(--seal);
    opacity: 0;
    margin-right: 0;
    transition: width 0.42s cubic-bezier(0.2, 0.7, 0.3, 1),
                margin-right 0.42s cubic-bezier(0.2, 0.7, 0.3, 1),
                opacity 0.3s ease;
  }
  .ri-pill.open {
    border-color: rgba(200, 163, 106, 0.6);
    background-color: rgba(200, 163, 106, 0.12);
  }
  .ri-pill.open::before {
    width: 6px;
    margin-right: 7px;
    opacity: 1;
  }
  .ri-gloss-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .ri-gloss-wrap.show { grid-template-rows: 1fr; }
  .ri-gloss {
    overflow: hidden;
    min-height: 0;
    max-width: 520px;
    padding: 14px 0 0 14px;
    border-left: 1px solid rgba(200, 163, 106, 0.4);
    font-family: var(--font-display);
    font-size: 13.5px;
    line-height: 1.65;
    color: rgba(239, 233, 221, 0.74);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .ri-gloss-wrap.show .ri-gloss { opacity: 1; }

  /* Motion gate — the pill lift + gloss reveal are motion; the no-motion state
     (instant color change, dot simply present) still reads as finished. */
  @media (prefers-reduced-motion: reduce) {
    .ri-pill, .ri-pill::before, .ri-gloss-wrap, .ri-gloss, .feature, .cv-link { transition: none; }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .ri-pill:hover { transform: translateY(-2px); }
  }
</style>

<script>
  // Click-to-reveal for the research-interest pills. One shared gloss region:
  // opening a pill shows its gloss and marks it with the seal dot; clicking the
  // open pill (or another) toggles/switches. Vanilla, no island — re-inits after
  // every View Transition swap with a teardown so handlers don't leak.
  function initResearchPills() {
    const list = document.querySelector<HTMLElement>('[data-ri]');
    const wrap = document.querySelector<HTMLElement>('[data-ri-gloss-wrap]');
    const gloss = document.getElementById('ri-gloss');
    if (!list || !wrap || !gloss) return;

    const pills = Array.from(list.querySelectorAll<HTMLButtonElement>('.ri-pill'));

    function onClick(e: MouseEvent) {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ri-pill');
      if (!btn) return;
      const wasOpen = btn.classList.contains('open');

      pills.forEach((p) => {
        p.classList.remove('open');
        p.setAttribute('aria-expanded', 'false');
      });

      if (wasOpen) {
        wrap!.classList.remove('show');
        if (parseFloat(getComputedStyle(wrap!).transitionDuration) === 0) gloss!.textContent = '';
        return;
      }

      btn.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
      gloss!.textContent = btn.dataset.gloss ?? '';
      wrap!.classList.add('show');
    }

    function onEnd(e: TransitionEvent) {
      if (e.propertyName === 'grid-template-rows' && !wrap!.classList.contains('show')) {
        gloss!.textContent = '';
      }
    }

    list.addEventListener('click', onClick);
    wrap.addEventListener('transitionend', onEnd);
    riTeardown = () => {
      list.removeEventListener('click', onClick);
      wrap.removeEventListener('transitionend', onEnd);
    };
  }

  let riTeardown: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    riTeardown?.();
    riTeardown = null;
    initResearchPills();
  });
</script>
