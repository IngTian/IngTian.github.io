---
// src/sections/Rules.astro
// SLIDE 2 OF 3 — THE RULES, drawn as the feasible set collapsing.
//
// The owner's answer to the one thing I was unsure about: "for a feasible set, it can be animated in linear
// algebra right". Exactly right, and it is what makes this slide buildable. A constraint is a linear
// inequality, which is a half-space; the legal set is their intersection, a convex polytope. So the collapse
// is a computation rather than a metaphor: add a half-space, clip the polygon, measure what survives.
//
// Three assets with a budget constraint and no shorting give the 2-simplex — a triangle — drawn in barycentric
// coordinates so it is equilateral and the areas on screen are the REAL relative areas. Each rule cuts it with
// a straight line, and the number beside it is the actual remaining fraction: 100 -> 69.7 -> 46.7 -> 43.2 ->
// 28.2 -> 20%.
//
// SCALING IS STATED, NOT HIDDEN. Three assets cannot carry a real 5% single-name cap (three names at 5% cannot
// sum to 100%), so the bounds are loosened for the illustration and the caption says so. What transfers exactly
// is the shape of the argument; the count is what scales.
//
// Geometry in lib/feasible.ts (pure, 29 tests, including the barycentric derivation checked against the
// original inequalities at 66 sample points).
import {
  CONSTRAINTS, SIMPLEX, ASSETS, feasibleAfter, areaSeries, toWeights, centroid, removedBy, cutLine, area,
} from '../lib/feasible';
import { FUND } from '../data/desk';
import { humanCount } from '../lib/problemSize';
import {
  PATH_LEVELS, PATH_PERIODS, PATH_RULES, ALL_PATHS,
  survivors, killedBy, survivalSeries as pathSeries, countFuturesFrom, compoundedFraction, pathPoints,
} from '../lib/pathspace';

const series = areaSeries();
const whole = area(SIMPLEX);
// Every stage precomputed: the client animates between ready-made polygons rather than clipping at paint time.
//
// Each stage now also carries the SLAB IT REMOVES and the LINE THAT REMOVES IT. The slide's own copy says
// "every rule is a straight line through the space of legal portfolios; each one removes a slab" — and the
// drawing showed neither. A reader watched a shape get smaller without ever seeing the cut, so the sentence was
// doing the work the picture should have been doing. lib/feasible already had cutLine() written and tested; it
// had simply never been used.
const stages = CONSTRAINTS.map((c, i) => ({
  label: c.label,
  why: c.why,
  poly: feasibleAfter(i + 1),
  cut: removedBy(i + 1),
  line: cutLine(c),
  remaining: series[i + 1],
  // What THIS rule costs, as a share of the whole space — the number that says which rules actually bite.
  removed: area(removedBy(i + 1)) / whole,
}));
const finalPoly = feasibleAfter(CONSTRAINTS.length);
const finalWeights = toWeights(centroid(finalPoly));

// Drawing box. The simplex spans x 0..1 and y 0..sqrt(3)/2, so the viewBox matches its aspect exactly and
// nothing is stretched — the whole point of using barycentric coordinates.
const S = 300;
const H = S * (Math.sqrt(3) / 2);
// Pad generously: the corner labels sit OUTSIDE the triangle, and at 16px they were clipped by the viewBox
// ("100% NVDA" rendered as "'DA"). The pad has to hold the longest label, not just the triangle.
const pad = 46;
const sx = (x: number) => pad + x * S;
const sy = (y: number) => pad + (H - y * S);
const pts = (poly: { x: number; y: number }[]) => poly.map((p) => `${sx(p.x).toFixed(1)},${sy(p.y).toFixed(1)}`).join(' ');

// ── ACT TWO: THE SAME QUESTION, ONE PERIOD LATER ────────────────────────────────────────────────────────
//
// The owner: "triangle might not be enough actually. for single period might be yes. for multi period we are
// shrinking many potential paths right?"
//
// Right, and it is the correction the slide needed. The triangle is the feasible set of ONE weight vector; the
// field is multi-PERIOD, so the object actually being constrained is a whole SEQUENCE of decisions. Two acts on
// one stage: the triangle answers "what may I hold", then it cross-fades to a thicket of candidate paths and the
// same rules comb them away. Sharing the stage box is what makes the second object cost no vertical space — the
// slide already owns exactly one screen and had 241px of headroom, which is not enough for a second figure.
//
// Grid stated on the slide, because it is a modelling choice: PATH_LEVELS bands x PATH_PERIODS decisions. The
// COMPOUNDING figure below is exact and grid-free; the path counts are exact given the grid.
const pathStages = PATH_RULES.map((r, i) => ({
  label: r.label,
  why: r.why,
  kind: r.kind,
  kept: survivors(i + 1),
  killed: killedBy(i + 1),
  remaining: pathSeries()[i + 1],
}));
const pathTotal = ALL_PATHS.length;
const pathLeft = pathStages[pathStages.length - 1].kept.length;

// The lattice shares the triangle's viewBox so the two acts occupy the identical rectangle and the cross-fade
// does not shift the composition. Inset a little so the band labels have room.
const lBox = { x: pad + 6, y: pad + 14, w: S - 12, h: H - 34 };
const ppts = (path: number[]) => pathPoints(path, lBox, PATH_LEVELS, PATH_PERIODS);

// THE STRUCTURAL NUMBER, and the one that earns the whole second act: how many legal futures exist from each
// starting band. If they differ, the periods cannot be chosen separately — which is exactly why the next slide
// needs dynamic programming. Measured on this grid: band 2 has 14 futures, band 3 has 6, the edges have none.
const futures = Array.from({ length: PATH_LEVELS }, (_, b) => countFuturesFrom(b));
const bestBand = futures.indexOf(Math.max(...futures));
const liveBands = futures.filter((f) => f > 0);
const leanestBand = futures.indexOf(Math.min(...liveBands.length ? liveBands : [0]));

// Compounding at the fund's real horizon, from the single-period figure this slide already measures.
const singlePeriodLegal = series[series.length - 1];
const compounded = compoundedFraction(singlePeriodLegal, FUND.periods);
// "one in N", which is how a reader actually holds a number this small.
const oneIn = compounded > 0 ? 1 / compounded : Infinity;
const oneInExp = Math.floor(Math.log10(oneIn));
---
<section id="rules" class="ru" aria-labelledby="ru-heading">
  <div class="ru-paper">
    <div class="ru-inner">
      <p class="ru-kicker">2 / 3 · the rules</p>

      <div class="ru-split">
        <div class="ru-say">
          <h2 id="ru-heading" class="ru-head">Then you learn what you are not allowed to do.</h2>
          <p class="ru-lede">
            Every rule a fund carries is a straight line through the space of legal portfolios. Each one removes
            a slab. They compound.
          </p>

          <!-- THE RULES, AND EACH ONE IS CLICKABLE. Same reasoning as the defining slide's beats: a sequence
               that only advances on its own timer reads at the slide's pace, not the reader's, and here the
               numbers invite comparison — "which rule cost the most?" is a question you can only answer by
               going back to one. Clicking freezes; there is no resume timer, because a timer that restarts
               takes the slide away mid-thought.
               Two figures per rule now: what it COSTS (this rule's slab) and what is LEFT after it. The old
               list had only the second, so "they compound" was visible but "some of them barely bite" was
               not — rule 3 removes 3.5% of the space and rule 1 removes 30%, and that difference is the
               interesting part of a mandate. -->
          <ol class="ru-list">
            <li class="ru-head-row" aria-hidden="true">
              <span></span><span></span>
              <span class="ru-col">cuts</span>
              <span class="ru-col">left</span>
            </li>
            {stages.map((s, i) => (
              <li>
                <button class="ru-item" type="button" data-stage={i} aria-pressed="false">
                  <span class="ru-num">{i + 1}</span>
                  <span class="ru-label">{s.label}</span>
                  <span class="ru-cut">−{(s.removed * 100).toFixed(0)}%</span>
                  <span class="ru-pct">{(s.remaining * 100).toFixed(0)}%</span>
                  <span class="ru-why">{s.why}</span>
                </button>
              </li>
            ))}
          </ol>

          <!-- THE MULTI-PERIOD CLOSE. The single-period figure is only the setup; the compounded one is the
               point, and it is exact arithmetic rather than a grid count — a rule leaving f of splits legal in
               one month leaves f^T of sequences legal over T months. At this slide's own measured f and the
               fund's own horizon that is one in 10^17.
               Then the structural line, which is what act two exists to earn and what no single-period picture
               can show: the number of legal futures depends on WHERE YOU STAND, so the months cannot be chosen
               one at a time. That is the sentence the Method slide answers. -->
          <p class="ru-scale">
            <strong>{(series[series.length - 1] * 100).toFixed(0)}%</strong> of splits survive one month. Do it
            for {FUND.periods} months and only <strong>1 in 10<sup>{oneInExp}</sup></strong> of the possible
            sequences is legal — and a real mandate carries <strong>{humanCount(FUND.constraints)}+</strong>
            rules across <strong>{humanCount(FUND.tickers)}</strong> names.
          </p>
          <p class="ru-sep">
            The rules also interlock: from band <strong>{bestBand}</strong> there are
            <strong>{futures[bestBand]}</strong> legal futures, from band <strong>{leanestBand}</strong> only
            <strong>{futures[leanestBand]}</strong>. What you may do next depends on where you are now — so you
            cannot choose the months one at a time.
          </p>
        </div>

        <figure class="ru-fig">
          <p class="ru-fig-head">
            <span class="ru-act ru-act--1" data-act-head="1">Legal portfolios of {ASSETS.join(' · ')} — one month</span>
            <span class="ru-act ru-act--2" data-act-head="2">
              Every way to hold it for {PATH_PERIODS} months — {pathTotal} sequences
            </span>
          </p>

          <svg class="ru-chart" viewBox={`0 0 ${S + pad * 2} ${H + pad * 2}`} role="img"
               aria-label={`Two drawings in one frame. First, the set of legal portfolios of three assets shrinking as five constraints are applied, from the whole space down to ${(series[series.length - 1] * 100).toFixed(0)} percent of it. Then the same rules applied to whole sequences of decisions: of ${pathTotal} ways to hold the money over ${PATH_PERIODS} months, ${pathLeft} survive.`}>
            <!-- ══ ACT ONE — ONE PERIOD. The feasible set of a single weight vector: real convex clipping on
                 the 2-simplex. This is the whole story if you only ever decide once. ══ -->
            <g class="ru-act ru-act--1" data-act="1">
            <!-- The unconstrained simplex, always visible as the ghost of what was possible. -->
            <polygon class="ru-simplex" points={pts(SIMPLEX)} />

            <!-- THE SLAB EACH RULE REMOVES, drawn as a hatched region with the cutting line along its edge.
                 This is what makes the collapse legible as an ACT rather than as a shape that got smaller:
                 you see the line arrive, the slab it takes, and what is left. Drawn before the survivor so
                 the survivor sits on top. -->
            {stages.map((s, i) => (
              <g class="ru-cutgroup" data-cut={i}>
                <polygon class="ru-slab" points={pts(s.cut)} />
              </g>
            ))}

            <!-- Each stage's surviving polygon. The script reveals them in order; with no JS the final one is
                 shown, which is the finished state. -->
            {stages.map((s, i) => (
              <polygon class="ru-stage" data-poly={i} points={pts(s.poly)} />
            ))}

            <!-- THE CUTTING LINE LAST, on purpose. It lies exactly along the survivor's new edge, so drawn
                 before it the survivor's 2px accent stroke painted straight over the dashes — measured, not a
                 single pixel of the line survived. The line is the slide's central claim ("every rule is a
                 straight line"), so it goes on top of everything. -->
            {stages.map((s, i) => (
              <g class="ru-cutgroup" data-cut={i}>
                {s.line && (
                  <line class="ru-cutline"
                        x1={sx(s.line[0].x)} y1={sy(s.line[0].y)}
                        x2={sx(s.line[1].x)} y2={sy(s.line[1].y)} />
                )}
              </g>
            ))}

            <!-- The corners, labelled with what they mean: an all-in-one-name portfolio. -->
            {SIMPLEX.map((p, i) => (
              <circle class="ru-vertex" cx={sx(p.x)} cy={sy(p.y)} r="2.5" />
            ))}
            <!-- Corner labels sit outside the triangle, anchored so they grow away from it. -->
            <text class="ru-vlabel" x={sx(SIMPLEX[0].x)} y={sy(SIMPLEX[0].y) + 18} text-anchor="middle">100% {ASSETS[0]}</text>
            <text class="ru-vlabel" x={sx(SIMPLEX[1].x)} y={sy(SIMPLEX[1].y) + 18} text-anchor="middle">100% {ASSETS[1]}</text>
            <text class="ru-vlabel" x={sx(SIMPLEX[2].x)} y={sy(SIMPLEX[2].y) - 12} text-anchor="middle">100% {ASSETS[2]}</text>
            </g><!-- /act one -->

            <!-- ══ ACT TWO — THE SEQUENCE. Same rules, but now the object is a PATH: one decision per month, so
                 the feasible set is a set of sequences rather than a set of points. The same stage box, so the
                 second object costs no vertical space on a slide that already owns exactly one screen.
                 Every candidate path is drawn once; the rules comb them away. ══ -->
            <g class="ru-act ru-act--2" data-act="2">
              <!-- The band gridlines: exposure, low at the bottom. Drawn first so paths sit over them. -->
              {Array.from({ length: PATH_LEVELS }, (_, b) => {
                const y = lBox.y + (1 - b / (PATH_LEVELS - 1)) * lBox.h;
                return <line class="ru-band" x1={lBox.x} y1={y} x2={lBox.x + lBox.w} y2={y} />;
              })}
              {Array.from({ length: PATH_PERIODS }, (_, t) => {
                const x = lBox.x + (t / (PATH_PERIODS - 1)) * lBox.w;
                return <line class="ru-tick" x1={x} y1={lBox.y - 8} x2={x} y2={lBox.y + lBox.h + 8} />;
              })}

              <!-- THE WHOLE THICKET, as the ghost of what was possible — the counterpart of the simplex
                   outline in act one. All 625 sequences, drawn once, faintly. -->
              <g class="ru-thicket">
                {ALL_PATHS.map((path) => <polyline class="ru-path" points={ppts(path)} />)}
              </g>

              <!-- THE PATHS EACH RULE KILLS, revealed with that rule. Drawn under the survivors, so a reader
                   sees the deletion rather than only the remainder — the same discipline as act one's slab. -->
              {pathStages.map((st, i) => (
                <g class="ru-pathkill" data-pathkill={i}>
                  {st.killed.map((path) => <polyline class="ru-path ru-path--killed" points={ppts(path)} />)}
                </g>
              ))}

              <!-- WHAT SURVIVES after each rule. One group per stage, revealed in step with the list. -->
              {pathStages.map((st, i) => (
                <g class="ru-pathkeep" data-pathkeep={i}
                   data-rule-label={st.label} data-rule-why={st.why}
                   data-rule-pct={`${(st.remaining * 100).toFixed(1)}%`}
                   data-rule-kept={String(st.kept.length)}>
                  {st.kept.map((path) => <polyline class="ru-path ru-path--kept" points={ppts(path)} />)}
                </g>
              ))}

              <!-- The decision points themselves, so the reader sees this is a sequence of CHOICES. -->
              {Array.from({ length: PATH_PERIODS }, (_, t) =>
                Array.from({ length: PATH_LEVELS }, (_, b) => {
                  const x = lBox.x + (t / (PATH_PERIODS - 1)) * lBox.w;
                  const y = lBox.y + (1 - b / (PATH_LEVELS - 1)) * lBox.h;
                  return <circle class="ru-node" cx={x} cy={y} r="1.6" />;
                }))}

              <text class="ru-vlabel" x={lBox.x} y={lBox.y - 14} text-anchor="start">more risk</text>
              <text class="ru-vlabel" x={lBox.x} y={lBox.y + lBox.h + 22} text-anchor="start">less risk</text>
              <text class="ru-vlabel" x={lBox.x + lBox.w} y={lBox.y + lBox.h + 22} text-anchor="end">month {PATH_PERIODS}</text>
            </g><!-- /act two -->
          </svg>

          <p class="ru-read" data-read aria-live="polite">
            <span class="ru-read-label" data-read-label>Unconstrained</span>
            <span class="ru-read-body" data-read-body>every split of the money is available</span>
          </p>

          <figcaption class="ru-cap">
            <span class="ru-act ru-act--1" data-act-head="1">
              One surviving portfolio: <strong>{finalWeights.map((w, i) => `${(w * 100).toFixed(0)}% ${ASSETS[i]}`).join(' · ')}</strong>.
              Bounds are loosened to fit three assets — a real 5% single-name cap is infeasible on three names.
              The shape of the argument is exact; the count is what scales.
            </span>
            <span class="ru-act ru-act--2" data-act-head="2">
              <strong>{pathLeft}</strong> of <strong>{pathTotal}</strong> sequences survive all
              {PATH_RULES.length} rules. {PATH_LEVELS} exposure bands over {PATH_PERIODS} months is a modelling
              choice so the paths can be counted; the counts on that grid are exact, and the compounding figure
              needs no grid at all.
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .ru { position: relative; z-index: 1; width: 100vw; margin-left: calc(50% - 50vw); --deck-lead: 0px; }
  .ru-paper {
    --r-bg: #c4b7a1; --r-edge: rgba(74,66,54,0.26); --r-ink: #1f1b14;
    --r-soft: #423b30; --r-faint: #6a6153; --r-accent: #7c5522;
    background: var(--r-bg);
    border-top: 1px solid var(--r-edge); border-bottom: 1px solid var(--r-edge);
    padding: clamp(30px, 4vh, 62px) 0;
  }
  :global(html[data-theme='dark']) .ru-paper {
    --r-bg: #14161a; --r-edge: rgba(184,177,161,0.14); --r-ink: #dce1dc;
    --r-soft: #a8b0a9; --r-faint: #6d746e; --r-accent: #7fc9a0;
  }
  .ru-inner {
    /* Clears the fixed Toc rail, whose right edge moved from x=129 to x=151 once it gained an indented tier
       ("Problem / Limits / Method" under "The field"). Shared across the five paper slides. */
    padding-left: clamp(168px, 10.4vw, 200px); padding-right: clamp(20px, 2.4vw, 52px); box-sizing: border-box;
  }
  @media (max-width: 1099px) { .ru-inner { padding-left: clamp(28px, 6vw, 80px); } }

  .ru-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--r-accent); margin: 0 0 14px;
  }
  /* ── THE DRAWING IS THE SLIDE, which is the one thing the descent piece does that this did not.
     Measured before this change: the descent graph occupies 35.7% of its slide with NO divider rule — the
     drawing spans the panel and the text sits in its negative space. This slide gave its triangle 5.8% (340px
     in a 1700px frame), boxed in a right-hand column behind a hairline, which reads as an illustration beside
     an essay rather than as the subject. Same template on three consecutive slides is what made the sequence
     feel "off" even though each slide was individually fine.
     So the geometry now gets the room: no divider, a much larger simplex, and the type placed around it. */
  .ru-split {
    display: grid; grid-template-columns: 42fr 58fr; gap: 0 clamp(24px, 3vw, 56px); align-items: center;
  }
  .ru-fig { margin: 0; }
  @media (max-width: 1040px) {
    .ru-split { grid-template-columns: 1fr; gap: 4vh 0; }
    .ru-fig { padding-top: 4vh; border-top: 1px solid var(--r-edge); }
  }

  .ru-head {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(24px, 2.4vw, 38px); line-height: 1.16;
    color: var(--r-ink); margin: 0; max-width: 30ch; letter-spacing: -0.012em;
  }
  .ru-lede {
    font-size: clamp(13.5px, 1vw, 15px); line-height: 1.62; color: var(--r-soft);
    margin: 12px 0 0; max-width: 50ch;
  }

  /* The rules, as a numbered ledger: each dims until its cut has been made, so the list and the drawing are
     the same event seen twice. */
  .ru-list { list-style: none; margin: clamp(14px, 2vh, 22px) 0 0; padding: 0; display: grid; gap: 4px; }
  /* The two figure columns are labelled once, so neither needs a unit repeated on every row. */
  .ru-head-row {
    display: grid; grid-template-columns: 16px 1fr 5ch 5ch; gap: 0 clamp(10px, 1.2vw, 16px);
    padding: 0 8px 2px 10px;
  }
  .ru-col {
    font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--r-faint); text-align: right;
  }

  /* EACH RULE IS A BUTTON, reset to read as a ledger row. Full width and left-aligned so the whole row is the
     target rather than just the words — the same choice the defining slide's beats made. */
  .ru-item {
    display: grid; grid-template-columns: 16px 1fr 5ch 5ch; gap: 2px clamp(10px, 1.2vw, 16px);
    align-items: baseline; opacity: 0.42;
    width: 100%; text-align: left; margin: 0;
    background: none; border: 0; border-radius: 3px; font: inherit; color: inherit;
    padding: 4px 8px 5px 10px;
    /* Reserved at all times, so switching rules never reflows the column. */
    border-left: 2px solid transparent;
    -webkit-appearance: none; appearance: none;
  }
  /* html.poly-js is set by the script before it starts stepping, so dimming and the pointer affordance only
     happen where the sequence can actually run. Default = the finished state, which is also what a reader with
     JavaScript off gets: every rule legible. */
  :global(html.poly-js) .ru-item { cursor: pointer; }
  :global(html.poly-js) .ru-item:not(.is-done) { opacity: 0.42; }
  .ru-item.is-done { opacity: 1; }
  /* The rule being drawn right now — the one the readout and the slab belong to. */
  .ru-item.is-current { opacity: 1; border-left-color: var(--r-accent); }
  @media (hover: hover) {
    :global(html.poly-js) .ru-item:hover { opacity: 0.72; }
    :global(html.poly-js) .ru-item.is-done:hover,
    :global(html.poly-js) .ru-item.is-current:hover { opacity: 1; }
  }
  .ru-item:focus-visible { outline: 2px solid var(--r-accent); outline-offset: 2px; opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .ru-item { transition: opacity .5s ease, border-color .4s ease; }
  }
  /* No JS: every rule shown at full strength, matching the final polygon. */
  .ru-item { opacity: 1; }

  .ru-num {
    font-family: var(--font-mono); font-size: 9.5px; color: var(--r-accent);
    border: 1px solid currentColor; border-radius: 50%;
    width: 16px; height: 16px; display: grid; place-items: center;
  }
  .ru-label { font-size: 14px; line-height: 1.35; color: var(--r-ink); }
  /* WHAT THIS RULE COSTS, and what is left after it. Two different jobs, so two different weights: the cost is
     the new information (it is what makes some rules matter more than others) and reads in the accent; the
     remainder is running context and reads quieter. */
  .ru-cut {
    font-family: var(--font-mono); font-size: 12.5px; color: var(--r-accent);
    font-variant-numeric: tabular-nums; text-align: right;
  }
  .ru-pct {
    font-family: var(--font-mono); font-size: 12.5px; color: var(--r-faint);
    font-variant-numeric: tabular-nums; text-align: right;
  }
  .ru-why { grid-column: 2 / -1; font-size: 11.5px; line-height: 1.45; color: var(--r-faint); max-width: 52ch; }

  .ru-scale {
    font-size: clamp(13px, 0.98vw, 14.5px); line-height: 1.6; color: var(--r-soft);
    margin: clamp(14px, 2vh, 22px) 0 0; max-width: 56ch;
    padding-top: clamp(10px, 1.4vh, 14px); border-top: 1px solid var(--r-edge);
  }
  .ru-scale strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--r-accent); font-variant-numeric: tabular-nums;
  }

  .ru-fig-head {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--r-faint); margin: 0 0 10px;
  }
  /* Sized to the SLIDE, not to a column: the triangle is the object the slide is about, so it takes the height
     it can get. 340px was a thumbnail; this is the subject. */
  .ru-chart {
    width: 100%; max-width: min(620px, 100%); height: auto; display: block; margin: 0 auto;
  }

  /* The simplex stays visible as a ghost: the argument is about what was REMOVED, so the original space has to
     remain legible behind the survivor. */
  .ru-simplex {
    fill: color-mix(in srgb, var(--r-ink) 7%, transparent);
    stroke: var(--r-faint); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0.5;
  }
  /* The survivor needs to READ against the ghost simplex, and at 22% fill on a toned ground it did not — the
     remaining region was barely distinguishable from the space it survived inside, which is the one contrast
     the slide depends on. */
  .ru-stage {
    fill: color-mix(in srgb, var(--r-accent) 42%, transparent);
    stroke: var(--r-accent); stroke-width: 2; vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .ru-stage.is-shown { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .ru-stage { transition: opacity .55s ease; }
  }
  /* No JS / reduced motion: the last stage is the finished state. Default (no guard class) shows the last
     polygon, so a reader with JavaScript off gets the finished picture rather than an empty triangle. */
  .ru-stage { opacity: 0; }
  .ru-stage:last-of-type { opacity: 1; }
  :global(html.poly-js) .ru-stage:last-of-type { opacity: 0; }
  :global(html.poly-js) .ru-stage.is-shown { opacity: 1; }

  /* ── THE REMOVED SLAB. Hatched rather than filled: a second solid tone would compete with the survivor for
     "this is the region that matters", and hatching reads as deleted in a way a flat wash does not. The
     pattern is a repeating linear-gradient on a foreignObject-free SVG fill, so it needs a real <pattern> —
     defined inline below via CSS on the polygon instead, using a dashed stroke plus a light wash, which keeps
     it to two paint properties and no extra defs. ── */
  .ru-cutgroup { opacity: 0; }
  .ru-cutgroup.is-shown { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .ru-cutgroup { transition: opacity .45s ease; }
  }
  .ru-slab {
    fill: color-mix(in srgb, var(--r-ink) 13%, transparent);
    stroke: none;
  }
  /* THE LINE THAT DOES THE CUTTING — the slide's central claim, finally drawn. Dashed so it reads as a boundary
     being imposed rather than as an edge of the shape, and heavier than the polygon strokes because it is the
     event. */
  .ru-cutline {
    /* Measured at 1.6px / 0.5 opacity: only 65 dark pixels survived along a ~500px line, because it runs
       exactly along the survivor's own 2px accent edge and reads as a texture on that stroke rather than as a
       line of its own. Heavier, fully opaque, and with a longer dash so the gaps are legible at this size —
       this is the slide's central claim ("every rule is a straight line"), not an annotation. */
    stroke: var(--r-ink); stroke-width: 2.6; vector-effect: non-scaling-stroke;
    stroke-dasharray: 9 5; stroke-linecap: round; opacity: 0.9;
  }

  .ru-vertex { fill: var(--r-faint); }
  .ru-vlabel {
    font-family: var(--font-mono); font-size: 8px; fill: var(--r-faint);
    letter-spacing: 0.04em;
  }

  .ru-read {
    display: grid; grid-template-columns: auto 1fr; gap: 0 12px; align-items: baseline;
    margin: clamp(10px, 1.4vh, 16px) 0 0; min-height: 2.4em;
  }
  .ru-read-label {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--r-accent); white-space: nowrap;
  }
  .ru-read-body { font-size: 12.5px; line-height: 1.5; color: var(--r-soft); }

  /* ══ TWO ACTS ON ONE STAGE ═══════════════════════════════════════════════════════════════════════════
     Act one is the triangle (one period), act two the path lattice (a sequence). They share the drawing box
     and cross-fade, which is the only reason the second object costs no vertical space — the slide already
     owns exactly one screen and had 241px of measured headroom, nowhere near a second figure's worth.
     DEFAULT = act two, because it is the finished state: it is the multi-period picture, and the slide is
     about a multi-period field. With JavaScript off a reader therefore gets the object the slide is really
     about, and the sequencing is the enhancement. */
  .ru-act--1 { opacity: 0; }
  .ru-act--2 { opacity: 1; }
  :global(html.poly-js) .ru-act { opacity: 0; }
  :global(html.poly-js) .ru-act.is-live { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .ru-act { transition: opacity .6s ease; }
  }
  /* The two heads and the two captions occupy the same line rather than stacking, so switching act cannot
     reflow the column. Grid-stacked: both children in cell 1/1, the taller one setting the height. */
  .ru-fig-head, .ru-cap { display: grid; }
  .ru-fig-head > .ru-act, .ru-cap > .ru-act { grid-area: 1 / 1; }

  /* ── ACT TWO: THE THICKET. Every candidate sequence drawn once, hairline and nearly transparent — the
     counterpart of act one's ghost simplex. At 625 paths the overlap does the work: dense where many
     sequences pass, empty where none can. */
  .ru-path {
    fill: none; stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linejoin: round;
  }
  /* MEASURED AND CORRECTED: at 0.11 opacity, 625 overlapping hairlines accumulated into a solid plaid — a mesh
     with no legible structure, which is worse than no drawing. Alpha compounds where paths coincide, and on a
     5x4 grid they coincide constantly (every path shares every node with dozens of others). 0.03 is the level
     at which the DENSITY reads as texture instead of as a fill. */
  .ru-thicket .ru-path { stroke: var(--r-faint); opacity: 0.03; }
  /* A killed path is drawn ONCE, in ink, so the deletion is the visible event — same discipline as the slab
     in act one, where showing only the remainder made the rule invisible. Also thinned for the same reason:
     a rule can kill 530 paths at once. */
  .ru-path--killed { stroke: var(--r-ink); opacity: 0.07; }
  /* Survivors carry the accent and are the only confident marks on the stage — by the last rule there are 31
     of them, few enough to be followed individually, which is the whole reason the grid is small. */
  .ru-path--kept { stroke: var(--r-accent); opacity: 0.5; stroke-width: 1.5; }

  .ru-pathkill, .ru-pathkeep { opacity: 0; }
  .ru-pathkill.is-shown, .ru-pathkeep.is-shown { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .ru-pathkill, .ru-pathkeep { transition: opacity .5s ease; }
  }
  /* No JS: the last stage is the finished state, exactly as act one does with its final polygon. */
  .ru-pathkeep { opacity: 0; }
  .ru-pathkeep:last-of-type { opacity: 1; }
  :global(html.poly-js) .ru-pathkeep:last-of-type { opacity: 0; }
  :global(html.poly-js) .ru-pathkeep.is-shown { opacity: 1; }

  /* The band grid and the decision points: structure, not data, so they stay quiet. */
  .ru-band { stroke: var(--r-faint); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0.2; }
  .ru-tick { stroke: var(--r-faint); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0.13; }
  .ru-node { fill: var(--r-faint); opacity: 0.4; }

  /* The non-separability line — the sentence act two exists to earn, so it gets its own weight rather than
     being folded into the paragraph above it. */
  .ru-sep {
    font-size: clamp(12.5px, 0.94vw, 14px); line-height: 1.6; color: var(--r-soft);
    margin: clamp(8px, 1.2vh, 12px) 0 0; max-width: 56ch;
  }
  .ru-sep strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--r-accent); font-variant-numeric: tabular-nums;
  }
  .ru-scale sup { font-size: 0.72em; }

  .ru-cap {
    font-size: 10.5px; line-height: 1.5; color: var(--r-faint);
    margin: clamp(8px, 1.2vh, 14px) 0 0; max-width: 56ch;
  }
  .ru-cap strong { font-family: var(--font-mono); font-weight: 400; color: var(--r-soft); }
  /* ── RESPONSIVE BLOCK, at the END of the stylesheet on purpose: every declaration here overrides a base rule
     of the same specificity, so source order IS the mechanism. ── */

  /* SHORT SCREENS. Nothing here is broken by width, only by height, so the query is on height. Measured at
     1366x768 the slide ran 795px against a 768px screen; the list and the drawing each give up a little. */
  @media (max-height: 860px) {
    .ru-head { font-size: clamp(22px, 2vw, 30px); }
    .ru-lede { font-size: 13px; line-height: 1.5; }
    .ru-list { gap: 2px; }
    .ru-item { padding-top: 2px; padding-bottom: 3px; }
    .ru-label { font-size: 13px; }
    .ru-why { font-size: 11px; line-height: 1.38; }
    .ru-chart { max-width: min(500px, 100%); }
    .ru-read { min-height: 2em; }
    .ru-scale { font-size: 12.5px; line-height: 1.5; }
    .ru-sep { font-size: 12px; line-height: 1.45; margin-top: 6px; }
  }

  /* STACKED LAYOUT. Below 1040px the drawing sits UNDER the text rather than beside it, so the two heights are
     additive — measured, the slide ran to 1465px against a 1050px screen at three separate widths, because
     nothing capped the triangle once it had the full column width. It does not need to be tall when it is that
     wide, and the prose closes up to pay for the rest. */
  @media (max-width: 1040px) {
    /* The triangle's aspect is FIXED (an equilateral simplex, so drawn areas are real areas), so its height is
       0.866 x its width and the only way to shorten it is to narrow it. max-height does nothing here — measured,
       at a 400px width cap the chart drew 359px tall and a 420px max-height never bound. Sized from the
       viewport height instead, so the drawing shrinks on exactly the screens that cannot afford it:
       say 492 + fig 507 + chrome = 1156 against 1050 before this. */
    .ru-chart { max-width: min(30vh, 78%); }
    .ru-fig { padding-top: 2.4vh; }
    .ru-head { font-size: clamp(22px, 3.4vw, 30px); }
    .ru-lede { font-size: 13px; line-height: 1.55; }
    .ru-list { gap: 1px; }
    .ru-item { padding-top: 2px; padding-bottom: 2px; }
    .ru-why { font-size: 10.5px; line-height: 1.36; }
    .ru-scale { font-size: 12.5px; line-height: 1.5; padding-top: 8px; }
    /* The non-separability line is new vertical weight the stacked layout did not budget for — measured 17px
       over at three widths. It closes up here rather than being cut, because it is the sentence act two exists
       to earn. */
    .ru-sep { font-size: 12px; line-height: 1.45; margin-top: 6px; }
    .ru-cap { font-size: 10px; line-height: 1.42; }
    .ru-read { min-height: 0; margin-top: 8px; }
    /* The last 30px, taken from the paper's own padding and the gap between the two halves rather than from the
       type — everything above is already at the smallest size that reads. Measured after: fits exactly. */
    /* Measured repeatedly: with act two's extra paragraph the stacked slide sat 5px over at three widths, and
       every text size here is already at its floor. The last pixels come from the paper's own padding and the
       gap between the halves, which cost nothing to read. */
    .ru-paper { padding-top: clamp(10px, 1.4vh, 18px); padding-bottom: clamp(10px, 1.4vh, 18px); }
    .ru-split { gap: 1.4vh 0; }
    .ru-list { margin-top: 10px; }
    .ru-scale { margin-top: 10px; }
  }
</style>

<script>
  // THE COLLAPSE, one rule at a time, and the reader can drive it.
  //
  // PROGRESSIVE ENHANCEMENT in the only safe direction: the CSS default is the FINISHED state (every rule
  // legible, the final polygon shown), and html.poly-js — added only once the sequence is about to run — is
  // what switches on the dimming and the stepping. The earlier inverse guard (no-poly-js, added here and
  // removed on success) covered a script that RAN AND FAILED but not JavaScript being off entirely, where the
  // class never appeared at all.
  document.documentElement.classList.add('poly-js');

  function initPoly(): (() => void) | null {
    const section = document.querySelector<HTMLElement>('#rules');
    if (!section) return null;
    const polys = Array.from(section.querySelectorAll<SVGPolygonElement>('[data-poly]'));
    const cuts = Array.from(section.querySelectorAll<SVGGElement>('[data-cut]'));
    const items = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-stage]'));
    const label = section.querySelector<HTMLElement>('[data-read-label]');
    const body = section.querySelector<HTMLElement>('[data-read-body]');
    // ACT TWO's pieces. Absent means the second act was not rendered, which must degrade to act one rather
    // than disabling the slide.
    const kills = Array.from(section.querySelectorAll<SVGGElement>('[data-pathkill]'));
    const keeps = Array.from(section.querySelectorAll<SVGGElement>('[data-pathkeep]'));
    const acts = Array.from(section.querySelectorAll<HTMLElement>('[data-act], [data-act-head]'));
    if (!polys.length || !items.length || !label || !body || cuts.length !== polys.length * 2) {
      document.documentElement.classList.remove('poly-js');
      return null;
    }

    // ── THE SCRIPT, in two acts.
    //
    // Act one steps the triangle through its five cuts: the feasible set of ONE decision. Act two steps the
    // path lattice through its rules: the feasible set of a SEQUENCE. One timeline, so a reader who does
    // nothing sees the whole argument, and the act changes under them at the hinge.
    //
    // Step numbering is one flat line so freezing, arrow keys and the observer need no special cases:
    //   -1                     unconstrained triangle
    //   0 .. nOne-1            triangle cuts
    //   nOne .. nOne+nTwo-1    path rules
    const nOne = items.length;
    const nTwo = keeps.length;
    const LAST = nOne + nTwo - 1;

    const oneStages = items.map((li) => ({
      label: li.querySelector('.ru-label')?.textContent?.trim() ?? '',
      cut: li.querySelector('.ru-cut')?.textContent?.trim() ?? '',
      pct: li.querySelector('.ru-pct')?.textContent?.trim() ?? '',
      why: li.querySelector('.ru-why')?.textContent?.trim() ?? '',
    }));
    // Act two's copy comes off the data the page rendered into the list's dataset, so the readout cannot drift
    // from the geometry. Falls back to nothing rather than to invented text.
    const twoStages = keeps.map((g) => ({
      label: g.dataset.ruleLabel ?? '',
      why: g.dataset.ruleWhy ?? '',
      pct: g.dataset.rulePct ?? '',
      kept: g.dataset.ruleKept ?? '',
    }));

    let step = -1;
    let timer = 0;
    let frozen = false;
    const stop = () => { window.clearTimeout(timer); timer = 0; };

    const inActTwo = (st: number) => st >= nOne;

    const render = () => {
      const act = inActTwo(step) ? '2' : '1';
      for (const el of acts) {
        const mine = el.dataset.act ?? el.dataset.actHead;
        el.classList.toggle('is-live', mine === act);
      }

      // Act one: the survivor polygon and the slab its rule removed.
      const oneIdx = inActTwo(step) ? -1 : step;
      polys.forEach((pg, i) => pg.classList.toggle('is-shown', i === oneIdx));
      cuts.forEach((g) => g.classList.toggle('is-shown', Number(g.dataset.cut) === oneIdx));

      // Act two: what this rule killed, and what still survives.
      const twoIdx = inActTwo(step) ? step - nOne : -1;
      kills.forEach((g) => g.classList.toggle('is-shown', Number(g.dataset.pathkill) === twoIdx));
      keeps.forEach((g) => g.classList.toggle('is-shown', Number(g.dataset.pathkeep) === twoIdx));

      // The list marks act one's rules as done, and goes fully quiet in act two — its rows describe the
      // single-period cuts, so leaving one highlighted while the lattice is on screen would be a lie.
      items.forEach((li, i) => {
        li.classList.toggle('is-done', !inActTwo(step) && i <= step);
        li.classList.toggle('is-current', !inActTwo(step) && i === step);
        li.setAttribute('aria-pressed', String(!inActTwo(step) && i === step));
      });

      if (step < 0) {
        label.textContent = 'Unconstrained';
        body.textContent = 'every split of the money is available';
      } else if (!inActTwo(step)) {
        const st = oneStages[step];
        label.textContent = `${st.cut} → ${st.pct} left`;
        body.textContent = st.label.toLowerCase() + ' — ' + st.why.replace(/\.$/, '');
      } else {
        const st = twoStages[twoIdx];
        label.textContent = st.pct ? `${st.kept} paths → ${st.pct} left` : 'paths';
        body.textContent = st.label ? st.label.toLowerCase() + ' — ' + st.why.replace(/\.$/, '') : '';
      }
    };

    const freeze = (i: number) => {
      frozen = true;
      stop();
      section.dataset.frozen = 'true';
      step = i;
      render();
    };

    const pick = (e: Event) => {
      const i = items.indexOf(e.currentTarget as HTMLButtonElement);
      if (i >= 0) freeze(i);
    };
    for (const b of items) b.addEventListener('click', pick);

    // Arrow keys walk the WHOLE timeline, both acts, so a keyboard reader can reach the path lattice — which
    // the list's five buttons alone cannot get to.
    const onKey = (e: KeyboardEvent) => {
      const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1
        : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const from = step < 0 ? 0 : step;
      freeze((from + dir + (LAST + 1)) % (LAST + 1));
      if (!inActTwo(step)) items[step]?.focus();
    };
    for (const b of items) b.addEventListener('keydown', onKey);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Finished state: the multi-period picture, fully constrained. The buttons still work, so the same
      // control exists without anything moving on its own.
      step = LAST;
      render();
      return () => {
        for (const b of items) { b.removeEventListener('click', pick); b.removeEventListener('keydown', onKey); }
      };
    }

    const advance = () => {
      step = step >= LAST ? -1 : step + 1;
      render();
      // Hold longest on the two arrivals: the end of act one (the collapsed triangle) and the end of act two
      // (the surviving paths), because those are the two states the copy rests on. And hold a beat longer on
      // the hinge, where the object on the stage changes underneath the reader.
      const dwell = step === LAST ? 4200
        : step === nOne - 1 ? 3000
        : step === nOne ? 2600
        : step < 0 ? 1500 : 1700;
      timer = window.setTimeout(advance, dwell);
    };

    render();

    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (frozen) return;
      if (visible && !timer) timer = window.setTimeout(advance, 1200);
      else if (!visible) stop();
    }, { threshold: 0.3 });
    io.observe(section);

    return () => {
      stop();
      io.disconnect();
      for (const b of items) { b.removeEventListener('click', pick); b.removeEventListener('keydown', onKey); }
    };
  }

  let teardown: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = initPoly();
  });
</script>
