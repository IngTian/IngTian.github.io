---
// src/sections/Rules.astro
// SLIDE 2 OF 3 — HOW HARD THIS ACTUALLY IS.
//
// The owner's redirect, and it replaced the whole slide: "a graph is not illustrative here. the constraints are
// complex and internally connected… essentially this slide just needs to present how complex the situation is.
// that's the whole point. the first slide let people understand what it is, the second one introduce the immense
// complexity."
//
// So this slide is not a geometry lesson. It is the difficulty, in the four beats the owner named:
//   1. imagine you run $1bn+ — your picks are constrained and your slippage is now MEASURABLE
//   2. name a few of the constraints
//   3. draw the futures those names might take — thousands of them
//   4. so: account for a stochastic future, obey every rule, and optimise. All at once.
//
// WHAT WENT, AND WHY. Two earlier drawings lived here: a convex feasible polygon (lib/feasible) and a lattice of
// decision sequences (lib/pathspace). Both are real, exact and unit-tested — and both answer "what is the
// feasible set", a question a reader who has never been told no does not have. Worse, both SHRINK something,
// which reads as tidying up. The point is the opposite: the problem gets bigger the closer you look. Both
// modules stay in the tree, unreferenced and still fully tested, so nothing verified was thrown away and either
// can return if a later slide wants it.
//
// The four constraint categories below have been sitting in data/desk.ts unused since they were written, each
// with a real reason attached. They are the answer to beat two, and they finally get shown.
//
// Numbers: cited or computed, never invented. Impact is square-root, calibrated to the published anchor that one
// day's volume moves the price about one daily sigma. The fund's figures come from data/desk.ts. The
// trajectories are a seeded walk — identical on every build, because a fan that shimmered would undercut a slide
// whose whole claim is that this scale is real. Arithmetic in lib/complexity.ts (30 tests).
import { CONSTRAINTS, FUND } from '../data/desk';
import { humanCount } from '../lib/problemSize';
import {
  sizeLadder, trajectories, trajBounds, trajPoints,
  decisionVariables, scenarioLeaves, magnitude, TRAJ_COUNT, TRAJ_WEEKS,
} from '../lib/complexity';

const ladder = sizeLadder();
// The rung beat one QUOTES. It must be the same rung the headline names, because the reader sees the sentence
// and the bar chart at the same time — an earlier draft said "a billion dollars" while quoting the $10bn row's
// 6.7% and $13m, which is the kind of mismatch a careful reader catches immediately.
const quoted = ladder.find((r) => r.aum === 1_000_000_000) ?? ladder[ladder.length - 1];
const big = ladder[ladder.length - 1];
const you = ladder[0];

// One category per group, so beat two names KINDS of rule rather than four examples of one kind — the owner
// asked for "a few", and four kinds is the more informative reading.
const groups = ['Mandate', 'Regulatory', 'Liquidity', 'Operational'];
const named = groups
  .map((g) => CONSTRAINTS.find((c) => c.group === g))
  .filter((c): c is (typeof CONSTRAINTS)[number] => !!c);

const paths = trajectories();
const bounds = trajBounds(paths);
const W = 560, H = 300;
const box = { x: 0, y: 10, w: W, h: H - 20 };
const baseY = box.y + (1 - (100 - bounds.lo) / (bounds.hi - bounds.lo)) * box.h;

// Beat four's arithmetic. Deliberately crude, and the caption says so: nobody models the future with a 3-way
// tree, so it is an honest lower bound on "how many futures are there".
const vars = decisionVariables(FUND.tickers, FUND.periods);
const leafExp = magnitude(scenarioLeaves(3, FUND.periods));

// Three threads picked out in ink over the fan, so a reader sees that each line is one name's possible future
// rather than an abstract wash. Fixed indices, so the choice is deterministic like everything else here.
const HIGHLIGHT = [7, 41, 88];
---
<section id="rules" class="ru" aria-labelledby="ru-heading">
  <div class="ru-paper">
    <div class="ru-inner">
      <p class="ru-kicker">2 / 3 · the difficulty</p>

      <div class="ru-split">
        <div class="ru-say">
          <h2 id="ru-heading" class="ru-head">Now imagine it is not your money.</h2>

          <!-- THE FOUR BEATS, in the owner's order. Each is a real button: same interaction as the defining
               slide, because these beats carry numbers a reader will want to go back to. -->
          <ol class="ru-beats">
            <li>
              <button class="ru-beat" type="button" data-beat="0" aria-pressed="true">
                <span class="ru-beat-n">1</span>
                <span class="ru-beat-say">
                  <span class="ru-beat-head">You run a billion dollars.</span>
                  <span class="ru-beat-body">
                    Move a fifth of it and you are <strong>{(quoted.participation * 100).toFixed(1)}%</strong>
                    of everything that trades that day, in the most liquid stock there is — the price moves away
                    from you before you are done, and <strong>${Math.round(quoted.cost).toLocaleString()}</strong>
                    is gone on one decision. With {you.label} the same trade costs nothing, which is why you have
                    never had to think about it.
                  </span>
                </span>
              </button>
            </li>
            <li>
              <button class="ru-beat" type="button" data-beat="1" aria-pressed="false">
                <span class="ru-beat-n">2</span>
                <span class="ru-beat-say">
                  <span class="ru-beat-head">And you are not allowed to do most of it.</span>
                  <span class="ru-beat-body">
                    Four kinds of rule, of the <strong>{humanCount(FUND.constraints)}+</strong> a real mandate
                    carries. They are not a checklist — they refer to each other, so obeying one can breach
                    another.
                  </span>
                </span>
              </button>
            </li>
            <li>
              <button class="ru-beat" type="button" data-beat="2" aria-pressed="false">
                <span class="ru-beat-n">3</span>
                <span class="ru-beat-say">
                  <span class="ru-beat-head">Nobody knows what any of it will do.</span>
                  <span class="ru-beat-body">
                    {TRAJ_COUNT} possible years for <em>one</em> holding. A real book holds
                    <strong>{humanCount(FUND.tickers)}</strong> names, each with its own fan — and they move
                    together in ways that change exactly when it matters.
                  </span>
                </span>
              </button>
            </li>
            <li>
              <button class="ru-beat" type="button" data-beat="3" aria-pressed="false">
                <span class="ru-beat-n">4</span>
                <span class="ru-beat-say">
                  <span class="ru-beat-head">Now choose. Every month. For all of it.</span>
                  <span class="ru-beat-body">
                    <strong>{vars.toLocaleString()}</strong> numbers to pick across {FUND.periods} rebalances,
                    under interlocking rules, against <strong>10<sup>{leafExp}</sup></strong> possible futures —
                    paying slippage every time you change your mind.
                  </span>
                </span>
              </button>
            </li>
          </ol>

          <p class="ru-scale">
            That is the job. Not picking a winner — choosing a whole sequence of positions that stays legal and
            stays affordable, whichever of those futures actually arrives.
          </p>
        </div>

        <figure class="ru-fig">
          <!-- ONE FIGURE, FOUR STATES. The drawing answers whichever beat is live: the cost ladder, the rule
               categories, the fan of futures, then everything at once. Sharing one box is what lets the slide
               hold four ideas on a single screen — it owns exactly 100vh and has no room for four figures. -->
          <p class="ru-fig-head">
            <span class="ru-panel" data-head="0">The same decision, at four sizes</span>
            <span class="ru-panel" data-head="1">Four kinds of rule, all binding at once</span>
            <span class="ru-panel" data-head="2">{TRAJ_COUNT} futures — for one holding</span>
            <span class="ru-panel" data-head="3">All of it, simultaneously</span>
          </p>

          <div class="ru-stagebox">
            <!-- ── BEAT 1: THE COST LADDER. Bars are log-scaled and the note says so: the span is six orders of
                 magnitude, and on a linear axis three of the four bars would be invisible. -->
            <div class="ru-panel ru-ladder" data-panel="0">
              <ul class="ru-rungs">
                {ladder.map((r) => {
                  const hiL = Math.log10(Math.max(big.cost, 10));
                  // NOTE: written as `r.cost > 1 ? ... : ...` rather than `r.cost <= 1`. Astro's template
                  // compiler reads `<=` inside a JSX expression as `<` opening a fragment and fails with
                  // "Unable to assign attributes when using <> Fragment shorthand syntax".
                  const w = r.cost > 1 ? Math.max(1.5, (Math.log10(r.cost) / hiL) * 100) : 1.5;
                  return (
                    <li>
                      <span class="ru-rung-label">{r.label}</span>
                      <span class="ru-rung-aum">
                        {r.aum >= 1e9 ? `$${(r.aum / 1e9).toFixed(0)}bn` : r.aum >= 1e6 ? `$${(r.aum / 1e6).toFixed(0)}m` : `$${r.aum.toLocaleString()}`}
                      </span>
                      <span class="ru-rung-track"><span class="ru-rung-bar" style={`width:${w.toFixed(1)}%`}></span></span>
                      <span class="ru-rung-cost">
                        {r.cost < 1 ? '—' : r.cost < 1e6 ? `$${Math.round(r.cost).toLocaleString()}` : `$${(r.cost / 1e6).toFixed(1)}m`}
                      </span>
                    </li>
                  );
                })}
              </ul>
              <p class="ru-note">
                Cost of moving a fifth of the book at once. Bars are log-scaled: the span is
                <strong>{magnitude(big.cost)}</strong> orders of magnitude, so a linear axis would draw one bar
                and three slivers.
              </p>
            </div>

            <!-- ── BEAT 2: THE RULE CATEGORIES, each with the reason it exists. Four KINDS, not four examples,
                 and every one of them is a real category with a real cause. -->
            <div class="ru-panel ru-rules" data-panel="1">
              <ul class="ru-cats">
                {named.map((c) => (
                  <li>
                    <span class="ru-cat">{c.group}</span>
                    <span class="ru-cat-rule">{c.rule}</span>
                    <span class="ru-cat-why">{c.why}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- ── BEAT 3: THE FAN. Every trajectory drawn once, three picked out in ink.
                 MEASURED: rasterised into this exact 560x300 box, 120 paths ink about 20% of it — plural enough
                 that the eye stops counting, sparse enough that one thread can still be followed. This is the
                 fix for the mistake the earlier path lattice made, where 625 lines at 0.11 opacity accumulated
                 into a solid plaid: free trajectories overlap far less than paths through a shared grid. -->
            <div class="ru-panel ru-fan" data-panel="2">
              <svg class="ru-fanchart" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img"
                   aria-label={`${TRAJ_COUNT} possible one-year paths for a single holding, spreading from one starting value to a wide range of outcomes.`}>
                <line class="ru-base" x1="0" y1={baseY} x2={W} y2={baseY} />
                {/* The fan is emitted ONCE, here, and beat four references it with <use>. Drawing it twice cost
                    240 polylines of ~53 points each and pushed LCP to 2.7s (Lighthouse perf 96 -> 95) for a
                    picture the reader never sees twice at once. */}
                <g id="ru-fan-paths">
                  {paths.map((p, i) => (
                    <polyline class:list={['ru-traj', HIGHLIGHT.includes(i) && 'ru-traj--lit']}
                              points={trajPoints(p, bounds, box)} />
                  ))}
                </g>
              </svg>
              <p class="ru-note">
                One holding, {TRAJ_WEEKS} weeks, {TRAJ_COUNT} of its possible futures. Three drawn in ink so the
                individual threads are visible; the dotted line is where you started.
              </p>
            </div>

            <!-- ── BEAT 4: the same fan, ghosted, with the scale of the question laid over it — because "all of
                 it at once" should look like all of it at once rather than like a new subject. -->
            <div class="ru-panel ru-all" data-panel="3">
              <svg class="ru-fanchart ru-fanchart--ghost" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                {/* Reuses beat three's geometry rather than re-emitting 120 polylines — same picture, ghosted. */}
                <use href="#ru-fan-paths" />
              </svg>
              <ul class="ru-tally">
                <li><span class="ru-tally-n">{humanCount(FUND.tickers)}</span><span class="ru-tally-l">names, each with its own fan</span></li>
                <li><span class="ru-tally-n">{FUND.periods}</span><span class="ru-tally-l">rebalances in the year</span></li>
                <li><span class="ru-tally-n">{vars.toLocaleString()}</span><span class="ru-tally-l">weights to choose</span></li>
                <li><span class="ru-tally-n">{humanCount(FUND.constraints)}+</span><span class="ru-tally-l">rules, all interlocking</span></li>
                <li class="ru-tally--big">
                  <span class="ru-tally-n">10<sup>{leafExp}</sup></span>
                  <span class="ru-tally-l">futures to be right in — and that is at three outcomes a month</span>
                </li>
              </ul>
            </div>
          </div>

          <figcaption class="ru-cap">
            <span class="ru-panel" data-head="0">
              Square-root impact, calibrated so that trading a full day's volume moves the price by one daily
              standard deviation — the published rule of thumb. Volumes are a mega-cap's: the friendliest case
              there is.
            </span>
            <span class="ru-panel" data-head="1">
              Every category is real and every reason is the actual reason. The thresholds are typical rather
              than any one fund's, and a real mandate runs to hundreds of pages.
            </span>
            <span class="ru-panel" data-head="2">
              Illustrative paths from a fixed seed — identical on every build. A real book's names also move
              TOGETHER, which no single fan can show, and their correlation rises exactly when you need it not
              to.
            </span>
            <span class="ru-panel" data-head="3">
              The scenario count is a deliberate lower bound: three outcomes a month is far cruder than anyone
              would model, and it still reaches 10<sup>{leafExp}</sup>.
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .ru { position: relative; z-index: 1; width: 100vw; margin-left: calc(50% - 50vw); --deck-lead: 0px; }
  .ru-paper {
    --r-bg: #c4b7a1; --r-edge: rgba(74,66,54,0.26); --r-ink: #1f1b14;
    --r-soft: #423b30; --r-faint: #6a6153; --r-accent: #7c5522;
    background: var(--r-bg);
    border-top: 1px solid var(--r-edge); border-bottom: 1px solid var(--r-edge);
    padding: clamp(30px, 4vh, 62px) 0;
  }
  :global(html[data-theme='dark']) .ru-paper {
    --r-bg: #14161a; --r-edge: rgba(184,177,161,0.14); --r-ink: #dce1dc;
    --r-soft: #a8b0a9; --r-faint: #6d746e; --r-accent: #7fc9a0;
  }
  .ru-inner {
    /* Clears the fixed Toc rail, whose right edge sits at x=151 once it carries its indented tier. Shared
       across the five paper slides, so it is edited in all of them together or in none. */
    padding-left: clamp(168px, 10.4vw, 200px); padding-right: clamp(20px, 2.4vw, 52px); box-sizing: border-box;
  }
  @media (max-width: 1100px) { .ru-inner { padding-left: clamp(28px, 6vw, 80px); } }

  .ru-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--r-accent); margin: 0 0 12px;
  }

  .ru-split {
    display: grid; grid-template-columns: 44fr 56fr; gap: 0 clamp(24px, 3vw, 56px); align-items: center;
  }
  .ru-fig { margin: 0; min-width: 0; }

  .ru-head {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(24px, 2.4vw, 38px); line-height: 1.16;
    color: var(--r-ink); margin: 0; max-width: 26ch; letter-spacing: -0.012em;
  }

  /* ── THE FOUR BEATS. Buttons, like the defining slide's, so a reader can go back to a number. */
  .ru-beats { list-style: none; margin: clamp(16px, 2.4vh, 28px) 0 0; padding: 0; display: grid; gap: 4px; }
  .ru-beat {
    display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 0 12px;
    align-items: start; width: 100%; text-align: left; margin: 0;
    background: none; border: 0; border-radius: 3px; font: inherit; color: inherit;
    padding: 7px 8px 8px 10px;
    /* Reserved at all times, so switching beats never reflows the column. */
    border-left: 2px solid transparent;
    opacity: 1;
    -webkit-appearance: none; appearance: none;
  }
  /* html.complex-js is added by the script before it starts stepping, so the dimming and the pointer affordance
     only appear where the sequence can actually run. Default = every beat legible, which is the no-JS state. */
  :global(html.complex-js) .ru-beat { cursor: pointer; opacity: 0.4; }
  :global(html.complex-js) .ru-beat.is-on { opacity: 1; border-left-color: var(--r-accent); }
  @media (hover: hover) {
    :global(html.complex-js) .ru-beat:not(.is-on):hover { opacity: 0.7; }
  }
  .ru-beat:focus-visible { outline: 2px solid var(--r-accent); outline-offset: 2px; opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .ru-beat { transition: opacity .45s ease, border-color .4s ease; }
  }

  .ru-beat-n {
    font-family: var(--font-mono); font-size: 9.5px; color: var(--r-accent);
    border: 1px solid currentColor; border-radius: 50%;
    width: 17px; height: 17px; display: grid; place-items: center; margin-top: 2px;
  }
  .ru-beat-say { display: block; min-width: 0; }
  .ru-beat-head {
    display: block; font-size: clamp(14px, 1.08vw, 16px); line-height: 1.3; color: var(--r-ink);
  }
  .ru-beat-body {
    display: block; font-size: clamp(11.5px, 0.88vw, 13px); line-height: 1.5; color: var(--r-faint);
    margin-top: 3px; max-width: 46ch;
  }
  .ru-beat-body strong {
    font-family: var(--font-mono); font-weight: 400; color: var(--r-accent); font-variant-numeric: tabular-nums;
  }
  .ru-beat-body sup { font-size: 0.7em; }

  .ru-scale {
    font-size: clamp(13px, 0.98vw, 14.5px); line-height: 1.6; color: var(--r-soft);
    margin: clamp(14px, 2vh, 22px) 0 0; max-width: 52ch;
    padding-top: clamp(10px, 1.4vh, 14px); border-top: 1px solid var(--r-edge);
  }

  .ru-fig-head {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--r-faint); margin: 0 0 12px; display: grid;
  }
  .ru-fig-head > .ru-panel { grid-area: 1 / 1; }

  /* ── ONE BOX, FOUR PANELS, absolutely positioned inside a fixed-height stage so switching beats never
     reflows the column — the same arrangement the defining slide uses, and for the same reason. */
  .ru-stagebox { position: relative; width: 100%; min-height: clamp(280px, 40vh, 400px); }
  .ru-panel { opacity: 0; pointer-events: none; }
  .ru-panel.is-on { opacity: 1; pointer-events: auto; }
  .ru-stagebox > .ru-panel { position: absolute; inset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .ru-panel { transition: opacity .5s ease; }
  }
  /* No JS: show the FIRST beat, which is the slide's opening claim. The four beats read as text regardless. */
  .ru-panel[data-panel='0'], .ru-panel[data-head='0'] { opacity: 1; }
  :global(html.complex-js) .ru-panel[data-panel='0'],
  :global(html.complex-js) .ru-panel[data-head='0'] { opacity: 0; }
  :global(html.complex-js) .ru-panel.is-on { opacity: 1; }

  /* ── BEAT 1: the cost ladder. */
  .ru-ladder { display: flex; flex-direction: column; justify-content: center; }
  .ru-rungs { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(12px, 2vh, 22px); }
  .ru-rungs li {
    display: grid; grid-template-columns: minmax(0, 1fr) 6ch; gap: 3px clamp(10px, 1.4vw, 18px);
    align-items: baseline;
  }
  .ru-rung-label { font-size: 13.5px; color: var(--r-ink); }
  .ru-rung-aum {
    font-family: var(--font-mono); font-size: 12px; color: var(--r-faint); text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .ru-rung-track {
    grid-column: 1 / 2; height: 9px; background: color-mix(in srgb, var(--r-ink) 8%, transparent);
    border-radius: 1px; overflow: hidden;
  }
  .ru-rung-bar { display: block; height: 100%; background: var(--r-accent); opacity: 0.75; }
  .ru-rung-cost {
    grid-column: 2 / 3; font-family: var(--font-mono); font-size: 12.5px; color: var(--r-accent);
    text-align: right; font-variant-numeric: tabular-nums;
  }

  /* ── BEAT 2: the rule categories. */
  .ru-rules { display: flex; flex-direction: column; justify-content: center; }
  .ru-cats { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(10px, 1.6vh, 18px); }
  .ru-cats li { display: grid; gap: 2px; }
  .ru-cat {
    font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--r-accent);
  }
  .ru-cat-rule { font-size: 13px; line-height: 1.35; color: var(--r-ink); }
  .ru-cat-why { font-size: 11.5px; line-height: 1.45; color: var(--r-faint); max-width: 54ch; }

  /* ── BEATS 3 AND 4: the fan of futures. */
  .ru-fan { display: flex; flex-direction: column; justify-content: center; }
  .ru-fanchart { width: 100%; height: clamp(190px, 27vh, 300px); display: block; }
  .ru-traj {
    fill: none; stroke: var(--r-faint); stroke-width: 1; vector-effect: non-scaling-stroke;
    opacity: 0.22; stroke-linejoin: round;
  }
  /* Three threads in ink, so a reader sees that each line is one name's possible future. */
  .ru-traj--lit { stroke: var(--r-accent); opacity: 0.9; stroke-width: 1.8; }
  .ru-base {
    stroke: var(--r-faint); stroke-width: 1; stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke; opacity: 0.5;
  }
  /* THE GHOST. <use> clones the referenced group, and the clone's own classes come with it — so the three
     accent-lit threads arrived at full strength and the tally sat on a fan louder than itself. Fading the
     <use> element as a whole is what actually ghosts it, since the clone's internal opacities multiply by it. */
  .ru-fanchart--ghost { opacity: 0.42; }
  .ru-fanchart--ghost .ru-traj { opacity: 0.1; }
  .ru-fanchart--ghost .ru-traj--lit { stroke: var(--r-faint); stroke-width: 1; opacity: 0.14; }

  /* ── BEAT 4: the tally, laid over the ghosted fan. */
  .ru-all { display: grid; align-items: center; }
  .ru-all > * { grid-area: 1 / 1; }
  .ru-tally {
    list-style: none; margin: 0; padding: 0; align-self: center;
    display: grid; gap: clamp(5px, 0.9vh, 10px);
  }
  .ru-tally li {
    display: grid; grid-template-columns: 7ch minmax(0, 1fr); gap: 0 clamp(10px, 1.2vw, 16px);
    align-items: baseline;
  }
  .ru-tally-n {
    font-family: var(--font-mono); font-size: clamp(13px, 1.1vw, 16px); color: var(--r-accent);
    text-align: right; font-variant-numeric: tabular-nums;
  }
  .ru-tally-n sup { font-size: 0.68em; }
  .ru-tally-l { font-size: clamp(11.5px, 0.88vw, 13px); line-height: 1.4; color: var(--r-soft); }
  .ru-tally--big .ru-tally-n { font-size: clamp(16px, 1.5vw, 22px); color: var(--r-ink); }

  .ru-note {
    font-family: var(--font-mono); font-size: 9px; line-height: 1.5; letter-spacing: 0.04em;
    color: var(--r-faint); margin: clamp(8px, 1.2vh, 14px) 0 0; max-width: 60ch;
  }

  .ru-cap {
    font-size: 10.5px; line-height: 1.5; color: var(--r-faint);
    margin: clamp(8px, 1.2vh, 14px) 0 0; max-width: 60ch; display: grid;
  }
  .ru-cap > .ru-panel { grid-area: 1 / 1; }
  .ru-cap sup { font-size: 0.72em; }

  /* ── RESPONSIVE, at the END of the sheet on purpose: every declaration here overrides one of the same
     specificity above, so source order is the whole mechanism. */
  @media (max-height: 860px) {
    /* Measured: the rule-categories panel is the tallest of the four and overflowed the shared stagebox by
       10-15px at 1366x768 and 1280x800 — the box is sized to the fan, and four stacked rules with reasons need
       more than that. The categories close up here rather than the box growing, because the box growing would
       push the whole slide past the screen. */
    .ru-cats { gap: clamp(6px, 1vh, 12px); }
    .ru-cat-rule { font-size: 12px; line-height: 1.3; }
    .ru-cat-why { font-size: 10.5px; line-height: 1.38; }
    .ru-head { font-size: clamp(22px, 2vw, 30px); }
    .ru-beats { gap: 2px; margin-top: clamp(12px, 1.8vh, 20px); }
    .ru-beat { padding-top: 4px; padding-bottom: 5px; }
    .ru-beat-head { font-size: clamp(13px, 0.98vw, 15px); }
    .ru-beat-body { font-size: clamp(11px, 0.82vw, 12px); line-height: 1.44; }
    .ru-stagebox { min-height: clamp(240px, 34vh, 330px); }
    .ru-fanchart { height: clamp(160px, 22vh, 240px); }
    .ru-scale { font-size: 12.5px; line-height: 1.5; }
    .ru-rungs { gap: clamp(9px, 1.4vh, 16px); }
  }

  @media (max-width: 1040px) {
    .ru-split { grid-template-columns: 1fr; gap: 3vh 0; }
    .ru-fig { padding-top: 3vh; border-top: 1px solid var(--r-edge); }
    .ru-paper { padding-top: clamp(14px, 2vh, 24px); padding-bottom: clamp(14px, 2vh, 24px); }
    .ru-head { font-size: clamp(22px, 3.4vw, 30px); }
    .ru-beats { gap: 1px; }
    .ru-beat { padding-top: 4px; padding-bottom: 4px; }
    .ru-beat-body { font-size: clamp(11px, 1.4vw, 12.5px); line-height: 1.44; }
    .ru-stagebox { min-height: clamp(220px, 28vh, 290px); }
    .ru-fanchart { height: clamp(140px, 19vh, 210px); }
    .ru-scale { font-size: 12.5px; line-height: 1.5; padding-top: 8px; }
    .ru-note, .ru-cap { font-size: 9.5px; line-height: 1.42; }
    .ru-rungs { gap: clamp(8px, 1.2vh, 14px); }
    .ru-cats { gap: clamp(7px, 1vh, 12px); }
  }
</style>

<script>
  // THE FOUR BEATS, in order, and the reader can take the wheel.
  //
  // PROGRESSIVE ENHANCEMENT in the only safe direction: the CSS default is beat one shown with all four beats
  // legible as text, and html.complex-js — added only once the sequence is about to run — is what switches on
  // the dimming and the stepping. So JavaScript switched off entirely leaves a readable slide rather than an
  // empty one, which is the failure mode the inverse-guard pattern used to have.
  document.documentElement.classList.add('complex-js');

  function initComplex(): (() => void) | null {
    const section = document.querySelector<HTMLElement>('#rules');
    if (!section) return null;
    const beats = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-beat]'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-panel]'));
    const heads = Array.from(section.querySelectorAll<HTMLElement>('[data-head]'));
    if (!beats.length || panels.length !== beats.length) {
      // Nothing to step — hand the slide back to its CSS default rather than leaving it dimmed.
      document.documentElement.classList.remove('complex-js');
      return null;
    }

    const show = (i: number) => {
      beats.forEach((b, k) => {
        b.classList.toggle('is-on', k === i);
        b.setAttribute('aria-pressed', String(k === i));
      });
      panels.forEach((p, k) => p.classList.toggle('is-on', k === i));
      // TWO elements share each head index — the figure's heading and the caption — so match on the attribute
      // VALUE rather than on position in the list.
      heads.forEach((h) => h.classList.toggle('is-on', Number(h.dataset.head) === i));
    };

    let step = 0;
    let timer = 0;
    // FROZEN ONCE CLICKED, and it stays frozen — the same rule as the two neighbouring slides. These beats carry
    // numbers a reader will want to sit with, and a timer that resumed would pull the slide away mid-thought.
    let frozen = false;
    const stop = () => { window.clearTimeout(timer); timer = 0; };

    const freeze = (i: number) => {
      frozen = true;
      stop();
      section.dataset.frozen = 'true';
      step = i;
      show(i);
    };

    const pick = (e: Event) => {
      const i = beats.indexOf(e.currentTarget as HTMLButtonElement);
      if (i >= 0) freeze(i);
    };
    for (const b of beats) b.addEventListener('click', pick);

    // Arrow keys walk the group, so a keyboard reader need not tab through four buttons to reach the last beat.
    const onKey = (e: KeyboardEvent) => {
      const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1
        : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      freeze((step + dir + beats.length) % beats.length);
      beats[step].focus();
    };
    for (const b of beats) b.addEventListener('keydown', onKey);

    show(0);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Finished state: the LAST beat, which is the one the slide's argument rests on. The buttons still work,
      // so a reduced-motion reader gets the same control without anything moving on its own.
      step = beats.length - 1;
      show(step);
      return () => {
        for (const b of beats) { b.removeEventListener('click', pick); b.removeEventListener('keydown', onKey); }
      };
    }

    const advance = () => {
      step = (step + 1) % beats.length;
      show(step);
      // Hold longest on the last beat: it is the slide's whole point and it carries the most to read.
      timer = window.setTimeout(advance, step === beats.length - 1 ? 6400 : 4600);
    };

    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (frozen) return;                        // a reader's choice outranks the observer
      if (visible && !timer) timer = window.setTimeout(advance, 4200);
      else if (!visible) stop();
    }, { threshold: 0.3 });
    io.observe(section);

    return () => {
      stop();
      io.disconnect();
      for (const b of beats) { b.removeEventListener('click', pick); b.removeEventListener('keydown', onKey); }
    };
  }

  let teardown: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = initComplex();
  });
</script>
