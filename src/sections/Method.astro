---
// src/sections/Method.astro
// SLIDE 2 — WHY IT IS HARD, AND WHAT THE JOB IS.
//
// The owner's reframe of the whole sequence: "our job is to illustrate 1. what this topic is 2. why is it
// important and hard 3. what's my job." Slide 1 is (1); this is (2) and (3).
//
// And the framing correction that rebuilt this slide: "it should be 'we are trying to find this strategy'
// vs. 'this is mine'." The previous version drew three published curves and highlighted one as the owner's.
// That was defensible on the data but wrong in stance — it made the slide about a result he owns rather than
// about the search he performs. So the subject is now the SEARCH: the size of the space, the constraints
// that cut it, and the fact that the answer must be found rather than picked.
//
// The paper is no longer the spine of the argument — "you don't necessarily need to follow the paper, it's
// just one paper" — so it appears on the next slide as evidence, not here as the thesis.
//
// WHY THIS IS HARD IS ARITHMETIC, NOT OPINION, which is the only way to convince a reader with no finance
// background. 4 assets x 12 periods = 48 decisions; 3000 tickers x 24 periods = 72,000, and the number of
// corner portfolios does not fit in a double. lib/problemSize.ts computes it, 15 tests verify it.
import { TOY, REAL, HARD_POINTS, JOB_HEAD, JOB_BODY, JOB_TOOLS } from '../data/scale';
import { multiPeriodVars, scaleFactor, humanCount, log10Combinations } from '../lib/problemSize';

const toyVars = multiPeriodVars(TOY.assets, TOY.periods);
const realVars = multiPeriodVars(REAL.tickers, REAL.periods);
const factor = scaleFactor(TOY, REAL);
// How many "corner" portfolios exist if you had to enumerate 100 holdings out of the universe. The value
// overflows a double, so it is stated as a magnitude — and that IS the argument.
const cornerMagnitude = Math.round(log10Combinations(REAL.tickers, 100));
---
<section id="method" class="mt" aria-labelledby="mt-heading">
  <div class="mt-paper">
    <div class="mt-inner">
      <p class="mt-kicker">Why it is hard</p>
      <h2 id="mt-heading" class="mt-headline">
        The example had {toyVars} decisions. A real mandate has {humanCount(realVars)}, and they are all
        entangled.
      </h2>

      <!-- THE SCALE, as a comparison a non-specialist can hold. -->
      <dl class="mt-scale">
        <div class="mt-scale-item">
          <dt>{TOY.assets} × {TOY.periods}</dt>
          <dd><span class="mt-scale-label">{TOY.label}</span>{toyVars} weights to choose</dd>
        </div>
        <div class="mt-scale-item is-big">
          <dt>{humanCount(REAL.tickers)} × {REAL.periods}</dt>
          <dd><span class="mt-scale-label">{REAL.label}</span>{humanCount(realVars)} weights, {humanCount(REAL.constraints)} constraints</dd>
        </div>
        <div class="mt-scale-item">
          <dt>{humanCount(factor)}×</dt>
          <dd><span class="mt-scale-label">larger</span>and every choice changes what the next one costs</dd>
        </div>
      </dl>

      <div class="mt-split">
        <!-- WHY IT IS HARD: three reasons, each in plain language. -->
        <div class="mt-why">
          {HARD_POINTS.map((h) => (
            <div class="mt-why-item">
              <p class="mt-why-head">{h.head}</p>
              <p class="mt-why-body">{h.body}</p>
            </div>
          ))}
          <p class="mt-corners">
            Enumeration is not an option: choosing which 100 of {humanCount(REAL.tickers)} holdings to own
            has on the order of <strong>10<sup>{cornerMagnitude}</sup></strong> answers — more than there are
            atoms in the observable universe. You cannot list them. You have to move through them.
          </p>
        </div>

        <!-- WHAT THE JOB IS. -->
        <div class="mt-job">
          <p class="mt-kicker mt-kicker--job">What my job is</p>
          <p class="mt-job-head">{JOB_HEAD}</p>
          {JOB_BODY.map((p) => <p class="mt-job-body">{p}</p>)}
          <ul class="mt-tools">
            {JOB_TOOLS.map((t) => (
              <li>
                <span class="mt-tool-name">{t.name}</span>
                <span class="mt-tool-role">{t.role}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mt {
    position: relative; z-index: 1;
    width: 100vw; margin-left: calc(50% - 50vw);
    --deck-lead: 0px;
  }
  .mt-paper {
    --mt-bg: #c4b7a1;
    --mt-edge: rgba(74, 66, 54, 0.26);
    --mt-ink: #1f1b14;
    --mt-ink-soft: #423b30;
    --mt-ink-faint: #6a6153;
    --mt-accent: #7c5522;
    background: var(--mt-bg);
    border-top: 1px solid var(--mt-edge);
    border-bottom: 1px solid var(--mt-edge);
    padding: clamp(42px, 5.8vh, 88px) 0;
  }
  :global(html[data-theme='dark']) .mt-paper {
    --mt-bg: #14161a;
    --mt-edge: rgba(184, 177, 161, 0.14);
    --mt-ink: #dce1dc;
    --mt-ink-soft: #a8b0a9;
    --mt-ink-faint: #6d746e;
    --mt-accent: #7fc9a0;
  }
  .mt-inner {
    padding-left: clamp(150px, 9.5vw, 190px);
    padding-right: clamp(20px, 2.4vw, 52px);
    box-sizing: border-box;
  }
  @media (max-width: 1099px) { .mt-inner { padding-left: clamp(28px, 6vw, 80px); } }

  .mt-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--mt-accent); margin: 0 0 14px;
  }
  .mt-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(23px, 2.1vw, 36px); line-height: 1.22;
    color: var(--mt-ink); margin: 0; max-width: 46ch;
    letter-spacing: -0.008em; text-wrap: pretty;
  }

  /* THE SCALE COMPARISON — mono figures, so it reads as measurement rather than as marketing. */
  .mt-scale {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(14px, 2vh, 24px) clamp(20px, 2.6vw, 48px);
    margin: clamp(22px, 3vh, 38px) 0 0;
    padding: clamp(16px, 2.2vh, 26px) 0;
    border-top: 1px solid var(--mt-edge);
    border-bottom: 1px solid var(--mt-edge);
  }
  .mt-scale-item dt {
    font-family: var(--font-mono); font-size: clamp(17px, 1.5vw, 23px);
    color: var(--mt-ink-soft); line-height: 1; font-variant-numeric: tabular-nums;
  }
  .mt-scale-item.is-big dt { color: var(--mt-accent); }
  .mt-scale-item dd {
    margin: 9px 0 0; font-size: 12.5px; line-height: 1.5; color: var(--mt-ink-faint); max-width: 32ch;
  }
  .mt-scale-label {
    display: block; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--mt-ink-soft); margin-bottom: 5px;
  }

  .mt-split {
    display: grid; grid-template-columns: 54fr 46fr;
    gap: 0 clamp(30px, 3.6vw, 72px);
    margin: clamp(22px, 3vh, 38px) 0 0;
    align-items: start;
  }
  .mt-job { border-left: 1px solid var(--mt-edge); padding-left: clamp(30px, 3.6vw, 72px); }
  @media (max-width: 1040px) {
    .mt-split { grid-template-columns: 1fr; gap: 4vh 0; }
    .mt-job { border-left: 0; padding-left: 0; padding-top: 4vh; border-top: 1px solid var(--mt-edge); }
  }

  .mt-why-item + .mt-why-item { margin-top: clamp(14px, 1.8vh, 22px); }
  .mt-why-head {
    font-family: var(--font-display); font-weight: 500; font-size: 16px;
    color: var(--mt-ink); margin: 0 0 5px;
  }
  .mt-why-body {
    font-size: clamp(13.5px, 1vw, 15px); line-height: 1.68; color: var(--mt-ink-soft);
    margin: 0; max-width: 56ch;
  }
  .mt-corners {
    font-size: clamp(13.5px, 1vw, 15px); line-height: 1.68; color: var(--mt-ink-soft);
    margin: clamp(16px, 2.2vh, 26px) 0 0; max-width: 56ch;
    padding-top: clamp(12px, 1.6vh, 18px); border-top: 1px solid color-mix(in srgb, var(--mt-edge) 60%, transparent);
  }
  .mt-corners strong { font-family: var(--font-mono); color: var(--mt-accent); font-weight: 400; }
  .mt-corners sup { font-size: 0.72em; }

  .mt-kicker--job { margin-bottom: 12px; }
  .mt-job-head {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(18px, 1.5vw, 25px); line-height: 1.3;
    color: var(--mt-ink); margin: 0 0 16px; max-width: 30ch;
  }
  .mt-job-body {
    font-size: clamp(13.5px, 1vw, 15px); line-height: 1.7; color: var(--mt-ink-soft);
    margin: 0 0 13px; max-width: 46ch;
  }
  .mt-tools { list-style: none; margin: clamp(16px, 2.2vh, 24px) 0 0; padding: 0; display: grid; gap: 9px; }
  .mt-tools li { display: grid; gap: 2px; }
  .mt-tool-name {
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; color: var(--mt-accent);
  }
  .mt-tool-role { font-size: 12.5px; line-height: 1.5; color: var(--mt-ink-soft); max-width: 44ch; }
</style>
