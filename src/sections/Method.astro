---
// src/sections/Method.astro
// SLIDE 2 — WHY IT IS HARD AT SCALE, AND WHAT THE JOB IS.
//
// The owner's brief, and it is the hinge of the whole sequence: "we didnt include constraints right? most
// traders dont care about constraints, but imagine we run the funds at 1B scale and we have strict drawdown,
// and regulatory constraints (you can name a few), then, you can have that realistic number thousands of
// tickers and countless constraints. i need to find out a good strategy to optimize a sequence of decisions.
// the toolkit is blablabla."
//
// That is exactly right, and it is the reason the job is not "trade well". The previous slide showed
// discretionary traders diverging on six names with no rules at all. This slide adds the two things that
// change the problem's KIND rather than its size: a mandate that forbids most of what you might want to do,
// and a book big enough that your own trading moves the price against you.
//
// The constraints are named categories with real reasons (data/desk.ts), not decoration — a reader with a
// finance background should recognise every one, and a reader without one should still follow why each
// exists.
import { CONSTRAINTS, FUND, JOB_STATEMENT, JOB_NOTE, TOOLKIT, INSTRUMENTS } from '../data/desk';
import { multiPeriodVars, humanCount } from '../lib/problemSize';

const smallVars = multiPeriodVars(INSTRUMENTS.length, 52);
const bigVars = multiPeriodVars(FUND.tickers, FUND.periods);

// Group the constraints so the slide reads as categories rather than as a list of twelve rules.
const groups = [...new Set(CONSTRAINTS.map((c) => c.group))].map((g) => ({
  group: g,
  items: CONSTRAINTS.filter((c) => c.group === g),
}));
---
<section id="method" class="mt" aria-labelledby="mt-heading">
  <div class="mt-paper">
    <div class="mt-inner">
      <p class="mt-kicker">Why it is hard</p>
      <h2 id="mt-heading" class="mt-headline">
        Now run {FUND.aum}, and you are not allowed to do most of that.
      </h2>
      <p class="mt-lede">
        The people on the last slide had six names, no mandate and no size. Change either and the problem
        changes kind: the rules forbid most of what you might want, and a book this large moves the price
        it is trying to trade at.
      </p>

      <!-- THE SCALE, as a comparison a non-specialist can hold. -->
      <dl class="mt-scale">
        <div class="mt-scale-item">
          <dt>{INSTRUMENTS.length} × 52</dt>
          <dd><span class="mt-scale-label">Last slide</span>{smallVars} weights, no constraints</dd>
        </div>
        <div class="mt-scale-item is-big">
          <dt>{humanCount(FUND.tickers)} × {FUND.periods}</dt>
          <dd><span class="mt-scale-label">A real mandate</span>{humanCount(bigVars)} weights, {humanCount(FUND.constraints)}+ constraints</dd>
        </div>
        <div class="mt-scale-item">
          <dt>{(FUND.drawdownLimit * 100).toFixed(0)}%</dt>
          <dd><span class="mt-scale-label">Drawdown limit</span>breach it and investors redeem, forcing sales at the worst moment</dd>
        </div>
      </dl>

      <div class="mt-split">
        <!-- THE CONSTRAINTS, grouped, each with the reason it exists. -->
        <div class="mt-rules">
          <p class="mt-sub">The rules you cannot trade around</p>
          {groups.map((g) => (
            <div class="mt-group">
              <p class="mt-group-name">{g.group}</p>
              <ul class="mt-cons">
                {g.items.map((c) => (
                  <li>
                    <span class="mt-con-rule">{c.rule}</span>
                    <span class="mt-con-why">{c.why}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- WHAT THE JOB IS, and the toolkit. -->
        <div class="mt-job">
          <p class="mt-sub mt-sub--job">What my job is</p>
          <p class="mt-job-head">{JOB_STATEMENT}</p>
          <p class="mt-job-note">{JOB_NOTE}</p>
          <ul class="mt-tools">
            {TOOLKIT.map((t) => (
              <li>
                <span class="mt-tool-name">{t.name}</span>
                <span class="mt-tool-role">{t.role}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mt {
    position: relative; z-index: 1;
    width: 100vw; margin-left: calc(50% - 50vw);
    --deck-lead: 0px;
  }
  .mt-paper {
    --mt-bg: #c4b7a1;
    --mt-edge: rgba(74, 66, 54, 0.26);
    --mt-ink: #1f1b14;
    --mt-ink-soft: #423b30;
    --mt-ink-faint: #6a6153;
    --mt-accent: #7c5522;
    background: var(--mt-bg);
    border-top: 1px solid var(--mt-edge);
    border-bottom: 1px solid var(--mt-edge);
    /* This slide carries six named constraints plus the toolkit, so it is the densest of the three. Measured
       at 1700x1050 it overflowed one screen by 46px at 4.6vh, which in a deck means the deck pages through
       it and the composition is never seen whole. */
    padding: clamp(26px, 3.4vh, 52px) 0;
  }
  :global(html[data-theme='dark']) .mt-paper {
    --mt-bg: #14161a;
    --mt-edge: rgba(184, 177, 161, 0.14);
    --mt-ink: #dce1dc;
    --mt-ink-soft: #a8b0a9;
    --mt-ink-faint: #6d746e;
    --mt-accent: #7fc9a0;
  }
  .mt-inner {
    padding-left: clamp(150px, 9.5vw, 190px);
    padding-right: clamp(20px, 2.4vw, 52px);
    box-sizing: border-box;
  }
  @media (max-width: 1099px) { .mt-inner { padding-left: clamp(28px, 6vw, 80px); } }

  .mt-kicker {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--mt-accent); margin: 0 0 12px;
  }
  .mt-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(23px, 2.2vw, 38px); line-height: 1.18;
    color: var(--mt-ink); margin: 0; max-width: 40ch;
    letter-spacing: -0.01em; text-wrap: pretty;
  }
  .mt-lede {
    font-size: clamp(13.5px, 1vw, 15.5px); line-height: 1.66; color: var(--mt-ink-soft);
    margin: 12px 0 0; max-width: 62ch;
  }

  .mt-scale {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(12px, 1.8vh, 22px) clamp(20px, 2.6vw, 48px);
    margin: clamp(18px, 2.6vh, 32px) 0 0;
    padding: clamp(14px, 2vh, 22px) 0;
    border-top: 1px solid var(--mt-edge);
    border-bottom: 1px solid var(--mt-edge);
  }
  .mt-scale-item dt {
    font-family: var(--font-mono); font-size: clamp(16px, 1.4vw, 22px);
    color: var(--mt-ink-soft); line-height: 1; font-variant-numeric: tabular-nums;
  }
  .mt-scale-item.is-big dt { color: var(--mt-accent); }
  .mt-scale-item dd {
    margin: 8px 0 0; font-size: 12px; line-height: 1.48; color: var(--mt-ink-faint); max-width: 34ch;
  }
  .mt-scale-label {
    display: block; font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--mt-ink-soft); margin-bottom: 4px;
  }

  .mt-split {
    display: grid; grid-template-columns: 52fr 48fr;
    gap: 0 clamp(26px, 3.2vw, 64px);
    margin: clamp(18px, 2.6vh, 32px) 0 0;
    align-items: start;
  }
  .mt-job { border-left: 1px solid var(--mt-edge); padding-left: clamp(26px, 3.2vw, 64px); }
  @media (max-width: 1080px) {
    .mt-split { grid-template-columns: 1fr; gap: 4vh 0; }
    .mt-job { border-left: 0; padding-left: 0; padding-top: 4vh; border-top: 1px solid var(--mt-edge); }
  }

  .mt-sub {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--mt-accent); margin: 0 0 14px;
  }
  .mt-sub--job { margin-bottom: 12px; }

  /* Tightened rather than shrunk: the last 21px of overflow came from the gaps between six constraints, and
     losing a point of type size would have cost legibility for no reason. */
  .mt-group + .mt-group { margin-top: clamp(9px, 1.2vh, 14px); }
  .mt-group-name {
    font-family: var(--font-display); font-weight: 500; font-size: 14px;
    color: var(--mt-ink); margin: 0 0 5px;
  }
  .mt-cons { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .mt-cons li {
    display: grid; gap: 2px;
    padding-left: 14px; position: relative;
  }
  .mt-cons li::before {
    content: ""; position: absolute; left: 0; top: 0.55em;
    width: 7px; height: 1px; background: var(--mt-accent); opacity: 0.7;
  }
  .mt-con-rule { font-size: 13px; line-height: 1.45; color: var(--mt-ink-soft); }
  .mt-con-why { font-size: 12px; line-height: 1.45; color: var(--mt-ink-faint); max-width: 52ch; }

  /* MEASURED: this column is what sets the slide's height (611px against the constraint column's 464px), so
     the last of the overflow comes out of here rather than off the constraint list — which is the half a
     finance reader actually scrutinises. */
  .mt-job-head {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(17px, 1.4vw, 22px); line-height: 1.3;
    color: var(--mt-ink); margin: 0 0 10px; max-width: 36ch;
  }
  .mt-job-note {
    font-size: clamp(12.5px, 0.9vw, 14px); line-height: 1.56; color: var(--mt-ink-soft);
    margin: 0 0 clamp(10px, 1.4vh, 16px); max-width: 48ch;
  }
  .mt-tools { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .mt-tools li { display: grid; gap: 1px; }
  .mt-tool-name {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--mt-accent);
  }
  .mt-tool-role { font-size: 12px; line-height: 1.45; color: var(--mt-ink-soft); max-width: 48ch; }
</style>
