---
// src/sections/Work.astro
// SLIDE 3 — "just say plainly, my publications, my writings, my projects."
//
// Plainly is the instruction and the whole design: after two slides that teach and argue, this one simply
// says where the work is. Three columns, one line of what each holds, a real link each. No display-size
// headline competing with the two slides before it, no counts, no "selected X" headings.
//
// WHY THIS IS NOT A RESUME even though it is a list. A résumé lists credentials — title, employer, dates,
// reverse-chronological — and claims authorization. This lists ARTEFACTS and where to read them. The
// distinction is that every row here is a thing a reader can go and check.
import { getCollection } from 'astro:content';
import { STATUS_LABEL, publications, projects, appendixProjects, type Publication } from '../data/profile';
import { PAPER_DATA } from '../data/papers';
import { monthYear } from '../lib/dates';
import { wholeParts } from '../lib/words';
import { KINDS, pieces } from '../data/writing';
import PlushCow from '../components/PlushCow.astro';

const shownProjects = appendixProjects(projects);

// ── THE WRITING COLUMN IS DERIVED, NOT PROMISED: a hand-written "coming" state once told visitors there was
// no writing while a piece was live in the nav. pieces() (data/writing.ts) is EXACTLY what src/pages/writing.astro
// reads, drafts dropped and newest first, so the two pages cannot disagree, and the next piece is still just a
// file. Newest first, not featured-first: `featured` picks /writing's lead and does not reorder the shelf.
const writings = pieces(await getCollection('writing'));

// Two rows, matching the projects column: this slide points, it does not enumerate.
const shownWritings = writings.slice(0, 2);

// Month and year (lib/dates.ts), which is the right grain for a running collection: a day is more precision than
// this line can use, and a bare year would make an August piece look like last winter's.

// A paper whose line quotes its numbers has it in PAPER_DATA (data/papers/index.ts says where they come from);
// any other is its venue and year.
const lineFor = (p: Publication) => {
  const line = PAPER_DATA[p.slug]?.line;
  return line ? `${line} · ${STATUS_LABEL[p.status].toLowerCase()}` : `${p.venue} · ${p.year}`;
};

// A title's names never break at their hyphen (lib/words wholeParts): without this the full RL-BHRP title wraps as
// "(RL-" / "BHRP)" at 1440 and 390, splitting the paper's own name. Fraunces has no U+2011, so a non-breaking hyphen
// would fall back to another face.
---
{/* THE APPENDIX, the last slide: the page ends on it. `Appendix` is the owner's word, the reference matter at the
     end of a paper, which is the register the rest of the site is written in. Nothing follows it: the footer and
     its seal are deleted, and CV and Email are in the corner nav on every page. */}
<section id="appendix" class="wk" aria-labelledby="ap-heading">
  <div class="wk-paper slide-paper">
    <div class="slide-gutter">
      <h2 id="ap-heading" class="wk-title">Appendix</h2>

      <div class="wk-cols">
        {/* PUBLICATIONS: the paper by name, so a reader knows what they are opening. */}
        <div class="wk-col">
          <p class="wk-col-kicker">Publications</p>
          {publications.map((p) => (
            <div class="wk-item">
              <p class="wk-item-name">{wholeParts(p.title).map((s, i) => (i % 2 ? <span class="wk-nobreak">{s}</span> : s))}</p>
              <p class="wk-item-line">{lineFor(p)}</p>
            </div>
          ))}
          <a class="wk-link" href="/research">Read the research<span class="wk-arrow" aria-hidden="true">→</span></a>
        </div>

        {/* WRITINGS: whatever is published, the same treatment as the papers and the projects (name, one line, a
             real link), because every row here is a thing the reader can go and check. With nothing published the
             column is its kicker and its link, and /writing holds that space with the cow. */}
        <div class="wk-col">
          <p class="wk-col-kicker">Writing</p>
          {shownWritings.map((w) => (
            <div class="wk-item">
              <p class="wk-item-name">{w.title}</p>
              <p class="wk-item-line">{KINDS[w.kind].label} · {monthYear(w.date)}</p>
            </div>
          ))}
          <a class="wk-link" href="/writing">Read the writing<span class="wk-arrow" aria-hidden="true">→</span></a>
        </div>

        {/* PROJECTS: last, and briefest — for a quant reader this is supporting evidence. */}
        <div class="wk-col">
          <p class="wk-col-kicker">Projects</p>
          {shownProjects.map((p) => (
            <div class="wk-item">
              <p class="wk-item-name">{p.name}</p>
              <p class="wk-item-line">{p.idea}</p>
            </div>
          ))}
          <a class="wk-link" href="/projects">All projects<span class="wk-arrow" aria-hidden="true">→</span></a>
        </div>
      </div>

      {/* THE COW, the page's closing aside, in what was 480px of blank panel at the slide's foot (measured: 422px
           of content in a 900px slide). */}
      <div class="wk-cow">
        <PlushCow size="mark" />
      </div>

    </div>
  </div>
</section>

<style>
  .wk { position: relative; z-index: 1; }
  .wk-paper { padding: clamp(52px, 7.4vh, 104px) 0; }

  /* BIGGER THROUGHOUT, on the owner's note ("the work is okay. fonts can be bigger"). The slide had the
     most vertical room of the three — it measured 501px of a 1050px screen — so the type was small for no
     reason. It still stays under the two slides before it in hierarchy, because this one points rather
     than argues. */
  .wk-title {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 2.6vw, 42px); line-height: 1.22;
    color: var(--panel-ink); margin: 0; letter-spacing: -0.008em;
  }

  .wk-cols {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(26px, 3vw, 60px);
    margin: clamp(28px, 3.8vh, 52px) 0 0;
  }
  .wk-col + .wk-col { border-left: 1px solid var(--panel-edge); padding-left: clamp(26px, 3vw, 60px); }
  @media (max-width: 980px) {
    .wk-cols { grid-template-columns: 1fr; gap: 4vh 0; }
    .wk-col + .wk-col { border-left: 0; padding-left: 0; padding-top: 4vh; border-top: 1px solid var(--panel-edge); }
  }

  .wk-col-kicker {
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--panel-accent); margin: 0 0 20px;
  }

  .wk-item { margin: 0 0 clamp(18px, 2.2vh, 26px); }
  .wk-item-name {
    /* ACCENT FACE: these are the sub-headlines the owner asked to give some variety to — the paper and project
       names sitting under each mono column label. Fraunces earns its keep at this size. */
    font-family: var(--font-accent); font-weight: 500; font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.28; color: var(--panel-ink); margin: 0;
  }
  .wk-nobreak { white-space: nowrap; }
  .wk-item-line {
    font-size: clamp(13.5px, 1vw, 15px); line-height: 1.58; color: var(--panel-faint);
    margin: 6px 0 0; max-width: 40ch;
  }

  /* RIGHT EDGE, NOT CENTRED — the owner picked this from six real renders. Centring was the version he called
     "off … there by mistake", and the reason is structural: a three-column grid has no centre line, so a centred
     mark lands in the gutter between the first two columns and aligns to nothing. Every other element on this
     panel sits on the grid. Flush right puts it on the same edge the grid itself ends on, and at `mark` size it
     reads as a margin note rather than a fourth column.
     Right-aligned also makes the bubble's growth free: it expands leftward into empty panel while the cow stays
     anchored, so pressing it never moves anything else. */
  .wk-cow {
    display: flex; justify-content: flex-end;
    margin: clamp(34px, 6vh, 84px) 0 0;
  }

  .wk-link {
    display: inline-flex; align-items: baseline; gap: 8px;
    margin: clamp(8px, 1.2vh, 14px) 0 0;
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.12em;
    text-transform: uppercase; text-decoration: none;
    color: var(--panel-accent);
    border-bottom: 1px solid currentColor; padding-bottom: 3px;
  }
  .wk-arrow { transition: transform .28s cubic-bezier(.2,.7,.3,1); }
  @media (hover: hover) { .wk-link:hover .wk-arrow { transform: translateX(4px); } }
  .wk-link:focus-visible { outline: 2px solid var(--panel-accent); outline-offset: 4px; }
</style>
