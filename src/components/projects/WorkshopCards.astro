---
// /projects' "02 · The workshop": the personal tools as cards (the 21st.dev spotlight-card reference, rebuilt by
// hand) — a glow that follows the pointer, the picture, the idea, chips and the install line — then the dashed
// in-progress card, which lists `inProgress` and carries the rail's #p-in-progress.
//
// Each card is the project's repo link, or a button for a private one (macboot) and for the in-progress card,
// carrying data-ask like every project surface on the page. Since a button may only hold phrasing content, the
// card is built from spans, so one markup serves both.
//
// THE INSTALL LINE IS SHOWN WHOLE, never abbreviated and never clipped: manifold's is its README's 92-character
// curl with a 74-character URL that has no break opportunity, ~510px of 11.5px mono in a card whose text is
// ~240px wide. The card is overflow: hidden, so an unwrapped line would be cut off silently rather than overflow
// the page — so `.cmd` wraps anywhere. A `prompt` line (macboot's words for Claude Code) drops the "$ ", and is
// the one line shown in part: an excerpt of a longer prompt, which its own "…" says (profile.ts).
import { inProgress, projects, repoUrl } from '../../data/profile';
import { projectSectionId } from '../../lib/pageStops';
import ProjectPicture from './ProjectPicture.astro';

const cards = projects.filter((p) => p.tier === 'workshop').map((p) => {
  const url = repoUrl(p);
  return { p, url, Tag: (url ? 'a' : 'button') as 'a' | 'button' };
});
---
<ul class="cards" data-cards>
  {cards.map(({ p, url, Tag }) => (
    <li id={projectSectionId(p.slug)}>
      <Tag class="card" href={url ?? undefined} type={url ? undefined : 'button'} data-ask={p.slug}>
        <span class="card-in">
          <span class="thumb">
            <ProjectPicture slug={p.slug} sizes="(max-width: 760px) 92vw, (max-width: 1400px) 460px, 320px" />
          </span>
          <span class="cb">
            <span class="nm">{p.name}</span>
            <span class="idea">{p.idea}</span>
            <span class="chips">{p.proof.map((t) => <span class="t">{t}</span>)}</span>
            {p.install && <span class="cmd">{p.install.prompt ? '' : '$ '}{p.install.text}</span>}
          </span>
        </span>
      </Tag>
    </li>
  ))}
  <li id="p-in-progress">
    <button type="button" class="card ghost" data-ask="in-progress">
      <span class="card-in">
        <span class="nm">in progress</span>
        {inProgress.map((w) => (
          <span class="wip"><span class="wn">{w.name}</span><span class="idea">{w.idea}</span></span>
        ))}
      </span>
    </button>
  </li>
</ul>

<style>
  .cards {
    list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
  }
  /* The boot: each card waits below its place, and rises in after the rows when TerminalHeader deals. */
  :global(html.projects-boot) .cards li { opacity: 0; transform: translateY(18px); transition: none; }
  @media (prefers-reduced-motion: no-preference) {
    .cards li { transition: opacity 0.4s, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  }
  /* The 1px padding is the border: the spotlight under it shows through as a ring. A card has its own opaque
     ground (.card-in), so it drops the page's label knockout — all but the dashed one, below, which has none. */
  .card {
    position: relative; display: block; width: 100%; height: 100%; padding: 1px; overflow: hidden;
    border-radius: 12px; background: rgba(var(--draft-line-rgb), 0.13); color: var(--ink-1);
    font: inherit; text-align: left; text-decoration: none; text-shadow: none; cursor: pointer;
  }
  .card::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; opacity: 0; pointer-events: none;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(var(--draft-hi-rgb), 0.7), transparent 42%);
  }
  .card-in { position: relative; display: block; height: 100%; overflow: hidden; border-radius: 11px; background: var(--draft-ground); }
  .card-in::before {
    content: ""; position: absolute; inset: 0; opacity: 0; pointer-events: none;
    background: radial-gradient(520px circle at var(--mx, 50%) var(--my, 50%), rgba(var(--draft-hi-rgb), 0.09), transparent 45%);
  }
  @media (prefers-reduced-motion: no-preference) { .card::before, .card-in::before { transition: opacity 0.35s; } }
  /* Pointer only, so a tap never leaves a card lit. The dashed card has no ring: its inside is transparent, so the
     ring's gradient would show through it as a blot rather than at its edge.
     CONTRAST ON HOVER: at the pointer the spotlight is the seal at .09 over the card's ground, which takes ink-3 to
     4.39:1 in light theme — and over the dashed card's open field it compounds with the edge vignette. So a lit
     card lifts its ink-3 words to ink-2 (7.82 at worst, the dashed card at the vignette's corner), as a hovered row
     does; the install line is kept out of the light by its own opaque ground, below. tests/draftingPalette.test.ts
     holds the numbers. */
  @media (hover: hover) {
    .card:not(.ghost):hover::before, .card:hover .card-in::before { opacity: 1; }
    .card:hover .idea, .card:hover .t { color: var(--ink-2); }
  }
  .card:focus-visible { outline: 2px solid var(--ochre); outline-offset: 3px; }

  .thumb { position: relative; display: block; height: 170px; overflow: hidden; background: var(--draft-ph);
    border-bottom: 1px solid rgba(var(--draft-line-rgb), 0.12); }
  .cb { position: relative; display: block; padding: 18px 20px 20px; }
  .nm { display: block; font: 600 17px var(--font-mono); }
  .idea { display: block; margin: 8px 0 14px; font-size: 14px; line-height: 1.5; color: var(--ink-3); }
  /* Not nowrap: a chip wider than the card ("gradients checked against finite differences in CI") wraps inside
     itself, where nowrap had the card's overflow cut it off. A chip that fits never wraps — flex-wrap moves it to
     a new line first. */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .t { padding: 3px 7px; border-radius: 3px; border: 1px solid rgba(var(--draft-line-rgb), 0.22); font: 10.5px var(--font-mono);
    letter-spacing: 0.04em; color: var(--ink-3); }
  /* The mockup's .06 tint, laid over an OPAQUE ground so the spotlight never shows through it: through it, the seal
     on the tinted light fell to 4.12:1 in light theme and 4.25 in dark. At rest it is the same colour as before.
     LIT, IT IS NOT THE MOCKUP, and that is the price of the spec's 4.5:1 rule: with the pointer on the line the card
     around it warms by deltaE76 5.5 (light) / 6.3 (dark) and the line by 0, so it reads as a neutral well inside a
     warm glow, fading as the pointer leaves it (the light ends 234px out). No share of the light buys the mockup
     back: past 30% the seal falls under AA in light theme, and 30% warms the line by under deltaE 2, too little to see. */
  .cmd { display: block; margin-top: 14px; padding: 7px 9px; border-radius: 4px;
    background: linear-gradient(rgba(var(--draft-line-rgb), 0.06), rgba(var(--draft-line-rgb), 0.06)), var(--draft-ground);
    font: 11.5px var(--font-mono); color: var(--ochre); overflow-wrap: anywhere; }

  /* THE DASHED CARD IS TRANSPARENT, so its words sit straight on the drafting field and need the page's knockout
     back: without it a stroke under a glyph takes light ink-3 to 4.10:1 (minor line), 3.03 (major) and 1.34 (a lit
     ping) — projects.astro's numbers. `inherit`, not merely no `none`: it is a <button>, and the UA stylesheet gives
     buttons `text-shadow: none` of their own. */
  .card.ghost { background: transparent; border: 1px dashed rgba(var(--draft-line-rgb), 0.3); text-shadow: inherit; }
  .ghost .card-in { display: flex; flex-direction: column; justify-content: center; min-height: 300px; padding: 26px; background: transparent; }
  .ghost .nm { font-size: 15px; }
  .wip { display: block; margin-top: 14px; }
  .wn { display: block; font: 13px var(--font-mono); }
  .ghost .idea { margin: 4px 0 0; line-height: 1.55; }
</style>

<script>
  // Started at astro:page-load, not at parse: hover-only, so the first pointer move after `load` finds it. Its one
  // listener is on the list, which leaves with the DOM, so there is nothing to tear down.
  function init(): void {
    const list = document.querySelector<HTMLElement>('[data-cards]');
    // Pointer only: a touch screen's tap fires hover too, and would leave a card's glow on.
    if (!list || !matchMedia('(hover: hover)').matches) return;
    // The glow's centre follows the pointer; the inner layer inherits the custom properties from its card.
    const onMove = (e: PointerEvent): void => {
      if (e.pointerType === 'touch') return;
      const c = (e.target as Element).closest<HTMLElement>('.card');
      if (!c) return;
      const r = c.getBoundingClientRect();
      c.style.setProperty('--mx', `${e.clientX - r.left}px`);
      c.style.setProperty('--my', `${e.clientY - r.top}px`);
    };
    list.addEventListener('pointermove', onMove);
  }

  document.addEventListener('astro:page-load', init);
</script>
