---
// The marginal table-of-contents rail, one component for every page that has one, driven by a Stop tree from
// lib/pageStops. The template recurses, so the rail is as deep as the tree.
//
// Each label is three layers of the same text — the dim one (--rail-ink, else --ink-3), which is the link's name,
// and two copies over it, .ink2 for the quieter mark and .ink1 for the lead — so a state change is a cross-fade of
// opacities, never a colour transition, and every state is a solid ink at rest (the inactive one clears 4.5:1 on
// every rail page's ground). The copies are empty aria-hidden elements whose text is generated (::before, from
// data-l): aria-hidden keeps them out of the link's name in every engine (generated text alone is named by some and
// not by others), and generated text is in no selection, no find-in-page and no unstyled page, so each of those
// holds a label once. The dash hangs in a 20px gutter left of the label, so no label ever moves.
//
// Not an island (the site has none): a vanilla <script>, started through onPageView, with a teardown. The entrance
// is CSS, not the script's: a bundled script runs after the browser has painted, so a from-state it set could land
// on a rail already painted at rest. Each row carries its index (--i) and the rail the gap between rows (--gap).
//
// A page reskins it only through role tokens (CLAUDE.md, The concept): --knockout and --rail-dash-halo, declared
// by the registers whose ground needs them (today /projects' drafting sheet), `none` everywhere else; and
// --rail-ink and --rail-focus, the resting label's ink and the focus ring's (else --ink-3 and --ochre), declared by
// the homepage (tokens.css, `deck`), whose tan panels neither light --ink-3 nor light ochre clears.
//
// The site's one other rail is /art's, coupled to its gallery's formation and left alone.
import { type Stop, flattenStops } from '../lib/pageStops';
import { RAIL, stagger } from '../lib/motionTiming';

interface Props {
  stops: Stop[];
  /** The id of an element the rail stays off (the homepage's hero): hidden until that element's bottom has risen
   *  above the middle of the screen, by `display: none`, so its links leave the tab order with it. With no script
   *  it stays hidden: over a hero it would print across the name on a short window. */
  hideOver?: string;
  /** Set only by the template's own recursion: the depth of the list being rendered. */
  depth?: number;
  /** Set only by the template's own recursion: the whole rail in document order, which numbers its rows. */
  flat?: Stop[];
}
const { stops, hideOver, depth, flat = flattenStops(stops) } = Astro.props;
// The entrance (lib/motionTiming RAIL): each row RAIL.row long, RAIL.rowStep after the one before, closer on a long
// rail so the last is in by RAIL.enter. The CSS reads both from the nav's style, --row and --gap, so it plays the
// duration this arithmetic used. With no `max`, stagger(i) is i x stagger(1), so the CSS multiplies.
const gap = stagger(1, flat.length, { step: RAIL.rowStep, total: RAIL.enter - RAIL.row });
---
{depth === undefined ? (
  stops.length > 0 && (
    <nav class="side-rail" aria-label="On this page" data-hide-over={hideOver} style={`--gap:${gap}ms;--row:${RAIL.row}ms`}><Astro.self stops={stops} depth={0} flat={flat} /></nav>
  )
) : (
  <ul class={depth > 0 ? 'sub' : undefined}>
    {stops.map((s) => (
      <li>
        <a href={`#${s.target}`} style={`--i:${flat.indexOf(s)}`}><span class="rule" aria-hidden="true"></span><span class="lbl"><span class="dim">{s.label}</span><span class="ink2" aria-hidden="true" data-l={s.label}></span><span class="ink1" aria-hidden="true" data-l={s.label}></span></span></a>
        {s.children && s.children.length > 0 && <Astro.self stops={s.children} depth={depth + 1} flat={flat} />}
      </li>
    ))}
  </ul>
)}

<style>
  /* Vertically centred in the left margin. The 30px of padding is the dash's gutter (20px dash, 10px air), so every
     label sits where it would with its dash drawn; the pages' clearances were measured against that edge. */
  .side-rail {
    position: fixed;
    left: clamp(18px, 2.4vw, 38px);
    top: 50%;
    transform: translateY(-50%);
    z-index: 30;
    /* 200px, and the last 10px are load-bearing: the longest label in the data, "University of Toronto" (the PhD
       institution), needs 151px, and a nested label gets 200 - 30 - 12 = 158. At 190 it rendered as
       "UNIVERSITY OF TORON…". Widening beats tightening the tracking, which would change the rail's type
       everywhere to fix one string. */
    max-width: 200px;
    padding-left: 30px;
    /* The dash's strength: ink-1 at 55% clears 3:1 as a mark on every rail page's ground (worst computed, 3.21:1
       on the homepage's light sky at its deepest under the rail; 3.74:1 measured over the light reading sky). tests/deckPalette.test.ts,
       tests/paperPalette.test.ts and tests/draftingPalette.test.ts hold the panels and the sheets.
       It is the alpha of the dash's colour, not its opacity, so a register can ring the dash with an opaque knockout. */
    --mk: 55%;
  }
  .side-rail ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  /* Nested lists breathe less than top-level ones, so a group reads as a group — but not below 12px, at any depth.
     A nested row is 12.5px tall (10px type at 1.25), and axe's target-size, which Lighthouse scores in A11y, wants
     an undersized target's centre 24px from every neighbour's: 12px gives rows 24.5px apart and the first 25.1px
     from its parent. At 9px every nested rail failed it on the desktop runs, scoring 95-96. */
  .side-rail .sub { gap: 12px; margin-top: 12px; padding-left: 12px; }

  .side-rail a {
    position: relative; display: flex; text-decoration: none;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase; line-height: 1.25;
  }
  /* Child stops are smaller and less tracked-out than their parent: hierarchy by type, not by indent depth, which
     a narrow margin cannot afford. */
  .side-rail .sub a { font-size: 10px; letter-spacing: 0.12em; }

  /* ONE LINE PER ROW: a label that cannot fit ends in an ellipsis rather than wrapping, which would break the even
     rhythm and push its neighbours off-centre. All three layers clip the same way, so they stay one word.
     --knockout is a register's ring for a ground with strokes under the text (on /projects, 1px of the bare sheet
     around every glyph, so no field line touches one; the page's own text wears the same token); the copies inherit
     it. */
  .side-rail .lbl { position: relative; min-width: 0; text-shadow: var(--knockout, none); }
  .side-rail .dim,
  .side-rail .ink2,
  .side-rail .ink1 { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .side-rail .dim { color: var(--rail-ink, var(--ink-3)); }
  .side-rail .ink2,
  .side-rail .ink1 { position: absolute; inset: 0; opacity: 0; }
  .side-rail .ink2::before,
  .side-rail .ink1::before { content: attr(data-l); }
  .side-rail .ink2 { color: var(--ink-2); }
  .side-rail .ink1 { color: var(--ink-1); }

  /* The dash, and its faint preview at a hovered or focused row (a::after): the same 20px hairline in the gutter,
     shown by opacity and scaled from its left end. A text-shadow does not reach the dash (a painted span), so it
     wears its register's knockout as a box-shadow, --rail-dash-halo. */
  .side-rail .rule,
  .side-rail a::after {
    position: absolute; left: -30px; top: 50%; width: 20px; height: 1px; margin-top: -0.5px;
    background: var(--ink-1); opacity: 0; transform-origin: 0 50%; pointer-events: none;
  }
  .side-rail .rule { background: color-mix(in srgb, var(--ink-1) var(--mk), transparent); box-shadow: var(--rail-dash-halo, none); }
  .side-rail a::after { content: ''; }

  /* THE MARKS, set by the script (lib/scrollspy's railMarks). The lead, the one current stop the moving dash is at,
     is full ink with the whole dash. Any other current stop (.is-quiet: a second section in the reading band) and
     an ancestor of a current stop wear the quieter mark — --ink-2 and a 12px dash — so the rail shows one "here" at
     a time. The quiet dash keeps the full strength: at the prototype's 0.69 of it, it computes to 2.30-2.40:1 in
     light, under 3:1. */
  .side-rail a:is(.is-active, .is-ancestor) .dim { opacity: 0; }
  .side-rail a.is-active .ink1 { opacity: 1; }
  .side-rail a:is(.is-ancestor, .is-quiet) .ink2 { opacity: 1; }
  .side-rail a.is-active.is-quiet .ink1 { opacity: 0; }
  .side-rail a:is(.is-active, .is-ancestor) .rule { opacity: 1; }
  .side-rail a:is(.is-ancestor, .is-quiet) .rule { transform: scaleX(0.6); }

  /* FORCED COLOURS (Windows High Contrast) set every ink in one system colour and paint backgrounds as Canvas, so
     the inks the marks cross-fade between look alike and the dash is gone. The current stop keeps a mark there: the
     dash in Highlight (and the hover preview with it, at its own opacity), the current label underlined. */
  @media (forced-colors: active) {
    .side-rail .rule, .side-rail a::after { forced-color-adjust: none; background: Highlight; box-shadow: none; }
    .side-rail a.is-active .ink2, .side-rail a.is-active .ink1 { text-decoration: underline; }
  }

  /* HOVER IS .is-hover, NOT :hover: the script sets it for a mouse or a pen and ignores a touch, so a tap on a
     touch laptop (whose primary pointer can hover) never leaves a row nudged and previewed. */
  @media (hover: hover) {
    .side-rail a.is-hover:not(.is-active)::after { opacity: 0.2; }
  }
  .side-rail a:not(.is-active):focus-visible::after { opacity: 0.2; }
  .side-rail a:focus-visible { outline: 1px solid var(--rail-focus, var(--ochre)); outline-offset: 3px; border-radius: 2px; }

  /* The label's cross-fade and the 2px nudge toward a hovered or focused row. The dash's slide and the quiet marks'
     fades are the script's. The times are lib/motionTiming's RAIL, the curves its FADE and EASE
     (tests/motionTiming.test.ts). */
  @media (prefers-reduced-motion: no-preference) {
    .side-rail .dim,
    .side-rail .ink2,
    .side-rail .ink1 { transition: opacity 200ms ease-out; }
    .side-rail a::after { transition: opacity 160ms ease-out; }
    .side-rail .lbl { transition: transform 160ms cubic-bezier(.2,.7,.2,1); }
    .side-rail a:focus-visible .lbl { transform: translateX(2px); }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .side-rail a.is-hover .lbl { transform: translateX(2px); }
  }
  /* THE ENTRANCE, once each time the rail renders (a ClientRouter arrival renders a new rail; on `/`, see below): every row in
     from 6px left, --row long and --i x --gap late (both set by the frontmatter, so the last row is in by RAIL.enter).
     CSS, so it runs from the first frame with nothing to wait for, and the backwards fill holds each row in its
     from-state through its delay. A CSS animation restarts when its element is rendered again, so a rail hidden at
     1100px and below runs it when it first shows, and a row the script hid (its target stopped rendering) replays its
     own when it shows again; today no rail page hides a target wider than 1100px. On a page with a veil (/writing,
     /experience) most of it plays under the veil's wipe. On `/` the rail is off the hero (hideOver), so it plays as the
     reader leaves the hero, and again each time they come back down past it. */
  @media (prefers-reduced-motion: no-preference) {
    .side-rail a {
      animation: side-rail-enter var(--row) cubic-bezier(.2,.7,.2,1) backwards;
      animation-delay: calc(var(--i) * var(--gap));
    }
  }
  @keyframes side-rail-enter { from { opacity: 0; transform: translateX(-6px); } }

  /* Off the element its page names (hideOver) until the script marks it passed. */
  .side-rail[data-hide-over]:not([data-past]) { display: none; }

  /* The rail is a wide-viewport affordance; below this the page re-centers. */
  @media (max-width: 1100px) { .side-rail { display: none; } }
</style>

<script>
  // The rail's script: which stops are marked (lib/scrollspy's railMarks, measured on every scroll frame) and the
  // motion between marks, ported from the v4 prototype. Only transform and opacity move, once per change of mark:
  // - ONE dash moves, the lead's. When the lead changes, its dash slides from wherever the old one is (at rest or
  //   mid-flight) and grows to its length; with nowhere to slide from, it grows in place. Any other current stop
  //   takes the quiet mark, fading in and out where it stands. So a section boundary in the reading band is one
  //   quiet mark appearing and then one slide, and a rail click is one dash travelling. The times are RAIL's.
  // The first marks appear at once, inside the rows' CSS entrance. Reduced motion: the same marks, at once.
  import { prefersReducedMotion } from '../lib/motion';
  import { EASE, RAIL } from '../lib/motionTiming';
  import { fragmentId } from '../lib/pageStops';
  import { type Marks, railMarks } from '../lib/scrollspy';
  import { play } from '../scripts/motion';
  import { onPageView } from '../scripts/pageView';

  onPageView('.side-rail', (rail) => {
    const stops = [...rail.querySelectorAll<HTMLAnchorElement>('a')].flatMap((a) => {
      const el = document.getElementById(fragmentId(a.hash));
      const rule = a.querySelector<HTMLElement>('.rule');
      const li = a.closest('li');
      return el && rule && li ? [{ a, el, rule, li }] : [];
    });
    if (!stops.length) return undefined;
    const over = rail.dataset.hideOver ? document.getElementById(rail.dataset.hideOver) : null;
    // Each stop's parent: the nearest enclosing row that is itself a stop.
    const indexOf = new Map(stops.map((s, i) => [s.li, i]));
    const parent = stops.map((s) => {
      for (let li = s.li.parentElement?.closest('li'); li; li = li.parentElement?.closest('li')) {
        const i = indexOf.get(li);
        if (i !== undefined) return i;
      }
      return null;
    });

    const ac = new AbortController();
    const live = new Set<Animation>();
    const fly = new Map<number, Animation>(); // at most one animation per dash
    let on = new Set<number>();
    let ancestors = new Set<number>();
    let lead: number | null = null;
    let was = false; // the rail was showing on the last frame: only then do marks move rather than appear
    let raf = 0;

    function measure(): Marks {
      const boxes = stops.map((s, i) => {
        const r = s.el.getBoundingClientRect();
        return { top: r.top, bottom: r.bottom, visible: s.el.getClientRects().length > 0, parent: parent[i] };
      });
      // A stop whose target is not rendered leaves the rail: the rail offers what the page is showing.
      stops.forEach((s, i) => s.li.toggleAttribute('hidden', !boxes[i].visible));
      return railMarks(boxes, window.innerHeight, window.scrollY, document.documentElement.scrollHeight);
    }

    function halt(i: number): void {
      fly.get(i)?.cancel();
      fly.delete(i);
    }
    function flyDash(i: number, frames: Keyframe[], opts: KeyframeAnimationOptions): void {
      halt(i);
      const f = play(stops[i].rule, frames, opts, live);
      fly.set(i, f);
      const end = (): void => { if (fly.get(i) === f) fly.delete(i); };
      f.finished.then(end, end);
    }
    const fadeIn = (i: number): void => flyDash(i, [{ opacity: 0, offset: 0 }], { duration: RAIL.fade });
    const centre = (el: Element): { x: number; y: number } => {
      const r = el.getBoundingClientRect();
      return { x: r.left, y: r.top + r.height / 2 };
    };

    function apply(m: Marks, animate: boolean): void {
      const prev = on, wasAnc = ancestors, from = lead, next = new Set(m.current), anc = new Set(m.ancestors);
      on = next;
      ancestors = anc;
      lead = m.lead;
      // Read before any class or animation changes: where the old lead's dash is now (nowhere if its row is
      // hidden), and how each quiet mark looks, so one that stops being current fades from where it is.
      const src = animate && from !== null && stops[from].a.getClientRects().length > 0 ? centre(stops[from].rule) : null;
      const quiet = animate
        ? [...prev].filter((i) => i !== from).map((i) => {
          const cs = getComputedStyle(stops[i].rule);
          return { i, opacity: cs.opacity, transform: cs.transform };
        })
        : [];
      stops.forEach(({ a }, i) => {
        a.classList.toggle('is-active', next.has(i));
        a.classList.toggle('is-quiet', next.has(i) && i !== lead);
        a.classList.toggle('is-ancestor', anc.has(i));
        // 'true' is valid on more than one link when more than one section is genuinely in view.
        if (next.has(i)) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      if (!animate) {
        fly.forEach((f) => f.cancel());
        fly.clear();
        return;
      }
      if (lead !== from) {
        if (from !== null) halt(from);
        if (lead !== null && src) {
          // Its resting place: the row's height-centre, at the dash's own offset (offsetLeft ignores transforms).
          const { a, rule } = stops[lead];
          const r = a.getBoundingClientRect();
          const dx = src.x - (r.left + rule.offsetLeft), dy = src.y - (r.top + r.height / 2);
          flyDash(lead, [
            { transform: `translate(${dx}px, ${dy}px) scaleX(1)`, opacity: 1, easing: EASE },
            { transform: 'translate(0px, 0px) scaleX(0.45)', opacity: 1, offset: RAIL.slide / (RAIL.slide + RAIL.grow), easing: EASE },
            { transform: 'translate(0px, 0px) scaleX(1)', opacity: 1 },
          ], { duration: RAIL.slide + RAIL.grow, easing: 'linear' });
        } else if (lead !== null) {
          flyDash(lead, [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], { duration: RAIL.growIn });
        }
        // The stop it left, if still current, takes the quiet mark where it stands; the dash leaving covers it.
        if (from !== null && next.has(from)) fadeIn(from);
      }
      // A stop newly current fades its quiet mark in, unless it was an ancestor: an ancestor's mark is the quiet mark.
      for (const i of next) if (i !== lead && i !== from && !prev.has(i) && !wasAnc.has(i)) fadeIn(i);
      for (const q of quiet) {
        if (next.has(q.i)) continue;
        halt(q.i);
        // No longer current, and no ancestor's mark in its place: it fades where it is.
        if (getComputedStyle(stops[q.i].rule).opacity !== '0' || q.opacity === '0') continue;
        flyDash(q.i, [{ opacity: q.opacity, transform: q.transform }, { opacity: 0, transform: q.transform }], { duration: RAIL.fade });
      }
    }

    function frame(): void {
      raf = 0;
      // Passed once its bottom is above mid-screen, as the hero is when the deck rests on the slide after it.
      if (over) rail.toggleAttribute('data-past', over.getBoundingClientRect().bottom < window.innerHeight / 2);
      const shown = rail.getClientRects().length > 0; // display: none at 1100px and below, and off hideOver
      if (shown) apply(measure(), was && !prefersReducedMotion());
      was = shown;
    }
    const spy = (): void => { if (!raf) raf = requestAnimationFrame(frame); };

    frame();
    window.addEventListener('scroll', spy, { passive: true, signal: ac.signal });
    window.addEventListener('resize', spy, { passive: true, signal: ac.signal });
    // Hover is a mouse's or a pen's; a tap reports 'touch' and is ignored (the CSS reads .is-hover, not :hover).
    for (const a of rail.querySelectorAll('a')) {
      a.addEventListener('pointerenter', (e) => a.classList.toggle('is-hover', e.pointerType !== 'touch'), { signal: ac.signal });
      a.addEventListener('pointerleave', () => a.classList.remove('is-hover'), { signal: ac.signal });
    }
    // Started at parse, so the first marks were measured before the webfonts: measure again once they land.
    void document.fonts.ready.then(() => { if (!ac.signal.aborted) spy(); });

    return () => {
      ac.abort();
      cancelAnimationFrame(raf);
      live.forEach((a) => a.finish());
    };
  });
</script>
