---
// src/components/FactorFan.astro
// The factor exposure fan, interactive and in real 3D — drag to rotate.
//
// ONE ASSET, MANY SIGNALS. The site is a single ticker; the portfolio items are signals that
// load onto it. So the object is a factor model, r = α + Σ β_k f_k + ε, with each term
// expanded into one beam whose size IS that term's loading. The maths is not decoration on top
// of the picture — the picture is the maths laid out in space.
//
// WHY three.js, and why it costs nothing measurable:
// the module is dynamically imported from inside an IntersectionObserver, so the chunk is
// fetched only when the section actually scrolls into view. Lighthouse does not scroll, so it
// never loads during an audit and the Perf ≥99 bar is untouched. Under
// prefers-reduced-motion the import never fires at all and the baked SVG still frame — which
// is also the no-JS state and the LCP paint — stays on screen.
//
// RENDERED AS AN INSTRUMENT, not as pixel art. A first pass rendered into a low-resolution
// buffer with image-rendering: pixelated; it read as a retro-game artefact against a
// Swiss-minimal page and was dropped. Full resolution, flat metal-free shading, hairline
// structure: the object should look measured, because it is showing a measurement.
import { fanFrame } from '../lib/fanFrame';
import { loadings, fanBeams, FACTORS } from '../lib/factorModel';
import { SIGNAL_WEIGHTS } from '../data/signalWeights';
import { FACTOR_EQUATIONS } from '../lib/equations';

const ls = loadings(SIGNAL_WEIGHTS.signals);
const beams = fanBeams();
const stillSvg = fanFrame(SIGNAL_WEIGHTS.signals);

// Serialised for the client so the runtime does no model work: geometry and loadings are
// computed once at BUILD time and handed over as data.
const payload = {
  beams: beams.map((b) => ({
    key: b.factor.key,
    label: b.factor.label,
    href: b.factor.href,
    announce: b.factor.announce ?? null,
    gloss: b.factor.gloss,
    beta: ls.find((l) => l.factor.key === b.factor.key)!.beta,
    azimuth: b.azimuth,
    elevation: b.elevation,
    length: b.length,
    halfWidth: b.halfWidth,
    tip: b.tip,
  })),
};

// Signals per factor, for the hover panel — what actually loads on each beam.
const signalsByFactor = Object.fromEntries(
  FACTORS.map((f) => [
    f.key,
    SIGNAL_WEIGHTS.signals.filter((s) => s.factor === f.key).map((s) => ({ label: s.label, score: s.score })),
  ]),
);
---
<section id="factor-fan" class="fan" aria-labelledby="fan-heading">
  <h2 id="fan-heading" class="sr-only">Factor exposures — where to find my work</h2>

  <!-- The model, typeset once and large. Only the general form: the fitted expansion and the
       beta definition were a second and third line that competed with the object for
       attention, and the fan already shows every loading. -->
  <div class="fan-eq" set:html={FACTOR_EQUATIONS.general} />
  <p class="fan-eq-note">one asset · six signals · drag the fan to rotate</p>

  <div class="fan-stage" data-fan-stage>
    <!-- The baked still. It is the LCP paint, the no-JS state and the reduced-motion state,
         and it is replaced in place once (and only if) the 3D layer loads. -->
    <div class="fan-still" data-fan-still set:html={stillSvg} />
    <canvas class="fan-canvas" data-fan-canvas aria-hidden="true"></canvas>

    <!-- The real interface. Six focusable controls over the beams, positioned by percentage
         from the same geometry the renderer uses. Keyboard, screen readers and JS-off all
         work with no separate accessible path. -->
    <ul class="fan-hits" data-fan-hits>
      {payload.beams.map((b) => (
        <li class="fan-hit-wrap" data-key={b.key}>
          {b.href ? (
            <a class="fan-hit" href={b.href} data-key={b.key}>
              <span class="fan-hit-label">{b.label}</span>
              <span class="fan-hit-beta">β {b.beta.toFixed(3)}</span>
            </a>
          ) : (
            <button class="fan-hit" type="button" data-key={b.key} aria-live="polite">
              <span class="fan-hit-label">{b.label}</span>
              <span class="fan-hit-beta">{b.announce}</span>
            </button>
          )}
        </li>
      ))}
    </ul>
  </div>

  <!-- Hover/focus detail: which signals load on the active factor, and at what score. -->
  <div class="fan-detail" data-fan-detail hidden>
    <p class="fan-detail-head"><span data-detail-label></span> <span data-detail-beta></span></p>
    <p class="fan-detail-gloss" data-detail-gloss></p>
    <ul class="fan-detail-list" data-detail-list></ul>
  </div>

  <script type="application/json" data-fan-payload set:html={JSON.stringify(payload)} />
  <script type="application/json" data-fan-signals set:html={JSON.stringify(signalsByFactor)} />
</section>

<style>
  .fan { position: relative; padding: 10vh 0 6vh; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* The equation, BIG. It is the thesis of the whole section, so it gets display scale rather
     than caption scale. MathML inherits the page font, so the display face is set explicitly. */
  .fan-eq { text-align: center; }
  /* --ink-1, NOT --paper. On the homepage's near-black ground --paper is the readable choice,
     but this component is also mounted on a light reading page where --paper IS the background
     — the equation rendered cream-on-cream and was almost invisible. --ink-1 inverts per theme
     and is correct on both. */
  .fan-eq :global(math) {
    font-family: var(--font-display), Georgia, serif;
    font-size: clamp(30px, 4.4vw, 62px);
    color: var(--ink-1);
  }
  .fan-eq-note {
    margin: 14px 0 0; text-align: center;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink-4);
  }

  .fan-stage {
    position: relative; margin: 4vh auto 0;
    width: min(1320px, 94vw); aspect-ratio: 1600 / 880;
    touch-action: none;   /* drag to rotate must not scroll the page */
  }
  .fan-still, .fan-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fan-still :global(svg) { display: block; width: 100%; height: auto; }
  .fan-canvas {
    display: block; opacity: 0; transition: opacity .5s ease;
    /* No image-rendering: pixelated. The pixel-art treatment was dropped — it read as a
       retro-game artefact against a Swiss-minimal page, and this object's job is to look like
       a precise instrument, which wants clean antialiased edges. */
    cursor: grab;
  }
  .fan-canvas.is-live { opacity: 1; }
  .fan-canvas.is-dragging { cursor: grabbing; }
  /* Once the 3D layer is live the still is hidden — but it stays in the DOM, so a teardown or
     a failed init can bring it straight back. */
  .fan-still.is-hidden { opacity: 0; pointer-events: none; }

  /* THE OVERLAY MUST NOT EAT THE DRAG. This <ul> covers the whole stage, so with the default
     pointer-events it swallowed every pointerdown and the canvas never saw one — drag-to-rotate
     was completely dead. Verified with elementFromPoint at five points across the stage: all
     five returned .fan-hits, never the canvas. The container is now transparent to the pointer
     and only the labels themselves are targets. */
  .fan-hits {
    position: absolute; inset: 0; list-style: none; margin: 0; padding: 0;
    pointer-events: none;
  }
  .fan-hit-wrap { position: absolute; transform: translate(-50%, -50%); pointer-events: none; }
  .fan-hit { pointer-events: auto; }
  .fan-hit {
    display: flex; flex-direction: column; gap: 2px; align-items: flex-start;
    padding: 5px 9px; border: 0; cursor: pointer;
    text-decoration: none; font-family: var(--font-mono); color: var(--ink-1);
    /* A backing plate: labels ride ON the 3D beams, and mono text over a lit ochre wedge is
       unreadable without one. Tinted from the page ground so it works in both themes. */
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(3px);
    border-radius: 3px;
  }
  .fan-hit-label {
    font-size: clamp(11px, 0.95vw, 15px); letter-spacing: 0.16em; text-transform: uppercase;
    white-space: nowrap;
  }
  .fan-hit-beta { font-size: clamp(10px, 0.8vw, 13px); color: var(--ochre); white-space: nowrap; }
  .fan-hit:focus-visible { outline: 1px solid var(--ochre); outline-offset: 3px; }

  .fan-detail {
    width: min(1320px, 94vw); margin: 3vh auto 0; min-height: 92px;
    border-top: 1px solid rgba(var(--hairline-rgb), 0.28); padding-top: 16px;
  }
  .fan-detail-head {
    margin: 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--paper);
  }
  .fan-detail-head span[data-detail-beta] { color: var(--ochre); margin-left: 10px; }
  .fan-detail-gloss { margin: 8px 0 0; font-size: 14px; color: var(--ink-3); max-width: 62ch; }
  .fan-detail-list {
    margin: 12px 0 0; padding: 0; list-style: none;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 4px 24px;
  }
  .fan-detail-list li {
    display: grid; grid-template-columns: 1fr auto; gap: 12px;
    font-size: 12.5px; color: var(--ink-3);
    padding: 3px 0; border-bottom: 1px solid rgba(var(--hairline-rgb), 0.12);
  }
  .fan-detail-score { font-family: var(--font-mono); font-size: 11px; color: var(--ochre); }

  /* Narrow screens: the fan is too wide to read and dragging fights the scroll, so the
     destinations become a plain list. Same content, finished state. */
  @media (max-width: 720px) {
    .fan-stage { display: none; }
    .fan-hits {
      position: static; display: grid; gap: 8px;
      width: min(1320px, 94vw); margin: 4vh auto 0;
    }
    .fan-hit-wrap { position: static; transform: none; }
    .fan-hit {
      border: 1px solid rgba(var(--hairline-rgb), 0.3); border-radius: 10px;
      padding: 14px 16px; flex-direction: row; justify-content: space-between; width: 100%;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../lib/motion';

  interface BeamData {
    key: string; label: string; href: string | null; announce: string | null; gloss: string;
    beta: number; azimuth: number; elevation: number; length: number; halfWidth: number;
    tip: { x: number; y: number; z: number };
  }

  const teardowns: Array<() => void> = [];

  function initFans(): void {
    while (teardowns.length) teardowns.pop()!();
    document.querySelectorAll<HTMLElement>('[data-fan-stage]').forEach((stage) => {
      const t = initFan(stage);
      if (t) teardowns.push(t);
    });
  }

  function initFan(stage: HTMLElement): (() => void) | null {
    const section = stage.closest('#factor-fan') as HTMLElement | null;
    if (!section) return null;
    const canvas = stage.querySelector<HTMLCanvasElement>('[data-fan-canvas]');
    const still = stage.querySelector<HTMLElement>('[data-fan-still]');
    const hits = stage.querySelector<HTMLElement>('[data-fan-hits]');
    const detail = section.querySelector<HTMLElement>('[data-fan-detail]');
    if (!canvas || !still || !hits || !detail) return null;

    const payloadEl = section.querySelector('[data-fan-payload]');
    const signalsEl = section.querySelector('[data-fan-signals]');
    if (!payloadEl?.textContent || !signalsEl?.textContent) return null;
    const beams: BeamData[] = JSON.parse(payloadEl.textContent).beams;
    const signalsByFactor: Record<string, { label: string; score: number }[]> =
      JSON.parse(signalsEl.textContent);

    // ── The detail panel. Works whether or not the 3D layer ever loads.
    const setDetail = (key: string | null) => {
      if (!key) { detail.hidden = true; return; }
      const b = beams.find((x) => x.key === key);
      if (!b) return;
      detail.hidden = false;
      detail.querySelector('[data-detail-label]')!.textContent = b.label;
      detail.querySelector('[data-detail-beta]')!.textContent =
        b.beta > 0 ? `β ${b.beta.toFixed(3)}` : 'no signals yet';
      detail.querySelector('[data-detail-gloss]')!.textContent = b.gloss;
      const list = detail.querySelector('[data-detail-list]')!;
      const rows = signalsByFactor[key] ?? [];
      list.innerHTML = rows.length
        ? rows.map((s) =>
            `<li><span>${s.label}</span><span class="fan-detail-score">s ${s.score}</span></li>`,
          ).join('')
        : '<li><span>Nothing published here yet — the loading is exactly zero.</span></li>';
    };

    let activeKey: string | null = null;
    const hitEls = Array.from(hits.querySelectorAll<HTMLElement>('.fan-hit'));
    const onEnter = (e: Event) => {
      activeKey = (e.currentTarget as HTMLElement).dataset.key ?? null;
      setDetail(activeKey);
    };
    const onLeave = () => { activeKey = null; setDetail(null); };
    for (const el of hitEls) {
      el.addEventListener('pointerenter', onEnter);
      el.addEventListener('focus', onEnter);
      el.addEventListener('pointerleave', onLeave);
      el.addEventListener('blur', onLeave);
      if (el.tagName === 'BUTTON') el.addEventListener('click', (ev) => ev.preventDefault());
    }

    // Place the DOM controls from the SAME geometry the renderer uses, so a label can never
    // drift off its beam. Positions are recomputed by the render loop once 3D is live; this
    // is the static placement used by the still frame.
    const placeStatic = () => {
      for (const el of hits.querySelectorAll<HTMLElement>('.fan-hit-wrap')) {
        const b = beams.find((x) => x.key === el.dataset.key);
        if (!b) continue;
        // Match fanFrame's camera so the controls sit on the still frame's beams.
        const CAM = { z: -2.5, y: 1.15, focal: 1.05, pitch: 0.30 };
        const yc = b.tip.y - CAM.y, zc = b.tip.z - CAM.z;
        const cp = Math.cos(CAM.pitch), sp = Math.sin(CAM.pitch);
        const y1 = yc * cp + zc * sp;
        const z1 = Math.max(0.05, zc * cp - yc * sp);
        const s = CAM.focal / z1;
        // Same 1.18 push-out the 3D loop uses, so the static and live placements agree.
        el.style.left = `${(0.5 + b.tip.x * 1.18 * s) * 100}%`;
        el.style.top = `${(0.52 - y1 * 1.18 * s * (1600 / 880)) * 100}%`;
      }
    };
    placeStatic();

    // ── The 3D layer, loaded only when it is both wanted and visible.
    let dispose: (() => void) | null = null;
    let io: IntersectionObserver | null = null;

    if (!prefersReducedMotion() && window.matchMedia('(min-width: 721px)').matches) {
      io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io?.disconnect();
        io = null;
        // Dynamic import: Vite emits three.js as its own chunk, fetched now and not before.
        import('../lib/fanScene')
          .then(({ mountFanScene }) => {
            dispose = mountFanScene({
              canvas, beams,
              onActive: (key) => { if (!activeKey) setDetail(key); },
              placeLabel: (key, x, y) => {
                const el = hits.querySelector<HTMLElement>(`.fan-hit-wrap[data-key="${key}"]`);
                if (el) { el.style.left = `${x * 100}%`; el.style.top = `${y * 100}%`; }
              },
            });
            canvas.classList.add('is-live');
            still.classList.add('is-hidden');
          })
          .catch(() => {
            // A failed chunk must leave the finished still frame in place, not a blank box.
            canvas.classList.remove('is-live');
            still.classList.remove('is-hidden');
          });
      }, { rootMargin: '200px' });
      io.observe(stage);
    }

    return () => {
      io?.disconnect();
      dispose?.();
      for (const el of hitEls) {
        el.removeEventListener('pointerenter', onEnter);
        el.removeEventListener('focus', onEnter);
        el.removeEventListener('pointerleave', onLeave);
        el.removeEventListener('blur', onLeave);
      }
    };
  }

  document.addEventListener('astro:page-load', initFans);
</script>
