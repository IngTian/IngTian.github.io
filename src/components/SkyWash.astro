---
// The living Monet sky — woven warm/cool broken color over the .descent gradient.
// MUST render inside <main class="descent"> (a child), so its z-index:-1 tucks
// behind content within .descent's z-index:0 stacking context — a BaseLayout
// sibling would fall behind the opaque gradient and vanish. CSS, plus a small
// script that pauses the breathe while scrolling. The static state (woven color,
// no motion) is also the reduced-motion / Firefox fallback.
---
<div class="sky-wash" aria-hidden="true">
  <div class="sky-warm"></div>
  <div class="sky-cool"></div>
  <div class="sky-sun"></div>
</div>

<style>
  .sky-wash {
    position: absolute;
    inset: 0;
    z-index: -1;            /* behind content, above the gradient — like .descent::after */
    pointer-events: none;
    overflow: hidden;
  }
  .sky-wash > div {
    position: absolute;
    inset: 0;
    will-change: transform, opacity;
  }

  /* WARM woven strokes — strictly warm (gold → amber → soft peach), down a
     left-ish axis. No rose/magenta: the broken-color axis is WARM vs COLD, not
     purple vs red. "Whisper" strength (0.18): felt, not shouted — it compounds
     with the existing .descent::before/::after atmosphere, so it sits low. */
  .sky-warm {
    mix-blend-mode: soft-light;
    opacity: 0.18;
    background:
      radial-gradient(40% 13% at 20% 7%,  rgba(247,196,104,1), transparent 70%),
      radial-gradient(48% 14% at 33% 21%, rgba(238,160,86,1),  transparent 72%),
      radial-gradient(50% 15% at 28% 38%, rgba(230,150,92,1),  transparent 74%),
      radial-gradient(52% 16% at 38% 58%, rgba(224,158,108,1), transparent 78%),
      radial-gradient(58% 18% at 45% 84%, rgba(214,166,120,1), transparent 82%);
    transform-origin: 30% 40%;
  }

  /* COLD woven strokes — cool blue → teal (not pure indigo), down a right-ish
     axis. The opposite pole of the warm/cold axis. */
  .sky-cool {
    mix-blend-mode: soft-light;
    opacity: 0.18;
    background:
      radial-gradient(44% 14% at 82% 13%, rgba(118,162,206,1), transparent 72%),
      radial-gradient(42% 13% at 74% 28%, rgba(104,156,196,1), transparent 74%),
      radial-gradient(46% 14% at 68% 47%, rgba(96,150,190,1),  transparent 76%),
      radial-gradient(48% 15% at 66% 70%, rgba(92,140,184,1),  transparent 80%);
    transform-origin: 72% 55%;
  }

  /* luminous sun glow, upper-right — slightly lower than the washes */
  .sky-sun {
    mix-blend-mode: screen;
    opacity: 0.16;
    background: radial-gradient(34% 18% at 80% 9%, rgba(255,224,160,1), transparent 64%);
    transform-origin: 80% 9%;
  }

  /* NO WASH IN THE DARK THEME. The strokes (gold, blue, a pale sun) are far lighter than the night ground, and the
     group isolates their blends, so each paints as plain colour at a few percent: a lift of about 10 code values over
     a 500px radius, which 8 bits draw as rings. These were the "two big bubbles" (warm left, cool right). They read
     worst on the intro's flat first beat, stayed as a muddy cast at rest, and were strongest on a phone or without
     WebGL, where nothing lowers the layer's opacity. Hidden, not faded: the per-stroke dark opacities that stood here
     never applied while motion was on, because the breathe's keyframes set opacity, and an animation outranks a
     normal declaration. The dark sky's texture is the shader's nebula, or without WebGL the .descent washes. */
  :global(html[data-theme='dark']) .sky-wash { display: none; }

  /* Gentle breathe — warm & cool pulse OUT OF PHASE (as warm swells, cool
     recedes, then they trade), so the sky's temperature visibly shifts even
     while the viewer holds still. transform/opacity only; long mismatched
     durations so it never resyncs into an obvious loop. Gated: the static state
     above is the finished reduced-motion / Firefox / no-JS fallback. */
  @media (prefers-reduced-motion: no-preference) {
    .sky-warm { animation: sky-breathe-warm 20s ease-in-out infinite alternate; }
    .sky-cool { animation: sky-breathe-cool 26s ease-in-out infinite alternate; }
    .sky-sun  { animation: sky-breathe-sun  16s ease-in-out infinite alternate; }

    @keyframes sky-breathe-warm {
      from { transform: scale(1);    opacity: 0.12; }
      to   { transform: scale(1.12) translate3d(-20px, 15px, 0); opacity: 0.18; }
    }
    @keyframes sky-breathe-cool {
      from { transform: scale(1.10) translate3d(18px, -12px, 0); opacity: 0.18; }
      to   { transform: scale(1);    opacity: 0.12; }
    }
    @keyframes sky-breathe-sun {
      from { transform: scale(1);    opacity: 0.10; }
      to   { transform: scale(1.08); opacity: 0.16; }
    }

    /* ── THE BREATHE HOLDS ITS BREATH WHILE YOU SCROLL (the owner found the deck's scroll "not smooth enough").
       MEASURED: during a deck advance the median frame was 33.7ms (82% dropped). Bisecting cleared the nav's
       backdrop-filter, the descent washes, the grain and the hero canvas, and landed here: each of these three
       elements is 1685 x 7812 = 13.2 MEGAPIXELS (`inset: 0` inside main.descent is the whole DOCUMENT), each
       blended and animating, so every frame re-blends about 40 megapixels. Measured on a four-advance walk:
         will-change removed          32.5ms   (no help)
         blend modes off              24.6ms   (helps, and costs the Monet look)
         wash fixed to the viewport   25.0ms   (helps, and the sky stops descending with you)
         ANIMATION PAUSED              8.4ms   (as good as deleting the wash outright, which also gave 8.4ms)
       So pausing only WHILE SCROLLING costs nothing visible: the sky breathes whenever the reader is still.
       `animation-play-state: paused` resumes from the same point, so there is no jump. Only script ADDS the
       class, so with no JS the animation simply runs. */
    :global(html.wash-still) .sky-warm,
    :global(html.wash-still) .sky-cool,
    :global(html.wash-still) .sky-sun {
      animation-play-state: paused;
    }
    /* NOT also relaxing will-change here, though it looks like free savings: measured, dropping the promotion
       on scroll start was neutral-to-worse (medians 24.9/24.3/24.9 against 16.6/16.7/25.0 with it kept),
       because un-promoting forces a re-raster of a 13-megapixel layer at exactly the wrong moment. */
  }
</style>

<script>
  // Pauses the sky's breathe for the duration of a scroll — see the CSS note above for the measurements.
  // Lives with the wash rather than in the deck because SkyWash is on every page with a sky and the deck is only
  // on one.
  function initWashPause(): (() => void) | null {
    if (!document.querySelector('.sky-wash')) return null;
    // Nothing to pause when the animation was never started.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return null;

    const root = document.documentElement;
    let quiet = 0;

    const onScroll = () => {
      root.classList.add('wash-still');
      window.clearTimeout(quiet);
      // Long enough to cover the deck's own smooth scroll (measured at ~680ms for one slide gap) plus a beat,
      // so the breathe does not restart mid-flight and cause a second round of dropped frames.
      quiet = window.setTimeout(() => root.classList.remove('wash-still'), 260);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    return () => {
      window.clearTimeout(quiet);
      window.removeEventListener('scroll', onScroll);
      root.classList.remove('wash-still');
    };
  }

  let teardownWash: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    teardownWash?.();
    teardownWash = initWashPause();
  });
</script>
