---
// FluidSky: WebGL lifecycle for a domain-warped, scroll-responsive sky canvas.
//
// Shader (skyShader.ts) displaces sampling along the gradient; contrast policy
// (skyLegibility.ts) ensures text legibility. Two archetypes: descent (paper text,
// dangerous: lighter) and reading (dark ink, dangerous: darker).
//
// INVARIANTS:
//   1. Canvas is OPAQUE with no mix-blend-mode. A blended full-screen layer forces
//      the compositor to re-read the page backdrop every frame, defeating layer
//      caching for the whole document.
//   2. .fluid-live must never outlive a visible canvas. CSS rules (display:none
//      under 640px, reduced-motion, strength=0) gate the canvas, and the class is
//      additionally dropped on resize-to-hidden and GL context loss.
//
// Perf: viewport-sized (scroll is a uniform), 0.5x internal resolution, ~30fps
// idle / full rate while scrolling, paused on tab-hide, skipped under 640px.
interface Props {
  strength?: 0 | 1 | 2 | 3 | 4;
  mode?: 'background' | 'contained';
  /** 'descent' (paper text, dawn→ground) | 'reading' (dark ink, luminous) */
  variant?: 'descent' | 'reading';
}
const { strength = 4, mode = 'background', variant = 'descent' } = Astro.props;
---
<canvas
  class:list={['fluid-sky', mode === 'contained' ? 'is-contained' : 'is-background']}
  data-fluid-canvas
  aria-hidden="true"
  data-strength={String(strength)}
  data-mode={mode}
  data-variant={variant}
></canvas>

<style>
  .fluid-sky {
    pointer-events: none;
    display: block;
  }
  .fluid-sky.is-background {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  .fluid-sky.is-contained {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .fluid-sky[data-strength='0'] { display: none; }
  :global(html[data-fluid-strength='0']) .fluid-sky { display: none !important; }
  :global(html[data-fluid='off']) .fluid-sky { display: none; }
  @media (max-width: 640px) { .fluid-sky { display: none; } }
</style>

<script>
  import { prefersReducedMotion } from '../../lib/motion';
  import { VERTEX_SHADER, fragmentShader, SKY_UNIFORMS } from '../../lib/skyShader';
  import { gateFor, tintBudget, nebulaCeiling, type SkyVariant } from '../../lib/skyLegibility';
  import { rampFor, type Theme } from '../../lib/skyPalette';
  import {
    DEFAULT_MODE, NODE_COUNT, NODE_LIFETIME,
    smoothingAlpha, nodeStrength, speedDrive,
  } from '../../lib/skyInteraction';

  const VERT = VERTEX_SHADER;
  const FRAG = fragmentShader();

  // Strength ladder: 0 = off, 1-3 = subtle to strong, 4 = full strength.
  const AMP_BY_LEVEL = [0, 0.7, 1.0, 1.35, 1.8];

  const teardowns: Array<() => void> = [];

  function initAll(): void {
    while (teardowns.length) teardowns.pop()!();
    document.querySelectorAll<HTMLCanvasElement>('[data-fluid-canvas]').forEach((c) => {
      const t = initOne(c);
      if (t) teardowns.push(t);
    });
  }

  function buildRamp(theme: Theme, variant: SkyVariant): HTMLCanvasElement | null {
    const N = 512;
    const c = document.createElement('canvas');
    c.width = 1;
    c.height = N;
    const ctx = c.getContext('2d');
    if (!ctx) return null;
    const g = ctx.createLinearGradient(0, 0, 0, N);
    for (const [pos, hex] of rampFor(variant, theme)) g.addColorStop(pos, hex);
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 1, N);
    return c;
  }
  function initOne(cvs: HTMLCanvasElement): (() => void) | null {
    if (getComputedStyle(cvs).display === 'none') return null;
    const gl = (cvs.getContext('webgl', { antialias: false, alpha: false, depth: false })
      || cvs.getContext('experimental-webgl', { antialias: false, alpha: false, depth: false })) as WebGLRenderingContext | null;
    if (!gl) { cvs.style.display = 'none'; return null; }
    function compile(type: number, src: string): WebGLShader | null {
      const sh = gl!.createShader(type);
      if (!sh) return null;
      gl!.shaderSource(sh, src); gl!.compileShader(sh);
      if (!gl!.getShaderParameter(sh, gl!.COMPILE_STATUS)) { gl!.deleteShader(sh); return null; }
      return sh;
    }
    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) { cvs.style.display = 'none'; return null; }

    const prog = gl.createProgram();
    if (!prog) { cvs.style.display = 'none'; return null; }
    gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { cvs.style.display = 'none'; return null; }
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
    const U: Record<string, WebGLUniformLocation | null> = {};
    for (const name of SKY_UNIFORMS) U[name] = gl.getUniformLocation(prog, name);
    const tex = gl.createTexture();
    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);

    const variant = (cvs.dataset.variant ?? 'descent') as SkyVariant;
    let rampTheme: Theme | '' = '';
    function uploadRamp(force = false): void {
      const theme: Theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      if (!force && theme === rampTheme) return;
      rampTheme = theme;
      const ramp = buildRamp(theme, variant);
      if (!ramp) return;
      gl!.activeTexture(gl!.TEXTURE0);
      gl!.bindTexture(gl!.TEXTURE_2D, tex);
      gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RGBA, gl!.RGBA, gl!.UNSIGNED_BYTE, ramp);
      gl!.uniform1i(U.uRamp, 0);
    }
    uploadRamp(true);
    const contained = cvs.dataset.mode === 'contained';
    function level(): number {
      const live = document.documentElement.dataset.fluidStrength;
      if (live !== undefined) return Number(live);
      return Number(cvs.dataset.strength ?? '4');
    }
    let gateTop = 0.55;
    function measureGate(): void {
      if (contained) { gateTop = 1.0; return; }
      if (variant === 'reading') { gateTop = 0.0; return; }
      // Descent pages: find where content starts. Look for #mountains (homepage),
      // else fall back to the first element child of <main> with text content, else
      // treat the whole page as a reading zone (gateTop = 0.0, the conservative
      // direction — engages the legibility gate everywhere).
      const content = document.getElementById('mountains') ||
        Array.from(document.querySelector('main')?.children ?? [])
          .find((el): el is HTMLElement => el instanceof HTMLElement && el.textContent?.trim().length > 0) as HTMLElement | undefined;
      if (!content) { gateTop = 0.0; return; }
      const top = content.getBoundingClientRect().top + window.scrollY;
      gateTop = Math.min(0.95, Math.max(0.1, top / Math.max(1, document.documentElement.scrollHeight)));
    }
    measureGate();
    // The ambient sky renders at HALF resolution: it is a soft, low-frequency field
    // where 2x2 blocks are invisible, and halving the pixel count is most of why this
    // canvas is cheap.
    //
    // An interaction is the exception. The lens magnifies the field around a point,
    // which concentrates a spatial GRADIENT inside a ~120px radius — and at 0.5x that
    // gradient is quantised onto 2px blocks, which is what reads as a coarse or
    // "steppy" lens rather than glass. So the canvas re-sizes to full resolution while
    // an interaction is live and drops back to half when it ends. Idle cost is
    // unchanged (which is where the canvas spends nearly all its time), and the extra
    // pixels are only paid for while the pointer is actually doing something.
    const SCALE_IDLE = 0.5;
    const SCALE_ACTIVE = 1.0;
    let scaleNow = SCALE_IDLE;
    let sizedW = 0, sizedH = 0;
    function sizeTo(force = false): void {
      if (!force && sizedW && sizedH) {
        gl!.viewport(0, 0, sizedW, sizedH);
        return;
      }
      const w = Math.max(1, Math.round((cvs.clientWidth || 1) * scaleNow));
      const h = Math.max(1, Math.round((cvs.clientHeight || 1) * scaleNow));
      if (cvs.width !== w || cvs.height !== h) { cvs.width = w; cvs.height = h; }
      sizedW = cvs.width;
      sizedH = cvs.height;
      gl!.viewport(0, 0, sizedW, sizedH);
    }
    /** Switch internal resolution. Resizing a canvas clears it and reallocates its
     *  backbuffer, so this must only fire on a real transition, never per frame. */
    function setScale(next: number): void {
      if (next === scaleNow) return;
      scaleNow = next;
      sizeTo(true);
    }
    // Cached layout metrics: avoid per-frame synchronous layout reads.
    let mVw = Math.max(1, window.innerWidth);
    let mVh = Math.max(1, window.innerHeight);
    let mDocH = Math.max(1, document.documentElement.scrollHeight);
    function measureLayout(): void {
      mVw = Math.max(1, window.innerWidth);
      mVh = Math.max(1, window.innerHeight);
      mDocH = Math.max(1, document.documentElement.scrollHeight);
    }
    // ── Pointer interaction state ──────────────────────────────────────────
    // The pointer is tracked in SAMPLE SPACE (x = 0..1 across the canvas, y in the
    // same scrolling units the shader uses for sy), so the effect stays anchored to
    // the sky rather than to the screen while the page scrolls.
    //
    // Everything is exponentially smoothed with a time constant, not a per-frame
    // lerp: this canvas runs ~30fps idle and full-rate while scrolling, and a raw
    // lerp would make the interaction feel different at the two rates.
    const ptr = { x: 0.5, y: 0, presence: 0, speed: 0, vx: 0, vy: 0, turn: 0 };
    let rawX = 0.5, rawY = 0, havePointer = false, lastPtrMs = 0;
    let prevVx = 0, prevVy = 0;   // previous velocity, for the signed turning rate
    // Ripple node pool: xy = impact point, z = strength, w = age. Reused round-robin
    // so allocation is zero per frame and the count is a compile-time constant the
    // shader's loop bound matches (WebGL1 forbids a dynamic bound).
    const nodes = new Float32Array(NODE_COUNT * 4);
    const nodeAges = new Float32Array(NODE_COUNT).fill(Infinity);
    let nodeNext = 0;
    let dropClock = 0;
    // Continuous emission, not discrete: the user explicitly asked for "the drop to
    // be continuous instead of discrete", so drops land on a TIME cadence and are
    // interpolated along the path covered since the last one. Per-drop strength is
    // scaled down to compensate for more overlapping ripples, keeping the SUM mild.
    const DROP_INTERVAL = 0.075;

    function mode(): number {
      const live = document.documentElement.dataset.skyInteraction;
      if (live !== undefined) return Number(live) || 0;
      return DEFAULT_MODE;
    }

    function onPointerMove(e: PointerEvent): void {
      if (e.pointerType === 'touch') return;   // mouse/trackpad only, by design
      const rect = cvs.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      rawX = (e.clientX - rect.left) / rect.width;
      // y in the shader's scrolling sample units: same scale as uYOffset/uYSpan
      const vwNow = Math.max(1, mVw);
      rawY = (window.scrollY + (e.clientY - rect.top)) / vwNow;
      havePointer = true;
      lastPtrMs = performance.now();
    }
    function onPointerLeave(): void { havePointer = false; }

    // Advance the pointer + node simulation. Split out of draw() so the maths is
    // readable and so a frame with dt = 0 (a duplicate rAF) cannot divide by zero.
    function stepInteraction(dt: number): void {
      const m = mode();
      if (m === 0) {
        // Off: relax presence to zero so switching modes mid-hover fades out
        // instead of snapping, and let live nodes finish rather than vanish. Velocity
        // must decay too, or `speed` keeps its last value and the activity check that
        // drives frame rate and internal resolution never goes false.
        const decay = 1 - smoothingAlpha(dt, 0.25);
        ptr.presence *= decay;
        ptr.vx *= decay; ptr.vy *= decay; ptr.turn *= decay;
        ptr.speed = Math.hypot(ptr.vx, ptr.vy);
      } else {
        // Presence rises while the pointer is over the canvas and falls when it
        // leaves or goes idle — an idle pointer should not hold the sky open.
        // Slower rise (0.30s) than the original 0.18s: the lens should GATHER at the
        // pointer rather than appear at it. The fall stays longer still, so leaving
        // the sky relaxes rather than snaps off.
        //
        // The idle timeout is 6s, not 1.2s. At 1.2s a lens held still — which is the
        // lens's strongest and most deliberate state — silently dissolved while the
        // pointer had not moved at all, so resting on the sky and watching it looked
        // like the effect was broken. An idle pointer is a legitimate reading pose.
        const idleFor = (performance.now() - lastPtrMs) / 1000;
        const want = havePointer && idleFor < 6 ? 1 : 0;
        ptr.presence += (want - ptr.presence) * smoothingAlpha(dt, want ? 0.30 : 0.55);

        // ── Position lag, and why it must SHRINK as the pointer speeds up ──────
        // A little lag makes the effect feel like a material responding instead of a
        // spotlight glued to the cursor. But a FIXED time constant gives lag that
        // grows without bound with speed, because steady-state lag is v * tau:
        //
        //   at tau = 0.055 and R = 122px (the lens radius at 1440 wide)
        //      430 px/s ->  24px = 0.19 R   under the cursor, correct
        //     1500 px/s ->  82px = 0.67 R   trailing
        //     2200 px/s -> 121px = 0.99 R   DETACHED — a blob behind the cursor
        //     3500 px/s -> 192px = 1.57 R   entirely outside its own footprint
        //
        // That is the "works when I move slowly, poorly when I move fast" failure: a
        // flick easily reaches 2000-3000px/s, where the lens is no longer where you
        // are pointing. Physically it is also wrong — a bead of water under your
        // finger does not fall further behind the faster you drag it.
        //
        // So tau is scaled down with speed, holding lag at roughly a FIXED FRACTION
        // of the radius instead of a fixed time. Slow moves keep the full 0.055s of
        // inertia; a fast flick converges toward tau_min and stays under the cursor.
        // Ripple is excluded: its nodes detach from the pointer by design on emission.
        const m2 = mode();
        const localised = m2 === 1 || m2 === 2 || m2 === 3;
        // speed is in viewport widths/sec; 0.30 vw/s ~ 480px/s at 1600 wide.
        //
        // The slow end is 0.095s, not 0.055s: the lens radius grew to ~208px, and lag
        // only reads as wrong relative to the FOOTPRINT, so a bigger lens can afford
        // more absolute inertia at the same fraction of R (38px = 0.18R at 480px/s).
        // That extra inertia is what makes a slow drift feel like glass gliding rather
        // than a disc snapped to the cursor — the "smoother" half of the request.
        // The fast end still converges to 0.017s so the lens stays under the cursor
        // during a flick; the whole point is that these two ends want opposite things.
        const fastness = Math.min(1, ptr.speed / 1.2);
        const tauPos = localised ? 0.095 - 0.078 * fastness : 0.085;
        const aPos = smoothingAlpha(dt, tauPos);
        const nx = ptr.x + (rawX - ptr.x) * aPos;
        const ny = ptr.y + (rawY - ptr.y) * aPos;
        if (dt > 0) {
          const ivx = (nx - ptr.x) / dt, ivy = (ny - ptr.y) / dt;
          // Velocity RISES fast and falls slow. It now feeds the position time
          // constant above, so a slow rise would mean the lag shrinks only after the
          // flick is already underway — the effect would detach for the first ~100ms
          // of every fast move, which is precisely the part that reads as broken.
          // Asymmetric smoothing (0.03s up, 0.12s down) reacts immediately to
          // acceleration while still decaying gently, so the vortex's turning rate and
          // the fade do not flicker when the pointer stops.
          const speeding = Math.hypot(ivx, ivy) > Math.hypot(ptr.vx, ptr.vy);
          const aVel = smoothingAlpha(dt, speeding ? 0.03 : 0.12);
          ptr.vx += (ivx - ptr.vx) * aVel;
          ptr.vy += (ivy - ptr.vy) * aVel;
        }
        // Signed TURNING RATE, for the vortex model. The 2D cross product of the
        // previous and current velocity gives the sense and magnitude of the turn;
        // normalising by the speeds makes it a rate rather than a speed proxy, which
        // is the point: a STRAIGHT stroke has zero curvature and must leave the sky
        // untouched, or the model degenerates into the rejected "stirring".
        if (dt > 0) {
          const sp = Math.hypot(ptr.vx, ptr.vy), spPrev = Math.hypot(prevVx, prevVy);
          const cross = prevVx * ptr.vy - prevVy * ptr.vx;
          const turnNow = sp > 1e-4 && spPrev > 1e-4 ? cross / (sp * spPrev) / dt : 0;
          // smoothed so a single jittery sample cannot spike the twist
          ptr.turn += (turnNow - ptr.turn) * smoothingAlpha(dt, 0.16);
          prevVx = ptr.vx; prevVy = ptr.vy;
        }
        ptr.x = nx; ptr.y = ny;
        ptr.speed = Math.hypot(ptr.vx, ptr.vy);

        // Bleed velocity toward zero when no pointer is present. Without this, vx/vy
        // keep whatever value they last held — nothing recomputes them once events
        // stop — so `speed` stays above the activity threshold forever and the canvas
        // never returns to its idle frame rate or half resolution. Measured: it sat
        // at full resolution indefinitely after the pointer left.
        if (!havePointer) {
          const decay = 1 - smoothingAlpha(dt, 0.20);
          ptr.vx *= decay; ptr.vy *= decay; ptr.turn *= decay;
          ptr.speed = Math.hypot(ptr.vx, ptr.vy);
        }
      }

      // Ripple emission (mode 4 only) — continuous cadence, interpolated path.
      if (m === 4 && ptr.presence > 0.05) {
        dropClock += dt;
        while (dropClock >= DROP_INTERVAL) {
          dropClock -= DROP_INTERVAL;
          // gentle movement makes gentle drops; a still pointer still emits, faintly
          const drive = 0.35 + 0.65 * speedDrive(ptr.speed);
          nodes[nodeNext * 4 + 0] = ptr.x;
          nodes[nodeNext * 4 + 1] = ptr.y;
          nodes[nodeNext * 4 + 2] = drive * ptr.presence;
          nodes[nodeNext * 4 + 3] = 0;
          nodeAges[nodeNext] = 0;
          nodeNext = (nodeNext + 1) % NODE_COUNT;
        }
      }
      // Age every live node and recompute its strength envelope.
      for (let i = 0; i < NODE_COUNT; i++) {
        if (!Number.isFinite(nodeAges[i])) continue;
        nodeAges[i] += dt;
        if (nodeAges[i] >= NODE_LIFETIME) {
          nodeAges[i] = Infinity;
          nodes[i * 4 + 2] = 0;
          continue;
        }
        nodes[i * 4 + 3] = nodeAges[i];
        // keep the emitted drive, scale by the age envelope
        const base = nodes[i * 4 + 2];
        if (base > 0) nodes[i * 4 + 2] = base;
      }
    }

    /** Is any ripple still visible? Keeps the loop at full rate until the last one
     *  has finished expanding, so a ripple never freezes mid-flight. */
    function hasLiveNodes(): boolean {
      for (let i = 0; i < NODE_COUNT; i++) if (Number.isFinite(nodeAges[i])) return true;
      return false;
    }

    /** Per-node strength actually sent to the GPU: emitted drive x age envelope. */
    const nodeUpload = new Float32Array(NODE_COUNT * 4);
    function packNodes(): Float32Array {
      for (let i = 0; i < NODE_COUNT; i++) {
        const age = nodeAges[i];
        const live = Number.isFinite(age);
        nodeUpload[i * 4 + 0] = nodes[i * 4 + 0];
        nodeUpload[i * 4 + 1] = nodes[i * 4 + 1];
        nodeUpload[i * 4 + 2] = live ? nodes[i * 4 + 2] * nodeStrength(age) : 0;
        nodeUpload[i * 4 + 3] = live ? age : 0;
      }
      return nodeUpload;
    }

    const t0 = performance.now();
    let lastDrawMs = t0;
    function draw(nowMs: number): void {
      sizeTo();
      uploadRamp();
      const vw = mVw, vh = mVh, docH = mDocH;
      if (contained) {
        gl!.uniform1f(U.uYOffset, level() * 2.0);
        gl!.uniform1f(U.uYSpan, (cvs.clientHeight || vh) / (cvs.clientWidth || vw));
        gl!.uniform1f(U.uDepth0, 0.0);
        gl!.uniform1f(U.uDepthSpan, 1.0);
      } else {
        gl!.uniform1f(U.uYOffset, window.scrollY / vw);
        gl!.uniform1f(U.uYSpan, vh / vw);
        gl!.uniform1f(U.uDepth0, window.scrollY / docH);
        gl!.uniform1f(U.uDepthSpan, vh / docH);
      }
      gl!.uniform1f(U.uAmp, AMP_BY_LEVEL[Math.max(0, Math.min(4, level()))] ?? 1.0);
      gl!.uniform1f(U.uDark, document.documentElement.dataset.theme === 'dark' ? 1 : 0);
      gl!.uniform3f(U.uNebula, 0.055, 0.105, 0.115);
      gl!.uniform1f(U.uReading, variant === 'reading' ? 1 : 0);
      gl!.uniform1f(U.uGateTop, gateTop);
      const gates = gateFor(1, variant);
      gl!.uniform1f(U.uGateDark, gates.dark);
      gl!.uniform1f(U.uGateLight, gates.light);
      const budget = tintBudget(variant);
      gl!.uniform1f(U.uTintCap, budget.cap);
      gl!.uniform1f(U.uViscousFloor, budget.viscousFloor);
      gl!.uniform1f(U.uNebulaCeiling, nebulaCeiling());
      gl!.uniform1f(U.uTime, (nowMs - t0) / 1000);

      // Pointer interaction. dt is clamped: a backgrounded tab or a long GC pause
      // can hand back a huge delta, which would teleport the pointer and fire a
      // burst of ripples all at one spot.
      const dt = Math.min(0.05, Math.max(0, (nowMs - lastDrawMs) / 1000));
      lastDrawMs = nowMs;
      stepInteraction(dt);
      gl!.uniform1f(U.uMode, contained ? 0 : mode());
      gl!.uniform4f(U.uPtr, ptr.x, ptr.y, ptr.presence, ptr.speed);
      // uPtrVel carries the raw velocity for WIND (which advects along it), but the
      // signed TURNING RATE in .x for VORTEX (which must be zero on a straight
      // stroke). One vec2, two meanings, selected by mode — documented here and in
      // the GLSL because a reader of either side alone would misread it.
      const vortex = mode() === 3;
      gl!.uniform2f(U.uPtrVel, vortex ? ptr.turn : ptr.vx, vortex ? 0 : ptr.vy);
      gl!.uniform4fv(U.uNodes, packNodes());

      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
    }

    sizeTo(true);
    draw(performance.now());
    if (!contained) cvs.closest('.descent')?.classList.add('fluid-live');
    const reduce = prefersReducedMotion();
    let rafId = 0, running = false, last = 0, scrolling = false;
    function loop(now: number): void {
      // Full rate whenever a pointer effect is ALIVE — not only while it is moving.
      //
      // An earlier version gated this on movement, reasoning that a still pointer adds
      // no temporal signal. That is wrong for the lens, and backwards in the worst
      // way: the lens FADES as the pointer moves and is strongest at rest, so its
      // smoothest, most-visible moment is exactly the one that gated down to ~30fps.
      // What the eye then saw was the effect relaxing in visible steps.
      //
      // A settling effect is still animating even when the input is static: the
      // exponential position/presence smoothing has a ~0.055-0.42s tail, and every
      // frame of that tail is a different image. So escalate on presence, and hold
      // full rate briefly after presence decays so the relaxation lands smoothly too.
      const settling = ptr.presence > 0.02 || ptr.speed > 0.004;
      const interactive = mode() !== 0 && (settling || hasLiveNodes());
      // Full internal resolution only while an interaction is live — see sizeTo().
      setScale(interactive ? SCALE_ACTIVE : SCALE_IDLE);
      const budget = scrolling || interactive ? 0 : 32;
      if (now - last >= budget) { draw(now); last = now; }
      rafId = requestAnimationFrame(loop);
    }
    function start(): void {
      if (running || reduce || document.hidden) return;
      running = true; last = 0; rafId = requestAnimationFrame(loop);
    }
    function stop(): void {
      if (!running) return;
      running = false; cancelAnimationFrame(rafId); rafId = 0;
    }
    const onLost = (e: Event) => {
      e.preventDefault(); stop();
      if (!contained) cvs.closest('.descent')?.classList.remove('fluid-live');
    };
    const onRestored = () => { initAll(); };
    const onVis = () => { if (document.hidden) stop(); else start(); };
    cvs.addEventListener('webglcontextlost', onLost as EventListener);
    cvs.addEventListener('webglcontextrestored', onRestored);
    document.addEventListener('visibilitychange', onVis);
    // Pointer listeners go on the WINDOW, not the canvas: the canvas is
    // pointer-events: none (it must never intercept a click or a text selection),
    // so it receives no pointer events of its own. Passive, and skipped entirely
    // under reduced motion — the no-motion state must look finished, and a
    // pointer-driven effect is motion.
    const onMove = onPointerMove as EventListener;
    const onLeaveWin = onPointerLeave as EventListener;
    if (!reduce && !contained) {
      window.addEventListener('pointermove', onMove, { passive: true });
      window.addEventListener('pointerdown', onMove, { passive: true });
      document.addEventListener('pointerleave', onLeaveWin, { passive: true });
      window.addEventListener('blur', onLeaveWin);
    }
    let scrollRaf = 0, scrollIdleT = 0;
    const onScroll = () => {
      scrolling = true;
      window.clearTimeout(scrollIdleT);
      scrollIdleT = window.setTimeout(() => { scrolling = false; }, 160);
      if (reduce && !scrollRaf) {
        scrollRaf = requestAnimationFrame(() => { scrollRaf = 0; draw(performance.now()); });
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    let resizeT = 0;
    const onResize = () => {
      window.clearTimeout(resizeT);
      resizeT = window.setTimeout(() => {
        const hidden = getComputedStyle(cvs).display === 'none';
        if (!contained) cvs.closest('.descent')?.classList.toggle('fluid-live', !hidden);
        if (hidden) { stop(); return; }
        start();
        sizeTo(true); measureLayout(); measureGate(); draw(performance.now());
      }, 160);
    };
    window.addEventListener('resize', onResize);

    const mo = new MutationObserver(() => { uploadRamp(true); draw(performance.now()); });
    mo.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-fluid-strength', 'data-theme', 'data-sky-interaction'],
    });

    const settle = window.setTimeout(() => { sizeTo(true); measureLayout(); measureGate(); draw(performance.now()); }, 1200);

    start();

    return () => {
      stop();
      window.clearTimeout(resizeT);
      window.clearTimeout(settle);
      if (scrollRaf) cancelAnimationFrame(scrollRaf);
      window.clearTimeout(scrollIdleT);
      document.removeEventListener('visibilitychange', onVis);
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerdown', onMove);
      document.removeEventListener('pointerleave', onLeaveWin);
      window.removeEventListener('blur', onLeaveWin);
      cvs.removeEventListener('webglcontextlost', onLost as EventListener);
      cvs.removeEventListener('webglcontextrestored', onRestored);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      mo.disconnect();
      cvs.closest('.descent')?.classList.remove('fluid-live');
      gl.deleteTexture(tex);
      gl.deleteBuffer(buf);
      gl.deleteProgram(prog);
      gl.deleteShader(vs);
      gl.deleteShader(fs);
    };
  }

  document.addEventListener('astro:page-load', initAll);
</script>
