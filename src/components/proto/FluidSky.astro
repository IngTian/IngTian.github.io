---
// FluidSky (PROTOTYPE) — the fluid IS the sky. It REPLACES --descent-grad.
//
// ── Why replace, after two rounds of "combine" ────────────────────────────
// Combining was the wrong call and the symptoms proved it. Modulating a tuned
// gradient means the effect fights the thing underneath it: strong enough to see
// meant strong enough to grey out the palette and hurt text contrast, and weak
// enough to be safe meant invisible. Also, layering "Monet-ish ink" on top of a
// "Monet sky" is redundant — the same idea twice, each diluting the other.
//
// As the background it stops fighting anything:
//   · NO mix-blend-mode → the compositor never re-reads the page backdrop, which
//     was the real per-frame cost (not the noise math). An opaque layer is just
//     a blit.
//   · It can run at FULL strength, because it isn't distorting a gradient — it is
//     the gradient.
//   · Contrast becomes controllable rather than accidental: the shader owns the
//     colour, so the descent's luminance ramp is GUARANTEED (see uContrast and
//     the legibility gate below) instead of hoped for.
//
// ── How the Monet colour story survives ───────────────────────────────────
// The vertical palette is uploaded as a 1D gradient TEXTURE built from the exact
// --descent-grad stops (mirrored from tokens.css). The shader does not invent
// colour — the domain-warped field only displaces WHERE along that ramp each
// pixel samples. So dawn paper → ochre → lavender → indigo dusk → grey ink →
// near-black ground is preserved, but the boundaries marble and diffuse like ink
// in water. That is the Seine, not a gradient with fog on it.
//
// ── Cost ──────────────────────────────────────────────────────────────────
// Page-height absolute canvas, drawn ONCE. Scrolling moves you through it for
// free, exactly like the CSS gradient it replaces — no scroll uniform, no rAF,
// no blend. Redraw happens only on resize or theme change.
//
// No WebGL → canvas hides → .descent's CSS gradient shows → today's site.
interface Props {
  /** Warp strength. 0 = plain gradient · 1 subtle · 2 medium · 3 strong · 4 max */
  strength?: 0 | 1 | 2 | 3 | 4;
  /** `background` (default) — the sky itself. `contained` — a ladder rung. */
  mode?: 'background' | 'contained';
}
const { strength = 2, mode = 'background' } = Astro.props;
---
<canvas
  class:list={['fluid-sky', mode === 'contained' ? 'is-contained' : 'is-background']}
  data-fluid-canvas
  aria-hidden="true"
  data-strength={String(strength)}
  data-mode={mode}
></canvas>

<style>
  .fluid-sky {
    position: absolute;
    pointer-events: none;
    display: block;
    /* NO mix-blend-mode. This is the sky, not a wash over it — that omission is
       the entire performance fix. */
  }

  /* ── BACKGROUND: covers the whole descent, behind everything ─────────────
     z-index:-2 (SkyWash and .descent::before/::after sit at -1) so the woven
     broken-colour washes still ride ON TOP of the fluid, and all of it stays
     behind content. Negative-z children paint above the parent's own background,
     so this opaquely replaces --descent-grad while leaving it as the fallback. */
  .fluid-sky.is-background {
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  /* ── CONTAINED: a /proto-ladder rung ────────────────────────────────────── */
  .fluid-sky.is-contained {
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  /* Strength is a SHADER uniform now, not opacity — the layer is opaque. Only
     "off" is a CSS concern. */
  .fluid-sky[data-strength='0'] { display: none; }
  :global(html[data-fluid-strength='0']) .fluid-sky { display: none !important; }

  /* Layer kill-switch → falls back to the shipped CSS gradient. */
  :global(html[data-fluid='off']) .fluid-sky { display: none; }

  /* Phones: a page-height texture is the wrong trade on a narrow viewport where
     the sky is mostly behind content. The CSS gradient is the finished state. */
  @media (max-width: 640px) {
    .fluid-sky { display: none; }
  }
</style>

<script>
  const VERT = `
    attribute vec2 aPos;
    varying vec2 vUv;
    void main() {
      vUv = aPos * 0.5 + 0.5;
      gl_Position = vec4(aPos, 0.0, 1.0);
    }
  `;

  // The field displaces WHERE we sample the palette ramp; it never authors colour.
  const FRAG = `
    precision highp float;
    varying vec2 vUv;
    uniform sampler2D uRamp;   // 1D descent palette (exact --descent-grad stops)
    uniform float uAmp;        // warp strength
    uniform float uAspect;     // height/width, so strata aren't stretched
    uniform float uGateTop;    // normalized depth where the content zone starts
    uniform float uGateSoft;   // fade distance into that zone

    float hash(vec2 p) {
      p = fract(p * vec2(443.897, 441.423));
      p += dot(p, p + 19.19);
      return fract(p.x * p.y);
    }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i),                 hash(i + vec2(1.0, 0.0)), u.x),
                 mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
    }
    float fbm(vec2 p) {
      float v = 0.0, a = 0.5;
      for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.02; a *= 0.5; }
      return v;
    }

    void main() {
      // depth: 0 at the dawn top, 1 at the near-black ground
      float depth = 1.0 - vUv.y;

      // Isotropic sample space. The canvas is page-tall (very non-square), so
      // without the aspect term the strata would smear into horizontal bands.
      vec2 p = vec2(vUv.x, (1.0 - vUv.y) * uAspect) * 2.4;

      // two-level domain warp — the ink-in-water signature
      vec2 q = vec2(fbm(p), fbm(p + vec2(5.2, 1.3)));
      vec2 r = vec2(fbm(p + 2.9 * q + vec2(1.7, 9.2)),
                    fbm(p + 2.9 * q + vec2(8.3, 2.8)));
      float f = fbm(p + 2.6 * r);

      // Stratify: banding the warp field is what reads as diffusion rather than
      // as a soft blur.
      float bands = sin((f * 6.2831853) * 1.35 + length(r) * 2.2);
      float strata = smoothstep(-0.7, 0.7, bands);
      float field = mix(f, strata, 0.5) - 0.5;   // centred, range ~[-0.5, 0.5]

      // ── LEGIBILITY GATE ────────────────────────────────────────────────
      // Vertical displacement is what changes a pixel's luminance, so it is also
      // what can wreck text contrast. Free rein through the open sky; damped to a
      // fraction once we reach the content zone, where light paper text sits on
      // grey ink. The colour story still marbles there — just not far enough to
      // lift the background into the text's value range.
      float gate = 1.0 - 0.82 * smoothstep(uGateTop, uGateTop + uGateSoft, depth);

      // Displace where we read the ramp. 0.26 (was 0.16) — with the gate holding
      // the reading zone safe, the open sky can afford a much larger excursion,
      // which is what makes the strata read as ink in water rather than a haze.
      float y = clamp(depth + field * uAmp * 0.26 * gate, 0.0, 1.0);

      vec3 col = texture2D(uRamp, vec2(0.5, y)).rgb;

      // A whisper of warm/cool broken colour along the warp axis — Monet's
      // temperature play. Also damped by the gate.
      float temp = (r.x - r.y) * 0.05 * uAmp * gate;
      col.r += temp;
      col.b -= temp * 1.1;

      gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
    }
  `;

  // ── The descent palette, mirroring --descent-grad in tokens.css ──────────
  // Kept in sync by hand (a prototype); the shipped version should read these
  // from the token so they can never drift.
  const LIGHT_STOPS: Array<[number, string]> = [
    [0.00, '#f4efe4'], [0.08, '#f0eadf'], [0.15, '#efe6d4'], [0.23, '#e2d2c2'],
    [0.30, '#ccc4b6'], [0.37, '#a6a8ad'], [0.44, '#7d7e88'], [0.52, '#565660'],
    [0.62, '#3a3833'], [0.78, '#2a2720'], [0.90, '#1d1b16'], [1.00, '#16140f'],
  ];
  const DARK_STOPS: Array<[number, string]> = [
    [0.00, '#16191d'], [0.20, '#131619'], [0.40, '#111417'],
    [0.60, '#0e1013'], [0.80, '#0b0d0f'], [1.00, '#08090b'],
  ];

  const AMP_BY_LEVEL = [0, 0.55, 1.0, 1.6, 2.4];

  const teardowns: Array<() => void> = [];

  function initAll(): void {
    while (teardowns.length) teardowns.pop()!();
    document.querySelectorAll<HTMLCanvasElement>('[data-fluid-canvas]').forEach((c) => {
      const t = initOne(c);
      if (t) teardowns.push(t);
    });
  }

  /** Paint the descent ramp into a tall 1px-wide canvas → upload as the palette. */
  function buildRamp(dark: boolean): HTMLCanvasElement | null {
    const N = 512;
    const c = document.createElement('canvas');
    c.width = 1;
    c.height = N;
    const ctx = c.getContext('2d');
    if (!ctx) return null;
    const g = ctx.createLinearGradient(0, 0, 0, N);
    for (const [pos, hex] of dark ? DARK_STOPS : LIGHT_STOPS) g.addColorStop(pos, hex);
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 1, N);
    return c;
  }

  function initOne(cvs: HTMLCanvasElement): (() => void) | null {
    if (getComputedStyle(cvs).display === 'none') return null;

    const gl = (cvs.getContext('webgl', { antialias: false, alpha: false, depth: false })
      || cvs.getContext('experimental-webgl', { antialias: false, alpha: false, depth: false })) as WebGLRenderingContext | null;
    if (!gl) { cvs.style.display = 'none'; return null; }

    function compile(type: number, src: string): WebGLShader | null {
      const sh = gl!.createShader(type);
      if (!sh) return null;
      gl!.shaderSource(sh, src);
      gl!.compileShader(sh);
      if (!gl!.getShaderParameter(sh, gl!.COMPILE_STATUS)) { gl!.deleteShader(sh); return null; }
      return sh;
    }

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) { cvs.style.display = 'none'; return null; }

    const prog = gl.createProgram();
    if (!prog) { cvs.style.display = 'none'; return null; }
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { cvs.style.display = 'none'; return null; }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const uRamp = gl.getUniformLocation(prog, 'uRamp');
    const uAmp = gl.getUniformLocation(prog, 'uAmp');
    const uAspect = gl.getUniformLocation(prog, 'uAspect');
    const uGateTop = gl.getUniformLocation(prog, 'uGateTop');
    const uGateSoft = gl.getUniformLocation(prog, 'uGateSoft');

    const tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);

    function uploadRamp(): void {
      const dark = document.documentElement.dataset.theme === 'dark';
      const ramp = buildRamp(dark);
      if (!ramp) return;
      gl!.bindTexture(gl!.TEXTURE_2D, tex);
      gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RGBA, gl!.RGBA, gl!.UNSIGNED_BYTE, ramp);
      gl!.uniform1i(uRamp, 0);
    }

    function level(): number {
      const live = document.documentElement.dataset.fluidStrength;
      if (live !== undefined) return Number(live);
      return Number(cvs.dataset.strength ?? '2');
    }

    // Where does the reading zone begin, as a fraction of the whole descent? The
    // gate damps vertical displacement from here down so text contrast holds.
    function gateTop(): number {
      if (cvs.dataset.mode === 'contained') return 1.0;   // no content → no gate
      const content = document.getElementById('mountains');
      const host = cvs.offsetParent as HTMLElement | null;
      if (!content || !host) return 0.55;
      const hostTop = host.getBoundingClientRect().top + window.scrollY;
      const hostH = host.offsetHeight || 1;
      const cTop = content.getBoundingClientRect().top + window.scrollY;
      return Math.min(0.95, Math.max(0.1, (cTop - hostTop) / hostH));
    }

    // Page-height canvas at reduced resolution. Clamped to the driver's
    // renderbuffer limit — the descent can be 4000-6000px tall, and a texture
    // request past MAX_RENDERBUFFER_SIZE fails silently to a blank frame.
    const MAX = Math.min(4096, gl.getParameter(gl.MAX_RENDERBUFFER_SIZE) as number || 4096);

    function draw(): void {
      const cssW = cvs.clientWidth || 1;
      const cssH = cvs.clientHeight || 1;
      let scale = 0.5;
      // shrink further if the page is so tall that 0.5x would exceed the limit
      if (cssH * scale > MAX) scale = MAX / cssH;
      const w = Math.max(1, Math.min(MAX, Math.round(cssW * scale)));
      const h = Math.max(1, Math.min(MAX, Math.round(cssH * scale)));
      if (cvs.width !== w || cvs.height !== h) {
        cvs.width = w;
        cvs.height = h;
      }
      gl!.viewport(0, 0, w, h);

      gl!.activeTexture(gl!.TEXTURE0);
      uploadRamp();
      gl!.uniform1f(uAmp, AMP_BY_LEVEL[Math.max(0, Math.min(4, level()))] ?? 1.0);
      // aspect keeps the noise isotropic on a very tall canvas
      gl!.uniform1f(uAspect, cssH / Math.max(1, cssW));
      gl!.uniform1f(uGateTop, gateTop());
      gl!.uniform1f(uGateSoft, 0.06);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
    }

    draw();

    // Signal that the canvas has really painted, so the page can drop the CSS
    // gradient underneath it. Doing this only AFTER a successful draw is what
    // makes every failure path (no WebGL, shader compile fail, size clamp) fall
    // back to the shipped gradient instead of a blank void.
    if (cvs.dataset.mode !== 'contained') {
      const host = cvs.closest('.descent');
      host?.classList.add('fluid-live');
    }

    // Redraw only when the picture genuinely changes. No rAF, no scroll handler —
    // the canvas is page-tall, so scrolling moves through it exactly like the CSS
    // gradient it replaces.
    let t = 0;
    const onResize = () => { window.clearTimeout(t); t = window.setTimeout(draw, 180); };
    window.addEventListener('resize', onResize);

    const mo = new MutationObserver(() => draw());
    mo.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-fluid-strength', 'data-theme'],
    });

    // The descent's height changes as images/fonts settle; one late redraw keeps
    // the ramp aligned to the final layout.
    const settle = window.setTimeout(draw, 1200);

    return () => {
      window.clearTimeout(t);
      window.clearTimeout(settle);
      window.removeEventListener('resize', onResize);
      mo.disconnect();
      // Restore the CSS gradient — otherwise a View-Transition swap would leave
      // the page with the gradient suppressed and no canvas painting it.
      cvs.closest('.descent')?.classList.remove('fluid-live');
      gl.deleteTexture(tex);
      gl.deleteBuffer(buf);
      gl.deleteProgram(prog);
      gl.deleteShader(vs);
      gl.deleteShader(fs);
    };
  }

  document.addEventListener('astro:page-load', initAll);
</script>
