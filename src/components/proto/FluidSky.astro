---
// FluidSky (PROTOTYPE) — the Monet sky's ink diffusion, as an UPPER-SKY
// ATMOSPHERE layer that paints ONCE.
//
// ── Why this was rewritten ────────────────────────────────────────────────
// The previous version was a full-viewport `position: fixed` canvas with
// `mix-blend-mode`, redrawing its shader ~15-30×/sec forever. Two consequences,
// both reported:
//
//   1. COST. The noise math was only half the problem. A full-screen blended
//      layer forces the compositor to re-read and re-blend the backdrop on every
//      frame it changes — that defeats GPU layer caching for the whole page, and
//      `fixed` meant it never scrolled off. A permanent tax on every pixel.
//   2. LEGIBILITY. A whole-page layer necessarily covers the Mountains content
//      zone, which is light paper text on grey ink. Luminance modulation there
//      attacks text contrast directly. The effect was fighting the reading.
//
// ── The architecture now ──────────────────────────────────────────────────
// Exactly what the shipped site already does for atmosphere (`.descent::before`
// is a 120vh top-anchored wash that drifts via transform):
//
//   · ABSOLUTE, not fixed — anchored to the top of the descent and ~200vh tall,
//     so it covers Heights + Interlude and SCROLLS AWAY before Mountains. The
//     content zone is never under it. Solves (2) structurally, not by tuning.
//   · DRAWN ONCE. No rAF loop. The shader renders a single frame at init (and on
//     resize / theme change). Per-frame fragment cost is zero, so (1) is solved
//     at the root rather than optimized around.
//   · LIFE comes from a slow CSS transform drift — compositor-only, the one kind
//     of motion the taste rules allow, and the same technique as sky-drift-a/b.
//     The static state is finished, so reduced-motion just gets the still.
//   · MASKED with a vertical gradient: fades in below the hero's text band, is
//     strongest through the dusk/interlude turn, and is fully transparent before
//     the content starts. The ink lands where "an artist by night" lands.
//
// Still combine-not-replace: the tuned --descent-grad remains the source of
// truth; this modulates over it. No WebGL → nothing renders → today's site.
interface Props {
  /** 0 = off · 1 subtle · 2 medium · 3 strong · 4 too-much (the ceiling) */
  strength?: 0 | 1 | 2 | 3 | 4;
  /**
   * `atmosphere` (default) — top-anchored, masked, scrolls away before content.
   * `contained` — fills its positioned ancestor with no mask, for the /proto-ladder
   *   comparison rungs where several independent skies must coexist.
   */
  mode?: 'atmosphere' | 'contained';
}
const { strength = 1, mode = 'atmosphere' } = Astro.props;
---
<canvas
  class:list={['fluid-sky', mode === 'contained' ? 'is-contained' : 'is-atmosphere']}
  data-fluid-canvas
  aria-hidden="true"
  data-strength={String(strength)}
  data-mode={mode}
></canvas>

<style>
  .fluid-sky {
    position: absolute;
    pointer-events: none;
    display: block;
    z-index: -1;            /* behind content, above the gradient — SkyWash's slot */
    mix-blend-mode: overlay;
    opacity: var(--fluid-op, 0.30);
  }

  /* ── ATMOSPHERE: top-anchored, ends before the content zone ─────────────
     200vh covers Heights (108vh) + Interlude (78vh) with margin. Because it is
     absolute inside .descent (not fixed), it scrolls off naturally and the
     Mountains zone is never underneath it. */
  .fluid-sky.is-atmosphere {
    top: 0;
    left: 0;
    right: 0;
    /* Height is set in JS from the ACTUAL top of #mountains — vh arithmetic can't
       get this right (Heights carries pb-[12vh], sections use min-height, and the
       viewport unit basis differs from layout height). Guessing gave a measured
       200vh → 165px overlap, then 186vh → 36px. The fallback below is only for
       the pre-script paint. */
    height: 186vh;
    /* Fade in under the hero's text band, peak through the dusk turn, gone well
       before Mountains. This is also why the effect no longer costs legibility:
       it is simply not present where the dense text is. */
    --fluid-mask: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 12%,
      rgba(0, 0, 0, 0.85) 30%,
      rgba(0, 0, 0, 1) 46%,
      rgba(0, 0, 0, 0.9) 62%,
      rgba(0, 0, 0, 0.45) 78%,
      transparent 92%
    );
    -webkit-mask-image: var(--fluid-mask);
    mask-image: var(--fluid-mask);
  }

  /* ── CONTAINED: the ladder rungs ────────────────────────────────────────── */
  .fluid-sky.is-contained {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ── Strength ladder ────────────────────────────────────────────────────
     Lower across the board than before: the layer is now confined to the bright
     upper sky, where overlay bites harder than it did averaged over the whole
     page. Level 1 is the default. */
  .fluid-sky[data-strength='0'] { display: none; }
  .fluid-sky[data-strength='1'] { --fluid-op: 0.30; }
  .fluid-sky[data-strength='2'] { --fluid-op: 0.44; }
  .fluid-sky[data-strength='3'] { --fluid-op: 0.60; }
  .fluid-sky[data-strength='4'] { --fluid-op: 0.82; }

  /* Dark theme: overlay on near-black lifts hard — pull every level back. */
  :global(html[data-theme='dark']) .fluid-sky[data-strength='1'] { --fluid-op: 0.16; }
  :global(html[data-theme='dark']) .fluid-sky[data-strength='2'] { --fluid-op: 0.26; }
  :global(html[data-theme='dark']) .fluid-sky[data-strength='3'] { --fluid-op: 0.38; }
  :global(html[data-theme='dark']) .fluid-sky[data-strength='4'] { --fluid-op: 0.54; }

  /* Live override for the prototype panels. */
  :global(html[data-fluid-strength='0']) .fluid-sky { display: none !important; }
  :global(html[data-fluid-strength='1']) .fluid-sky { --fluid-op: 0.30; }
  :global(html[data-fluid-strength='2']) .fluid-sky { --fluid-op: 0.44; }
  :global(html[data-fluid-strength='3']) .fluid-sky { --fluid-op: 0.60; }
  :global(html[data-fluid-strength='4']) .fluid-sky { --fluid-op: 0.82; }

  /* Layer kill-switch. */
  :global(html[data-fluid='off']) .fluid-sky { display: none; }

  /* Phones: the sky is mostly hidden behind content on a narrow viewport, so the
     layer pays for itself least there. The CSS gradient is the finished state. */
  @media (max-width: 640px) {
    .fluid-sky { display: none; }
  }

  /* ── The only motion: a slow compositor-only drift ───────────────────────
     transform/opacity only, never a repaint of the shader. The still frame is
     the finished composition, so reduced-motion loses nothing. */
  @media (prefers-reduced-motion: no-preference) {
    .fluid-sky.is-atmosphere {
      will-change: transform;
      animation: fluid-drift 68s ease-in-out infinite alternate;
    }
    @keyframes fluid-drift {
      from { transform: translate3d(0, 0, 0) scale(1.04); }
      to   { transform: translate3d(-1.2%, 1.1%, 0) scale(1.10); }
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../lib/motion';

  const VERT = `
    attribute vec2 aPos;
    varying vec2 vUv;
    void main() {
      vUv = aPos * 0.5 + 0.5;
      gl_Position = vec4(aPos, 0.0, 1.0);
    }
  `;

  // Domain-warped fBm (Inigo Quilez's two-level warp), drawn ONCE.
  //
  // Because there is no per-frame budget any more, the quality knobs go back UP:
  // 4 octaves instead of 3, and the sin()-free hash is kept. A single draw of a
  // ~250k-pixel field is negligible, so the earlier tradeoffs (3 octaves, 0.35x
  // scale, 15fps, adaptive throttle) are all obsolete — they existed only to make
  // a continuous loop affordable.
  const FRAG = `
    precision highp float;
    varying vec2 vUv;
    uniform float uAmp;
    uniform float uSeed;

    float hash(vec2 p) {
      p = fract(p * vec2(443.897, 441.423));
      p += dot(p, p + 19.19);
      return fract(p.x * p.y);
    }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i),                 hash(i + vec2(1.0, 0.0)), u.x),
                 mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
    }
    float fbm(vec2 p) {
      float v = 0.0, a = 0.5;
      for (int i = 0; i < 4; i++) { v += a * noise(p); p *= 2.02; a *= 0.5; }
      return v;
    }

    void main() {
      vec2 p = vec2(vUv.x * 3.1, (1.0 - vUv.y) * 3.1) + uSeed;

      // two-level domain warp — what makes it read as viscous ink, not blur
      vec2 q = vec2(fbm(p), fbm(p + vec2(5.2, 1.3)));
      vec2 r = vec2(fbm(p + 2.9 * q + vec2(1.7, 9.2)),
                    fbm(p + 2.9 * q + vec2(8.3, 2.8)));
      float f = fbm(p + 2.6 * r);

      // Stratify: fold the warp field into soft bands. This is the difference
      // between "ink diffusing in water" and "a soft vertical blur".
      float bands = sin((f * 6.2831853) * 1.6 + length(r) * 2.4);
      float strata = smoothstep(-0.65, 0.65, bands);

      float mixed = mix(f, strata, 0.55);
      float m = 0.5 + (mixed - 0.5) * (uAmp * 2.6);

      // warm/cool broken colour along the warp axis — Monet, not grey haze
      float temp = (r.x - r.y) * 0.42 * uAmp;

      gl_FragColor = vec4(
        clamp(m + temp,        0.0, 1.0),
        clamp(m,               0.0, 1.0),
        clamp(m - temp * 1.15, 0.0, 1.0),
        1.0
      );
    }
  `;

  // One teardown per canvas (the ladder page mounts several).
  const teardowns: Array<() => void> = [];

  function initAll(): void {
    while (teardowns.length) teardowns.pop()!();
    document.querySelectorAll<HTMLCanvasElement>('[data-fluid-canvas]').forEach((c) => {
      const t = initOne(c);
      if (t) teardowns.push(t);
    });
  }

  function initOne(cvs: HTMLCanvasElement): (() => void) | null {
    // Nothing to do if CSS has removed the layer (mobile, or strength 0).
    if (getComputedStyle(cvs).display === 'none') return null;

    const gl = (cvs.getContext('webgl', { antialias: false, alpha: true, depth: false })
      || cvs.getContext('experimental-webgl', { antialias: false, alpha: true, depth: false })) as WebGLRenderingContext | null;
    if (!gl) { cvs.style.display = 'none'; return null; }

    function compile(type: number, src: string): WebGLShader | null {
      const sh = gl!.createShader(type);
      if (!sh) return null;
      gl!.shaderSource(sh, src);
      gl!.compileShader(sh);
      if (!gl!.getShaderParameter(sh, gl!.COMPILE_STATUS)) { gl!.deleteShader(sh); return null; }
      return sh;
    }

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) { cvs.style.display = 'none'; return null; }

    const prog = gl.createProgram();
    if (!prog) { cvs.style.display = 'none'; return null; }
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { cvs.style.display = 'none'; return null; }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const uAmp = gl.getUniformLocation(prog, 'uAmp');
    const uSeed = gl.getUniformLocation(prog, 'uSeed');

    const AMP_BY_LEVEL = [0, 0.34, 0.46, 0.72, 1.05];
    function level(): number {
      const live = document.documentElement.dataset.fluidStrength;
      if (live !== undefined) return Number(live);
      return Number(cvs.dataset.strength ?? '1');
    }
    // Each contained rung gets its own slice of the field so the ladder panels
    // aren't five copies of the same picture.
    const seed = cvs.dataset.mode === 'contained' ? level() * 7.3 : 0;
    gl.uniform1f(uSeed, seed);

    // 0.5× internal resolution. Higher than the old 0.35× because a ONE-TIME
    // draw can afford quality; the smooth field still hides the upscale.
    const SCALE = 0.5;

    // Clamp the atmosphere layer to end exactly where the content zone begins.
    // Measured, not computed from vh: 200vh overlapped #mountains by 165px and
    // 186vh by 36px, because Heights carries pb-[12vh] and both sections use
    // min-height. Reading the real offset is the only reliable way, and it keeps
    // working if section heights ever change.
    function fitToContent(): void {
      if (cvs.dataset.mode === 'contained') return;
      const content = document.getElementById('mountains');
      const host = cvs.offsetParent as HTMLElement | null;
      if (!content || !host) return;
      const top = content.getBoundingClientRect().top + window.scrollY;
      const hostTop = host.getBoundingClientRect().top + window.scrollY;
      const h = Math.max(0, Math.round(top - hostTop));
      if (h > 0) cvs.style.height = `${h}px`;
    }

    function draw(): void {
      fitToContent();
      const w = Math.max(1, Math.round(cvs.clientWidth * SCALE));
      const h = Math.max(1, Math.round(cvs.clientHeight * SCALE));
      if (cvs.width !== w || cvs.height !== h) {
        cvs.width = w;
        cvs.height = h;
        gl!.viewport(0, 0, w, h);
      }
      gl!.uniform1f(uAmp, AMP_BY_LEVEL[Math.max(0, Math.min(4, level()))] ?? 0.34);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
    }

    draw();

    // Redraw only on events that actually change the picture — never per frame.
    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(draw, 180);
    };
    window.addEventListener('resize', onResize);

    // The prototype panels flip data-fluid-strength; amplitude is baked into the
    // single draw, so watch for it and redraw once when it changes.
    const mo = new MutationObserver(() => draw());
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-fluid-strength', 'data-theme'] });

    // NOTE: no rAF loop, no IntersectionObserver, no visibilitychange handler —
    // there is no ongoing work to pause. prefersReducedMotion() is consulted only
    // by the CSS drift; the painted frame is identical either way.
    void prefersReducedMotion;

    return () => {
      window.clearTimeout(resizeTimer);
      window.removeEventListener('resize', onResize);
      mo.disconnect();
      gl.deleteBuffer(buf);
      gl.deleteProgram(prog);
      gl.deleteShader(vs);
      gl.deleteShader(fs);
    };
  }

  document.addEventListener('astro:page-load', initAll);
</script>
