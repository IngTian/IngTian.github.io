---
// FluidSky (PROTOTYPE) — a FAITHFUL port of the original demo shader.
//
// ── Why this is a rewrite back to the beginning ───────────────────────────
// The user identified the very first thing I showed (the live WebGL panel in the
// brainstorm synthesis screen) as the correct look, and asked to restart from it.
// I recovered that shader verbatim from
// .superpowers/brainstorm/9818-1785798195/content/synthesis.html and diffed it
// against what I had drifted to. The differences that mattered:
//
//   original (liked)                  what I had (rejected)
//   ────────────────────────────────  ─────────────────────────────────────
//   frequency 1.6x / 2.2y (ANISO)     6.4 isotropic — ~4x too fine
//   warp gains 3.4*q, 3.2*r           2.9*q, 2.6*r — weaker warp
//   NO banding term                   a sin() "strata" fold mixed at 0.5
//   opaque, shader owns the colour     mid-grey modulation + overlay blend
//   5 octaves                          3 octaves
//   displacement 0.46                  drifted
//
// The single worst offender was the sin() BANDING term — I invented it while
// trying to make an under-powered blend visible, and it is what turned soft ink
// diffusion into hard ribbons. It is gone.
//
// A correction to my own earlier description: that demo was NOT compositing over
// --descent-grad. It carried the descent palette as hardcoded stops and drew
// OPAQUELY. The reason it still felt like "the Monet background" is that those
// stops ARE the Monet colours. So this port is opaque too, with the palette
// uploaded as a texture built from the real --descent-grad stops (same colours,
// one source of truth, and it re-themes for dark).
//
// Interaction is deliberately NOT included — dropped on request so the base look
// can be judged on its own. The pointer work is in git history if we return to it.
//
// Perf: viewport-sized (scroll is a uniform, so a 5000px descent still shades
// only one screen), 0.5x internal resolution, ~30fps, paused on tab-hide,
// static finished frame under reduced motion, skipped under 640px.
interface Props {
  /** 0 = plain gradient · 1 subtle · 2 medium · 3 strong · 4 the original demo's own strength */
  strength?: 0 | 1 | 2 | 3 | 4;
  mode?: 'background' | 'contained';
  /**
   * Which sky this page has.
   *
   * 'descent' — the homepage / /art / 404: --descent-grad, the full dawn→ground
   *   ramp that sinks to near-black. Text over it is PAPER-coloured, so the
   *   dangerous direction is the sky getting LIGHTER.
   *
   * 'reading' — /research, /projects: --reading-grad, deliberately luminous
   *   top-to-bottom so DARK ink stays legible the whole way down. The dangerous
   *   direction is therefore INVERTED — the sky getting DARKER. This is not a
   *   cosmetic switch: sampling the descent ramp on a reading page would drag a
   *   pale background down to #16140f underneath dark text.
   */
  variant?: 'descent' | 'reading';
}
const { strength = 4, mode = 'background', variant = 'descent' } = Astro.props;
---
<canvas
  class:list={['fluid-sky', mode === 'contained' ? 'is-contained' : 'is-background']}
  data-fluid-canvas
  aria-hidden="true"
  data-strength={String(strength)}
  data-mode={mode}
  data-variant={variant}
></canvas>

<style>
  .fluid-sky {
    pointer-events: none;
    display: block;
    /* Opaque — the shader owns the colour, exactly as the original demo did.
       No mix-blend-mode: that is also what keeps an animated full-screen layer
       affordable (a blended layer forces the compositor to re-read the page
       backdrop every frame). */
  }

  .fluid-sky.is-background {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;   /* behind SkyWash (-1) and all content */
  }

  .fluid-sky.is-contained {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .fluid-sky[data-strength='0'] { display: none; }
  :global(html[data-fluid-strength='0']) .fluid-sky { display: none !important; }
  :global(html[data-fluid='off']) .fluid-sky { display: none; }

  @media (max-width: 640px) {
    .fluid-sky { display: none; }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../lib/motion';

  const VERT = `
    attribute vec2 aPos;
    varying vec2 vUv;
    void main() {
      vUv = aPos * 0.5 + 0.5;
      gl_Position = vec4(aPos, 0.0, 1.0);
    }
  `;

  // Faithful to the original demo: two-level domain warp (Inigo Quilez), the
  // warped field displaces WHERE along the descent ramp we sample, then a viscous
  // luminance term and a warm bloom. No banding, no strata fold.
  const FRAG = `
    precision highp float;
    varying vec2 vUv;

    uniform sampler2D uRamp;
    uniform float uAmp;
    uniform float uTime;
    uniform float uYOffset;   // scroll, in viewport widths
    uniform float uYSpan;     // viewport height, in viewport widths
    uniform float uDepth0;    // page depth at the top of the viewport
    uniform float uDepthSpan; // page depth spanned by one viewport
    uniform float uGateTop;   // depth where the reading zone begins
    uniform float uDark;      // 1.0 in the dark theme, 0.0 in light
    uniform vec3  uNebula;    // the cool tint dark theme lifts the ink with
    uniform float uReading;   // 1.0 on a reading page (dark ink on pale paper)
    uniform float uReadCap;   // reading pages: max darkward ramp excursion

    float hash(vec2 p) {
      p = fract(p * vec2(443.897, 441.423));
      p += dot(p, p + 19.19);
      return fract(p.x * p.y);
    }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i),                 hash(i + vec2(1.0, 0.0)), u.x),
                 mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
    }
    // 5 octaves, as the original. (I had cut this to 3 to afford a blended loop;
    // opaque compositing pays for the detail back.)
    float fbm(vec2 p) {
      float v = 0.0, a = 0.5;
      for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.02; a *= 0.5; }
      return v;
    }

    void main() {
      float t = uTime;

      // ANISOTROPIC sample space — more frequency DOWN than ACROSS, which is what
      // stretches the field into drifting strata instead of round blobs.
      //
      // SCALE BUG FIXED HERE. I copied the original demo's 1.6 / 2.2 verbatim, but
      // the demo drew into a 373x250 PANEL while this fills a ~1440x900 viewport.
      // Measured in noise-units per on-screen pixel:
      //     demo  0.00429 horiz / 0.00880 vert
      //     mine  0.00111 horiz / 0.00153 vert
      // so every feature came out 3.9x too large across and 5.8x too tall — one
      // enormous smear per screen, which is exactly why it read as "no difference".
      // 6.2 / 12.7 reproduce the demo's on-screen feature SIZE at viewport scale.
      float sy = uYOffset + (1.0 - vUv.y) * uYSpan;
      vec2 p = vec2(vUv.x * 6.2, sy * 12.7);

      // ── two-level domain warp (Inigo Quilez) — the original gains ──
      vec2 q = vec2(fbm(p + 0.09 * t),
                    fbm(p + vec2(5.2, 1.3) - 0.07 * t));
      vec2 r = vec2(fbm(p + 3.4 * q + vec2(1.7, 9.2) + 0.055 * t),
                    fbm(p + 3.4 * q + vec2(8.3, 2.8) - 0.048 * t));
      float f = fbm(p + 3.2 * r);

      // page depth of this pixel (0 = dawn, 1 = ground)
      float depth = clamp(uDepth0 + (1.0 - vUv.y) * uDepthSpan, 0.0, 1.0);

      // ── LEGIBILITY GATE, rewritten ──────────────────────────────────────
      // The old gate was 1 - 0.86*smoothstep(gateTop, gateTop+0.06, depth),
      // which pinned displacement to 14% over the whole content zone. Measured in
      // ramp units that left 0.057 — under HALF a palette band — so Mountains got
      // neither clean colour nor real ink, just a faint mottled mush. That is the
      // "weird" background.
      //
      // The insight: what threatens text is not displacement per se, it is
      // displacement that DARKENS the sky toward the paper-coloured text. Pulling
      // the sample point UP the ramp (toward lighter dawn colours) is harmless
      // here — the text is light, so a lighter background is what hurts, and a
      // DARKER one actually helps.
      //
      // So instead of one scalar clamp, the gate is now ASYMMETRIC: over the
      // reading zone the ink may still swing generously toward the dark end while
      // its lightward excursion is limited. Full ink character, contrast intact.
      // On a reading page the entire page is a reading zone (text runs top to
      // bottom), so the gate is fully engaged everywhere rather than fading in at a
      // content boundary.
      float zone = mix(smoothstep(uGateTop, uGateTop + 0.10, depth), 1.0, uReading);
      // ── The asymmetry INVERTS by page archetype ─────────────────────────
      // Descent pages carry PAPER-coloured text, so a LIGHTER sky is what erases it
      // and the dark direction is free. Reading pages carry DARK INK on pale paper,
      // so the danger is exactly reversed: a DARKER sky erases the ink, and the
      // light direction is the safe one. Copy-pasting the descent gate onto a
      // reading page would clamp the safe direction and free the dangerous one.
      float gateDark  = mix(1.0 - 0.25 * zone, 1.0 - 0.30 * zone, uReading);
      // Toward the dawn: 0.90, not 0.72. In LIGHT theme the content zone carries
      // paper-coloured text on grey ink, and the lightward swing was bright enough
      // that the text nearly dissolved into the sky. Only the LIGHT direction is
      // clamped harder; the dark direction stays free, so the ink keeps its
      // character (that was the point of making the gate asymmetric).
      float gateLight = mix(1.0 - 0.90 * zone, 1.0 - 0.25 * zone, uReading);

      // Perturb WHERE along the descent this pixel samples → marbled strata.
      //
      // The OTHER half of the "no difference" bug. The demo panel showed the
      // ENTIRE dawn→ground ramp in 250px, so its 0.46 displacement swung across
      // several colour bands. A real viewport at the top of the page spans only
      // depth 0.00–0.19 — all cream — so the same 0.46 never left the cream band
      // and produced almost no visible change.
      //
      // Fix: displace in units of the RAMP, not of the local viewport window. 0.34
      // is ~1.8 palette bands, so the ink genuinely carries taupe and slate up into
      // the dawn the way it did in the panel.
      float raw = (f - 0.5) * 0.34 * uAmp;
      // positive raw = deeper down the ramp (darker) → the permissive direction
      float disp = raw > 0.0 ? raw * gateDark : raw * gateLight;

      // ── TOP-OF-RAMP BIAS — why the hero looked flat ─────────────────────
      // Measured luminance of the light ramp's top stops:
      //     0.00 #f4efe4  0.938
      //     0.08 #f0eadf  0.920
      //     0.15 #efe6d4  0.904
      // A hero viewport spans depth 0.00–0.19, i.e. a luminance range of just
      // 0.034 — versus 0.336 across 0.23–0.44. So identical displacement shows
      // ~10x less in the hero: symmetric swings inside four near-identical creams
      // have almost nothing to reveal, which is exactly the "no fluid in light
      // theme" report (dusk was rich, the hero was flat).
      //
      // Fix: near the top, bias the excursion DOWNWARD so the ink can actually
      // reach taupe and slate instead of oscillating within cream. Fades out by
      // depth ~0.30, where the ramp has its own contrast and needs no help.
      float topLift = 1.0 - smoothstep(0.02, 0.30, depth);
      disp += 0.5 * abs(raw) * topLift;

      float y = clamp(depth + disp, 0.0, 1.0);

      // HARD FLOOR over the reading zone: the sampled point may never sit higher
      // (lighter) on the ramp than the gradient's own value there. A guarantee
      // rather than a tuning — it makes "the content zone never gets brighter than
      // the shipped sky" true by construction, which is what keeps the
      // paper-coloured text readable no matter how the field swings.
      // Hard guarantee, direction chosen per archetype.
      //
      //   descent → never sample LIGHTER than the gradient (protects paper text)
      //   reading → never sample MORE THAN uReadCap DEEPER than the gradient
      //
      // BUG FIXED HERE: the reading branch used min(y, depth), which forbade ANY
      // darkward move. Combined with gateDark already at 0.10 that clamped the
      // effect to exactly zero — hence "no fluid at all" on /research. And the
      // lightward direction has nowhere to go either, because the reading ramp
      // starts at L=0.938 (near-white). So the reading variant had no usable
      // direction whatsoever.
      //
      // Measured headroom says a bounded darkward move is safe: paper L=0.938 vs
      // --ink-1 L=0.079 is 7.7:1, and darkening the sky to L=0.80 still leaves
      // 6.6:1 — comfortably past the 4.5:1 body-text floor. So allow the ink to
      // sink, just not far.
      float readGuard = min(y, depth + uReadCap);
      float guarded = mix(max(y, depth), readGuard, uReading);
      y = mix(y, guarded, zone);

      vec3 col = texture2D(uRamp, vec2(0.5, y)).rgb;

      // Viscous luminance banding straight from the warp field (original). Over
      // the reading zone, bias it DARKWARD instead of symmetric: same viscous
      // character, but it can only help light text.
      float lum = 0.90 + 0.20 * f;
      col *= mix(lum, 0.86 + 0.14 * f, zone);
      // Warm bloom where the warp piles up (original) — faded out over the reading
      // zone, since it lightens.
      col += 0.045 * vec3(0.784, 0.639, 0.416) * smoothstep(0.55, 1.0, length(r)) * (1.0 - zone) * (1.0 - uReading);

      // ── DARK THEME needs a DIFFERENT MECHANISM, not more strength ────────
      // Measured luminance range of the two ramps:
      //     light  0.938 → 0.079   range 0.860
      //     dark   0.097 → 0.035   range 0.062   ← 13.9x smaller
      // Displacing along six stops of near-black cannot reveal anything, which is
      // why dark theme read as "less visible". Raising uAmp does nothing: the
      // palette has no contrast to expose.
      //
      // So in dark theme the field ADDS light instead of relocating it — a cool
      // phosphor/cyan nebular tint lifted by the warp, which is the same
      // vocabulary as the dark theme's existing atmosphere washes. The terrain's
      // dots still read as the star field; this becomes the nebula behind them.
      if (uDark > 0.5 && uReading < 0.5) {
        float glow = smoothstep(0.30, 0.95, f);          // where the ink piles up
        float veins = smoothstep(0.45, 1.0, length(r));  // along the warp filaments
        float lift = (glow * 0.72 + veins * 0.45) * uAmp;
        // damped over the reading zone: adding light is the dangerous direction
        // there, since the text is light too.
        lift *= 1.0 - 0.72 * zone;
        col += uNebula * lift;

        // ── STARS ────────────────────────────────────────────────────────
        // The dark theme is already the "terminal galaxy" where the terrain's dots
        // read as a star field; this puts real stars in the nebula BEHIND them,
        // strongest over the content zone (the deep sky) where the nebula itself
        // is damped — so the reading zone gains character without gaining haze.
        //
        // Real stars are not white: colour tracks temperature (O/B blue-white →
        // A white → K/M amber), so each star draws its tint from its own hash. A
        // touch of violet is included because that is what the eye reads as
        // "deep space" even though few stars are literally violet.
        // Star lattice in PAGE space (x across the viewport, y including scroll),
        // so stars are pinned to the sky and scroll with it rather than sliding.
        // NOTE: this shader has no sp vec2 — the vertical page coordinate is the
        // float sy. Using sp here was a copy-paste from an earlier revision and
        // failed to compile (undeclared identifier), which silently hid the canvas.
        // (Reminder: NEVER use backticks in this file's comments — the shader is a
        // template literal, so a backtick terminates it and breaks the build.)
        vec2 starUv = vec2(vUv.x, sy);
        vec2 cell = floor(starUv * 96.0);
        vec2 sub = fract(starUv * 96.0);
        float pick = hash(cell);
        // ~7% of cells hold a star. The lattice is 96 (was 34): a finer grid with a
        // lower hit rate gives POINTS at real star density, where the coarse grid
        // made a few large orbs.
        if (pick > 0.93) {
          vec2 jitter = vec2(hash(cell + 3.7), hash(cell + 9.1));
          float d = length(sub - jitter);
          // tiny hard core + soft halo
          // tight core + faint halo — a star is a point source with a little bloom
          float core = smoothstep(0.055, 0.0, d);
          float halo = smoothstep(0.20, 0.0, d) * 0.16;

          // TWINKLE: two out-of-phase sines per star, so no two blink together
          // and the field never pulses in unison.
          float ph = hash(cell + 17.3) * 6.2831853;
          float sp2 = 0.55 + hash(cell + 23.9) * 1.5;
          float tw = 0.55 + 0.45 * sin(uTime * sp2 + ph)
                          * (0.6 + 0.4 * sin(uTime * sp2 * 0.37 + ph * 2.1));

          // stellar colour by "temperature"
          float temp2 = hash(cell + 41.7);
          vec3 tint = temp2 < 0.34
            ? mix(vec3(0.62, 0.74, 1.00), vec3(0.86, 0.92, 1.00), temp2 / 0.34)   // blue-white
            : (temp2 < 0.72
              ? vec3(0.97, 0.97, 1.00)                                            // white
              : mix(vec3(0.80, 0.72, 1.00), vec3(1.00, 0.86, 0.72), (temp2 - 0.72) / 0.28)); // violet → amber

          // ── Confined to the TAGLINE band ────────────────────────────────
          // Previously smoothstep(0.18, 0.55, depth), which put stars across the
          // whole lower half — too much. Stars now live in a narrow window centred
          // on the Interlude ("A researcher by day, an artist by night, and a
          // mathematician at heart"), which sits at roughly depth 0.16-0.22, and
          // fade out on both sides. They read as a moment at the line rather than
          // as a texture over the page.
          float band = smoothstep(0.10, 0.17, depth) * (1.0 - smoothstep(0.24, 0.36, depth));
          col += tint * (core * 1.05 + halo) * tw * band;
        }
      }

      gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
    }
  `;

  // The real --descent-grad stops (tokens.css) and its dark twin. The original
  // demo hardcoded an abbreviated 6-stop version of the same ramp; using the full
  // token stops keeps one source of truth and gives dark theme for free.
  const LIGHT_STOPS: Array<[number, string]> = [
    [0.00, '#f4efe4'], [0.08, '#f0eadf'], [0.15, '#efe6d4'], [0.23, '#e2d2c2'],
    [0.30, '#ccc4b6'], [0.37, '#a6a8ad'], [0.44, '#7d7e88'], [0.52, '#565660'],
    [0.62, '#3a3833'], [0.78, '#2a2720'], [0.90, '#1d1b16'], [1.00, '#16140f'],
  ];
  // READING pages (/research, /projects) mirror --reading-grad from tokens.css:
  // luminous top-to-bottom, never sinking to the ground, so dark ink stays legible.
  // Its luminance range is TINY by design (0.938 → ~0.83), which is exactly why the
  // reading variant leans on texture and temperature rather than value swings.
  const READING_LIGHT_STOPS: Array<[number, string]> = [
    [0.00, '#f4efe4'], [0.24, '#f1ebe0'], [0.48, '#efe6d4'],
    [0.74, '#e7ddce'], [1.00, '#dcd5cf'],
  ];
  const READING_DARK_STOPS: Array<[number, string]> = [
    [0.00, '#14171b'], [0.48, '#131619'], [1.00, '#111417'],
  ];

  const DARK_STOPS: Array<[number, string]> = [
    [0.00, '#16191d'], [0.20, '#131619'], [0.40, '#111417'],
    [0.60, '#0e1013'], [0.80, '#0b0d0f'], [1.00, '#08090b'],
  ];

  // Raised again on request ("i remember the one to be more stronger"). Rung 4 is
  // now well past the original demo's own strength — the asymmetric gate means the
  // reading zone no longer pays for a stronger open sky.
  const AMP_BY_LEVEL = [0, 0.7, 1.0, 1.35, 1.8];

  const teardowns: Array<() => void> = [];

  function initAll(): void {
    while (teardowns.length) teardowns.pop()!();
    document.querySelectorAll<HTMLCanvasElement>('[data-fluid-canvas]').forEach((c) => {
      const t = initOne(c);
      if (t) teardowns.push(t);
    });
  }

  function buildRamp(dark: boolean, variantOf: () => boolean): HTMLCanvasElement | null {
    const N = 512;
    const c = document.createElement('canvas');
    c.width = 1;
    c.height = N;
    const ctx = c.getContext('2d');
    if (!ctx) return null;
    const g = ctx.createLinearGradient(0, 0, 0, N);
    const reading = variantOf();
    const stops = reading
      ? (dark ? READING_DARK_STOPS : READING_LIGHT_STOPS)
      : (dark ? DARK_STOPS : LIGHT_STOPS);
    for (const [pos, hex] of stops) g.addColorStop(pos, hex);
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 1, N);
    return c;
  }

  function initOne(cvs: HTMLCanvasElement): (() => void) | null {
    if (getComputedStyle(cvs).display === 'none') return null;

    const gl = (cvs.getContext('webgl', { antialias: false, alpha: false, depth: false })
      || cvs.getContext('experimental-webgl', { antialias: false, alpha: false, depth: false })) as WebGLRenderingContext | null;
    if (!gl) { cvs.style.display = 'none'; return null; }

    function compile(type: number, src: string): WebGLShader | null {
      const sh = gl!.createShader(type);
      if (!sh) return null;
      gl!.shaderSource(sh, src);
      gl!.compileShader(sh);
      if (!gl!.getShaderParameter(sh, gl!.COMPILE_STATUS)) { gl!.deleteShader(sh); return null; }
      return sh;
    }

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) { cvs.style.display = 'none'; return null; }

    const prog = gl.createProgram();
    if (!prog) { cvs.style.display = 'none'; return null; }
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { cvs.style.display = 'none'; return null; }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const U = {
      ramp: gl.getUniformLocation(prog, 'uRamp'),
      amp: gl.getUniformLocation(prog, 'uAmp'),
      time: gl.getUniformLocation(prog, 'uTime'),
      yOff: gl.getUniformLocation(prog, 'uYOffset'),
      ySpan: gl.getUniformLocation(prog, 'uYSpan'),
      d0: gl.getUniformLocation(prog, 'uDepth0'),
      dSpan: gl.getUniformLocation(prog, 'uDepthSpan'),
      gate: gl.getUniformLocation(prog, 'uGateTop'),
      dark: gl.getUniformLocation(prog, 'uDark'),
      nebula: gl.getUniformLocation(prog, 'uNebula'),
      reading: gl.getUniformLocation(prog, 'uReading'),
      readCap: gl.getUniformLocation(prog, 'uReadCap'),
    };

    const tex = gl.createTexture();
    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);

    // Declared BEFORE uploadRamp's first call: reading it from inside buildRamp
    // while it was still declared further down threw a temporal-dead-zone
    // ReferenceError, which aborted init — the canvas mounted but never painted
    // (live=false on every page). A JS throw here looks identical to a shader
    // failure from the outside, so check both.
    const isReading = cvs.dataset.variant === 'reading';
    let rampTheme = '';
    function uploadRamp(force = false): void {
      const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      if (!force && theme === rampTheme) return;
      rampTheme = theme;
      const ramp = buildRamp(theme === 'dark', () => isReading);
      if (!ramp) return;
      gl!.activeTexture(gl!.TEXTURE0);
      gl!.bindTexture(gl!.TEXTURE_2D, tex);
      gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RGBA, gl!.RGBA, gl!.UNSIGNED_BYTE, ramp);
      gl!.uniform1i(U.ramp, 0);
    }
    uploadRamp(true);

    const contained = cvs.dataset.mode === 'contained';

    function level(): number {
      const live = document.documentElement.dataset.fluidStrength;
      if (live !== undefined) return Number(live);
      return Number(cvs.dataset.strength ?? '4');
    }

    let gateTop = 0.55;
    function measureGate(): void {
      if (contained) { gateTop = 1.0; return; }
      // Reading pages have no #mountains — they ARE text top-to-bottom, so the gate
      // starts at the very top. (uReading also forces zone=1 in the shader; this
      // keeps the two consistent rather than relying on one of them.)
      if (isReading) { gateTop = 0.0; return; }
      const content = document.getElementById('mountains');
      if (!content) { gateTop = 0.55; return; }
      const top = content.getBoundingClientRect().top + window.scrollY;
      gateTop = Math.min(0.95, Math.max(0.1, top / Math.max(1, document.documentElement.scrollHeight)));
    }
    measureGate();

    const SCALE = 0.5;
    // clientWidth/clientHeight are also layout reads, so they are resolved only
    // when the size actually changes (resize / settle), not per frame.
    let sizedW = 0;
    let sizedH = 0;
    function sizeTo(force = false): void {
      if (!force && sizedW && sizedH) {
        gl!.viewport(0, 0, sizedW, sizedH);
        return;
      }
      const w = Math.max(1, Math.round((cvs.clientWidth || 1) * SCALE));
      const h = Math.max(1, Math.round((cvs.clientHeight || 1) * SCALE));
      if (cvs.width !== w || cvs.height !== h) { cvs.width = w; cvs.height = h; }
      sizedW = cvs.width;
      sizedH = cvs.height;
      gl!.viewport(0, 0, sizedW, sizedH);
    }

    // ── Cached layout metrics — the SCROLL-LAG fix ──────────────────────────
    // draw() used to read document.documentElement.scrollHeight (and innerWidth /
    // innerHeight) on EVERY frame. scrollHeight is a forced synchronous layout:
    // the browser must flush pending style/layout work before it can answer. At
    // ~30fps that is 30 reflows/sec, and it is worst exactly while scrolling,
    // when layout is already dirty — the classic cause of scroll jank.
    //
    // These change only on resize / layout settle, never during a scroll, so they
    // are cached and refreshed from the same places that re-measure the gate.
    let mVw = Math.max(1, window.innerWidth);
    let mVh = Math.max(1, window.innerHeight);
    let mDocH = Math.max(1, document.documentElement.scrollHeight);
    function measureLayout(): void {
      mVw = Math.max(1, window.innerWidth);
      mVh = Math.max(1, window.innerHeight);
      mDocH = Math.max(1, document.documentElement.scrollHeight);
    }

    const t0 = performance.now();
    function draw(nowMs: number): void {
      sizeTo();
      uploadRamp();

      const vw = mVw;
      const vh = mVh;
      const docH = mDocH;

      if (contained) {
        gl!.uniform1f(U.yOff, level() * 2.0);
        gl!.uniform1f(U.ySpan, (cvs.clientHeight || vh) / (cvs.clientWidth || vw));
        gl!.uniform1f(U.d0, 0.0);
        gl!.uniform1f(U.dSpan, 1.0);
      } else {
        gl!.uniform1f(U.yOff, window.scrollY / vw);
        gl!.uniform1f(U.ySpan, vh / vw);
        gl!.uniform1f(U.d0, window.scrollY / docH);
        gl!.uniform1f(U.dSpan, vh / docH);
      }

      gl!.uniform1f(U.amp, AMP_BY_LEVEL[Math.max(0, Math.min(4, level()))] ?? 1.0);
      const isDark = document.documentElement.dataset.theme === 'dark';
      gl!.uniform1f(U.dark, isDark ? 1 : 0);
      // Cool phosphor-cyan, between the dark theme's --ochre (#66c28c emerald) and
      // --indigo (#5fb2c9 cyan) — the palette this theme already uses for its
      // atmosphere. Low magnitude: it is a nebula, not a light show.
      gl!.uniform3f(U.nebula, 0.055, 0.105, 0.115);
      gl!.uniform1f(U.reading, isReading ? 1 : 0);
      // How far a reading page's sky may sink below its own gradient value, in ramp
      // units. 0.34 lands the darkest excursion near L~0.80, which still measures
      // 6.6:1 against --ink-1 (floor is 4.5:1). Bounded on purpose: this is the one
      // number keeping body text safe on /research and /projects.
      gl!.uniform1f(U.readCap, 0.34);
      gl!.uniform1f(U.gate, gateTop);
      gl!.uniform1f(U.time, (nowMs - t0) / 1000);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
    }

    // first frame — also the reduced-motion / pre-loop state. Force a real
    // measure once here; after this the cached metrics carry every frame.
    sizeTo(true);
    draw(performance.now());

    // Signal a real paint so the page can drop the CSS gradient underneath this
    // opaque canvas. Set only AFTER a successful draw, so every failure path (no
    // WebGL, shader compile fail) falls back to the shipped gradient.
    if (!contained) cvs.closest('.descent')?.classList.add('fluid-live');

    const reduce = prefersReducedMotion();

    let rafId = 0;
    let running = false;
    let last = 0;
    // true while a scroll gesture is in progress → draw at full display rate
    let scrolling = false;

    function loop(now: number): void {
      // ── Frame pacing, and why scrolling looked laggy ────────────────────
      // The remaining "lag" was not slowness — it was a FRAME-RATE MISMATCH. The
      // page scrolls at the display's 60fps while this canvas redrew at 30fps, and
      // the sky's vertical position is scroll-derived, so during a scroll the
      // background trailed the content by up to 32ms. The eye reads that as the
      // background stuttering against the text.
      //
      // Fix: while scrolling, draw EVERY frame so the sky is locked to the content.
      // When the page is still, fall back to 30fps — the ink drift is slow enough
      // that nobody can tell, and it halves idle cost.
      const budget = scrolling ? 0 : 32;
      if (now - last >= budget) { draw(now); last = now; }
      rafId = requestAnimationFrame(loop);
    }
    function start(): void {
      if (running || reduce || document.hidden) return;
      running = true; last = 0;
      rafId = requestAnimationFrame(loop);
    }
    function stop(): void {
      if (!running) return;
      running = false;
      cancelAnimationFrame(rafId);
      rafId = 0;
    }

    const onVis = () => { if (document.hidden) stop(); else start(); };
    document.addEventListener('visibilitychange', onVis);

    // Frozen state still needs a repaint on scroll (the depth window is
    // scroll-derived) or it would look like a stuck decal.
    // The scrolling flag stays true for a moment after the last scroll event, so the
    // full-rate window covers the whole gesture including momentum/inertia.
    let scrollRaf = 0;
    let scrollIdleT = 0;
    const onScroll = () => {
      scrolling = true;
      window.clearTimeout(scrollIdleT);
      scrollIdleT = window.setTimeout(() => { scrolling = false; }, 160);
      // Under reduced motion there is no loop, so a scroll still needs one repaint
      // (the sky's depth window is scroll-derived and would otherwise be stale).
      if (reduce && !scrollRaf) {
        scrollRaf = requestAnimationFrame(() => { scrollRaf = 0; draw(performance.now()); });
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    let resizeT = 0;
    const onResize = () => {
      window.clearTimeout(resizeT);
      resizeT = window.setTimeout(() => { sizeTo(true); measureLayout(); measureGate(); draw(performance.now()); }, 160);
    };
    window.addEventListener('resize', onResize);

    const mo = new MutationObserver(() => { uploadRamp(true); draw(performance.now()); });
    mo.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-fluid-strength', 'data-theme'],
    });

    const settle = window.setTimeout(() => { sizeTo(true); measureLayout(); measureGate(); draw(performance.now()); }, 1200);

    start();

    return () => {
      stop();
      window.clearTimeout(resizeT);
      window.clearTimeout(settle);
      if (scrollRaf) cancelAnimationFrame(scrollRaf);
      window.clearTimeout(scrollIdleT);
      document.removeEventListener('visibilitychange', onVis);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      mo.disconnect();
      cvs.closest('.descent')?.classList.remove('fluid-live');
      gl.deleteTexture(tex);
      gl.deleteBuffer(buf);
      gl.deleteProgram(prog);
      gl.deleteShader(vs);
      gl.deleteShader(fs);
    };
  }

  document.addEventListener('astro:page-load', initAll);
</script>
