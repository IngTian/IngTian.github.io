---
// FluidSky (PROTOTYPE) — the Monet sky, made to FLOW.
//
// The load-bearing decision: this does NOT replace --descent-grad. The tuned
// gradient stays the single source of truth for the sky's colour story; this
// canvas rides OVER it as a low-amplitude MODULATION via mix-blend-mode:
// soft-light. The shader centres its output on mid-grey, and soft-light over
// mid-grey is a no-op — so where the field is neutral the Monet palette shows
// through byte-identical, and where it isn't, the sky flows lighter/darker with
// a whisper of warm/cool temperature swing (Monet broken colour, not grey haze).
//
// Consequences of "combine" over "replace":
//   · the palette can't drift — we never re-author the colours
//   · both themes work for free (the gradient already re-themes itself)
//   · if WebGL is missing the page is EXACTLY today's site, finished-looking
//
// Scroll-coupled: page position feeds a uniform so the strata slide past as you
// descend — the descent metaphor survives.
//
// Perf: 0.5× internal resolution (smooth noise hides it), ~30fps, paused
// offscreen AND on tab-hide, one static frame painted first, full GL teardown
// on astro:page-load re-init (TerrainHero's lifecycle pattern).
//
// STRENGTH is a live variable (html[data-fluid-strength]) because the first tune
// landed BELOW the perceptual threshold: measured mean Δ was 2.5/255 in the
// content zone (≈1.5% of pixels changed by >8) — invisible. Calibrating from
// invisible is impossible, so the levels are exposed for A/B.
interface Props {
  /** 0 = off · 1 subtle · 2 medium · 3 strong · 4 too-much (the ceiling) */
  strength?: 0 | 1 | 2 | 3 | 4;
  /**
   * `fixed` (default) — one sky for the whole page, scroll carried by a uniform.
   * `contained` — absolute inside the nearest positioned ancestor, for the
   * ladder page where SEVERAL independent skies must coexist. Required because
   * position:fixed took every rung's canvas out of flow: all five covered the
   * whole viewport and only the last-painted one was visible, so the per-rung
   * ladder measurements were meaningless (identical numbers across levels).
   */
  mode?: 'fixed' | 'contained';
}
const { strength = 2, mode = 'fixed' } = Astro.props;
---
<canvas
  class:list={['fluid-sky', mode === 'contained' && 'is-contained']}
  id={mode === 'fixed' ? 'fluid-sky' : undefined}
  data-fluid-canvas
  aria-hidden="true"
  data-strength={String(strength)}
  data-mode={mode}
></canvas>

<style>
  /* position:fixed + z-index:-1 INSIDE main.descent — negative-z children paint
     above the parent's own background (the gradient) but below all content, the
     same slot SkyWash uses. Fixed (not absolute) keeps the canvas viewport-sized
     instead of page-sized; scroll is carried by a uniform instead. */
  .fluid-sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: block;
  }
  /* contained: stays inside its rung instead of covering the viewport */
  .fluid-sky.is-contained {
    position: absolute;
    /* overlay, not soft-light — see the ladder comment below for the measurement
       that forced this change. */
    mix-blend-mode: overlay;
    opacity: var(--fluid-op, 0.48);
  }

  /* ── The strength ladder ────────────────────────────────────────────────
     ALL levels now use `overlay`, not soft-light. soft-light against a
     near-neutral source is mathematically close to an identity op, which is what
     made levels 1–3 measure 0.3–0.5/255 (invisible) while level 4 — the only one
     that had already been switched to overlay — measured 51. Same blend at every
     rung is what makes the ladder monotonic instead of a cliff. */
  .fluid-sky[data-strength='0'] { display: none; }
  .fluid-sky[data-strength='1'] { --fluid-op: 0.30; }
  .fluid-sky[data-strength='2'] { --fluid-op: 0.48; }
  .fluid-sky[data-strength='3'] { --fluid-op: 0.68; }
  .fluid-sky[data-strength='4'] { --fluid-op: 0.90; }

  /* Dark theme is a charcoal void — overlay on near-black lifts hard, so every
     level pulls back. */
  :global(html[data-theme='dark']) .fluid-sky[data-strength='1'] { --fluid-op: 0.18; }
  :global(html[data-theme='dark']) .fluid-sky[data-strength='2'] { --fluid-op: 0.30; }
  :global(html[data-theme='dark']) .fluid-sky[data-strength='3'] { --fluid-op: 0.44; }
  :global(html[data-theme='dark']) .fluid-sky[data-strength='4'] { --fluid-op: 0.62; }

  /* Live override from the ladder UI, so a level can be flipped without a reload.
     BUG FIXED HERE: these rules used to also set `display:block`, which beat the
     [data-strength='0'] { display:none } rule on specificity — so "level 0" was
     never actually OFF, and every ladder measurement was taken against a
     fluid-on baseline. Only the OFF rule touches display now. */
  :global(html[data-fluid-strength='0']) .fluid-sky { display: none !important; }
  :global(html[data-fluid-strength='1']) .fluid-sky { --fluid-op: 0.30; }
  :global(html[data-fluid-strength='2']) .fluid-sky { --fluid-op: 0.48; }
  :global(html[data-fluid-strength='3']) .fluid-sky { --fluid-op: 0.68; }
  :global(html[data-fluid-strength='4']) .fluid-sky { --fluid-op: 0.90; }

  /* Layer kill-switch for A/B-ing in the prototype. */
  :global(html[data-fluid='off']) .fluid-sky { display: none; }
</style>

<script>
  import { prefersReducedMotion } from '../../lib/motion';

  const VERT = `
    attribute vec2 aPos;
    varying vec2 vUv;
    void main() {
      vUv = aPos * 0.5 + 0.5;
      gl_Position = vec4(aPos, 0.0, 1.0);
    }
  `;

  // Domain-warped fBm (Inigo Quilez's two-level warp). The output is a
  // MODULATION centred on 0.5, not a colour — see the component comment.
  const FRAG = `
    precision highp float;
    varying vec2 vUv;
    uniform float uTime;
    uniform float uScroll;
    uniform float uAmp;

    float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i),               hash(i + vec2(1.0, 0.0)), u.x),
                 mix(hash(i + vec2(0.0,1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
    }
    float fbm(vec2 p) {
      float v = 0.0, a = 0.5;
      for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.02; a *= 0.5; }
      return v;
    }

    void main() {
      // uScroll shifts the sampled window so strata slide past as you descend.
      // Frequency raised from 1.45 after the A/B: the low-frequency version made
      // a few big blobs that read as smudged glass over the content zone. Finer
      // strata read as ink diffusing in water — which is the actual reference.
      vec2 p = vec2(vUv.x * 3.1, (1.0 - vUv.y + uScroll) * 3.1);

      // two-level domain warp — this is what makes it read as viscous ink
      vec2 q = vec2(fbm(p + 0.052 * uTime),
                    fbm(p + vec2(5.2, 1.3) - 0.040 * uTime));
      vec2 r = vec2(fbm(p + 2.9 * q + vec2(1.7, 9.2) + 0.030 * uTime),
                    fbm(p + 2.9 * q + vec2(8.3, 2.8) - 0.025 * uTime));
      float f = fbm(p + 2.6 * r);

      // ── Why this is not a grey field any more ───────────────────────────
      // The first implementation emitted 0.5 + (f-0.5)*amp and composited with
      // soft-light. Centring on mid-grey made the blend a near-identity, so the
      // warp field barely reached the page: measured Δ was 0.3–0.5/255 across
      // levels 1–3 (invisible), then jumped to 51 at level 4 — a 110× cliff
      // between adjacent levels, which is the signature of an effect that isn't
      // actually compositing. Tuning opacity could never fix that.
      //
      // Now the field drives CONTRAST and TEMPERATURE with real range, and the
      // strata come from banding the warp field rather than from luminance
      // wobble. Output still averages ~0.5 so the Monet gradient is preserved on
      // average, but locally it has enough amplitude to be seen.

      // Stratify: fold the warp field into soft bands — this is what reads as
      // ink diffusing in water rather than as a soft vertical blur.
      float bands = sin((f * 6.2831853) * 1.6 + length(r) * 2.4);
      float strata = smoothstep(-0.65, 0.65, bands);

      // combine the raw field with the banding, then push contrast by amplitude
      float mix1 = mix(f, strata, 0.55);
      float m = 0.5 + (mix1 - 0.5) * (uAmp * 2.6);

      // warm/cool broken colour along the warp axis, scaled with amplitude
      float temp = (r.x - r.y) * 0.42 * uAmp;

      gl_FragColor = vec4(
        clamp(m + temp,        0.0, 1.0),
        clamp(m,               0.0, 1.0),
        clamp(m - temp * 1.15, 0.0, 1.0),
        1.0
      );
    }
  `;

  // One teardown per canvas — the ladder page mounts several independent skies,
  // so a single module-level handle would leak all but the last.
  const teardowns: Array<() => void> = [];

  function initAll(): void {
    while (teardowns.length) teardowns.pop()!();
    const all = document.querySelectorAll<HTMLCanvasElement>('[data-fluid-canvas]');
    all.forEach((c) => {
      const t = initOne(c);
      if (t) teardowns.push(t);
    });
  }

  function initOne(cvs: HTMLCanvasElement): (() => void) | null {

    const gl = (cvs.getContext('webgl', { antialias: false, alpha: true, depth: false })
      || cvs.getContext('experimental-webgl', { antialias: false, alpha: true, depth: false })) as WebGLRenderingContext | null;
    // No WebGL → hide the layer entirely. The page falls back to today's site.
    if (!gl) { cvs.style.display = 'none'; return null; }

    function compile(type: number, src: string): WebGLShader | null {
      const sh = gl!.createShader(type);
      if (!sh) return null;
      gl!.shaderSource(sh, src);
      gl!.compileShader(sh);
      if (!gl!.getShaderParameter(sh, gl!.COMPILE_STATUS)) {
        gl!.deleteShader(sh);
        return null;
      }
      return sh;
    }

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) { cvs.style.display = 'none'; return null; }

    const prog = gl.createProgram();
    if (!prog) { cvs.style.display = 'none'; return null; }
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { cvs.style.display = 'none'; return null; }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const uTime = gl.getUniformLocation(prog, 'uTime');
    const uScroll = gl.getUniformLocation(prog, 'uScroll');
    const uAmp = gl.getUniformLocation(prog, 'uAmp');

    // Amplitude — how far the sky may deviate from the tuned gradient. This is
    // the OTHER half of strength: opacity alone can't reach the ceiling, because
    // a low-amplitude field faded up just looks like flat grey. Amplitude is
    // what makes the strata legible as strata.
    const AMP_BY_LEVEL = [0, 0.30, 0.40, 0.78, 1.15];
    function ampFor(level: number): number {
      return AMP_BY_LEVEL[Math.max(0, Math.min(4, level))] ?? 0.40;
    }
    function currentLevel(): number {
      const live = document.documentElement.dataset.fluidStrength;
      if (live !== undefined) return Number(live);
      return Number(cvs!.dataset.strength ?? '2');
    }
    let amp = ampFor(currentLevel());
    gl.uniform1f(uAmp, amp);

    // 0.5× internal resolution: a smooth noise field survives the upscale
    // invisibly and this is the single biggest perf lever.
    const SCALE = 0.5;
    function resize(): void {
      const w = Math.max(1, Math.round(cvs!.clientWidth * SCALE));
      const h = Math.max(1, Math.round(cvs!.clientHeight * SCALE));
      if (cvs!.width !== w || cvs!.height !== h) {
        cvs!.width = w;
        cvs!.height = h;
        gl!.viewport(0, 0, w, h);
      }
    }

    // In `fixed` mode the canvas is viewport-locked, so page scroll IS the
    // sampling window — that's what makes descending feel like descending.
    // In `contained` mode the canvas scrolls with its own rung, so adding page
    // scroll on top would double-count and every rung would sample nearly the
    // same slice; a fixed per-rung offset keeps each panel's field distinct.
    const contained = cvs.dataset.mode === 'contained';
    function scrollUnits(): number {
      if (contained) return 0;
      const vh = window.innerHeight || 1;
      return window.scrollY / vh;
    }

    function draw(tSec: number): void {
      resize();
      // Re-read the level each frame so the ladder UI takes effect live.
      const want = ampFor(currentLevel());
      if (want !== amp) { amp = want; gl!.uniform1f(uAmp, amp); }
      gl!.uniform1f(uTime, tSec);
      gl!.uniform1f(uScroll, scrollUnits());
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
    }

    // One finished frame immediately — instant paint, and the guaranteed
    // reduced-motion / pre-loop baseline.
    draw(0);

    const reduce = prefersReducedMotion();
    const onResize = () => { if (reduce) draw(0); };
    window.addEventListener('resize', onResize);
    // Under reduced motion the strata are frozen, but the sky must still track
    // scroll or it would look like a stuck decal.
    const onScroll = () => { if (reduce) draw(0); };
    window.addEventListener('scroll', onScroll, { passive: true });

    let rafId = 0;
    let running = false;
    let last = 0;
    let io: IntersectionObserver | null = null;
    const t0 = performance.now();

    function loop(now: number): void {
      if (now - last > 33) {           // ~30fps
        draw((now - t0) / 1000);
        last = now;
      }
      rafId = requestAnimationFrame(loop);
    }
    function start(): void {
      if (running || reduce || document.hidden) return;
      running = true; last = 0;
      rafId = requestAnimationFrame(loop);
    }
    function stop(): void {
      if (!running) return;
      running = false;
      cancelAnimationFrame(rafId);
      rafId = 0;
    }

    const onVis = () => { if (document.hidden) stop(); else start(); };

    if (!reduce) {
      document.addEventListener('visibilitychange', onVis);
      io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) start(); else stop();
      }, { threshold: 0 });
      io.observe(cvs);
    }

    return () => {
      stop();
      window.removeEventListener('resize', onResize);
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('visibilitychange', onVis);
      io?.disconnect();
      // Release GL objects so a View-Transition re-init doesn't leak contexts.
      gl.deleteBuffer(buf);
      gl.deleteProgram(prog);
      gl.deleteShader(vs);
      gl.deleteShader(fs);
    };
  }

  document.addEventListener('astro:page-load', initAll);
</script>
