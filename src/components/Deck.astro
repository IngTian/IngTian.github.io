---
// src/components/Deck.astro
// THE DECK CONTROLLER — "like a PPT, one scroll guides you to the next slide. It's not a free scroll."
//
// One wheel gesture, one arrow key, or one swipe advances exactly one stop. The stops themselves come
// from lib/deck.ts (pure and unit-tested); this file is only the event plumbing.
//
// WHY JS AT ALL, when CSS scroll-snap exists. Snap was built first and measured; it cannot do this at
// the page's real proportions. Slide gaps are 581-2346px while one wheel gesture is ~320px, so
// `scroll-snap-type: y mandatory` re-snapped to the slide it started from and the page froze at y=84
// through eight consecutive gestures. `proximity`, `scroll-snap-stop: always`, and a hero shrunk to
// exactly 100vh all measured identically stuck. The full numbers are in lib/deck.ts.
//
// WHAT THIS DELIBERATELY DOES NOT BREAK, because hijacking the wheel is the easiest way to ruin a page:
//   · keyboard — Home/End/PageUp/PageDown/space/arrows keep working, and Tab focus is never fought
//   · #anchor links, the rail's included — a jump the deck did not start wins: it drops its own slide and
//     swallows the wheel until the browser's scroll ends (onNavigate)
//   · find-in-page — the deck picks up from wherever the browser put the page
//   · zoom and small viewports — recomputed on resize; disabled when a slide barely exceeds the screen
//   · REDUCED MOTION — the deck does not engage at all; the page is an ordinary free scroll, which is
//     a finished state, not a degraded one
//   · trackpad momentum — a gesture is coalesced, so one flick is one slide rather than five
//
// A vanilla script, no island (CLAUDE.md, Stack): it re-inits on astro:page-load with a teardown, like
// TerrainHero and DescentPath.
---
<script>
  import { deckStops, nextStop, wheelAction, easeInOutCubic, DECK_TWEEN_MS, type DeckSlide } from '../lib/deck';
  import { prefersReducedMotion } from '../lib/motion';
  import { isPhone, PHONE_QUERY } from '../lib/viewport';

  function initDeck(): (() => void) | null {
    const main = document.querySelector<HTMLElement>('main.is-slides');
    if (!main) return null;
    // The motion gate is the project's single source of truth. A deck is involuntary movement; a
    // reader who asked for less motion gets the plain scroll.
    if (prefersReducedMotion()) return null;

    // ── THE DECK DOES NOT ENGAGE ON A PHONE. Its contract, "every slide owns the screen", is false there:
    // measured in real WebKit, 5 of the 7 slides are TALLER than the viewport (rules 1.84 screens, story 3.07
    // on an iPhone 14; 2.5 and 4.2 on an SE). So it rests INSIDE slides, and each reported symptom follows:
    //   · text under the fixed nav at 7 of 15 stops (the panels' 78px clears it only at a slide's top);
    //   · one swipe scrolling twice: the touch listeners are { passive: true }, so they cannot preventDefault,
    //     and iOS's momentum scroll fights go()'s scrollTo;
    //   · a flick under the 44px SWIPE threshold resting off-stop (30px on an iPhone 14, 95px on an SE);
    //   · one swipe advancing two stops.
    // Turning the deck off removes all four by deleting behaviour, not adding compensation: the phone gets the
    // ordinary free scroll, the same finished state reduced-motion readers get.
    if (isPhone()) return null;

    // Slide elements: the top-level sections, full stop. Story is NOT split into graph and editorial: the
    // two overlap (the graph is sticky beside the writing), and a stop on the sticky column would measure
    // its STUCK position. Being taller than a screen, it is paged by deckStops.
    function slideEls(): HTMLElement[] {
      return Array.from(main!.children).filter(
        (el): el is HTMLElement => el instanceof HTMLElement && el.tagName === 'SECTION',
      );
    }

    let stops: number[] = [];
    function measure(): void {
      const vh = window.innerHeight;
      // A stop is a slide's top edge, never a point above it: the air a title needs is its panel's own
      // padding (global.css, .slide-paper), because a stop lifted above a full-bleed slide shows a strip of
      // the one before it.
      const slides: DeckSlide[] = slideEls().map((el) => {
        const r = el.getBoundingClientRect();
        return { top: r.top + window.scrollY, height: r.height };
      });
      const maxY = Math.max(0, document.documentElement.scrollHeight - vh);
      stops = deckStops(slides, vh, maxY);
    }
    measure();

    // ── Gesture coalescing.
    // A trackpad flick is dozens of wheel events; a mouse notch is one. Without coalescing, a flick
    // would advance a dozen slides. After a gesture is honoured, further wheel events are swallowed
    // until the stream goes quiet — which is also what stops momentum from queueing up jumps.
    // THE LOCK IS HELD UNTIL THE SLIDE ANIMATION FINISHES, not until the wheel stream goes quiet.
    // An earlier version cleared it after 140ms of silence, which measured as a bug: a 14-event
    // trackpad flick jumped from the top of the page to the bottom (0 → 6302, every slide at once),
    // because events still arriving during the transition each triggered another advance. (That transition was a
    // ~500ms native smooth scroll then; it is now our own 650ms tween — see tweenTo. The coalescing logic is
    // unchanged, and the reason it exists is unchanged with it.)
    // Two conditions must BOTH hold before another gesture is honoured — the animation has settled at
    // its target, AND the wheel stream has gone quiet, so leftover momentum cannot advance a slide the
    // reader did not ask for.
    let animating = false;
    let target: number | null = null;
    let quietTimer = 0;
    let animTimer = 0;
    let streamLive = false;
    let travel = 0;            // a gesture's travel while it is still under the threshold (wheelAction)
    const QUIET_MS = 160;      // stream considered ended after this much silence
    const ANIM_MAX_MS = 900;   // hard release. Now a pure belt-and-braces: our tween is 650ms and calls
                               // release() itself on its last frame, so this only fires if a frame never
                               // arrives (a backgrounded tab). It stays because losing the lock forever
                               // would leave the deck permanently deaf to gestures.

    /** Programmatic scrolls (anchors, find-in-page, replay buttons) must not be treated as gestures. */
    let ignoreUntil = 0;

    function release(): void {
      animating = false;
      target = null;
    }

    // ── THE TRANSITION IS OURS, not the browser's. Native smooth scroll reaches near-peak velocity within
    // ~35ms of a ~500ms slide (measured on the owner's recording: "the sudden change of slides"), and it
    // cannot be CANCELLED, so a new scroll over a running one lurched. Owning it is one cancelAnimationFrame.
    //
    // `behavior: 'instant'` on each step is load-bearing: global.css sets `html { scroll-behavior: smooth }`, so
    // a plain scrollTo would hand every one of our ~40 frames to the browser's own smoothing and the two curves
    // would fight. This is the one place that override must be bypassed.
    let raf = 0;

    function cancelTween(): void {
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
    }

    function tweenTo(dest: number): void {
      cancelTween();
      const from = window.scrollY;
      const dist = dest - from;
      // Already there (or within rounding): do not spend 650ms animating nothing.
      if (Math.abs(dist) < 2) { window.scrollTo({ top: dest, behavior: 'instant' }); release(); return; }
      const t0 = performance.now();
      const step = (now: number): void => {
        const p = Math.min(1, (now - t0) / DECK_TWEEN_MS);
        window.scrollTo({ top: Math.round(from + dist * easeInOutCubic(p)), behavior: 'instant' });
        if (p < 1) {
          raf = requestAnimationFrame(step);
        } else {
          raf = 0;
          release();   // landed exactly on the stop; no settling, so no off-by-a-pixel rest
        }
      };
      raf = requestAnimationFrame(step);
    }

    function go(dir: 1 | -1): boolean {
      const dest = nextStop(stops, Math.round(window.scrollY), dir);
      if (dest === null) return false;      // at an end — let the browser scroll normally
      animating = true;
      target = dest;
      ignoreUntil = Date.now() + ANIM_MAX_MS;
      window.clearTimeout(animTimer);
      animTimer = window.setTimeout(release, ANIM_MAX_MS);
      tweenTo(dest);
      return true;
    }

    function onWheel(e: WheelEvent): void {
      if (e.ctrlKey || !e.deltaY) return;             // pinch-zoom, not a scroll; a purely sideways event
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;  // horizontal gesture

      // Let anything scrollable in its own right (a code block, a table's own box) scroll itself.
      if (isInnerScrollable(e.target, e.deltaY)) return;

      // Was a gesture ALREADY live before this event? Captured before the stream is re-armed below,
      // because the test that matters is "is this event a continuation" — re-arming first would make
      // every event look like a continuation of itself. Mid-animation, mid-gesture or mid-jump, the event
      // is swallowed: this is what makes one flick equal one slide. The rules are wheelAction's (lib/deck.ts).
      const live = animating || streamLive || yielding;
      travel = live ? 0 : travel + e.deltaY;
      const action = wheelAction(travel, live, stops, Math.round(window.scrollY));
      if (action === 'pass') { travel = 0; return; }   // at an end — let the browser scroll normally
      e.preventDefault();

      // Track the stream: a new gesture is only possible once this goes quiet. A small opener is held as
      // travel, not as a stream, or the rest of its own gesture would be swallowed as a continuation.
      window.clearTimeout(quietTimer);
      quietTimer = window.setTimeout(() => { streamLive = false; travel = 0; }, QUIET_MS);
      if (action === 'start') { go(travel > 0 ? 1 : -1); travel = 0; }
      if (action === 'start' || live) streamLive = true;
    }

    /** True when the event started inside an element that can still scroll in this direction. */
    function isInnerScrollable(target: EventTarget | null, deltaY: number): boolean {
      let el = target instanceof Element ? target : null;
      while (el && el !== document.body) {
        const st = getComputedStyle(el);
        const scrolls = /(auto|scroll|overlay)/.test(st.overflowY);
        if (scrolls && el.scrollHeight > el.clientHeight + 1) {
          const atTop = el.scrollTop <= 0;
          const atBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 1;
          if (!((deltaY < 0 && atTop) || (deltaY > 0 && atBottom))) return true;
        }
        el = el.parentElement;
      }
      return false;
    }

    // ── Keyboard. Arrows/space/PageUp/PageDown move a slide; Home/End and Tab are left alone so the
    // page stays navigable in the ways people expect.
    function onKey(e: KeyboardEvent): void {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      // ALREADY CONSUMED — the deck is the LAST handler for a key, never a second one.
      //
      // This listener is on `window` in the bubble phase, so by the time it runs, any handler on the actual
      // target has already had the key. The three explainer slides each give their beat <button>s a keydown
      // that walks the group with the arrows and calls preventDefault() (Choice, Rules, Solve). Without this
      // guard a keyboard reader focused on a beat chip pressed ArrowDown and got BOTH: the beat advanced and
      // the deck scrolled a whole slide away from the thing they were stepping through.
      //
      // The tag list below cannot cover this: the target is a BUTTON, and BUTTON is deliberately exempted for
      // space only (space on a button is an activation) — arrows on a button are usually free for the deck to
      // take, and are only spoken for when a component says so. defaultPrevented is exactly that statement, so
      // honouring it needs no list of which components use arrows, and a fourth one costs nothing here.
      if (e.defaultPrevented) return;
      const t = e.target as HTMLElement | null;
      // Never intercept typing, or a control that uses arrows itself.
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;

      let dir: 1 | -1 | 0 = 0;
      if (e.key === 'ArrowDown' || e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey)) dir = 1;
      else if (e.key === 'ArrowUp' || e.key === 'PageUp' || (e.key === ' ' && e.shiftKey)) dir = -1;
      if (!dir) return;
      // Space on a button/link is an activation, not a scroll.
      if (e.key === ' ' && t && /^(BUTTON|A|SUMMARY)$/.test(t.tagName)) return;
      if (go(dir)) e.preventDefault();
    }

    // ── Touch. One swipe, one slide. Threshold in px so a tap or a tiny drag does nothing.
    let touchY: number | null = null;
    const SWIPE = 44;
    function onTouchStart(e: TouchEvent): void {
      touchY = e.touches.length === 1 ? e.touches[0].clientY : null;
    }
    function onTouchEnd(e: TouchEvent): void {
      if (touchY === null) return;
      const endY = e.changedTouches[0]?.clientY ?? touchY;
      const dy = touchY - endY;
      touchY = null;
      if (Math.abs(dy) < SWIPE) return;
      if (isInnerScrollable(e.target, dy)) return;
      go(dy > 0 ? 1 : -1);
    }

    // Recompute on resize (zoom, rotation, devtools) — stop positions are geometry, and stale geometry
    // is worse than no deck. Also recompute when the document height changes: images and the terrain
    // canvas settle after first paint, and the /art-style lazy content can grow the page.
    let resizeTimer = 0;
    function onResize(): void {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(measure, 160);
    }
    const ro = new ResizeObserver(onResize);
    ro.observe(document.documentElement);

    // ── A JUMP THE DECK DID NOT START WINS. A rail link or an #anchor is a fragment navigation: the browser
    // smooth-scrolls to it (global.css's scroll-behavior) and fires popstate (Astro's router dispatches one
    // even for the hash already in the URL), and hashchange when the hash changes. Two things cut that scroll
    // short, so the click landed nowhere while the hash said it had: the deck's tween, whose next instant
    // scrollTo cancels the browser's smooth scroll (a rail click 250ms into a PageDown missed 4 of 4), and a
    // wheel during the jump, taken as a new gesture and tweened from mid-flight. So the deck drops its slide
    // and swallows the wheel (wheelAction's `live`) until the scroll ends. A key press still moves a slide:
    // it is the reader's, where a wheel tail is often momentum.
    let yielding = false;
    let yieldTimer = 0;
    // The fallback end, from the last scroll event: a jump with nothing to scroll (its slide already on
    // screen) fires no scrollend, and neither does a browser without it.
    // ponytail: a jump whose frames stall past this loses its hold (seen only under software GL, a 1.4s stall);
    // wait on scrollend alone where it exists if a real machine ever shows it.
    const YIELD_MS = 300;
    function endYield(): void { yielding = false; window.clearTimeout(yieldTimer); }
    function holdYield(): void { window.clearTimeout(yieldTimer); yieldTimer = window.setTimeout(endYield, YIELD_MS); }
    function onNavigate(): void {
      cancelTween();
      release();
      window.clearTimeout(animTimer);
      yielding = true;
      holdYield();
    }

    // Release the lock as soon as the animation actually LANDS, so a deliberate second gesture is not
    // made to wait out the full ANIM_MAX_MS. The timer stays as the fallback for a smooth scroll that
    // never reaches its target (interrupted by an anchor jump, or clamped at the page end).
    function onScroll(): void {
      if (yielding) { holdYield(); return; }
      if (animating && target !== null) {
        if (Math.abs(window.scrollY - target) <= 2) release();
        return;
      }
      // A scroll the deck did not initiate (anchor link, find-in-page, restored position) is left
      // alone; the deck simply picks up from wherever the browser put us.
      if (Date.now() > ignoreUntil) release();
    }

    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('keydown', onKey);
    window.addEventListener('touchstart', onTouchStart, { passive: true });
    window.addEventListener('touchend', onTouchEnd, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('scrollend', endYield);
    window.addEventListener('popstate', onNavigate);
    window.addEventListener('hashchange', onNavigate);

    return () => {
      window.removeEventListener('wheel', onWheel);
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('touchstart', onTouchStart);
      window.removeEventListener('touchend', onTouchEnd);
      window.removeEventListener('resize', onResize);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('scrollend', endYield);
      window.removeEventListener('popstate', onNavigate);
      window.removeEventListener('hashchange', onNavigate);
      window.clearTimeout(quietTimer);
      window.clearTimeout(resizeTimer);
      window.clearTimeout(animTimer);
      window.clearTimeout(yieldTimer);
      // CANCEL THE TWEEN, or a View Transition leaves a rAF loop still scrolling the page it belongs to —
      // which on the next route would drag the reader down a document that has no deck at all.
      cancelTween();
      ro.disconnect();
    };
  }

  // Re-init on first load AND after every View Transition swap, with teardown — the project's pattern
  // for vanilla scripts (see TerrainHero). Without the teardown the listeners would stack up and
  // one gesture would advance several slides after a couple of navigations.
  let deckTeardown: (() => void) | null = null;
  function reinit(): void {
    deckTeardown?.();
    deckTeardown = initDeck();
  }
  document.addEventListener('astro:page-load', reinit);

  // RE-DECIDE WHEN THE BREAKPOINT IS CROSSED, not only on navigation. Without this the phone gate would be
  // sampled once per page load and then be wrong for the rest of the visit in both directions: a phone
  // rotated to landscape (844px wide) would stay deck-less until it navigated, and a desktop window dragged
  // below 640px would keep a deck driving a layout that has become the phone one. Rotation is the case that
  // matters — it is one gesture, not an unusual thing to do.
  //
  // A matchMedia change listener rather than a resize handler: it fires only on the transition that actually
  // changes the answer, so there is nothing to debounce. The deck's own resize handling (measure(), inside
  // initDeck) still deals with size changes that do NOT cross the boundary.
  if (typeof window !== 'undefined' && typeof window.matchMedia === 'function') {
    window.matchMedia(PHONE_QUERY).addEventListener('change', reinit);
  }
</script>
