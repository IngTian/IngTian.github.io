---
import { EQUATIONS } from '../lib/equations';
// Bubbles: mostly silent; rare Easter eggs. `word` = the cow; `mathml` = baked.
const bubbles = JSON.stringify([
  null, null, null, null,
  { word: '<span class="m">●</span> Moo!' },
  { mathml: EQUATIONS.gradZero },
  { mathml: EQUATIONS.gradZero },
  { mathml: EQUATIONS.kkt },
]);
---
{/* `data-intro` marks the surface that carries the first-open animation. Nothing in the page reads it:
    it exists so tests/distSmoke.test.ts can assert the intro ships on `/` and ONLY on `/`. Moving this
    component — or BaseLayout growing its own copy — is the single edit that would hand a 3.6-second
    construction animation to all nine routes, /404 and the proto gallery included, and that assertion
    is the thing that would notice. An attribute rather than a class, because a class would read as a
    styling hook that nothing styles. */}
<canvas id="terrain" class="terrain-canvas" aria-hidden="true" data-intro data-bubbles={bubbles}></canvas>
<div class="terrain-bubble" id="terrain-bubble" aria-hidden="true"></div>

<style>
  .terrain-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%;
    z-index: 0; pointer-events: none; display: block;
  }
  .terrain-bubble {
    position: absolute; z-index: 1; color: var(--on-accent);
    background: var(--ochre); border: 1px solid color-mix(in oklab, var(--indigo) 55%, transparent);
    border-radius: 999px; padding: 4px 13px; white-space: nowrap;
    opacity: 0; transform: translateY(5px); pointer-events: none;
    box-shadow: 0 6px 18px rgba(0,0,0,.18);
  }
  @media (prefers-reduced-motion: no-preference) {
    .terrain-bubble { transition: opacity .45s, transform .45s; }
  }
  .terrain-bubble.show { opacity: 1; transform: none; }
  .terrain-bubble.word { font-family: var(--font-display); font-style: italic; font-size: 16px; }
  /* :global() ON THE DESCENDANTS, because the script creates them and scoped rules cannot reach them.
     Both `.m` and `math` come from `bubbleEl.innerHTML = b.word || b.mathml` below, out of the data-bubbles
     JSON built in the frontmatter — so neither node is in this component's template and neither can carry
     its scope hash. Astro compiled these to `.terrain-bubble[cid] .m[cid]` and `.terrain-bubble[cid]
     math[cid]`, which match nothing in dist on any route: the Moo glyph has been unstyled (wrong colour,
     still italic from `.terrain-bubble.word`) and the three MathML bubbles have had neither their colour nor
     their 1.05em.
     DescentPath.astro:136-148 documents this exact failure for its own script-created emphasis nodes and
     fixes it the same way; this is the instance that was missed. The parent stays scoped because the bubble
     div IS in the template — going global on the whole selector would leak. */
  .terrain-bubble :global(.m) { color: color-mix(in oklab, var(--on-accent) 70%, var(--indigo)); font-style: normal; }
  .terrain-bubble :global(math) { color: var(--on-accent); font-size: 1.05em; }
</style>

<script>
  import { field, runDescent, project, SPAWNS,
           TERRAIN_LIGHT, TERRAIN_TERMINAL, type TerrainRamp } from '../lib/terrain';
  import { buildGrid, paintTerrain, TERRAIN_CONFIG_DEFAULTS, type GridPoint } from '../lib/terrainRender';
  import { prefersReducedMotion } from '../lib/motion';
  import {
    introFrame, introDurationFrom, shouldPlayIntro, surveyProgress, introStillRunning,
    type IntroFrame,
  } from '../lib/introTimeline';
  import { introContours, terrainLevels } from '../lib/terrainContours';

  // The canvas is JS-painted, so it can't inherit CSS tokens — pick the ramp +
  // walker colors from the active theme (data-theme on <html>). Read fresh on
  // each init so a View-Transition swap or a live theme toggle repaints correctly.
  // Dark = the "terminal galaxy": cyan-blue "Glacier" ice dots read as a star
  // field on the charcoal void; light = the shipped warm "Classic" ochre→indigo.
  type WalkerPalette = { glow: [number,number,number]; settled: [number,number,number]; trail: [number,number,number] };
  // `darkness` (0 = light, 1 = dark) drives the directional-light value/gain
  // blend in the shared renderer so the relief reads on both the pale and the
  // dark sky. `dotScale` is a per-theme radius bump — dark gets a touch more (its
  // dots read as a fainter starfield on the void), light a little.
  // `survey` is the intro's contour-line ink, and it is `--ink-3` in each theme rather than a new colour:
  // light #5a544a, dark #8b938c. The palette rule is tokens only, and a contour map wants the same
  // secondary ink a rail label uses — present, clearly behind the dots it precedes.
  function themePalette(): {
    ramp: TerrainRamp; walker: WalkerPalette; darkness: number; dotScale: number;
    survey: [number, number, number];
  } {
    // Walker trios:
    //   dark  = Glacier — frost glow, ice settle, recessive teal trail (screensaver)
    //   light = Classic — the shipped paper glow, ochre settle, indigo trail
    if (document.documentElement.dataset.theme === 'dark')
      return { ramp: TERRAIN_TERMINAL, walker: { glow: [227,242,247], settled: [134,188,204], trail: [73,127,146] }, darkness: 1, dotScale: 1.18, survey: [139, 147, 140] };
    // LIGHT dotScale trimmed 1.15 → 1.08. Light theme now spends its EDL shade on
    // VALUE rather than opacity (see edlSpend in lib/terrain.ts), which by itself
    // adds ink — and "heavier" is not the goal, "clearer" is. The radius trim
    // offsets that ink increase while keeping visible presence on the ridge.
    return { ramp: TERRAIN_LIGHT, walker: { glow: [244,239,228], settled: [200,163,106], trail: [92,108,140] }, darkness: 0, dotScale: 1.08, survey: [90, 84, 74] };
  }

  // Teardown handle for the previous init — re-init runs on every page load AND
  // after each View Transition swap (astro:page-load), so we must dispose the
  // prior instance's listeners / rAF loop / observer or they leak across
  // navigations and reference a stale (swapped-out) canvas. Without this, the
  // bowl field renders blank when you navigate back to home.
  let teardown: (() => void) | null = null;

  // MODULE SCOPE, so it SURVIVES a re-init — which is the whole point of it being here.
  //
  // `theme:change` re-inits this component, and it can land mid-intro. With the clock inside init, the
  // re-init decided afresh: the session flag was already set (it is set at start), so it painted the
  // FINISHED terrain instantly over a half-risen surface — a snap. And with `?intro=1` in the URL the
  // flag no longer applied, so the intro RESTARTED from the flat plane: a backwards collapse, during
  // the owner's own tuning loop, and exactly the "second discontinuity" the design lists as an
  // anti-goal. Carrying the start time across the re-init resumes the animation where it was instead.
  let introStartedAt: number | null = null;

  function initTerrain() {
    teardown?.();
    teardown = null;

    const cvs = document.getElementById('terrain') as HTMLCanvasElement | null;
    const bubbleEl = document.getElementById('terrain-bubble') as HTMLElement | null;
    if (!cvs || !bubbleEl) return;

    const ctx = cvs.getContext('2d')!;
    const reduce = prefersReducedMotion();
    const BUBBLES = JSON.parse(cvs.dataset.bubbles || '[]') as Array<null | { word?: string; mathml?: string }>;
    const { ramp, walker, darkness, dotScale, survey: surveyInk } = themePalette();
    const [gr, gg, gb] = walker.glow;      // walker head-glow
    const [sr, sg, sb] = walker.settled;   // settled-at-minimum accent
    const [tr, tg, tb] = walker.trail;      // descending trail

    // The static-per-camera terrain: dot grid + precomputed normals + EDL shade,
    // built once (EDL is O(n²); the camera is fixed so it never needs recompute).
    // Config is the baked default (shape-reading on) plus this theme's ramp/darkness.
    // starfield: the dark theme's dots twinkle as temperature-tinted stars (its
    // whole conceit is that they read as a star field); light theme keeps the
    // shipped warm relief untouched.
    const cfg = { ...TERRAIN_CONFIG_DEFAULTS, ramp, darkness, dotScale, starfield: darkness > 0.5 };
    const ZOOM = cfg.zoom;                 // walkers must use the SAME zoom to stay on the surface
    let grid: GridPoint[] = buildGrid(cfg.edlParams);

    let W = 0, Hh = 0, DPR = 1;
    function resize() {
      DPR = Math.min(2, window.devicePixelRatio || 1);
      const r = cvs!.getBoundingClientRect();
      W = cvs!.width = Math.round(r.width * DPR);
      Hh = cvs!.height = Math.round(r.height * DPR);
    }
    resize();

    // ── THE INTRO: "the map becomes the territory" ───────────────────────────────────────────────
    //
    // On a first open, isolines of this same field stroke themselves onto a FLAT plane, the surface
    // rises out of that map carrying the lines with it, and the dots resolve as the lines fade. The
    // schedule is pure and lives in lib/introTimeline.ts; this file only paints it.
    //
    // THE CAMERA NEVER MOVES. The one animated quantity is elevation — `paintTerrain`'s `lift`, and the
    // same factor applied to the contour points below. That is what makes the lines and the dots read as
    // ONE surface drawn twice instead of two animations stapled together.
    //
    // ON THE PRECOMPUTED EDL SHADE, because an earlier version of this comment got it wrong: it is NOT
    // camera-only. `computeEDL` projects each dot at FULL elevation and derives its shade from
    // screen-space depth differences between neighbours, so it is a function of the fixed camera AND of
    // the finished geometry. It is therefore exact only at `lift === 1`. During the rise the flat plane
    // carries the finished relief's shade — a density-and-size ghost of the mountain, with colour
    // uniform because `hn` collapses — which is accepted: it reads as a shaded-relief map, which is what
    // the survey is. The landing frame is still byte-exact, which is the property that matters.
    // (What WOULD break it is animating the camera. Do not.)
    //
    // Versioned key, namespaced so it cannot collide with the theme key BaseLayout's resolver reads.
    // Bump the suffix when the animation changes enough to want a second look mid-session — otherwise a
    // reload during a design pass shows nothing and the change appears not to have shipped.
    const INTRO_KEY = 'descent.intro.seen.v1';
    const INTRO_MS = introDurationFrom(location.search);
    // An intro already in flight RESUMES across a re-init; otherwise the flag and `?intro=1` decide.
    const resuming = introStillRunning(introStartedAt, performance.now(), INTRO_MS);
    const playIntro = !reduce && (resuming || shouldPlayIntro(
      { get: () => sessionStorage.getItem(INTRO_KEY) },
      location.search,
    ));
    // SET AT START, not on completion: "first open" is the semantics, and setting it at the end means a
    // visitor who reloads repeatedly sees the animation every time. `?intro=1` overrides the flag, which
    // is what makes a tuning pass one reload rather than a storage purge.
    if (playIntro) { try { sessionStorage.setItem(INTRO_KEY, '1'); } catch { /* private mode: fine */ } }

    /**
     * The survey pass — isolines stroked onto the surface at its current elevation.
     *
     * Drawn BEFORE the dots and as a SEPARATE pass rather than inside `paintTerrain`, which owns dots
     * and elevation. Widening that function for a different kind of mark is how a painter rots; widening
     * it for `lift` was correct because elevation is already its business.
     *
     * `prog` staggers the levels slightly (0.05 apart) so the map draws as a sequence of passes rather
     * than nine lines appearing at once, and each run reveals progressively along its own length — which
     * is what reads as "drawn" rather than "faded in".
     */
    function strokeSurvey(surveyT: number, alpha: number, lift: number) {
      const [ir, ig, ib] = surveyInk;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.lineWidth = 1.15 * DPR;
      const levels = introContours();
      const lv = terrainLevels();
      for (let li = 0; li < levels.length; li++) {
        // The per-level schedule lives in lib/introTimeline.ts. It was three inline literals here, which
        // put phase boundaries in a draw call where no test could reach them — and the schedule was
        // wrong, finishing the whole map in the first fifth of its phase and leaving a frozen frame.
        const prog = surveyProgress(surveyT, li, levels.length);
        if (prog <= 0) continue;
        ctx.strokeStyle = `rgba(${ir},${ig},${ib},${(0.46 * alpha * Math.min(1, prog * 1.6)).toFixed(3)})`;
        // A CONTOUR POINT'S ELEVATION *IS* ITS LEVEL — that is what makes it a contour. So the height
        // is `lv[li] * lift` and `field()` must not be called here: it would evaluate five Gaussians per
        // point, ~6,200 `exp()` calls per frame on an unthrottled loop, to recompute a number we already
        // know. It is also strictly MORE accurate: the points are linear interpolations along cell
        // edges, so `field()` returns the level plus O(cell²) error, which would sit the line slightly
        // off its own isoline.
        const z = lv[li] * lift;
        for (const run of levels[li]) {
          const n = Math.max(2, Math.ceil(run.length * prog));
          ctx.beginPath();
          for (let k = 0; k < n; k++) {
            const [x, y] = run[k];
            const [sx, sy] = project(x, y, z, W, Hh, ZOOM);
            if (k === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
          }
          ctx.stroke();
        }
      }
    }

    /** The live breath amplitude, in world-z. The static frame uses 0 — see `frame`'s note on `breathIn`. */
    const BREATH_AMP = 0.04;
    /** How long the breath takes to come up from the still frame. Long enough to read as settling rather
     *  than as a correction; short enough that a reader who arrives mid-ramp sees a living hero. */
    const BREATH_IN_MS = 900;

    // descent walkers
    interface Walker { pts: Array<{x:number;y:number}>; born: number; done: boolean; retire: boolean; bubble: null | {word?:string;mathml?:string}; }
    const walkers: Walker[] = [];
    let spawnIx = 0, nextSpawnAt = 600;
    const STEP_MS = 680;
    function maybeSpawn(ts: number) {
      if (ts < nextSpawnAt) return;
      if (walkers.length && !walkers[walkers.length - 1].done) { nextSpawnAt = ts + 400; return; }
      const [sx, sy] = SPAWNS[spawnIx % SPAWNS.length];
      const bubble = BUBBLES[(spawnIx * 3 + 1) % BUBBLES.length];
      spawnIx++;
      walkers.push({ pts: runDescent(sx, sy), born: ts, done: false, retire: false, bubble });
      nextSpawnAt = ts + 4200 + (spawnIx % 3) * 900;
    }

    /**
     * `breathIn` is the fix for a reported discontinuity: *"the hero's dots got shifted by a tiny bit into
     * its correct location."*
     *
     * The static frame and the animated frame disagreed about exactly one parameter. `frame(0, false)`
     * paints with `breathAmp = 0`; the loop paints with `0.04`. So the instant the loop starts, every dot's
     * elevation gains `0.04 * sin(tsec * 0.4 + x*0.7 + y*0.6)` in one frame — and because `project` scales
     * by `min(W, Hh) * 0.34 * zoom`, that is up to **±8.8 CSS px** of vertical displacement per dot at the
     * hero's measured box. Not a fade, not a slide: a jump. It happened on every ordinary page load, since
     * the static frame is painted first for instant LCP and the loop starts a moment later.
     *
     * Ramping the AMPLITUDE rather than the clock is what makes this exact. At `breathAmp = 0` the elevation
     * is `field(x, y)` regardless of `tsec`, so the ramp's first frame reproduces the static frame byte for
     * byte whatever time the loop happens to start at — there is nothing to synchronise. Easing the clock
     * instead would have required knowing the phase the still frame was painted at.
     *
     * Measured with a centroid probe over the first 1.6s: largest frame-to-frame step 2.077px before,
     * 0.924px after — and the centroid understates it, because the breath is a travelling wave whose
     * displacements partly cancel in the mean.
     */
    function frame(ts: number, animate: boolean, breathIn = 1, intro: IntroFrame | null = null) {
      ctx.clearRect(0, 0, W, Hh);
      const tsec = ts / 1000;
      const breathAmp = animate ? BREATH_AMP * breathIn : 0;
      const breathHz = 0.4;
      const lift = intro ? intro.lift : 1;

      // The intro's survey, behind everything.
      //
      // THE `intro.survey > 0` GUARD IS NOT COSMETIC. Without it, the very first frame — which has
      // contourAlpha 1 and survey 0 — called `introContours()`, paid the full 10.6ms marching-squares
      // build, and then stroked exactly ZERO paths. The spec said in so many words to compute that
      // geometry on the first animation tick rather than synchronously before first paint; this guard
      // is what makes that true. Measured: it was the whole of the +12ms this feature cost the LCP.
      if (intro && intro.contourAlpha > 0.002 && intro.survey > 0) {
        strokeSurvey(intro.survey, intro.contourAlpha, lift);
      }

      // Terrain dots (shared renderer): elevation color → directional relief +
      // warm/cool tint → Eye-Dome Lighting + elevation emphasis → bottom fade.
      // The bottom fade dissolves the bowl softly into the gradient instead of
      // ending in an abrupt dot-band at the hero's lower edge.
      //
      // The intro's dot fade-in rides on `globalAlpha` rather than on a tenth parameter to
      // `paintTerrain`. The painter composes its own per-dot alpha from elevation and EDL, and
      // globalAlpha multiplies the lot — which is exactly the semantics wanted, for free. Always reset:
      // the walker and bubble passes below must not inherit it.
      // Skipped entirely while the dots are still invisible: at globalAlpha 0 this issued 987
      // arc+fill pairs that painted nothing, every frame, for the first 1008ms of an UNTHROTTLED loop.
      if (!intro || intro.dots > 0.004) {
        if (intro) ctx.globalAlpha = intro.dots;
        paintTerrain(ctx, grid, cfg, W, Hh, DPR, tsec, breathAmp, lift);
        if (intro) ctx.globalAlpha = 1;
      }

      // walkers (only when animating; static frame shows terrain only)
      let anyBubble: null | { x:number; y:number; b:{word?:string;mathml?:string} } = null;
      if (animate) {
        maybeSpawn(ts);
        const APPEAR = 160, TAIL = 4600, HOLD = 1600;
        for (const wk of walkers) {
          const elapsed = ts - wk.born;
          const shown = Math.min(wk.pts.length, Math.floor(elapsed / STEP_MS) + 1);
          if (shown >= wk.pts.length && !wk.done) { wk.done = true; }
          let maxAlpha = 0;
          for (let i = 0; i < shown; i++) {
            const pt = wk.pts[i];
            const z = field(pt.x, pt.y) + breathAmp * Math.sin(tsec * breathHz + pt.x * 0.7 + pt.y * 0.6);
            const [sx, sy] = project(pt.x, pt.y, z + 0.06, W, Hh, ZOOM);
            const isLast = i === wk.pts.length - 1;
            const age = ts - (wk.born + i * STEP_MS);
            const appear = Math.min(1, age / APPEAR);
            const life = (isLast && wk.done)
              ? Math.max(0, 1 - Math.max(0, age - HOLD) / 700)
              : Math.max(0, 1 - age / TAIL);
            const a = appear * life;
            if (a <= 0.01) continue;
            maxAlpha = Math.max(maxAlpha, a);
            const rr = (isLast ? 5.2 : 3.8) * DPR;
            ctx.beginPath(); ctx.arc(sx, sy, rr * 1.9, 0, 2 * Math.PI); ctx.fillStyle = `rgba(${gr},${gg},${gb},${0.5 * a})`; ctx.fill();
            ctx.beginPath(); ctx.arc(sx, sy, rr, 0, 2 * Math.PI);
            ctx.fillStyle = isLast && wk.done ? `rgba(${sr},${sg},${sb},${0.95 * a})` : `rgba(${tr},${tg},${tb},${a})`;
            ctx.fill();
            if (isLast && wk.done && a > 0.5 && wk.bubble) anyBubble = { x: sx, y: sy, b: wk.bubble };
          }
          if (wk.done && maxAlpha <= 0.01) wk.retire = true;
        }
        for (let i = walkers.length - 1; i >= 0; i--) if (walkers[i].retire) walkers.splice(i, 1);
      }

      // rare Easter-egg bubble
      if (anyBubble) {
        const b = anyBubble.b;
        const key = b.mathml || b.word || '';
        if (bubbleEl!.dataset.key !== key) {
          bubbleEl!.dataset.key = key;
          bubbleEl!.classList.toggle('word', !!b.word);
          bubbleEl!.innerHTML = b.word || b.mathml || '';
        }
        bubbleEl!.style.left = (anyBubble.x / DPR + 12) + 'px';
        bubbleEl!.style.top = (anyBubble.y / DPR - 44) + 'px';
        bubbleEl!.classList.add('show');
      } else { bubbleEl!.classList.remove('show'); bubbleEl!.dataset.key = ''; }
    }

    // FIRST PAINT, and there is exactly one of them on either path.
    //
    // Without the intro: one finished frame immediately — instant LCP, and the guaranteed baseline for
    // reduced motion and for the moment before the loop spins up. Unchanged.
    //
    // With the intro: the first paint IS the intro's own t=0, the flat plane. `frame(0, false)` must NOT
    // run on that path. An earlier draft of the design had it paint the finished terrain first and then
    // start the intro, which means the visitor watches the landscape COLLAPSE to a plane — a backwards
    // jump, and exactly the discontinuity this whole feature is supposed to avoid.
    //
    // When RESUMING across a re-init (a theme flip mid-intro), paint the frame the animation is
    // actually at, not t=0 — otherwise the fix for the snap would itself be a backwards jump.
    if (playIntro) {
      const t0 = resuming && introStartedAt !== null
        ? Math.min(1, (performance.now() - introStartedAt) / INTRO_MS)
        : 0;
      frame(0, false, 1, introFrame(t0));
    } else frame(0, false);

    // Resize handler: canvas resize clears the backing store, so repaint the
    // static frame under reduced-motion (otherwise the animation loop repaints).
    // DEBOUNCED, at the same 160ms the Deck, FluidSky and DescentPath already use. `resize()` reassigns
    // `cvs.width`/`cvs.height`, and reassigning either REALLOCATES the backing store of a full-bleed canvas
    // at DPR up to 2 — that is the expensive part, not the getBoundingClientRect. Undebounced it ran once
    // per resize event for the whole duration of a window drag.
    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { resize(); if (reduce) frame(0, false); }, 160);
    };
    window.addEventListener('resize', onResize);

    // Under reduced-motion we stop here (static frame is the finished state).
    // Otherwise run the animation, paused while the hero is offscreen, and
    // throttled to ~30fps — imperceptible for this gentle motion, half the cost.
    let rafId = 0;
    let io: IntersectionObserver | null = null;
    if (!reduce) {
      let running = false, last = 0, breathFrom = 0;
      let introDone = !playIntro, introFrom = 0;
      const loop = (ts: number) => {
        // ── The intro, while it lasts ────────────────────────────────────────────────────────────
        if (!introDone) {
          // The clock is stamped at module scope on the first frame of the FIRST init, and reused by
          // any re-init that lands while the intro is still running — so a theme flip resumes.
          if (!introFrom) {
            if (resuming && introStartedAt !== null) introFrom = introStartedAt;
            else introFrom = introStartedAt = ts;
          }
          const t = Math.min(1, (ts - introFrom) / INTRO_MS);
          // `animate: false` so no walker spawns or draws during the intro — a comet descending a flat
          // plane is meaningless, and at partial lift it would hang in mid-air above the surface,
          // because walker points are projected at full elevation and know nothing about `lift`.
          frame(ts, false, 1, introFrame(t));
          // DELIBERATELY UNTHROTTLED, unlike the live loop's 33ms. This is 3.6 seconds once per session
          // and it is the first thing anyone sees; the project's own FluidSky lesson is that what reads
          // as smooth is cadence locked to the display refresh, not draw count. The live loop's 30fps is
          // right for a gentle permanent breath and wrong for a one-off eased construction.
          if (t >= 1) {
            introDone = true;
            // The first walker arrives a beat AFTER the landing rather than instantly: `nextSpawnAt` is
            // seeded at 600ms from navigation start, which the intro has long since passed.
            nextSpawnAt = ts + 600;
            // Re-arm the breath ramp so it comes up from the landed frame. The landed frame has
            // breathAmp 0 and lift 1, which IS `frame(0, false)` — so this ramp is the correct
            // continuation and no crossfade is needed. See introTimeline's note on the t=1 landing.
            breathFrom = 0;
          }
          rafId = requestAnimationFrame(loop);
          return;
        }
        // ── The live hero ───────────────────────────────────────────────────────────────────────
        // `breathFrom` is stamped on the first frame of a run, so the ramp is measured from when the loop
        // actually started rather than from navigation start.
        if (!breathFrom) breathFrom = ts;
        if (ts - last > 33) {
          frame(ts, true, Math.min(1, (ts - breathFrom) / BREATH_IN_MS));
          last = ts;
        }
        rafId = requestAnimationFrame(loop);
      };
      io = new IntersectionObserver((entries) => {
        const visible = entries[0].isIntersecting;
        // AN UNSEEN INTRO IS CONSUMED, NOT DEFERRED. A reload at a restored scroll position leaves the
        // hero offscreen, so this fires with visible=false before the intro has run. Keeping it pending
        // would play a 3.6s construction animation on a scroll-back minutes later, in front of someone
        // already reading — which is not an intro. Land it now; the canvas is then correct whenever they
        // arrive. Same rule if the deck carries them off the hero mid-intro.
        if (!visible && !introDone) {
          introDone = true;
          cancelAnimationFrame(rafId);
          running = false;
          frame(0, false);
          return;
        }
        // `breathFrom = 0` re-arms the ramp, so resuming from offscreen comes back up from the still
        // frame instead of snapping to full breath.
        if (visible && !running) { running = true; last = 0; breathFrom = 0; rafId = requestAnimationFrame(loop); }
        else if (!visible && running) { running = false; cancelAnimationFrame(rafId); }
      }, { threshold: 0 });
      io.observe(cvs);
    }

    // Dispose everything this instance attached, so a later re-init (View
    // Transition swap) doesn't leave a stale rAF loop / observer / listener
    // pointing at the old canvas.
    teardown = () => {
      window.removeEventListener('resize', onResize);
      // The debounce timer has to go too: a pending one would fire after the swap and call resize() against
      // the canvas this instance captured, which ClientRouter has already replaced.
      window.clearTimeout(resizeTimer);
      if (rafId) cancelAnimationFrame(rafId);
      io?.disconnect();
    };
  }

  // Run on first load and after every View Transition swap. astro:page-load
  // fires in both cases; if ClientRouter isn't present it still fires once.
  document.addEventListener('astro:page-load', initTerrain);
  // A THEME FLIP REPAINTS THIS CANVAS, but must not re-init the whole page. The toggle used to dispatch
  // astro:page-load, which re-ran every vanilla script — the deck's 7-slide re-measure, the Toc, three beat
  // steppers, the cow — for a palette change none of them care about. Measured at 6x throttle: a 357ms long task
  // on the homepage against 55ms on /404, and identical with the View Transition disabled, so the transition was
  // never the cost. This canvas is one of only three surfaces that paint from JS and read the palette.
  document.addEventListener('theme:change', initTerrain);
</script>
