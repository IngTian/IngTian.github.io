---
// THE FIRST-VISIT ENTRANCE. Rendered from index.astro ONLY — never BaseLayout, so no other route can inherit a
// full-screen overlay. Moving it up one file is the single edit that would hand this to all nine routes.
//
// IT IS AN ENTRANCE, NOT A GATE, AND THAT IS THE WHOLE DESIGN. It plays itself and lands in the hero: no
// button, no click — "the users wont click anything just seeing through the animation". The field is the HERO'S
// OWN terrain, painted by the same renderer at a pulled-back camera, tweening to exactly the hero's camera. At
// the landing frame the overlay and the hero are the same picture, so removing the overlay cannot be seen.
//
// That continuity is the point. Ten rounds were spent tuning a borrowed line field that cross-faded into an
// unrelated hero, and the verdict stayed "a little bit dull". The research into intros that land says the
// device is always continuity of OBJECT — a progress ring that becomes the button, a gate that is also the
// page-transition chrome. Two unrelated things cross-fading is what reads as a toll booth.
//
// THE ONE INVARIANT THAT MATTERS: this ships NOT COVERING, and JS raises it. The static HTML carries the
// overlay in its dismissed state and an inline script adds .is-up. An overlay that defaulted to covering would
// lock out every visitor whose JS failed and hide the page from anything that does not run scripts. The page's
// full markup is in the HTML either way, so this is a decoration, not a content gate — which is what keeps it
// crawlable. tests/distSmoke.test.ts asserts the shipped HTML carries no covering class.
import { name, roles } from '../data/profile';
// Only what define:vars hands to the INLINE script belongs here. The entrance's own timings
// (ENTRANCE_MS, the camera path, the name's travel) are imported by the bundled painter below, which can
// import — so they are never restated and never passed through the markup.
import {
  GATE_DISMISS_MS,
  GATE_LAND_EVENT,
  GATE_REVEAL_EVENT,
  GATE_SEEN_KEY,
  GATE_UP_ATTR,
} from '../lib/gate';

// Letters carry which WORD they belong to, because the hero sets its surname in italic at a different ink and
// weight (`Ing <em class="italic text-ink-3 font-medium">Tian</em>`). A stand-in that was uniformly roman
// snapped at the swap — the one frame this entire design exists to make invisible.
const letters = [
  ...[...name.first].map((ch) => ({ ch, last: false })),
  { ch: ' ', last: false },
  ...[...name.last].map((ch) => ({ ch, last: true })),
];
---

{/* aria-hidden, and NOT a dialog. It was `role="dialog" aria-modal="true"` while there was a button to focus;
    with nothing to interact with it is a transient decoration, and announcing a modal that the reader can
    neither act on nor escape is worse than announcing nothing. The real <h1> is the hero's, underneath — which
    also retires the two-<h1> defect this component shipped once. */}
<div class="gate" data-gate aria-hidden="true">
  {/* The backdrop is a SEPARATE layer from the canvas so it can fade independently.
      It has to: the hero sits on the fluid sky, the overlay sits on an opaque ground, and if the ground were
      still opaque at the landing frame the removal would flash the sky in. It clears in the LAST 450ms, on the
      same `crossover` clock as the name's ink — the two are one event and running them on separate wide clocks
      is what made the name vanish mid-travel. See `crossover` in lib/gate.ts. */}
  <div class="gate-back" data-gate-back></div>
  <canvas class="gate-field" data-gate-field></canvas>

  <div class="gate-text" data-gate-text>
    {/* A <p>, not an <h1> — see above. The letters are spans so they can arrive one at a time. */}
    <p class="gate-name">
      {letters.map((l, i) => (
        <span class={l.last ? 'gate-letter is-last' : 'gate-letter'} style={`--l:${i}`}>
          {l.ch === ' ' ? ' ' : l.ch}
        </span>
      ))}
    </p>
    <p class="gate-roles">{roles}</p>
  </div>
</div>

<style>
  /* SHIPS NOT COVERING. `visibility: hidden` as well as `opacity: 0` so nothing in here can be tabbed to or
     read by a screen reader before the script raises it — and so the no-JS state is genuinely absent rather
     than invisible-but-present. This is the one element allowed to rest at opacity 0 (see trap 6). */
  .gate {
    position: fixed;
    inset: 0;
    z-index: 70;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden;
  }
  .gate.is-up {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .gate-back { position: absolute; inset: 0; background: var(--bg); }

  /* The canvas is positioned and sized by script to MATCH THE HERO'S CANVAS RECT exactly — measured, not
     assumed, because `project` scales by min(W,H) and centres at 0.46H, so the same zoom in a different box is
     a different picture. Landing on the hero's frame means landing on its geometry too. */
  .gate-field { position: absolute; display: block; pointer-events: none; }

  .gate-text {
    position: absolute; inset: 0; display: grid; place-content: center; text-align: center; padding: 0 7vw;
    /* The stagger, declared once. Both the letters and the roles line index off these, so the roles line cannot
       drift out of step with the letters it has to stay clear of. */
    --gate-lead: 120ms;
    --gate-stagger: 28ms;
  }

  .gate-name {
    font-family: var(--font-display), Georgia, serif;
    /* IVORY, because the ground under it starts opaque and dark. It was `--ink-1` for one build, which is the
       DARK ink — the name was simply invisible on the first screen, which is the third route this component has
       found to that defect (see trap 6; the guard there greps for `opacity: 0` and cannot see a colour).
       The script tweens it toward the hero's ink as the ground clears — see the painter. */
    color: var(--paper);
    font-size: clamp(44px, 9vw, 116px);
    /* 0.9 and -0.02em are the HERO'S numbers, copied (Heights.astro: `leading-[0.9] tracking-[-0.02em]`).
       It was 0.95 here, which looked like a detail and is not: the FLIP matches the stand-in's measured box to
       the hero's, so a different line-height makes the two boxes different SHAPES and only one axis can land.
       If the hero's type changes, change these with it. */
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .gate-letter { display: inline-block; will-change: transform; }
  /* The surname, matching the hero's `<em class="italic text-ink-3 font-medium">` exactly. Its ink is
     tweened separately by the painter, to `--ink-3` rather than `--ink-1`. */
  .gate-letter.is-last { font-style: italic; font-weight: 500; }

  .gate-roles {
    font-family: var(--font-display), Georgia, serif;
    font-style: italic;
    color: var(--ink-3);
    font-size: clamp(15px, 2.2vw, 21px);
    /* 1.25rem = the hero's own `mt-5`. At 0.6rem this line sat inside the descenders of "Ing" on the opening
       frame — a display serif at line-height 0.9 overflows its line box by ~13px at 116px, and a 9.6px gap is
       less than that. The first frame of the site is not the place to crowd two lines. */
    margin: 1.25rem 0 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* THE LETTERS FAIL VISIBLE. This is trap 6: they animated in from `opacity: 0` behind a `forwards` fade,
       and any element whose animation does not run is then permanently invisible — what vanished was the
       owner's name on the first screen of his own portfolio. They animate TRANSFORM from a legible state now,
       so an interrupted animation leaves the name readable rather than gone. */
    .gate.is-up .gate-letter {
      animation: gate-letter 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(var(--gate-lead) + var(--l) * var(--gate-stagger));
    }
    /* THE LETTERS COME DOWN, NOT UP, and that is the fix for a collision rather than a preference.
       They used to spring from `translateY(0.38em)` — BELOW their resting place — which is 44px at the clamp's
       ceiling, and the roles line sits 20px under the name. So for the whole 120-836ms of the stagger the name
       slid down THROUGH that line: measured, "g"'s descender reached about 30px past the roles line's own
       baseline. Reading the settled geometry says nothing about it, because settled they clear by ~14px.
         Three fixes were considered and this is the only one with no second moving part. Giving the roles line
       the same spring does NOT work — `em` resolves against each element's own font-size, so the letters travel
       44px while a 21px line travels 8px and they still meet (built, measured, still colliding). Passing the
       rise as a shared custom property would fix that arithmetic but puts a `var()` inside an interpolated
       transform, which is trap 5's second note: Chrome refuses to interpolate it and snaps. Widening the static
       gap to clear 44px would push this line much further from the name than the hero's own `mt-5`, which shows
       at the handover. Coming from ABOVE cannot collide with anything, because there is nothing above the name.
     */
    @keyframes gate-letter {
      from { transform: translateY(-0.38em) scale(0.97); }
      to   { transform: none; }
    }
  }

  /* Phones get the same CONTENT; the canvas is simply cheaper. The painter halves nothing here — it caps DPR
     and the hero's own canvas does the same, so the cost is the cost of one terrain. No media query lives in
     this file any more, which is deliberate: the hand-synced phone-breakpoint checklist in CLAUDE.md counts
     `max-width: 640px` blocks by grep, and this component no longer contributes one. */
</style>

<script
  is:inline
  define:vars={{
    KEY: GATE_SEEN_KEY,
    MS: GATE_DISMISS_MS,
    UP: GATE_UP_ATTR,
    REVEAL: GATE_REVEAL_EVENT,
    LAND: GATE_LAND_EVENT,
  }}
>
  // POLICY ONLY. This script raises the overlay and releases it; it paints nothing. It is `is:inline` because
  // it has to run before first paint — that is what makes the entrance the first thing on screen rather than a
  // flash of homepage followed by an overlay — and an inline script cannot import, so the rules it enforces are
  // RESTATED here and unit-tested in lib/gate.ts rather than shared. Everything that can be a number handed in
  // through define:vars is, because a restated number drifts from its test silently.
  (function () {
    // FRESH LOAD ONLY. An inline script runs during parse, so readyState is 'loading' on a real navigation;
    // when ClientRouter re-executes this on a client-side navigation into / it is 'complete'. Without the guard
    // the overlay raises over a homepage the visitor was already looking at. isFreshLoad() owns this rule.
    if (document.readyState !== 'loading') return;

    // FAIL CLOSED: no store, or a store that throws, means do not raise. A visitor in a locked-down browser
    // gets the site, not a decoration they cannot dismiss.
    var seen = true;
    try {
      seen = window.sessionStorage.getItem(KEY) === '1';
    } catch (e) {
      return;
    }
    if (seen) return;

    // AN ENTRANCE MADE ENTIRELY OF MOTION HAS NOTHING TO SHOW A READER WHO ASKED FOR NONE, so it does not
    // raise at all under reduced motion. The alternative — a still frame of the hero's terrain with the name
    // centred, held for two seconds — is a delay with no content, which is worse than no entrance. The
    // "finished state" the motion rule asks for is the homepage itself.
    try {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    } catch (e) { /* no matchMedia: treat as motion-allowed */ }

    var gate = document.querySelector('[data-gate]');
    if (!gate) return;

    try { window.sessionStorage.setItem(KEY, '1'); } catch (e) { /* best effort */ }

    var inerted = [];
    function setInert(on) {
      if (on) {
        for (var i = 0; i < document.body.children.length; i++) {
          var k = document.body.children[i];
          // INERT EVERY BODY CHILD EXCEPT THE OVERLAY, not just <main>: 18 focusable elements (the Toc links,
          // CornerNav's page and mark links, the menu button, the theme toggle) render AFTER </main>, so
          // inerting the landmark alone leaves something you can tab behind.
          if (k === gate || k.tagName === 'SCRIPT' || k.hasAttribute('inert')) continue;
          k.setAttribute('inert', '');
          inerted.push(k);
        }
      } else {
        for (var j = 0; j < inerted.length; j++) inerted[j].removeAttribute('inert');
        inerted = [];
      }
    }

    // ONE FLICK MUST NOT SCROLL THE PAGE BEHIND THE OVERLAY, and preventDefault alone does not achieve that:
    // Deck.astro also listens on window for wheel and its handler does not check defaultPrevented, so the deck
    // would move and the reveal would land on a later slide instead of the hero. stopImmediatePropagation is
    // what stops a sibling listener. `overflow: hidden` only suppresses the USER's scrolling mechanism —
    // window.scrollTo() still works — so it is not sufficient on its own either.
    var DECK_KEYS = [' ', 'PageDown', 'PageUp', 'Home', 'End', 'ArrowDown', 'ArrowUp', 'Spacebar'];
    function swallow(e) {
      e.stopImmediatePropagation();
      if (e.cancelable) e.preventDefault();
      land();
    }
    function onKey(e) {
      if (e.key === 'Tab' || DECK_KEYS.indexOf(e.key) !== -1 || e.key === 'Escape' || e.key === 'Enter') {
        e.stopImmediatePropagation();
        if (e.cancelable) e.preventDefault();
      }
      land();
    }

    // ANY GESTURE SKIPS TO THE END. This is the one thing an automatic overlay must get right: a forced wait a
    // reader cannot cut short is the failure mode that gets portfolios closed before they render. Every
    // listener that exists to swallow an input also lands the entrance, so the same flick that would have
    // scrolled the page instead finishes the animation — nothing is swallowed without doing something.
    var landed = false;
    function land() {
      if (landed) return;
      landed = true;
      window.dispatchEvent(new Event(LAND));   // the painter snaps its camera to the hero's and stops
      dismiss();
    }

    var autoTimer = 0;
    function dismiss() {
      window.clearTimeout(autoTimer);
      gate.classList.remove('is-up');
      document.documentElement.style.overflow = '';
      document.documentElement.removeAttribute(UP);
      setInert(false);
      window.removeEventListener('wheel', swallow);
      window.removeEventListener('touchmove', swallow);
      window.removeEventListener('touchend', swallow);
      window.removeEventListener('pointerdown', swallow);
      document.removeEventListener('keydown', onKey, true);
      document.removeEventListener('astro:before-swap', dismiss);

      // The canvases paused themselves while covered; tell them to resume. Dispatched NOW rather than after the
      // fade, so the hero is already painting its own identical frame underneath while the overlay fades out —
      // which is what makes the swap invisible rather than a cross-dissolve between two states.
      window.dispatchEvent(new Event(REVEAL));

      // A TIMER, never transitionend: under reduced motion there is no transition to fire and this would never
      // run, leaving the page scroll-locked forever. (It cannot happen today, since the overlay does not raise
      // under reduced motion — but the hazard is one CSS edit away and the cost of the timer is nothing.)
      window.setTimeout(function () {
        // The deck measured its stops while the document was scroll-locked; make it re-measure.
        window.dispatchEvent(new Event('resize'));
      }, MS);
    }

    gate.classList.add('is-up');
    document.documentElement.style.overflow = 'hidden';
    // Raised BEFORE the canvases initialise, because this script is inline and parse-time while theirs run on
    // astro:page-load — so they see the flag on their first check and never start a loop at all, rather than
    // starting one and being stopped a moment later.
    document.documentElement.setAttribute(UP, '');
    setInert(true);

    window.addEventListener('wheel', swallow, { passive: false });
    window.addEventListener('touchmove', swallow, { passive: false });
    window.addEventListener('touchend', swallow, { passive: true });
    window.addEventListener('pointerdown', swallow, { passive: true });
    document.addEventListener('keydown', onKey, true);
    // LISTENERS OUTLIVE THE DOM OTHERWISE. ClientRouter replaces document.body, so without a teardown
    // `swallow`/`onKey` keep calling preventDefault forever: wheel scrolling and Tab dead site-wide with
    // nothing on screen to explain it.
    document.addEventListener('astro:before-swap', dismiss);

    // AND IT ENDS ON ITS OWN. The painter also lands at ENTRANCE_MS; this is the backstop for the case where
    // the painter never starts — a module script that fails to load, or a browser without canvas. Without it a
    // failed painter would leave an opaque overlay up permanently, which is the worst available outcome.
    autoTimer = window.setTimeout(land, 2600);
  })();
</script>

<script>
  // ── THE ENTRANCE ITSELF ──────────────────────────────────────────────────────────────────────────────
  // An ordinary bundled module, NOT inline, and that is forced rather than chosen: the field is the hero's
  // terrain, which is hundreds of lines of Gaussian-mixture field, camera and eye-dome-lighting maths. It
  // cannot be restated in an inline script, so the split is policy inline (it must beat first paint) and
  // painting here (it may arrive a frame late, because the overlay is already up and opaque).
  import { buildGrid, paintTerrain, terrainConfig, type GridPoint } from '../lib/terrainRender';
  import {
    ENTRANCE_MS,
    GATE_LAND_EVENT as LAND,
    crossover,
    entranceZoom,
    haloAt,
    haloScale,
    nameTravel,
  } from '../lib/gate';
  import { prefersReducedMotion } from '../lib/motion';

  let raf = 0;
  let stop: (() => void) | null = null;

  function start(): void {
    const maybeGate = document.querySelector<HTMLElement>('[data-gate]');
    const maybeCanvas = document.querySelector<HTMLCanvasElement>('[data-gate-field]');
    const maybeText = document.querySelector<HTMLElement>('[data-gate-text]');
    const maybeBack = document.querySelector<HTMLElement>('[data-gate-back]');
    if (!maybeGate || !maybeCanvas || !maybeText || !maybeBack) return;
    // Non-null aliases straight after the guard: TypeScript does not carry a const's narrowing into the
    // hoisted functions below, which is the ts(18047) class CLAUDE.md warns will come back.
    const gate = maybeGate;
    const cvs = maybeCanvas;
    const text = maybeText;
    const back = maybeBack;

    // Nothing to do if the overlay is not covering — a repeat visit in the same session never raises it, and
    // neither does a reduced-motion reader.
    if (!gate.classList.contains('is-up') || prefersReducedMotion()) return;

    const ctx = cvs.getContext('2d');
    if (!ctx) return;
    const c2 = ctx;

    // THE HERO'S CANVAS IS THE TARGET, AND ITS GEOMETRY IS MEASURED RATHER THAN ASSUMED. `project` scales by
    // min(W, H) and centres at 0.46H, so the same zoom in a differently-shaped box is a different picture —
    // matching the hero's camera means matching its rect. Reading it also means a CSS change to #heights
    // cannot silently desynchronise the two.
    const hero = document.querySelector<HTMLCanvasElement>('#terrain');
    const heroName = document.querySelector<HTMLElement>('#heights .hero-rise h1');

    const cfg = terrainConfig(document.documentElement.dataset.theme === 'dark');
    const grid: GridPoint[] = buildGrid(cfg.edlParams);
    const heroZoom = cfg.zoom;

    let W = 0;
    let Hh = 0;
    let DPR = 1;

    function layout(): void {
      const r = hero ? hero.getBoundingClientRect() : { top: 0, left: 0, width: window.innerWidth, height: window.innerHeight * 1.08 };
      cvs.style.top = `${r.top}px`;
      cvs.style.left = `${r.left}px`;
      cvs.style.width = `${r.width}px`;
      cvs.style.height = `${r.height}px`;
      DPR = Math.min(2, window.devicePixelRatio || 1);
      W = cvs.width = Math.round(r.width * DPR);
      Hh = cvs.height = Math.round(r.height * DPR);
    }

    // THE NAME'S TRAVEL IS A FLIP, measured both ends. The overlay's name is centred and the hero's sits
    // bottom-left at a different size, so the move is a translate plus a scale computed from the two rects —
    // transform only, which is what the motion rule asks for and what the compositor wants.
    /**
     * THE NAME CROSSES OVER FROM IVORY TO THE HERO'S INK as the ground clears, and this is not decoration.
     *
     * The overlay opens on an opaque dark ground, where only a light name is legible. It LANDS on the hero's
     * luminous sky, where the hero's own name is dark ink. If the colour stayed put, the last thing a visitor
     * would see is the name changing colour at the swap — the one frame the whole design exists to make
     * invisible. So it is interpolated on the same curve as the ground.
     *
     * Read from the tokens rather than named here: `--paper` and `--ink-1` both re-declare per theme, and in
     * dark the ink ramp inverts, so hardcoding either would be wrong in one of the two themes.
     */
    const rgb = (v: string): [number, number, number] => {
      const t = v.trim();
      const hex = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(t);
      if (hex) {
        const h = hex[1].length === 3 ? hex[1].replace(/./g, (c) => c + c) : hex[1];
        return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as [number, number, number];
      }
      const n = t.match(/-?[\d.]+/g);
      return n && n.length >= 3 ? [+n[0], +n[1], +n[2]] : [239, 233, 221];
    };
    const rootCs = getComputedStyle(document.documentElement);
    const inkFrom = rgb(rootCs.getPropertyValue('--paper'));
    const inkTo = rgb(rootCs.getPropertyValue('--ink-1'));
    const inkToLast = rgb(rootCs.getPropertyValue('--ink-3'));
    // The halo's colour, read from the token like everything else here — `--paper` re-declares per theme and
    // naming a hex would be wrong in one of the two. Its STRENGTH is per-theme too, and measured rather than
    // branched: in dark, `--paper` and `--ink-1` are both cool near-whites, so the name barely crosses at all
    // and a near-white glow behind near-white glyphs only washes their edges. See haloScale.
    const hal = inkFrom;
    const halScale = haloScale(inkFrom, inkTo);
    const nameEl = text.querySelector<HTMLElement>('.gate-name');
    const rolesEl = text.querySelector<HTMLElement>('.gate-roles');
    const firstLetters = [...text.querySelectorAll<HTMLElement>('.gate-letter:not(.is-last)')];
    const lastLetters = [...text.querySelectorAll<HTMLElement>('.gate-letter.is-last')];
    const mix = (to: [number, number, number], p: number): string => {
      const c = inkFrom.map((v, i) => Math.round(v + (to[i] - v) * p));
      return `rgb(${c[0]},${c[1]},${c[2]})`;
    };

    let dx = 0;
    let dy = 0;
    let ds = 1;
    function measureTravel(): void {
      if (!heroName) return;
      const a = text.getBoundingClientRect();
      const b = heroName.getBoundingClientRect();
      const an = nameEl ? nameEl.getBoundingClientRect() : a;
      ds = an.width > 0 ? b.width / an.width : 1;
      dx = b.left + b.width / 2 - (an.left + an.width / 2);
      dy = b.top + b.height / 2 - (an.top + an.height / 2);
    }

    /** WHERE the name is. Position only — the colour is on its own, later clock; see applyCrossover. */
    function applyTravel(p: number): void {
      text.style.transform = `translate(${dx * p}px, ${dy * p}px) scale(${1 + (ds - 1) * p})`;
      // GONE by the time the name is halfway, rather than fading across the whole travel. The hero's own copy
      // is hidden while the stand-in is in flight so there is nothing to double, but at a quarter opacity under
      // a moving name it read as a smudge rather than as a crossfade.
      if (rolesEl) rolesEl.style.opacity = String(Math.max(0, 1 - p * 2.2));
    }

    /**
     * WHAT COLOUR the name is, and how much ground is left under it — one progress value for both, because they
     * are two halves of one event. See `crossover` in lib/gate.ts for why this is late, short, and shared: run
     * on separate wide clocks, the name's lightness ramp and its background's hugged each other and the name
     * measured dL* 6 mid-travel, i.e. invisible.
     */
    function applyCrossover(p: number): void {
      // TWO inks, because the hero uses two. One colour on the parent would land the surname on the wrong one
      // and the swap would show it.
      const a = mix(inkTo, p);
      const b = mix(inkToLast, p);
      for (const el of firstLetters) el.style.color = a;
      for (const el of lastLetters) el.style.color = b;
      // A paper veil, alive only while the ramps pass each other. The blur radius is BAKED — the taste rule
      // forbids animating a blur — so only the alpha moves.
      if (nameEl) {
        const h = haloAt(p) * halScale;
        nameEl.style.textShadow = h > 0.001
          ? `0 0 28px rgba(${hal[0]},${hal[1]},${hal[2]},${h.toFixed(3)})`
          : 'none';
      }
      back.style.opacity = String(1 - p);
    }

    layout();
    measureTravel();
    window.addEventListener('resize', () => { layout(); measureTravel(); });

    let t0 = 0;
    let done = false;

    function finish(): void {
      if (done) return;
      done = true;
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
      // Land exactly on the hero: its camera, its geometry, the name in its place. This is the frame that makes
      // the removal invisible, so it is painted explicitly rather than left to whatever the last tick managed.
      cfg.zoom = heroZoom;
      c2.clearRect(0, 0, W, Hh);
      paintTerrain(c2, grid, cfg, W, Hh, DPR, 0, 0.04);
      applyTravel(1);
      applyCrossover(1);
    }

    function frame(now: number): void {
      if (!t0) t0 = now;
      const ms = now - t0;

      cfg.zoom = heroZoom * entranceZoom(ms);
      c2.clearRect(0, 0, W, Hh);
      paintTerrain(c2, grid, cfg, W, Hh, DPR, ms / 1000, 0.04);
      applyTravel(nameTravel(ms));
      applyCrossover(crossover(ms));

      if (ms >= ENTRANCE_MS) {
        finish();
        // Tell the policy script to release the page. The painter owns the clock because it owns the frame the
        // landing has to be exact on; the inline script owns inert, scroll and teardown.
        window.dispatchEvent(new Event(LAND));
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    // A skip from the policy script (any gesture) finishes the picture immediately. Both scripts listen to the
    // same event, so one flick lands the camera AND releases the page.
    const onLand = (): void => finish();
    window.addEventListener(LAND, onLand);

    raf = requestAnimationFrame(frame);

    stop = () => {
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
      window.removeEventListener(LAND, onLand);
      stop = null;
    };
  }

  // Teardown on every exit, for the same reason the policy script has one: ClientRouter replaces document.body
  // and a rAF loop painting a canvas that is no longer in the document is pure waste.
  document.addEventListener('astro:before-swap', () => stop?.());
  document.addEventListener('astro:page-load', () => { stop?.(); start(); });
  if (document.readyState !== 'loading') start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
</script>
