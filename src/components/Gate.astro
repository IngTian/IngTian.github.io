---
// THE FIRST-VISIT ENTRANCE. Rendered from index.astro ONLY — never BaseLayout, so no other route can inherit
// a full-screen overlay. Moving it up one file is the single edit that would hand this to all nine routes.
//
// THE FIELD IS THE HERO'S OWN TERRAIN, AND THERE IS NO TEXT ON THIS SCREEN. The overlay paints the same
// Gaussian-mixture loss field the hero paints, through the same renderer, with a camera and a tempo that
// settle onto exactly the hero's. The owner's brief is the design: "a fluid field moving using the terrain we
// have. and then this terrain transforms into the terrain location we have then seamlessly into the hero. the
// name and other stuff just fades in."
//
// "The name just fades in" is why this component has no name in it. The HERO'S name fades in, underneath —
// which is what deletes the entire class of defects the previous attempt produced (a stand-in copy, a FLIP
// between two measured boxes, an ivory-to-ink colour crossover, two names on screen at once). The only thing
// this file owns is a canvas and the policy around it.
//
// THE ONE INVARIANT THAT MATTERS: this ships NOT COVERING, and JS raises it. The static HTML carries the
// overlay in its dismissed state and the inline script adds .is-up. An overlay that defaulted to covering
// would lock out every visitor whose JS failed and hide the page from anything that does not run scripts. The
// page's full markup is in the HTML either way, so this is a decoration, not a content gate — which is what
// keeps it crawlable. tests/distSmoke.test.ts asserts the shipped HTML carries no covering class.
import {
  GATE_DISMISS_MS,
  GATE_LAND_EVENT,
  GATE_REVEAL_EVENT,
  GATE_SEEN_KEY,
  GATE_UP_ATTR,
} from '../lib/gate';
---

{/* aria-hidden, and NOT a dialog. It was `role="dialog" aria-modal="true"` while a button existed to focus;
    with nothing to interact with, announcing a modal a reader can neither act on nor escape is worse than
    announcing nothing. The real <h1> is the hero's, underneath — which also retires the two-<h1> defect this
    component shipped once. */}
<div class="gate" data-gate aria-hidden="true">
  {/* The opaque ground. A SEPARATE element from the canvas rather than a background on `.gate`, because the
      canvas is positioned to the hero's measured box while the ground must cover the whole viewport. */}
  <div class="gate-back"></div>
  {/* Positioned and sized from the HERO CANVAS'S OWN rect by the painter — never from the viewport. `project`
      scales by `min(W, Hh)` and centres at `0.46 * Hh`, and `#heights` is 108vh, so on most desktop windows
      the hero's basis is its height and a 100vh overlay at the same `zoom` is a different picture in both
      scale and position. Measuring the rect also means a CSS change to `#heights` cannot silently
      desynchronise the two. */}
  <canvas class="gate-field" data-gate-field aria-hidden="true"></canvas>
</div>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    /* THE DISMISSED STATE IS THE RESTING STATE — trap 1. Shipping `is-up` in the markup would lock out any
       visitor whose JS failed. */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .gate.is-up {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* The ground the field is read against. Opaque for the whole entrance: the dots are ink-on-ink here, and
     the handover to the luminous sky happens during the DISMISSAL crossfade, with the terrain steady on top
     of it. That ordering is deliberate — see the note on `land()` in the painter. */
  .gate-back {
    position: absolute;
    inset: 0;
    /* THE SKY AT THE HEIGHTS, not `--bg`, and the difference is the whole legibility of the screen.
       This was `--bg` (near-black) for one build and the light theme's field nearly vanished: its terrain is
       DARK ink whose eye-dome shading spends itself on value rather than opacity, so it needs a luminous
       ground exactly as it has on the hero. `--sky-top` is the gradient's own 0% stop, which also makes the
       dismissal crossfade almost nothing — a flat ground giving way to the same colour with the sky's warp
       in it, behind a terrain that does not move. */
    background: var(--sky-top);
  }

  .gate-field {
    position: absolute;
    /* top/left/width/height are written by the painter from the hero canvas's rect. */
    display: block;
    pointer-events: none;
  }

  /* MATCH THE HERO'S PHONE TREATMENT. `#heights .terrain-canvas` drops to `opacity: 0.4` under this same
     query, and a second canvas does not inherit that — without this, a phone's entrance paints a field 2.5x
     stronger than the hero it lands on. (This is one of the hand-synced `max-width: 640px` blocks CLAUDE.md
     counts; if PHONE_MAX_WIDTH changes, change this with it.) */
  @media (max-width: 640px), (max-height: 520px) {
    .gate-field { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .gate { transition: opacity 600ms ease, visibility 600ms ease; }
  }
</style>

<script
  is:inline
  define:vars={{
    KEY: GATE_SEEN_KEY,
    MS: GATE_DISMISS_MS,
    UP: GATE_UP_ATTR,
    REVEAL: GATE_REVEAL_EVENT,
    LAND: GATE_LAND_EVENT,
  }}
>
  // POLICY ONLY — this script paints nothing. It is `is:inline` because it has to run before first paint:
  // that is what makes the entrance the first thing on screen rather than a flash of homepage followed by an
  // overlay. An inline script cannot import, so the rules it enforces are RESTATED here and unit-tested in
  // lib/gate.ts rather than shared, and every string or number it needs comes through define:vars, because a
  // restated constant drifts from its test silently.
  (function () {
    var gate = document.querySelector('[data-gate]');
    if (!gate) return;

    // FRESH LOAD ONLY. An inline script runs during parse, so readyState is 'loading' on a genuine
    // navigation; when ClientRouter re-executes this after a View Transition the document is already
    // 'complete'. Without the guard the overlay raised mid-session, over a homepage the visitor was already
    // going to. isFreshLoad() in lib/gate.ts owns this rule.
    if (document.readyState !== 'loading') return;

    var store = null;
    try { store = window.sessionStorage; } catch (e) { store = null; }

    // FAIL CLOSED: no store, or a store that throws, means do not raise. A visitor in a locked-down browser
    // gets the site, not a decoration they cannot dismiss.
    var seen = true;
    if (store) {
      try { seen = store.getItem(KEY) !== null; } catch (e) { seen = true; }
    }
    if (seen) return;

    function reduced() {
      try { return window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { return false; }
    }

    // AN ENTRANCE MADE ENTIRELY OF MOTION HAS NOTHING TO SHOW A READER WHO ASKED FOR NONE, so it does not
    // raise at all under reduced motion. The alternative — a still frame of the hero's terrain held for two
    // seconds — is a delay with no content, which is worse than no entrance. The "finished state" the motion
    // rule asks for is the homepage itself.
    if (reduced()) return;

    var done = false;
    var landed = false;
    var autoTimer = 0;

    // STOPIMMEDIATEPROPAGATION, NOT JUST PREVENTDEFAULT — and the difference is the whole bug this fixes.
    // preventDefault() cancels the browser's own scrolling; it does nothing to a SIBLING listener. Deck.astro
    // also listens on window for wheel, and its onWheel does NOT check e.defaultPrevented (it checks it for
    // keydown, but not for wheel). So one flick while the overlay was up ran the deck's tween —
    // window.scrollTo() still works under `overflow: hidden`, which by spec suppresses only the USER's
    // scrolling mechanism — and the reveal landed in the middle of a later slide, never showing the hero the
    // entrance exists to introduce.
    //
    // AND IT LANDS, rather than only swallowing. Every surveyed intro that landed well was skippable, and a
    // swallower that did not land would leave a reader flicking at a screen that ignores them. The listeners
    // that suppress input are the same ones that end the entrance, so nothing is swallowed without also
    // doing something. If you ever add a swallowing listener here that does not land, re-read this.
    function swallow(e) {
      if (done) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      land();
    }

    // The deck's keys have to be swallowed for the same reason. An earlier version handled Escape and Tab and
    // returned, so ArrowDown/PageDown/space/Home/End reached Deck.onKey and paged the document behind it.
    var DECK_KEYS = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' ', 'Spacebar'];

    function onKey(e) {
      if (done) return;
      if (e.key === 'Escape' || DECK_KEYS.indexOf(e.key) !== -1) {
        e.preventDefault();
        e.stopImmediatePropagation();
        land();
      }
    }

    // EVERY BODY CHILD EXCEPT THE OVERLAY, not just <main>. `inert` on main alone left 18 focusable elements
    // reachable — 7 Toc links, 5 CornerNav page links, 4 CornerNav mark links, the nav menu button and the
    // theme toggle, all of which render AFTER </main>.
    var inerted = [];
    function setInert(on) {
      if (on) {
        var kids = document.body.children;
        for (var i = 0; i < kids.length; i++) {
          var k = kids[i];
          if (k === gate || k.tagName === 'SCRIPT' || k.hasAttribute('inert')) continue;
          k.setAttribute('inert', '');
          inerted.push(k);
        }
      } else {
        for (var j = 0; j < inerted.length; j++) inerted[j].removeAttribute('inert');
        inerted = [];
      }
    }

    /**
     * THE LANDING. Called by the painter when its clock runs out, by any gesture, by Escape, and by the
     * backstop timer — whichever comes first. Idempotent.
     *
     * ORDER IS LOAD-BEARING, and it is the opposite of the obvious one:
     *
     *   1. Tell the painter to land. It snaps its camera to the hero's exact config and keeps mirroring it,
     *      so whatever is on the overlay's canvas from here on is the hero's own frame.
     *   2. Clear `data-gate-up` BEFORE firing REVEAL. The hero's `apply()` re-reads `isCovered()`, which
     *      tests that attribute — fire first and it computes "still covered" and does not resume.
     *   3. Fire REVEAL on `document`. That is the hero's channel (it listens on `document`, not `window` —
     *      dispatching on `window` is a separate channel and the hero never hears it). `last = 0` on resume
     *      means its first frame paints immediately.
     *   4. Only then start the dismissal, which crossfades the overlay out over 600ms. Both canvases are
     *      painting the same frame in the same box through that window, so the only thing that visibly changes
     *      is the ground giving way to the sky — the terrain is continuous across the seam, and the hero's
     *      name and bio fade up on the same clock.
     */
    function land() {
      if (landed) return;
      landed = true;
      if (autoTimer) { window.clearTimeout(autoTimer); autoTimer = 0; }
      window.dispatchEvent(new Event(LAND));
      document.documentElement.removeAttribute(UP);
      document.dispatchEvent(new Event(REVEAL));
      dismiss();
    }

    function dismiss() {
      if (done) return;            // idempotent: a gesture then the timer must not run this twice
      done = true;
      try { if (store) store.setItem(KEY, '1'); } catch (e) { /* denied; it reappears next load */ }

      gate.classList.remove('is-up');
      document.documentElement.style.overflow = '';
      document.documentElement.removeAttribute(UP);
      setInert(false);
      window.removeEventListener('wheel', swallow, { passive: false });
      window.removeEventListener('touchmove', swallow, { passive: false });
      window.removeEventListener('touchend', swallow);
      window.removeEventListener('pointerdown', swallow);
      document.removeEventListener('keydown', onKey, true);
      window.removeEventListener(LAND, land);
      document.removeEventListener('astro:before-swap', land);

      // A TIMER, never transitionend — under reduced motion no transition fires and this would never run,
      // leaving the page scroll-locked forever. dismissMs() in lib/gate.ts owns this number.
      window.setTimeout(function () {
        // The deck measured its stops while the document was scroll-locked; make it re-measure.
        window.dispatchEvent(new Event('resize'));
      }, MS);
    }

    gate.classList.add('is-up');
    document.documentElement.style.overflow = 'hidden';
    // Tells the hero and the sky to hold off while nothing they paint can be seen, and tells Heights to hold
    // the name, bio and roles at zero so they have something to fade IN from. Both jobs want exactly the same
    // lifetime, so they share one flag rather than racing two.
    document.documentElement.setAttribute(UP, '');
    setInert(true);
    window.addEventListener('wheel', swallow, { passive: false });
    window.addEventListener('touchmove', swallow, { passive: false });
    window.addEventListener('touchend', swallow, { passive: true });
    window.addEventListener('pointerdown', swallow, { passive: true });
    document.addEventListener('keydown', onKey, true);
    // THE PAINTER'S SIDE OF THE HANDSHAKE, and leaving it out is a bug this shipped once: the painter runs
    // the clock and dispatches LAND when it reaches the end, so without this listener the entrance only ever
    // ended via the backstop timer — measured, it ran 4000ms instead of 2600 and the terrain sat finished for
    // a second and a half. The channel is bidirectional on purpose (land() dispatches LAND to tell the
    // painter to stop tweening), and the `landed` guard is what keeps the self-dispatch from recursing.
    window.addEventListener(LAND, land);
    // Window/document listeners outlive the overlay's DOM: ClientRouter replaces document.body, so without
    // this `swallow`/`onKey` would keep calling preventDefault forever — wheel scrolling and Tab dead
    // site-wide with nothing on screen to explain it.
    document.addEventListener('astro:before-swap', land);

    // AND IT ENDS EVEN IF THE PAINTER NEVER RUNS. This is the worst case of an automatic overlay and it is
    // worse than anything the click gate could do: the entrance normally ends when the painter's clock runs
    // out, and the painter is a BUNDLED module. If it fails to load, throws on an old browser, or the canvas
    // context is unavailable, nothing would ever land and an opaque full-screen layer would sit over the site
    // permanently. This script cannot fail to run — it is parsed with the document — so it carries the
    // backstop. tests/distSmoke.test.ts asserts it exists and is bounded.
    autoTimer = window.setTimeout(land, 4000);
  })();
</script>

<script>
  // THE PAINTER. A bundled module, because it needs the terrain renderer and the entrance's schedule and
  // restating either would be the drift this whole design exists to avoid. It may arrive a frame late — the
  // overlay is already up and opaque by then, raised by the inline script above.
  import {
    BREATH_AMP_LIVE,
    BREATH_PERIOD_S,
    buildGrid,
    paintTerrain,
    terrainConfig,
    type GridPoint,
  } from '../lib/terrainRender';
  import {
    ENTRANCE_AZ_SWING,
    ENTRANCE_BREATH_FROM,
    ENTRANCE_EDL_SIZE_FROM,
    ENTRANCE_ELEV_EMPHASIS_FROM,
    ENTRANCE_MS,
    ENTRANCE_ZOOM_FROM,
    GATE_LAND_EVENT,
    breathPhaseOffset,
    entranceProgress,
  } from '../lib/gate';

  let teardown: (() => void) | null = null;

  function initEntrance(): void {
    teardown?.();
    teardown = null;

    const maybeCanvas = document.querySelector<HTMLCanvasElement>('[data-gate-field]');
    const maybeGate = document.querySelector<HTMLElement>('[data-gate]');
    // Only paint when the inline script actually raised the overlay. On a second visit in a session, on a
    // reduced-motion reader, or on any route but `/`, there is nothing to paint and no clock to run.
    if (!maybeCanvas || !maybeGate || !maybeGate.classList.contains('is-up')) return;
    const cvs = maybeCanvas;

    const maybeCtx = cvs.getContext('2d');
    if (!maybeCtx) return;
    const ctx = maybeCtx;

    // The hero's canvas is the geometry reference, not the viewport. If it is not in the document there is
    // no frame to land on, so do not start — the inline script's backstop still ends the entrance.
    const maybeHero = document.querySelector<HTMLCanvasElement>('#terrain');
    if (!maybeHero) return;
    const hero = maybeHero;

    // A FRESH CONFIG, never shared with the hero. The tween mutates zoom/light/edl on this object every
    // frame; one shared object would make the hero's picture follow the overlay's camera.
    const dark = document.documentElement.dataset.theme === 'dark';
    const cfg = terrainConfig(dark);
    const HERO_ZOOM = cfg.zoom;
    const HERO_AZ = cfg.light.az;
    const HERO_EDL_SIZE = cfg.edlSizeRange;
    const HERO_ELEV = cfg.elevEmphasis;

    // buildGrid, never a hand-rolled lattice: its loop accumulates floating point and stops at 2.52, giving
    // 1089 points and an asymmetric footprint, and `computeEDL` normalises by the p80 of the response over
    // the WHOLE set — so a "cleaner" lattice changes every dot's shade, not just the new ones.
    const grid: GridPoint[] = buildGrid(cfg.edlParams);

    let DPR = 1;
    let W = 0;
    let Hh = 0;

    /** Match the hero's canvas exactly: its box, its DPR, and its no-ctx.scale convention. */
    function layout(): void {
      const r = hero.getBoundingClientRect();
      cvs.style.top = `${r.top}px`;
      cvs.style.left = `${r.left}px`;
      cvs.style.width = `${r.width}px`;
      cvs.style.height = `${r.height}px`;
      DPR = Math.min(2, window.devicePixelRatio || 1);
      W = cvs.width = Math.round(r.width * DPR);
      Hh = cvs.height = Math.round(r.height * DPR);
      // No ctx.scale(DPR, DPR): paintTerrain works in device pixels and applies DPR to the dot radius
      // itself, so scaling the context and passing CSS dimensions would give both half-size dots and a
      // wrong scale basis.
    }

    let raf = 0;
    let t0 = 0;
    let landed = false;

    /** The hero's exact frame. Everything the tween touches is put back to the value the hero paints. */
    function heroFrame(tsec: number): void {
      cfg.zoom = HERO_ZOOM;
      cfg.light.az = HERO_AZ;
      cfg.edlSizeRange = HERO_EDL_SIZE;
      cfg.elevEmphasis = HERO_ELEV;
      ctx.clearRect(0, 0, W, Hh);
      paintTerrain(ctx, grid, cfg, W, Hh, DPR, tsec, BREATH_AMP_LIVE);
    }

    function frame(now: number): void {
      if (!t0) t0 = now;
      const ms = now - t0;

      if (landed || ms >= ENTRANCE_MS) {
        // MIRROR MODE. Past the landing the overlay keeps painting the hero's own frame on the hero's own
        // clock, so the 600ms dismissal crossfade is between two identical pictures and the only thing that
        // changes is the ground giving way to the sky.
        heroFrame(now / 1000);
        if (!landed) {
          landed = true;
          window.dispatchEvent(new Event(GATE_LAND_EVENT));
        }
        raf = requestAnimationFrame(frame);
        return;
      }

      const p = entranceProgress(ms);
      cfg.zoom = (ENTRANCE_ZOOM_FROM + (1 - ENTRANCE_ZOOM_FROM) * p) * HERO_ZOOM;
      cfg.light.az = HERO_AZ + ENTRANCE_AZ_SWING * (1 - p);
      cfg.edlSizeRange = ENTRANCE_EDL_SIZE_FROM + (HERO_EDL_SIZE - ENTRANCE_EDL_SIZE_FROM) * p;
      cfg.elevEmphasis = ENTRANCE_ELEV_EMPHASIS_FROM + (HERO_ELEV - ENTRANCE_ELEV_EMPHASIS_FROM) * p;
      const breathAmp = ENTRANCE_BREATH_FROM + (BREATH_AMP_LIVE - ENTRANCE_BREATH_FROM) * p;

      // THE CLOCK IS THE HERO'S, MINUS A WHOLE NUMBER OF BREATH PERIODS' WORTH OF PHASE.
      // The hero passes `rAF timestamp / 1000`, i.e. time since navigation start, and the two share an
      // origin with performance.now(). Subtracting a decaying offset runs the field fast-forward and lets it
      // decelerate; because the offset is a WHOLE number of periods it is invisible in `sin`, so the moment
      // it reaches zero the overlay is on the hero's exact phase. An offset of any other size would leave
      // every dot displaced by up to ±8.8 CSS px relative to the hero's next frame.
      const tsec = now / 1000 - breathPhaseOffset(p, BREATH_PERIOD_S);

      ctx.clearRect(0, 0, W, Hh);
      paintTerrain(ctx, grid, cfg, W, Hh, DPR, tsec, breathAmp);
      raf = requestAnimationFrame(frame);
    }

    // A land from the policy script (a gesture, Escape, or the backstop) finishes the picture immediately.
    function onLand(): void {
      landed = true;
    }

    const onResize = (): void => { layout(); };

    layout();
    window.addEventListener('resize', onResize);
    window.addEventListener(GATE_LAND_EVENT, onLand);
    raf = requestAnimationFrame(frame);

    teardown = () => {
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
      window.removeEventListener('resize', onResize);
      window.removeEventListener(GATE_LAND_EVENT, onLand);
    };
    document.addEventListener('astro:before-swap', () => { teardown?.(); teardown = null; }, { once: true });
  }

  // THE THEME CAN FLIP MID-ENTRANCE. The toggle fires `theme:change`, and a painter that read the palette
  // once at start would keep the old ramp, darkness and dotScale and land on a differently-coloured hero.
  document.addEventListener('theme:change', initEntrance);
  document.addEventListener('astro:page-load', initEntrance);
  initEntrance();
</script>
