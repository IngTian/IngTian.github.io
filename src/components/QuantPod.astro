---
// src/components/QuantPod.astro
// The pod as a full-bleed pixel-art ROOM that the page ends inside.
//
// WHY FULL-BLEED: framed in a 1180px box with its edges masked, the room read as a
// picture hanging in the sky rather than a place you had arrived at. Taking the full
// width makes it the environment, and it dissolves the seam problem entirely — there
// is no edge to blend when there is no edge. The descent's sky ends here on purpose;
// the links and the seal sit INSIDE the room. Documented as a deliberate exception to
// "one continuous sky" in CLAUDE.md.
//
// WHY LOW-RES: real pixel art is authored in a small buffer and scaled up. The room
// paints into a fixed 480x280 canvas which CSS blows up with image-rendering:
// pixelated. That is why every edge is crisp and every detail is deliberate — and it
// makes the paint cost independent of viewport size.
//
// THE ACCESSIBILITY CONTRACT (unchanged):
//   - ONE canvas, aria-hidden, pure decoration.
//   - Every destination is a REAL focusable element positioned by PERCENTAGE over its
//     monitor: <a> to navigate, <button> to announce "coming". Keyboard, screen
//     readers and JS-off all work with no separate accessible path.
//   - No React island. Vanilla script, re-inits on astro:page-load with teardown,
//     matching TerrainHero / Toc / artGallery.
import { roomScreens, ROOM_W, ROOM_H } from '../lib/podRoom';
import { SCREEN_CONTENT, ganttBars } from '../lib/podScreens';
import { timeline } from '../data/profile';

// Percentages of the buffer — resolution independent, so no JS on resize.
const rects = roomScreens();
const slots = SCREEN_CONTENT.map((s) => ({ ...s, rect: rects.find((r) => r.slot === s.slot)! }));
// Computed at BUILD time and serialised, so the first paint does no data work.
const gantt = ganttBars(timeline, 2026);
---
<section id="pod" class="pod" aria-labelledby="pod-heading">
  <h2 id="pod-heading" class="sr-only">The desk — where to find my work</h2>

  <div class="pod-frame">
    <canvas
      class="pod-canvas"
      data-pod-canvas
      width={ROOM_W}
      height={ROOM_H}
      data-gantt={JSON.stringify(gantt)}
      aria-hidden="true"
    ></canvas>

    <!-- Style lab: TEMPORARY scaffolding so the two art directions can be judged live,
         because small-detail screenshots are unjudgeable. One of these gets baked in and
         this block is deleted. -->
    <div class="pod-lab" role="group" aria-label="Room art style">
      <button type="button" class="pod-lab-btn" data-pod-style-btn="scene">1 · modernist</button>
      <button type="button" class="pod-lab-btn" data-pod-style-btn="retro">2 · console</button>
      <button type="button" class="pod-lab-btn" data-pod-style-btn="pixel">3 · pixel art</button>
    </div>

    <!-- The real interface, over the painted screens. -->
    <ul class="pod-hits">
      {slots.map((s) => (
        <li
          class="pod-hit-wrap"
          data-base-rect={`${s.rect.left},${s.rect.top},${s.rect.width},${s.rect.height}`}
          style={`left:${s.rect.left}%;top:${s.rect.top}%;width:${s.rect.width}%;height:${s.rect.height}%`}
        >
          {s.href ? (
            <a class="pod-hit" data-slot={String(s.slot)} href={s.href}>
              <span class="pod-hit-label">{s.label}</span>
            </a>
          ) : (
            <button class="pod-hit" data-slot={String(s.slot)} type="button" aria-live="polite">
              <span class="pod-hit-label">{s.label}</span>
              <span class="pod-hit-soon">{s.announce}</span>
            </button>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Full-bleed: break out of the page's content column and own the width. */
  .pod {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-block: 6vh 0;
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  /* The buffer's own aspect, so the percentage overlay always lines up. */
  .pod-frame { position: relative; width: 100%; aspect-ratio: 1600 / 880; }
  .pod-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
    /* Smooth by default — the retrofuturist style wants its curved glass and chrome
       gradients interpolated. The pixel style adds .is-pixel to get hard pixels instead;
       image-rendering is that style's entire look and this one's enemy. */
    image-rendering: auto;
    /* Only the TOP needs dissolving — the room's own dark floor carries the bottom
       into the page, and the links sit on it. */
    mask-image: linear-gradient(to bottom, transparent 0, black 7%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 7%);
  }

  .pod-canvas.is-pixel { image-rendering: pixelated; }

  /* Style lab — temporary scaffolding, deleted when a style is chosen. */
  .pod-lab {
    position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
    z-index: 3; display: flex; gap: 6px;
    padding: 5px; border-radius: 999px;
    background: rgb(0 0 0 / 0.55); backdrop-filter: blur(8px);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .pod-lab-btn {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
    padding: 5px 12px; border-radius: 999px; cursor: pointer;
    background: transparent; border: 0; color: var(--ink-3);
  }
  .pod-lab-btn[aria-pressed='true'] { background: var(--ochre); color: var(--on-accent); }
  .pod-lab-btn:focus-visible { outline: 1px solid var(--ochre); outline-offset: 2px; }

  .pod-hits { position: absolute; inset: 0; list-style: none; margin: 0; padding: 0; }
  .pod-hit-wrap { position: absolute; }
  .pod-hit {
    display: flex; flex-direction: column; justify-content: flex-end; gap: 2px;
    width: 100%; height: 100%; padding: 4px;
    background: transparent; border: 0; cursor: pointer;
    text-decoration: none; text-align: left; font-family: var(--font-mono);
    color: var(--paper);
  }
  /* Labels ride just BELOW the monitor so they never cover the screen art. */
  .pod-hit-label {
    position: absolute; top: calc(100% + 8px); left: 0;
    font-size: clamp(8px, 0.72vw, 11px); letter-spacing: 0.18em;
    text-transform: uppercase; white-space: nowrap;
    opacity: 0.55; transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .pod-hit-soon {
    position: absolute; top: calc(100% + 22px); left: 0;
    font-size: clamp(7px, 0.6vw, 9px); letter-spacing: 0.06em; white-space: nowrap;
    color: var(--ink-4); opacity: 0; transition: opacity 0.25s ease;
  }
  .pod-hit:hover .pod-hit-label,
  .pod-hit:focus-visible .pod-hit-label { opacity: 1; }
  .pod-hit:hover .pod-hit-soon,
  .pod-hit:focus-visible .pod-hit-soon { opacity: 1; }
  .pod-hit:focus-visible {
    outline: 1px solid var(--ochre); outline-offset: 3px; border-radius: 1px;
  }

  /* Narrow screens: the room is too wide to read, so the destinations become a plain
     labelled list. Same content, no scene — a finished state, not a broken one. */
  @media (max-width: 720px) {
    .pod { width: auto; margin-left: 0; }
    .pod-frame { aspect-ratio: auto; }
    .pod-canvas { display: none; }
    .pod-hits { position: static; display: grid; gap: 10px; }
    .pod-hit-wrap { position: static !important; width: auto !important; height: auto !important; }
    .pod-hit {
      border: 1px solid var(--rule); border-radius: 10px; padding: 14px 16px;
      min-height: 52px; justify-content: center;
    }
    .pod-hit-label, .pod-hit-soon { position: static; opacity: 1; }
    .pod-hit-soon { margin-top: 2px; }
  }
</style>

<script>
  import { ROOM_W, ROOM_H } from '../lib/podRoom';
  import { paintRoom } from '../lib/podRoomPaint';
  import { paintRetroRoom } from '../lib/podRoomRetro';
  import { paintScene, sceneScreens } from '../lib/podScene';
  import { prefersReducedMotion } from '../lib/motion';

  type PodStyle = 'scene' | 'retro' | 'pixel';
  const STYLE_KEY = 'podStyle';

  /** Three painters over shared geometry. 'scene' is flat modernist architecture on the
   *  one-true-camera (podCamera); 'retro' is the 1960s console; 'pixel' is the pixel-art
   *  room. Modernist is the default while it is being evaluated. */
  const currentStyle = (): PodStyle =>
    (document.documentElement.dataset.podStyle as PodStyle) || 'scene';

  const teardowns: Array<() => void> = [];

  function initPods(): void {
    while (teardowns.length) teardowns.pop()!();
    document.querySelectorAll<HTMLCanvasElement>('[data-pod-canvas]').forEach((cvs) => {
      const t = initPod(cvs);
      if (t) teardowns.push(t);
    });
  }

  function initPod(cvs: HTMLCanvasElement): (() => void) | null {
    const ctx = cvs.getContext('2d');
    if (!ctx) return null;

    const gantt = JSON.parse(cvs.dataset.gantt || '[]');
    const theme = (): 'light' | 'dark' =>
      document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

    // The buffer is FIXED — no DPR, no resize sizing. Paint cost is constant and CSS does
    // the scaling, which is what keeps a 1600x880 room cheap to repaint on hover.
    cvs.width = ROOM_W;
    cvs.height = ROOM_H;

    let hoverSlot: number | null = null;
    let t0 = 0;

    // The modernist scene lays its screens out in world space, so its hit areas differ
    // from the other two styles'. The overlay follows the ACTIVE style — if it did not,
    // the click targets would silently drift off the painted screens.
    const wraps = Array.from(
      (cvs.parentElement as HTMLElement).querySelectorAll<HTMLElement>('.pod-hit-wrap'),
    );
    const applyRects = (style: PodStyle) => {
      const rects = style === 'scene' ? sceneScreens(ROOM_W, ROOM_H) : null;
      for (const wrap of wraps) {
        const slot = Number(wrap.querySelector<HTMLElement>('.pod-hit')?.dataset.slot);
        if (rects) {
          const r = rects.find((x) => x.slot === slot);
          if (!r) continue;
          wrap.style.left = `${r.left}%`; wrap.style.top = `${r.top}%`;
          wrap.style.width = `${r.width}%`; wrap.style.height = `${r.height}%`;
        } else if (wrap.dataset.baseRect) {
          const [l, tp, w, h] = wrap.dataset.baseRect.split(',');
          wrap.style.left = `${l}%`; wrap.style.top = `${tp}%`;
          wrap.style.width = `${w}%`; wrap.style.height = `${h}%`;
        }
      }
    };

    // Last animation timestamp, so a hover repaint while the loop is running does not
    // rewind the sun and the water to t=0 (a bare draw() would). `function` rather than
    // `const` so redraw() can reference it above its own definition without a TDZ error.
    let lastNow = 0;
    function redraw() { draw(lastNow); }

    function draw(nowMs = lastNow) {
      lastNow = nowMs;
      const style = currentStyle();
      // image-rendering is the pixel style's whole look and the other two styles' enemy.
      cvs.classList.toggle('is-pixel', style === 'pixel');
      cvs.classList.toggle('is-scene', style === 'scene');
      const t = t0 ? (nowMs - t0) / 1000 : 0;
      if (style === 'pixel') paintRoom(ctx, { theme: theme(), hoverSlot, gantt });
      else if (style === 'retro') paintRetroRoom(ctx, { theme: theme(), hoverSlot, gantt });
      else paintScene(ctx, ROOM_W, ROOM_H, { theme: theme(), hoverSlot, gantt, t });
    }

    const frame = cvs.parentElement!;
    const hits = Array.from(frame.querySelectorAll<HTMLElement>('.pod-hit'));
    const onEnter = (e: Event) => {
      hoverSlot = Number((e.currentTarget as HTMLElement).dataset.slot);
      redraw();
    };
    const onLeave = () => { hoverSlot = null; redraw(); };
    for (const h of hits) {
      h.addEventListener('pointerenter', onEnter);
      h.addEventListener('focus', onEnter);
      h.addEventListener('pointerleave', onLeave);
      h.addEventListener('blur', onLeave);
      // The two announcing controls must not navigate.
      if (h.tagName === 'BUTTON') h.addEventListener('click', (ev) => ev.preventDefault());
    }

    // Style lab wiring — temporary, removed with the lab itself.
    const labBtns = Array.from(frame.querySelectorAll<HTMLButtonElement>('[data-pod-style-btn]'));
    const syncLab = () => {
      const s = currentStyle();
      for (const b of labBtns) b.setAttribute('aria-pressed', String(b.dataset.podStyleBtn === s));
    };
    const setStyle = (s: PodStyle) => {
      document.documentElement.dataset.podStyle = s;
      try { localStorage.setItem(STYLE_KEY, s); } catch { /* private mode */ }
      syncLab();
      applyRects(s);
      restartLoop();
    };
    const onLab = (e: Event) => {
      setStyle((e.currentTarget as HTMLElement).dataset.podStyleBtn as PodStyle);
    };
    for (const b of labBtns) b.addEventListener('click', onLab);
    const onKey = (e: KeyboardEvent) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      const s: PodStyle | null =
        e.key === '1' ? 'scene' : e.key === '2' ? 'retro' : e.key === '3' ? 'pixel' : null;
      if (s) setStyle(s);
    };
    window.addEventListener('keydown', onKey);
    syncLab();

    // ── Ambient life. ONLY the modernist scene moves, and only slowly: the sun drifts, the
    // pool's highlights slide, the birds shift. Gated three ways — the style must be
    // 'scene', the section must be on screen (IntersectionObserver), and the visitor must
    // not have asked for reduced motion. Under reduced motion the static first frame is
    // the finished picture, which is also the no-JS state.
    let raf = 0;
    let onScreen = true;
    const reduce = prefersReducedMotion();

    const frameLoop = (now: number) => {
      if (!t0) t0 = now;
      draw(now);
      raf = requestAnimationFrame(frameLoop);
    };
    const stopLoop = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };
    const restartLoop = () => {
      stopLoop();
      if (currentStyle() === 'scene' && onScreen && !reduce) raf = requestAnimationFrame(frameLoop);
      else draw();
    };

    const io = new IntersectionObserver((entries) => {
      onScreen = entries.some((e) => e.isIntersecting);
      restartLoop();
    }, { rootMargin: '120px' });
    io.observe(cvs.parentElement as HTMLElement);

    applyRects(currentStyle());
    restartLoop();   // paints a static first frame immediately — this is the LCP paint

    const mo = new MutationObserver(() => { syncLab(); applyRects(currentStyle()); restartLoop(); });
    mo.observe(document.documentElement, {
      attributes: true, attributeFilter: ['data-theme', 'data-pod-style'],
    });

    return () => {
      stopLoop();
      io.disconnect();
      mo.disconnect();
      window.removeEventListener('keydown', onKey);
      for (const b of labBtns) b.removeEventListener('click', onLab);
      for (const h of hits) {
        h.removeEventListener('pointerenter', onEnter);
        h.removeEventListener('focus', onEnter);
        h.removeEventListener('pointerleave', onLeave);
        h.removeEventListener('blur', onLeave);
      }
    };
  }

  // Restore the chosen style before the first paint, so switching does not flash.
  function restoreStyle(): void {
    try {
      const s = localStorage.getItem(STYLE_KEY);
      if (s === 'pixel' || s === 'retro') document.documentElement.dataset.podStyle = s;
    } catch { /* private mode */ }
  }

  restoreStyle();
  document.addEventListener('astro:page-load', initPods);
</script>
