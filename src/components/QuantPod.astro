---
// src/components/QuantPod.astro
// The pod as a full-bleed pixel-art ROOM that the page ends inside.
//
// WHY FULL-BLEED: framed in a 1180px box with its edges masked, the room read as a
// picture hanging in the sky rather than a place you had arrived at. Taking the full
// width makes it the environment, and it dissolves the seam problem entirely — there
// is no edge to blend when there is no edge. The descent's sky ends here on purpose;
// the links and the seal sit INSIDE the room. Documented as a deliberate exception to
// "one continuous sky" in CLAUDE.md.
//
// WHY LOW-RES: real pixel art is authored in a small buffer and scaled up. The room
// paints into a fixed 480x280 canvas which CSS blows up with image-rendering:
// pixelated. That is why every edge is crisp and every detail is deliberate — and it
// makes the paint cost independent of viewport size.
//
// THE ACCESSIBILITY CONTRACT (unchanged):
//   - ONE canvas, aria-hidden, pure decoration.
//   - Every destination is a REAL focusable element positioned by PERCENTAGE over its
//     monitor: <a> to navigate, <button> to announce "coming". Keyboard, screen
//     readers and JS-off all work with no separate accessible path.
//   - No React island. Vanilla script, re-inits on astro:page-load with teardown,
//     matching TerrainHero / Toc / artGallery.
import { roomScreens, ROOM_W, ROOM_H } from '../lib/podRoom';
import { SCREEN_CONTENT, ganttBars } from '../lib/podScreens';
import { timeline } from '../data/profile';

// Percentages of the buffer — resolution independent, so no JS on resize.
const rects = roomScreens();
const slots = SCREEN_CONTENT.map((s) => ({ ...s, rect: rects.find((r) => r.slot === s.slot)! }));
// Computed at BUILD time and serialised, so the first paint does no data work.
const gantt = ganttBars(timeline, 2026);
---
<section id="pod" class="pod" aria-labelledby="pod-heading">
  <h2 id="pod-heading" class="sr-only">The desk — where to find my work</h2>

  <div class="pod-frame">
    <canvas
      class="pod-canvas"
      data-pod-canvas
      width={ROOM_W}
      height={ROOM_H}
      data-gantt={JSON.stringify(gantt)}
      aria-hidden="true"
    ></canvas>

    <!-- The real interface, over the painted screens. -->
    <ul class="pod-hits">
      {slots.map((s) => (
        <li
          class="pod-hit-wrap"
          style={`left:${s.rect.left}%;top:${s.rect.top}%;width:${s.rect.width}%;height:${s.rect.height}%`}
        >
          {s.href ? (
            <a class="pod-hit" data-slot={String(s.slot)} href={s.href}>
              <span class="pod-hit-label">{s.label}</span>
            </a>
          ) : (
            <button class="pod-hit" data-slot={String(s.slot)} type="button" aria-live="polite">
              <span class="pod-hit-label">{s.label}</span>
              <span class="pod-hit-soon">{s.announce}</span>
            </button>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Full-bleed: break out of the page's content column and own the width. */
  .pod {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-block: 6vh 0;
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  /* The buffer's own aspect, so the percentage overlay always lines up. */
  .pod-frame { position: relative; width: 100%; aspect-ratio: 1600 / 880; }
  .pod-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
    /* THE pixel-art line: scale the small buffer up with hard pixels, no blur. */
    image-rendering: pixelated;
    /* Only the TOP needs dissolving — the room's own dark floor carries the bottom
       into the page, and the links sit on it. */
    mask-image: linear-gradient(to bottom, transparent 0, black 7%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 7%);
  }

  .pod-hits { position: absolute; inset: 0; list-style: none; margin: 0; padding: 0; }
  .pod-hit-wrap { position: absolute; }
  .pod-hit {
    display: flex; flex-direction: column; justify-content: flex-end; gap: 2px;
    width: 100%; height: 100%; padding: 4px;
    background: transparent; border: 0; cursor: pointer;
    text-decoration: none; text-align: left; font-family: var(--font-mono);
    color: var(--paper);
  }
  /* Labels ride just BELOW the monitor so they never cover the screen art. */
  .pod-hit-label {
    position: absolute; top: calc(100% + 8px); left: 0;
    font-size: clamp(8px, 0.72vw, 11px); letter-spacing: 0.18em;
    text-transform: uppercase; white-space: nowrap;
    opacity: 0.55; transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .pod-hit-soon {
    position: absolute; top: calc(100% + 22px); left: 0;
    font-size: clamp(7px, 0.6vw, 9px); letter-spacing: 0.06em; white-space: nowrap;
    color: var(--ink-4); opacity: 0; transition: opacity 0.25s ease;
  }
  .pod-hit:hover .pod-hit-label,
  .pod-hit:focus-visible .pod-hit-label { opacity: 1; }
  .pod-hit:hover .pod-hit-soon,
  .pod-hit:focus-visible .pod-hit-soon { opacity: 1; }
  .pod-hit:focus-visible {
    outline: 1px solid var(--ochre); outline-offset: 3px; border-radius: 1px;
  }

  /* Narrow screens: the room is too wide to read, so the destinations become a plain
     labelled list. Same content, no scene — a finished state, not a broken one. */
  @media (max-width: 720px) {
    .pod { width: auto; margin-left: 0; }
    .pod-frame { aspect-ratio: auto; }
    .pod-canvas { display: none; }
    .pod-hits { position: static; display: grid; gap: 10px; }
    .pod-hit-wrap { position: static !important; width: auto !important; height: auto !important; }
    .pod-hit {
      border: 1px solid var(--rule); border-radius: 10px; padding: 14px 16px;
      min-height: 52px; justify-content: center;
    }
    .pod-hit-label, .pod-hit-soon { position: static; opacity: 1; }
    .pod-hit-soon { margin-top: 2px; }
  }
</style>

<script>
  import { ROOM_W, ROOM_H } from '../lib/podRoom';
  import { paintRoom } from '../lib/podRoomPaint';

  const teardowns: Array<() => void> = [];

  function initPods(): void {
    while (teardowns.length) teardowns.pop()!();
    document.querySelectorAll<HTMLCanvasElement>('[data-pod-canvas]').forEach((cvs) => {
      const t = initPod(cvs);
      if (t) teardowns.push(t);
    });
  }

  function initPod(cvs: HTMLCanvasElement): (() => void) | null {
    const ctx = cvs.getContext('2d');
    if (!ctx) return null;

    const gantt = JSON.parse(cvs.dataset.gantt || '[]');
    const theme = (): 'light' | 'dark' =>
      document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

    // The buffer is FIXED — no DPR, no resize sizing. That is the whole point of a
    // low-res pixel buffer: paint cost is constant and CSS does the scaling.
    cvs.width = ROOM_W;
    cvs.height = ROOM_H;

    let hoverSlot: number | null = null;
    const draw = () => paintRoom(ctx, { theme: theme(), hoverSlot, gantt });

    const frame = cvs.parentElement!;
    const hits = Array.from(frame.querySelectorAll<HTMLElement>('.pod-hit'));
    const onEnter = (e: Event) => {
      hoverSlot = Number((e.currentTarget as HTMLElement).dataset.slot);
      draw();
    };
    const onLeave = () => { hoverSlot = null; draw(); };
    for (const h of hits) {
      h.addEventListener('pointerenter', onEnter);
      h.addEventListener('focus', onEnter);
      h.addEventListener('pointerleave', onLeave);
      h.addEventListener('blur', onLeave);
      // The two announcing controls must not navigate.
      if (h.tagName === 'BUTTON') h.addEventListener('click', (ev) => ev.preventDefault());
    }

    draw();   // static first frame immediately — this is the LCP paint

    // Repaint only on hover and theme change. Nothing animates: a dark room lit by
    // screens is alive without motion, so there is no rAF loop at all and the
    // reduced-motion state is the same finished picture.
    const mo = new MutationObserver(draw);
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    return () => {
      mo.disconnect();
      for (const h of hits) {
        h.removeEventListener('pointerenter', onEnter);
        h.removeEventListener('focus', onEnter);
        h.removeEventListener('pointerleave', onLeave);
        h.removeEventListener('blur', onLeave);
      }
    };
  }

  document.addEventListener('astro:page-load', initPods);
</script>
