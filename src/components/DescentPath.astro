---
// src/components/DescentPath.astro
// THE CAREER AS A DESCENT — one named trajectory on the site's own loss field, in 2D or 3D, with
// the trail drawn as it was walked.
//
// The owner's framing: "I'm almost running a gradient descent on my own while finding that we are
// at a LOCAL MIN in the SDE — that's why we adapted and intended to find the GLOBAL MIN." And the
// correction that matters most: "I have no idea where the global min is. Maybe a future quant
// researcher." So the deepest point is drawn as an UNKNOWN and the trail stops short of it.
//
// WHY THIS IS NOT THE HERO AGAIN. A reviewer flagged that contouring terrain.ts's field() is the
// hero's object with different hatching, and that is a fair charge against a REPLACEMENT for the
// hero. Here the field is deliberately the same field, because the point is that this is the same
// landscape the whole site is about — but the hero shows an anonymous surface with anonymous
// walkers, and this shows ONE trajectory, named, with its barrier called out. Same field,
// different subject. The caption says so rather than pretending the surface is new.
//
// No React island (the terminal is the only one). Vanilla script, re-inits on astro:page-load with
// teardown, matching TerrainHero / Toc. Canvas is decoration; the waypoints are a real <ol> so the
// content works with JS off and for a screen reader.
import { WAYPOINTS, trajectoryFacts } from '../lib/trajectory';

const facts = trajectoryFacts();
---
<section id="descent-path" class="dp" aria-labelledby="dp-heading">
  <header class="dp-head">
    <h2 id="dp-heading">A descent, with one climb</h2>
    <p class="dp-lede">
      The same loss surface the page opens with — but one named path across it. The engineering
      years sit in a real local minimum. Leaving it costs a
      <strong>{facts.climbRequired.toFixed(2)} climb</strong>, because a gradient method cannot
      walk out of a basin. That climb is the whole story.
    </p>

    <!-- 3D was offered as a comparison and lost: the relief view measured 2.0% ink against the
         plan view's 3.4% because the surface itself was never rendered, so it read as a 2D curve on
         a distorted grid. The owner chose plan, so the control is gone rather than left as a
         half-good option. descentPath.ts keeps the projection parameter, which costs nothing. -->
    <div class="dp-controls">
      <button type="button" class="dp-btn dp-replay" data-replay>replay the walk</button>
    </div>

    <!-- A live readout, so the reveal reads as a WALK with a state rather than a fade-in. It also
         states the discovery moment, which is the point of the whole device. -->
    <p class="dp-readout" data-readout aria-live="polite"></p>
  </header>

  <div class="dp-stage" data-dp-stage>
    <canvas class="dp-canvas" data-dp-canvas aria-hidden="true"></canvas>
    <p class="dp-fallback" data-dp-fallback>
      A contour map of a non-convex loss surface with a career path crossing a ridge between two
      basins. The list below carries the same information.
    </p>
  </div>

  <!-- The accessible path. Visually hidden because the graph's own labels already name every stop —
       a repeated list on screen said the same thing twice and pulled the section back toward the
       resume format this whole piece exists to avoid. Screen readers and no-JS still get everything,
       in order. -->
  <ol class="dp-stops sr-only">
    {WAYPOINTS.map((w) => (
      <li>
        <span>{w.period}</span> — <strong>{w.label}</strong>. {w.learned}
      </li>
    ))}
  </ol>

  <p class="dp-foot">
    The deepest point is not marked. Where the global minimum actually is remains unknown — the
    descent is still running.
  </p>
</section>

<style>
  .dp { position: relative; padding: 12vh 0 8vh; }
  .dp-head { max-width: 70ch; }
  .dp-head h2 {
    font-family: var(--font-display); font-size: clamp(26px, 3vw, 38px); font-weight: 300;
    color: var(--paper); margin: 0;
  }
  .dp-lede {
    font-size: 15.5px; line-height: 1.75; color: var(--ink-3); margin: 14px 0 0;
  }
  .dp-lede strong { color: var(--ochre); font-weight: 400; }

  .dp-readout {
    margin: 14px 0 0; min-height: 1.5em;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--ink-4);
  }
  .dp-readout b { color: var(--ochre); font-weight: 400; }
  .dp-readout i { color: var(--seal); font-style: normal; }

  .dp-controls { display: flex; gap: 8px; margin: 22px 0 0; }
  .dp-btn {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; padding: 7px 14px; cursor: pointer;
    background: transparent; color: var(--ink-4);
    border: 1px solid rgba(var(--hairline-rgb), 0.3); border-radius: 2px;
  }
  .dp-btn:hover { color: var(--paper); border-color: rgba(var(--hairline-rgb), 0.55); }
  .dp-btn:focus-visible { outline: 1px solid var(--ochre); outline-offset: 2px; }


  .dp-stage {
    position: relative; margin: 3vh 0 0; width: 100%; aspect-ratio: 16 / 9;
    transition: opacity .18s ease;
  }
  .dp-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* The fallback text sits under the canvas and is revealed only when the canvas cannot draw, so
     the no-JS state is informative rather than an empty box. */
  .dp-fallback {
    position: absolute; inset: 0; display: grid; place-items: center; text-align: center;
    margin: 0; padding: 0 12%; font-size: 14px; line-height: 1.7; color: var(--ink-4);
  }
  .dp-stage.is-live .dp-fallback { display: none; }


  .dp-foot {
    margin: 4vh 0 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em;
    color: var(--ink-5); max-width: 64ch;
  }

  /* Narrow screens: the graph's in-frame labels collide below ~720px, so the canvas gives way to the
     ordered list, which stops being visually hidden and becomes the content. */
  @media (max-width: 720px) {
    .dp-stage { display: none; }
    .dp-stops.sr-only {
      position: static; width: auto; height: auto; margin: 3vh 0 0; padding: 0;
      overflow: visible; clip: auto; white-space: normal;
      list-style: none; display: grid; gap: 14px;
    }
    .dp-stops li { font-size: 13.5px; line-height: 1.6; color: var(--ink-3); }
    .dp-stops strong { color: var(--paper); font-weight: 400; }
  }
</style>

<script>
  import {
    project, contours, contourLevels, trail, climbSpan, unknownAttractor,
    type Projection, type View,
  } from '../lib/descentPath';
  import { WAYPOINTS, trajectoryFacts, DEEP_SIDE_LABEL } from '../lib/trajectory';
  import { knownnessFn, knowledgeRadius } from '../lib/knowledge';
  import { prefersReducedMotion } from '../lib/motion';

  const teardowns: Array<() => void> = [];

  function initAll(): void {
    while (teardowns.length) teardowns.pop()!();
    document.querySelectorAll<HTMLElement>('[data-dp-stage]').forEach((stage) => {
      const t = init(stage);
      if (t) teardowns.push(t);
    });
  }

  function init(stage: HTMLElement): (() => void) | null {
    const canvas = stage.querySelector<HTMLCanvasElement>('[data-dp-canvas]');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return null;
    const section = stage.closest('#descent-path') as HTMLElement;
    const replay = section.querySelector<HTMLButtonElement>('[data-replay]');
    const readout = section.querySelector<HTMLElement>('[data-readout]');

    const projection: Projection = '2d';   // plan only; see the note in the markup above
    let reveal = 0;                 // 0..1, how much of the trail is drawn
    let raf = 0;
    let W = 0, H = 0, dpr = 1;

    // Geometry is computed ONCE per projection, not per frame: contours are the expensive part and
    // they do not change as the trail animates.
    const pts = trail();
    const span = climbSpan(pts);
    // HOISTED, and this is load-bearing for the animation, not a micro-optimisation. Both facts and
    // the attractor come from trajectoryFacts(), which runs four 3000-step gradient descents. Calling
    // it inside draw() cost ~1.8s per frame and produced a 0.6fps slideshow.
    const facts = trajectoryFacts();
    const attractor = unknownAttractor();
    const levels = contourLevels(11);
    const contourCache = new Map<string, [number, number][][]>();
    const contoursFor = (lv: number) => {
      const key = lv.toFixed(4);
      let c = contourCache.get(key);
      if (!c) { c = contours(lv, 150); contourCache.set(key, c); }
      return c;
    };

    // PALETTE CACHE. tok() called getComputedStyle() and it ran SIX TIMES PER DRAW — six forced
    // style recalculations per animation frame. Measured before this fix: 0.6 fps, mean 1758ms per
    // frame, which is precisely the "step function, like a powerpoint" symptom. The canvas work
    // itself was never the problem: only ~270 draw calls per frame, and the pure maths costs 10ms.
    // Read the tokens once and invalidate only when the theme attribute changes.
    type Pal = Record<string, string>;
    let palCache: Pal | null = null;
    const readPalette = (): Pal => {
      const cs = getComputedStyle(document.documentElement);
      const get = (n: string, fb: string) => cs.getPropertyValue(n).trim() || fb;
      return {
        ink5: get('--ink-5', '#b8b1a1'),
        ink4: get('--ink-4', '#8c8576'),
        ink3: get('--ink-3', '#5a544a'),
        paper: get('--paper', '#efe9dd'),
        ochre: get('--ochre', '#c8a36a'),
        seal: get('--seal', '#b23a2e'),
      };
    };
    const palette = (): Pal => (palCache ??= readPalette());

    function size(): void {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(2, window.devicePixelRatio || 1);
      W = Math.max(1, Math.round(r.width));
      H = Math.max(1, Math.round(r.height));
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
    }

    function view(): View {
      // Generous right and bottom padding: labels sit to the right of their points, and the
      // original render clipped them off the frame.
      return { w: W, h: H, projection, pad: { l: 70, r: 210, t: 50, b: 70 } };
    }

    /** How much experience the walker has at the current reveal, as a CONTINUOUS quantity.
     *
     *  Was Math.floor(...) + 1, which quantised knowledge into seven discrete jumps: nothing changed
     *  for ~740ms and then the whole surface lurched. That is exactly the "too extreme, almost seems
     *  stuck" the owner reported — a quantisation artefact, not a duration problem. knownAfter()
     *  accepts a fractional value and eases the newest disc in from zero. */
    function experience(): number {
      return reveal * (WAYPOINTS.length - 1) + 1;
    }

    /** Position on the spline at parameter t — the walker's own location, used to advance the
     *  knowledge frontier continuously rather than in per-stop instalments. */
    function pathAt(t: number): { x: number; y: number } {
      const idx = Math.min(pts.length - 1, Math.max(0, Math.round(t * (pts.length - 1))));
      const p = pts[idx];
      return { x: p.x, y: p.y };
    }

    /** How well a world point is understood right now. Driven by where the walker HAS BEEN along the
     *  curve, so the left half of the field fades in smoothly as the descent proceeds.
     *
     *  The frontier is built ONCE PER FRAME (see refreshKnown) rather than per point: rebuilding it
     *  per call cost ~290,000 disc constructions per frame and pinned the animation at 0.6fps. */
    let knownAt: (x: number, y: number) => number = () => 0;
    function refreshKnown(): void { knownAt = knownnessFn(reveal, pathAt); }
    function known(x: number, y: number): number { return knownAt(x, y); }

    function draw(): void {
      refreshKnown();
      const v = view();
      const { ink5, ink4, ink3, paper, ochre, seal } = palette();

      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, W, H);
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      // ── Contours as DOTS, not polylines. This is the style from the original sketch, copied
      // rather than re-invented: each grid crossing is drawn as a 1px stub with a round linecap, so
      // it renders as a dot. It reads as a survey plot and it is kin to the hero's dot field without
      // repeating the hero's object.
      ctx.lineCap = 'round';
      levels.forEach((lv, i) => {
        const runs = contoursFor(lv);
        const deep = 1 - i / (levels.length - 1);          // 1 at the deepest level
        ctx.strokeStyle = ink5;
        ctx.lineWidth = 1.7 + deep * 1.3;
        for (const run of runs) {
          // Sample along the run so the dots have air between them; a dot per point would fuse back
          // into a line at this contour resolution.
          for (let k = 0; k < run.length; k += 2) {
            const p = run[k];
            const kn = known(p[0], p[1]);
            if (kn <= 0.02) continue;
            const [sx, sy] = project(p[0], p[1], v);
            ctx.globalAlpha = (0.30 + deep * 0.50) * Math.min(1, kn * 1.6);
            ctx.beginPath();
            ctx.moveTo(sx, sy);
            ctx.lineTo(sx + 0.5, sy);
            ctx.stroke();
          }
        }
      });
      ctx.globalAlpha = 1;

      // ── Basin wash. Fills only CLOSED contour loops, which is the fix for the rectangular
      // patches that appeared around both minima: a contour run clipped by the frame edge is an open
      // polyline, and closePath() on it draws a chord straight across the frame, filling a slab. A
      // real bowl is a loop whose last point returns to its first.
      const washLevels = levels.slice(0, 5);
      washLevels.forEach((lv, i) => {
        const runs = contoursFor(lv);
        ctx.fillStyle = ochre;
        ctx.globalAlpha = 0.034 - i * 0.005;
        for (const run of runs) {
          if (run.length < 12) continue;
          const a = run[0], z = run[run.length - 1];
          const closed = Math.hypot(a[0] - z[0], a[1] - z[1]) < 0.08;
          if (!closed) continue;
          const mid = run[Math.floor(run.length / 2)];
          const kn = known(mid[0], mid[1]);
          if (kn <= 0.05) continue;
          // Fade the wash in with knowledge too, so a basin does not appear at full strength the
          // instant its centre is learned.
          ctx.globalAlpha = (0.034 - i * 0.005) * Math.min(1, kn * 1.6);
          ctx.beginPath();
          run.forEach((p, k) => {
            const [sx, sy] = project(p[0], p[1], v);
            if (k === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
          });
          ctx.closePath();
          ctx.fill();
        }
      });
      ctx.globalAlpha = 1;

      // ── NO KNOWLEDGE CIRCLES. Two earlier versions drew the horizon explicitly: first as radial
      // gradient fills (which flooded the frame, 3.4% -> 57.6% ink) and then as boundary hairlines
      // (which drew circles straight across both basins and fought the shapes they were meant to
      // reveal). The horizon does not need its own marks: masking the contours by knowledge already
      // shows exactly how far understanding reaches, and it shows it in the field's own language.

      // ── The deeper basin. HELD BACK until experience actually reaches it: measured, it is
      // invisible for seven of eight stops and discovered at the last, missing by 0.01 at the stop
      // before. Drawing it earlier would give away an ending the walker had not yet earned.
      const att = attractor;
      const discovered = known(att.x, att.y) > 0.02;
      const [ax, ay] = project(att.x, att.y, v);
      if (!discovered) {
        // Not yet known: nothing is drawn here at all. The absence IS the point.
      } else {
      for (let r = 34; r > 0; r -= 8) {
        ctx.beginPath();
        ctx.arc(ax, ay, r, 0, Math.PI * 2);
        ctx.strokeStyle = ink4;
        ctx.globalAlpha = 0.06 + (34 - r) / 34 * 0.10;
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.setLineDash([2, 5]);
      ctx.beginPath();
      ctx.arc(ax, ay, 9, 0, Math.PI * 2);
      ctx.strokeStyle = ink4;
      ctx.lineWidth = 1.1;
      ctx.stroke();
      ctx.setLineDash([]);
      // The deeper side, NAMED. Not "the global minimum" — the direction the descent runs in.
      label(ctx, ax + 22, ay + 30, DEEP_SIDE_LABEL, 15, ochre);
      label(ctx, ax + 22, ay + 51, 'deeper still — unknown', 12, ink5);
      }

      // ── The local basin, named, because being stuck there is the point.
      const [lx, ly] = project(facts.localBasin.x, facts.localBasin.y, v);
      ctx.beginPath();
      ctx.arc(lx, ly, 5, 0, Math.PI * 2);
      ctx.fillStyle = ochre;
      ctx.globalAlpha = 0.55;
      ctx.fill();
      ctx.globalAlpha = 1;

      // ── The trail, revealed to `reveal`. Ochre descending, SEAL climbing — the one saturated
      // colour on the site, spent on the one moment that matters.
      const shown = pts.filter((p) => p.t <= reveal);
      if (shown.length > 1) {
        for (let i = 1; i < shown.length; i++) {
          const a = shown[i - 1], b = shown[i];
          const [x1, y1] = project(a.x, a.y, v);
          const [x2, y2] = project(b.x, b.y, v);
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = b.climbing ? seal : ochre;
          ctx.lineWidth = b.climbing ? 3.4 : 2.1;
          ctx.globalAlpha = b.climbing ? 1 : 0.9;
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
        // The walker's head: a small mark at the leading edge, so an in-progress reveal reads as
        // something moving rather than a line being wiped in.
        const head = shown[shown.length - 1];
        const [hx, hy] = project(head.x, head.y, v);
        ctx.beginPath();
        ctx.arc(hx, hy, 4.5, 0, Math.PI * 2);
        ctx.fillStyle = paper;
        ctx.fill();
      }

      // ── Waypoints, only those the trail has reached.
      WAYPOINTS.forEach((wp, i) => {
        const arrival = i / (WAYPOINTS.length - 1);
        if (arrival > reveal + 1e-6) return;
        const [px, py] = project(wp.x, wp.y, v);
        const isBasin = wp.phase === 'basin';
        ctx.beginPath();
        ctx.arc(px, py, isBasin ? 6 : 4, 0, Math.PI * 2);
        ctx.fillStyle = isBasin ? ochre : paper;
        ctx.fill();
        // The final waypoint sits near the attractor, so its label collided with the deep-side name.
        // Put the last one above its dot and leave the rest to the right.
        const isLast = i === WAYPOINTS.length - 1;
        if (isLast) label(ctx, px - 6, py - 14, wp.label, 15, paper);
        else label(ctx, px + 14, py + 5, wp.label, 15, ink3);
      });

      // ── The climb, called out once, where it happens.
      if (span && reveal >= span.t1) {
        const mid = pts.find((p) => p.t >= (span.t0 + span.t1) / 2)!;
        const [mx, my] = project(mid.x, mid.y, v);
        ctx.strokeStyle = seal;
        ctx.globalAlpha = 0.5;
        ctx.beginPath();
        ctx.moveTo(mx, my);
        ctx.lineTo(mx - 54, my - 38);
        ctx.stroke();
        ctx.globalAlpha = 1;
        label(ctx, mx - 58, my - 44, `climb +${facts.climbRequired.toFixed(2)}`, 13, seal, 'end');
      }

      ctx.restore();
    }

    /** Labels in the sketch's own idiom: 15px mono with real letter-spacing. Canvas has no
     *  letter-spacing property everywhere, so the glyphs are spaced by hand — that tracking is most
     *  of why the sketch's type reads better than plain fillText at 12.5px. */
    function label(
      c: CanvasRenderingContext2D, x: number, y: number, text: string,
      size = 15, fill: string, align: CanvasTextAlign = 'left', track = 0.9,
    ): void {
      c.font = `${size}px "JetBrains Mono", ui-monospace, monospace`;
      c.fillStyle = fill;
      const chars = [...text];
      const widths = chars.map((ch) => c.measureText(ch).width + track);
      const total = widths.reduce((a, b) => a + b, 0) - track;
      let cx = align === 'end' ? x - total : align === 'center' ? x - total / 2 : x;
      for (let i = 0; i < chars.length; i++) {
        c.fillText(chars[i], cx, y);
        cx += widths[i];
      }
    }

    // ── Reveal animation. Slow enough to read, and it is the only motion here.
    const reduce = prefersReducedMotion();
    function animate(): void {
      cancelAnimationFrame(raf);
      if (reduce) { reveal = 1; draw(); return; }
      // Drive the reveal from ELAPSED TIME, not from an accumulated per-frame delta.
      //
      // The accumulator version ran ~5x too slow and looked frozen. Measured: 3 of 8 stops after
      // 4s, i.e. ~11s for the whole path against an intended 2s. The cause is that dt was clamped
      // to 0.05 as a safety rail, but the clamp was BINDING on most frames, so each frame
      // contributed at most 0.05 * rate regardless of real time. Elapsed time cannot drift.
      // 1150ms for eight stops read as "the whole path just appeared" — the eye cannot follow ~140ms
      // per leg. This is a WALK: it has to be slow enough to see one stop arrive after another, and
      // now the surface is being discovered as it goes, so the pacing carries information rather
      // than just decoration.
      const DURATION_MS = 6400;
      const t0 = performance.now();
      reveal = 0;
      // Smootherstep: zero velocity AND zero acceleration at both ends, so the walk starts without a
      // jolt and settles into the discovery instead of stopping dead. A linear ramp made the finish
      // feel abrupt even at the right duration.
      const ease = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
      const step = (now: number) => {
        const raw = Math.min(1, (now - t0) / DURATION_MS);
        reveal = ease(raw);
        markStops();
        draw();
        if (raw < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    /** Light up the stop cards as the trail reaches them, so the graph and the list are one thing. */
    function markStops(): void {
      // The visible stop cards are gone (the graph labels them), so this only drives the readout now.
      if (!readout) return;
      // Experience is continuous now, so the READOUT has to round it — an earlier build printed
      // "stop 1.0000000994998548/8" straight from the float.
      const k = experience();
      const kShown = Math.min(WAYPOINTS.length, Math.round(k));
      const att = attractor;
      const found = known(att.x, att.y) > 0.02;
      const r = knowledgeRadius(k - 1).toFixed(2);
      readout.innerHTML = found
        ? `stop <b>${kShown}/${WAYPOINTS.length}</b> · reach <b>${r}</b> · ` +
          `<i>a deeper basin is now visible</i> — it was there the whole time`
        : `stop <b>${kShown}/${WAYPOINTS.length}</b> · reach <b>${r}</b> · ` +
          `nothing deeper is visible from here`;
    }

    const onReplay = () => animate();
    replay?.addEventListener('click', onReplay);

    let resizeT = 0;
    const onResize = () => {
      window.clearTimeout(resizeT);
      resizeT = window.setTimeout(() => { size(); draw(); }, 140);
    };
    window.addEventListener('resize', onResize);

    const mo = new MutationObserver(() => { palCache = null; draw(); });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Start when it is on screen, so the reveal is seen rather than missed.
    //
    // rootMargin was '-15% 0px', which shrinks the trigger box — and an INSTANT scroll (or a deep
    // link, or a reload already scrolled down) can land the element inside the viewport without
    // ever crossing that shrunken boundary, so the observer never fires and the trail sits frozen
    // one leg in. Measured: 7 of 8 stops stayed dimmed. Now: no negative margin, plus a direct
    // visibility check at init for the case where it is ALREADY on screen before the observer runs.
    let started = false;
    const begin = () => { if (!started) { started = true; animate(); } };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) begin();
    }, { threshold: 0.25 });
    io.observe(stage);
    // Already visible on load? The observer would fire, but not until the next frame — and if the
    // page was restored mid-scroll it may not fire at all. Check directly.
    const r0 = stage.getBoundingClientRect();
    if (r0.top < window.innerHeight * 0.9 && r0.bottom > 0) begin();

    size();
    stage.classList.add('is-live');
    markStops();
    draw();                       // a finished static frame immediately

    return () => {
      cancelAnimationFrame(raf);
      window.clearTimeout(resizeT);
      window.removeEventListener('resize', onResize);
      io.disconnect();
      mo.disconnect();
      replay?.removeEventListener('click', onReplay);
    };
  }

  document.addEventListener('astro:page-load', initAll);
</script>
