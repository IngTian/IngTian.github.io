---
// Persistent top-right utility nav — surfaces the "reach me" actions
// (GitHub · Email · CV · LinkedIn) from the very first paint (issue #21). It is
// the only place on the site they are linked: Email and CV at every width,
// GitHub and LinkedIn from 1200px.
//
// Plain Astro + a bundled vanilla <script> (NOT a React island), re-inits on
// astro:page-load with a teardown, and adapts its color to the sky beneath it.
// Pinned to the TOP edge, it flips on the gradient fraction painted directly
// behind it, dark ink on the pale upper sky → paper once the descent sinks
// into dusk. Ochre on hover, the site's one interaction accent.
//
// Hrefs come from profile.ts (the single source of résumé facts); the icons
// live here (presentation, not content). Built so the deferred light/dark
// theme toggle drops in as one more item with no restructuring.
//
// IT ALSO CARRIES THE SITE'S PAGE SET. The owner: "it might be wiser to add navigations directly on the
// top right hovering bar, so it's always visible. the click stays an easter egg." Real navigation cannot
// depend on a discovery, so the pages sit here, always visible, and the tagline's links stay the easter egg.
//
// Pages are TEXT (they are destinations, and a label is what makes them scannable); the contact marks drop to
// ICON-ONLY above mobile, because eight text items in one capsule would run past a third of the viewport —
// measured at 1700px before the change. Contact is recognisable by glyph; a page is not.
import { contact } from '../data/profile';
import { PAGES } from '../data/nav';

interface Props {
  /** 'scroll' = flip text color by the descent fraction behind the nav (home,
   *  /art). 'light' = pin to dark text (pages that stay pale in light theme,
   *  e.g. /writing). Only affects the LIGHT theme; dark is always light text. */
  navZone?: 'scroll' | 'light';
}
const { navZone = 'scroll' } = Astro.props;

// The current route, normalised without a trailing slash, so aria-current marks the page you are on.
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';

// `profile`: GitHub and LinkedIn, the items that go first when the capsule runs out of room (below 1200px).
type Item = { key: string; label: string; href: string; external: boolean; icon: string; profile?: boolean };
const items: Item[] = [
  {
    key: 'github', ...contact.github, profile: true,
    // GitHub mark (fill, currentColor)
    icon: '<path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>',
  },
  {
    key: 'email', ...contact.email,
    // Envelope (stroke, currentColor)
    icon: '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" d="M1.75 3.75h12.5v8.5H1.75z"/><path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" d="m2.25 4.25 5.75 4.5 5.75-4.5"/>',
  },
  {
    key: 'cv', ...contact.cv,
    // Document with a download arrow (stroke, currentColor)
    icon: '<path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" d="M3.75 1.75h5l3.5 3.5v9h-8.5z"/><path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" d="M8 7v4m0 0L6.4 9.4M8 11l1.6-1.6"/>',
  },
  {
    key: 'linkedin', ...contact.linkedin, profile: true,
    // LinkedIn "in" mark (fill, currentColor)
    icon: '<path fill="currentColor" d="M3.4 5.6H.9V14h2.5V5.6ZM2.15 1A1.45 1.45 0 1 0 2.15 3.9 1.45 1.45 0 0 0 2.15 1ZM14 9.28c0-2.3-1.23-3.37-2.86-3.37-1.32 0-1.91.72-2.24 1.23V5.6H6.4c.03.71 0 8.4 0 8.4h2.5V9.31c0-.22.02-.45.08-.6.18-.45.59-.91 1.28-.91.9 0 1.26.69 1.26 1.69V14H14V9.28Z"/>',
  },
];
---
<nav class="cnav" aria-label="Site navigation, contact and profiles" data-cnav data-nav-mode={navZone}>
  {/* PHONE MENU BUTTON — visible only on a phone (the mobile block in <style>). A real <button> with
      aria-expanded/aria-controls so the disclosure is announced; at every other width it is display:none,
      and so out of the tab order and the a11y tree. */}
  <button
    type="button"
    class="navmenu"
    data-nav-menu
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="cnav-list"
  >
    <span class="pill" aria-hidden="true"></span>
    <span class="content">
      <svg class="ic" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <path d="M2.4 4.2h11.2M2.4 8h11.2M2.4 11.8h11.2"/>
        </g>
      </svg>
    </span>
  </button>
  <ul id="cnav-list">
    {/* THE PAGES, first and in words — this is the part a visitor needs and must not have to hunt for.
        aria-current marks the page you are on, so the nav answers "where am I" as well as "where can I go": "page"
        on its own link, "true" on its section's when the page is under one (/research/<slug>, /writing/<slug>). */}
    {PAGES.map((p) => (
      <li>
        <a class="page" href={p.href} aria-current={current === p.href ? 'page' : current.startsWith(`${p.href}/`) ? 'true' : undefined}>
          <span class="pill" aria-hidden="true"></span>
          <span class="content"><span class="page-label">{p.label}</span></span>
        </a>
      </li>
    ))}
    <li class="sep" aria-hidden="true"></li>
    {items.map((it) => (
      <li class:list={['mark-li', { profile: it.profile }]}>
        <a
          class="mark"
          href={it.href}
          data-key={it.key}
          aria-label={it.label}
          {...(it.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="pill" aria-hidden="true"></span>
          <span class="content">
            <svg class="ic" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" set:html={it.icon}></svg>
            <span class="label">{it.label}</span>
          </span>
        </a>
      </li>
    ))}
    <li class="sep" aria-hidden="true"></li>
    <li>
      {/* Theme toggle. A real <button> (not a link) so it's keyboard-operable
          and announced correctly. Shows the moon (→ go dark) in light theme and
          the sun (→ go light) in dark theme; CSS swaps which glyph is visible
          off the <html data-theme>. Label + pressed state kept in sync by the
          inline script below. */}
      <button type="button" class="toggle" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
        <span class="pill" aria-hidden="true"></span>
        <span class="content">
          <svg class="ic ic-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path fill="currentColor" d="M6.2 1.6a6.4 6.4 0 1 0 8.2 8.2A5 5 0 0 1 6.2 1.6Z"/>
          </svg>
          <svg class="ic ic-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <circle cx="8" cy="8" r="3.1" fill="currentColor"/>
            <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
              <path d="M8 .9v2.0M8 13.1v2.0M.9 8h2.0M13.1 8h2.0M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4"/>
            </g>
          </svg>
        </span>
      </button>
    </li>
  </ul>
</nav>

<style>
  .cnav {
    position: fixed;
    top: clamp(14px, 2vw, 22px);
    right: clamp(14px, 7vw, 64px);
    z-index: 40;                 /* above the rail (30) and content */
  }

  /* ── The frosted-glass capsule. A rounded, lucid panel the links sit inside
     — translucent so the Monet sky reads through it, with a static backdrop
     blur (blur is BAKED via backdrop-filter, never animated — taste rule) and
     a hairline rim. Zone-adaptive: paper-frost on the pale hero, ink-frost on
     the deep bottom (like the reference). The frosted panel also lifts the
     background locally, which fixes the mid-grey dusk contrast band the old
     text-halo was patching — so the halo is gone. ── */
  .cnav ul {
    list-style: none; margin: 0; padding: 4px;
    display: flex; align-items: center; gap: 2px;
    border-radius: 999px;
    /* light-zone frost (default at top): warm paper glass */
    background: rgba(244, 239, 228, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 2px 10px rgba(22, 20, 15, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    backdrop-filter: blur(14px) saturate(1.15);
    transition: background 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
  }
  /* dark-zone frost: the sky has sunk into dusk/ink — a cool dark glass */
  .cnav[data-zone="dark"] ul {
    background: rgba(22, 20, 15, 0.42);
    border: 1px solid rgba(184, 177, 161, 0.22);
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  /* Dark THEME: the whole page is a dark void top-to-bottom, so the light-zone
     (top-of-page) paper frost would be a bright blob. Force dark glass for BOTH
     zones; text is already light via the flipped tokens. */
  :global(html[data-theme='dark']) .cnav ul {
    background: rgba(12, 12, 16, 0.5);
    border: 1px solid rgba(184, 177, 161, 0.18);
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  /* the light text should stay light in the top zone under the dark theme */
  :global(html[data-theme='dark']) .cnav a,
  :global(html[data-theme='dark']) .cnav .toggle { color: var(--ink-1); }

  .cnav li { display: flex; }

  /* links AND the theme-toggle button share one capsule-item base */
  .cnav a, .cnav .toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 9px 14px;
    border-radius: 999px;
    color: var(--ink-1);         /* light-zone ink */
    transition: color 0.35s ease;
    isolation: isolate;          /* keep the bloom pill under .content */
  }
  .cnav .toggle { background: none; border: 0; cursor: pointer; -webkit-appearance: none; appearance: none; padding: 9px 12px; }
  .cnav[data-zone="dark"] a, .cnav[data-zone="dark"] .toggle { color: var(--paper); }

  /* ── The phone menu button. Self-contained rather than folded into the shared item base, so it carries
     its own frost: when the list is closed this button IS the whole nav, with no <ul> behind it to provide
     the glass. display:none by default keeps it out of the tab order and the a11y tree off a phone. ── */
  .cnav .navmenu {
    display: none;
    position: relative;
    place-items: center;
    background: rgba(244, 239, 228, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 2px 10px rgba(22, 20, 15, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    backdrop-filter: blur(14px) saturate(1.15);
    border-radius: 999px;
    padding: 10px 11px;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    color: var(--ink-1);
    isolation: isolate;
  }
  .cnav[data-zone="dark"] .navmenu {
    background: rgba(22, 20, 15, 0.42);
    border-color: rgba(184, 177, 161, 0.22);
    color: var(--paper);
  }
  :global(html[data-theme='dark']) .cnav .navmenu {
    background: rgba(12, 12, 16, 0.5);
    border-color: rgba(184, 177, 161, 0.18);
    color: var(--ink-1);
  }
  .cnav .navmenu:focus-visible { outline: 2px solid var(--ochre); outline-offset: 2px; }

  /* thin separator before the toggle — sets the utility control apart */
  .cnav .sep { width: 1px; align-self: stretch; margin: 4px 3px; background: currentColor; opacity: 0.18; }

  /* content sits above the bloom pill */
  .cnav .content { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; }
  .cnav .ic { flex: none; display: block; }

  /* ── PAGES vs MARKS. The pages are the navigation and read as words; the contact marks are recognisable
     glyphs, so by default they carry only their icon and the capsule stays a capsule. The label is still in
     the DOM (visually hidden, not display:none) so screen readers and the accessible name are unaffected. ── */
  .cnav .mark .label {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .cnav .mark .content { gap: 0; }
  .cnav .mark { padding: 9px 11px; }

  /* ── VERY WIDE SCREENS GET THE WORDS TOO. The owner: "can you adaptively show the texts for
     github/email/resume/linkedin as well? i have a large monitor."
     The threshold is measured, not guessed. With all nine items labelled the capsule is 883px, which is:
       46% of 1920   ·   40% of 2200   ·   34.5% of 2560   ·   23% of 3840
     At 1920 it has stopped being a corner affordance and reads as a header bar, so the labels appear from
     2200px up — where the capsule is at most two fifths of the screen and there is still more empty space to
     its left than capsule. Below that the icons carry the meaning, and each one's name is its aria-label.
     `unset` rather than re-declaring each property: the hidden state is a clip-path trick with four
     interacting declarations, and undoing them one by one is how one gets left behind. */
  @media (min-width: 2200px) {
    .cnav .mark .label {
      position: unset; width: unset; height: unset; overflow: unset; clip-path: unset;
    }
    .cnav .mark .content { gap: 7px; }
    .cnav .mark { padding: 9px 14px; }
  }

  /* THE PAGE YOU ARE ON, or the section it is under (either aria-current): a 6px dot in the accent role token
     (--ochre, so seal red on /projects) plus weight 600 — shape plus colour; the bloom pill stays hover's. The dot
     sits in the link's left padding, never inside the label, and every page link reserves the same 20px, so no
     label moves between pages (the capsule is right-anchored). 20 is the shared 14 + 6, so the dot sits 7px off
     the link's edge and 7px off the label; at 14 it sat flush on the edge (the owner: "almost on the edge"). */
  .cnav .page { padding-left: 20px; }
  .cnav .page .page-label { display: inline-block; position: relative; }
  .cnav a[aria-current] .page-label::before {
    content: '';
    position: absolute;
    right: calc(100% + 7px); top: 50%;
    width: 6px; height: 6px; margin-top: -3px;
    border-radius: 50%;
    background: var(--ochre);
    box-shadow: 0 0 9px color-mix(in oklab, var(--ochre) 75%, transparent);
  }
  .cnav a[aria-current] { font-weight: 600; }

  /* sun/moon swap: show the glyph for the ACTION (moon = go dark in light
     theme; sun = go light in dark theme). Default (light) shows moon. */
  .cnav .toggle .ic-sun { display: none; }
  :global(html[data-theme='dark']) .cnav .toggle .ic-moon { display: none; }
  :global(html[data-theme='dark']) .cnav .toggle .ic-sun { display: block; }

  /* ── The bloom pill — an accent capsule that grows in behind the item on
     hover/focus, inverting the text to dark ink. The accent (ochre light /
     phosphor-green dark) is the site's one interaction accent, so this reads
     as an evolution of the old "text turns accent" hover. transform/opacity. ── */
  .cnav .pill {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 999px;
    background: var(--ochre);
    opacity: 0;
    transform: scale(0.72);
    transition: opacity 0.32s ease, transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }

  @media (hover: hover) {
    .cnav a:hover .pill, .cnav .toggle:hover .pill { opacity: 1; transform: scale(1); }
    .cnav a:hover, .cnav .toggle:hover { color: var(--on-accent); }   /* dark ink reads on the accent */
    .cnav[data-zone="dark"] a:hover, .cnav[data-zone="dark"] .toggle:hover { color: var(--on-accent); }
    .cnav a:hover .content, .cnav .toggle:hover .content { animation: cnav-nudge 0.32s ease; }
  }
  .cnav a:focus-visible, .cnav .toggle:focus-visible { outline: none; color: var(--on-accent); }
  .cnav a:focus-visible .pill, .cnav .toggle:focus-visible .pill {
    opacity: 1; transform: scale(1);
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--ochre) 55%, transparent);
  }

  @keyframes cnav-nudge {
    0% { transform: translateY(0); }
    45% { transform: translateY(-1.5px); }
    100% { transform: translateY(0); }
  }

  /* Narrow: the page WORDS are what must survive (they are the navigation), so the profiles go first and Email
     and CV stay: they are linked nowhere else on the site. The threshold is 1200px: the full capsule is 693px,
     68% of a 1024px viewport, and a nav at two thirds of the width has stopped being a corner affordance.
     Both separators stay, since Email and CV sit between them.
     HIDE THE <li>, NOT JUST THE <a> INSIDE IT: an empty list item is still a flex item, and costs a gap.
     FROM 641px THE CAPSULE IS TIGHTER, so it fits one row. At 12px JetBrains Mono (0.6em advance, a fixed-pitch
     face) plus 0.06em letter-spacing a label character is 7.92px, and the five labels are 36 of them: 285.12px.
     With the paddings above the capsule is 613.12px, and a 641px window has 596.13px left of the 7vw offset,
     581.13px beside a classic 15px scrollbar: 17px and 32px over. A page link's right padding 14 → 8 (the
     left's 20 is the dot's) and a mark's 11 → 8 make it 571.12px, 10px under with the scrollbar and 25px
     without. Every current-page state is that width: the dot sits in reserved padding, and 600 keeps the
     advances. */
  @media (max-width: 1199px) {
    .cnav .profile { display: none; }
    @media not all and (max-width: 640px) {
      .cnav .page { padding-right: 8px; }
      .cnav .mark { padding: 9px 8px; }
    }
  }

  /* ── ON A PHONE THE NAV IS ONE MARK, AND THE DESTINATIONS ARE A TAP AWAY. ──
     The capsule that works on a desktop cannot work here, and the reason is arithmetic rather than taste: five
     labels plus a theme toggle DO NOT FIT one row at 320px at any font size this design would accept. Every
     attempt to make them fit deformed the nav instead.
       · one non-wrapping row  → the contents overflowed LEFTWARD off the screen. "Research" rendered as
         "earch" at 390px and was entirely gone at 320px, so the first destination was unreachable.
       · pin both edges + wrap → stops it being a corner nav at all: the capsule stretched across the screen
         (292x68 = 91% of a 320px viewport), justify-content:flex-end left 73px of DEAD pill on the left, and
         the toggle was stranded alone on a second row. The owner's word was "exploded".
       · full-width bar, one row, 10px type → fits with ~10px to spare, i.e. renaming any label breaks it.
     A disclosure has none of these problems: at rest it is a 40x38 mark (13% of a 320px screen against the
     old 91%), and it is the only form that still works if a sixth page is ever added.
     The button and the list are mutually exclusive — opening swaps one for the other — so the capsule can
     never grow a second row, which is the failure every other form kept finding. */
  @media (max-width: 640px) {
    .cnav { top: 12px; right: 14px; }
    .cnav .content { gap: 0; }
    .cnav .navmenu { display: grid; }
    .cnav ul {
      display: none;
      flex-direction: column;
      align-items: stretch;
      padding: 4px;
      border-radius: 14px;
      min-width: 148px;
      /* The open list is 415px tall, past a landscape phone's screen (640x360), so it scrolls inside itself
         rather than leave its last rows off the bottom. */
      max-height: calc(100dvh - 24px);
      overflow-y: auto;
    }
    /* Open state lives on <html> rather than on the nav, so the page can respond to it too (a future scrim
       would hang off the same attribute) and so the script has one place to look. */
    :global(html[data-nav-open]) .cnav ul { display: flex; }
    :global(html[data-nav-open]) .cnav .navmenu { display: none; }
    /* SIZED TO APPLE'S 44pt MINIMUM, not to the desktop capsule's proportions. These rows are now the ONLY way
       to navigate on a phone, so a cramped target here is not a cosmetic problem. Measured, not guessed: 9px of
       vertical padding gave 31px rows and 14px gave 41px — both under the guideline. 16px on a 13px line
       measures 45px, which clears it; Email, CV and the toggle carry a 16px icon, so 48px. (`.cnav .mark` is
       named because it outranks `.cnav a`.) */
    .cnav .page, .cnav .mark { font-size: 13px; }
    .cnav a, .cnav .mark, .cnav .toggle { padding: 16px 13px; }
    /* Email and CV are rows under the pages, icon and word (the marks' 2200px form), and a hairline sets each
       group apart: pages, then contact, then the toggle. */
    .cnav .mark .label { position: unset; width: unset; height: unset; overflow: unset; clip-path: unset; }
    .cnav .mark .content { gap: 7px; }
    .cnav .sep { width: auto; height: 1px; margin: 4px 13px; }
  }

  /* Reduced motion: no bloom scale / nudge — the pill still appears (instant)
     so the hover affordance survives, but nothing animates. */
  @media (prefers-reduced-motion: reduce) {
    .cnav ul, .cnav a, .cnav .toggle, .cnav .pill { transition: none; }
    .cnav a:hover .content, .cnav a:focus-visible .content,
    .cnav .toggle:hover .content, .cnav .toggle:focus-visible .content { animation: none; }
    .cnav .pill { transform: scale(1); }   /* no scale-in; just fade via opacity */
  }
</style>

<script>

  // Zone the nav by the gradient fraction painted directly behind it. The
  // .descent gradient spans the full content height, so the sky color at the
  // nav's fixed top position maps to (scrollY + probe) / descentHeight — the
  // very thing that decides whether dark ink or paper stays legible. Above the
  // flip point the upper sky is pale (dark ink); below it the descent sinks
  // into dusk→ink (paper). Re-inits on every astro:page-load (View Transitions)
  // with a teardown so listeners don't leak across navigations.

  // Fraction of the descent at which paper text overtakes dark ink for
  // legibility behind the nav. Set to the measured contrast CROSSOVER: a probe
  // of the rendered sky shows ink-1 holds AA (≥4.5:1) down to ~0.55 and paper
  // takes over from ~0.57 upward, so flipping here keeps the higher-contrast
  // color on each side. (The lone mid-grey dusk point right at the crossover
  // sits just under 4.5 for both inks on the bare sky; the capsule's frosted
  // glass lifts its backdrop there, see the .cnav ul note.)
  const DARK_FROM = 0.57;

  let teardown: (() => void) | null = null;

  function initCornerNav() {
    teardown?.();
    teardown = null;

    // ALIASED AFTER THE GUARD: TypeScript does not carry a const's narrowing into a hoisted `function`
    // (CLAUDE.md, Conventions), so the functions below read a non-null alias.
    const maybeNav = document.querySelector<HTMLElement>('[data-cnav]');
    if (!maybeNav || !('requestAnimationFrame' in window)) return;
    const nav = maybeNav;
    const descent = document.querySelector<HTMLElement>('.descent');

    // Zone = which LIGHT-theme text color the nav uses. Two modes:
    //  - 'light': pinned dark text (pages that stay pale — /writing). Set once.
    //  - 'scroll': flip dark→paper by the descent fraction behind the nav (home,
    //    /art, which ride the full dawn→night gradient). Needs a .descent el.
    // (Dark theme forces light text via CSS regardless of this attribute.)
    const mode = nav.dataset.navMode === 'light' ? 'light' : 'scroll';

    let onScroll: (() => void) | null = null;
    // Hoisted to the teardown's scope, not the branch's: the re-measure listener and the content observer must
    // be removable, or every View Transition would stack another observer on the same <main>.
    let onResize: (() => void) | null = null;
    // Declared OUT here, beside onResize, because the teardown that clears it runs in this scope.
    let navResizeTimer = 0;
    let zoneRO: ResizeObserver | null = null;
    if (mode === 'light' || !descent) {
      nav.dataset.zone = 'light';
    } else {

      /**
       * Relative luminance of the first OPAQUE thing actually painted behind the nav, or null if the sky is
       * showing through.
       *
       * WHY THIS EXISTS. The gradient fraction below is a proxy for "what colour is behind the nav", and the
       * proxy is wrong wherever an opaque panel is drawn ON TOP of the sky — which is most of this page. The
       * explainer slides and the story/appendix panels are full-bleed paper. Measured consequence in the
       * LIGHT theme: from 57% of the document down, the nav flipped to its dark glass while the thing behind
       * it was still opaque light paper, so it read as an alien dark slab and its labels fell to 3.98:1 —
       * under AA, on the site's only navigation.
       * Sampling the real backdrop makes the answer correct by construction instead of by tuning a number,
       * and it keeps working when panels move or new ones are added. elementsFromPoint (plural) is used
       * because the nav itself is the topmost thing at that point; its own subtree is skipped.
       */
      // ── MEASURED ONCE, NOT PER FRAME. querySelectorAll, then interleaved getBoundingClientRect() and
      // getComputedStyle() per element, is the textbook layout-thrash pattern; run on every scroll frame it made
      // the deck's transitions "almost like sluggish" (the owner). Nothing it measures changes while scrolling
      // (a panel's document-space box and colour are fixed; only scrollY moves), so measureBackdrops() caches it
      // and the per-frame path is arithmetic with no DOM reads.
      type Band = { top: number; bottom: number; lum: number };
      let bands: Band[] = [];
      let navCenterY = 0;
      let descentH = 0;
      const lin = (c: number) => { const v = c / 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };

      const measureBackdrops = (): void => {
        const nr = nav.getBoundingClientRect();
        navCenterY = (nr.top + nr.bottom) / 2;   // the nav is position:fixed, so this is scroll-invariant
        descentH = descent.offsetHeight;
        const vw = window.innerWidth;
        const sy = window.scrollY;
        const next: Band[] = [];
        // GEOMETRY, NOT HIT-TESTING. document.elementsFromPoint SKIPS every element with pointer-events: none,
        // which is what all the decorative sky layers are, so on the homepage it walked past the canvas-painted
        // dawn sky to .descent's opaque dark base and flipped the light nav to dark glass over the pale hero
        // (measured 3.09:1). The question it asks instead: is a FULL-BLEED OPAQUE PANEL covering the nav's line right now? Those are the
        // only things that hide the sky, they are always `main > section > <block>`, and their boxes are
        // ordinary geometry that no pointer-events value can hide. Anything else means the sky is what shows,
        // and the descent-fraction proxy below is the right model for a sky whose colour varies with depth.
        // Read every candidate's geometry and colour ONCE, in document coordinates. The rect reads and the
        // style reads still interleave here, but this runs on init and on resize rather than 60 times a second.
        for (const el of document.querySelectorAll<HTMLElement>('main > section > *')) {
          const r = el.getBoundingClientRect();
          if (r.width < vw * 0.6) continue;                 // not full-bleed: a card, not a panel
          const parts = /rgba?\(([^)]+)\)/.exec(getComputedStyle(el).backgroundColor);
          if (!parts) continue;
          const [cr, cg, cb, ca = 1] = parts[1].split(',').map((s) => parseFloat(s));
          if (!(ca >= 0.9)) continue;                       // translucent: the sky still reads through
          next.push({
            top: r.top + sy,
            bottom: r.bottom + sy,
            lum: 0.2126 * lin(cr) + 0.7152 * lin(cg) + 0.0722 * lin(cb),
          });
        }
        bands = next;
      };

      const update = () => {
        // THE WHOLE PER-FRAME PATH, and it touches the DOM exactly once (scrollY, which is free — it does not
        // force layout). An opaque backdrop answers the question directly; the gradient fraction is the
        // fallback for when the sky itself is what shows through. 0.35 sits between the paper tones (~0.85)
        // and the dusk/ink ones (~0.02-0.2), so mid-grey dusk still chooses paper text as it did before.
        const docY = window.scrollY + navCenterY;
        for (const b of bands) {
          if (docY >= b.top && docY <= b.bottom) {
            nav.dataset.zone = b.lum > 0.35 ? 'light' : 'dark';
            return;
          }
        }
        if (!descentH) return;
        nav.dataset.zone = docY / descentH > DARK_FROM ? 'dark' : 'light';
      };

      measureBackdrops();
      let ticking = false;
      onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      };
      // RESIZE RE-MEASURES; SCROLL DOES NOT. Debounced at 160ms, as elsewhere, or a window drag thrashes
      // layout once per event. Cleared in the teardown below: a pending callback after a View Transition would
      // measure a document ClientRouter has already replaced.
      onResize = () => {
        window.clearTimeout(navResizeTimer);
        navResizeTimer = window.setTimeout(() => { measureBackdrops(); onScroll?.(); }, 160);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
      // The document also changes height WITHOUT a resize — the terrain canvas and images settle after first
      // paint, and a deck slide can grow. Stale bands would leave the nav in the wrong zone, so watch the
      // content box; this fires rarely and never during a scroll.
      zoneRO = new ResizeObserver(() => measureBackdrops());
      const mainEl = document.querySelector('main');
      if (mainEl) zoneRO.observe(mainEl);
      update();
    }

    // ── Theme toggle ──────────────────────────────────────────────────────
    // Flip data-theme on <html>, persist the explicit choice, and keep the
    // button's a11y state in sync. The JS-painted surfaces repaint on
    // `theme:change` (repaintForTheme, below).
    const toggle = nav.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    function syncToggle() {
      const dark = document.documentElement.dataset.theme === 'dark';
      if (!toggle) return;
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    }
    syncToggle();

    // THE ATTRIBUTE FLIP ONLY: swap it, persist, sync a11y. The repaint is repaintForTheme's, and why it is not
    // astro:page-load is said there.
    function flipTheme() {
      const dark = document.documentElement.dataset.theme === 'dark';
      if (dark) { delete document.documentElement.dataset.theme; }
      else { document.documentElement.dataset.theme = 'dark'; }
      try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) {}
      syncToggle();
    }

    // Its listeners are the JS-painted surfaces (CLAUDE.md, Themes), and it is the only way a theme change reaches
    // them: none observes the attribute or re-reads it per frame. TerrainHero, DescentPath and
    // FluidSky add theirs at module level and never remove it, so after a ClientRouter visit to `/` they still fire
    // elsewhere and return when their canvas is absent. A PerformanceObserver check across a flip on `/` reports no
    // long task (worst rAF gap 34ms, one frame of the hero's own 30fps throttle).
    function repaintForTheme() {
      // A DEDICATED EVENT, never astro:page-load: re-firing that re-runs every page script's init (the deck's
      // re-measure, the rail, the beat steppers, the cow), none of which a colour change affects. Isolated
      // by measurement: 357ms of long task on the homepage against 55ms on /404, and unchanged when the View
      // Transition was disabled, so the cost was always this re-init and never the transition.
      document.dispatchEvent(new Event('theme:change'));
    }

    function onToggle() {
      // AN INSTANT FLIP, DELIBERATELY: NO VIEW TRANSITION. A View Transition shows SNAPSHOTS, and in real
      // Chrome with GPU rasterisation the canvases are absent from them, so a 0.5s crossfade showed the bare
      // --descent-grad (a flat grey) with no sky and no terrain dots. Headless Chrome's software rendering does
      // capture canvases, so it does not reproduce there. repaintForTheme() re-inits both canvases in the same
      // task as the attribute flip: text, sky and terrain cross at +29ms, spread 0ms. If a dissolve is wanted,
      // lerp the canvases' ramps in JS alongside the CSS; never startViewTransition over a canvas.
      flipTheme();
      repaintForTheme();
    }
    toggle?.addEventListener('click', onToggle);

    // ── PHONE MENU. The button and the list are one disclosure: opening swaps the ☰ for the list,
    // so the two are never on screen together and the capsule never grows a second row.
    const menu = nav.querySelector<HTMLButtonElement>('[data-nav-menu]');
    function setOpen(open: boolean): void {
      const root = document.documentElement;
      if (open) root.setAttribute('data-nav-open', '');
      else root.removeAttribute('data-nav-open');
      menu?.setAttribute('aria-expanded', open ? 'true' : 'false');
      // Move focus INTO the list when opening so a keyboard or VoiceOver user lands on the first destination
      // instead of on a button that just vanished.
      if (open) nav.querySelector<HTMLAnchorElement>('ul a')?.focus();
    }
    function onMenu(): void {
      setOpen(!document.documentElement.hasAttribute('data-nav-open'));
    }
    // Dismiss on an outside tap or Escape — an open sheet with no way out is a trap on a phone.
    function onDocPointer(e: Event): void {
      if (!document.documentElement.hasAttribute('data-nav-open')) return;
      if (e.target instanceof Node && nav.contains(e.target)) return;
      setOpen(false);
    }
    function onDocKey(e: KeyboardEvent): void {
      if (e.key === 'Escape' && document.documentElement.hasAttribute('data-nav-open')) {
        setOpen(false);
        menu?.focus();
      }
    }
    menu?.addEventListener('click', onMenu);
    document.addEventListener('pointerdown', onDocPointer);
    document.addEventListener('keydown', onDocKey);

    teardown = () => {
      if (onScroll) window.removeEventListener('scroll', onScroll);
      if (onResize) window.removeEventListener('resize', onResize);
      window.clearTimeout(navResizeTimer);
      zoneRO?.disconnect();
      toggle?.removeEventListener('click', onToggle);
      menu?.removeEventListener('click', onMenu);
      document.removeEventListener('pointerdown', onDocPointer);
      document.removeEventListener('keydown', onDocKey);
      document.documentElement.removeAttribute('data-nav-open');
    };
  }

  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = null;
    initCornerNav();
  });
</script>
