---
// PROTOTYPE (claude/writing-proto) — "Notebook", the index: a lab notebook's table of contents. One chronological
// stream of numbered entries, numbered from the oldest so a number never changes as the notebook grows; the number
// and the kind's stamp sit in the left margin, outside a seal-red margin rule; each title runs on dotted leaders to
// its date; a year is each section break. The kinds are the notebook's key, and the key's stamps filter the stream
// (radios and :has(), no script). A `short` note is read whole where it is listed: no leaders, as there is no page
// to turn to. With nothing written, the cow holds the page, under the title and the charter alone.
// The column is NotebookPiece's (--mg, --gut, --W = its --M + --G + --N), so nothing moves between index and piece.
import type { Kind, Piece } from '../../data/protoWriting';
import { CHARTER, KINDS } from '../../data/protoWriting';
import PlushCow from '../PlushCow.astro';
import { COW_LINES_WRITING } from '../../data/cowGlyph';
import { monthYear } from '../../lib/dates';

interface Props { pieces: Piece[] }
const { pieces } = Astro.props;

const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const day = (d: string) => `${d.slice(8)} ${MON[Number(d.slice(5, 7)) - 1]}`;
const no = (i: number) => String(pieces.length - i).padStart(3, '0');
// ponytail: the singular by dropping a plural "s"; a kind whose label is not "<word>s" needs its own word.
const stamp = (k: Kind) => KINDS[k].label.replace(/s$/, '');

const entries = pieces.map((p, i) => ({ ...p, no: no(i) }));
const years = [...new Set(entries.map((e) => e.date.slice(0, 4)))]
  .map((y) => ({ y, entries: entries.filter((e) => e.date.startsWith(y)) }));
const kinds = (Object.keys(KINDS) as Kind[]).map((k) => ({ k, stamp: stamp(k), gloss: KINDS[k].gloss, n: pieces.filter((p) => p.kind === k).length }));
// The proto page renders this index at more than one count, so each radio group needs its own name.
const group = `nb-kind-${pieces.length}`;

const oldest = pieces.at(-1);
const newest = pieces[0];
const span = oldest && newest
  ? [monthYear(oldest.date), monthYear(newest.date)].filter((m, i, a) => a.indexOf(m) === i).join(' – ')
  : '';
const range = pieces.length === 1 ? 'Entry 001' : `Entries 001–${no(0)}`;
---
<section class="nb">
  <header class="row">
    <div class="main">
      <a class="back" href="/">← back</a>
      <h1>Writing</h1>
      {pieces.length > 0 && <p class="sub">A working notebook, kept in public.</p>}
      <p class="charter">{CHARTER}</p>
      {pieces.length > 0 && <p class="spine">{range} · {span}</p>}
    </div>
  </header>

  {pieces.length === 0 ? (
    <div class="row">
      <div class="main nb-cow">
        <PlushCow size="large" lines={COW_LINES_WRITING} label="A cow, holding the space until something is written here. Press it." />
      </div>
    </div>
  ) : (
    <>
      <div class="row key">
        <p class="mg key-k" aria-hidden="true">Key</p>
        <div class="main opts" role="radiogroup" aria-label="Show entries of one kind">
          <label class="opt">
            <input type="radio" name={group} value="all" checked />
            <span class="stamp">All</span><span class="cnt">{pieces.length}</span>
          </label>
          {kinds.map((k) => (
            <label class="opt">
              <input type="radio" name={group} value={k.k} disabled={k.n === 0} />
              <span class="stamp">{k.stamp}</span><span class="cnt">{k.n}</span>
              <span class="gloss">{k.gloss}</span>
            </label>
          ))}
        </div>
      </div>

      {years.map((yr) => (
        <section class="year">
          <h2 class="row yr"><span class="mg">{yr.y}</span></h2>
          <ol class="entries">
            {yr.entries.map((e) => (
              <li class:list={['row', 'entry', e.short && 'entry-short']} data-kind={e.kind}>
                <p class="mg"><span class="no"><span class="no-k">No.</span>{e.no}</span><span class="stamp">{stamp(e.kind)}</span></p>
                <div class="main">
                  {e.short ? (
                    <>
                      <p class="lead"><span class="title">{e.title}</span><time datetime={e.date}>{day(e.date)}</time></p>
                      <p class="short">{e.short}</p>
                    </>
                  ) : (
                    <>
                      <a class="lead" href={`/writing/${e.slug}`}>
                        <span class="title">{e.title}</span><span class="dots" aria-hidden="true"></span><time datetime={e.date}>{day(e.date)}</time>
                      </a>
                      <p class="blurb">{e.blurb} <span class="mins">{e.minutes} min</span></p>
                    </>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </>
  )}
</section>

<style>
  /* The frame: the margin column (--mg) left of the rule, the writing right of it. The rule is the frame's own 1px
     background, so it runs the page's full height, header and all. */
  .nb {
    --mg: 7.5rem; --gut: 1.5rem; --pad: clamp(22px, 5vw, 72px); --W: 54rem;
    --rule: color-mix(in srgb, var(--seal) 55%, transparent);
    --line: rgba(var(--hairline-rgb), 0.2);
    --dot: rgba(var(--hairline-rgb), 0.75);
    box-sizing: border-box; max-width: calc(var(--mg) + var(--gut) + var(--W) + 2 * var(--pad)); margin: 0 auto;
    padding: 13vh var(--pad) 14vh;
    background: linear-gradient(var(--rule), var(--rule)) no-repeat calc(var(--pad) + var(--mg)) 0 / 1px 100%;
  }
  .row { display: grid; grid-template-columns: var(--mg) minmax(0, 1fr); align-items: baseline; }
  .mg { grid-column: 1; margin: 0; padding-right: var(--gut); display: flex; flex-direction: column; align-items: flex-end;
    gap: 8px; text-align: right; }
  .main { grid-column: 2; min-width: 0; padding-left: var(--gut); }

  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }
  .back:focus-visible, .lead:focus-visible { outline: 2px solid var(--ink-1); outline-offset: 3px; }

  h1 { margin: 20px 0 0; font: 400 clamp(46px, 6vw, 78px)/1 var(--font-display); letter-spacing: -0.02em; color: var(--ink-1); }
  .sub { margin: 14px 0 0; font: italic 400 clamp(19px, 1.7vw, 23px)/1.35 var(--font-accent); color: var(--ink-2); }
  .charter { margin: 18px 0 0; max-width: 56ch; font-size: 15px; line-height: 1.65; color: var(--ink-3); }
  .spine { margin: 22px 0 0; font: 11.5px/1.5 var(--font-mono); letter-spacing: 0.06em; color: var(--ink-3); }
  .nb-cow { margin-top: 5vh; }

  /* A kind's stamp: one ink, a 1px edge, mono capitals. */
  .stamp { display: inline-block; padding: 3px 6px 2px; border: 1px solid currentColor; border-radius: 2px;
    font: 10px/1.2 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; color: var(--ink-2); }

  /* ── THE KEY, which is also the filter: a checked stamp is inked in the accent, as the nav's pill is. */
  .key { margin-top: 8vh; }
  .key-k { font: 10.5px/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .opts { display: grid; grid-template-columns: auto repeat(3, minmax(0, 1fr)); gap: 16px 28px; }
  .opt { position: relative; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 8px; cursor: pointer; }
  .opt input { position: absolute; width: 1px; height: 1px; margin: 0; opacity: 0; pointer-events: none; }
  .cnt { font: 11px/1 var(--font-mono); color: var(--ink-3); }
  .gloss { flex-basis: 100%; font-size: 13px; line-height: 1.5; color: var(--ink-3); }
  @media (hover: hover) { .opt:hover .stamp { color: var(--ink-1); } }
  .opt:has(input:checked) .stamp { background: var(--ochre); border-color: var(--ochre); color: var(--on-accent); }
  .opt:has(input:focus-visible) .stamp { outline: 2px solid var(--ink-1); outline-offset: 3px; }
  .opt:has(input:disabled) { cursor: default; opacity: 0.55; }
  /* ponytail: one pair per kind, by hand; a fourth kind adds a pair here. */
  .nb:has(input[value='notes']:checked) .entry:not([data-kind='notes']),
  .nb:has(input[value='notes']:checked) .year:not(:has([data-kind='notes'])),
  .nb:has(input[value='explainers']:checked) .entry:not([data-kind='explainers']),
  .nb:has(input[value='explainers']:checked) .year:not(:has([data-kind='explainers'])),
  .nb:has(input[value='methods']:checked) .entry:not([data-kind='methods']),
  .nb:has(input[value='methods']:checked) .year:not(:has([data-kind='methods'])) { display: none; }

  /* ── THE CONTENTS: a year in the margin over a ruled line, then its entries, each ruled across the margin too. */
  .year { margin-top: 8vh; }
  .yr { margin: 0; padding-bottom: 10px; border-bottom: 1px solid rgba(var(--hairline-rgb), 0.5);
    font: 400 30px/1 var(--font-display); color: var(--ink-1); }
  .yr .mg { display: block; }
  .entries { list-style: none; margin: 0; padding: 0; }
  .entry { padding: 18px 0 20px; border-bottom: 1px solid var(--line); }
  .no { font: 400 18px/1 var(--font-display); color: var(--ink-2); white-space: nowrap; }
  .no-k { margin-right: 3px; font: 10px/1 var(--font-mono); color: var(--ink-3); }

  /* The title runs on leaders to its date, which sits on the title's last line. */
  .lead { display: flex; align-items: last baseline; margin: 0; color: var(--ink-1); text-decoration: none; }
  .title { font: 400 19px/1.3 var(--font-display); color: var(--ink-1); text-wrap: pretty; }
  .dots { flex: 1 1 1.5em; min-width: 1.5em; height: 3px; margin: 0 10px;
    background: radial-gradient(circle, var(--dot) 0 0.85px, transparent 1.15px) 0 0 / 6px 3px repeat-x; }
  .lead time { flex: none; margin-left: auto; padding-left: 12px; font: 12px/1 var(--font-mono); letter-spacing: 0.04em;
    color: var(--ink-3); }
  @media (hover: hover) {
    a.lead:hover { --dot: var(--ink-1); }
    a.lead:hover .title { text-decoration: underline 1px var(--seal); text-underline-offset: 4px; }
  }
  .blurb { margin: 8px 0 0; max-width: 62ch; font-size: 14.5px; line-height: 1.6; color: var(--ink-3); }
  .mins { margin-left: 4px; font: 11px/1 var(--font-mono); letter-spacing: 0.04em; white-space: nowrap; color: var(--ink-3); }
  /* A short note, read whole: its title in italic, and the note itself in Georgia, the stream's one passage of prose. */
  .entry-short .title { font-style: italic; }
  .short { margin: 10px 0 0; max-width: 60ch; font: 400 17px/1.6 var(--font-display); color: var(--ink-2); }

  @media (max-width: 1100px) {
    .opts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* A phone: the margin closes to the rule at the left edge, and what it held becomes a line over the entry. */
  @media (max-width: 640px) {
    .nb { --mg: 0px; --gut: 16px; --pad: 20px; padding-top: 12vh; }
    .row { grid-template-columns: minmax(0, 1fr); }
    .mg, .main { grid-column: 1; }
    .mg { flex-direction: row; align-items: baseline; justify-content: flex-start; gap: 12px; padding: 0 0 8px var(--gut); text-align: left; }
    .opts { grid-template-columns: minmax(0, 1fr); }
  }
</style>
