---
// /proto-writing, direction "Contents": a piece set as a magazine feature. A running head (its department, its issue),
// the title large, the standfirst in the accent italic, a byline; then the body on a ~70-character line with a drop
// cap and a small-caps-style first line, paragraphs indented rather than spaced, the blockquote as a pull quote across
// the body and its margin, equations centred with room, a margin note in the margin (in the column from 1100px down)
// and a tombstone after the last paragraph. No script.
//
// The body is set:html, so every rule for it is :global under .cp-body (CLAUDE.md, trap 1).
import type { SAMPLE } from '../../data/protoWriting';
import { KINDS } from '../../data/protoWriting';
import { longDate } from '../../lib/dates';

interface Props { piece: typeof SAMPLE }
const { piece } = Astro.props;
// ponytail: ContentsIndex's quarter-to-season rule, repeated; one module when this leaves the prototype.
const SEASONS = ['Winter', 'Spring', 'Summer', 'Autumn'];
const issue = `${SEASONS[Math.floor((Number(piece.date.slice(5, 7)) - 1) / 3)]} ${piece.date.slice(0, 4)}`;
---
<article class="cp">
  <a class="back" href="/writing">← writing</a>
  <header class="cp-head">
    <p class="cp-run"><span class="cp-k">{KINDS[piece.kind].label}</span><span>Writing · {issue}</span></p>
    <h1>{piece.title}</h1>
    <p class="cp-stand">{piece.standfirst}</p>
    <p class="cp-by">By Ing Tian · <time datetime={piece.date}>{longDate(piece.date)}</time> · {piece.minutes} min read</p>
  </header>
  <div class="cp-body"><Fragment set:html={piece.html} /></div>
  <footer class="cp-foot"><a class="back" href="/writing">← writing</a><span>{issue}</span></footer>
</article>

<style>
  /* The measure: a body column (--body) and, wider than 1100px, a margin (--note) a gap (--gap) to its right, which
     the notes float into and the pull quote spans. From 1100px down both are 0 and the page is one column. */
  .cp { --body: 40rem; --gap: clamp(28px, 3.5vw, 56px); --note: clamp(170px, 17vw, 250px);
    width: min(100% - 2 * clamp(22px, 5vw, 72px), var(--body) + var(--gap) + var(--note));
    margin: 0 auto; padding: 13vh 0 14vh; }
  @media (max-width: 1100px) { .cp { --gap: 0px; --note: 0px; } }

  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }

  .cp-run { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 24px; margin: 28px 0 0;
    padding-bottom: 10px; border-bottom: 1px solid var(--ink-1);
    font: 11px/1.3 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .cp-k { color: var(--seal); }
  .cp-head h1 { margin: clamp(26px, 4.5vh, 48px) 0 0 -0.03em; font: 400 clamp(42px, 6vw, 96px)/1 var(--font-display);
    letter-spacing: -0.03em; color: var(--ink-1); text-wrap: balance; }
  .cp-stand { max-width: var(--body); margin: clamp(18px, 2.6vh, 30px) 0 0;
    font: italic 400 clamp(20px, 1.9vw, 26px)/1.4 var(--font-accent); color: var(--ink-2); text-wrap: pretty; }
  .cp-by { margin: 24px 0 0; font: 11.5px/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }

  /* ── THE BODY. --fs is named so the drop cap can size from it: ::first-letter inherits ::first-line's smaller size. */
  .cp-body { --fs: 18px; margin: clamp(44px, 7vh, 76px) calc(var(--note) + var(--gap)) 0 0;
    font-size: var(--fs); line-height: 1.72; color: var(--ink-2); }
  .cp-body > :global(*) { margin: 0; }
  .cp-body > :global(* + *) { margin-top: 1.15em; }
  .cp-body > :global(p + p:not(.w-src)) { margin-top: 0; text-indent: 1.5em; }

  /* The drop cap, three lines deep: its cap height spans two line-heights and a body cap. */
  .cp-body > :global(p:first-child::first-line) { font-size: 0.86em; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-1); }
  .cp-body > :global(p:first-child::first-letter) { float: left; margin: 0.03em 0.08em 0 -0.03em;
    font: 400 calc(var(--fs) * 6)/0.8 var(--font-display); letter-spacing: 0; color: var(--seal); }

  .cp-body > :global(h2) { margin-top: 2.3em; font: 400 clamp(24px, 2.3vw, 31px)/1.2 var(--font-display);
    letter-spacing: -0.01em; color: var(--ink-1); }
  .cp-body > :global(h2::before) { content: ''; display: block; width: 2.2rem; height: 2px; margin-bottom: 0.7em;
    background: var(--seal); }
  .cp-body > :global(h3) { margin-top: 1.9em; font: italic 400 clamp(19px, 1.7vw, 22px)/1.3 var(--font-accent);
    color: var(--ink-1); }
  .cp-body > :global(h2 + *), .cp-body > :global(h3 + *) { margin-top: 0.6em; }

  .cp-body :global(strong) { font-weight: 600; color: var(--ink-1); }
  .cp-body :global(em) { font-style: italic; }
  .cp-body :global(a) { color: var(--ink-1); text-decoration: underline 1px var(--seal); text-underline-offset: 0.18em; }
  .cp-body :global(math) { color: var(--ink-1); }
  .cp-body :global(p math) { font-size: 1.05em; }

  .cp-body :global(ul) { padding: 0; list-style: none; }
  .cp-body :global(ul > li) { position: relative; padding-left: 1.6em; }
  .cp-body :global(ul > li + li) { margin-top: 0.55em; }
  .cp-body :global(ul > li::before) { content: '\2014'; position: absolute; left: 0; color: var(--seal); }

  /* An equation, given room: centred while it fits, flush left and scrolling once it does not (safe), at display
     size (math-style: normal), since lib/equations' maths is inline. */
  .cp-body > :global(.w-eq) { display: flex; justify-content: safe center; margin: 1.8em 0; padding: 0.3em 0;
    overflow-x: auto; overflow-y: hidden; }
  .cp-body :global(.w-eq math) { font-size: 1.3em; math-style: normal; }

  /* A margin note: floated into the margin beside what follows it; in the column from 1100px down. */
  .cp-body > :global(.w-note) { float: right; clear: right; width: var(--note);
    margin: 0.4em calc(-1 * (var(--note) + var(--gap))) 1em 0; padding-top: 10px; border-top: 2px solid var(--seal);
    font-size: 13.5px; line-height: 1.55; color: var(--ink-3); }
  .cp-body :global(.w-note strong) { display: block; margin-bottom: 4px; font: 600 10.5px/1.3 var(--font-mono);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-1); }

  /* The pull quote, across the body and the margin, below any note: the accent italic, between a heavy rule and a
     hairline, its opening mark hung in seal. */
  .cp-body > :global(blockquote) { clear: right; margin: 1.1em calc(-1 * (var(--note) + var(--gap))) 1.1em 0;
    padding: 0.5em 0 0.6em; border-top: 2px solid var(--ink-1); border-bottom: 1px solid rgba(var(--hairline-rgb), 0.45);
    font: italic 400 clamp(26px, 3vw, 42px)/1.16 var(--font-accent); letter-spacing: -0.01em; color: var(--ink-1);
    text-wrap: balance; }
  .cp-body > :global(blockquote::before) { content: '\201C'; display: inline-block; width: 0.45em; margin-left: -0.45em;
    color: var(--seal); }
  .cp-body > :global(blockquote::after) { content: '\201D'; color: var(--seal); }

  .cp-body > :global(.w-src) { clear: both; margin-top: 3em; padding-top: 14px; border-top: 1px solid rgba(var(--hairline-rgb), 0.4);
    font: 12px/1.6 var(--font-mono); letter-spacing: 0.02em; color: var(--ink-3); }

  /* The end: a tombstone, the end of a proof, after the last paragraph of prose. */
  .cp-body > :global(p:has(+ .w-src)::after), .cp-body > :global(p:last-child:not(.w-src)::after) {
    content: ''; display: inline-block; width: 0.55em; height: 0.55em; margin-left: 0.4em; background: var(--seal); }

  .cp-foot { display: flex; justify-content: space-between; gap: 16px; margin-top: 10vh; padding-top: 14px;
    border-top: 1px solid var(--ink-1); font: 11px/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ink-3); }

  @media (max-width: 1100px) {
    .cp-body > :global(.w-note) { float: none; width: auto; margin: 1.4em 0; }
  }
  @media (max-width: 640px) {
    .cp-head h1 { font-size: clamp(36px, 10.5vw, 54px); }
    .cp-body { --fs: 17px; }
    .cp-body > :global(blockquote) { font-size: clamp(24px, 7vw, 30px); }
  }
</style>
