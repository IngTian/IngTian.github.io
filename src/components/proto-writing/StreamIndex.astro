---
// PROTOTYPE, direction "Stream": /writing as a well-kept personal log. One stream, newest first, grouped by year; a
// hairline and a month stamp in the gutter mark each new month, the day sits beside every entry. A long piece is a row
// that links out (its kind, minutes, title, blurb); a short note is a post, set whole, its title run in, closed by a
// seal-red end mark: that is all of it. A kind is a chart legend's marker drawn in ink (notes a circle, explainers a
// diamond, methods a square), keyed once in the head with its gloss and count. No filter and no script: at 24 a log
// reads by scrolling. With nothing written, the cow holds the space.
import PlushCow from '../PlushCow.astro';
import { COW_LINES_WRITING } from '../../data/cowGlyph';
import { CHARTER, KINDS, type Kind, type Piece } from '../../data/protoWriting';
import { longDate, monthYear } from '../../lib/dates';

interface Props { pieces: Piece[] }
const { pieces } = Astro.props;

const MON = 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split(' ');
// A tag names one piece, so it is the kind's key in the singular (all three end in a plain s).
const one = (k: Kind) => k.slice(0, -1);
const runIn = (t: string) => (/[.?!]$/.test(t) ? t : `${t}.`);

const kinds = (Object.keys(KINDS) as Kind[]).map((k) => ({ k, ...KINDS[k], n: pieces.filter((p) => p.kind === k).length }));
const years = [...new Set(pieces.map((p) => p.date.slice(0, 4)))].map((y) => {
  const list = pieces.filter((p) => p.date.startsWith(y));
  // `first` opens a month: it carries the month's hairline and its stamp.
  return { y, list: list.map((p, i) => ({ ...p, first: i === 0 || list[i - 1].date.slice(0, 7) !== p.date.slice(0, 7) })) };
});
const oldest = pieces.at(-1);
---
<section class="st">
  <header class="st-head">
    <a class="back" href="/">← back</a>
    <h1>Writing</h1>
    {pieces.length > 0 && <p class="st-aside">Thinking out loud, with the mathematics left in.</p>}
    <p class="st-charter">{CHARTER}</p>
    {oldest && (
      <>
        <p class="st-tally">{pieces.length} {pieces.length === 1 ? 'entry' : 'entries'} since {monthYear(oldest.date)} · newest first</p>
        <dl class="st-key">
          {kinds.map((k) => (
            <div>
              <dt><i class:list={['mk', `mk--${k.k}`]} aria-hidden="true"></i>{k.label}<span class="st-kn">{k.n || 'none yet'}</span></dt>
              <dd>{k.gloss}</dd>
            </div>
          ))}
        </dl>
      </>
    )}
  </header>

  {pieces.length === 0 ? (
    <div class="st-cow">
      <PlushCow size="large" lines={COW_LINES_WRITING} label="A cow, holding the space until something is written here. Press it." />
    </div>
  ) : (
    <div class="st-stream">
      {years.map(({ y, list }) => (
        <section class="st-year">
          <header class="st-yh">
            <h2>{y}</h2>
            <p>{list.length} {list.length === 1 ? 'entry' : 'entries'}</p>
          </header>
          <ol class="st-list">
            {list.map((p) => (
              <li class:list={['st-e', p.short ? 'st-post' : 'st-row', p.first && 'is-first']} id={p.short ? `w-${p.slug}` : undefined}>
                <p class="st-when" aria-hidden="true">
                  <span class:list={['st-mon', !p.first && 'is-rep']}>{MON[Number(p.date.slice(5, 7)) - 1]}</span>
                  <span class="st-day">{p.date.slice(8)}</span>
                </p>
                <div class="st-body">
                  <p class="st-meta">
                    <span class="st-tag"><i class:list={['mk', `mk--${p.kind}`]} aria-hidden="true"></i>{one(p.kind)}</span>
                    <span>{p.short ? 'the whole note' : `${p.minutes} min`}</span>
                    <time class="sr-only" datetime={p.date}>{longDate(p.date)}</time>
                  </p>
                  {p.short ? (
                    <div class="st-text">
                      <h3>{runIn(p.title)}</h3> <p>{p.short}</p>
                    </div>
                  ) : (
                    <>
                      <h3 class="st-title"><a href={`/writing/${p.slug}`}>{p.title}<span class="st-go" aria-hidden="true">→</span></a></h3>
                      <p class="st-blurb">{p.blurb}</p>
                    </>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
      {oldest && <p class="st-end">That’s the bottom: the first entry, {longDate(oldest.date)}.</p>}
      <footer class="st-foot"><a class="back" href="/">← back to the descent</a></footer>
    </div>
  )}
</section>

<style>
  /* The column, as /experience sets it: clear of the rail's column when wide, the full width at 1100px and under. */
  .st { max-width: 1120px; margin: 0 auto; padding: 14vh clamp(20px, 5vw, 72px) 0; box-sizing: border-box; }
  @media not all and (max-width: 1100px) { .st { padding-left: clamp(190px, 13vw, 230px); } }
  .st-head, .st-stream { max-width: 50rem; }

  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }
  .back:focus-visible, .st-title a:focus-visible { outline: 2px solid var(--seal); outline-offset: 3px; border-radius: 1px; }

  /* ── THE HEAD ── */
  .st h1 { margin: 16px 0 0; font: 500 clamp(40px, 5vw, 60px)/1.04 var(--font-display); letter-spacing: -0.01em; color: var(--ink-1); }
  .st-aside { margin: 12px 0 0; font: italic 400 clamp(18px, 1.6vw, 21px)/1.4 var(--font-accent); color: var(--ink-2); }
  .st-charter { margin: 18px 0 0; max-width: 58ch; font-size: 15px; line-height: 1.65; color: var(--ink-3); }
  .st-tally { margin: 34px 0 0; font: 12px/1.5 var(--font-mono); letter-spacing: 0.02em; color: var(--ink-3); }

  /* The key: a chart legend, one marker per kind, its count and its gloss. */
  .st-key { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 14px 0 0; padding-top: 16px;
    border-top: 1px solid rgba(var(--hairline-rgb), 0.22); }
  .st-key dt { display: flex; align-items: baseline; font: 12px/1.4 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-1); }
  .st-kn { margin-left: auto; padding-left: 10px; color: var(--ink-3); }
  .st-key dd { margin: 6px 0 0; font-size: 13.5px; line-height: 1.55; color: var(--ink-3); }

  /* The markers: borders, not backgrounds, so forced colours draw them too. */
  .mk { display: inline-block; flex: none; width: 0; height: 0; margin-right: 8px; border: 3.5px solid currentColor;
    vertical-align: 0.08em; }
  .mk--notes { border-radius: 50%; }
  .mk--explainers { transform: rotate(45deg) scale(0.88); }

  /* ── THE STREAM ── */
  .st-stream { margin-top: 56px; }
  .st-year + .st-year { margin-top: 72px; }
  .st-yh { display: flex; align-items: baseline; gap: 14px; }
  .st-yh h2 { margin: 0; font: 500 clamp(30px, 3vw, 40px)/1 var(--font-display); letter-spacing: -0.01em; color: var(--ink-1); }
  .st-yh p { margin: 0; font: 12px/1 var(--font-mono); color: var(--ink-3); }

  .st-list { list-style: none; margin: 18px 0 0; padding: 0; }
  .st-e { position: relative; display: grid; grid-template-columns: 6rem minmax(0, 1fr); padding: 14px 0; }
  /* A month opens with a hairline across the stream. */
  .st-e.is-first { margin-top: 10px; padding-top: 20px; border-top: 1px solid rgba(var(--hairline-rgb), 0.22); }
  .st-when { display: flex; flex-direction: column; gap: 5px; margin: 0; }
  .st-mon { font: 11px/1.4 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); }
  .st-mon.is-rep { visibility: hidden; }
  .st-day { font: 400 24px/1 var(--font-display); color: var(--ink-3); }

  .st-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin: 0;
    font: 11px/1.4 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); }
  .st-tag { color: var(--ink-2); }

  /* A row: the title links out, and the whole row is its target. */
  .st-title { margin: 6px 0 0; font: 500 clamp(19px, 1.6vw, 22px)/1.3 var(--font-display); color: var(--ink-1); text-wrap: pretty; }
  .st-title a { color: inherit; text-decoration: none; }
  .st-title a::after { content: ''; position: absolute; inset: 0; }
  .st-go { display: inline-block; margin-left: 0.35em; font-family: var(--font-body); color: var(--ink-3); }
  .st-blurb { margin: 6px 0 0; max-width: 60ch; font-size: 15px; line-height: 1.6; color: var(--ink-3); }
  @media (hover: hover) {
    .st-row:hover .st-title a { text-decoration: underline 1px var(--seal); text-underline-offset: 4px; }
    .st-row:hover .st-go { color: var(--seal); transform: translateX(4px); }
  }
  @media (prefers-reduced-motion: no-preference) { .st-go { transition: transform 160ms ease-out, color 160ms ease-out; } }

  /* A post: the short note set whole, its title run in, closed by the seal's end mark. */
  .st-post { padding: 20px 0 24px; }
  .st-text { margin-top: 8px; max-width: 34em; font: 400 clamp(19px, 1.7vw, 22px)/1.5 var(--font-display); color: var(--ink-1);
    text-wrap: pretty; }
  .st-text h3, .st-text p { display: inline; margin: 0; font: inherit; }
  .st-text h3 { font-weight: 700; }
  .st-text p::after { content: ''; display: inline-block; margin-left: 0.4em; border: 0.24em solid var(--seal); vertical-align: 0.05em; }

  .st-end { margin: 48px 0 0; padding-top: 16px; border-top: 1px solid rgba(var(--hairline-rgb), 0.22);
    font: 12px/1.5 var(--font-mono); color: var(--ink-3); }

  .st-cow { margin: clamp(10px, 2vh, 26px) 0 0; padding-bottom: 14vh; }
  .st-foot { padding: 10vh 0 16vh; }

  @media (max-width: 640px) {
    .st { padding-top: 12vh; }
    .st-key { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .st-e { grid-template-columns: 3.4rem minmax(0, 1fr); }
    .st-mon { letter-spacing: 0.08em; }
    .st-day { font-size: 20px; }
  }
</style>
