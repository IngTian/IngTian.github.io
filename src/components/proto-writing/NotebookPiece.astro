---
// PROTOTYPE (claude/writing-proto) — "Notebook", the piece: one notebook page. The entry's number and its kind's
// stamp sit in the left margin, outside the seal-red margin rule, and each section's § hangs there too. Past 1100px
// the outer margin on the right holds the standfirst, beside the title, and every aside.w-note, beside the text it
// follows (floats, so no script places them); from 1100px down both fall in under what they annotate. The last
// paragraph ends on ∎, and the foot turns to the previous and next pages. The column is NotebookIndex's.
import type { SAMPLE } from '../../data/protoWriting';
import { KINDS, PIECES } from '../../data/protoWriting';
import { longDate } from '../../lib/dates';

interface Props { piece: typeof SAMPLE }
const { piece } = Astro.props;

// The entry's number, from the oldest; the neighbours are the nearest entries with a page (a short note has none).
const at = PIECES.findIndex((p) => p.slug === piece.slug);
const no = (i: number) => String(PIECES.length - i).padStart(3, '0');
const near = (i: number) => (i < 0 || !PIECES[i] ? null : { ...PIECES[i], no: no(i) });
const older = near(PIECES.findIndex((p, i) => i > at && !p.short));
const newer = near(PIECES.findLastIndex((p, i) => i < at && !p.short));
// ponytail: the singular by dropping a plural "s", as in NotebookIndex.
const stamp = KINDS[piece.kind].label.replace(/s$/, '');
---
<article class="nb">
  <div class="row"><div class="main"><a class="back" href="/writing">← writing</a></div></div>

  <header class="row head">
    <p class="mg"><span class="no"><span class="no-k">No.</span>{no(at)}</span><span class="stamp">{stamp}</span></p>
    <div class="main title-block">
      <div>
        <h1>{piece.title}</h1>
        <p class="meta"><time datetime={piece.date}>{longDate(piece.date)}</time> · {piece.minutes} min read</p>
      </div>
      <p class="standfirst">{piece.standfirst}</p>
    </div>
  </header>

  <div class="row body">
    <div class="main"><div class="nb-prose"><Fragment set:html={piece.html} /></div></div>
  </div>

  <footer class="row foot">
    <div class="main">
      {(older || newer) && (
        <nav class="turn" aria-label="Neighbouring entries">
          {older && (
            <a class="prev" href={`/writing/${older.slug}`}>
              <span class="turn-k">← previous · No. {older.no}</span><span class="turn-t">{older.title}</span>
            </a>
          )}
          {newer && (
            <a class="next" href={`/writing/${newer.slug}`}>
              <span class="turn-k">next · No. {newer.no} →</span><span class="turn-t">{newer.title}</span>
            </a>
          )}
        </nav>
      )}
      <a class="back" href="/writing">← writing</a>
    </div>
  </footer>
</article>

<style>
  /* NotebookIndex's frame, with the right margin's two measures: the text (--M) and the notes (--N), --G apart. */
  .nb {
    --mg: 7.5rem; --gut: 1.5rem; --pad: clamp(22px, 5vw, 72px);
    --M: 36rem; --G: 3rem; --N: 15rem;
    --rule: color-mix(in srgb, var(--seal) 55%, transparent);
    --tick: color-mix(in srgb, var(--seal) 70%, transparent);
    box-sizing: border-box; max-width: calc(var(--mg) + var(--gut) + var(--M) + var(--G) + var(--N) + 2 * var(--pad));
    margin: 0 auto; padding: 13vh var(--pad) 14vh;
    background: linear-gradient(var(--rule), var(--rule)) no-repeat calc(var(--pad) + var(--mg)) 0 / 1px 100%;
  }
  .row { display: grid; grid-template-columns: var(--mg) minmax(0, 1fr); align-items: baseline; }
  .mg { grid-column: 1; margin: 0; padding-right: var(--gut); display: flex; flex-direction: column; align-items: flex-end;
    gap: 12px; text-align: right; }
  .main { grid-column: 2; min-width: 0; padding-left: var(--gut); }

  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }
  .back:focus-visible, .turn a:focus-visible { outline: 2px solid var(--ink-1); outline-offset: 3px; }

  /* ── THE HEAD: the number large in the margin, on the title's first baseline; the stamp under it, inked a touch
     askew and double-ruled; the standfirst in the outer margin, in the margin's voice. */
  .head { margin-top: 28px; }
  .no { font: 400 40px/1 var(--font-display); color: var(--ink-1); white-space: nowrap; }
  .no-k { margin-right: 4px; font: 11px/1 var(--font-mono); color: var(--ink-3); }
  .stamp { display: inline-block; padding: 3px 6px 2px; border: 1px solid currentColor; border-radius: 2px;
    outline: 1px solid currentColor; outline-offset: 2px; transform: rotate(-2deg);
    font: 10px/1.2 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; color: var(--ink-2); }
  .title-block { display: grid; grid-template-columns: minmax(0, 1fr) var(--N); column-gap: var(--G); align-items: end; }
  h1 { margin: 0; font: 400 clamp(34px, 3.4vw, 48px)/1.1 var(--font-display); letter-spacing: -0.015em; color: var(--ink-1);
    text-wrap: balance; }
  .meta { margin: 16px 0 0; font: 12px/1.4 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); }
  /* Every note in the margin opens on a short seal tick. */
  .standfirst { margin: 0; padding-top: 12px; background: linear-gradient(var(--tick), var(--tick)) no-repeat 0 0 / 1.75rem 1px;
    font: italic 400 16.5px/1.5 var(--font-accent); color: var(--ink-2); }

  /* ── THE BODY. It is set:html, so every rule under .nb-prose reaches it through :global (CLAUDE.md, trap 1). */
  .body { margin-top: 7vh; }
  .nb-prose { width: calc(100% - var(--G) - var(--N)); counter-reset: nb-sec; font-size: 17px; line-height: 1.72; color: var(--ink-2); }
  .nb-prose > :global(* + *) { margin-top: 1.15em; }
  .nb-prose > :global(:first-child) { margin-top: 0; }
  .nb-prose :global(h2) { counter-increment: nb-sec; margin-top: 2.3em; font: 400 clamp(23px, 2vw, 27px)/1.25 var(--font-display);
    color: var(--ink-1); text-wrap: balance; }
  /* The § hangs in the left margin, right-set against the rule like the entry's number, and keeps the heading's
     baseline because it is inline: its negative left margin and its right margin cancel. */
  .nb-prose :global(h2::before) { content: '§' counter(nb-sec); display: inline-block; box-sizing: border-box;
    width: calc(var(--mg) - var(--gut)); margin: 0 calc(2 * var(--gut)) 0 calc(-1 * (var(--mg) + var(--gut)));
    text-align: right; font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); }
  .nb-prose :global(h3) { margin-top: 1.9em; font: italic 400 20px/1.3 var(--font-accent); color: var(--ink-1); }
  .nb-prose :global(em) { font-style: italic; }
  .nb-prose :global(strong) { font-weight: 600; color: var(--ink-1); }
  .nb-prose :global(ul) { padding-left: 1.5em; list-style: '\2013\00A0\00A0'; }
  .nb-prose :global(li::marker) { color: var(--ink-3); }
  .nb-prose :global(li + li) { margin-top: 0.45em; }
  .nb-prose :global(math) { color: var(--ink-1); }
  /* A display: indented, flush left (centred in a scroll box, a wide one would lose its left end), and set in
     display style although lib/equations' inlineMath writes it inline. */
  .nb-prose :global(.w-eq) { margin: 1.5em 0; padding: 2px 0 2px 1.5rem; overflow-x: auto; overflow-y: hidden; }
  .nb-prose :global(.w-eq math) { font-size: 1.12em; math-style: normal; }
  .nb-prose :global(blockquote) { position: relative; margin: 1.9em 0; padding-left: 1.4em;
    font: italic 400 clamp(21px, 1.9vw, 24px)/1.4 var(--font-display); color: var(--ink-1); text-wrap: pretty; }
  .nb-prose :global(blockquote::before) { content: '\201C'; position: absolute; left: -0.05em; top: -0.12em;
    font: 400 2.4em/1 var(--font-display); color: var(--seal); }
  .nb-prose :global(.w-src) { margin-top: 2.6em; padding-top: 12px; border-top: 1px solid rgba(var(--hairline-rgb), 0.25);
    font: 12.5px/1.6 var(--font-mono); color: var(--ink-3); }
  /* ∎ — the entry is finished: after the last paragraph, before any source line. */
  .nb-prose :global(p:has(+ .w-src)::after), .nb-prose > :global(p:last-child:not(.w-src)::after) { content: '\220E'; margin-left: 0.4em;
    color: var(--seal); }
  /* A note falls in under the text it follows, behind a seal hairline; past 1100px it floats into the outer margin. */
  .nb-prose :global(.w-note) { display: block; margin: 1.2em 0; padding-left: 1rem; border-left: 1px solid var(--tick);
    font-size: 14px; line-height: 1.55; color: var(--ink-3); }
  .nb-prose :global(.w-note strong) { color: var(--ink-1); }
  @media not all and (max-width: 1100px) {
    .nb-prose :global(.w-note) { float: right; clear: right; width: var(--N); margin: 0.3em calc(-1 * (var(--G) + var(--N))) 0 0;
      padding: 12px 0 0; border-left: 0; background: linear-gradient(var(--tick), var(--tick)) no-repeat 0 0 / 1.75rem 1px;
      font-size: 13.5px; }
  }

  /* ── THE FOOT: turn the page. */
  .foot { margin-top: 12vh; }
  .turn { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-bottom: 40px; padding-top: 18px;
    border-top: 1px solid rgba(var(--hairline-rgb), 0.25); }
  .turn a { display: block; color: var(--ink-1); text-decoration: none; }
  .turn .next { grid-column: 2; text-align: right; }
  .turn-k { display: block; font: 11px/1.4 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); }
  .turn-t { display: block; margin-top: 6px; font: 400 17px/1.35 var(--font-display); color: var(--ink-1); text-wrap: balance; }
  @media (hover: hover) { .turn a:hover .turn-t { text-decoration: underline 1px var(--seal); text-underline-offset: 4px; } }

  @media (max-width: 1100px) {
    .title-block { grid-template-columns: minmax(0, 1fr); row-gap: 24px; }
    .standfirst { max-width: var(--M); font-size: 19px; }
    .nb-prose { width: auto; max-width: var(--M); }
  }
  /* A phone: the margin closes to the rule at the left edge; the number and stamp become a line over the title, and
     the § comes inside its heading. */
  @media (max-width: 640px) {
    .nb { --mg: 0px; --gut: 16px; --pad: 20px; padding-top: 12vh; }
    .row { grid-template-columns: minmax(0, 1fr); }
    .mg, .main { grid-column: 1; }
    .mg { flex-direction: row; align-items: center; justify-content: flex-start; gap: 16px; padding: 0 0 14px var(--gut); text-align: left; }
    .no { font-size: 28px; }
    .nb-prose { font-size: 16.5px; }
    .nb-prose :global(h2::before) { display: inline; width: auto; margin: 0 0.5em 0 0; }
    .turn { grid-template-columns: minmax(0, 1fr); }
    .turn .next { grid-column: 1; text-align: left; }
  }
</style>
