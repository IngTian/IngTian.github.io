---
// PROTOTYPE (throwaway): one piece of the searchable base, on the paper sheet. The header, a wide computed cover, the
// body on a ~68ch measure in Georgia at 18px (the sheet's reading face, in both type options: the switch moves the
// headings only), and at its foot the pieces either side of it in the index's order, as the index's cards.
// The card markup and its CSS repeat BaseIndex's on purpose, class for class: a prototype gets two files.
import type { SAMPLE } from '../../data/protoWriting';
import { PIECES, KINDS, TOPICS } from '../../data/protoWriting';
import { coverSvg } from '../../lib/protoCovers';
import { longDate } from '../../lib/dates';

interface Props { piece: typeof SAMPLE }
const { piece } = Astro.props;

// Previous and Next in the index's order (newest first), wrapping at the ends so the newest piece shows both.
const i = PIECES.findIndex((p) => p.slug === piece.slug);
const at = (k: number) => PIECES[(k + PIECES.length) % PIECES.length];
const around = [{ dir: '← Previous', p: at(i - 1) }, { dir: 'Next →', p: at(i + 1) }];
---
<div class="wbp">
  <article>
    <header class="wbp-head">
      <a class="back" href="/writing">← writing</a>
      <p class="wb-kicker">
        <span class="wb-kind">{KINDS[piece.kind].label}</span>
        {piece.topics.map((t) => <span class="wb-pill">{TOPICS[t].label}</span>)}
      </p>
      <h1 class="wbp-h1">{piece.title}</h1>
      <p class="wbp-stand">{piece.standfirst}</p>
      <p class="wb-meta"><time datetime={piece.date}>{longDate(piece.date)}</time> · {piece.minutes} min read</p>
    </header>
    <div class="wb-cv wbp-banner"><Fragment set:html={coverSvg(piece.topics[0], piece.slug, 1200, 360)} /></div>
    <div class="wbp-body"><Fragment set:html={piece.html} /></div>
  </article>

  <nav class="wbp-around" aria-label="More writing">
    {around.map(({ dir, p }) => (
      <div class="wb-card">
        <p class="wbp-dir">{dir}</p>
        <div class="wb-cv">
          <Fragment set:html={coverSvg(p.topics[0], p.slug, 400, 250)} />
          <span class="wb-min">{p.minutes} min</span>
        </div>
        <p class="wb-kicker"><span class="wb-kind">{KINDS[p.kind].label}</span><span class="wb-pill">{TOPICS[p.topics[0]].label}</span></p>
        <h2 class="wb-t wb-title"><a href={`/writing/${p.slug}`}>{p.title}</a></h2>
        <p class="wb-blurb">{p.blurb}</p>
        <p class="wb-meta"><time datetime={p.date}>{longDate(p.date)}</time></p>
      </div>
    ))}
  </nav>
</div>

<style>
  .wbp { max-width: 1240px; margin: 0 auto; padding: 15vh clamp(22px, 5vw, 72px) 96px; font-family: var(--font-body); color: var(--ink-2); }
  .wbp :focus-visible { outline: 2px solid var(--ochre); outline-offset: 2px; border-radius: 2px; }
  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }

  /* ── the header ── */
  .wbp-head { max-width: 820px; }
  .wbp-head .wb-kicker { margin-top: 28px; }
  .wbp-h1 { margin: 18px 0 0; font-family: var(--font-body); font-weight: 800; font-size: clamp(36px, 4.6vw, 60px); line-height: 1.04;
    letter-spacing: -0.03em; color: var(--ink-1); text-wrap: balance; }
  .wbp-stand { margin: 18px 0 0; max-width: 34em; font-size: 20px; line-height: 1.5; color: var(--ink-3); text-wrap: pretty; }
  .wbp-head .wb-meta { margin-top: 18px; }
  .wb-cv.wbp-banner { aspect-ratio: 10 / 3; margin-top: 40px; }

  /* ── the type switch: the headings only; the body stays Georgia ── */
  :global(html[data-w-type='serif']) .wbp-h1,
  :global(html[data-w-type='serif']) .wb-t { font-family: var(--font-display); font-weight: 400; letter-spacing: -0.01em; }

  /* ── the body: set:html, so every rule reaches in through :global, under .wbp-body ── */
  .wbp-body { max-width: 68ch; margin-top: 48px; font: 18px/1.65 var(--font-display); color: var(--ink-2); }
  .wbp-body :global(:where(p, ul, ol, blockquote, h2, h3, aside, div)) { margin: 0; }
  .wbp-body > :global(* + *) { margin-top: 1.1em; }
  .wbp-body :global(h2) { margin-top: 2em; font: 700 24px/1.25 var(--font-body); letter-spacing: -0.015em; color: var(--ink-1); }
  .wbp-body :global(h3) { margin-top: 1.7em; font: 700 19px/1.3 var(--font-body); letter-spacing: -0.01em; color: var(--ink-1); }
  :global(html[data-w-type='serif']) .wbp-body :global(h2) { font: 400 26px/1.25 var(--font-display); letter-spacing: 0; }
  :global(html[data-w-type='serif']) .wbp-body :global(h3) { font: italic 400 20px/1.3 var(--font-display); letter-spacing: 0; }
  .wbp-body :global(em) { font-style: italic; }
  .wbp-body :global(strong) { font-weight: 700; color: var(--ink-1); }
  .wbp-body :global(ul) { padding-left: 1.2em; }
  .wbp-body :global(li + li) { margin-top: 0.4em; }
  .wbp-body :global(li::marker) { color: var(--ink-3); }
  .wbp-body :global(blockquote) { margin-block: 1.8em; padding: 0.7em 0; font-size: 22px; line-height: 1.45; font-style: italic;
    color: var(--ink-1); border-block: 1px solid rgba(var(--hairline-rgb), 0.35); text-wrap: balance; }
  .wbp-body :global(.w-eq) { margin-block: 1.4em; padding: 0.3em 0; text-align: center; overflow-x: auto; overflow-y: hidden; }
  .wbp-body :global(.w-eq math) { math-style: normal; font-size: 1.1em; }
  .wbp-body :global(.w-note) { padding-top: 10px; font: 14.5px/1.55 var(--font-body); color: var(--ink-3);
    border-top: 1px solid rgba(var(--hairline-rgb), 0.35); }
  .wbp-body :global(.w-note strong) { font-weight: 600; }
  .wbp-body :global(.w-src) { margin-top: 2.4em; padding-top: 12px; font: 12px/1.5 var(--font-mono); color: var(--ink-3);
    border-top: 1px solid rgba(var(--hairline-rgb), 0.3); }
  /* wide, a note hangs in the margin beside the paragraph after it; its negative margin takes it out of the line */
  @media not all and (max-width: 1100px) {
    .wbp-body :global(.w-note) { float: right; clear: right; width: 220px; margin: 0.35em -260px 0 0; }
  }

  /* ── the cards either side: BaseIndex's card, class for class ── */
  .wbp-around { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 28px; margin-top: 96px; padding-top: 28px;
    border-top: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .wbp-dir { margin: 0 0 12px; font: 11px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }

  .wb-cv { position: relative; aspect-ratio: 8 / 5; overflow: hidden; border-radius: 6px;
    background: rgba(var(--hairline-rgb), 0.05); border: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .wb-cv :global(.cover) { display: block; width: 100%; height: 100%; }
  .wb-cv :global(.cv-ink) { --c: var(--ink-1); }
  .wb-cv :global(.cv-mid) { --c: var(--ink-3); }
  .wb-cv :global(.cv-seal) { --c: var(--seal); }
  .wb-cv :global(.cv-faint) { --c: rgba(var(--hairline-rgb), 0.22); }
  .wb-cv :global(.cv-s) { fill: none; stroke: var(--c, var(--ink-1)); }
  .wb-cv :global(.cv-f) { fill: var(--c, var(--ink-1)); stroke: none; }
  .wb-min { position: absolute; left: 10px; top: 10px; padding: 5px 8px; font: 11px/1 var(--font-mono); color: var(--ink-2);
    background: var(--sheet-ground); border: 1px solid rgba(var(--hairline-rgb), 0.3); border-radius: 999px; }
  .wb-kicker { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .wb-kind { margin-right: 2px; font: 11px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .wb-pill { padding: 4px 9px; font-size: 12px; font-weight: 500; line-height: 1; color: var(--ink-2);
    border: 1px solid rgba(var(--hairline-rgb), 0.35); border-radius: 999px; }
  .wb-meta { margin: 0; font: 12px/1.4 var(--font-mono); color: var(--ink-3); }
  .wb-t { margin: 0; font-family: var(--font-body); font-weight: 700; letter-spacing: -0.02em; color: var(--ink-1); text-wrap: balance; }
  .wb-t a { color: inherit; text-decoration: none; }
  .wb-t a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .wb-t a:focus-visible { outline: none; }
  .wb-card { position: relative; }
  .wb-card:has(.wb-t a:focus-visible) { outline: 2px solid var(--ochre); outline-offset: 10px; border-radius: 6px; }
  .wb-card .wb-kicker { margin-top: 16px; }
  .wb-title { margin-top: 10px; font-size: 20px; line-height: 1.25; }
  .wb-blurb { margin: 8px 0 0; font-size: 15px; line-height: 1.5; color: var(--ink-3);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }
  .wb-card .wb-meta { margin-top: 12px; }
  @media (hover: hover) {
    .wb-card:hover .wb-cv { transform: translateY(-3px); border-color: rgba(var(--hairline-rgb), 0.6); }
    .wb-card:hover .wb-t a { text-decoration: underline 1px; text-underline-offset: 0.16em; }
  }
  @media (prefers-reduced-motion: no-preference) { .wb-card .wb-cv { transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.3, 1); } }

  @media (max-width: 1100px) { .wbp-around { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .wbp { padding-top: 12vh; }
    .wb-cv.wbp-banner { aspect-ratio: 2 / 1; }
    .wbp-body { font-size: 17px; }
    .wbp-around { grid-template-columns: minmax(0, 1fr); gap: 44px; }
  }
</style>
