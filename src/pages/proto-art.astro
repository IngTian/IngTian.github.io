---
// PROTOTYPE (throwaway): the /art redesign, direction B, "The sentence", on a still paper sheet (the research
// routes' register). One sentence whose seal-red phrases each bring a work onto the mat beside it, then the
// calligraphy room, then every photograph in rows of one height; any work opens the dark room. /art itself is
// untouched. Data: data/protoArt.ts. Retire it by deleting this page, that file, its `want` entry and its paper
// mark in tests/distSmoke.test.ts, and CLAUDE.md's count.
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import { calligraphy, photography } from '../data/artworks';
import { PLACES, SENTENCES, type Phrase, type WorkKey } from '../data/protoArt';

// /art's byte rules (CLAUDE.md, Stack), as art.astro keeps them: sizes from getImage(), never off the import (the
// import is a Proxy; reading `.width` keeps the original in dist), a webp at native pixels for the dark room's 6x.
const zoomOf = async (src: ImageMetadata) => {
  const z = await getImage({ src, format: 'webp' });
  const { width: w, height: h } = z.options;
  if (!w || !h) throw new Error(`getImage() gave no native size for ${z.src}`);
  return { src: z.src, w, h };
};
const photoZoom = await Promise.all(photography.map((p) => zoomOf(p.src)));
const calZoom = await Promise.all(calligraphy.map((w) => zoomOf(w.src)));

// Every photograph sits in exactly one placeholder place.
const placed = PLACES.flatMap((p) => p.photos).sort((a, b) => a - b);
if (placed.length !== photography.length || placed.some((n, i) => n !== i + 1)) {
  throw new Error(`proto-art: the places hold ${placed.length} photographs; every one of the ${photography.length} goes in exactly one`);
}
const placeOf = new Map(PLACES.flatMap((pl) => pl.photos.map((n) => [n, `${pl.name}, ${pl.region}`] as const)));

const UNKNOWN = '—';
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
interface Work {
  key: WorkKey; src: ImageMetadata; alt: string; title: string; place: string; year: string; medium: string;
  z: { src: string; w: number; h: number }; ar: number; treatment?: 'stele' | 'paper';
}
// The dark room's one line, built once from the label's own fields.
const lineOf = (w: Work) => [w.title, w.place, w.year, w.medium].join(' · ');
const photos: Work[] = photography.map((p, i) => ({
  key: `photo-${String(i + 1).padStart(2, '0')}`, src: p.src, alt: p.alt, title: p.title ?? 'Untitled',
  place: `${placeOf.get(i + 1)} (placeholder)`, year: UNKNOWN, medium: 'Photograph',
  z: photoZoom[i], ar: photoZoom[i].w / photoZoom[i].h,
}));
// artworks.ts writes a work's medium as "<script> · <medium>" and its kicker as "Calligraphy · <script in Chinese>".
// The Chinese title is the brief's for the couplet (春聯); the poem has none on record, so it gets no line.
const ZH_TITLE = ['春聯'];
const cals = calligraphy.map((w, i) => {
  const [script = '', medium = ''] = (w.medium ?? '').split(' · ');
  const work: Work = {
    key: `cal-${i + 1}`, src: w.src, alt: w.alt, title: w.title ?? 'Untitled', place: UNKNOWN, year: UNKNOWN,
    medium: `${cap(script)}; ${medium}`, z: calZoom[i], ar: calZoom[i].w / calZoom[i].h, treatment: w.treatment,
  };
  return { ...work, zh: ZH_TITLE[i], script: cap(script), zhScript: (w.kicker ?? '').split(' · ')[1] ?? '', mediumOnly: cap(medium), note: w.note || UNKNOWN };
});
const byKey = new Map<string, Work>([...photos, ...cals].map((w) => [w.key, w]));

// The sentences: each phrase must name a real work, and each sentence holds five to seven.
const phrasesOf = (s: (typeof SENTENCES)[number]) => s.parts.filter((x): x is Phrase => typeof x !== 'string');
SENTENCES.forEach((s, k) => {
  const ph = phrasesOf(s);
  if (ph.length < 5 || ph.length > 7) throw new Error(`proto-art: sentence ${k + 1} has ${ph.length} phrases, not 5-7`);
  const bad = ph.filter((x) => !byKey.has(x.work));
  if (bad.length) throw new Error(`proto-art: sentence ${k + 1} names no such work: ${bad.map((x) => x.work).join(', ')}`);
});
// The mat holds each work a sentence names, once; the first sentence's first work is on it at arrival.
const first = phrasesOf(SENTENCES[0])[0].work;
const matWorks = [...new Set(SENTENCES.flatMap((s) => phrasesOf(s).map((x) => x.work)))].map((k) => byKey.get(k)!);

// ── `sizes`, from the CSS below (each bound is a maximum, so the hint never under-declares).
// THE MAT. .pa-wrap is at most 1240px with 72px sides, .opening's columns are 1fr / 1.15fr with a 64px gap, so the
// mat column is at most (1096 - 64) * 1.15 / 2.15 = 552px; less its 24px padding, the image is at most 504px wide
// and 552px tall (the mat's 600px cap). Stacked (900px and under) the mat is at most 520px tall with 16px padding,
// 488px for the image, and at most 778px wide (810px of column at 900px); on a phone, 100vw less 2 x 22px of side
// and 2 x 16px of mat.
const matSizes = (ar: number) =>
  `(max-width: 640px) calc(100vw - 76px), (max-width: 900px) ${Math.min(Math.ceil(ar * 488), 778)}px, ${Math.min(Math.ceil(ar * 552), 504)}px`;
// THE ROWS. ROW_H and ROW_H_PHONE are .rows' --row-h, synced by hand: the script lays the rows out with justifyRows
// at that target, which closes a row at or under it and caps the last row at 1.16x, so a photograph is at most
// ar * --row-h * 1.16 wide; and at most the 1096px column less its 2 x 10px of mat.
const ROW_H = 280;
const ROW_H_PHONE = 150;
const rowSizes = (ar: number) =>
  `(max-width: 640px) ${Math.ceil(ar * ROW_H_PHONE * 1.16)}px, ${Math.min(Math.ceil(ar * ROW_H * 1.16), 1076)}px`;
// THE CALLIGRAPHY, as on /art: height-capped at 820px (CAL_MAX_H, the px arm of .cal img's max-height), so at most
// 820 * ar px wide; on a phone, 100vw less 2 x 22px of side and 2 x 16px of mat.
const CAL_MAX_H = 820;
const calSizes = (ar: number) => `(max-width: 640px) calc(100vw - 76px), ${Math.ceil(ar * CAL_MAX_H)}px`;

const darkData = (w: Work) => ({ 'data-zoom': w.z.src, 'data-zw': w.z.w, 'data-zh': w.z.h, 'data-alt': w.alt, 'data-line': lineOf(w) });
---
<BaseLayout
  title="PROTOTYPE · Art — Ing Tian"
  description="A prototype of the redesigned /art: one sentence as the index, the calligraphy, then every photograph."
  page="paper"
  veil={false}
>
  <main class="proto-art pa">
    <div class="pa-wrap">
      <header class="pa-head">
        <a class="back" href="/">← back</a>
        <h1>Art</h1>
      </header>

      <section class="opening" aria-label="Selected works">
        <div class="words">
          {SENTENCES.map((s, k) => (
            <p class="sentence" data-s={k} data-works={phrasesOf(s).map((x) => x.work).join(',')} hidden={k !== 0}>
              {s.parts.map((x) => typeof x === 'string' ? x : (
                <a class="phrase" href={`#${x.work}`} data-work={x.work} aria-controls="pa-mat"
                   aria-current={x.work === phrasesOf(s)[0].work ? 'true' : undefined}>{x.text}</a>
              ))}
            </p>
          ))}
          <p class="sr-only" aria-live="polite" data-live></p>
        </div>
        <div class="stage" id="pa-mat">
          {matWorks.map((w) => (
            <figure class:list={['mw', { 'is-on': w.key === first }]} data-work={w.key} hidden={w.key !== first}>
              <div class="mat">
                <button type="button" class:list={['mat-btn', w.treatment]} aria-label={`View full screen: ${w.alt}`} {...darkData(w)}>
                  <Image src={w.src} alt={w.alt} widths={[480, 900, 1200]} sizes={matSizes(w.ar)}
                         loading={w.key === first ? 'eager' : 'lazy'} fetchpriority={w.key === first ? 'high' : undefined}
                         decoding="async" draggable="false" />
                </button>
              </div>
              <figcaption class="label">
                <span class="l-title">{w.title}</span>
                <dl>
                  <div><dt>Place</dt><dd>{w.place}</dd></div>
                  <div><dt>Year</dt><dd>{w.year}</dd></div>
                  <div><dt>Medium</dt><dd>{w.medium}</dd></div>
                </dl>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="room" id="calligraphy" aria-labelledby="cal-h">
        <h2 id="cal-h">Calligraphy</h2>
        {cals.map((w) => (
          <article class="obj" id={w.key}>
            <div class="obj-words">
              {w.zh && <p class="zh" lang="zh-Hant">{w.zh}</p>}
              <h3>{w.title}</h3>
              <dl>
                <div><dt>Script</dt><dd>{w.script}{w.zhScript && <> · <span lang="zh-Hant">{w.zhScript}</span></>}</dd></div>
                <div><dt>Medium</dt><dd>{w.mediumOnly}</dd></div>
                <div><dt>Note</dt><dd>{w.note}</dd></div>
              </dl>
            </div>
            <div class="obj-mat">
              <button type="button" class:list={['cal', w.treatment]} aria-label={`View full screen: ${w.alt}`} {...darkData(w)}>
                <Image src={w.src} alt={w.alt} widths={[480, 900, 1200]} sizes={calSizes(w.ar)} loading="lazy" decoding="async" />
              </button>
            </div>
          </article>
        ))}
      </section>

      <section class="room" id="photographs" aria-labelledby="ph-h">
        <h2 id="ph-h">Photographs</h2>
        <p class="count">{photos.length} photographs, in the order of their files.</p>
        <div class="rows">
          {photos.map((w) => (
            <div class="tile" id={w.key} style={`--ar:${w.ar.toFixed(4)}`}>
              <button type="button" class="tile-btn" {...darkData(w)}>
                <span class="tile-mat">
                  <Image src={w.src} alt={w.alt} widths={[300, 600, 900]} sizes={rowSizes(w.ar)} loading="lazy" decoding="async" />
                </span>
                <span class="t-title">{w.title}</span>
                <span class="t-place">{w.place}</span>
              </button>
            </div>
          ))}
        </div>
      </section>

      <footer class="pa-foot"><a class="back" href="/">← back to the descent</a></footer>
    </div>

    <dialog class="dark" aria-label="The dark room: one work, full screen" aria-describedby="pa-dark-line">
      <button type="button" class="d-btn d-close" aria-label="Close">✕</button>
      <img class="d-img" alt="" draggable="false" />
      <div class="d-bar">
        <p class="d-line" id="pa-dark-line"></p>
        <span class="d-count" aria-hidden="true"></span>
        <button type="button" class="d-btn" data-step="-1" aria-label="Previous work">←</button>
        <button type="button" class="d-btn" data-step="1" aria-label="Next work">→</button>
        <button type="button" class="d-btn d-info" aria-pressed="true" aria-label="Show the label">i</button>
      </div>
    </dialog>

    <div class="proto-bar" role="group" aria-label="Prototype controls">
      <button type="button" class="pb-chip" aria-expanded="true" aria-controls="pa-pb-body">Prototype</button>
      <span class="pb-body" id="pa-pb-body">
        <span class="pb-l">Sentence</span>
        {SENTENCES.map((s, k) => (
          <button type="button" class="pb-s" data-s={k} aria-pressed={k === 0 ? 'true' : 'false'} aria-label={`Sentence ${k + 1}, ${s.tone}`} title={s.tone}>{k + 1}</button>
        ))}
        <span class="pb-note">Places are placeholders; “—” is unknown.</span>
      </span>
    </div>
  </main>
</BaseLayout>

<style>
  /* THE SHEET is the research routes' register (page="paper"): its ground, inks and seal, in both themes. A mat is
     a faint tone of the sheet's own hairline ink, so it follows the theme with it. */
  .pa { --mat: rgba(var(--hairline-rgb), 0.08); --mat-faint: rgba(var(--hairline-rgb), 0.05); min-height: 100vh; }
  .pa-wrap { max-width: 1240px; margin: 0 auto; padding: 0 clamp(22px, 5vw, 72px); }
  .pa-head { padding: 13vh 0 0; }
  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }
  .pa h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(40px, 4.6vw, 60px); line-height: 1.04;
    letter-spacing: -0.01em; margin-top: 16px; color: var(--ink-1); }

  /* ── THE OPENING: words left, the work right; stacked at 900px and under, the work first. ──────────── */
  .opening { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; align-items: start; margin-top: 40px; }
  .sentence { font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.5;
    color: var(--ink-1); }
  .phrase { color: var(--seal); text-decoration: none; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .phrase[aria-current] { text-decoration-line: underline; text-decoration-thickness: 2px; }
  @media (hover: hover) { .phrase:hover { text-decoration-line: underline; } }
  .phrase:focus-visible { outline: 2px solid var(--seal); outline-offset: 2px; border-radius: 1px; }
  .stage { display: grid; scroll-margin-top: 72px; }
  .mw { grid-area: 1 / 1; margin: 0; opacity: 0; }
  .mw.is-on { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .mw { transition: opacity 300ms ease; } }
  .mat { height: min(72vh, 600px); padding: 24px; background: var(--mat); }
  .mat-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 0; border: 0;
    background: none; cursor: zoom-in; }
  .mat-btn :global(img) { display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; }
  .mat-btn:focus-visible, .cal:focus-visible, .tile-btn:focus-visible { outline: 2px solid var(--seal); outline-offset: 3px; }

  /* THE LABEL: dry and exact, "Label: value" lines in the body face; the title alone in Georgia. */
  .label { margin-top: 14px; min-height: 7.4em; font-size: 14px; line-height: 1.55; color: var(--ink-3); }
  .l-title { display: block; font-family: var(--font-display); font-size: 18px; line-height: 1.3; color: var(--ink-1); margin-bottom: 4px; }
  .pa dl > div { display: flex; gap: 0.4em; }
  .pa dt { color: var(--ink-1); font-weight: 600; }
  .pa dt::after { content: ':'; }
  .pa dd { margin: 0; }

  /* ── THE ROOMS ──────────────────────────────────────────────────────────────────────────────────── */
  .room { margin-top: 120px; padding-top: 28px; border-top: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .room h2 { font-family: var(--font-display); font-weight: 400; font-size: 28px; line-height: 1.2; color: var(--ink-1); }
  .count { margin-top: 8px; font-size: 14px; color: var(--ink-3); }

  /* The calligraphy: an object block each, words a 3 : 7 column beside the work on its mat. */
  .obj { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 7fr); gap: 48px; align-items: start; margin-top: 56px; }
  .obj-words { font-size: 15px; line-height: 1.6; color: var(--ink-3); }
  .zh { font-family: var(--font-display); font-size: 18px; color: var(--ink-2); }
  .obj h3 { font-family: var(--font-display); font-weight: 400; font-size: 28px; line-height: 1.2; color: var(--ink-1); margin: 4px 0 14px; }
  .obj-words dl { display: grid; gap: 6px; }
  .obj-mat { display: flex; justify-content: center; padding: 32px; background: var(--mat); }
  .cal { padding: 0; border: 0; background: none; line-height: 0; cursor: zoom-in; }
  .cal :global(img) { display: block; width: auto; max-width: 100%; max-height: min(82vh, 820px); }
  /* The stele treatment, kept: the slab stands off its mat. A work on paper gets a hairline edge, no shadow. */
  .stele :global(img) { filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.55)); }
  .paper :global(img) { border: 1px solid rgba(var(--hairline-rgb), 0.25); }

  /* The photographs: rows of one height, each photograph whole on a faint mat, its title and place under it. With no
     script each tile is its photograph at --row-h, and the rows wrap ragged; the script justifies them. */
  .rows { --row-h: 280; --pad: 10px; display: flex; flex-wrap: wrap; column-gap: 16px; row-gap: 28px; margin-top: 28px; }
  .tile { flex: none; width: calc(var(--ar) * var(--row-h) * 1px + 2 * var(--pad)); }
  .tile-btn { display: block; width: 100%; padding: 0; border: 0; background: none; text-align: left; cursor: zoom-in; }
  .tile-mat { display: block; padding: var(--pad); background: var(--mat-faint); }
  .tile-mat :global(img) { display: block; width: 100%; height: auto; aspect-ratio: var(--ar); }
  .t-title { display: block; margin-top: 8px; font-size: 14px; line-height: 1.4; color: var(--ink-1); font-weight: 600;
    text-underline-offset: 0.18em; }
  .t-place { display: block; font-size: 13px; line-height: 1.4; color: var(--ink-3); }
  /* Images fade in once as they decode (the script marks the tile), and a hover underlines the title and dims the
     photograph a little, by opacity. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .tile-mat :global(img) { opacity: 0; transition: opacity 0.6s ease; }
    .tile.is-loaded .tile-mat :global(img) { opacity: 1; }
  }
  @media (hover: hover) {
    .tile-btn:hover .t-title { text-decoration: underline; }
    .tile .tile-btn:hover .tile-mat :global(img) { opacity: 0.85; }
  }
  .pa-foot { padding: 120px 0 18vh; }

  @media (max-width: 900px) {
    .opening, .obj { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .stage, .obj-mat { order: -1; }
    .mat { height: min(60vh, 520px); padding: 16px; }
  }
  @media (max-width: 640px) {
    .obj-mat { padding: 16px; }
    .rows { --row-h: 150; --pad: 6px; column-gap: 10px; row-gap: 20px; }
    .t-title { font-size: 13px; }
    .t-place { font-size: 12px; }
  }

  /* ── THE DARK ROOM: an empty dark dialog, the work as large as fits, small square controls. It is dark in both
     themes, so its inks are fixed. ──────────────────────────────────────────────────────────────────── */
  .dark { border: 0; padding: 0; margin: 0; width: 100vw; height: 100dvh; max-width: 100vw; max-height: 100dvh;
    background: #1c1b18; color: rgba(239, 233, 221, 0.86); overflow: hidden; }
  .dark::backdrop { background: #1c1b18; }
  .dark[open] { display: flex; align-items: center; justify-content: center; }
  .d-img { max-width: calc(100vw - 32px); max-height: calc(100dvh - 112px); transform-origin: 0 0; cursor: grab; will-change: transform; }
  .d-btn { width: 44px; height: 44px; flex: none; border: 1px solid rgba(239, 233, 221, 0.45); background: #1c1b18;
    color: rgba(239, 233, 221, 0.9); font: 15px/1 var(--font-mono); cursor: pointer; }
  @media (hover: hover) { .d-btn:hover { border-color: rgba(239, 233, 221, 0.85); } }
  .d-btn:focus-visible { outline: 2px solid #e0574a; outline-offset: 2px; }
  .d-close { position: fixed; top: 6px; left: 16px; z-index: 2; }
  .d-bar { position: fixed; left: 16px; right: 16px; bottom: 6px; z-index: 2; display: flex; align-items: center; gap: 8px; height: 44px; }
  .d-line { flex: 1; min-width: 0; font-size: 13px; line-height: 1.4; color: rgba(239, 233, 221, 0.8);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dark[data-line-off] .d-line { visibility: hidden; }
  .d-info[aria-pressed='false'] { color: rgba(239, 233, 221, 0.6); }
  .d-count { font: 12px/1 var(--font-mono); color: rgba(239, 233, 221, 0.7); margin-right: 4px; }

  /* ── THE PROTOTYPE TOOLBAR: a control for choosing, not part of the design. One row, at most 48px tall. ──── */
  .proto-bar { position: fixed; left: 12px; bottom: 12px; z-index: 50; max-width: calc(100vw - 24px); height: 48px;
    display: flex; align-items: center; gap: 10px; padding: 6px 8px; background: #16140f; color: #efe9dd;
    border: 1px dashed #e0574a; border-radius: 4px; font: 11px/1.2 var(--font-mono); white-space: nowrap; overflow: hidden; }
  .proto-bar button { font: inherit; color: inherit; background: none; border: 1px solid rgba(239, 233, 221, 0.35); border-radius: 3px;
    height: 34px; min-width: 34px; padding: 0 8px; cursor: pointer; }
  .proto-bar button:focus-visible { outline: 2px solid #e0574a; outline-offset: 2px; }
  .proto-bar .pb-chip { color: #e0574a; letter-spacing: 0.12em; text-transform: uppercase; }
  .pb-body { display: inline-flex; align-items: center; gap: 4px; min-width: 0; }
  .pb-l { color: rgba(239, 233, 221, 0.7); margin-right: 2px; }
  .proto-bar .pb-s[aria-pressed='true'] { background: #efe9dd; color: #16140f; border-color: #efe9dd; }
  .pb-note { margin-left: 8px; color: rgba(239, 233, 221, 0.7); overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  @media (scripting: none) { .proto-bar { display: none; } }
</style>

<script>
  import { onPageView } from '../scripts/pageView';
  import { prefersReducedMotion } from '../lib/motion';
  import { justifyRows } from '../lib/justify';

  const FADE_MS = 300; // .mw's opacity transition
  const LINE_KEY = 'proto-art.dark-line';

  onPageView<HTMLElement>('main.proto-art', (main) => {
    const reduce = prefersReducedMotion();
    const timers: number[] = [];

    // ── The dark room: a list of openers (each carries data-zoom and the rest), prev/next, wheel zoom to 6x, a pan.
    const dark = main.querySelector<HTMLDialogElement>('dialog.dark');
    const dImg = dark?.querySelector<HTMLImageElement>('.d-img') ?? null;
    let list: HTMLElement[] = [];
    let at = 0;
    let opener: HTMLElement | null = null;
    let zx = 0, zy = 0, zs = 1, panning = false, px = 0, py = 0;
    const tf = (): void => { if (dImg) dImg.style.transform = `translate(${zx}px,${zy}px) scale(${zs})`; };
    const show = (): void => {
      const el = list[at];
      if (!dark || !dImg || !el) return;
      const w = Number(el.dataset.zw), h = Number(el.dataset.zh);
      // The box is reserved from the native size as a ratio and a capped width, and the old picture blanked first:
      // art's lightbox (scripts/artGallery.ts) says why each of the obvious alternatives was wrong.
      if (w && h) {
        dImg.style.aspectRatio = `${w}/${h}`;
        dImg.style.width = `min(calc(100vw - 32px), calc((100dvh - 112px) * ${(w / h).toFixed(4)}))`;
      }
      dImg.removeAttribute('src');
      dImg.alt = el.dataset.alt ?? '';
      zs = 1; zx = 0; zy = 0; tf();
      dImg.src = el.dataset.zoom ?? '';
      const line = dark.querySelector('.d-line');
      if (line) line.textContent = el.dataset.line ?? '';
      const count = dark.querySelector('.d-count');
      if (count) count.textContent = list.length > 1 ? `${at + 1} / ${list.length}` : '';
      dark.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => { b.hidden = list.length < 2; });
    };
    const openList = (els: HTMLElement[], el: HTMLElement): void => {
      list = els;
      if (!dark || !list.length) return;
      at = Math.max(0, list.indexOf(el));
      show();
      if (!dark.open) {
        // Safari does not focus a clicked button, so the opener is the element clicked unless focus is elsewhere.
        const a = document.activeElement;
        opener = a instanceof HTMLElement && a !== document.body ? a : el;
        dark.showModal();
      }
    };
    const step = (d: number): void => { if (list.length > 1) { at = (at + d + list.length) % list.length; show(); } };
    if (dark && dImg) {
      const dlg = dark, img = dImg;
      // The label line, hidden or shown, is remembered for the session.
      const info = dlg.querySelector<HTMLElement>('.d-info');
      const setLine = (shown: boolean): void => {
        dlg.toggleAttribute('data-line-off', !shown);
        info?.setAttribute('aria-pressed', String(shown));
        try { sessionStorage.setItem(LINE_KEY, shown ? 'on' : 'off'); } catch { /* private mode: not remembered */ }
      };
      let stored: string | null = null;
      try { stored = sessionStorage.getItem(LINE_KEY); } catch { /* private mode */ }
      setLine(stored !== 'off');
      info?.addEventListener('click', () => setLine(dlg.hasAttribute('data-line-off')));
      dlg.querySelector('.d-close')?.addEventListener('click', () => dlg.close());
      dlg.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step))));
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      // Escape is the dialog's own; focus goes back to what opened it.
      dlg.addEventListener('close', () => { img.removeAttribute('src'); opener?.focus({ preventScroll: true }); opener = null; });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      });
      dlg.addEventListener('wheel', (e) => {
        e.preventDefault();
        const ns = Math.min(6, Math.max(1, zs * (e.deltaY < 0 ? 1.12 : 0.89)));
        const r = img.getBoundingClientRect();
        const k = ns / zs;
        zx -= (e.clientX - r.left) * (k - 1); zy -= (e.clientY - r.top) * (k - 1); zs = ns;
        if (zs === 1) { zx = 0; zy = 0; }
        tf();
      }, { passive: false });
      img.addEventListener('pointerdown', (e) => { if (zs <= 1) return; panning = true; px = e.clientX; py = e.clientY; img.setPointerCapture(e.pointerId); e.stopPropagation(); });
      img.addEventListener('pointermove', (e) => { if (!panning) return; zx += e.clientX - px; zy += e.clientY - py; px = e.clientX; py = e.clientY; tf(); });
      img.addEventListener('pointerup', () => { panning = false; });
    }
    const openFrom = (els: HTMLElement[]): void => els.forEach((b) => b.addEventListener('click', () => openList(els, b)));
    openFrom(Array.from(main.querySelectorAll<HTMLElement>('.cal')));
    openFrom(Array.from(main.querySelectorAll<HTMLElement>('.tile-btn')));

    // ── The opening: a phrase, clicked or focused, brings its work onto the mat. The new work is decoded first, so
    // the cross-fade never fades in an empty mat; a later phrase supersedes a swap still waiting.
    const sentences = Array.from(main.querySelectorAll<HTMLElement>('.sentence'));
    const figs = new Map(Array.from(main.querySelectorAll<HTMLElement>('.mw')).map((f) => [f.dataset.work ?? '', f]));
    const stage = main.querySelector<HTMLElement>('.stage');
    const live = main.querySelector<HTMLElement>('[data-live]');
    let s = 0;
    let cur = sentences[0]?.dataset.works?.split(',')[0] ?? '';
    let seq = 0;
    const mark = (): void => {
      sentences[s]?.querySelectorAll<HTMLElement>('.phrase').forEach((a) => {
        if (a.dataset.work === cur) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      });
    };
    const swap = (key: string): void => {
      const next = figs.get(key), prev = figs.get(cur);
      if (!next) return;
      // Any swap still waiting is dropped, and every work but the shown one and this one leaves the mat.
      const t = ++seq;
      figs.forEach((f, k) => { if (k !== cur && k !== key) { f.hidden = true; f.classList.remove('is-on'); } });
      if (key === cur) return;
      // Unseen until it is decoded, and out of reach while unseen.
      next.inert = true;
      next.hidden = false;
      const img = next.querySelector('img');
      if (img) img.loading = 'eager';
      (img ? img.decode() : Promise.resolve()).catch(() => {}).then(() => {
        if (t !== seq) return;
        cur = key;
        mark();
        prev?.classList.remove('is-on');
        next.classList.add('is-on');
        if (prev) prev.inert = true;
        next.inert = false;
        if (live) live.textContent = next.querySelector('.l-title')?.textContent ?? '';
        const hide = (): void => { if (prev && cur !== prev.dataset.work) prev.hidden = true; };
        if (reduce) hide(); else timers.push(window.setTimeout(hide, FADE_MS));
      });
    };
    main.querySelectorAll<HTMLAnchorElement>('.phrase').forEach((a) => {
      const key = a.dataset.work ?? '';
      a.addEventListener('click', (e) => {
        e.preventDefault();
        swap(key);
        // Stacked, the work is above the sentence: bring it back on screen if the reader has scrolled past it.
        if (stage && stage.getBoundingClientRect().top < 0) stage.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
      });
      a.addEventListener('focus', () => swap(key));
    });
    // The mat opens the dark room on the shown sentence's works, in its order.
    figs.forEach((f) => f.querySelector('.mat-btn')?.addEventListener('click', (e) => {
      const els = (sentences[s]?.dataset.works ?? '').split(',').map((k) => figs.get(k)?.querySelector<HTMLElement>('.mat-btn'))
        .filter((b): b is HTMLElement => !!b);
      openList(els, e.currentTarget as HTMLElement);
    }));

    // ── The rows: justified at the stylesheet's --row-h, gap and --pad. A tile is its photograph's ratio times the
    // row's height, plus its mat; justifyRows takes the mat's padding into the gap and off the width, so every row
    // fills exactly. Widths are floored to 0.01px so a full row's sum never overflows into a wrap.
    const rows = main.querySelector<HTMLElement>('.rows');
    const tiles = Array.from(main.querySelectorAll<HTMLElement>('.tile'));
    const ars = tiles.map((t) => parseFloat(t.style.getPropertyValue('--ar')) || 1);
    let lastW = 0;
    const layout = (): void => {
      if (!rows) return;
      const W = rows.clientWidth;
      if (!W || W === lastW) return;
      lastW = W;
      const cs = getComputedStyle(rows);
      const H = parseFloat(cs.getPropertyValue('--row-h')), pad = parseFloat(cs.getPropertyValue('--pad')), gap = parseFloat(cs.columnGap);
      justifyRows(ars, W - 2 * pad, H, gap + 2 * pad).forEach((r) => r.indices.forEach((i) => {
        tiles[i].style.width = `${Math.floor((ars[i] * r.height + 2 * pad) * 100) / 100}px`;
      }));
    };
    layout();
    const ro = new ResizeObserver(layout);
    if (rows) ro.observe(rows);
    tiles.forEach((t) => {
      const img = t.querySelector('img');
      const done = (): void => t.classList.add('is-loaded');
      if (!img || (img.complete && img.naturalWidth > 0)) done();
      else { img.addEventListener('load', done, { once: true }); img.addEventListener('error', done, { once: true }); }
    });

    // ── The prototype toolbar: which sentence (kept in the URL as ?s=2), and a chip it collapses to.
    const bar = main.querySelector<HTMLElement>('.proto-bar');
    const chip = bar?.querySelector<HTMLElement>('.pb-chip');
    const body = bar?.querySelector<HTMLElement>('.pb-body');
    chip?.addEventListener('click', () => {
      const open = chip.getAttribute('aria-expanded') !== 'true';
      chip.setAttribute('aria-expanded', String(open));
      if (body) body.hidden = !open;
    });
    const choose = (k: number): void => {
      s = k;
      sentences.forEach((p, i) => { p.hidden = i !== k; });
      bar?.querySelectorAll<HTMLElement>('.pb-s').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.s) === k)));
      const q = new URLSearchParams(location.search);
      if (k === 0) q.delete('s'); else q.set('s', String(k + 1));
      const qs = q.toString();
      history.replaceState(history.state, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
      swap(sentences[k]?.dataset.works?.split(',')[0] ?? cur);
      mark();
    };
    bar?.querySelectorAll<HTMLElement>('.pb-s').forEach((b) => b.addEventListener('click', () => choose(Number(b.dataset.s))));
    const asked = Number(new URLSearchParams(location.search).get('s')) - 1;
    if (asked > 0 && asked < sentences.length) choose(asked);

    return () => { ro.disconnect(); timers.forEach((t) => clearTimeout(t)); if (dark?.open) dark.close(); };
  });
</script>
