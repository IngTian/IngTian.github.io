  .wg-region { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--ink-2); }
  .sheet { --h: 148px; display: flex; flex-wrap: wrap; gap: 10px; }
  .tile { flex: none; height: var(--h); aspect-ratio: var(--ar); max-width: 100%; margin: 0; position: relative; }
  .tile:hover, .tile:focus-within { z-index: 5; }
  .tile-btn { position: absolute; inset: 0; padding: 0; border: 0; overflow: hidden; border-radius: 2px; cursor: zoom-in;
    background: rgba(var(--hairline-rgb), 0.2); }
