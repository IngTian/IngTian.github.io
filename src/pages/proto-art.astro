    color: rgba(239, 233, 221, 0.86); font-size: 13px; line-height: 1.5; text-align: center; }
  .lb-count, .lb-where { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: rgba(239, 233, 221, 0.6); }
  .lb-title { font-family: var(--font-display); font-size: 17px; color: #efe9dd; }
