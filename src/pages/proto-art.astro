  .lb-fig { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .lb-img { max-width: 86vw; max-height: 82vh; will-change: transform; cursor: grab; transform-origin: 0 0;
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.8); }
