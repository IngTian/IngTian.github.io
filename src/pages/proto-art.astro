    align-items: center; gap: 6px 14px; padding: 8px 12px; background: #16140f; color: #efe9dd; border: 1px dashed #e0574a;
    border-radius: 4px; font-family: var(--font-mono); font-size: 11px; line-height: 1.4; box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.6); }
  .pb-tag { color: #e0574a; letter-spacing: 0.14em; text-transform: uppercase; }
