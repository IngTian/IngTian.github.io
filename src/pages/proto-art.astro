---
// PROTOTYPE (throwaway): the /art redesign, to look at on the real site. A globe of places, five chosen photographs,
// the calligraphy in its own room, and the rest of the photographs by place. /art itself is untouched. Data and the
// stack layout: data/protoArt.ts. Retire it by deleting this page, that file, its `want` entry in
// tests/distSmoke.test.ts and CLAUDE.md's count.
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidSky from '../components/FluidSky.astro';
import SkyWash from '../components/SkyWash.astro';
import { Image, getImage } from 'astro:assets';
import { calligraphy, photography } from '../data/artworks';
import { CULL, PICKS, PLACES } from '../data/protoArt';

// /art's byte rules (CLAUDE.md, Stack), as art.astro keeps them: sizes from getImage(), never off the import (the
// import is a Proxy; reading `.width` keeps the original in dist), a webp at native pixels for the lightbox's 6x.
const zoomOf = async (src: ImageMetadata) => {
  const z = await getImage({ src, format: 'webp' });
  const { width: w, height: h } = z.options;
  if (!w || !h) throw new Error(`getImage() gave no native size for ${z.src}`);
  return { src: z.src, w, h };
};
const photoZoom = await Promise.all(photography.map((p) => zoomOf(p.src)));
const calZoom = await Promise.all(calligraphy.map((w) => zoomOf(w.src)));

// Every photograph sits in exactly one placeholder place; the placeholder cull leaves a few off the page, never a pick.
const placed = PLACES.flatMap((p) => p.photos).sort((a, b) => a - b);
if (placed.length !== photography.length || placed.some((n, i) => n !== i + 1)) {
  throw new Error(`proto-art: the places hold ${placed.length} photographs; every one of the ${photography.length} goes in exactly one`);
}
const culled = new Set(CULL);
if (PICKS.some((n) => culled.has(n))) throw new Error('proto-art: a pick is in the cull');
const placeOf = new Map(PLACES.flatMap((p) => p.photos.map((n) => [n, p] as const)));
const photo = (n: number) => {
  const p = photography[n - 1];
  const z = photoZoom[n - 1];
  return { n, src: p.src, alt: p.alt, title: p.title ?? 'Untitled', note: p.note ?? '', z, ar: z.w / z.h, place: placeOf.get(n)! };
};
const places = PLACES.map((pl) => ({ ...pl, shown: pl.photos.filter((n) => !culled.has(n)) })).filter((pl) => pl.shown.length);
// A stack's faces: its first three, top card first. The top card's photograph leads the hover box.
const stacks = places.map((pl) => ({ pl, faces: pl.shown.slice(0, 3).map(photo) }));
const picks = PICKS.map(photo);
// The rest, by place: what the stacks hold that the carousel does not.
const groups = places.map((pl) => ({ pl, photos: pl.shown.filter((n) => !PICKS.includes(n)).map(photo) })).filter((g) => g.photos.length);
const pad2 = (n: number) => String(n).padStart(2, '0');

// THE CONTACT SHEET. Every tile is the sheet's row height tall (TILE_H, TILE_H_PHONE at 640px and under) and its
// photograph's real ratio wide, so its `sizes` is exactly that width. [300, 600, 900] are /art's own widths, so the
// variants are shared.
const TILE_H = 148;
const TILE_H_PHONE = 112;
const tileSizes = (ar: number) => `(max-width: 640px) ${Math.ceil(TILE_H_PHONE * ar)}px, ${Math.ceil(TILE_H * ar)}px`;
// The carousel's frame is min(520px, 36vw, 50vh) wide, 440px at most below 900px.
const SEL_SIZES = '(max-width: 900px) 440px, 520px';
// A polaroid's window is a 56px square of the photo, so a landscape photo needs 56 * ar px of width to fill it.
const thumbSizes = (ar: number) => `${Math.ceil(56 * Math.max(1, ar))}px`;
// The calligraphy, as on /art: height-capped at 820px, so 820 * ar px wide at most.
const CAL_MAX_H = 820;
const calSizes = (ar: number) => `(max-width:1024px) 80vw, ${Math.ceil(ar * CAL_MAX_H)}px`;
// The kicker's Chinese gets its own `lang`.
const kickerParts = (k: string) => { const [en, zh] = k.split(' · '); return { en, zh }; };
---
<BaseLayout
  title="PROTOTYPE · An artist by night — Ing Tian"
  description="A prototype of the redesigned /art: places, selected photographs, the calligraphy, and the rest by place."
  veilLine="an artist by night"
  veilOnLoad={true}
>
  <main class="proto-art pa descent is-fluid">
    <FluidSky variant="descent" />
    <SkyWash />
    <div class="pa-wrap">
      <header class="pa-head veil" data-ink>
        <a class="back" href="/">← back</a>
        <h1>An artist by night</h1>
        <p class="lede">Photographs from where they were taken, a few chosen, the calligraphy in a room of its own, then the rest, place by place.</p>
      </header>

      <section class="room places-room" id="places" aria-labelledby="places-h">
        <div class="places-side veil" data-ink>
          <h2 class="seclabel" id="places-h">Places</h2>
          <p class="side-line">Each stack is the photographs from one place. Drag to turn the globe; open a stack to look closely.</p>
          <ol class="places">
            {places.map((pl) => (
              <li><button type="button" class="place-btn" data-place={pl.id}>
                <span class="pl-name">{pl.name}</span><span class="pl-region">{pl.region}</span><span class="pl-n">{pl.shown.length}</span>
              </button></li>
            ))}
          </ol>
          <p class="placeholder-note sealed">Pins are placeholders: the real places come from the owner.</p>
        </div>
        <div class="globe-stage" data-mode="crop" data-ink>
          <canvas class="globe-canvas" aria-hidden="true"></canvas>
          {stacks.map(({ pl, faces }) => (
            <div class="stack has-tip" data-place={pl.id} data-lat={pl.lat} data-lon={pl.lon} data-photos={pl.shown.join(',')}>
              <button class="stack-btn" type="button" aria-label={`${pl.name}, ${pl.shown.length} photographs: open`} aria-describedby={`tip-${pl.id}`}>
                {faces.slice().reverse().map((ph, k, all) => (
                  <span class="pol" style={`--k:${all.length - 1 - k}`}>
                    <Image src={ph.src} alt={ph.alt} widths={[160, 300]} sizes={thumbSizes(ph.ar)} loading="lazy" decoding="async" />
                    {k === all.length - 1 && <span class="pol-n" aria-hidden="true">{pl.shown.length}</span>}
                  </span>
                ))}
              </button>
              <div class="tip stack-tip" role="tooltip" id={`tip-${pl.id}`}>
                <p class="tip-k">{pl.region}</p>
                <p class="tip-t">{pl.name}</p>
                <p class="tip-n"><i>{faces[0].title}.</i> {faces[0].note}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="room sel" id="selected" aria-roledescription="carousel" aria-label="Selected photographs">
        <div class="sel-grid">
          <div class="sel-text veil" data-ink>
            <h2 class="seclabel">Selected</h2>
            <p class="sel-count" aria-hidden="true"><span class="sel-rule"></span><span class="sel-cur">01</span> / {pad2(picks.length)}</p>
            <div class="sel-slides">
              {picks.map((ph, i) => (
                <div class:list={['sel-slide', { 'is-on': i === 0 }]} role="group" aria-roledescription="slide"
                     aria-label={`${i + 1} of ${picks.length}`} inert={i !== 0}>
                  <h3 class="sel-title">{ph.title}</h3>
                  <p class="sel-sub sealed">{ph.place.name}, {ph.place.region}</p>
                  <p class="sel-story">{ph.note}</p>
                </div>
              ))}
            </div>
            <div class="sel-arrows">
              <button type="button" class="arrow" data-step="-1" aria-label="Previous photograph">←</button>
              <button type="button" class="arrow" data-step="1" aria-label="Next photograph">→</button>
            </div>
          </div>
          <div class="sel-frame">
            <span class="corner tl" aria-hidden="true"></span><span class="corner br" aria-hidden="true"></span>
            {picks.map((ph, i) => (
              <button type="button" class:list={['sel-img', { 'is-on': i === 0 }]} inert={i !== 0}
                      aria-label={`Open ${ph.title} full screen`}
                      data-photo={ph.n} data-zoom={ph.z.src} data-zw={ph.z.w} data-zh={ph.z.h} data-alt={ph.alt}
                      data-title={ph.title} data-note={ph.note} data-where={`${ph.place.name}, ${ph.place.region}`}>
                <Image src={ph.src} alt={ph.alt} widths={[600, 900, 1200]} sizes={SEL_SIZES} loading="lazy" decoding="async" draggable="false" />
              </button>
            ))}
          </div>
        </div>
        <ol class="sel-progress veil" data-ink>
          {picks.map((ph, i) => (
            <li><button type="button" data-go={i} aria-current={i === 0 ? 'true' : undefined}>{ph.title}</button></li>
          ))}
        </ol>
      </section>

      <section class="room cal-room" id="calligraphy" aria-labelledby="cal-h">
        <h2 class="seclabel veil" id="cal-h" data-ink>Calligraphy</h2>
        <div class="cal-host">
          {calligraphy.map((w, i) => (
            <figure class="cal-work">
              <button type="button" class:list={['cal', w.treatment]} aria-label={`View ${w.title} full screen`}
                      data-photo={`c${i}`} data-zoom={calZoom[i].src} data-zw={calZoom[i].w} data-zh={calZoom[i].h}
                      data-alt={w.alt} data-title={w.title} data-note={w.medium}>
                <Image src={w.src} alt={w.alt} widths={[480, 900, 1200]} sizes={calSizes(calZoom[i].w / calZoom[i].h)}
                       loading="lazy" decoding="async" />
              </button>
              <figcaption class="cal-cap veil" data-ink data-zone="dark">
                <span class="cal-k">{kickerParts(w.kicker ?? '').en}{kickerParts(w.kicker ?? '').zh && <> · <span lang="zh-Hant">{kickerParts(w.kicker ?? '').zh}</span></>}</span>
                <span class="cal-t">{w.title}</span>
                <span class="cal-m">{w.medium}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="room wall-room" id="wall" aria-labelledby="wall-h">
        <h2 class="seclabel veil" id="wall-h" data-ink data-zone="dark">The rest, by place</h2>
        {groups.map(({ pl, photos }) => (
          <div class="wall-group" data-ink data-zone="dark">
            <h3 class="wg-head veil"><span class="wg-name">{pl.name}</span><span class="wg-region">{pl.region}</span></h3>
            <div class="sheet">
              {photos.map((ph) => (
                <figure class="tile has-tip" style={`--ar:${ph.ar.toFixed(4)}`}>
                  <button type="button" class="tile-btn" aria-describedby={`cap-${ph.n}`}
                          data-photo={ph.n} data-zoom={ph.z.src} data-zw={ph.z.w} data-zh={ph.z.h} data-alt={ph.alt}
                          data-title={ph.title} data-note={ph.note} data-where={`${ph.place.name}, ${ph.place.region}`}>
                    <Image src={ph.src} alt={ph.alt} widths={[300, 600, 900]} sizes={tileSizes(ph.ar)} loading="lazy" decoding="async" />
                  </button>
                  <figcaption class="tip tile-tip" id={`cap-${ph.n}`}>
                    <span class="tip-t">{ph.title}</span>
                    <span class="tip-n">{ph.note}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))}
      </section>

      <footer class="pa-foot veil" data-ink data-zone="dark"><a class="back" href="/">← back to the descent</a></footer>
    </div>

    <dialog class="lightbox" id="pa-lightbox" aria-label="Photograph detail">
      <button type="button" class="lb-close" aria-label="Close">✕ close</button>
      <button type="button" class="lb-nav" data-step="-1" aria-label="Previous">←</button>
      <figure class="lb-fig">
        <img class="lb-img" src="" alt="" draggable="false" />
        <figcaption class="lb-cap"><span class="lb-count"></span><span class="lb-title"></span><span class="lb-where"></span><span class="lb-note"></span></figcaption>
      </figure>
      <button type="button" class="lb-nav" data-step="1" aria-label="Next">→</button>
      <p class="lb-hint" aria-hidden="true">scroll to zoom · drag to pan · ← → to move · Esc to close</p>
    </dialog>

    <div class="proto-bar" role="group" aria-label="Prototype controls">
      <span class="pb-tag">Prototype controls</span>
      <span class="pb-group"><span class="pb-l">Globe</span>
        <button type="button" data-globe="crop" aria-pressed="true">cropped hemisphere</button>
        <button type="button" data-globe="whole" aria-pressed="false">whole globe</button>
      </span>
      <span class="pb-group"><span class="pb-l">Calligraphy</span>
        <button type="button" data-calpos="first" aria-pressed="false">before the globe</button>
        <button type="button" data-calpos="carousel" aria-pressed="true">after the carousel</button>
        <button type="button" data-calpos="end" aria-pressed="false">at the end</button>
      </span>
      <span class="pb-legend">Not part of the design. Pins, picks and the cull are placeholders (left off: {CULL.map(pad2).join(', ')}); compare with <a href="/art">/art</a>.</span>
    </div>
  </main>
</BaseLayout>

<style>
  /* overflow-x: clip, so a hover box near the edge (laid out while hidden) never widens the page. */
  .pa { position: relative; z-index: 0; min-height: 100vh; overflow-x: clip;
    /* The hover boxes' inks, resolved here, outside every zone: a box is a card of its own ground. */
    --tip-ground: var(--paper); --tip-ink: var(--ink-1); --tip-ink-2: var(--ink-2); --tip-edge: rgba(var(--hairline-rgb), 0.28); }
  :global(html[data-theme='dark']) .pa { --tip-ground: var(--bg); }
  .pa-wrap { max-width: 1240px; margin: 0 auto; padding: 0 clamp(22px, 5vw, 72px); }

  /* THE INK FOLLOWS THE SKY (light theme; in dark the ink ramp is light on a dark sky everywhere). The script sets
     data-zone on each [data-ink] block from the sky's luminance over its span, and data-veil where neither ink
     clears 4.5:1 there; a .veil block, or the .veil inside one, then sits on a soft knockout of its zone's ground.
     The markup's own zones are a guess at the default order, for no script. */
  .pa [data-zone='light'] { --veil: rgba(239, 233, 221, 0.45); }
  .pa [data-zone='dark'] { --veil: rgba(22, 20, 15, 0.5); }
  :global(html:not([data-theme='dark'])) .pa [data-zone='dark'] {
    --ink-1: #efe9dd; --ink-2: rgba(239, 233, 221, 0.88); --ink-3: rgba(239, 233, 221, 0.76); --ink-4: rgba(239, 233, 221, 0.6);
    --hairline-rgb: 239, 233, 221;
  }
  :global(html:not([data-theme='dark'])) .pa [data-veil].veil, :global(html:not([data-theme='dark'])) .pa [data-veil] .veil {
    position: relative; isolation: isolate; }
  :global(html:not([data-theme='dark'])) .pa [data-veil].veil::before, :global(html:not([data-theme='dark'])) .pa [data-veil] .veil::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; border-radius: 18px;
    background: var(--veil); box-shadow: 0 0 30px 22px var(--veil); }

  .pa-head { padding: 13vh 0 2vh; }
  .back { font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); text-decoration: none; letter-spacing: 0.04em; }
  .back:hover { color: var(--seal); }
  .pa h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(38px, 5vw, 60px); line-height: 1.04;
    letter-spacing: -0.01em; margin-top: 16px; color: var(--ink-1); }
  .lede { font-size: 15px; color: var(--ink-2); margin-top: 16px; line-height: 1.7; max-width: 52ch; }
  .seclabel { font-family: var(--font-mono); font-weight: 400; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--ink-2); margin: 0 0 18px; width: fit-content; }
  .room { padding: 7vh 0; }
  /* Seal red as a rule beside small text, never as the small text's colour (3.2-3.7:1 on the light sky). */
  .sealed::before { content: ""; display: inline-block; width: 16px; height: 1px; margin-right: 10px; vertical-align: 0.32em; background: var(--seal); }

  /* ── 1. PLACES ───────────────────────────────────────────────────────────────────────────────── */
  .places-room { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 40px; align-items: center; }
  .globe-stage { position: relative; height: min(70vh, 620px); min-height: 420px; touch-action: pan-y; cursor: grab;
    --globe-disc: rgba(239, 233, 221, 0.28); }
  :global(html[data-theme='dark']) .globe-stage { --globe-disc: rgba(223, 227, 223, 0.035); }
  .globe-stage.is-grabbing { cursor: grabbing; }
  .globe-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* No script: no globe, the list is the page. Until placed, a stack sits nowhere: the script shows it. */
  @media (scripting: none) { .globe-stage { display: none; } .places-room { grid-template-columns: 1fr; } }
  .stack { position: absolute; left: 0; top: 0; width: 74px; height: 82px; opacity: 0; z-index: 1; will-change: transform, opacity; }
  .stack.is-away { pointer-events: none; }
  .stack:hover, .stack:focus-within, .stack.is-lit { z-index: 5; }
  .stack-btn { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .pol { position: absolute; left: 5px; top: 4px; width: 64px; height: 74px; padding: 4px 4px 14px; background: var(--paper);
    box-shadow: 0 1px 2px rgba(20, 18, 14, 0.22), 0 6px 14px -6px rgba(20, 18, 14, 0.45);
    transform: translate(calc(var(--k) * 3px), calc(var(--k) * -2px)) rotate(calc(-4deg + var(--k) * 5deg));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .pol :global(img) { display: block; width: 56px; height: 56px; object-fit: cover; }
  /* The count, as a note in the top card's margin. The card is paper in both themes, so its ink is fixed: 6:1. */
  .pol-n { position: absolute; right: 6px; bottom: 1px; font: 400 9px/13px var(--font-mono); letter-spacing: 0.04em; color: #5a544a; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .stack:hover .pol, .stack.is-lit .pol { transform: translate(calc(var(--k) * 9px), calc(var(--k) * -4px)) rotate(calc(-6deg + var(--k) * 8deg)); }
  }
  .stack-btn:focus-visible { outline: 2px solid var(--seal); outline-offset: 4px; }

  /* THE HOVER BOX (WCAG 1.4.13): on hover (a mouse or pen) or keyboard focus; it takes the pointer while shown, a
     bridge spans the gap to it, and Escape hides it without moving either (the script's data-tip-off). A card in
     the site's ink on its own ground (paper in light, the page base in dark), so it reads on any depth of the sky. */
  .tip { position: absolute; z-index: 6; opacity: 0; pointer-events: none; transform: translateY(4px);
    background: var(--tip-ground); color: var(--tip-ink); border: 1px solid var(--tip-edge); border-radius: 2px;
    box-shadow: 0 16px 36px -20px rgba(20, 18, 14, 0.5); transition: opacity 0.18s ease, transform 0.18s ease; text-align: left; }
  @media (hover: hover) { .has-tip:hover:not([data-tip-off]) .tip { opacity: 1; transform: none; pointer-events: auto; } }
  .has-tip:has(:focus-visible):not([data-tip-off]) .tip { opacity: 1; transform: none; pointer-events: auto; }
  .tip::before { content: ""; position: absolute; }
  .tip-k { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tip-ink-2); white-space: nowrap; }
  .tip-t { display: block; font-family: var(--font-display); font-size: 18px; line-height: 1.25; margin-top: 5px; }
  .tip-n { display: block; font-size: 13px; line-height: 1.55; margin-top: 6px; color: var(--tip-ink-2); }
  .tip-n i { font-family: var(--font-display); color: var(--tip-ink); }
  /* A stack's box goes to the side of it that covers the fewest other stacks and pins (the script's data-side). */
  .stack-tip { width: 240px; padding: 12px 14px 13px; left: calc(100% + 14px); top: 0; }
  .stack-tip::before { top: 0; bottom: 0; left: -16px; width: 16px; }
  .stack[data-side='left'] .stack-tip { left: auto; right: calc(100% + 14px); }
  .stack[data-side='left'] .stack-tip::before { left: auto; right: -16px; }
  .stack[data-side='below'] .stack-tip { left: 50%; margin-left: -120px; top: calc(100% + 14px); }
  .stack[data-side='above'] .stack-tip { left: 50%; margin-left: -120px; top: auto; bottom: calc(100% + 14px); }
  .stack[data-side='below'] .stack-tip::before { left: 0; right: 0; width: auto; top: -16px; bottom: auto; height: 16px; }
  .stack[data-side='above'] .stack-tip::before { left: 0; right: 0; width: auto; top: auto; bottom: -16px; height: 16px; }

  .side-line { font-size: 14px; line-height: 1.65; color: var(--ink-2); margin-bottom: 18px; }
  .places { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .places li { border-bottom: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .place-btn { display: grid; grid-template-columns: 1fr auto; column-gap: 10px; width: 100%; padding: 9px 2px; border: 0;
    background: none; text-align: left; cursor: pointer; color: var(--ink-1); min-height: 44px; }
  .pl-name { font-family: var(--font-display); font-size: 16px; }
  .pl-region { grid-row: 2; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: var(--ink-2); }
  .pl-n { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); }
  .place-btn:hover .pl-name, .place-btn:focus-visible .pl-name { color: var(--seal); }
  .place-btn:focus-visible { outline: 2px solid var(--seal); outline-offset: 2px; }
  .placeholder-note { margin-top: 16px; font-family: var(--font-mono); font-size: 11px; line-height: 1.6; color: var(--ink-2); }

  /* ── 2. SELECTED ─────────────────────────────────────────────────────────────────────────────── */
  .sel-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .sel-text { max-width: 440px; }
  .sel-count { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em; color: var(--ink-2); }
  .sel-rule { width: 32px; height: 1px; background: currentColor; }
  /* Every slide's text in one cell, so the panel is as tall as the longest and nothing below it moves. */
  .sel-slides { display: grid; margin-top: 26px; }
  .sel-slide { grid-area: 1 / 1; opacity: 0; transform: translateY(10px); }
  .sel-slide.is-on { opacity: 1; transform: none; }
  .sel-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(36px, 4.4vw, 58px); line-height: 1.08;
    letter-spacing: -0.015em; color: var(--ink-1); }
  .sel-sub { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-2); }
