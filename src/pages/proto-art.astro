---
// PROTOTYPE (throwaway): the /art redesign, to look at on the real site. A globe of places, five chosen photographs,
// the wall of the rest, and the calligraphy in its own room. /art itself is untouched. Data: data/protoArt.ts.
// Retire it by deleting this page, that file, its `want` entry in tests/distSmoke.test.ts and CLAUDE.md's count.
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidSky from '../components/FluidSky.astro';
import SkyWash from '../components/SkyWash.astro';
import { Image, getImage } from 'astro:assets';
import { calligraphy, photography } from '../data/artworks';
import { PICKS, PLACES } from '../data/protoArt';

// /art's byte rules (CLAUDE.md, Stack), as art.astro keeps them: sizes from getImage(), never off the import (the
// import is a Proxy; reading `.width` keeps the original in dist), a webp at native pixels for the lightbox's 6x.
const zoomOf = async (src: ImageMetadata) => {
  const z = await getImage({ src, format: 'webp' });
  const { width: w, height: h } = z.options;
  if (!w || !h) throw new Error(`getImage() gave no native size for ${z.src}`);
  return { src: z.src, w, h };
};
const photoZoom = await Promise.all(photography.map((p) => zoomOf(p.src)));
const calZoom = await Promise.all(calligraphy.map((w) => zoomOf(w.src)));

// Every photograph sits in exactly one placeholder place.
const placed = PLACES.flatMap((p) => p.photos).sort((a, b) => a - b);
if (placed.length !== photography.length || placed.some((n, i) => n !== i + 1)) {
  throw new Error(`proto-art: the places hold ${placed.length} photographs; every one of the ${photography.length} goes in exactly one`);
}
const placeOf = new Map(PLACES.flatMap((p) => p.photos.map((n) => [n, p] as const)));
const photo = (n: number) => {
  const p = photography[n - 1];
  const z = photoZoom[n - 1];
  return { n, src: p.src, alt: p.alt, title: p.title ?? 'Untitled', note: p.note ?? '', z, ar: z.w / z.h, place: placeOf.get(n)! };
};
const picks = PICKS.map(photo);
const rest = photography.map((_, i) => i + 1).filter((n) => !PICKS.includes(n)).map(photo);
const pad2 = (n: number) => String(n).padStart(2, '0');

// THE WALL'S ROWS. A tile spans round(50 / ar) rows of u = a column's width / 50 (the grid's auto rows), plus
// GAP_U rows of gap, so its box keeps the photo's real ratio to within half a row (under 0.8%, which object-fit
// takes up) at any column count, with no script. 50, not finer: one column of the 37 is ~2,300 rows already. Sparse auto-placement puts each tile at the first free place
// after the last, so the reading order stays the order of the data.
const GAP_U = 3;
const rowsOf = (ar: number) => Math.round(50 / ar);
// A tile is one column wide: at most 360px at three columns (a 1096px wall), half the window at two, the window at
// one. Upper bounds, never under-declared; [300, 600, 900] are /art's own widths, so the variants are shared.
const TILE_SIZES = '(max-width: 640px) 100vw, (max-width: 900px) 50vw, 360px';
// The carousel's frame is min(520px, 36vw, 50vh) wide, 440px at most below 900px.
const SEL_SIZES = '(max-width: 900px) 440px, 520px';
// A polaroid's window is a 56px square of the photo, so a landscape photo needs 56 * ar px of width to fill it.
const thumbSizes = (ar: number) => `${Math.ceil(56 * Math.max(1, ar))}px`;
// The calligraphy, as on /art: height-capped at 820px, so 820 * ar px wide at most.
const CAL_MAX_H = 820;
const calSizes = (ar: number) => `(max-width:1024px) 80vw, ${Math.ceil(ar * CAL_MAX_H)}px`;
// The kicker's Chinese gets its own `lang`.
const kickerParts = (k: string) => { const [en, zh] = k.split(' · '); return { en, zh }; };
---
<BaseLayout
  title="PROTOTYPE · An artist by night — Ing Tian"
  description="A prototype of the redesigned /art: places, selected photographs, the wall, and the calligraphy."
  veilLine="an artist by night"
  veilOnLoad={true}
>
  <main class="proto-art pa descent is-fluid">
    <FluidSky variant="descent" />
    <SkyWash />
    <div class="pa-wrap">
      <header class="pa-head" data-ink>
        <a class="back" href="/">← back</a>
        <h1>An artist by night</h1>
        <p class="lede">Photographs from where they were taken, a few chosen, then the whole wall; and the calligraphy, in a room of its own.</p>
      </header>

      <section class="room places-room" id="places" aria-labelledby="places-h" data-ink>
        <div class="places-side">
          <h2 class="seclabel" id="places-h">Places</h2>
          <p class="side-line">Each stack is the photographs from one place. Drag to turn the globe; open a stack to look closely.</p>
          <ol class="places">
            {PLACES.map((pl) => (
              <li><button type="button" class="place-btn" data-place={pl.id}>
                <span class="pl-name">{pl.name}</span><span class="pl-region">{pl.region}</span><span class="pl-n">{pl.photos.length}</span>
              </button></li>
            ))}
          </ol>
          <p class="placeholder-note">Pins are placeholders: the real places come from the owner.</p>
        </div>
        <div class="globe-stage" data-mode="whole">
          <canvas class="globe-canvas" aria-hidden="true"></canvas>
          {PLACES.map((pl) => (
            <div class="stack has-tip" data-place={pl.id} data-lat={pl.lat} data-lon={pl.lon} data-photos={pl.photos.join(',')}>
              <button class="stack-btn" type="button" aria-label={`${pl.name}, ${pl.photos.length} photographs: open`} aria-describedby={`tip-${pl.id}`}>
                {pl.photos.slice(0, 3).map(photo).reverse().map((ph, k, all) => (
                  <span class="pol" style={`--k:${all.length - 1 - k}`}>
                    <Image src={ph.src} alt={ph.alt} widths={[160, 300]} sizes={thumbSizes(ph.ar)} loading="lazy" decoding="async" />
                  </span>
                ))}
                <span class="stack-n" aria-hidden="true">{pl.photos.length}</span>
              </button>
              <div class="tip stack-tip" role="tooltip" id={`tip-${pl.id}`}>
                <p class="tip-k">{pl.name} · {pl.region} · {pl.photos.length} photographs</p>
                <p class="tip-t">{photo(pl.photos[0]).title}</p>
                <p class="tip-n">{photo(pl.photos[0]).note}</p>
                <p class="tip-more">With {pl.photos.slice(1).map((n) => photo(n).title).join(', ')}.</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="room sel" id="selected" aria-roledescription="carousel" aria-label="Selected photographs">
        <div class="sel-grid">
          <div class="sel-text" data-ink>
            <h2 class="seclabel">Selected</h2>
            <p class="sel-count" aria-hidden="true"><span class="sel-rule"></span><span class="sel-cur">01</span> / {pad2(picks.length)}</p>
            <div class="sel-slides">
              {picks.map((ph, i) => (
                <div class:list={['sel-slide', { 'is-on': i === 0 }]} role="group" aria-roledescription="slide"
                     aria-label={`${i + 1} of ${picks.length}`} inert={i !== 0}>
                  <h3 class="sel-title">{ph.title}</h3>
                  <p class="sel-sub">{ph.place.name}, {ph.place.region}</p>
                  <p class="sel-story">{ph.note}</p>
                </div>
              ))}
            </div>
            <div class="sel-arrows">
              <button type="button" class="arrow" data-step="-1" aria-label="Previous photograph">←</button>
              <button type="button" class="arrow" data-step="1" aria-label="Next photograph">→</button>
            </div>
          </div>
          <div class="sel-frame">
            <span class="corner tl" aria-hidden="true"></span><span class="corner br" aria-hidden="true"></span>
            {picks.map((ph, i) => (
              <button type="button" class:list={['sel-img', { 'is-on': i === 0 }]} inert={i !== 0}
                      aria-label={`Open ${ph.title} full screen`}
                      data-photo={ph.n} data-zoom={ph.z.src} data-zw={ph.z.w} data-zh={ph.z.h} data-alt={ph.alt}
                      data-title={ph.title} data-note={ph.note} data-where={`${ph.place.name}, ${ph.place.region}`}>
                <Image src={ph.src} alt={ph.alt} widths={[600, 900, 1200]} sizes={SEL_SIZES} loading="lazy" decoding="async" draggable="false" />
              </button>
            ))}
          </div>
        </div>
        <ol class="sel-progress" data-ink>
          {picks.map((ph, i) => (
            <li><button type="button" data-go={i} aria-current={i === 0 ? 'true' : undefined}>{ph.title}</button></li>
          ))}
        </ol>
      </section>

      <section class="room wall-room" id="wall" aria-labelledby="wall-h">
        <h2 class="seclabel" id="wall-h" data-ink>All photographs</h2>
        <div class="wall">
          {rest.map((ph) => (
            <figure class="tile has-tip" style={`--r:${rowsOf(ph.ar)};--span:${rowsOf(ph.ar) + GAP_U}`}>
              <button type="button" class="tile-btn" aria-describedby={`cap-${ph.n}`}
                      data-photo={ph.n} data-zoom={ph.z.src} data-zw={ph.z.w} data-zh={ph.z.h} data-alt={ph.alt}
                      data-title={ph.title} data-note={ph.note} data-where={`${ph.place.name}, ${ph.place.region}`}>
                <Image src={ph.src} alt={ph.alt} widths={[300, 600, 900]} sizes={TILE_SIZES} loading="lazy" decoding="async" />
              </button>
              <figcaption class="tip tile-tip" id={`cap-${ph.n}`}>
                <span class="tip-t">{ph.title}</span>
                <span class="tip-n">{ph.note}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="room cal-room" id="calligraphy" aria-labelledby="cal-h">
        <h2 class="seclabel" id="cal-h" data-ink data-zone="dark">Calligraphy</h2>
        <div class="cal-host">
          {calligraphy.map((w, i) => (
            <figure class="cal-work">
              <button type="button" class:list={['cal', w.treatment]} aria-label={`View ${w.title} full screen`}
                      data-photo={`c${i}`} data-zoom={calZoom[i].src} data-zw={calZoom[i].w} data-zh={calZoom[i].h}
                      data-alt={w.alt} data-title={w.title} data-note={w.medium}>
                <Image src={w.src} alt={w.alt} widths={[480, 900, 1200]} sizes={calSizes(calZoom[i].w / calZoom[i].h)}
                       loading="lazy" decoding="async" />
              </button>
              <figcaption class="cal-cap" data-ink data-zone="dark">
                <span class="cal-k">{kickerParts(w.kicker ?? '').en}{kickerParts(w.kicker ?? '').zh && <> · <span lang="zh-Hant">{kickerParts(w.kicker ?? '').zh}</span></>}</span>
                <span class="cal-t">{w.title}</span>
                <span class="cal-m">{w.medium}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <footer class="pa-foot" data-ink data-zone="dark"><a class="back" href="/">← back to the descent</a></footer>
    </div>

    <dialog class="lightbox" id="pa-lightbox" aria-label="Photograph detail">
      <button type="button" class="lb-close" aria-label="Close">✕ close</button>
      <button type="button" class="lb-nav" data-step="-1" aria-label="Previous">←</button>
      <figure class="lb-fig">
        <img class="lb-img" src="" alt="" draggable="false" />
        <figcaption class="lb-cap"><span class="lb-count"></span><span class="lb-title"></span><span class="lb-where"></span><span class="lb-note"></span></figcaption>
      </figure>
      <button type="button" class="lb-nav" data-step="1" aria-label="Next">→</button>
      <p class="lb-hint" aria-hidden="true">scroll to zoom · drag to pan · ← → to move · Esc to close</p>
    </dialog>

    <div class="proto-bar" role="group" aria-label="Prototype controls">
      <span class="pb-tag">Prototype controls</span>
      <span class="pb-group"><span class="pb-l">Globe</span>
        <button type="button" data-globe="whole" aria-pressed="true">whole globe</button>
        <button type="button" data-globe="crop" aria-pressed="false">cropped hemisphere</button>
      </span>
      <span class="pb-group"><span class="pb-l">Calligraphy</span>
        <button type="button" data-calpos="first" aria-pressed="false">before the globe</button>
        <button type="button" data-calpos="carousel" aria-pressed="false">after the carousel</button>
        <button type="button" data-calpos="end" aria-pressed="true">at the end</button>
      </span>
      <span class="pb-legend">Not part of the design. Pins and picks are placeholders; compare with <a href="/art">/art</a>.</span>
    </div>
  </main>
</BaseLayout>

<style>
  .pa { position: relative; z-index: 0; min-height: 100vh; }
  .pa-wrap { max-width: 1240px; margin: 0 auto; padding: 0 clamp(22px, 5vw, 72px); }

  /* THE INK FOLLOWS THE SKY. The light descent runs from paper to near-black, so text past its middle is set in
     paper. The script sets data-zone on each [data-ink] block from where its middle falls on the page (the sky is
     drawn by page depth); the markup's own values are the default order's, for no script. Dark theme: the ink ramp
     is already light, so none of this applies. */
  :global(html:not([data-theme='dark'])) .pa [data-zone='dark'] {
    --ink-1: #efe9dd; --ink-2: rgba(239, 233, 221, 0.88); --ink-3: rgba(239, 233, 221, 0.76); --ink-4: rgba(239, 233, 221, 0.6);
  }

  .pa-head { padding: 13vh 0 2vh; }
  .back { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); text-decoration: none; letter-spacing: 0.04em; }
  .back:hover { color: var(--seal); }
  .pa h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(38px, 5vw, 60px); line-height: 1.04;
    letter-spacing: -0.01em; margin-top: 16px; color: var(--ink-1); }
  .lede { font-size: 15px; color: var(--ink-3); margin-top: 16px; line-height: 1.7; max-width: 52ch; }
  .seclabel { font-family: var(--font-mono); font-weight: 400; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--ink-3); margin: 0 0 18px; }
  .room { padding: 7vh 0; }

  /* ── 1. PLACES ───────────────────────────────────────────────────────────────────────────────── */
  .places-room { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 40px; align-items: center; }
  .globe-stage { position: relative; height: min(70vh, 620px); min-height: 420px; touch-action: pan-y; cursor: grab;
    --globe-disc: rgba(239, 233, 221, 0.28); }
  :global(html[data-theme='dark']) .globe-stage { --globe-disc: rgba(223, 227, 223, 0.035); }
  .globe-stage.is-grabbing { cursor: grabbing; }
  .globe-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* No script: no globe, the list is the page. Until placed, a stack sits nowhere: the script shows it. */
  @media (scripting: none) { .globe-stage { display: none; } .places-room { grid-template-columns: 1fr; } }
  .stack { position: absolute; left: 0; top: 0; width: 74px; height: 82px; opacity: 0; z-index: 1; will-change: transform, opacity; }
  .stack.is-away { pointer-events: none; }
  .stack:hover, .stack:focus-within, .stack.is-lit { z-index: 5; }
  .stack-btn { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .pol { position: absolute; left: 5px; top: 4px; width: 64px; height: 74px; padding: 4px 4px 14px; background: var(--paper);
    box-shadow: 0 1px 2px rgba(20, 18, 14, 0.22), 0 6px 14px -6px rgba(20, 18, 14, 0.45);
    transform: translate(calc(var(--k) * 3px), calc(var(--k) * -2px)) rotate(calc(-4deg + var(--k) * 5deg));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .pol :global(img) { display: block; width: 56px; height: 56px; object-fit: cover; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .stack:hover .pol, .stack.is-lit .pol { transform: translate(calc(var(--k) * 9px), calc(var(--k) * -4px)) rotate(calc(-6deg + var(--k) * 8deg)); }
  }
  .stack-n { position: absolute; right: -2px; top: -4px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 9px;
    background: var(--seal); color: #f6efe6; font: 600 10px/18px var(--font-mono); text-align: center; z-index: 4; }
  .stack-btn:focus-visible { outline: 2px solid var(--seal); outline-offset: 4px; }

  /* THE HOVER BOX (WCAG 1.4.13): on hover (a mouse or pen) or keyboard focus; it takes the pointer while shown, a
     bridge spans the gap to it, and Escape hides it without moving either (the script's data-tip-off). Its ground
     is the page base, its text paper: 15:1 in both themes, on any depth of the sky. */
  .tip { position: absolute; z-index: 6; opacity: 0; pointer-events: none; transform: translateY(4px);
    background: var(--bg); color: var(--paper); border-radius: 3px; box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.55);
    transition: opacity 0.18s ease, transform 0.18s ease; text-align: left; }
  @media (hover: hover) { .has-tip:hover:not([data-tip-off]) .tip { opacity: 1; transform: none; pointer-events: auto; } }
  .has-tip:has(:focus-visible):not([data-tip-off]) .tip { opacity: 1; transform: none; pointer-events: auto; }
  .stack-tip { left: 50%; top: calc(100% + 10px); width: 250px; margin-left: -125px; padding: 12px 14px 13px; }
  .stack-tip::before { content: ""; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
  .tip-k { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.7; }
  .tip-t { display: block; font-family: var(--font-display); font-size: 17px; line-height: 1.25; margin-top: 6px; }
  .tip-n { display: block; font-size: 13px; line-height: 1.55; margin-top: 4px; opacity: 0.86; }
  .tip-more { font-size: 12px; line-height: 1.5; margin-top: 8px; opacity: 0.62; }

  .side-line { font-size: 14px; line-height: 1.65; color: var(--ink-3); margin-bottom: 18px; }
  .places { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .places li { border-bottom: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .place-btn { display: grid; grid-template-columns: 1fr auto; column-gap: 10px; width: 100%; padding: 9px 2px; border: 0;
    background: none; text-align: left; cursor: pointer; color: var(--ink-1); min-height: 44px; }
  .pl-name { font-family: var(--font-display); font-size: 16px; }
  .pl-region { grid-row: 2; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: var(--ink-3); }
  .pl-n { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); }
  .place-btn:hover .pl-name, .place-btn:focus-visible .pl-name { color: var(--seal); }
  .place-btn:focus-visible { outline: 2px solid var(--seal); outline-offset: 2px; }
  .placeholder-note { margin-top: 16px; font-family: var(--font-mono); font-size: 11px; line-height: 1.6; color: var(--seal); }

  /* ── 2. SELECTED ─────────────────────────────────────────────────────────────────────────────── */
  .sel-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .sel-text { max-width: 440px; }
  .sel-count { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em; color: var(--ink-3); }
  .sel-rule { width: 32px; height: 1px; background: currentColor; }
  /* Every slide's text in one cell, so the panel is as tall as the longest and nothing below it moves. */
  .sel-slides { display: grid; margin-top: 26px; }
  .sel-slide { grid-area: 1 / 1; opacity: 0; transform: translateY(10px); }
  .sel-slide.is-on { opacity: 1; transform: none; }
  .sel-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(36px, 4.4vw, 58px); line-height: 1.08;
    letter-spacing: -0.015em; color: var(--ink-1); }
  .sel-sub { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--seal); }
  .sel-story { margin-top: 18px; font-size: 17px; line-height: 1.75; color: var(--ink-2); max-width: 38ch; }
  .sel-arrows { display: flex; gap: 12px; margin-top: 34px; }
  .arrow { width: 48px; height: 48px; border-radius: 50%; border: 1px solid currentColor; background: none; color: var(--ink-1);
    font-size: 18px; cursor: pointer; transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease; }
  @media (hover: hover) { .arrow:hover { color: var(--seal); } }
  .arrow:active { transform: scale(0.95); }
  .arrow:focus-visible { outline: 2px solid var(--seal); outline-offset: 3px; }
  .sel-frame { position: relative; width: min(520px, 36vw, 50vh); aspect-ratio: 3 / 4; touch-action: pan-y; }
  .corner { position: absolute; width: 40px; height: 40px; border: 0 solid var(--ink-3); opacity: 0.55; pointer-events: none; }
  .corner.tl { left: -10px; top: -10px; border-left-width: 1px; border-top-width: 1px; }
  .corner.br { right: -10px; bottom: -10px; border-right-width: 1px; border-bottom-width: 1px; }
  .sel-img { position: absolute; inset: 0; padding: 0; border: 0; background: rgba(var(--hairline-rgb), 0.16); cursor: zoom-in;
    opacity: 0; transform: scale(1.02); }
  .sel-img.is-on { opacity: 1; transform: none; }
  .sel-img :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; box-shadow: 0 30px 60px -30px rgba(20, 18, 14, 0.6); }
  .sel-img:focus-visible { outline: 2px solid var(--seal); outline-offset: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    .sel-img { transition: opacity 0.7s ease, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .sel-slide { transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .sel-slide.is-on { transition-delay: 0.12s; }
  }
  .sel-progress { list-style: none; margin: 44px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .sel-progress button { position: relative; width: 100%; padding: 14px 0 0; border: 0; background: none; text-align: left; cursor: pointer;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--ink-3); min-height: 44px; }
  .sel-progress button::before, .sel-progress button::after { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px; }
  .sel-progress button::before { background: rgba(var(--hairline-rgb), 0.35); }
  .sel-progress button::after { background: var(--seal); transform: scaleX(0); transform-origin: left; }
  .sel-progress button[aria-current] { color: var(--ink-1); }
  .sel-progress button[aria-current]::after { transform: scaleX(1); }
  .sel-progress button:hover { color: var(--ink-1); }
  .sel-progress button:focus-visible { outline: 2px solid var(--seal); outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) { .sel-progress button::after { transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); } }

  /* ── 3. THE WALL ─────────────────────────────────────────────────────────────────────────────── */
  .wall-room { container-type: inline-size; }
  .wall { --cols: 3; --gap: 18px; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--gap);
    grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols) / 50); }
  .tile { grid-row: span var(--span); height: calc(var(--r) * (100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols) / 50);
    margin: 0; position: relative; overflow: hidden; border-radius: 2px; background: rgba(var(--hairline-rgb), 0.2); }
  .tile-btn { position: absolute; inset: 0; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .tile-btn :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; position: relative; z-index: 1; }
  .tile-btn:focus-visible { outline: 2px solid var(--seal); outline-offset: -2px; }
  /* /art's loading tile: a palette-tone ground, a transform-only shimmer while the picture decodes (three passes,
     inside five seconds, then the tone rests), and a fade once it has. No script or reduced motion: shown at once. */
  .tile::before { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none; transform: translateX(-100%);
    background: linear-gradient(100deg, transparent 30%, rgba(239, 233, 221, 0.22) 50%, transparent 70%); }
  .tile.is-loaded::before { content: none; }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .tile::before { animation: pa-shimmer 1.6s ease-in-out 3; }
    .tile-btn :global(img) { opacity: 0; transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .tile.is-loaded .tile-btn :global(img) { opacity: 1; }
    @keyframes pa-shimmer { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .tile:hover .tile-btn :global(img) { transform: scale(1.03); } }
  .tile-tip { left: 10px; right: 10px; bottom: 10px; padding: 10px 12px 11px; z-index: 3; }
  @media (max-width: 900px) { .wall { --cols: 2; --gap: 14px; } }
  @media (max-width: 640px) { .wall { --cols: 1; } }

  /* ── 4. CALLIGRAPHY ──────────────────────────────────────────────────────────────────────────── */
  .cal-host { display: flex; flex-direction: column; gap: clamp(8vh, 10vh, 120px); padding: 4vh 0; }
  .cal-work { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .cal { padding: 0; border: 0; background: none; line-height: 0; cursor: zoom-in; }
  .cal :global(img) { display: block; width: auto; max-width: 100%; max-height: min(82vh, 820px); }
  .cal.stele :global(img) { filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.55)); }
  .cal.paper :global(img) { border: 1px solid rgba(255, 255, 255, 0.16); box-shadow: 0 24px 60px -22px rgba(20, 18, 14, 0.5); }
  .cal:focus-visible { outline: 2px solid var(--seal); outline-offset: 6px; }
  .cal-cap { display: flex; flex-direction: column; align-items: center; gap: 5px; text-align: center; }
  .cal-k { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ink-3); }
  .cal-t { font-family: var(--font-display); font-size: 24px; color: var(--ink-1); }
  .cal-m { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); }
  .pa-foot { padding: 10vh 0 18vh; }

  /* ── THE LIGHTBOX ────────────────────────────────────────────────────────────────────────────── */
  .lightbox { border: 0; padding: 0; margin: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; background: rgba(16, 15, 12, 0.97); }
  .lightbox::backdrop { background: rgba(16, 15, 12, 0.97); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .lb-fig { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .lb-img { max-width: 86vw; max-height: 82vh; will-change: transform; cursor: grab; transform-origin: 0 0;
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.8); }
  .lb-cap { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 4px 14px; max-width: 80ch;
    color: rgba(239, 233, 221, 0.86); font-size: 13px; line-height: 1.5; text-align: center; }
  .lb-count, .lb-where { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: rgba(239, 233, 221, 0.6); }
  .lb-title { font-family: var(--font-display); font-size: 17px; color: #efe9dd; }
  .lb-note { flex-basis: 100%; }
  .lb-close { position: fixed; top: 20px; right: 24px; font-family: var(--font-mono); font-size: 13px; color: rgba(239, 233, 221, 0.75);
    background: none; border: 0; cursor: pointer; z-index: 2; }
  .lb-nav { flex: none; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(239, 233, 221, 0.4); background: none;
    color: rgba(239, 233, 221, 0.85); font-size: 18px; cursor: pointer; z-index: 2; }
