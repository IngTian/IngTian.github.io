    .tile-btn :global(img) { opacity: 0; transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .tile.is-loaded .tile-btn :global(img) { opacity: 1; }
    @keyframes pa-shimmer { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .tile:hover .tile-btn :global(img) { transform: scale(1.03); } }
  /* Under the tile, from its left edge, or its right where the sheet ends (the script's data-end). */
  .tile-tip { top: calc(100% + 10px); left: 0; width: 260px; padding: 10px 12px 11px; }
  .tile-tip::before { left: 0; right: 0; top: -12px; height: 12px; }
