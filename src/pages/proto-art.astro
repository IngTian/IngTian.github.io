  .pa-foot { padding: 10vh 0 18vh; width: fit-content; }

  /* ── THE LIGHTBOX ────────────────────────────────────────────────────────────────────────────── */
  .lightbox { border: 0; padding: 0; margin: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; background: rgba(16, 15, 12, 0.97); }
  .lightbox::backdrop { background: rgba(16, 15, 12, 0.97); }
