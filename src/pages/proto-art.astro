</style>

<script>
  import { onPageView } from '../scripts/pageView';
  import { prefersReducedMotion } from '../lib/motion';
  import { LAND, PLACES } from '../data/protoArt';

  const D = Math.PI / 180;
  // Past this depth of the page the light sky is dark enough to set text in paper (/art's rail flips at 0.42).
  const DARK_FROM = 0.45;
  type Mode = 'whole' | 'crop';
  type CalPos = 'first' | 'carousel' | 'end';
  interface View { lam: number; phi: number; R: number; cx: number; cy: number }

  // ── The land: a Fibonacci lattice on the sphere, kept where the mask says land. [sin lat, cos lat, lon] per dot.
  const bits = Uint8Array.from(atob(LAND.b64), (c) => c.charCodeAt(0));
  const isLand = (lat: number, lon: number): boolean => {
    const x = Math.min(LAND.w - 1, Math.floor(((lon + 180) / 360) * LAND.w));
    const y = Math.min(LAND.h - 1, Math.floor(((90 - lat) / 180) * LAND.h));
    const i = y * LAND.w + x;
    return ((bits[i >> 3] >> (i & 7)) & 1) === 1;
  };
  const lattices = new Map<number, Float32Array>();
  const lattice = (n: number): Float32Array => {
    const hit = lattices.get(n);
    if (hit) return hit;
    const out: number[] = [];
    const golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < n; i++) {
      const s = 1 - (2 * i + 1) / n;
      let lon = ((i * golden) / D) % 360;
      if (lon >= 180) lon -= 360;
      if (isLand(Math.asin(s) / D, lon)) out.push(s, Math.sqrt(1 - s * s), lon * D);
    }
    const arr = Float32Array.from(out);
    lattices.set(n, arr);
    return arr;
  };

  // The places' middle, where both views look. Whole: the globe at 0.4 of the stage, tilted so the places sit a
  // little above its centre. Cropped: a globe 0.9 of the stage wide, its top just inside the stage and its centre
  // below it, turned so the places sit mid-stage: a dome of the near hemisphere, the places about three times larger.
  const HOME_LAM = -104 * D;
  const PLACE_LAT = PLACES.reduce((s, p) => s + p.lat, 0) / PLACES.length;
  const home = (mode: Mode, w: number, h: number): View => {
    if (mode === 'whole') {
      const R = Math.min(w, h) * 0.4;
      return { lam: HOME_LAM, phi: 24 * D, R, cx: w / 2, cy: h / 2 + R * 0.08 };
    }
    const R = w * 0.9;
    const cy = h * 0.06 + R;
    const delta = Math.asin(Math.min(0.95, (cy - h * 0.48) / R));
    return { lam: HOME_LAM, phi: PLACE_LAT * D - delta, R, cx: w / 2, cy };
  };
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const mix = (a: View, b: View, t: number): View => ({
    lam: a.lam + (b.lam - a.lam) * t, phi: a.phi + (b.phi - a.phi) * t,
    R: a.R + (b.R - a.R) * t, cx: a.cx + (b.cx - a.cx) * t, cy: a.cy + (b.cy - a.cy) * t,
  });

  onPageView<HTMLElement>('main.proto-art', (main) => {
    const ac = new AbortController();
    const on = { signal: ac.signal };
    const reduce = prefersReducedMotion();
    const cleanups: (() => void)[] = [];
    const params = new URLSearchParams(location.search);

    // ── Zones: each [data-ink] block's ink, from the depth of its middle.
    const inks = Array.from(main.querySelectorAll<HTMLElement>('[data-ink]'));
    let onZone: () => void = () => {};
    const zone = (): void => {
      const H = main.offsetHeight || 1;
      const top0 = main.getBoundingClientRect().top;
      for (const el of inks) {
        const r = el.getBoundingClientRect();
        const z = (r.top - top0 + r.height / 2) / H > DARK_FROM ? 'dark' : 'light';
        if (el.dataset.zone !== z) el.dataset.zone = z;
      }
      onZone();
    };

    // ── The lightbox: a list of photo elements (each carries its data-zoom etc.), prev/next, wheel zoom to 6x.
    const lb = main.querySelector<HTMLDialogElement>('#pa-lightbox');
    const lbImg = lb?.querySelector<HTMLImageElement>('.lb-img') ?? null;
    let list: HTMLElement[] = [];
    let at = 0;
    let zx = 0, zy = 0, zs = 1, panning = false, px = 0, py = 0;
    const tf = (): void => { if (lbImg) lbImg.style.transform = `translate(${zx}px,${zy}px) scale(${zs})`; };
    const setText = (sel: string, text: string): void => { const el = lb?.querySelector(sel); if (el) el.textContent = text; };
    const show = (): void => {
      const el = list[at];
      if (!lb || !lbImg || !el) return;
      const w = Number(el.dataset.zw), h = Number(el.dataset.zh);
      // The box is reserved from the native size as a ratio and a capped width, and the old picture blanked
      // first: art's lightbox (scripts/artGallery.ts) says why each of the obvious alternatives was wrong.
      if (w && h) {
        lbImg.style.aspectRatio = `${w}/${h}`;
        lbImg.style.width = `min(86vw, ${((82 * w) / h).toFixed(3)}vh)`;
      }
      lbImg.removeAttribute('src');
      lbImg.alt = el.dataset.alt ?? '';
      zs = 1; zx = 0; zy = 0; tf();
      lbImg.src = el.dataset.zoom ?? '';
      setText('.lb-count', list.length > 1 ? `${at + 1} / ${list.length}` : '');
      setText('.lb-title', el.dataset.title ?? '');
      setText('.lb-where', el.dataset.where ?? '');
      setText('.lb-note', el.dataset.note ?? '');
      lb.querySelectorAll<HTMLElement>('.lb-nav').forEach((b) => { b.hidden = list.length < 2; });
    };
    const openList = (els: (HTMLElement | null)[], i: number): void => {
      list = els.filter((e): e is HTMLElement => !!e);
      if (!lb || !list.length) return;
      at = Math.max(0, Math.min(list.length - 1, i));
      show();
      if (!lb.open) lb.showModal();
    };
    const step = (d: number): void => { if (list.length > 1) { at = (at + d + list.length) % list.length; show(); } };
    const photoEl = (n: string): HTMLElement | null => main.querySelector<HTMLElement>(`[data-photo="${n}"]`);
    if (lb && lbImg) {
      const img = lbImg;
      lb.querySelector('.lb-close')?.addEventListener('click', () => lb.close());
      lb.querySelectorAll<HTMLElement>('.lb-nav').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step))));
      lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
      lb.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      });
      lb.addEventListener('wheel', (e) => {
        e.preventDefault();
        const ns = Math.min(6, Math.max(1, zs * (e.deltaY < 0 ? 1.12 : 0.89)));
        const r = img.getBoundingClientRect();
        const k = ns / zs;
        zx -= (e.clientX - r.left) * (k - 1); zy -= (e.clientY - r.top) * (k - 1); zs = ns;
        if (zs === 1) { zx = 0; zy = 0; }
        tf();
      }, { passive: false });
      img.addEventListener('pointerdown', (e) => { if (zs <= 1) return; panning = true; px = e.clientX; py = e.clientY; img.setPointerCapture(e.pointerId); e.stopPropagation(); });
      img.addEventListener('pointermove', (e) => { if (!panning) return; zx += e.clientX - px; zy += e.clientY - py; px = e.clientX; py = e.clientY; tf(); });
      img.addEventListener('pointerup', () => { panning = false; });
    }

    // ── Hover boxes: Escape hides the one shown, until both the pointer and the focus have left it.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || lb?.open) return;
      main.querySelectorAll<HTMLElement>('.has-tip').forEach((el) => {
        if (!el.matches(':hover, :focus-within') || el.dataset.tipOff !== undefined) return;
        el.dataset.tipOff = '';
        const done = new AbortController();
        const clear = (): void => {
          if (el.matches(':hover, :focus-within')) return;
          delete el.dataset.tipOff;
          done.abort();
        };
        el.addEventListener('pointerleave', clear, { signal: done.signal });
        el.addEventListener('focusout', () => setTimeout(clear, 0), { signal: done.signal });
        ac.signal.addEventListener('abort', () => done.abort());
      });
    }, on);

    // ── The wall: open from a tile, prev/next through the wall; mark each tile loaded as its picture decodes.
    const tiles = Array.from(main.querySelectorAll<HTMLElement>('.tile-btn'));
    tiles.forEach((b, i) => b.addEventListener('click', () => openList(tiles, i)));
    main.querySelectorAll<HTMLElement>('.tile').forEach((fig) => {
      const img = fig.querySelector('img');
      const mark = (): void => fig.classList.add('is-loaded');
      if (!img || (img.complete && img.naturalWidth > 0)) mark();
      else { img.addEventListener('load', mark, { once: true }); img.addEventListener('error', mark, { once: true }); }
    });

    // ── Calligraphy: its own two-work list.
    const cals = Array.from(main.querySelectorAll<HTMLElement>('.cal'));
    cals.forEach((b, i) => b.addEventListener('click', () => openList(cals, i)));

    // ── The carousel: no autoplay. Arrows, the titles, ← → while focus is in it, a swipe on the picture.
    const sel = main.querySelector<HTMLElement>('.sel');
    if (sel) {
      const imgs = Array.from(sel.querySelectorAll<HTMLElement>('.sel-img'));
      const slides = Array.from(sel.querySelectorAll<HTMLElement>('.sel-slide'));
      const marks = Array.from(sel.querySelectorAll<HTMLElement>('.sel-progress button'));
      const cur = sel.querySelector('.sel-cur');
      let i = 0;
      const go = (n: number): void => {
        const hadFocus = imgs.some((el) => el === document.activeElement);
        i = (n + imgs.length) % imgs.length;
        [imgs, slides].forEach((els) => els.forEach((el, k) => { el.classList.toggle('is-on', k === i); el.inert = k !== i; }));
        marks.forEach((m, k) => { if (k === i) m.setAttribute('aria-current', 'true'); else m.removeAttribute('aria-current'); });
        if (cur) cur.textContent = String(i + 1).padStart(2, '0');
        if (hadFocus) imgs[i].focus({ preventScroll: true });
      };
      sel.querySelectorAll<HTMLElement>('.arrow').forEach((b) => b.addEventListener('click', () => go(i + Number(b.dataset.step))));
      marks.forEach((m, k) => m.addEventListener('click', () => go(k)));
      sel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); go(i + 1); }
      });
      let sx = 0, sy = 0, swiped = false;
      const frame = sel.querySelector<HTMLElement>('.sel-frame');
      frame?.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; swiped = false; });
      frame?.addEventListener('pointerup', (e) => {
        const dx = e.clientX - sx, dy = e.clientY - sy;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) { swiped = true; go(i + (dx < 0 ? 1 : -1)); }
      });
      imgs.forEach((b, k) => b.addEventListener('click', () => { if (swiped) { swiped = false; return; } openList(imgs, k); }));
    }

    // ── The globe.
    const stage = main.querySelector<HTMLElement>('.globe-stage');
    const canvas = stage?.querySelector('canvas') ?? null;
    const ctx2d = canvas?.getContext('2d') ?? null;
    const stacks = Array.from(main.querySelectorAll<HTMLElement>('.stack'));
    const openPlace = (id: string): void => {
      const s = stacks.find((x) => x.dataset.place === id);
      openList((s?.dataset.photos ?? '').split(',').map(photoEl), 0);
    };
    stacks.forEach((s) => s.querySelector('.stack-btn')?.addEventListener('click', () => openPlace(s.dataset.place ?? '')));
    main.querySelectorAll<HTMLElement>('.place-btn').forEach((b) => {
      const id = b.dataset.place ?? '';
      const lit = (v: boolean) => stacks.find((x) => x.dataset.place === id)?.classList.toggle('is-lit', v);
      b.addEventListener('click', () => openPlace(id));
      b.addEventListener('pointerenter', () => lit(true));
      b.addEventListener('pointerleave', () => lit(false));
      b.addEventListener('focus', () => lit(true));
      b.addEventListener('blur', () => lit(false));
    });

    let setMode: (m: Mode) => void = () => {};
    if (stage && canvas && ctx2d) {
      const st = stage, cvs = canvas, ctx = ctx2d;
      const pins = stacks.map((s) => ({ el: s, lat: Number(s.dataset.lat) * D, lon: Number(s.dataset.lon) * D }));
      const CW = 74, CH = 82, LIFT = CH / 2 + 22;
      let mode: Mode = params.get('globe') === 'crop' ? 'crop' : 'whole';
      st.dataset.mode = mode;
      let w = 0, h = 0, dpr = 1;
      let view: View = { lam: HOME_LAM, phi: 0, R: 1, cx: 0, cy: 0 };
      let colors = { dot: '', rim: '', lead: '', pin: '', disc: '' };
      const recolor = (): void => {
        const cs = getComputedStyle(st);
        const v = (name: string) => cs.getPropertyValue(name).trim();
        colors = { dot: v('--ink-2'), rim: v('--ink-4'), lead: v('--ink-3'), pin: v('--seal'), disc: v('--globe-disc') };
      };
      recolor();

      // One motion at a time, each to rest: a tween (the arrival, a view change) or the drag's coast.
      let tween: { from: View; to: View; t0: number; ms: number; fn: (t: number) => number } | null = null;
      let coast: { vl: number; vp: number; t: number; t0: number } | null = null;
      let raf = 0;
      const clampPhi = (p: number) => Math.max(-75 * D, Math.min(80 * D, p));

      const draw = (): void => {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        const { lam, phi, R, cx, cy } = view;
        ctx.globalAlpha = 1;
        ctx.beginPath(); ctx.arc(cx, cy, R, 0, 2 * Math.PI);
        ctx.fillStyle = colors.disc; ctx.fill();
        ctx.globalAlpha = 0.5; ctx.lineWidth = 1; ctx.strokeStyle = colors.rim; ctx.stroke();
        const sp0 = Math.sin(phi), cp0 = Math.cos(phi);
        // ~7px between dots at the whole view's radius and ~9px at the cropped one's; the switch falls mid-tween.
        const dense = R > 420;
        const pts = lattice(dense ? 90000 : 16000);
        const rad = dense ? 1.6 : 1.15;
        const buckets = [new Path2D(), new Path2D(), new Path2D(), new Path2D()];
        for (let k = 0; k < pts.length; k += 3) {
          const s = pts[k], c = pts[k + 1], dl = pts[k + 2] - lam;
          const cdl = Math.cos(dl);
          const z = sp0 * s + cp0 * c * cdl;
          if (z <= 0) continue;
          const x = cx + R * c * Math.sin(dl);
          const y = cy - R * (cp0 * s - sp0 * c * cdl);
          if (x < -2 || y < -2 || x > w + 2 || y > h + 2) continue;
          const b = Math.min(3, (z * 4) | 0);
          const r = rad * (0.55 + 0.15 * b);
          buckets[b].moveTo(x + r, y);
          buckets[b].arc(x, y, r, 0, 2 * Math.PI);
        }
        ctx.fillStyle = colors.dot;
        [0.2, 0.4, 0.62, 0.86].forEach((a, b) => { ctx.globalAlpha = a; ctx.fill(buckets[b]); });

        // The places: each pin, and its stack set clear of the others with a hairline back to the pin.
        const at = pins.map((p) => {
          const dl = p.lon - lam, cdl = Math.cos(dl);
          const z = sp0 * Math.sin(p.lat) + cp0 * Math.cos(p.lat) * cdl;
          const x = cx + R * Math.cos(p.lat) * Math.sin(dl);
          const y = cy - R * (cp0 * Math.sin(p.lat) - sp0 * Math.cos(p.lat) * cdl);
          const inside = x > 0 && y > 0 && x < w && y < h;
          return { x, y, o: inside ? Math.max(0, Math.min(1, (z - 0.1) / 0.2)) : 0 };
        });
        // Thirty rounds pull each card toward its place above its pin while pushing it off every pin and every other
        // card; the rest only push, so they end apart (replayed offline at 600-1000px stages, whole and cropped: no
        // card over another or over a pin). Eight cards, so ~6,000 steps a frame.
        const cards = at.map((a) => ({ x: a.x, y: a.y - LIFT }));
        for (let it = 0; it < 60; it++) {
          let moved = false;
          for (let i = 0; i < cards.length; i++) {
            if (!at[i].o || it >= 30) continue;
            cards[i].x += (at[i].x - cards[i].x) * 0.12; cards[i].y += (at[i].y - LIFT - cards[i].y) * 0.12;
          }
          for (let i = 0; i < cards.length; i++) for (let j = 0; j < at.length; j++) {
            if (!at[i].o || !at[j].o) continue;
            const dx = cards[i].x - at[j].x, dy = cards[i].y - at[j].y;
            const ox = CW / 2 + 8 - Math.abs(dx), oy = CH / 2 + 8 - Math.abs(dy);
            if (ox <= 0 || oy <= 0) continue;
            moved = true;
            if (ox < oy) cards[i].x += (dx >= 0 ? 1 : -1) * ox; else cards[i].y += (dy > 0 ? 1 : -1) * oy;
          }
          for (let i = 0; i < cards.length; i++) for (let j = i + 1; j < cards.length; j++) {
            if (!at[i].o || !at[j].o) continue;
            const dx = cards[j].x - cards[i].x, dy = cards[j].y - cards[i].y;
            const ox = CW + 10 - Math.abs(dx), oy = CH + 10 - Math.abs(dy);
            if (ox <= 0 || oy <= 0) continue;
            moved = true;
            if (ox < oy) { const m = ((dx >= 0 ? 1 : -1) * ox) / 2; cards[i].x -= m; cards[j].x += m; }
            else { const m = ((dy >= 0 ? 1 : -1) * oy) / 2; cards[i].y -= m; cards[j].y += m; }
          }
          for (const c of cards) {
            c.x = Math.max(CW / 2 + 4, Math.min(w - CW / 2 - 4, c.x));
            c.y = Math.max(CH / 2 + 4, Math.min(h - CH / 2 - 4, c.y));
          }
          if (!moved && it >= 30) break;
        }
        ctx.lineWidth = 1; ctx.strokeStyle = colors.lead;
        at.forEach((a, i) => {
          if (!a.o) return;
          const c = cards[i];
          const ex = Math.max(c.x - CW / 2, Math.min(c.x + CW / 2, a.x)), ey = Math.max(c.y - CH / 2, Math.min(c.y + CH / 2, a.y));
          if (Math.hypot(ex - a.x, ey - a.y) > 4) {
            ctx.globalAlpha = 0.7 * a.o;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(ex, ey); ctx.stroke();
          }
          ctx.globalAlpha = a.o; ctx.fillStyle = colors.pin;
          ctx.beginPath(); ctx.arc(a.x, a.y, 2.8, 0, 2 * Math.PI); ctx.fill();
        });
        pins.forEach((p, i) => {
          p.el.style.transform = `translate3d(${(cards[i].x - CW / 2).toFixed(1)}px, ${(cards[i].y - CH / 2).toFixed(1)}px, 0)`;
          p.el.style.opacity = at[i].o.toFixed(3);
          p.el.classList.toggle('is-away', at[i].o < 0.5);
        });
      };

      const frame = (now: number): void => {
        raf = 0;
        let more = false;
        if (tween) {
          const t = Math.min(1, (now - tween.t0) / tween.ms);
          view = mix(tween.from, tween.to, tween.fn(t));
          if (t < 1) more = true; else tween = null;
        } else if (coast) {
          const dt = Math.max(0, Math.min(48, now - coast.t));
          coast.t = now;
          const k = Math.exp(-dt / 220);
          coast.vl *= k; coast.vp *= k;
          view = { ...view, lam: view.lam + coast.vl * dt, phi: clampPhi(view.phi + coast.vp * dt) };
          if (Math.hypot(coast.vl, coast.vp) > 2e-5 && now - coast.t0 < 1500) more = true; else coast = null;
        }
        draw();
        if (more) raf = requestAnimationFrame(frame);
      };
      const kick = (): void => { if (!raf) raf = requestAnimationFrame(frame); };
      const goTo = (to: View, ms: number, fn = easeInOut): void => {
        coast = null;
        if (reduce || ms <= 0) { tween = null; view = to; kick(); return; }
        tween = { from: view, to, t0: performance.now(), ms, fn };
        kick();
      };

      // The arrival: a third of a turn, west to east as the Earth turns, settled in 3.6s, then still. It starts when
      // the globe is first a quarter on screen; under reduced motion the globe is at rest from the start.
      let arrived = reduce;
      const size = (): void => {
        const r = st.getBoundingClientRect();
        const d = Math.min(2, window.devicePixelRatio || 1);
        if (!r.width || !r.height || (r.width === w && r.height === h && d === dpr)) return;
        w = r.width; h = r.height; dpr = d;
        cvs.width = Math.round(w * dpr); cvs.height = Math.round(h * dpr);
        // A new size re-homes the view; a running tween keeps its turn and lands on the new home.
        const rest = home(mode, w, h);
        coast = null;
        if (tween) tween = { ...tween, from: { ...tween.from, R: rest.R, cx: rest.cx, cy: rest.cy }, to: rest };
        else view = arrived ? rest : { ...rest, lam: rest.lam + 120 * D, phi: 8 * D };
        draw();
      };
      size();
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting) || arrived || !w) return;
        io.disconnect();
        arrived = true;
        goTo(home(mode, w, h), 3600, ease);
      }, { threshold: 0.25 });
      if (!arrived) io.observe(st);
      let rt = 0;
      const ro = new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(size, 160); });
      ro.observe(st);
      cleanups.push(() => { cancelAnimationFrame(raf); io.disconnect(); ro.disconnect(); clearTimeout(rt); });

      // Drag to turn; on release it coasts to rest (no coast under reduced motion).
      let drag: { x: number; y: number; t: number; vl: number; vp: number } | null = null;
      cvs.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        if (tween) arrived = true;
        tween = null; coast = null;
        drag = { x: e.clientX, y: e.clientY, t: performance.now(), vl: 0, vp: 0 };
        cvs.setPointerCapture(e.pointerId);
        st.classList.add('is-grabbing');
      });
      cvs.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const now = performance.now(), dt = Math.max(1, now - drag.t);
        const dl = -(e.clientX - drag.x) / view.R, dp = (e.clientY - drag.y) / view.R;
        view = { ...view, lam: view.lam + dl, phi: clampPhi(view.phi + dp) };
        drag = { x: e.clientX, y: e.clientY, t: now, vl: dl / dt, vp: dp / dt };
        kick();
      });
      const release = (): void => {
        if (!drag) return;
        if (!reduce && performance.now() - drag.t < 80) coast = { vl: drag.vl, vp: drag.vp, t: performance.now(), t0: performance.now() };
        drag = null;
        st.classList.remove('is-grabbing');
        kick();
      };
      cvs.addEventListener('pointerup', release);
      cvs.addEventListener('pointercancel', release);
      // A stack the keyboard reaches round the back brings the globe home, where every place is in front.
      stacks.forEach((s) => s.addEventListener('focusin', () => {
        if (s.classList.contains('is-away') && w) { arrived = true; goTo(home(mode, w, h), 900); }
      }));

      setMode = (m: Mode): void => {
        mode = m; st.dataset.mode = m;
        if (!w) return;
        arrived = true; io.disconnect();
        goTo(home(m, w, h), 900);
      };
      onZone = () => { recolor(); draw(); };
      document.addEventListener('theme:change', () => { recolor(); draw(); }, on);
    }

    // ── The prototype toolbar: the globe's view and where the calligraphy room stands, kept in the URL.
    const bar = main.querySelector<HTMLElement>('.proto-bar');
    const press = (attr: string, val: string): void => {
      bar?.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === val)));
    };
    const remember = (key: string, val: string, dflt: string): void => {
      const q = new URLSearchParams(location.search);
      if (val === dflt) q.delete(key); else q.set(key, val);
      const s = q.toString();
      history.replaceState(history.state, '', `${location.pathname}${s ? `?${s}` : ''}${location.hash}`);
    };
    const room = main.querySelector<HTMLElement>('#calligraphy');
    const placeCal = (pos: CalPos): void => {
      const anchor = { first: main.querySelector('#places'), carousel: main.querySelector('#selected')?.nextElementSibling, end: main.querySelector('.pa-foot') }[pos];
      if (room && anchor && anchor !== room) anchor.before(room);
      press('data-calpos', pos);
      zone();
    };
    bar?.querySelectorAll<HTMLElement>('[data-globe]').forEach((b) => b.addEventListener('click', () => {
      const m: Mode = b.dataset.globe === 'crop' ? 'crop' : 'whole';
      press('data-globe', m); remember('globe', m, 'whole'); setMode(m);
    }));
    bar?.querySelectorAll<HTMLElement>('[data-calpos]').forEach((b) => b.addEventListener('click', () => {
      const p = (b.dataset.calpos ?? 'end') as CalPos;
      remember('cal', p, 'end'); placeCal(p);
    }));
    press('data-globe', params.get('globe') === 'crop' ? 'crop' : 'whole');
    const calParam = params.get('cal');
    placeCal(calParam === 'first' || calParam === 'carousel' ? calParam : 'end');

    let zt = 0;
    window.addEventListener('resize', () => { clearTimeout(zt); zt = window.setTimeout(zone, 160); }, on);
    cleanups.push(() => clearTimeout(zt));

    return () => { ac.abort(); cleanups.forEach((f) => f()); };
  });
</script>
