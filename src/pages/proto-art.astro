  .lb-hint { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11px;
    color: rgba(239, 233, 221, 0.5); letter-spacing: 0.06em; pointer-events: none; white-space: nowrap; }

