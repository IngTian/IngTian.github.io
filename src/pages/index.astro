---
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidSky from '../components/proto/FluidSky.astro';
import Grain from '../components/Grain.astro';
import Toc from '../components/Toc.astro';
import SkyWash from '../components/SkyWash.astro';
import Heights from '../sections/Heights.astro';
import Interlude from '../sections/Interlude.astro';
import DescentPath from '../components/DescentPath.astro';
import Story from '../sections/Story.astro';
import Lesson from '../sections/Lesson.astro';
import Method from '../sections/Method.astro';
import Work from '../sections/Work.astro';
import Signature from '../sections/Signature.astro';
import Deck from '../components/Deck.astro';
---

<BaseLayout veilLine="a researcher by day" veilOnLoad={false}>
  <!-- is-slides turns the homepage into the deck: the scroll rests at slide edges instead of
       anywhere. The mechanism is CSS scroll-snap (see global.css) — no scroll-hijacking JS, so
       keyboard, trackpad momentum, and find-in-page all keep working. Only the homepage opts in;
       /research and /projects share .descent and must stay free-scrolling reading pages. -->
  <main class="descent is-fluid is-slides">
    <FluidSky strength={4} variant="descent" />
    <SkyWash />
    <Heights />
    <Interlude />
    <!-- The story so far: the graph, then the editorial that explains it. ONE SLIDE, so one surface —
         the graph renders INSIDE the Story panel, on the same paper ground, with the fluid sky fully
         hidden behind it. The descent piece is settled (see notes/showpiece.md). -->
    <Story>
      <DescentPath />
    </Story>
    <!-- THE FIELD, IN THREE SLIDES, on the owner's structure: teach it, then show how the decision gets
         made, then say plainly where the work is.
           1. Lesson — what portfolio optimization IS, with a drafted illustrative asset table, several
              candidate portfolios, the constraints, and the cow as the naive teaching voice.
           2. Method — "systematically, with maths, ML as a tool" plus the chart: three strategies from the
              paper's PUBLISHED out-of-sample results, the owner's method highlighted. Real numbers only —
              see data/track.ts for why an invented equity curve was not an option.
           3. Work — publications, writings, projects, stated plainly.
         The single-question Inquiry slide this replaces was the earlier draft of the same idea; it taught
         nothing before asking, which is what the lesson slide now fixes. -->
    <Lesson />
    <Method />
    <Work />
    <!-- MOUNTAINS IS GONE from the homepage, on the owner's instruction: "you may delete everything
         from below. The record, the experience, everything." It was the résumé — research interests,
         selected writing, selected experience, projects, recognition — and it is the thing the graph
         and the editorial exist to replace. Nothing was lost: every block already has its own route
         (/research, /experience, /projects), and the footer + corner nav carry the doorways. The
         section file is kept, unreferenced, so the markup can be recovered from git or re-used. -->
    <!-- THE TERMINAL IS GONE, on the owner's instruction: "you can delete the terminal at the bottom,
         it's already useless." It was the site's only React island; with it removed the homepage ships
         no client framework at all. Its data (data/script.ts), engine (useTypewriter) and spec are
         deleted with it rather than left as dead weight — git holds them if it ever comes back. -->
    <Signature />
  </main>
  <Toc />
  <Grain />
  <!-- One gesture = one slide. Behaviour lives in lib/deck.ts (pure, tested); this only attaches the
       listeners, and only on the homepage — the reading pages stay free-scrolling. -->
  <Deck />
</BaseLayout>
