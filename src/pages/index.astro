---
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidSky from '../components/proto/FluidSky.astro';
import Grain from '../components/Grain.astro';
import Toc from '../components/Toc.astro';
import SkyWash from '../components/SkyWash.astro';
import Heights from '../sections/Heights.astro';
import Interlude from '../sections/Interlude.astro';
import Mountains from '../sections/Mountains.astro';
import DescentPath from '../components/DescentPath.astro';
import Story from '../sections/Story.astro';
import Ground from '../sections/Ground.astro';
import Signature from '../sections/Signature.astro';
---

<BaseLayout veilLine="a researcher by day" veilOnLoad={false}>
  <main class="descent is-fluid">
    <FluidSky strength={4} variant="descent" />
    <SkyWash />
    <Heights />
    <Interlude />
    <!-- The story so far: the graph, then the editorial that explains it. The descent piece is
         settled (see notes/showpiece.md); the Story panel is the one place the page stops and
         talks, so it gets a paper ground instead of the sky. -->
    <DescentPath />
    <Story />
    <Mountains />
    <Ground />
    <Signature />
  </main>
  <Toc />
  <Grain />
</BaseLayout>
