---
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidSky from '../components/FluidSky.astro';
import Grain from '../components/Grain.astro';
import SideRail from '../components/SideRail.astro';
import SkyWash from '../components/SkyWash.astro';
import Heights from '../sections/Heights.astro';
import Interlude from '../sections/Interlude.astro';
import DescentPath from '../components/DescentPath.astro';
import Story from '../sections/Story.astro';
import Choice from '../sections/Choice.astro';
import Rules from '../sections/Rules.astro';
import Solve from '../sections/Solve.astro';
import Appendix from '../sections/Work.astro';
import Deck from '../components/Deck.astro';
import '../styles/slides.css';
import {
  INTRO_DURATION_MS, INTRO_DUR_MIN_MS, INTRO_DUR_MAX_MS,
} from '../lib/introTimeline';
import { INTRO_SEEN_KEY } from '../lib/introSession';
import { rampFor } from '../lib/skyPalette';
import { homeStops } from '../lib/pageStops';

// The tone the intro's first beat flattens the sky to, read from the SAME ramp data the shader samples
// so the CSS backdrop and the canvas cannot disagree about what "flat" looks like.
//
// POSITION IS PER THEME, and these two numbers must match `flatAt` in lib/skyShader.ts. Light takes the
// ramp's top (paper) and dark its lower middle (near-black). Both originally took the midpoint, which
// in light is #565660 — a mid grey of almost exactly the contour ink's luminance, so the survey lines
// vanished into it and the opening read, in the owner's words, "dull as hell".
const FLAT_AT = { light: 0.04, dark: 0.55 } as const;

/** Sample a ramp at `at`, interpolating between its two bracketing stops. */
const rampAt = (theme: 'light' | 'dark') => {
  const at = FLAT_AT[theme];
  const stops = rampFor('descent', theme);
  let lo = stops[0], hi = stops[stops.length - 1];
  for (const st of stops) {
    if (st[0] <= at && st[0] >= lo[0]) lo = st;
    if (st[0] >= at && st[0] <= hi[0]) hi = st;
  }
  const span = hi[0] - lo[0];
  const f = span > 0 ? (at - lo[0]) / span : 0;
  const ch = (c: string, i: number) => parseInt(c.slice(1 + i * 2, 3 + i * 2), 16);
  const mix = (i: number) => Math.round(ch(lo[1], i) + (ch(hi[1], i) - ch(lo[1], i)) * f);
  return `rgb(${mix(0)}, ${mix(1)}, ${mix(2)})`;
};
const introVars = {
  KEY: INTRO_SEEN_KEY,
  DEF: INTRO_DURATION_MS,
  MIN: INTRO_DUR_MIN_MS,
  MAX: INTRO_DUR_MAX_MS,
  TONE_LIGHT: rampAt('light'),
  TONE_DARK: rampAt('dark'),
};
---

{/* preloadAccent: the Work slide's sub-headlines are the homepage's only Fraunces, in the normal style (its
     italic editorial line shows only while /writing has no piece), and the homepage is the measurement that
     put this preload back (FCP 1956 -> 2333ms without any, three runs on a production build, measured when
     both styles were preloaded; the normal style alone has not been measured). See the note next to <Font>
     in BaseLayout. */}
<BaseLayout veilLine="a researcher by day" veilOnLoad={false} preloadAccent="normal" page="deck">
  {/* THE INTRO IS DECIDED HERE, BEFORE FIRST PAINT, and that timing is the whole point.

      The reported symptom was the sky flashing warm → flat → warm: `--descent-grad` is the base layer
      and the no-WebGL state and it holds the FINISHED colours, so the real sky was on screen for ~300ms
      before the canvas's first draw replaced it with the intro's flat tone. A state shown, then
      un-shown — the owner's words were "renders to our normal stuff and suddenly goes blank".

      A bundled `<script>` cannot fix that: Astro defers it, so it runs after parse, by which point the
      first paint has already happened. `is:inline` parses in document order and therefore before
      anything below it paints — the same mechanism, and the same reason, as the two inline scripts
      already in BaseLayout (the no-FOUC theme resolver and the veil). This is not an Astro limitation;
      it is Astro's answer to exactly this problem.

      `define:vars` keeps every constant single-sourced from lib/, so what is duplicated here is only
      the decision expression, not the policy. This script is the ONE decider: `introSession()` reads
      what it publishes rather than deciding again, so the two cannot disagree.

      THE HERO TEXT IS DELIBERATELY NOT HELD. A `?seq=1` spike did hold it — the owner's note was that
      otherwise "everything is competing for the same attention" — and it is deleted rather than
      shipped, because the H1 is this page's measured LCP element and pausing it for the intro's
      duration makes the animation's cost the headline's cost. The text keeps its own tuned arrival
      (see Heights.astro), which is also why a 5.2s animation is affordable at all. If the sequencing
      is wanted, the honest version is a shorter intro, not a paused LCP. */}
  <script is:inline define:vars={introVars}>
    (function () {
      try {
        var p = new URLSearchParams(location.search);
        var root = document.documentElement;
        var seen = null;
        try { seen = sessionStorage.getItem(KEY); } catch (e) { seen = null; }
        // `?intro=1` overrides the flag; a storage throw reads as "not seen", i.e. play it.
        if (p.get('intro') !== '1' && seen !== null) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try { sessionStorage.setItem(KEY, '1'); } catch (e) {}

        var raw = p.get('dur');
        var n = raw === null || raw.trim() === '' ? NaN : Number(raw);
        var ms = isFinite(n) ? Math.min(MAX, Math.max(MIN, n)) : DEF;
        root.dataset.introAt = String(performance.now());
        root.dataset.introMs = String(ms);

        // BEAT 1's backdrop, set here rather than by the canvas, because `--descent-grad` is the base
        // layer AND the no-WebGL state and it holds the FINISHED colours. Left to the canvas's first
        // draw, the real sky was on screen for ~300ms and then snapped flat: warm → flat → warm, which
        // is what the owner saw as "renders to our normal stuff and suddenly goes blank".
        root.classList.add('intro-flat');
        root.style.setProperty('--intro-flatten', '1');
        root.style.setProperty(
          '--intro-flat-tone',
          root.dataset.theme === 'dark' ? TONE_DARK : TONE_LIGHT,
        );
      } catch (e) { /* never let the hero fail to render over this */ }
    })();
  </script>
  {/* is-slides turns the homepage into the deck: the scroll rests at slide edges instead of anywhere.
       THE MECHANISM IS EXPLICIT JS, NOT CSS SCROLL-SNAP, and this comment used to claim the opposite —
       which is worth correcting loudly, because this is the first thing anyone reads before adding a
       section here. Snap was built first and MEASURED: slide gaps here are 819-2346px while one wheel
       gesture is ~320px, so `scroll-snap-type: y mandatory` kept re-snapping to the slide the gesture
       started from — the scroll sat at y=84 through eight consecutive gestures. `proximity`,
       `scroll-snap-stop: always` and a hero shrunk to exactly 100vh all measured identically stuck, so
       no snap flag can fix it (see the numbers in global.css and lib/deck.ts). The deck is therefore
       driven by <Deck /> below: it owns a rAF tween to the next stop from lib/deck.ts.
         What .is-slides itself contributes is only the SLIDE METRICS (global.css): each top-level
       <section> gets min-height 100vh and centres its content, and the five paper panels get the
       top clearance that keeps the fixed corner nav off their headlines.
         The half of the old comment that WAS true, and stays true — keyboard (Home/End/PageUp/PageDown/
       space/arrows), find-in-page and #anchor jumps, and trackpad momentum all keep working. That is
       deliberate work in Deck.astro (programmatic scrolls are ignored; one flick is coalesced into one
       slide), not something a CSS mechanism was giving us for free.
         Only the homepage's main carries .is-slides; every other page scrolls freely, the ones that share
       .descent (/writing, /writing/<slug>, /experience, /art, the 404) included. The deck also disengages entirely under
       reduced motion and on phones. */}
  <main class="descent is-fluid is-slides">
    <FluidSky variant="descent" />
    <SkyWash />
    <Heights />
    <Interlude />
    {/* WHAT I DO COMES BEFORE HOW I GOT HERE, on the owner's observation: "the descent answered my
         trajectory, but didn't answer what I do. Normally people think about what do I do first, then my
         trajectory." Correct, and it was backwards — a reader met a career-shaped gradient descent before
         knowing what field it descended into.
           1. Choice — what the decision IS, defined rather than assumed: ONE object, a hundred dollars in a
              bar, divided three ways, re-priced after one piece of news, then re-divided month after month.
              (It is not the earlier "six names you recognise" + a forty-eight-forecaster fan; that draft
              opened by assuming the concept, and grepping the built page confirmed nothing on the site said
              what a portfolio was.)
           2. Rules — how hard it actually is, in four beats: you run a billion dollars and your own slippage
              is now measurable; you are not allowed to do most of it; nobody knows what any of it will do;
              now do all of it at once, every month. (It is NOT the convex feasible polygon this comment used
              to describe — that drawing, and the decision lattice beside it, were exact and unit-tested and
              still pulled: both answer "what is the feasible set", a question a reader who has never been
              told no does not have yet, and both SHRINK something on the one slide whose whole claim is that
              the problem grows the closer you look. See the note at the top of Rules.astro before rebuilding
              either.)
           3. Solve — the method, as the algorithm running: a real Bellman lattice filling in backward from the
              horizon, then the optimal route traced forward past the 29 candidate policies it beat.

         Solve used to break the register as the one dark panel. It no longer does — a light-theme reader read
         that as a bug, not as emphasis, so all four paper slides now share one palette and follow the theme. */}
    <Choice />
    <Rules />
    <Solve />
    {/* THEN the trajectory, which now reads as "and this is how I came to be doing it" rather than as a
         riddle about an unnamed field. The graph renders INSIDE the Story panel so the picture and the words
         that read it are one surface. Settled piece. */}
    <Story>
      <DescentPath />
    </Story>
    <Appendix />
    {/* MOUNTAINS IS GONE from the homepage, on the owner's instruction: "you may delete everything
         from below. The record, the experience, everything." It was the résumé — research interests,
         selected writing, selected experience, projects, recognition — and it is the thing the graph
         and the editorial exist to replace. Nothing was lost: every block already has its own route
         (/research, /experience, /projects), and the corner nav carries the doorways. The section
         file is deleted; git holds it. */}
    {/* THE TERMINAL IS GONE, on the owner's instruction: "you can delete the terminal at the bottom,
         it's already useless." It was the site's only React island; with it removed the homepage ships
         no client framework at all. Its data (data/script.ts), engine (useTypewriter) and spec are
         deleted with it rather than left as dead weight — git holds them if it ever comes back. */}
  </main>
  <SideRail stops={homeStops()} hideOver="heights" />
  <Grain />
  {/* One gesture = one slide. Behaviour lives in lib/deck.ts (pure, tested); this only attaches the
       listeners, and only on the homepage — the reading pages stay free-scrolling. */}
  <Deck />
</BaseLayout>
