---
// PROTOTYPE (throwaway, claude/experience-proto): /experience as one wide panel per organisation, after the
// 21st.dev "impact experience" reference — the name, a tagline and the dates; a list of facts; what the work was —
// with each organisation's logo as a pixel-art mark beside its name, on the paper sheet. On hover a mark takes its
// logo's own colours. The switcher at the foot compares the hover ground, the type and the icon size. Noindexed by
// BaseLayout (/proto- path).
import BaseLayout from '../layouts/BaseLayout.astro';
import SideRail from '../components/SideRail.astro';
import { BRAND, PANELS, RECOGNITION, chartRows } from '../data/protoExperience';
import { ICONS } from '../data/protoExperienceIcons';
import type { Stop } from '../lib/pageStops';

type N = 16 | 24 | 32;
const SIZES: N[] = [16, 24, 32];
// A size not transcribed yet falls back to the 24.
const rowsOf = (key: string, n: N): string[] =>
  key === 'independent' ? chartRows(n) : ICONS[key]?.[n] ?? ICONS[key]?.[24] ?? [];
// The brand colours as custom properties on the panel: --b<role> on the light sheet, --b<role>-d on the dark.
const brandStyle = (key: string): string => {
  const b = ICONS[key]?.brand ?? BRAND[key];
  if (!b) return '';
  return (['k', 'm', 's'] as const).flatMap((r) => [
    b.light[r] ? `--b${r}:${b.light[r]}` : '', b.dark[r] ? `--b${r}-d:${b.dark[r]}` : '',
  ]).filter(Boolean).join(';');
};
// One <rect> per horizontal run of a colour, so a 24-cell mark is a few dozen rects, not hundreds.
const runs = (rows: string[]) => rows.flatMap((r, y) => {
  const out: { x: number; y: number; w: number; c: string }[] = [];
  for (let x = 0; x < r.length;) {
    const c = r[x];
    let e = x + 1;
    while (e < r.length && r[e] === c) e++;
    if (c !== '.') out.push({ x, y, w: e - x, c });
    x = e;
  }
  return out;
});
const stops: Stop[] = [
  ...PANELS.map((p) => ({ label: p.rail, target: `x-${p.key}` })),
  { label: 'Recognition', target: 'x-recognition' },
];
---
<BaseLayout title="Experience (prototype) — Ing Tian" description="Prototype of /experience." page="paper" veil={false}>
  <main class="xp">
    <SideRail stops={stops} />
    <div class="xp-wrap">
      <header class="xp-head">
        <a class="back" href="/">← back</a>
        <h1>Experience</h1>
        <p class="lede">The full record. Research first, engineering second — the order they matter in, not the order they happened.</p>
      </header>

      <div class="panels">
        {PANELS.map((p) => (
          <article class="panel" id={`x-${p.key}`} aria-labelledby={`xn-${p.key}`} style={brandStyle(p.key)}>
            {/* The hover ground: the panel's own mark in its colours, cells blown up, or a seal wash; the switcher
                picks one. */}
            <svg class="bg-icon brand" viewBox={`0 0 ${rowsOf(p.key, 32).length} ${rowsOf(p.key, 32).length}`} shape-rendering="crispEdges"
                 aria-hidden="true" preserveAspectRatio="xMaxYMid meet">
              {runs(rowsOf(p.key, 32)).map((r) => <rect class={r.c} x={r.x} y={r.y} width={r.w} height="1" />)}
            </svg>
            <span class="bg-wash" aria-hidden="true"></span>
            <div class="who">
              <div class="mark">
                {/* Each size twice over: in ink (.mono) and in the logo's colours (.brand), cross-faded on hover. */}
                {SIZES.map((n) => {
                  const rows = rowsOf(p.key, n), m = rows.length || n;
                  return (
                    <svg class={`icon i${n}`} viewBox={`0 0 ${m} ${m}`} shape-rendering="crispEdges" aria-hidden="true">
                      {(['mono', 'brand'] as const).map((g) => (
                        <g class={g}>{runs(rows).map((r) => <rect class={r.c} x={r.x} y={r.y} width={r.w} height="1" />)}</g>
                      ))}
                    </svg>
                  );
                })}
              </div>
              <h2 id={`xn-${p.key}`}>{p.name}</h2>
              <p class="tag">{p.tagline}</p>
              <p class="when">{p.period}</p>
            </div>
            <dl class="facts">
              {p.facts.map((f) => (
                <div><dt>{f.label}</dt><dd>{f.href ? <a href={f.href} target="_blank" rel="noopener">{f.value} ↗</a> : f.value}</dd></div>
              ))}
            </dl>
            <div class="what">
              {p.roles.map((r) => (
                <p>{p.roles.length > 1 && <strong>{r.title}, {r.period}. </strong>}{r.detail}</p>
              ))}
            </div>
          </article>
        ))}
      </div>

      <section class="recog" id="x-recognition" aria-labelledby="x-recognition-h">
        <h2 id="x-recognition-h">Recognition</h2>
        <ul>{RECOGNITION.map((a) => <li><span>{a.year}</span><span>{a.title}{a.note && <span class="note"> · {a.note}</span>}</span></li>)}</ul>
      </section>
    </div>

    <div class="proto-bar" role="group" aria-label="Prototype options">
      <span>hover</span>
      <button type="button" data-k="hover" data-v="icon">icon</button>
      <button type="button" data-k="hover" data-v="wash">wash</button>
      <button type="button" data-k="hover" data-v="none">none</button>
      <span>type</span>
      <button type="button" data-k="type" data-v="sans">sans</button>
      <button type="button" data-k="type" data-v="serif">serif</button>
      <span>icon</span>
      <button type="button" data-k="icon" data-v="16">16</button>
      <button type="button" data-k="icon" data-v="24">24</button>
      <button type="button" data-k="icon" data-v="32">32</button>
    </div>
  </main>
</BaseLayout>

<style>
  /* Options live on <html> as data-xp-*, so they survive nothing but this page. */
  .xp { min-height: 100vh; --panel: rgba(var(--hairline-rgb), 0.045); --panel-edge: rgba(var(--hairline-rgb), 0.16); }
  .xp-wrap { max-width: 1480px; margin: 0 auto; padding: 13vh clamp(22px, 5vw, 72px) 18vh; }
  @media not all and (max-width: 1100px) { .xp-wrap { padding-left: 300px; } }
  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  .xp-head h1 { margin: 18px 0 0; color: var(--ink-1); line-height: 0.95; }
  .lede { margin: 18px 0 0; max-width: 52ch; font-size: 16px; line-height: 1.6; color: var(--ink-3); }

  .panels { display: grid; gap: 8px; margin-top: 56px; }
  .panel { position: relative; overflow: hidden; display: grid; gap: 40px;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.15fr) minmax(0, 1.9fr);
    padding: 44px 40px; background: var(--panel); border: 1px solid var(--panel-edge); border-radius: 14px; }
  .panel > :not(.bg-icon, .bg-wash) { position: relative; }

  .mark { height: 96px; display: flex; align-items: flex-end; margin-bottom: 18px; }
  .icon { display: none; }
  :global(html[data-xp-icon='16']) .icon.i16 { display: block; width: 64px; height: 64px; }
  :global(html:not([data-xp-icon='16'], [data-xp-icon='32'])) .icon.i24 { display: block; width: 72px; height: 72px; }
  :global(html[data-xp-icon='32']) .icon.i32 { display: block; width: 96px; height: 96px; }
  .mono .k { fill: var(--ink-1); }
  .mono .m { fill: var(--ink-3); }
  .mono .s { fill: var(--seal); }
  /* The logo's own colours, from the panel's --b* (the ink where a role has none). */
  .brand .k { fill: var(--bk, var(--ink-1)); }
  .brand .m { fill: var(--bm, var(--ink-3)); }
  .brand .s { fill: var(--bs, var(--seal)); }
  :global(html[data-theme='dark']) .brand .k { fill: var(--bk-d, var(--bk, var(--ink-1))); }
  :global(html[data-theme='dark']) .brand .m { fill: var(--bm-d, var(--bm, var(--ink-3))); }
  :global(html[data-theme='dark']) .brand .s { fill: var(--bs-d, var(--bs, var(--seal))); }
  /* On hover the mark cross-fades from ink to its colours, opacity only. */
  .icon .brand { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) { .icon g { transition: opacity 320ms ease-out; } }
  .panel:hover .icon .brand, .panel:focus-within .icon .brand { opacity: 1; }
  .panel:hover .icon .mono, .panel:focus-within .icon .mono { opacity: 0; }

  .who h2 { margin: 0; color: var(--ink-1); line-height: 1.05; }
  .tag { margin: 14px 0 0; font-size: 15px; color: var(--ink-2); }
  .when { margin: 6px 0 0; font: 13px/1.4 var(--font-mono); color: var(--ink-3); }

  .facts { margin: 6px 0 0; display: grid; gap: 14px; align-content: start; }
  .facts > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; }
  .facts dt { font-size: 14px; color: var(--ink-3); }
  .facts dd { margin: 0; font-size: 14.5px; font-weight: 600; color: var(--ink-1); }
  .facts a { color: inherit; text-underline-offset: 3px; }
  .facts a:hover { color: var(--seal); }

  .what p { margin: 0 0 14px; font-size: 15.5px; line-height: 1.62; color: var(--ink-2); max-width: 62ch; }
  .what p:last-child { margin-bottom: 0; }
  .what strong { color: var(--ink-1); font-weight: 600; }

  /* THE HOVER GROUND, opacity only. icon: the panel's 24-cell mark, cells blown up to the panel's height, at the
     right; wash: one soft field of seal. Under reduced motion they appear without a fade. */
  .bg-icon, .bg-wash { position: absolute; pointer-events: none; opacity: 0; }
  .bg-icon { right: -4%; top: -12%; height: 124%; width: auto; aspect-ratio: 1; }
  .bg-wash { inset: 0; background: radial-gradient(70% 120% at 72% 40%, color-mix(in srgb, var(--seal) 22%, transparent), transparent 70%); }
  @media (prefers-reduced-motion: no-preference) { .bg-icon, .bg-wash { transition: opacity 420ms ease-out; } }
  @media (hover: hover) {
    :global(html:not([data-xp-hover])) .panel:hover .bg-icon,
    :global(html[data-xp-hover='icon']) .panel:hover .bg-icon { opacity: 0.14; }
    :global(html[data-xp-hover='wash']) .panel:hover .bg-wash { opacity: 1; }
  }
  :global(html:not([data-xp-hover])) .panel:focus-within .bg-icon,
  :global(html[data-xp-hover='icon']) .panel:focus-within .bg-icon { opacity: 0.14; }
  :global(html[data-xp-hover='wash']) .panel:focus-within .bg-wash { opacity: 1; }

  /* TYPE: sans is the reference's heavy grotesk in the system UI face; serif is the site's Georgia. */
  :global(html:not([data-xp-type='serif'])) .xp-head h1 { font: 800 clamp(56px, 8vw, 120px)/0.95 var(--font-body);
    text-transform: uppercase; letter-spacing: -0.035em; }
  :global(html:not([data-xp-type='serif'])) .who h2 { font: 700 clamp(30px, 2.6vw, 44px)/1.05 var(--font-body); letter-spacing: -0.02em; }
  :global(html[data-xp-type='serif']) .xp-head h1 { font: 400 clamp(52px, 7vw, 104px)/1 var(--font-display); letter-spacing: -0.01em; }
  :global(html[data-xp-type='serif']) .who h2 { font: 400 clamp(30px, 2.6vw, 44px)/1.08 var(--font-display); }

  .recog { margin-top: 12vh; max-width: 900px; }
  .recog h2 { margin: 0 0 12px; font: 12px/1 var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); }
  .recog ul { list-style: none; margin: 0; padding: 0; }
  .recog li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--panel-edge);
    font-size: 15px; color: var(--ink-2); }
  .recog li > span:first-child { font: 13px/1.5 var(--font-mono); color: var(--ink-3); }
  .recog .note { color: var(--ink-3); }

  @media (max-width: 1100px) {
    .panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .what { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .panel { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 28px 22px; }
    .facts > div { grid-template-columns: 6rem 1fr; }
  }

  .proto-bar { position: fixed; z-index: 60; left: 50%; bottom: 16px; transform: translateX(-50%); display: flex; align-items: center;
    gap: 2px; padding: 4px; font: 12px/1 var(--font-mono); color: var(--ink-3); background: var(--sheet-ground);
    border: 1px solid var(--panel-edge); border-radius: 8px; white-space: nowrap; }
  .proto-bar span { padding: 0 6px 0 12px; }
  .proto-bar button { font: inherit; color: var(--ink-2); background: none; border: 0; padding: 8px 9px; border-radius: 5px; cursor: pointer; }
  .proto-bar button[aria-pressed='true'] { background: var(--seal); color: var(--on-accent); }
</style>

<script>
  // The switcher: each button sets data-xp-<key> on <html> and marks itself; ?hover=…&type=…&icon=… preset it.
  const DEFAULTS: Record<string, string> = { hover: 'icon', type: 'sans', icon: '24' };
  const init = (): void => {
    const q = new URLSearchParams(location.search);
    const set = (k: string, v: string): void => {
      document.documentElement.setAttribute(`data-xp-${k}`, v);
      document.querySelectorAll<HTMLButtonElement>(`.proto-bar [data-k="${k}"]`)
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
    };
    for (const k of Object.keys(DEFAULTS)) set(k, q.get(k) ?? DEFAULTS[k]);
    document.querySelectorAll<HTMLButtonElement>('.proto-bar button')
      .forEach((b) => b.addEventListener('click', () => set(b.dataset.k ?? '', b.dataset.v ?? '')));
  };
  document.addEventListener('astro:page-load', init);
</script>
