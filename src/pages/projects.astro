---
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidSky from '../components/proto/FluidSky.astro';
import SkyWash from '../components/SkyWash.astro';
import SideRail from '../components/SideRail.astro';
import { projects, inProgress } from '../data/profile';
import { projectStops, projectSectionId } from '../lib/pageStops';

// TEMPORARY: a plain list of every project's name and idea, standing in until the /projects redesign
// replaces this page. Its sections carry the ids projectStops() points at, so the rail still lands.
const stops = projectStops(projects);
const groups = [
  { id: 'p-selected', title: 'Selected', items: projects.filter((p) => p.tier === 'selected') },
  { id: 'p-workshop', title: 'The workshop', items: projects.filter((p) => p.tier === 'workshop') },
];
---
<BaseLayout
  title="Projects — Ing Tian"
  description="Selected projects by Ing Tian (Zeying Tian) — shipped tools and systems. Featuring witness, a Go plugin that keeps a person-centric archive of how you think and grow as you code."
  page="drafting"
  veil={false}
  navZone="light"
>
  <main class="projects descent is-fluid">
    <FluidSky strength={4} variant="reading" yStart={1.15} />
    <SkyWash />

    <SideRail stops={stops} id="projects-toc" />

    <div class="projects-block">
      <header class="projects-head" id="p-index">
        <a class="back" href="/">← back</a>
        <h1>Projects</h1>
      </header>

      {groups.map((g) => (
        <section class="group" id={g.id}>
          <h2>{g.title}</h2>
          {g.items.map((p) => (
            <div class="item" id={projectSectionId(p.slug)}>
              <h3>{p.name}</h3>
              <p>{p.idea}</p>
            </div>
          ))}
        </section>
      ))}

      <section class="group" id="p-in-progress">
        <h2>In progress</h2>
        {inProgress.map((w) => (
          <div class="item">
            <h3>{w.name}</h3>
            <p>{w.idea}</p>
          </div>
        ))}
      </section>

      <footer class="projects-foot"><a class="back" href="/">← back to the descent</a></footer>
    </div>
  </main>
</BaseLayout>

<style>
  .projects { position: relative; z-index: 0; min-height: 100vh; }
  .projects.descent { background: var(--reading-grad); }
  .projects-block {
    width: min(64%, 860px);
    margin-left: 34%;
    margin-right: clamp(24px, 4vw, 90px);
    box-sizing: border-box;
  }
  .projects-head { padding: 14vh 0 5vh; }
  .back { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); text-decoration: none; letter-spacing: 0.04em; }
  .back:hover { color: var(--seal); }
  .projects h1 {
    font-family: var(--font-display); font-weight: 500; font-size: clamp(38px, 5vw, 58px);
    line-height: 1.04; letter-spacing: -0.01em; margin-top: 16px; color: var(--ink-1);
  }
  .group { padding-bottom: 5vh; scroll-margin-top: 12vh; }
  .group h2 { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 18px; }
  .item { margin-bottom: 22px; scroll-margin-top: 12vh; }
  .item h3 { font-family: var(--font-display); font-weight: 500; font-size: 22px; color: var(--ink-1); }
  .item p { font-size: 14px; line-height: 1.7; color: var(--ink-2); margin-top: 6px; max-width: 60ch; }
  .projects-foot { padding: 10vh 0 16vh; }

  @media (max-width: 1100px) {
    .projects-block { width: auto; margin: 0 auto; padding: 0 24px; max-width: 760px; }
  }
</style>
