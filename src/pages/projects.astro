---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlushCow from '../components/PlushCow.astro';
import SideRail from '../components/SideRail.astro';
import DraftingField from '../components/projects/DraftingField.astro';
import Gallery from '../components/projects/Gallery.astro';
import ProjectAsk from '../components/projects/ProjectAsk.astro';
import SelectedRows from '../components/projects/SelectedRows.astro';
import TerminalHeader from '../components/projects/TerminalHeader.astro';
import WorkshopCards from '../components/projects/WorkshopCards.astro';
import { projects } from '../data/profile';
import { projectStops } from '../lib/pageStops';
import { BOOT_DEADLINE_MS, BOOT_SEEN_KEY, shouldBoot } from '../lib/projectsBoot';

// /projects on its own register: the drafting field behind it (no FluidSky, no SkyWash — `page="drafting"` swaps
// in ink sized for the drafting ground) and no descent veil, because the page's boot is its entrance.
// Every section and every project carries the id projectStops() points at, so the rail always lands — the
// in-progress stop is the dashed card at the end of the workshop.
const stops = projectStops(projects);
const names = projects.filter((p) => p.tier === 'selected').map((p) => p.name);
const description = `Projects by Ing Tian (Zeying Tian) — ideas turned into things that run: ${names.slice(0, -1).join(', ')} and ${names.at(-1)}, plus the tools he built for himself and kept using.`;

// THE BOOT IS DECIDED HERE, INLINE, BEFORE FIRST PAINT — for the reason index.astro's intro decider is: a bundled
// script runs after parse, so the finished listing and the open fan would paint first and then be taken away.
// It survives ClientRouter navigation the same way too: `<html>` takes the incoming page's attributes (none of
// them `projects-boot`), and the router runs an inline script it has not run before, so arriving at /projects
// from another page decides once and a return in the same session finds the flag set anyway.
// shouldBoot is shipped AS ITS OWN SOURCE rather than retyped here, so the function tests/projectsBoot.test.ts
// checks is the one that runs — CLAUDE.md's "a test is not a consumer" (the intro's shouldPlayIntro had specs and
// no caller). tests/distSmoke.test.ts runs this script as shipped. A restored scroll is the router's: it keeps
// scrollY in history.state and restores it after parse, so `scrollY` alone still reads 0 here.
// It also owns the boot's CLOCK and its DEADLINE, both from parse. data-boot-at is t=0 for TerminalHeader, which
// may start late. The deadline is the failsafe: only TerminalHeader can light what this hides, so if its script
// never arrives or throws, at BOOT_DEADLINE_MS this takes the class off and tells the page itself — "a script
// that never runs hides nothing", Gallery's rule. Whoever removes the class sends `projects:booted`, so it is
// sent once. A ClientRouter departure drops the class with the rest of <html>'s attributes, which leaves the
// timer nothing to do, and the router never re-runs this script in the same document.
const bootDecider = `(function () {
  try {
    var KEY = ${JSON.stringify(BOOT_SEEN_KEY)}, DEADLINE = ${JSON.stringify(BOOT_DEADLINE_MS)};
    var shouldBoot = ${shouldBoot.toString()};
    var seen = null;
    try { seen = sessionStorage.getItem(KEY); } catch (e) { seen = null; }
    var st = history.state;
    if (!shouldBoot({
      seen: seen !== null,
      force: new URLSearchParams(location.search).get('boot') === '1',
      reduce: matchMedia('(prefers-reduced-motion: reduce)').matches,
      hash: location.hash,
      restoredScroll: scrollY > 0 || !!(st && st.scrollY > 0),
    })) return;
    try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
    var root = document.documentElement;
    root.dataset.bootAt = String(performance.now());
    root.classList.add('projects-boot');
    setTimeout(function () {
      if (!root.classList.contains('projects-boot')) return;
      root.classList.remove('projects-boot');
      window.dispatchEvent(new Event('projects:booted'));
    }, DEADLINE);
  } catch (e) { /* storage that throws means play (above); anything else, the finished page — never a broken one */ }
})();`;
---
<BaseLayout title="Projects — Ing Tian" description={description} page="drafting" veil={false} navZone="light">
  <script is:inline set:html={bootDecider} />
  <DraftingField />
  <SideRail stops={stops} id="projects-toc" />

  <main class="projects-page">
    <a class="back" href="/">← back</a>

    <TerminalHeader />
    {/* The cow: fixed in the right-hand column from 1180px, docked bottom-right on a phone, and between those in the
        flow beside the listing's last line — here in the source for that middle case. */}
    <div class="cowbox"><PlushCow size="rail" talk /></div>
    <Gallery />

    <section class="sec" id="p-selected" aria-labelledby="p-selected-h">
      <div class="sec-h"><span class="n">01</span><h2 id="p-selected-h">Selected work</h2><span class="s">quant · research · data</span></div>
      <SelectedRows />
    </section>

    <section class="sec" id="p-workshop" aria-labelledby="p-workshop-h">
      <div class="sec-h"><span class="n">02</span><h2 id="p-workshop-h">The workshop</h2><span class="s">tools I built for myself and kept using</span></div>
      <WorkshopCards />
    </section>
  </main>
  <ProjectAsk />
</BaseLayout>

<style>
  /* Above the field (z 0). The right gutter from 1180px is the cow's column, mirroring the rail on the left.
     THE LABEL KNOCKOUT: every glyph on the page wears a 1px ring of the bare ground, the way a drafting sheet clears
     the contours around a label. main has no background, so its text sits straight on the field's strokes, and a
     stroke under a glyph takes light --ink-3 from 5.00:1 to 4.10 (minor line), 3.03 (major) and 1.34 (a fresh lit
     ping) — the 4.5:1 rule held only between strokes. With the ring, the pixels touching a glyph are the ground the
     palette was measured on (tests/draftingPalette.test.ts). Offsets with no blur, so the ring is opaque; eight of
     them so the diagonals are closed too. A component with its own opaque ground should set `text-shadow: none`. */
  .projects-page {
    position: relative; z-index: 1; max-width: 1500px; padding: 0 6vw 180px;
    --knock: var(--draft-ground);
    text-shadow: -1px -1px 0 var(--knock), 0 -1px 0 var(--knock), 1px -1px 0 var(--knock), -1px 0 0 var(--knock),
      1px 0 0 var(--knock), -1px 1px 0 var(--knock), 0 1px 0 var(--knock), 1px 1px 0 var(--knock);
  }
  /* Clears SideRail where it shows (it hides at ≤1100px). Measured with every row active, so every rule drawn:
     its right edge is at x=139 at 1101px and x=151 at 2000px, against content starting at 190 and 230. */
  @media (min-width: 1101px) { .projects-page { padding-left: clamp(190px, 13vw, 230px); } }
  @media (min-width: 1180px) { .projects-page { padding-right: calc(4vw + 210px); } }

  /* Every jump target lands 110px down, clear of the fixed corner nav. :global because the targets are rendered by
     child components too (#p-index is TerminalHeader's): scoped, this compiled to section[cid-of-this-page][id] and
     silently missed them — CLAUDE.md's scoped-style trap. Anchored under .projects-page so it cannot leak. */
  .projects-page :global(section[id]), .projects-page :global(li[id]) { scroll-margin-top: 110px; }

  .back { display: inline-block; margin-top: 140px; font: 12px var(--font-mono); color: var(--ink-3); text-decoration: none; letter-spacing: 0.04em; }
  .back:hover { color: var(--ochre); }

  /* THE COW'S COLUMN. From 1180px it is fixed in the gutter the padding above reserves, mirroring the rail; on a
     phone it docks to the bottom-right corner at the same inset. Between 641 and 1179px it follows no scroll —
     fixed there, it and its bubble would cover text and tap targets on tablets and small laptops — and sits in the
     flow BESIDE THE LISTING'S LAST LINE, the idle prompt, whose 14 characters leave the rest of that row empty.
     The box takes no height of its own: the cow's top meets the summary's bottom (TerminalHeader's .idle is a
     12px margin plus one 13.5px/1.55 line, synced by hand) and its 104px reach down into the gallery's 70px top
     margin, so the gallery starts where it would with no cow. A band under the listing (218px, then a 104px row)
     pushed the gallery below the fold at 1100x800 and 1080x810, against spec §3. Its bubble is its own opaque
     ground, so no label knockout.
     NOTHING HERE TAKES A CLICK BUT THE COW. A child's pointer-events: none does not let a click through its
     parent's box, and the cow's wrapper is as wide as the bubble even while the bubble is hidden — so with only
     the bubble transparent, a 212x226 box on a phone and a strip over the rows' arrows at 1440 swallowed every
     click, after the bubble had gone. Hidden while the page boots, like the mockup's, and not pressable then: the
     boot rule is on the button, because its `auto` would beat a `none` inherited from the box. */
  .cowbox { display: flex; justify-content: flex-end; text-shadow: none; pointer-events: none; }
  .cowbox :global(.cow) { pointer-events: auto; }
  /* The bubble is the drafting panel, as every other surface on this page is; set on the bubble so it beats the
     cow's own paper, and its tail inherits it. */
  .cowbox :global(.cow-bubble) { --moo-paper: var(--draft-panel); }
  @media (max-width: 1179px) { .cowbox :global(.cow-art) { width: 88px; height: auto; } }
  @media (min-width: 641px) and (max-width: 1179px) {
    .cowbox { height: 0; align-items: flex-start; }
    .cowbox :global(.cow-wrap) { margin-top: calc(-12px - 13.5px * 1.55); }
  }
  @media (min-width: 1180px) { .cowbox { position: fixed; right: max(26px, 3.2vw); top: 47vh; z-index: 15; } }
  @media (max-width: 640px) { .cowbox { position: fixed; right: max(26px, 3.2vw); bottom: max(26px, 3.2vw); z-index: 15; } }
  :global(html.projects-boot) .cowbox { opacity: 0; transform: translateY(24px); transition: none; }
  :global(html.projects-boot) .cowbox :global(.cow) { pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .cowbox { transition: opacity 0.6s, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  }

  .sec { margin-top: 120px; }
  .sec-h { display: flex; align-items: baseline; gap: 16px; border-bottom: 1px solid rgba(var(--draft-line-rgb), 0.2); padding-bottom: 14px; }
  .sec-h .n { font: 12px var(--font-mono); color: var(--ochre); }
  .sec-h h2 { font: 600 13px var(--font-mono); letter-spacing: 0.24em; text-transform: uppercase; margin: 0; color: var(--ink-1); }
  .sec-h .s { margin-left: auto; font: 11.5px var(--font-mono); color: var(--ink-3); }
  /* The section heads wait out the boot with the rows and cards under them, as in the mockup. */
  :global(html.projects-boot) .sec-h { opacity: 0; transition: none; }
  @media (prefers-reduced-motion: no-preference) { .sec-h { transition: opacity 0.5s; } }
</style>

<script>
  // THE ASK: every project surface on the page (gallery card, selected row, workshop card) is its repo link, or a
  // button for a private one, carrying data-ask. A plain primary click asks first — `projects:ask` on window, for
  // the pop-up — instead of leaving; a modified or middle click falls through and opens the repo, as a reader doing
  // that expects. A button has no repo to fall through to, so a modified click on one asks too. One listener here,
  // so the rule cannot differ between the three.
  import { PROJECT_COW_LINES } from '../data/cowLines';
  import type { SpokenLine } from '../lib/cowSpeech';
  import { BUBBLE_MS, HELLO_DELAY_MS, IDLE_EVERY_MS, TYPE_MS, mayIdle, nextLine } from '../lib/cowTalk';
  import { askPoint } from '../lib/galleryLayout';
  import { prefersReducedMotion } from '../lib/motion';
  import { onPageView } from '../lib/pageView';

  let teardown: (() => void) | null = null;

  // Started with the boot (lib/pageView.ts), not at window `load`: the boot can be skipped once the header's script
  // runs, right after parse, and the press that skips it must already find this listening — and ProjectAsk, which
  // starts the same way, there to answer the clicks this turns into asks.
  onPageView('main.projects-page', () => {
    teardown?.();
    teardown = null;
    const page = document.querySelector<HTMLElement>('main.projects-page');
    if (!page) return;
    // A PRESS THAT SKIPS THE BOOT DOES NOTHING ELSE: the click ending it neither asks nor falls through to the repo.
    // During the boot the gallery is still the pile and the rows are invisible, so what is under the pointer is not
    // what the reader aimed at. Read at pointerdown, in the capture phase on window, because the boot's skip removes
    // html.projects-boot on that same pointerdown — a check at click time would never see the boot. A keyboard click
    // (detail 0) has no pointerdown of its own, so a stale mark from a press that never clicked cannot swallow it.
    let pressInBoot = false;
    const onDown = (): void => { pressInBoot = document.documentElement.classList.contains('projects-boot'); };
    const onClick = (e: MouseEvent): void => {
      const skipped = pressInBoot && e.detail > 0;
      // A listing name is an index: it jumps (no preventDefault) and never asks, but the cow still says its line.
      // A press that skipped the boot does not jump either: a line not yet printed is transparent, not absent, so
      // its link still takes the press.
      const listed = (e.target as Element).closest<HTMLElement>('[data-cow-key]');
      if (listed) {
        if (skipped) e.preventDefault();
        else window.dispatchEvent(new CustomEvent('cow:say', { detail: { key: listed.dataset.cowKey!, announce: true } }));
      }
      const from = (e.target as Element).closest<HTMLElement>('[data-ask]');
      if (!from) return;
      if (skipped) { e.preventDefault(); return; }
      const at = askPoint(e, from.getBoundingClientRect(), from.matches('a[href]'));
      if (!at) return;
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('projects:ask', { detail: { slug: from.dataset.ask!, ...at, from } }));
    };
    window.addEventListener('pointerdown', onDown, { capture: true });
    page.addEventListener('click', onClick);
    teardown = () => {
      window.removeEventListener('pointerdown', onDown, { capture: true });
      page.removeEventListener('click', onClick);
    };
  });

  // THE COW TALKS. PlushCow's `talk` markup, driven from here so no other page with a cow ships any of this. It greets
  // once per page view, HELLO_DELAY_MS after the page is booted — "booted" is a state: no html.projects-boot means
  // booted already, otherwise wait for `projects:booted`. It says a project's line on `cow:say` (the ask and the
  // listing send one), its next idle line when pressed, and now and then one on its own, gated by mayIdle() and
  // never while the tab is hidden. Only `announce` lines reach the live region: a reader asked for those, and the
  // greeting and idle chatter would interrupt a screen reader every 10-20s.
  let teardownCow: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    teardownCow?.();
    teardownCow = null;
    const wrap = document.querySelector<HTMLElement>('.cow-wrap--talk');
    const maybeBtn = wrap?.querySelector<HTMLButtonElement>('[data-cow]');
    const maybeBubble = wrap?.querySelector<HTMLElement>('.cow-bubble');
    const maybeSays = wrap?.querySelector<HTMLElement>('[data-cow-says]');
    const maybeA = wrap?.querySelector<HTMLElement>('[data-said-a]');
    const maybeB = wrap?.querySelector<HTMLElement>('[data-said-b]');
    const maybeLive = wrap?.querySelector<HTMLElement>('[data-cow-live]');
    if (!maybeBtn || !maybeBubble || !maybeSays || !maybeA || !maybeB || !maybeLive) return;
    const btn = maybeBtn, bubble = maybeBubble, says = maybeSays, lineA = maybeA, lineB = maybeB, live = maybeLive;
    const root = document.documentElement;
    const reduce = prefersReducedMotion();

    const sets: Record<string, readonly SpokenLine[]> = {
      ...PROJECT_COW_LINES.byKey, hello: PROJECT_COW_LINES.hello, idle: PROJECT_COW_LINES.idle,
    };
    const said: Record<string, number> = {};
    // Arrival counts as quiet, so the first idle line is never sooner than 14s in.
    let lastSpoke = performance.now();
    let typeT = 0, hideT = 0, helloT = 0, idleT = 0, liveF = 0;

    function say(key: string, announce: boolean): void {
      const k = key in sets ? key : 'idle';
      const next = nextLine(sets[k], said[k] ?? 0);
      said[k] = next.said;
      const [top, bottom] = next.line;
      lastSpoke = performance.now();
      window.clearTimeout(typeT);
      window.clearTimeout(hideT);
      if (announce) {
        // A reader's line wins: once they have asked, "Click one. I'll explain." has nothing left to say, so a
        // pending greeting (or one still waiting on the boot) is dropped rather than typed over their line.
        window.clearTimeout(helloT);
        window.removeEventListener('projects:booted', greet);
        // Cleared, then set a frame later, so a line equal to the last one (in-progress has only one) is a new
        // addition to the region rather than the same text, which a screen reader may not repeat.
        live.textContent = '';
        cancelAnimationFrame(liveF);
        liveF = requestAnimationFrame(() => { live.textContent = `${top} ${bottom}`; });
      }
      // The box is sized for the whole line before a character lands, so it does not grow as it types.
      says.style.width = `${Math.max(top.length, bottom.length)}ch`;
      bubble.classList.add('is-on');
      const hide = (): void => { bubble.classList.remove('is-on'); };
      // Reduced motion: the line whole, no typing and no hop.
      if (reduce) {
        lineA.textContent = top;
        lineB.textContent = bottom;
        hideT = window.setTimeout(hide, BUBBLE_MS);
        return;
      }
      btn.classList.remove('is-hop');
      void btn.offsetWidth;   // restart the hop on a line that interrupts the last one
      btn.classList.add('is-hop');
      let n = 0;
      const type = (): void => {
        n += 1;
        lineA.textContent = top.slice(0, n);
        lineB.textContent = bottom.slice(0, Math.max(0, n - top.length));
        if (n < top.length + bottom.length) typeT = window.setTimeout(type, TYPE_MS);
        else hideT = window.setTimeout(hide, BUBBLE_MS);
      };
      type();
    }

    const greet = (): void => { helloT = window.setTimeout(() => say('hello', false), HELLO_DELAY_MS); };
    const idle = (): void => {
      const [lo, hi] = IDLE_EVERY_MS;
      idleT = window.setTimeout(() => {
        if (!document.hidden && mayIdle(performance.now(), lastSpoke, root.classList.contains('projects-boot'))) say('idle', false);
        idle();
      }, lo + Math.random() * (hi - lo));
    };
    const onSay = (e: Event): void => {
      const d = (e as CustomEvent<{ key: string; announce: boolean }>).detail;
      if (d?.key) say(d.key, d.announce === true);
    };
    const onPress = (): void => say('idle', true);

    if (root.classList.contains('projects-boot')) window.addEventListener('projects:booted', greet, { once: true });
    else greet();
    idle();
    window.addEventListener('cow:say', onSay);
    btn.addEventListener('click', onPress);

    teardownCow = () => {
      [typeT, hideT, helloT, idleT].forEach((id) => window.clearTimeout(id));
      cancelAnimationFrame(liveF);
      window.removeEventListener('projects:booted', greet);
      window.removeEventListener('cow:say', onSay);
      btn.removeEventListener('click', onPress);
    };
  });
</script>
