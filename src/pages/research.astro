---
// The papers as a plain list, each title linking to where the paper can be read.
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/profile';
---
<BaseLayout
  title="Research — Ing Tian"
  description="Research by Ing Tian (Zeying Tian) on portfolio optimization and machine learning, including RL-BHRP, a reinforcement learning embedded Bayesian hierarchical risk parity approach to allocation."
  page="paper"
  veil={false}
>
  <main class="research">
    <a class="back" href="/">← back</a>
    <h1>Research</h1>
    <ul>
      {publications.map((p) => <li><a href={p.href}>{p.title}</a></li>)}
    </ul>
  </main>
</BaseLayout>
