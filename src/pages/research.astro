---
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidSky from '../components/proto/FluidSky.astro';
import SkyWash from '../components/SkyWash.astro';
import SideRail from '../components/SideRail.astro';
import { publications, researchInterests } from '../data/profile';
import { researchStops, paperSectionId, paperAnchorId } from '../lib/pageStops';
import { mathFor } from '../lib/paperMath';

const featured = publications.filter((p) => p.featured);
const others = publications.filter((p) => !p.featured);

// The rail nests each paper under its own name at any paper count — see
// lib/pageStops.ts. Equations come from lib/paperMath, the SAME module the rail
// consults, so a Method stop and a Method block can never disagree.
const stops = researchStops(publications, researchInterests);
---
{/* preloadAccent: .card-takeaway (further down this file) is the one Fraunces rule on /research, so this
     page opts into the two preload links. The six routes that render no accent text no longer pay 82KB at
     highest priority for a face they never use — see the note next to <Font> in BaseLayout. */}
<BaseLayout
  title="Research — Ing Tian"
  description="Selected research by Ing Tian (Zeying Tian) — portfolio optimization and machine learning. Featuring RL-BHRP, a reinforcement-learning-embedded Bayesian Hierarchical Risk Parity approach to adaptive allocation."
  veilLine="a researcher by day"
  veilOnLoad={true}
  navZone="light"
  preloadAccent={true}
>
  {/* Marks the document JS-capable before anything paints, so the CSS can present the cards as
       interactive only when something can respond. The collapse itself happens in the snippet AFTER
       the papers (a detail cannot be collapsed before it is parsed). */}
  <script is:inline>document.documentElement.classList.add('paper-js');</script>

  <main class="research descent is-fluid">
    <FluidSky strength={4} variant="reading" yStart={1.15} />
    <SkyWash />

    <SideRail stops={stops} id="research-toc" />

    <div class="research-block">
      <header class="research-head">
        <a class="back" href="/">← back</a>
        <h1>Research</h1>
        <p class="lede">Portfolio optimization at the seam of operations research and machine learning — what I work on, and what I've published.</p>
      </header>

      {researchInterests.length > 0 && (
        <section class="interests" id="r-interests">
          <h2 class="section-label">Research interests</h2>
          <ul class="interest-list">
            {researchInterests.map((it) => (
              <li class="interest">
                <span class="interest-label">{it.label}</span>
                <span class="interest-gloss">{it.gloss}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <h2 class="section-label section-label--major" id="r-selected">Selected research</h2>

      {featured.map((p, i) => {
        const math = mathFor(p);
        const headline = p.results?.[0];
        return (
        <article class="paper" data-paper>
          {/* title + byline span both columns, like a paper masthead.
               THE MASTHEAD IS THE CARD'S BUTTON. The owner's brief: the lucid paper card is "elegant…
               probably we will have many papers in the future, so it's fine to have that card in the
               research tab. After clicking on the card, it expands to a more detailed summary."
               A real <button> wrapping the summary, not a click handler on a div: it is keyboard
               reachable, announces its expanded state, and works with assistive tech for free. */}
          <button
            type="button"
            class="paper-card"
            id={paperAnchorId(i)}
            aria-expanded="false"
            aria-controls={`${paperAnchorId(i)}-detail`}
            data-paper-toggle
          >
            <span class="paper-head">
              <span class="kicker">{p.subject ?? 'Research'}</span>
              <span class="paper-title">{p.title}</span>
              <span class="byline">{p.authors} · {p.venue}{p.arxivId && <> · arXiv:{p.arxivId}</>} · {p.year}</span>
            </span>

            {/* The card's own summary, visible while collapsed: the one-line "why it matters" plus a
                 single headline number. Enough to decide whether to open it. */}
            {p.takeaway && <span class="card-takeaway">{p.takeaway}</span>}
            <span class="card-foot">
              {headline && (
                <span class="card-stat">
                  <span class="card-stat-value">{headline.value}</span>
                  <span class="card-stat-label">{headline.label}</span>
                </span>
              )}
              {/* The label swaps with the expanded state in CSS (see .card-cue-text), so there is no
                   JS-owned copy that could disagree with aria-expanded. aria-hidden because the button
                   already announces its own state — a screen reader would otherwise hear it twice. */}
              <span class="card-cue" aria-hidden="true">
                <span class="card-cue-text"></span>
                <span class="card-chevron"></span>
              </span>
            </span>
          </button>

          {/* two columns: LEFT = idea + formal method (math); RIGHT = results */}
          {/* NOT `hidden` in the markup: with JS off, this content must be readable, and an earlier
               version that shipped it hidden made the whole paper unreachable (measured: 0 of 1 panels
               rendered with script execution disabled). The inline head script collapses it before
               first paint whenever JS is available, so there is no flash for real visitors. */}
          <div class="paper-body" id={`${paperAnchorId(i)}-detail`} data-paper-detail>
            <div class="paper-left">
              {p.idea && (
                <section class="block" id={paperSectionId(i, 'idea')}>
                  <h3>The idea</h3>
                  <p>{p.idea}</p>
                  {/* The takeaway is NOT repeated here any more. It renders once, on the card, and stays there
                      whether the card is open or shut — see .card-takeaway. This copy existed only because the
                      card's was hidden on expand, and hiding it was the thing making the fold feel wrong. */}
                </section>
              )}

              {math && (
                <section class="block math" id={paperSectionId(i, 'math')}>
                  <h3>The method, formally</h3>
                  {math.equations.map((eq) => (
                    <figure class="eq">
                      <div class="eq-math" set:html={eq.html}></div>
                      <figcaption>{eq.gloss}</figcaption>
                    </figure>
                  ))}
                  <p class="math-foot">Equations from {math.source}.</p>
                </section>
              )}
            </div>

            <div class="paper-right">
              {(p.results?.length || p.metrics) && (
                <section class="block" id={paperSectionId(i, 'results')}>
                  <h3>Results · out-of-sample</h3>
                  {p.results && p.results.length > 0 && (
                    <dl class="results">
                      {p.results.map((r) => (
                        <div class="result">
                          <dt>{r.value}</dt>
                          <dd>{r.label}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  {p.metrics && (
                    <figure class="metrics">
                      <table>
                        <thead>
                          <tr>
                            <th scope="col" class="m-name">Metric</th>
                            {p.metrics.columns.map((c, i) => <th scope="col" class={i === 0 ? 'm-lead' : ''}>{c}</th>)}
                          </tr>
                        </thead>
                        <tbody>
                          {p.metrics.rows.map((row) => (
                            <tr class={row.highlight ? 'hl' : ''}>
                              <th scope="row" class="m-name">{row.metric}</th>
                              {row.values.map((v, i) => <td class={i === 0 ? 'm-lead' : ''}>{v}</td>)}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                      <figcaption>{p.metrics.caption}</figcaption>
                    </figure>
                  )}
                  <div class="links">
                    {p.href && <a class="paper-link" href={p.href} target="_blank" rel="noopener noreferrer">Read the paper · arXiv ↗</a>}
                    {p.pdfHref && <a class="paper-link" href={p.pdfHref} target="_blank" rel="noopener noreferrer">PDF ↗</a>}
                  </div>
                </section>
              )}
            </div>
          </div>
        </article>
        );
      })}

      {/* STATE BEFORE PAINT — but no longer the COLLAPSE before paint. The `html.paper-js` class set in this
           page's head already makes the CSS present every panel closed on the first frame, so this snippet does
           not need to touch them: setting `hidden` as well was a second mechanism for one job, and it was the
           one that made a deep link open nothing (it exempted the linked panel from `hidden` but not from the
           collapsing CSS, and revealFromHash then bailed on a `hidden` test that exemption had made false).
           What is still needed here, synchronously and during parsing, is the two things CSS cannot do: OPEN
           the panel a deep link points into, and mirror the resulting state onto the buttons so the chevron
           and the label are right on the first frame rather than one frame late. Closed panels are marked
           `inert` so their links are out of the tab order while they measure zero — a focusable link inside a
           zero-height box is a keyboard trap on a page that looks empty. */}
      <script is:inline>
        (() => {
          const hash = location.hash.slice(1);
          for (const d of document.querySelectorAll('[data-paper-detail]')) {
            const deep = !!hash && (d.id === hash || d.querySelector('#' + CSS.escape(hash)));
            if (deep) {
              d.classList.add('is-open');
              // No cap, so a deep-linked panel is never clipped; it opens without animating, which is right
              // for a panel that was already open when the page arrived.
              d.style.maxHeight = 'none';
            } else {
              d.setAttribute('inert', '');
              d.setAttribute('aria-hidden', 'true');
            }
          }
          for (const b of document.querySelectorAll('[data-paper-toggle]')) {
            const panel = document.getElementById(b.getAttribute('aria-controls'));
            b.setAttribute('aria-expanded', String(!!panel && panel.classList.contains('is-open')));
          }
        })();
      </script>

      {others.length > 0 && (
        <section class="more" id="r-earlier">
          <h3 class="more-label">Earlier work</h3>
          {others.map((p) => {
            const Tag = p.href ? 'a' : 'div';
            return (
              <Tag class="entry" href={p.href} target={p.href ? '_blank' : undefined} rel={p.href ? 'noopener noreferrer' : undefined}>
                <div class="entry-meta"><span>{p.authors}</span><span>{p.year}</span></div>
                <p class="entry-title">{p.title}{p.href && <span class="arr"> ↗</span>}</p>
                <p class="entry-venue">{p.venue}</p>
              </Tag>
            );
          })}
        </section>
      )}

      <footer class="research-foot"><a class="back" href="/">← back to the descent</a></footer>
    </div>
  </main>
</BaseLayout>

<style>
  .research { position: relative; z-index: 0; min-height: 100vh; }

  /* /research is a READING page — it holds the luminous range top-to-bottom
     (never sinking to near-black) so ink text stays legible all the way down.
     The gradient (light + dark twin) is the shared --reading-grad token in
     tokens.css, so /research and /projects can't drift apart again. */
  .research.descent { background: var(--reading-grad); }
  /* (Hairlines now use var(--hairline-rgb), which flips per theme in tokens.css
     — no hand-maintained dark-theme border override needed here anymore.) */

  /* The left rail is now the shared <SideRail> component (styles + scrollspy
     live there, so /research and /projects can't drift apart). */

  /* The paper block — held RIGHT-of-center at any width. A percentage left
     margin (NOT a clamp that caps out and drifts left on wide monitors) keeps
     ~34% of the viewport as empty margin on the left, where the TOC rail lives. */
  .research-block {
    width: min(64%, 1180px);
    margin-left: 34%;
    margin-right: clamp(24px, 4vw, 90px);
    box-sizing: border-box;
  }

  .research-head { padding: 14vh 0 6vh; }
  .back { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); text-decoration: none; letter-spacing: 0.04em; }
  .back:hover { color: var(--seal); }
  .research h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(38px, 5vw, 58px);
    line-height: 1.04; letter-spacing: -0.01em; font-variation-settings: 'SOFT' 60; margin-top: 16px; color: var(--ink-1); }
  .lede { font-size: 14px; color: var(--ink-3); margin-top: 16px; line-height: 1.7; max-width: 52ch; }

  /* section labels (mono eyebrows) — quiet wayfinding between blocks */
  .section-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--ink-4); scroll-margin-top: 12vh; }
  .section-label--major { margin-top: 9vh; padding-top: 4vh; border-top: 1px solid rgba(var(--hairline-rgb), 0.22); }

  /* research interests — themed list, each a label + one-line gloss */
  .interests { margin-top: 4vh; scroll-margin-top: 12vh; }
  .interest-list { list-style: none; margin: 3vh 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 48px; max-width: 940px; }
  .interest { border-top: 1px solid rgba(var(--hairline-rgb), 0.2); padding-top: 14px; }
  .interest-label { display: block; font-family: var(--font-display); font-weight: 500; font-size: 18px;
    color: var(--ink-1); line-height: 1.25; font-variation-settings: 'SOFT' 40; }
  .interest-gloss { display: block; font-size: 13.5px; line-height: 1.6; color: var(--ink-3); margin-top: 8px; }

  /* ── THE PAPER CARD. Collapsed by default; the masthead IS the button.
     This is the "lucid paper card" the owner picked out on the homepage — a translucent pane that
     lets the fluid sky through — moved here and made the paper's entry point: "after clicking on
     the card, it expands to a more detailed summary."
     Translucent rather than a solid fill, because the elegance came from the fluid showing through.
     A backdrop blur lifts the ink off the moving sky without hiding it. */
  /* --card-tint is the PANE colour, and it must key off the SURFACE, not the ink ramp.
     The bug this fixes: the pane was color-mix(--paper 42%). In the dark theme --paper is #dfe3df — it
     is the INK colour there, not a surface — so the card rendered as a pale panel and the --ink-4 text
     on it (rgb(100,107,100)) measured almost illegible. Light stays a warm paper wash; dark becomes a
     lifted charcoal, so ink keeps its meaning in both. */
  .paper-card {
    --card-tint: #f3eee2;
    --card-tint-strength: 42%;
    --card-tint-hover: 56%;
    --card-sheen: rgba(255, 255, 255, 0.28);

    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
    scroll-margin-top: 12vh;
    padding: clamp(22px, 2.2vw, 32px) clamp(22px, 2.4vw, 36px);
    border-radius: 14px;
    border: 1px solid rgba(var(--hairline-rgb), 0.3);
    background: color-mix(in srgb, var(--card-tint) var(--card-tint-strength), transparent);
    -webkit-backdrop-filter: blur(9px) saturate(1.05);
    backdrop-filter: blur(9px) saturate(1.05);
    box-shadow: inset 0 1px 0 var(--card-sheen);
  }
  :global(html[data-theme='dark']) .paper-card {
    --card-tint: #2b3038;
    --card-tint-strength: 62%;
    --card-tint-hover: 76%;
    --card-sheen: rgba(255, 255, 255, 0.07);
  }
  @media (hover: hover) {
    .paper-card { transition: border-color .3s, background-color .3s, transform .3s cubic-bezier(.2,.7,.3,1); }
    .paper-card:hover {
      border-color: color-mix(in srgb, var(--ochre) 55%, transparent);
      background: color-mix(in srgb, var(--card-tint) var(--card-tint-hover), transparent);
      transform: translateY(-2px);
    }
  }
  .paper-card:focus-visible { outline: 2px solid var(--ochre); outline-offset: 3px; }

  /* paper masthead — inside the card; also the paper's own rail anchor */
  .paper-head { display: block; }
  .kicker { display: block; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ink-4); }
  .paper-title {
    display: block;
    font-family: var(--font-display); font-weight: 500; font-size: clamp(22px, 2.7vw, 31px);
    line-height: 1.18; color: var(--ink-1); margin: 14px 0 0; font-variation-settings: 'SOFT' 40; max-width: 40ch;
  }
  .byline { display: block; font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); letter-spacing: 0.02em; margin-top: 14px; }

  /* The card's summary — the one-line thesis and one number, so the card is a real preview rather than a title
     you must open to evaluate. It is no longer "the COLLAPSED card's summary": it is present in both states now,
     which is what keeps the card from changing size when a paper opens.
     It takes the ACCENT face, inheriting that from the in-panel copy this replaces. That copy was the only use of
     Fraunces on /research, and the page preloads Fraunces — so moving the accent here keeps the preload earning
     its bytes instead of downloading a face nothing on the page uses. */
  .card-takeaway {
    display: block;
    font-family: var(--font-accent); font-style: italic;
    font-size: clamp(16px, 1.5vw, 19px); line-height: 1.55;
    color: var(--ink-2); margin-top: 20px; max-width: 54ch;
  }
  .card-foot {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 24px; flex-wrap: wrap; margin-top: 22px;
  }
  .card-stat { display: flex; align-items: baseline; gap: 10px; }
  .card-stat-value { font-family: var(--font-mono); font-size: clamp(19px, 1.9vw, 24px); color: var(--ink-1); }
  .card-stat-label { font-size: 12.5px; color: var(--ink-4); max-width: 34ch; }
  .card-cue { display: inline-flex; align-items: center; gap: 9px; }
  /* The label follows aria-expanded rather than being written by the script, so the visible copy and
     the announced state cannot drift. */
  .card-cue-text { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ochre); }
  .paper-card[aria-expanded='false'] .card-cue-text::after { content: 'read the detail'; }
  .paper-card[aria-expanded='true'] .card-cue-text::after { content: 'close'; }
  /* A chevron drawn from a rotated border, so it costs no glyph and no asset. */
  .card-chevron {
    width: 7px; height: 7px; display: inline-block;
    border-right: 1.5px solid var(--ochre); border-bottom: 1.5px solid var(--ochre);
    transform: rotate(45deg) translateY(-1px);
    transition: transform .32s cubic-bezier(.2,.7,.3,1);
  }
  .paper-card[aria-expanded='true'] .card-chevron { transform: rotate(225deg) translateY(-1px); }
  /* Once open, the cue reads as the reverse action and the summary is redundant with the detail — but it has to
     LEAVE smoothly, and `display: none` is what made the fold feel wrong however well the panel itself animated.
     The owner: "the collapse/expand animation is not smooth for the research card." Measured frame by frame on
     open: the document went 1656 -> 1636 -> 1882 -> 2173 -> … so the page jerked 20px BACKWARDS on the first
     frame and then grew. That dip is exactly this line vanishing in one frame while the panel below it was still
     at 56px — two movements in opposite directions at the same moment, which reads as a stutter at the start of
     every expansion.
     Collapsing it over the same duration and easing as the panel makes the motion monotonic: one thing shrinks
     while a much larger thing grows, and the net travel is always downward. */
  /* NOTHING HIDES IT ANY MORE — the owner's call, and it is the simplification the fold needed:
     "i think it might be improved if you dont hide Allocation that learns instead of assuming stuff on expansion.
     so let's hold the card not move."
     Right on both counts. The card now keeps exactly its own size whether open or shut, so opening a paper moves
     ONE box — the panel below it — and nothing above the panel shifts at all. It also removes a second animating
     element from every frame of the fold.
     Two earlier versions of this were worse. `display: none` dropped the line in a single frame, which measured as
     a 20px jerk BACKWARDS in the document height at the exact moment the panel started growing. Collapsing it
     smoothly fixed the jerk but still meant two boxes animating in opposite directions for 400ms.
     The reason it was ever hidden was duplication: the same sentence rendered again inside "The idea". That copy
     is deleted instead, so the thesis appears exactly once, in the one place that is visible in both states. */

  /* two columns: LEFT (idea + formal math) is wider so equations show in full;
     RIGHT (results) is the narrower numeric column. */
  .paper-body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(32px, 3.4vw, 60px);
    align-items: start;
    margin-top: 5vh;
  }

  /* ── THE FOLD. The owner, twice: he wanted animation on the fold, and then that the animation was "not smooth
     at all, almost like a ppt". The box was already interpolating by then — measured, ~36 frames from 0 to
     769px — so the height was never the problem. What was missing was everything else:

     1. THERE WAS NO FADE, only a rectangular wipe, and that is the whole of the "ppt" read: type at full
        strength revealed by a growing shutter. A leftover `detail-in` keyframe animation from the previous
        implementation ran with `fill-mode: both`, and a filled animation OVERRIDES the element's own declared
        value — so `opacity: 0` on the closed panel never took effect and the fold's opacity transition could
        never start. Measured on a reduction of the old rules: computed opacity 1 while closed, and asking for
        the fade started 0 transitions. Deleted rather than disabled.
     2. THE CONTENT DID NOT MOVE, for the same reason — the same filled animation pinned `transform: none`. The
        two columns now fade and lift on their own timeline, which is what reads as unfolding rather than as a
        blind being raised.
     3. A DEEP LINK OPENED NOTHING. The pre-paint snippet exempted a deep-linked panel from the `hidden`
        attribute but not from the collapsing CSS, and revealFromHash then bailed out on a `hidden` test that
        the exemption had already made false. It now opens the panel outright and the guard tests `is-open`.

     A NOTE ON WHAT WAS NOT WRONG, since a plausible story sent me the wrong way first: collapsing with `hidden`
     (display:none) and setting the target height in the same task DOES still animate here — I tested the exact
     pattern and both it and a forced-reflow control started a transition. So the old `hidden` was not breaking
     the first open. It is gone anyway, because the CSS collapse gated on html.paper-js already did that job and
     the attribute only added a second mechanism to keep in sync.

     max-height rather than height because you cannot transition to or from `auto`, and rather than
     grid-template-rows 0fr->1fr because this element is ALREADY a two-column grid whose rows are load bearing.
     Animating a size is a deliberate exception to the transform/opacity-only rule: an accordion cannot be
     built without it, and this is one panel rather than a full-page layer. */
  .paper-body {
    --fold-ease: cubic-bezier(0.4, 0.02, 0.2, 1);
    overflow: hidden;
    /* contain tells the browser this panel's insides cannot affect layout or paint outside its box, so growing it
       need not re-examine or repaint its ancestors. It is a free win on an accordion — the panel is already an
       overflow: hidden clipper, so `contain` promises nothing that was not already true.
       Honest limit: this is NOT a measured fix for the choppiness the owner reports. Three instruments failed to
       see that at all (rAF cadence reports vsync; a screencast probe reported ~95fps even at 20x CPU throttle,
       which is impossible), and the main-thread cost measures cheap: 36ms of style and 25ms of layout across the
       whole 400ms animation at 6x throttle. So this is applied because it is correct, not because it is the cure. */
    contain: layout paint;
    max-height: 0;
    margin-top: 0;
  }
  /* No cap: the script sets max-height to the panel's OWN measured height, then clears it once the transition
     lands so later reflows are never clipped. A fixed generous cap was tried first and did not animate at all —
     measured, a 400vh cap against 795px of content reached full height inside 140ms of a 460ms transition,
     because the interpolation is over the CAP, not over the content. */
  .paper-body.is-open { margin-top: 5vh; }

  /* The two columns carry the fade and the lift, so the clip box is not the only thing moving. */
  .paper-body > * { opacity: 0; transform: translate3d(0, -10px, 0); }
  .paper-body.is-open > * { opacity: 1; transform: none; }

  /* NO-JS: the panel is never `hidden` in the markup, so without the script it must be fully readable rather
     than a collapsed sliver. html.paper-js is added by an inline script in the head of this page, before any
     .paper-body is parsed, so the collapsed state only ever applies once something can open it again — which
     is also why the pre-paint snippet no longer needs to touch the panels at all. */
  html:not(.paper-js) .paper-body { max-height: none; margin-top: 5vh; overflow: visible; }
  html:not(.paper-js) .paper-body > * { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: no-preference) {
    .paper-body {
      transition: max-height 400ms var(--fold-ease), margin-top 400ms var(--fold-ease);
    }
    /* CLOSING (the base rule): the content leaves first and fast, so it is gone before the box has finished
       shrinking — otherwise you watch text slide up behind a closing shutter. */
    .paper-body > * { transition: opacity 160ms ease, transform 220ms var(--fold-ease); }
    /* OPENING: the content arrives just behind the box, which is what reads as unfolding. The delay is on the
       open state only, so it applies in that direction and not on the way back. */
    .paper-body.is-open > * { transition: opacity 300ms ease 90ms, transform 420ms var(--fold-ease) 60ms; }
  }

  /* The guard is emitted INTO THE HTML by an inline head script (see BaseLayout's paper-collapse
     snippet), so it is present on the very first paint and absent when JS is off. Belt and braces:
     the cue is also hidden when nothing can respond to it. */
  :global(html.paper-js) .paper-card { cursor: pointer; }
  :global(html:not(.paper-js)) .card-cue { display: none; }
  :global(html:not(.paper-js)) .paper-card { cursor: default; }

  /* (The `detail-in` keyframe animation that used to live here is deleted, not disabled — see fault 2 in the
     note above the fold. Its fill-mode pinned opacity to 1 and silently outranked the fold's own transition.) */
  .paper-left, .paper-right { min-width: 0; }

  .block { scroll-margin-top: 12vh; }
  .block + .block { margin-top: 6vh; }
  .block h3 { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--ink-4); margin-bottom: 14px; }
  .block > p { font-size: 16px; line-height: 1.72; color: var(--ink-2); }

  /* (.takeaway is gone with the in-panel duplicate it styled — the thesis renders once, on the card. Deleted
     rather than left as unreachable CSS.) */

  /* formal-method equations — full size to match the body type, never folded */
  .math .eq { margin: 0 0 30px; }
  .math .eq:first-of-type { margin-top: 2vh; }
  .eq-math { color: var(--ink-1); overflow-x: auto; overflow-y: hidden; }
  .eq-math :global(math) { font-size: 1.18em; }            /* as prominent as the prose */
  .eq figcaption { font-size: 13px; line-height: 1.6; color: var(--ink-3); margin-top: 12px; }
  /* `.block > p` (specificity 0,4,2 once Astro adds its scope attributes) beats a
     bare `.math-foot` (0,2,1), so this footnote was rendering at the body size of
     16px instead of 10px — a caption set larger than the prose it annotates.
     Pre-existing (it is live on main today); scoped the same way as its sibling
     rules so it actually wins. */
  .block > .math-foot { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; color: var(--ink-4);
    margin-top: 6px; padding-top: 16px; border-top: 1px solid rgba(var(--hairline-rgb), 0.18); }

  /* results: stat strip + full table (right column) */
  /* Stat strip. minmax(140px…) not 120px: a word-value like "comparable" needs
     ~159px at 26px display type and was being clipped at 120. dt also wraps and
     balances rather than overflowing its cell, so a long value degrades to two
     lines instead of getting cut off. */
  .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 18px; margin: 2vh 0 4vh; }
  /* NO overflow-wrap: break-word here. It was added to stop "comparable" being
     clipped, but at 26px display type it splits the word itself ("comparabl" /
     "e") at most desktop widths — worse than the problem. The widened minmax is
     the actual fix; a value longer than its cell now overhangs into the 18px grid
     gap, which nothing clips. text-wrap: balance still evens out multi-WORD
     values across lines without ever breaking inside a word. */
  .result dt { font-family: var(--font-display); font-weight: 600; font-size: 26px; color: var(--ink-1); font-variation-settings: 'SOFT' 30;
    text-wrap: balance; }
  .result dd { margin: 8px 0 0; font-size: 12px; line-height: 1.5; color: var(--ink-3); }

  .metrics { margin: 0; }
  .metrics table { width: 100%; border-collapse: collapse; }
  .metrics th, .metrics td { text-align: right; padding: 8px 8px; font-family: var(--font-mono); font-size: 11.5px; }
  .metrics thead th { color: var(--ink-4); font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase;
    font-size: 9.5px; border-bottom: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .metrics .m-name { text-align: left; color: var(--ink-3); font-weight: 400; }
  .metrics tbody th.m-name { color: var(--ink-2); }
  .metrics tbody tr { border-bottom: 1px solid rgba(var(--hairline-rgb), 0.12); }
  .metrics td { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .metrics td.m-lead { color: var(--ink-1); font-weight: 500; } /* RL-BHRP column, foregrounded */
  .metrics tr.hl td.m-lead { color: var(--seal); }              /* headline metrics in the seal accent */
  .metrics figcaption { margin-top: 12px; font-size: 11px; font-style: italic; color: var(--ink-4); line-height: 1.5; }

  .links { margin-top: 4vh; display: flex; gap: 12px; flex-wrap: wrap; }
  .paper-link { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; text-decoration: none;
    color: var(--ink-1); border: 1px solid var(--ink-4); border-radius: 999px; padding: 8px 16px; transition: border-color 0.3s, color 0.3s; }
  .paper-link:hover { border-color: var(--seal); color: var(--seal); }

  .more { margin-top: 8vh; border-top: 1px solid rgba(var(--hairline-rgb), 0.25); padding-top: 4vh; scroll-margin-top: 12vh; }
  .more-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-4); margin-bottom: 2vh; }
  .entry { display: block; padding: 18px 0; border-top: 1px solid rgba(var(--hairline-rgb), 0.16); text-decoration: none; max-width: 620px; }
  .entry:first-of-type { border-top: 0; }
  .entry-meta { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); }
  .entry-title { font-size: 15px; font-weight: 500; color: var(--ink-1); margin-top: 8px; line-height: 1.4; }
  .entry:hover .entry-title { color: var(--seal); }
  .arr { color: var(--ochre); }
  .entry-venue { font-size: 12.5px; font-style: italic; color: var(--ink-3); margin-top: 4px; }

  .research-foot { padding: 10vh 0 16vh; }

  /* narrow / tablet: drop the rail; collapse to one column (idea → method →
     results, in reading order). */
  @media (max-width: 1100px) {
    /* (SideRail hides itself at this same breakpoint.) */
    .research-block { width: auto; margin: 0 auto; padding: 0 24px; max-width: 760px; }
    .paper-body { grid-template-columns: 1fr; gap: 0; }
    .paper-right { margin-top: 6vh; }
  }
  @media (max-width: 640px) {
    .interest-list { grid-template-columns: 1fr; gap: 22px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .paper, .more { animation: research-in 0.7s ease both; }
    @keyframes research-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  }
</style>

<script>
  // THE PAPER CARDS — click a card, it expands to the detailed summary.
  //
  // The owner's brief: the lucid paper card is "elegant… probably we will have many papers in the
  // future, so I guess it's fine to have that card in the research tab with fluid background. After
  // clicking on the card, it expands to a more detailed summary. I think that's the right shape."
  //
  // Progressive enhancement, in the safe direction: the detail ships fully OPEN in the markup, and the
  // collapse is CSS gated on `html.paper-js` — a class set by an inline script in this page's head. So a
  // reader whose JS never runs gets every paper in full, and a reader whose JS does run gets the card view on
  // the first frame with no flash. The content is never trapped behind a script that failed to load, which an
  // earlier version did manage: it shipped the panels `hidden` and put the fallback behind a class the script
  // itself added (measured with script execution disabled: 1 panel, 0 rendered).
  //
  // No React island (the terminal is the only one). Re-inits on astro:page-load with teardown.

  function initPapers(): (() => void) | null {
    const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-paper-toggle]'));
    if (!cards.length) return null;
    // The .paper-js class and the initial collapse are done by the inline snippets, before paint. This
    // module only wires behaviour; it must not re-derive the open/closed state or it would fight them.
    document.documentElement.classList.add('paper-js');

    const detailOf = (card: HTMLButtonElement): HTMLElement | null => {
      const id = card.getAttribute('aria-controls');
      return id ? document.getElementById(id) : null;
    };

    // One settle handler per panel at most. Held in a map rather than left to accumulate, because a stale one
    // was a real bug: closing a card BEFORE its open transition finished left the open's listener attached, the
    // close's own transitionend then fired it, and it set max-height back to `none` — so the panel sprang open
    // again as an empty gap. Reachable by double-clicking a card.
    const settling = new WeakMap<HTMLElement, (e: TransitionEvent) => void>();

    function setOpen(card: HTMLButtonElement, open: boolean): void {
      const detail = detailOf(card);
      if (!detail) return;
      card.setAttribute('aria-expanded', String(open));

      const stale = settling.get(detail);
      if (stale) {
        detail.removeEventListener('transitionend', stale);
        settling.delete(detail);
      }

      // MEASURE, then animate to that number, in BOTH directions — you cannot interpolate from or to `none`,
      // and a generous cap makes the panel snap instead of animating: 400vh against 795px of content finished
      // inside 140ms of a 460ms transition, because the interpolation is over the cap.
      if (open) {
        // `inert` first: it must be gone before the panel is measured, and before anything inside can be focused.
        detail.removeAttribute('inert');
        detail.removeAttribute('aria-hidden');
        detail.style.maxHeight = `${detail.scrollHeight}px`;
        detail.classList.add('is-open');
        // Once open, drop the cap so a resize or a font swap cannot clip the panel. Guarded on the class, so if
        // a close overtakes this open the cap is not restored on a panel that is meant to be shut.
        const done = (e: TransitionEvent) => {
          if (e.propertyName !== 'max-height' || e.target !== detail) return;
          detail.removeEventListener('transitionend', done);
          settling.delete(detail);
          if (detail.classList.contains('is-open')) detail.style.maxHeight = 'none';
        };
        settling.set(detail, done);
        detail.addEventListener('transitionend', done);
      } else {
        // A concrete starting height, committed with a forced reflow, or there is nothing to animate FROM.
        detail.style.maxHeight = `${detail.scrollHeight}px`;
        void detail.offsetHeight;
        detail.classList.remove('is-open');
        detail.style.maxHeight = '0px';
        // Out of the tab order and the accessibility tree, but only once it has finished closing — marking it
        // inert immediately would blur whatever is focused inside it mid-animation.
        const done = (e: TransitionEvent) => {
          if (e.propertyName !== 'max-height' || e.target !== detail) return;
          detail.removeEventListener('transitionend', done);
          settling.delete(detail);
          if (!detail.classList.contains('is-open')) {
            detail.setAttribute('inert', '');
            detail.setAttribute('aria-hidden', 'true');
          }
        };
        settling.set(detail, done);
        detail.addEventListener('transitionend', done);
      }
      // The side rail's rows follow what is actually rendered (see SideRail) and it re-measures on
      // scroll — but an expand is not a scroll, so nudge it, or the rail keeps the old rows until the
      // reader happens to move.
      window.dispatchEvent(new Event('scroll'));
    }

    const onClick = (e: Event) => {
      const card = e.currentTarget as HTMLButtonElement;
      const wasOpen = card.getAttribute('aria-expanded') === 'true';
      setOpen(card, !wasOpen);
      // Collapsing shortens the page, which can leave the viewport below the card and strand the
      // reader in blank space. Pull the card back into view when that has happened.
      if (wasOpen && card.getBoundingClientRect().top < 0) {
        card.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    };

    for (const card of cards) card.addEventListener('click', onClick);

    // DEEP LINKS AND THE RAIL: a URL like /research#r-p0-math points INSIDE a collapsed card, and an
    // anchor into hidden content silently does nothing — the reader would click a rail row or open a
    // shared link and see no movement at all. Open the owning card first, then jump.
    function revealFromHash(): void {
      const id = location.hash.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      const detail = target.closest<HTMLElement>('[data-paper-detail]');
      // Already open? Nothing to reveal. This used to test for the `hidden` attribute, which the fold no longer
      // uses — so the guard was always true and deep links silently stopped opening their card.
      if (!detail || detail.classList.contains('is-open')) return;
      const card = document.querySelector<HTMLButtonElement>(`[aria-controls="${detail.id}"]`);
      if (!card) return;
      setOpen(card, true);
      // The anchor has no real position until the panel is laid out.
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start', behavior: 'auto' }));
    }
    window.addEventListener('hashchange', revealFromHash);
    revealFromHash();

    // FOLDED BY DEFAULT, on the owner's instruction: "i want the research card to be folded by default."
    // An earlier version opened the first featured paper on load, reasoning that a wall of shut cards makes a
    // reader click before they can read anything. But the collapsed card already carries the title, the subject,
    // the takeaway and the headline numbers — enough to decide with — so opening one by default just picked a
    // winner on the reader's behalf. A deep link still opens its own card (revealFromHash, above).

    return () => {
      for (const card of cards) card.removeEventListener('click', onClick);
      window.removeEventListener('hashchange', revealFromHash);
    };
  }

  let papersTeardown: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    papersTeardown?.();
    papersTeardown = initPapers();
  });
</script>
