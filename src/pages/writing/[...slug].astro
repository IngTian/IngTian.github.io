---
// /writing/<slug> — ONE ROUTE FOR EVERY PIECE. The owner: "i want the writing to be flexible… My favorite quotes is
// just a markdown file." A new piece is a .md in src/content/writing/ and gets a page here for free.
//
// On the paper sheet, as /writing is (page="paper", no veil, no sky), with the index's margin and back link: the
// header (its kind, title, the blurb as its standfirst, its dates and computed reading time), its cover as a wide
// banner, the body, and at its foot the pieces either side of it in date order, as the index's cards.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cover from '../../components/writing/Cover.astro';
import PieceCard from '../../components/writing/PieceCard.astro';
import { KINDS, neighbours, pieces } from '../../data/writing';
import { longDate } from '../../lib/dates';

export async function getStaticPaths() {
  // Drafts get no page, as on the index: pieces() drops them (and throws on an entry that did not render).
  const entries = await getCollection('writing');
  const list = pieces(entries);
  const byId = new Map(entries.map((e) => [e.id, e]));
  return list.map((piece) => ({
    params: { slug: piece.slug },
    props: { piece, entry: byId.get(piece.slug)!, around: neighbours(list, piece.slug) },
  }));
}

const { piece: p, entry, around } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={`${p.title} — Ing Tian`} description={p.blurb} page="paper" veil={false}>
  <main class="wp">
    <article>
      <header class="wp-head">
        <a class="back" href="/writing">← writing</a>
        <p class="wp-kind">{KINDS[p.kind].label}</p>
        <h1 class="wp-h1">{p.title}</h1>
        <p class="wp-stand">{p.blurb}</p>
        <p class="wp-meta">
          <time datetime={p.date}>{longDate(p.date)}</time>
          {p.updated && <Fragment> · updated <time datetime={p.updated}>{longDate(p.updated)}</time></Fragment>}
          · {p.minutes} min read
        </p>
      </header>
      <div class="wp-banner"><Cover figure={p.figure} seed={p.slug} w={1200} h={360} banner /></div>
      <div class="wp-body"><Content /></div>
    </article>

    {(around.prev || around.next) && (
      <nav class="wp-around" aria-label="More writing">
        <ul role="list">
          {around.prev && <PieceCard piece={around.prev} dir="← Previous" />}
          {around.next && <PieceCard piece={around.next} dir="Next →" />}
        </ul>
      </nav>
    )}
  </main>
</BaseLayout>

<style>
  .wp { max-width: 1240px; margin: 0 auto; padding: 15vh clamp(22px, 5vw, 72px) 96px; font-family: var(--font-body); color: var(--ink-2); }
  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  .back:focus-visible { outline: 2px solid var(--ochre); outline-offset: 2px; border-radius: 2px; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }

  /* ── the header ── */
  .wp-head { max-width: 820px; }
  .wp-kind { display: inline-block; margin: 28px 0 0; padding: 4px 9px; font-size: 12px; font-weight: 500; line-height: 1;
    color: var(--ink-2); border: 1px solid rgba(var(--hairline-rgb), 0.35); border-radius: 999px; }
  .wp-h1 { margin: 18px 0 0; font: 800 clamp(36px, 4.6vw, 60px)/1.04 var(--font-body); letter-spacing: -0.03em; color: var(--ink-1);
    text-wrap: balance; }
  .wp-stand { margin: 18px 0 0; max-width: 34em; font-size: 20px; line-height: 1.5; color: var(--ink-3); text-wrap: pretty; }
  .wp-meta { margin: 18px 0 0; font: 12px/1.4 var(--font-mono); color: var(--ink-3); }
  .wp-banner { margin-top: 40px; }

  /* ── the body. <Content /> carries no scope attribute, so every rule reaches it through :global, under .wp-body
     (CLAUDE.md, Astro trap 1). Georgia, the sheet's reading face, on a ~68ch measure; the headings are the page's sans.
     Tailwind's preflight zeroes every margin and strips list markers, so a markdown element with no rule here is
     undifferentiated text, not a browser default. ── */
  .wp-body { max-width: 68ch; margin-top: 48px; font: 18px/1.65 var(--font-display); color: var(--ink-2); }
  .wp-body > :global(* + *) { margin-top: 1.1em; }
  .wp-body :global(h2) { margin-top: 2em; font: 700 24px/1.25 var(--font-body); letter-spacing: -0.015em; color: var(--ink-1); }
  .wp-body :global(h3) { margin-top: 1.7em; font: 700 19px/1.3 var(--font-body); letter-spacing: -0.01em; color: var(--ink-1); }
  .wp-body :global(h4) { margin-top: 1.7em; font: 12px/1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3); }
  .wp-body :global(em) { font-style: italic; }
  .wp-body :global(strong) { font-weight: 700; color: var(--ink-1); }
  /* a link keeps the body's ink and is told apart by its underline, as on the research routes */
  .wp-body :global(a) { color: inherit; text-decoration: underline 1px; text-decoration-color: var(--sheet-link);
    text-underline-offset: 0.18em; }
  .wp-body :global(a:focus-visible) { outline: 2px solid var(--ochre); outline-offset: 2px; border-radius: 2px; }
  @media (hover: hover) { .wp-body :global(a:hover) { color: var(--seal); } }
  .wp-body :global(ul) { padding-left: 1.3em; list-style: disc; }
  .wp-body :global(ol) { padding-left: 1.3em; list-style: decimal; }
  .wp-body :global(ul ul) { list-style: circle; }
  .wp-body :global(ol ol) { list-style: lower-alpha; }
  .wp-body :global(li + li), .wp-body :global(li > :is(ul, ol)) { margin-top: 0.4em; }
  .wp-body :global(li::marker) { color: var(--ink-3); }
  .wp-body :global(hr) { margin-block: 2.4em; border: 0; border-top: 1px solid rgba(var(--hairline-rgb), 0.35); }
  .wp-body :global(img) { display: block; max-width: 100%; height: auto; margin-inline: auto; border-radius: 2px; }
  .wp-body :global(figcaption) { margin-top: 10px; font: 14px/1.5 var(--font-body); color: var(--ink-3); }

  /* A quote is set apart by hairlines, larger and in italic. THE PARAGRAPH STRAIGHT AFTER A QUOTE IS ITS SOURCE, by
     position rather than by a class, so the markdown stays plain (the favourite quotes are written so): set to the
     right, on the owner's call, so the eye leaves the quote at its last line and finds the source there. The quote
     has no margin below, or the source would sit a quote's margin away from it. */
  .wp-body :global(blockquote) { margin-top: 1.8em; padding: 0.7em 0; font-size: 22px; line-height: 1.45; font-style: italic;
    color: var(--ink-1); border-block: 1px solid rgba(var(--hairline-rgb), 0.35); text-wrap: balance; }
  .wp-body :global(blockquote p + p) { margin-top: 0.5em; }
  .wp-body :global(blockquote + p) { margin-top: 0.85em; text-align: right; font: 12px/1.6 var(--font-mono); letter-spacing: 0.04em;
    color: var(--ink-3); }
  .wp-body :global(blockquote + p::before) { content: '— '; }
  .wp-body :global(blockquote + p strong) { font-weight: 400; color: var(--ink-1); }

  /* Code: Shiki writes its theme as INLINE style (a dark slab and a palette of token colours), and seal red is the
     only colour on the sheet, so a fence goes monochrome; inline style is beaten only by !important. Overflow scrolls
     inside the block, never the page. */
  .wp-body :global(code) { padding: 1px 5px; font: 0.86em var(--font-mono); background: rgba(var(--hairline-rgb), 0.1); border-radius: 3px; }
  .wp-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 14px 16px; font: 13px/1.6 var(--font-mono); tab-size: 2;
    border: 1px solid rgba(var(--hairline-rgb), 0.3); border-radius: 4px;
    background: rgba(var(--hairline-rgb), 0.06) !important; color: var(--ink-2) !important; }
  .wp-body :global(pre span) { color: inherit !important; }
  .wp-body :global(pre code) { padding: 0; font: inherit; background: none; }

  /* A table scrolls in its own box rather than widening the page; a column's GFM alignment (`align`) is kept. */
  .wp-body :global(table) { display: block; width: max-content; max-width: 100%; overflow-x: auto; border-collapse: collapse;
    font: 15px/1.45 var(--font-body); font-variant-numeric: tabular-nums; border-block: 1px solid rgba(var(--hairline-rgb), 0.6); }
  .wp-body :global(:is(th, td)) { min-width: 8ch; padding: 6px 16px 6px 0; vertical-align: baseline; }
  .wp-body :global(:is(th, td):not([align])) { text-align: left; }
  .wp-body :global(:is(th, td):last-child) { padding-right: 0; }
  .wp-body :global(thead th) { font-weight: 600; color: var(--ink-1); border-bottom: 1px solid rgba(var(--hairline-rgb), 0.35); }

  /* Maths is build-time MathML: inline in its paragraph, a display as a direct child (`$$`), which scrolls in its own
     box. Flush left, not centred: centred in a scroll box, an overflow's left half cannot be reached. */
  .wp-body :global(math) { color: var(--ink-1); }
  .wp-body > :global(.katex) { display: block; max-width: 100%; overflow-x: auto; overflow-y: hidden; padding: 0.3em 0; }
  .wp-body > :global(.katex math) { font-size: 1.1em; }

  /* GFM footnotes: the marks, and the notes under a hairline at the foot, in the page's sans. */
  .wp-body :global(sup) { font-size: 0.7em; line-height: 0; }
  .wp-body :global([data-footnote-ref]) { padding-inline: 1px; text-decoration: none; }
  .wp-body :global(.footnotes) { margin-top: 3em; padding-top: 14px; font: 15px/1.55 var(--font-body); color: var(--ink-3);
    border-top: 1px solid rgba(var(--hairline-rgb), 0.35); }
  .wp-body :global(.footnotes li + li) { margin-top: 0.5em; }
  .wp-body :global([data-footnote-backref]) { text-decoration: none; }

  /* ── the pieces either side: the index's cards (components/writing/PieceCard.astro), on its grid ── */
  .wp-around { margin-top: 96px; padding-top: 28px; border-top: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .wp-around ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 28px; }

  @media (max-width: 1100px) { .wp-around ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .wp { padding-top: 12vh; }
    .wp-body { font-size: 17px; }
    .wp-around ul { grid-template-columns: minmax(0, 1fr); gap: 44px; }
  }
</style>
