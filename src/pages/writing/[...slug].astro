---
// /writing/<slug> — ONE ROUTE FOR EVERY PIECE, now and later.
//
// The owner: "i want the writing to be flexible… My favorite quotes is just a markdown file." So this file is
// the last page anyone has to write for the writing section: a new piece is a .md in src/content/writing/ and
// it gets a page here for free.
//
// Composition is borrowed from /writing rather than invented: same left margin, same measure, same reading
// gradient, same back link. That page's own note is the reason — "three reading pages that each guessed their
// own margins would read as three sites" — and a piece and its index disagreeing would be the same fault at
// smaller scale.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FluidSky from '../../components/proto/FluidSky.astro';
import SkyWash from '../../components/SkyWash.astro';
import { KINDS } from '../../data/writing';

export async function getStaticPaths() {
  // Drafts get no page, matching the index. Committing an unfinished note must not publish it.
  const entries = (await getCollection('writing')).filter((e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The kind's label, so the piece says which section it belongs to and links back to it. Falls back to the raw
// key, which cannot happen while the schema's enum and KINDS agree — and a test asserts they do.
const kind = KINDS.find((k) => k.key === entry.data.kind);
const longDate = new Date(`${entry.data.date}T00:00:00Z`).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---
<BaseLayout
  title={`${entry.data.title} — Ing Tian`}
  description={entry.data.blurb}
  veilLine="a thinker in the margins"
  veilOnLoad={true}
  navZone="light"
>
  <main class="piece descent is-fluid">
    <FluidSky strength={3} variant="reading" />
    <SkyWash />

    <div class="piece-block">
      <header class="piece-head">
        <a class="back" href="/writing">← writing</a>
        <p class="piece-kicker">
          <a href={`/writing#${entry.data.kind}`}>{kind?.label ?? entry.data.kind}</a>
          <span aria-hidden="true">·</span>
          <time datetime={entry.data.date}>{longDate}</time>
          {entry.data.minutes && <><span aria-hidden="true">·</span><span>{entry.data.minutes} min</span></>}
        </p>
        <h1>{entry.data.title}</h1>
      </header>

      {/* The markdown, styled by .prose below. Nothing here knows what the piece contains — that is the point. */}
      <div class="prose"><Content /></div>

      <footer class="piece-foot">
        <a class="back" href="/writing">← writing</a>
        <a class="back" href="/">← the descent</a>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  .piece { position: relative; z-index: 0; min-height: 100vh; }
  .piece.descent { background: var(--reading-grad); }

  .piece-block {
    width: min(64%, 860px);
    margin-left: 34%;
    margin-right: clamp(24px, 4vw, 90px);
    box-sizing: border-box;
  }
  .piece-head { padding: 14vh 0 4vh; }
  .back {
    font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);
    text-decoration: none; letter-spacing: 0.04em;
  }
  .back:hover { color: var(--seal); }
  .piece-kicker {
    display: flex; gap: 10px; align-items: baseline; margin-top: 22px;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-4);
  }
  .piece-kicker a { color: var(--ink-3); text-decoration: none; }
  .piece-kicker a:hover { color: var(--seal); }
  .piece h1 {
    font-family: var(--font-display); font-weight: 500; font-size: clamp(34px, 4.4vw, 52px);
    line-height: 1.06; letter-spacing: -0.01em; font-variation-settings: 'SOFT' 60;
    margin-top: 14px; color: var(--ink-1); text-wrap: balance;
  }

  /* The prose style lives in the is:global block below, and it HAS to. See the note there. */

  .piece-foot { display: flex; gap: 20px; padding: 8vh 0 12vh; }

  /* Phone: the 34% left margin is a desktop composition — it leaves a 12ch measure at 390px. Matches how
     /writing and /projects collapse, so the reading pages stay one system. */
  @media (max-width: 900px) {
    .piece-block { width: auto; margin-left: clamp(24px, 7vw, 64px); margin-right: clamp(24px, 7vw, 64px); }
    .piece-head { padding-top: 12vh; }
  }
</style>

<!-- ── THE PROSE STYLE, AND IT MUST BE is:global. NOT a preference — the first version of this was a scoped
     block and NONE of it applied, which is why the owner saw a wall with no spacing and a quote that did not
     read as a quote. Astro scoped styles rewrite every selector with a [data-astro-cid-…] attribute, and the
     elements <Content /> emits are generated from markdown at build time, so they carry no such attribute.
     `.prose blockquote` became `.prose[cid] blockquote[cid]` and matched nothing. The repo's own guide warns
     about this attribute changing specificity; it also silently changes what a selector can REACH.
     Everything below is nested under .prose so going global cannot leak into the rest of the site. -->
<style is:global>
  /* Measure is 62ch. The block is 860px wide, which at 16px is about 110 characters — a line length nobody
     finishes. */
  .prose { max-width: 62ch; color: var(--ink-2); font-size: 16px; line-height: 1.75; }
  .prose > * + * { margin-top: 1.15em; }
  .prose > :first-child { margin-top: 0; }
  .prose h2 {
    font-family: var(--font-display); font-weight: 500; color: var(--ink-1);
    font-size: clamp(22px, 2.2vw, 28px); line-height: 1.2; margin-top: 2.4em;
  }
  .prose h3 {
    font-family: var(--font-accent); font-style: italic; color: var(--ink-1);
    font-size: clamp(18px, 1.7vw, 21px); margin-top: 2em;
  }
  .prose a { color: var(--ink-1); text-decoration: none; box-shadow: inset 0 -1px 0 0 var(--ochre); }
  .prose a:hover { color: var(--seal); }
  .prose strong { color: var(--ink-1); font-weight: 500; }
  .prose em { font-family: var(--font-accent); font-style: italic; }
  .prose code {
    font-family: var(--font-mono); font-size: 0.88em;
    background: color-mix(in oklab, var(--ink-5) 14%, transparent); padding: 1px 5px; border-radius: 3px;
  }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose li + li { margin-top: 0.4em; }
  .prose hr { border: 0; border-top: 1px solid var(--ink-5); margin: 2.6em 0; opacity: 0.5; }

  /* ── A QUOTE HAS TO LOOK LIKE A QUOTE. The owner: "i cant even read sometimes… to be a quote."
     The earlier attempt was a size bump and a left rule, which is what a callout looks like, not what a
     quotation looks like. This is a pull-quote: a hanging opening mark in ochre doing the announcing, the words
     in the display serif large enough to be the loudest thing in the column, and the attribution set as a
     separate register underneath — mono, small, em-dashed — so the eye never has to work out where the quote
     stops and the source begins.
     The mark HANGS in the left margin (negative offset inside padding that clears it) rather than sitting
     inline, so the quote's own first line stays flush with the prose above it and the block still reads as part
     of the column. Generous space above and below makes each quote a unit, which is what a collection needs. */
  .prose blockquote {
    position: relative;
    margin-top: 2.6em;
    padding-left: 2.6ch;
    font-family: var(--font-display);
    font-size: clamp(21px, 2.5vw, 27px);
    line-height: 1.42;
    letter-spacing: -0.008em;
    color: var(--ink-1);
    text-wrap: pretty;
  }
  .prose blockquote::before {
    content: '\201C';
    position: absolute;
    left: -0.28ch;
    top: -0.06em;
    font-family: var(--font-display);
    font-size: 2.5em;
    line-height: 1;
    color: var(--ochre);
    opacity: 0.5;
  }
  .prose blockquote p { margin: 0; }
  .prose blockquote p + p { margin-top: 0.5em; }

  /* THE PARAGRAPH IMMEDIATELY AFTER A QUOTE IS ITS SOURCE, styled by position rather than by a class, so the
     markdown stays a plain .md with nothing to remember and still renders correctly anywhere else. */
  .prose blockquote + p {
    margin-top: 1em;
    padding-left: 2.6ch;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.65;
    color: var(--ink-4);
    max-width: 52ch;
  }
  .prose blockquote + p::before { content: '— '; color: var(--ink-5); }
  .prose blockquote + p strong { color: var(--ink-2); font-weight: 400; }

  /* On a phone the hanging mark would sit outside the text column, so it comes inside and the quote loses the
     hang rather than the margin. */
  @media (max-width: 640px) {
    .prose blockquote { padding-left: 2ch; }
    .prose blockquote::before { left: -0.1ch; font-size: 2.1em; }
    .prose blockquote + p { padding-left: 2ch; }
  }
</style>
