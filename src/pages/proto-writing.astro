---
// PROTOTYPE (throwaway, claude/writing-proto): /writing as a searchable base on the paper sheet, after the 21st.dev
// "blog-3" reference the owner proposed (a featured lead, topic chips, a grid of cards), with computed covers
// (lib/protoCovers.ts) instead of photographs. The switcher picks the count (0, 3, 24 sample pieces), the view (the
// index or a piece) and the type (the reference's heavy sans, or the sheet's Georgia). Noindexed (/proto- path).
import BaseLayout from '../layouts/BaseLayout.astro';
import { PIECES, SAMPLE } from '../data/protoWriting';
import BaseIndex from '../components/proto-writing/BaseIndex.astro';
import BasePiece from '../components/proto-writing/BasePiece.astro';

const COUNTS = [0, 3, 24];
---
<BaseLayout title="Writing (prototype) — Ing Tian" description="Prototype of /writing." page="paper" veil={false}>
  <main class="pw">
    <p class="pw-note">Prototype — every piece here is a sample; none exists yet.</p>
    {COUNTS.map((n) => <div class="pw-view" data-view="index" data-count={n}><BaseIndex pieces={PIECES.slice(0, n)} /></div>)}
    <div class="pw-view" data-view="piece"><BasePiece piece={SAMPLE} /></div>

    <div class="pw-bar" role="group" aria-label="Prototype options">
      <span>pieces</span>
      {COUNTS.map((n) => <button type="button" data-k="count" data-v={String(n)}>{n}</button>)}
      <span>view</span>
      <button type="button" data-k="view" data-v="index">index</button>
      <button type="button" data-k="view" data-v="piece">piece</button>
      <span>type</span>
      <button type="button" data-k="type" data-v="sans">sans</button>
      <button type="button" data-k="type" data-v="serif">serif</button>
    </div>
  </main>
</BaseLayout>

<style>
  .pw { min-height: 100vh; padding-bottom: 96px; }
  .pw-note { margin: 0; padding: 10px 16px; text-align: center; font: 12px/1.4 var(--font-mono); color: var(--ink-3); }
  .pw-view { display: none; }
  :global(html[data-w-view='piece']) .pw-view[data-view='piece'],
  :global(html[data-w-view='index'][data-w-count='0']) .pw-view[data-view='index'][data-count='0'],
  :global(html[data-w-view='index'][data-w-count='3']) .pw-view[data-view='index'][data-count='3'],
  :global(html[data-w-view='index'][data-w-count='24']) .pw-view[data-view='index'][data-count='24'] { display: block; }
  .pw-bar { position: fixed; z-index: 60; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; flex-wrap: wrap;
    align-items: center; justify-content: center; gap: 2px; max-width: calc(100vw - 24px); padding: 4px;
    font: 12px/1 var(--font-mono); color: var(--ink-3); background: var(--sheet-ground);
    border: 1px solid rgba(var(--hairline-rgb), 0.3); border-radius: 8px; }
  .pw-bar span { padding: 0 6px 0 12px; }
  .pw-bar button { font: inherit; color: var(--ink-2); background: none; border: 0; padding: 8px 9px; border-radius: 5px; cursor: pointer; }
  .pw-bar button[aria-pressed='true'] { background: var(--seal); color: var(--on-accent); }
</style>

<script>
  // Each option is data-w-<key> on <html> (the components read data-w-type for the face); ?count=…&view=…&type=…
  // preset them. No sample piece has a page: a piece's link opens the sample piece, and "← writing" the index.
  const DEFAULTS: Record<string, string> = { count: '24', view: 'index', type: 'sans' };
  const html = document.documentElement;
  const set = (k: string, v: string): void => {
    html.setAttribute(`data-w-${k}`, v);
    document.querySelectorAll<HTMLButtonElement>(`.pw-bar [data-k="${k}"]`)
      .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
  };
  const q = new URLSearchParams(location.search);
  for (const k of Object.keys(DEFAULTS)) set(k, q.get(k) ?? DEFAULTS[k]);
  document.querySelectorAll<HTMLButtonElement>('.pw-bar button')
    .forEach((b) => b.addEventListener('click', () => { set(b.dataset.k ?? '', b.dataset.v ?? ''); scrollTo(0, 0); }));
  document.querySelector('main.pw')?.addEventListener('click', (e) => {
    const a = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a[href^="/writing"]') : null;
    if (!a) return;
    e.preventDefault();
    set('view', a.getAttribute('href') === '/writing' ? 'index' : 'piece');
    scrollTo(0, 0);
  });
</script>
