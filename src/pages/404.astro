---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlushCow from '../components/PlushCow.astro';
import { COW_LINES_404 } from '../data/cowGlyph';
import FluidSky from '../components/proto/FluidSky.astro';
import SkyWash from '../components/SkyWash.astro';
---
<BaseLayout
  title="Lost in the descent — Ing Tian"
  description="This page wandered off the path."
  veilLine="a researcher by day"
  veilOnLoad={false}
  noindex={true}
>
  <main class="notfound descent is-fluid">
    <FluidSky strength={4} variant="descent" />
    <SkyWash />
    <section class="nf-inner">
      <p class="nf-code">404</p>
      <h1 class="nf-title">You've descended past the edge of the map.</h1>
      <p class="nf-sub">There's no page here — but the path back is just a step up.</p>

      <!-- A COW ON THE 404. The owner asked for one, and a lost reader is exactly who could use the company.
           It goes above the links rather than below them, so the way out is still the last thing read. -->
      <div class="nf-cow">
        <PlushCow
          size="large"
          lines={COW_LINES_404}
          label="A cow, keeping you company on a page that does not exist. Press it."
        />
      </div>
      {/* ONE LINK, NOT SIX. There used to be a second row listing every page, driven from data/nav.ts — and the
          owner spotted that it was both unreadable and unnecessary: "in light theme, the bottom of the 404 page is
          illegible. i wonder if you need that at all. after all we have the hovering nav bar."
          Both halves are right. It was rendering the SAME `PAGES` array the corner nav renders, so it was exactly
          duplicate links a few hundred pixels below a nav that is always on screen. And it was illegible by
          construction: --ink-3 is a dark ink, while /404 rides the descent gradient into its dark half, so the row
          sat dark-on-dark in the light theme.
          What stays is the one link the corner nav does NOT offer — the way home. */}
      <nav class="nf-links">
        <a class="nf-primary" href="/">← back to the descent</a>
      </nav>
    </section>
  </main>
</BaseLayout>

<style>
  .notfound { position: relative; z-index: 0; min-height: 100vh; display: grid; place-items: center; }
  .nf-inner { max-width: 600px; padding: 0 28px; text-align: center; }
  .nf-code { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.4em; color: var(--ink-4); }
  .nf-title { font-family: var(--font-display); font-weight: 500; font-size: clamp(28px, 4.4vw, 44px);
    line-height: 1.16; letter-spacing: -0.01em; color: var(--ink-1); margin-top: 20px; font-variation-settings: 'SOFT' 50; }
  .nf-sub { font-size: 15px; line-height: 1.7; color: var(--ink-3); margin-top: 18px; }
  /* The primary button on its own row, the five page links centred beneath it. As one wrapping flex row the
     fifth link ("Art") broke onto a line by itself and read as an orphan — a stack of two intentional rows is
     better than one row that wraps at an accidental place, and it no longer changes shape as pages are added. */
  .nf-cow { margin: clamp(18px, 3vh, 36px) 0 clamp(4px, 1vh, 12px); }

  /* One row now, so no column stack and no wrap handling — the .nf-pages and .nf-link rules that lived here are
     deleted with the markup rather than left behind as unreachable CSS. */
  .nf-links { margin-top: 40px; display: flex; justify-content: center; }
  .nf-primary { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.04em; text-decoration: none;
    color: var(--ink-1); border: 1px solid var(--ink-4); border-radius: 999px; padding: 9px 20px; transition: border-color 0.3s, color 0.3s; }
  .nf-primary:hover { border-color: var(--seal); color: var(--seal); }

  /* ── PHONE: CLEAR THE NAV, AND NEVER OVERFLOW UPWARDS. ──
     Two things combined to make the headline's first line permanently unreadable on a phone. `place-items:
     center` centres the block, so when the content is TALLER than the viewport it overflows equally in both
     directions — and the top direction is unreachable, because no scroll position exists above 0. On an
     iPhone 14 the content wants 679px in a 664px viewport, so the first line sat above the fold, under the
     nav, with no way to bring it down. PR #49 had removed the phantom 120vh of scroll that was accidentally
     serving as the escape hatch, which is what turned an ugly overlap into an unreachable line.
     Padding fixes both at once: it guarantees clearance below the nav mark (12px offset + 38px tall + air),
     and because .notfound uses min-height rather than height, the box GROWS when the content plus padding
     exceeds the screen instead of centring the overflow off the top edge. The page then scrolls normally to
     reveal everything — while still having zero PHANTOM overflow, which is the property PR #49 established
     and which a test now guards. */
  @media (max-width: 640px) {
    /* Top padding only. A bottom pad would be scrollable space below the last line, and PR #49 established
       that this page has none of that — measured, it turned 11px of designed air into 39px. The nf-links
       margin already provides the air at the foot. */
    .notfound { padding-top: 62px; align-content: center; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nf-inner { animation: nf-in 0.8s ease both; }
    @keyframes nf-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  }
</style>
