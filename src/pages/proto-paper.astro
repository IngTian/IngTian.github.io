---
// PROTOTYPE ROUTE — revised after review. Two layers, not three:
//
//   base   paper editorial craft (letterpress, raised initial, marginalia,
//                                 hanging punctuation, richer paper material)
//   accent fluid modulation OVER the Monet gradient — combined, never replacing
//
// The layer stack, bottom → top:
//   --descent-grad (untouched) → FluidSky (overlay) → SkyWash → PaperTooth → content
//
// CUT in this revision, all three for measured reasons:
//   · MOTES — probed the live canvas: 370 lit pixels out of 3,454,560 (0.011%)
//     at max alpha 35/255, mean 6.7/255. depthGate + the light-theme gain + the
//     alpha multiplier stacked into nothing. The feature was running and
//     mathematically invisible, so it went rather than getting rescued.
//   · FOLIOS (I/II/III running heads) — the left-margin Toc already names the
//     section AND tracks it live; the folio was a static duplicate.
//   · PaperMountains — with motes and the folio gone the wrapper added nothing,
//     so Mountains is imported verbatim ("the mountain is fine").
//
// Fluid now defaults to strength 1: measured Δ 5.6/255 — visible, but the
// lightest rung that is. Level 2+ read as too strong.
import BaseLayout from '../layouts/BaseLayout.astro';
import Toc from '../components/Toc.astro';
import SkyWash from '../components/SkyWash.astro';
import PaperTooth from '../components/proto/PaperTooth.astro';
import FluidSky from '../components/proto/FluidSky.astro';
import PaperHeights from '../sections/proto/PaperHeights.astro';
import PaperInterlude from '../sections/proto/PaperInterlude.astro';
import Mountains from '../sections/Mountains.astro';
import Ground from '../sections/Ground.astro';
import Signature from '../sections/Signature.astro';
---

<BaseLayout
  title="PROTO — paper editorial + fluid sky"
  veilLine="a researcher by day"
  veilOnLoad={false}
  noindex={true}
>
  <main class="descent is-fluid">
    <FluidSky strength={4} />
    <SkyWash />
    <PaperHeights />
    <PaperInterlude />
    <Mountains />
    <Ground />
    <Signature />
  </main>
  <Toc />
  <PaperTooth />

  <!-- Prototype-only switches: the two remaining layers, plus the fluid strength
       rungs so the level can be judged in situ (not just on /proto-ladder). -->
  <div class="proto-panel" data-proto-panel>
    <p class="proto-title">layers</p>
    <button type="button" data-layer="paper" class="on">paper</button>
    <button type="button" data-layer="fluid" class="on">fluid</button>
    <p class="proto-title mt-1">warp</p>
    <div class="proto-row">
      {[0, 1, 2, 3, 4].map((n) => (
        <button type="button" data-level={String(n)} class:list={[n === 4 && 'on']}>{n}</button>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  /* NOTE: the .is-fluid / .fluid-live rules now live in global.css so every route
     shares one definition — see "The fluid sky, shared across every route" there. */

  .proto-panel {
    position: fixed;
    left: 14px;
    bottom: 14px;
    z-index: 9998;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 9px 10px 10px;
    border-radius: 9px;
    background: rgba(22, 20, 15, 0.72);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .proto-title {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 8.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(239, 233, 221, 0.5);
    margin: 0 0 2px;
  }
  .proto-panel button {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    padding: 4px 11px;
    border-radius: 20px;
    cursor: pointer;
    color: rgba(239, 233, 221, 0.45);
    background: transparent;
    border: 1px solid rgba(239, 233, 221, 0.22);
    transition: color 0.25s, border-color 0.25s, background-color 0.25s;
  }
  .proto-panel button.on {
    color: var(--on-accent);
    background: var(--ochre);
    border-color: var(--ochre);
  }
  .proto-row { display: flex; gap: 4px; }
  .proto-row button { padding: 3px 8px; }
  .mt-1 { margin-top: 5px; }
  @media (prefers-reduced-motion: reduce) {
    .proto-panel button { transition: none; }
  }
</style>

<script>
  // Prototype layer toggles: flip data-<layer>="off" on <html>; each component's
  // CSS has a matching :global(html[data-*='off']) kill-switch.
  function initProtoPanel(): void {
    const panel = document.querySelector<HTMLElement>('[data-proto-panel]');
    if (!panel) return;
    const levelBtns = Array.from(panel.querySelectorAll<HTMLButtonElement>('button[data-level]'));
    panel.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as HTMLElement;

      // layer on/off
      const layerBtn = target.closest<HTMLButtonElement>('button[data-layer]');
      if (layerBtn) {
        const key = layerBtn.dataset.layer;
        if (!key) return;
        const root = document.documentElement;
        const isOn = root.dataset[key] !== 'off';
        if (isOn) root.dataset[key] = 'off';
        else delete root.dataset[key];
        layerBtn.classList.toggle('on', !isOn);
        return;
      }

      // fluid strength rung
      const lvlBtn = target.closest<HTMLButtonElement>('button[data-level]');
      if (lvlBtn) {
        const v = lvlBtn.dataset.level;
        if (v === undefined) return;
        levelBtns.forEach((b) => b.classList.remove('on'));
        lvlBtn.classList.add('on');
        document.documentElement.dataset.fluidStrength = v;
      }
    });
  }
  document.addEventListener('astro:page-load', initProtoPanel);
</script>
