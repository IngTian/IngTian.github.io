---
// /proto-gate — INTERNAL. Six candidate gates, each built as a REAL full-screen gate rather than a thumbnail.
//
// The owner: "all your three doesn't read too well tbh. can u build all 4 as a real gate and let me see? we have
// so many ideas." Right on both counts. A 355px card cannot settle a full-bleed composition — the repo's own
// rule is that art must be SEEN and that small-detail screenshots are unjudgeable — and six separate ideas had
// accumulated across two companion screens with nowhere to see them at size.
//
// Every frame carries the real name, the real roles line and the real button at the real scale, on the real
// ground. The only thing that differs between frames is the drawing behind, and the ramp is the shipped one
// wherever a ramp applies. That is the "one variable" discipline this page earned the hard way: an earlier
// version compared four treatments that each chose their own count, spacing and projection, and the owner's
// verdict was "they are not even real comparisons."
import BaseLayout from '../layouts/BaseLayout.astro';
import { GATE_VIEW_H, GATE_VIEW_W } from '../lib/gatePaths';
import { COMB_DEFAULTS, trails } from '../lib/gateLines';
import { REF_VIEW_H, REF_VIEW_W, refTrails } from '../lib/gateRefPaths';
import { SHAPE_VIEW_H, SHAPE_VIEW_W, protoShapes } from '../lib/gateProtoShapes';
import { name, roles } from '../data/profile';

interface Frame {
  key: string;
  label: string;
  note: string;
  view: [number, number];
  /** Either a Trail list rendered as paths, or ready-made SVG children (the shapes need circles too). */
  paths?: { d: string; i: number; opacity: number; width: number }[];
  svg?: string;
}

const FRAMES: Frame[] = [
  {
    key: 'ref',
    label: 'The original (ported)',
    note: '72 paths — 36 per family, two mirrored families, the 21st.dev geometry transcribed exactly. The '
      + 'family CONVERGES (the offset enters the two halves with opposite sign) and its opacity ramps 0.1→1.0, '
      + 'so most strokes recede and you read about eight over a haze. Borrowed, not derived: someone else’s '
      + 'drawing, and it would need crediting if it ships.',
    view: [REF_VIEW_W, REF_VIEW_H],
    paths: refTrails(),
  },
  {
    key: 'comb',
    label: 'Combed contours (ships today)',
    note: `Iso-cost contours of the hero’s own loss field under a ${COMB_DEFAULTS.tilt} tilt. 8 strokes, ramp `
      + '0.10→0.80. No-knot is a theorem here rather than a tuning — but the tilt has to exceed the field’s '
      + 'maximum gradient, so it swamps the terrain, which is exactly why it reads parallel.',
    view: [GATE_VIEW_W, GATE_VIEW_H],
    paths: trails(),
  },
  ...protoShapes().map((s) => ({
    key: s.key,
    label: s.label,
    note: s.note,
    view: [SHAPE_VIEW_W, SHAPE_VIEW_H] as [number, number],
    svg: s.svg,
  })),
];

const letters = [...`${name.first} ${name.last}`];
---

<BaseLayout
  title="Gate candidates — internal"
  description="Internal prototype: six candidate first-visit gates, each at full size."
  veilOnLoad={false}
  noindex={true}
>
  <main class="pg">
    {/* A real, visually hidden h1. The page is full-bleed previews with no visible headline, and the name in
        each frame repeats once per frame so it cannot be the heading. distSmoke asserts exactly one per
        document and caught this page shipping zero. */}
    <h1 class="sr-only">Gate candidates — internal</h1>

    {FRAMES.map((f, i) => (
      <section class="pg-frame" data-variant={f.key} data-active={i === 0 ? 'true' : 'false'} aria-hidden={i !== 0}>
        {f.paths ? (
          <svg viewBox={`0 0 ${f.view[0]} ${f.view[1]}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            {f.paths.map((t) => (
              <path d={t.d} stroke-opacity={t.opacity} stroke-width={t.width} pathLength="1" />
            ))}
          </svg>
        ) : (
          <svg
            viewBox={`0 0 ${f.view[0]} ${f.view[1]}`}
            preserveAspectRatio="xMidYMid slice"
            aria-hidden="true"
            focusable="false"
            set:html={f.svg}
          />
        )}

        <div class="pg-text">
          <p class="pg-name">{letters.map((ch) => (ch === ' ' ? <span class="pg-sp"> </span> : <span>{ch}</span>))}</p>
          <p class="pg-roles">{roles}</p>
          <span class="pg-btn">enter the descent <span aria-hidden="true">→</span></span>
        </div>
      </section>
    ))}

    <nav class="pg-switch" aria-label="Candidate">
      {FRAMES.map((f, i) => (
        <button type="button" data-pick={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
      ))}
    </nav>

    <aside class="pg-info">
      {FRAMES.map((f, i) => (
        <p data-info={f.key} hidden={i !== 0} class="pg-note">{f.note}</p>
      ))}
    </aside>
  </main>
</BaseLayout>

<style>
  .pg { position: relative; min-height: 100vh; background: var(--bg); overflow: hidden; }

  .pg-frame {
    position: fixed; inset: 0; opacity: 0; pointer-events: none;
    display: flex; align-items: center; justify-content: center;
  }
  .pg-frame[data-active='true'] { opacity: 1; }
  /* No transition on purpose: an instant swap is what makes two frames comparable. A cross-fade blends them
     and hides exactly the difference being judged. */
  .pg-frame svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* :global because three of the six inject their children through set:html, so those nodes carry no scope
     attribute — the trap documented in CLAUDE.md. */
  .pg-frame :global(path) { stroke: var(--ochre); stroke-linecap: round; fill: none; }

  .pg-text { position: relative; text-align: center; padding: 0 7vw; }
  .pg-name {
    font-family: var(--font-display), Georgia, serif; color: var(--paper);
    font-size: clamp(44px, 9vw, 116px); line-height: .95; letter-spacing: -.02em; margin: 0;
  }
  .pg-name span { display: inline-block; }
  .pg-sp { width: .3em; }
  .pg-roles {
    font-family: var(--font-display), Georgia, serif; font-style: italic;
    color: color-mix(in srgb, var(--paper) 62%, transparent);
    font-size: clamp(15px, 2.2vw, 21px); margin: 18px 0 0;
  }
  .pg-btn {
    display: inline-block; margin-top: 34px; font-size: 12.5px; padding: 10px 18px; border-radius: 9999px;
    font-family: var(--font-mono), ui-monospace, monospace;
    color: color-mix(in srgb, var(--paper) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--ochre) 25%, transparent);
  }

  .pg-switch {
    position: fixed; left: 50%; bottom: 72px; transform: translateX(-50%);
    display: flex; gap: 7px; flex-wrap: wrap; justify-content: center; z-index: 5; max-width: 94vw;
  }
  .pg-switch button {
    font-family: var(--font-mono), ui-monospace, monospace; font-size: 10.5px;
    padding: 6px 11px; border-radius: 99px; cursor: pointer;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--ochre) 22%, transparent);
    backdrop-filter: blur(6px);
  }
  .pg-switch button[aria-pressed='true'] { color: var(--paper); border-color: var(--ochre); }

  .pg-info {
    position: fixed; left: 50%; bottom: 12px; transform: translateX(-50%);
    width: min(94vw, 900px); text-align: center; z-index: 5;
  }
  .pg-note {
    font-size: 11px; line-height: 1.5; margin: 0;
    color: color-mix(in srgb, var(--paper) 46%, transparent);
  }

  @media (max-width: 820px) {
    .pg-switch { bottom: 104px; }
    .pg-note { display: none; }
  }
</style>

<script>
  // Plain switcher, re-initialised on astro:page-load with a teardown, per the Interactivity contract.
  let dispose: (() => void) | null = null;

  function initProtoGate(): void {
    dispose?.();
    dispose = null;
    const nav = document.querySelector<HTMLElement>('.pg-switch');
    if (!nav) return;

    const pick = (key: string): void => {
      for (const f of document.querySelectorAll<HTMLElement>('.pg-frame')) {
        const on = f.dataset.variant === key;
        f.dataset.active = String(on);
        f.setAttribute('aria-hidden', String(!on));
      }
      for (const b of nav.querySelectorAll<HTMLButtonElement>('button')) {
        b.setAttribute('aria-pressed', String(b.dataset.pick === key));
      }
      for (const d of document.querySelectorAll<HTMLElement>('[data-info]')) {
        d.hidden = d.dataset.info !== key;
      }
    };

    const onClick = (e: Event): void => {
      const b = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('button[data-pick]');
      if (b?.dataset.pick) pick(b.dataset.pick);
    };

    const onKey = (e: KeyboardEvent): void => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const keys = [...nav.querySelectorAll<HTMLButtonElement>('button')].map((b) => b.dataset.pick ?? '');
      const cur = keys.findIndex((k) =>
        document.querySelector<HTMLElement>(`.pg-frame[data-variant="${k}"]`)?.dataset.active === 'true');
      const next = (cur + (e.key === 'ArrowRight' ? 1 : keys.length - 1)) % keys.length;
      const key = keys[next];
      if (key) pick(key);
    };

    nav.addEventListener('click', onClick);
    document.addEventListener('keydown', onKey);
    dispose = () => {
      nav.removeEventListener('click', onClick);
      document.removeEventListener('keydown', onKey);
    };
  }

  document.addEventListener('astro:page-load', initProtoGate);
</script>
