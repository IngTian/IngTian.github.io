---
// /proto-gate — INTERNAL. A sweep of the gate comb's TILT dial, one variable, everything else fixed.
//
// THIS PAGE USED TO COMPARE FOUR DIFFERENT LINE TREATMENTS AND THAT WAS A BAD COMPARISON. The owner:
// "your other 3 are horribly implemented they are not even real comparisons." Correct. Each of the four was
// built independently and chose its own stroke count, spacing, cut length and projection, so flipping between
// them varied four parameter sets at once — and `contour` differed from `comb` on TWO axes simultaneously
// (level-set geometry AND whether elevation was projected), which is confounded by construction. Comparing
// four things that differ in four ways tells you nothing about any one of them.
//
// Combed contours won, so what is left is a genuine single-variable question: how much tilt. lib/gateLines.ts
// is written by an agent that could measure the picture but never see it, and it said as much — "2.6 is my
// judgement call and I cannot see the result." Below, only `tilt` changes. Same field, same camera, same
// seed count, same axis, same knots, same ramp. That is a real comparison.
import BaseLayout from '../layouts/BaseLayout.astro';
import { GATE_VIEW_H, GATE_VIEW_W } from '../lib/gatePaths';
import { COMB_DEFAULTS, MAX_FIELD_GRAD, trails } from '../lib/gateLines';
import { name, roles } from '../data/profile';

// NOW SWEEPING THE STROKE COUNT, because that is the live question. The owner: "the problem with urs is that
// you got too many lines. maybe cut a few so that it's more elegant."
//
// Worth knowing while looking, because it reframes the count: the 21st.dev reference that started this draws
// THIRTY-SIX paths per family and renders the family twice, so seventy-two. It does not look busy because its
// opacity ramp runs 0.1 to 1.0 — most of its strokes are nearly invisible and you read maybe eight of them
// over a haze. Ours ramps 0.10 to 0.55, so every stroke sits in the same mid-range and all of them read at
// once. Count is one lever; the ramp is the other, and it may be the stronger one.
const COUNTS = [8, 12, 18, 30];

const FRAMES = COUNTS.map((seeds) => ({
  key: `n${seeds}`,
  seeds,
  isDefault: seeds === COMB_DEFAULTS.seeds,
  trails: trails({ seeds }),
}));

const letters = [...`${name.first} ${name.last}`];
---

<BaseLayout
  title="Gate comb — stroke-count sweep (internal)"
  description="Internal prototype: the gate comb's stroke count, swept with every other parameter held fixed."
  veilOnLoad={false}
  noindex={true}
>
  <main class="pg">
    {/* A real, visually hidden <h1>. The page is full-bleed previews with no visible headline, and the name
        inside each frame repeats once per frame — so it cannot be the heading. distSmoke asserts exactly one
        per document and caught this page shipping zero. */}
    <h1 class="sr-only">Gate comb — stroke-count sweep (internal)</h1>

    {FRAMES.map((f, i) => (
      <section class="pg-frame" data-variant={f.key} data-active={f.isDefault ? 'true' : 'false'} aria-hidden={!f.isDefault}>
        <svg viewBox={`0 0 ${GATE_VIEW_W} ${GATE_VIEW_H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          {f.trails.map((t) => (
            <path d={t.d} stroke-opacity={t.opacity} stroke-width={t.width} pathLength="1" />
          ))}
        </svg>
        <div class="pg-text">
          <p class="pg-name">{letters.map((ch) => (ch === ' ' ? <span class="pg-sp"> </span> : <span>{ch}</span>))}</p>
          <p class="pg-roles">{roles}</p>
        </div>
        <span class="pg-hidden-i">{i}</span>
      </section>
    ))}

    <nav class="pg-switch" aria-label="Stroke count">
      {FRAMES.map((f) => (
        <button type="button" data-pick={f.key} aria-pressed={f.isDefault ? 'true' : 'false'}>
          {f.seeds} lines{f.isDefault ? ' ·' : ''}
        </button>
      ))}
    </nav>

    <aside class="pg-info">
      {FRAMES.map((f) => (
        <div data-info={f.key} hidden={!f.isDefault}>
          <p class="pg-metrics">
            {f.trails.length} strokes · tilt {COMB_DEFAULTS.tilt} (fixed) · no-knot floor {MAX_FIELD_GRAD}
            {f.isDefault ? ' · what ships today' : ''}
          </p>
        </div>
      ))}
      <p class="pg-note">
        Only the <strong>stroke count</strong> changes between these — same field, same tilt, same axis, same
        ramp. For reference, the design this started from draws 36 per family and renders two families; it
        reads sparse because its opacity ramp runs 0.1&ndash;1.0 so most strokes recede, where ours runs
        0.10&ndash;0.55 and they all read at once. Arrow keys flip.
      </p>
    </aside>
  </main>
</BaseLayout>

<style>
  .pg { position: relative; min-height: 100vh; background: var(--bg); overflow: hidden; }

  .pg-frame {
    position: fixed; inset: 0; opacity: 0; pointer-events: none;
    display: flex; align-items: center; justify-content: center;
  }
  .pg-frame[data-active='true'] { opacity: 1; }
  .pg-frame svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pg-frame path { fill: none; stroke: var(--ochre); stroke-linecap: round; }
  /* No transition on purpose: an instant swap is what makes two nearly-identical frames comparable. A
     cross-fade blends them and hides exactly the difference you are trying to see. */
  .pg-hidden-i { display: none; }

  .pg-text { position: relative; text-align: center; }
  .pg-name {
    font-family: var(--font-display), Georgia, serif; color: var(--paper);
    font-size: clamp(44px, 9vw, 116px); line-height: .95; letter-spacing: -.02em; margin: 0;
  }
  .pg-name span { display: inline-block; }
  .pg-sp { width: .3em; }
  .pg-roles {
    font-family: var(--font-display), Georgia, serif; font-style: italic;
    color: color-mix(in srgb, var(--paper) 62%, transparent);
    font-size: clamp(15px, 2.2vw, 21px); margin: 18px 0 0;
  }

  .pg-switch {
    position: fixed; left: 50%; bottom: 76px; transform: translateX(-50%);
    display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; z-index: 5;
  }
  .pg-switch button {
    font-family: var(--font-mono), ui-monospace, monospace; font-size: 11px;
    padding: 7px 13px; border-radius: 99px; cursor: pointer;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--ochre) 22%, transparent);
    backdrop-filter: blur(6px);
  }
  .pg-switch button[aria-pressed='true'] { color: var(--paper); border-color: var(--ochre); }

  .pg-info {
    position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%);
    width: min(92vw, 820px); text-align: center; z-index: 5;
  }
  .pg-metrics {
    font-family: var(--font-mono), ui-monospace, monospace; font-size: 10.5px;
    color: color-mix(in srgb, var(--ochre) 80%, transparent); margin: 0 0 4px; letter-spacing: .04em;
  }
  .pg-note {
    font-size: 11.5px; line-height: 1.5; margin: 0;
    color: color-mix(in srgb, var(--paper) 46%, transparent);
  }

  @media (max-width: 820px) {
    .pg-switch { bottom: 112px; }
    .pg-note { display: none; }
  }
</style>

<script>
  // Plain switcher, re-initialised on astro:page-load with a teardown, per the Interactivity contract.
  let dispose: (() => void) | null = null;

  function initProtoGate(): void {
    dispose?.();
    dispose = null;
    const nav = document.querySelector<HTMLElement>('.pg-switch');
    if (!nav) return;

    const pick = (key: string): void => {
      for (const f of document.querySelectorAll<HTMLElement>('.pg-frame')) {
        const on = f.dataset.variant === key;
        f.dataset.active = String(on);
        f.setAttribute('aria-hidden', String(!on));
      }
      for (const b of nav.querySelectorAll<HTMLButtonElement>('button')) {
        b.setAttribute('aria-pressed', String(b.dataset.pick === key));
      }
      for (const d of document.querySelectorAll<HTMLElement>('[data-info]')) {
        d.hidden = d.dataset.info !== key;
      }
    };

    const onClick = (e: Event): void => {
      const b = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('button[data-pick]');
      if (b?.dataset.pick) pick(b.dataset.pick);
    };

    const onKey = (e: KeyboardEvent): void => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const keys = [...nav.querySelectorAll<HTMLButtonElement>('button')].map((b) => b.dataset.pick ?? '');
      const cur = keys.findIndex((k) =>
        document.querySelector<HTMLElement>(`.pg-frame[data-variant="${k}"]`)?.dataset.active === 'true');
      const next = (cur + (e.key === 'ArrowRight' ? 1 : keys.length - 1)) % keys.length;
      const key = keys[next];
      if (key) pick(key);
    };

    nav.addEventListener('click', onClick);
    document.addEventListener('keydown', onKey);
    dispose = () => {
      nav.removeEventListener('click', onClick);
      document.removeEventListener('keydown', onKey);
    };
  }

  document.addEventListener('astro:page-load', initProtoGate);
</script>
