---
// /art, on a still sheet: sentences in the owner's voice, taking turns, whose seal-red phrases each bring a work
// onto the mat beside them, then the calligraphy as object blocks, then every photograph in justified rows; any
// work opens full screen in the dark room. It borrows the research routes' paper register (page="paper"): no sky,
// no veil, no rail. Two things move on their own: a photograph's one fade as it arrives, and the sentences' turns,
// which a reader can pause (WCAG 2.2.2) and which stop once a work is taken. The works and the sentences are
// data/artworks.ts; their rules and holds, the label line and the three `sizes` hints are lib/artPage.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import { SENTENCES, calligraphy, photography } from '../data/artworks';
import {
  CAL_WIDTHS, PHOTO_WIDTHS, calSizes, labelLine, matSizes, phrasesOf, rowSizes, sentenceProblems,
} from '../lib/artPage';

// EACH WORK'S NATIVE-PIXEL WEBP AND ITS RATIO, from one getImage() call. The webp's URL is `zoom`, which every work
// carries as data-zoom, to be looked at closely (6x), so the pixels stay. It is the native variant <Image> emits
// anyway for its `src` (18.6 MB a browser with `srcset` never requests), so it adds no file. `ar`, its native width
// over its height, reserves the work's box before the image decodes (a tile's and a block's --ar, the dark room's
// data-ar) and sets the three `sizes` hints. The size is read off getImage()'s options, never off the ImageMetadata:
// Astro's import is a Proxy, and reading any property of it but `clone` or `fsPath` keeps the original in dist.
// Reading `.width`/`.height` kept all 44 JPEGs there (40,525,788 B, referenced by nothing); tests/distSmoke.test.ts
// fails if an original ships.
const zoomOf = async (src: ImageMetadata) => {
  const z = await getImage({ src, format: 'webp' });
  const { width: w, height: h } = z.options;
  if (!w || !h) throw new Error(`getImage() gave no native size for ${z.src}`);
  return { zoom: z.src, ar: w / h };
};

// The page's one list of works; a label prints only the fields its record knows (labelLine).
const photos = await Promise.all(photography.map(async (p) => ({
  ...p, kind: 'photo' as const, ...(await zoomOf(p.src)),
})));
const cals = await Promise.all(calligraphy.map(async (c) => ({
  ...c, kind: 'cal' as const, ...(await zoomOf(c.src)),
})));
const works = [...photos, ...cals];
type Work = (typeof works)[number];
const byKey = new Map(works.map((w) => [w.key, w]));

// The sentences' rules (lib/artPage.ts): a sentence that breaks one fails the build here, naming it.
const keys = new Set(byKey.keys());
const problems = SENTENCES.flatMap((s, i) => sentenceProblems(s, keys).map((x) => `sentence ${i + 1}: ${x}`));
if (problems.length) throw new Error(`art: ${problems.join('; ')}`);
// The mat holds each work the sentences name, once, in their order; the first sentence's first work is on it at
// arrival.
const matWorks = [...new Set(SENTENCES.flatMap((s) => phrasesOf(s).map((x) => x.work)))]
  .flatMap((k) => byKey.get(k) ?? []);
const first = phrasesOf(SENTENCES[0])[0].work;

// What every opener carries: the native webp, its ratio, the alt and the label's one line.
const darkData = (w: Work) => ({
  'data-zoom': w.zoom, 'data-ar': w.ar.toFixed(4), 'data-alt': w.alt, 'data-line': labelLine(w),
});
---
<BaseLayout
  title="Art — Ing Tian"
  description="Calligraphy and photography by Ing Tian (Zeying Tian)."
  page="paper"
  veil={false}
>
  <main class="art">
    <div class="art-wrap">
      <header class="art-head">
        <a class="back" href="/">← back</a>
        <h1>Art</h1>
      </header>

      <section class="opening" aria-label="Selected works">
        <div class="words">
          {/* A phrase is a link to its work's place on the page, so without a script it jumps there. The sentences
              share one cell, so the column is the tallest's height and nothing under it moves at a turn; the ones
              not shown are inert, out of the tab order and the accessibility tree. */}
          <div class="sentences">
            {SENTENCES.map((s, i) => (
              <p class:list={['sentence', { 'is-on': i === 0 }]} inert={i !== 0}>
                {s.map((x) => typeof x === 'string' ? x : (
                  <a class="phrase" href={`#${x.work}`} data-work={x.work} aria-controls="art-mat"
                     aria-current={x.work === first ? 'true' : undefined}>{x.text}</a>
                ))}
              </p>
            ))}
          </div>
          {/* There from first paint, so nothing under them moves when the script starts; CSS hides them where no
              script will work them. Only when there are turns to take. */}
          {SENTENCES.length > 1 && (
            <div class="turns" role="group" aria-label="Sentences">
              {SENTENCES.map((_, i) => (
                <button type="button" data-turn={i} aria-label={`Sentence ${i + 1}`}
                        aria-current={i === 0 ? 'true' : undefined}>{i + 1}</button>
              ))}
              <button type="button" class="turns-play">Pause</button>
            </div>
          )}
          <p class="sr-only" aria-live="polite" data-live></p>
        </div>
        <div class="stage" id="art-mat">
          {matWorks.map((w) => (
            <figure class:list={['mw', { 'is-on': w.key === first }]} data-work={w.key} hidden={w.key !== first}>
              <div class="mat">
                <button type="button" class:list={['mat-btn', w.kind === 'cal' && w.treatment]}
                        aria-label={`View full screen: ${w.alt}`} {...darkData(w)}>
                  {/* Only the first work is eager and high priority: it is /art's LCP. */}
                  <Image src={w.src} alt={w.alt} widths={w.kind === 'photo' ? PHOTO_WIDTHS : CAL_WIDTHS} sizes={matSizes(w.ar)}
                         loading={w.key === first ? 'eager' : 'lazy'} fetchpriority={w.key === first ? 'high' : undefined}
                         decoding="async" draggable="false" />
                </button>
              </div>
              <figcaption class="label">
                {w.title && <span class="l-title">{w.title}</span>}
                <dl>
                  {w.kind === 'photo' && w.place && <div><dt>Place</dt><dd>{w.place}</dd></div>}
                  {w.kind === 'photo' && w.year && <div><dt>Year</dt><dd>{w.year}</dd></div>}
                  {w.kind === 'cal' && <div><dt>Script</dt><dd>{w.script} · <span lang="zh-Hant">{w.scriptZh}</span></dd></div>}
                  <div><dt>Medium</dt><dd>{w.medium}</dd></div>
                </dl>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="room" id="calligraphy" aria-labelledby="cal-h">
        <h2 id="cal-h">Calligraphy</h2>
        {cals.map((w) => (
          <article class="obj" id={w.key} aria-label={w.title ? undefined : labelLine(w)}>
            <div class="obj-words">
              {w.titleZh && <p class="zh" lang="zh-Hant">{w.titleZh}</p>}
              {w.title && <h3>{w.title}</h3>}
              <dl>
                <div><dt>Script</dt><dd>{w.script} · <span lang="zh-Hant">{w.scriptZh}</span></dd></div>
                <div><dt>Medium</dt><dd>{w.medium}</dd></div>
                {w.note && <div><dt>Note</dt><dd>{w.note}</dd></div>}
              </dl>
            </div>
            <div class="obj-mat">
              <button type="button" class:list={['cal', w.treatment]} style={`--ar:${w.ar.toFixed(4)}`}
                      aria-label={`View full screen: ${w.alt}`} {...darkData(w)}>
                <Image src={w.src} alt={w.alt} widths={CAL_WIDTHS} sizes={calSizes(w.ar)} loading="lazy" decoding="async" />
              </button>
            </div>
          </article>
        ))}
      </section>

      <section class="room" id="photographs" aria-labelledby="ph-h">
        <h2 id="ph-h">Photographs</h2>
        <p class="count">{photos.length} photographs.</p>
        <div class="rows">
          {photos.map((w) => (
            <div class="tile" id={w.key} style={`--ar:${w.ar.toFixed(4)}`}>
              <button type="button" class="tile-btn" {...darkData(w)}>
                <span class="tile-mat">
                  <Image src={w.src} alt={w.alt} widths={PHOTO_WIDTHS} sizes={rowSizes(w.ar)} loading="lazy" decoding="async" />
                </span>
                {(w.title || w.place) && (
                  <span class="t-cap">{w.title && <span class="t-title">{w.title}</span>}{w.title && w.place && ' · '}{w.place}</span>
                )}
              </button>
            </div>
          ))}
        </div>
      </section>

      <footer class="art-foot"><a class="back" href="/">← back to the descent</a></footer>
    </div>

    {/* The dark room: one work full screen, opened by any work's button. Its src, alt, line and count are the
        script's, from the opener's data-*. */}
    <dialog class="dark" aria-label="The dark room: one work, full screen" aria-describedby="art-dark-line">
      <button type="button" class="d-btn d-close" aria-label="Close">✕</button>
      <img class="d-img" alt="" draggable="false" />
      <div class="d-bar">
        <p class="d-line" id="art-dark-line"></p>
        <span class="d-count" aria-hidden="true"></span>
        <div class="d-ctl">
          <button type="button" class="d-btn" data-zoom-by="out" aria-label="Zoom out">−</button>
          <button type="button" class="d-btn" data-zoom-by="in" aria-label="Zoom in">+</button>
          <button type="button" class="d-btn" data-step="-1" aria-label="Previous work">←</button>
          <button type="button" class="d-btn" data-step="1" aria-label="Next work">→</button>
          <button type="button" class="d-btn d-info" aria-pressed="true" aria-label="Show the label">i</button>
        </div>
      </div>
    </dialog>
  </main>
</BaseLayout>

<style>
  /* THE SHEET is the research routes' register (page="paper"), borrowed: its ground, inks and seal, in both themes.
     A mat is a faint tone of the sheet's own hairline ink, so it follows the theme with it. */
  .art { --mat: rgba(var(--hairline-rgb), 0.08); --mat-faint: rgba(var(--hairline-rgb), 0.05); min-height: 100vh; }
  .art-wrap { max-width: 1240px; margin: 0 auto; padding: 0 clamp(22px, 5vw, 72px); }
  .art-head { padding: 13vh 0 0; }
  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }
  .art h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(40px, 4.6vw, 60px); line-height: 1.04;
    letter-spacing: -0.01em; margin-top: 16px; color: var(--ink-1); }

  /* ── THE OPENING: words left, the work right; stacked at 900px and under, the shown sentence first, its numbers
     under it, then the mat, so a tap swaps the work just below the line being read and nothing scrolls. ──── */
  .opening { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; align-items: start; margin-top: 40px; }
  .sentence { font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.5;
    color: var(--ink-1); }
  .phrase { color: var(--ochre); text-decoration: none; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  @media (hover: hover) { .phrase:hover { text-decoration-line: underline; } }
  /* The current phrase is filled, as the Met marks its own: a seal block with --on-accent text, broken with the line
     it wraps across. */
  .phrase[aria-current] { background: var(--ochre); color: var(--on-accent); -webkit-box-decoration-break: clone;
    box-decoration-break: clone; }
  .phrase:focus-visible { outline: 2px solid var(--seal); outline-offset: 2px; border-radius: 1px; }
  /* The turns' controls: the numbers, the shown one in seal, then Pause; each at least 32px a side (WCAG 2.5.8: 24).
     Hidden where no script works them, and Pause where reduced motion leaves no turns to pause. */
  .turns { display: flex; align-items: center; gap: 2px; margin: 20px 0 0 -8px; font: 12px/1 var(--font-mono); }
  .turns button { min-width: 32px; height: 32px; padding: 0 8px; font: inherit; color: var(--ink-3); background: none;
    border: 0; cursor: pointer; }
  .turns button[aria-current] { color: var(--ochre); text-decoration: underline; text-underline-offset: 4px; }
  .turns .turns-play { margin-left: 10px; }
  .turns button:focus-visible { outline: 2px solid var(--seal); outline-offset: 2px; }
  @media (scripting: none) { .turns { display: none; } }
  @media (prefers-reduced-motion: reduce) { .turns-play { display: none; } }
  /* The mat's works and the sentences each stack in one cell, the shown one .is-on, by one cross-fade, ART.swap
     (lib/motionTiming.ts): the script hides a work it replaces after it, and a sentence not shown is inert. */
  .stage, .sentences { display: grid; }
  .mw, .sentence { grid-area: 1 / 1; margin: 0; opacity: 0; }
  .mw.is-on, .sentence.is-on { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .mw, .sentence { transition: opacity 300ms ease-out; } }
  .mat { height: min(62vh, 560px); padding: 24px; background: var(--mat); }
  .mat-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 0; border: 0;
    background: none; cursor: zoom-in; }
  .mat-btn :global(img) { display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; }
  .mat-btn:focus-visible, .cal:focus-visible, .tile-btn:focus-visible { outline: 2px solid var(--seal); outline-offset: 3px; }

  /* THE LABEL: dry and exact, "Label: value" lines in the body face; the title alone in Georgia. Its min-height is
     sized for the fullest case (a title and three rows), so a swap moves nothing. */
  .label { margin-top: 14px; min-height: 7.4em; font-size: 14px; line-height: 1.55; color: var(--ink-3); }
  .l-title { display: block; font-family: var(--font-display); font-size: 18px; line-height: 1.3; color: var(--ink-1); margin-bottom: 4px; }
  .art dl > div { display: flex; gap: 0.4em; }
  .art dt { color: var(--ink-1); font-weight: 600; }
  .art dt::after { content: ':'; }
  .art dd { margin: 0; }

  /* ── THE ROOMS ──────────────────────────────────────────────────────────────────────────────────── */
  .room { margin-top: 120px; padding-top: 28px; border-top: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .room h2 { font-family: var(--font-display); font-weight: 400; font-size: 28px; line-height: 1.2; color: var(--ink-1); }
  .count { margin-top: 8px; font-size: 14px; color: var(--ink-3); }

  /* The calligraphy: an object block each, words a 3 : 7 column beside the work on its mat. */
  .obj { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 7fr); gap: 48px; align-items: start; margin-top: 56px; }
  .obj-words { font-size: 15px; line-height: 1.6; color: var(--ink-3); }
  .zh { font-family: var(--font-display); font-size: 18px; color: var(--ink-2); }
  .obj h3 { font-family: var(--font-display); font-weight: 400; font-size: 28px; line-height: 1.2; color: var(--ink-1); margin: 4px 0 14px; }
  .obj-words dl { display: grid; gap: 6px; }
  .obj-mat { display: flex; justify-content: center; padding: 32px; background: var(--mat); }
  /* The block is the work's width at the height cap, from its ratio, and the image fills it, so its box exists before
     the image decodes (the note above CAL_MAX_H in lib/artPage.ts). No max-height on the image: on a 100%-wide one
     it would squash the work rather than narrow it. */
  .cal { width: min(100%, calc(var(--ar) * min(82vh, 820px))); padding: 0; border: 0; background: none; line-height: 0;
    cursor: zoom-in; }
  .cal :global(img) { display: block; width: 100%; height: auto; }
  /* No shadow (the Met's rule): the stele's black ground already stands off the pale mat, and a hairline edge keeps
     it off the dark mat too, as it does the work on paper. */
  .stele :global(img), .paper :global(img) { border: 1px solid rgba(var(--hairline-rgb), 0.25); }

  /* The photographs: rows of one height, each photograph whole on a faint mat, with at most one clipped line under
     it. The caption sits outside the row-height arithmetic, so a row with and without captions keeps one image
     height. With no script each tile is its photograph at --row-h, and the rows wrap ragged; the script justifies
     them. */
  .rows { --row-h: 280; --pad: 10px; display: flex; flex-wrap: wrap; column-gap: 16px; row-gap: 28px; margin-top: 28px; }
  .tile { flex: none; width: calc(var(--ar) * var(--row-h) * 1px + 2 * var(--pad)); }
  .tile-btn { display: block; width: 100%; padding: 0; border: 0; background: none; text-align: left; cursor: zoom-in; }
  .tile-mat { display: block; padding: var(--pad); background: var(--mat-faint); }
  .tile-mat :global(img) { display: block; width: 100%; height: auto; aspect-ratio: var(--ar); }
  /* A photograph fades in once, over ART.tileFade: the script marks a tile whose image has not loaded when it starts
     data-pending, and drops the mark on load or error. An image already loaded is not held, so it never flips; one
     still arriving, even partly painted, is held and fades in. The hold is screen-only, so a printout gets every
     photograph, and a held image's transition is none in every medium, so a printout's dropping of the hold is a
     snap rather than a fade it prints at 0. */
  @media (prefers-reduced-motion: no-preference) { .tile-mat :global(img) { transition: opacity 600ms ease-out; } }
  .tile[data-pending] .tile-mat :global(img) { transition: none; }
  @media screen and (prefers-reduced-motion: no-preference) { .tile[data-pending] .tile-mat :global(img) { opacity: 0; } }
  .t-cap { display: block; margin-top: 8px; font-size: 13px; line-height: 1.4; color: var(--ink-3); white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; }
  .t-title { color: var(--ink-1); font-weight: 400; text-underline-offset: 0.18em; }
  /* A hover underlines the title, where there is one, and dims the photograph a little, by opacity. */
  @media (hover: hover) {
    .tile-btn:hover .t-title { text-decoration: underline; }
    .tile .tile-btn:hover .tile-mat :global(img) { opacity: 0.85; }
  }
  .art-foot { padding: 120px 0 18vh; }

  @media (max-width: 900px) {
    .opening, .obj { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .obj-mat { order: -1; }
    .mat { height: min(45vh, 380px); padding: 16px; }
  }
  @media (max-width: 640px) {
    .sentence { font-size: 21px; }
    .mat { height: min(40vh, 320px); padding: 16px; }
    .obj-mat { padding: 16px; }
    .rows { --row-h: 150; --pad: 6px; column-gap: 10px; row-gap: 20px; }
  }

  /* ── THE DARK ROOM: an empty dark dialog, the work as large as fits, small square controls. It is #0a0a0c in both
     themes, so its inks are its own, declared here once and read by every room rule (tests/paperPalette.test.ts
     measures them on it). The page behind it does not scroll while it is open: the lock is on <html>, which no
     component declares, so it is written :global (trap 1). Astro 6 leaves it unscoped either way, measured, and
     tests/distSmoke.test.ts holds the shipped rule. ─────────────────────────────────────────────────────── */
  :global(html:has(dialog.dark[open])) { overflow: hidden; }
  .dark { --room: #0a0a0c; --room-ink: rgba(239, 233, 221, 0.8); --room-ink-2: rgba(239, 233, 221, 0.6);
    --room-edge: rgba(239, 233, 221, 0.45); --room-edge-hover: rgba(239, 233, 221, 0.85); --room-focus: #e0574a;
    --d-bar: 56px;
    border: 0; padding: 0; margin: 0; width: 100vw; height: 100dvh; max-width: 100vw; max-height: 100dvh;
    background: var(--room); color: var(--room-ink); overflow: hidden;
    /* The whole room, so a pinch that starts off the work (on the ground or the bar) never zooms the page. */
    touch-action: none; }
  .dark::backdrop { background: #0a0a0c; }
  /* The dialog is a container, not a control: a tap on the work focuses it, and the browser's ring would frame the
     whole room. Its controls keep their own (.d-btn:focus-visible). */
  .dark:focus { outline: none; }
  /* The work is centred in the band between the close button's 56px strip and the bar, so a tall work never runs
     under either, however unequal the two are (56 and 104 on a phone). */
  .dark[open] { display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 56px 0 var(--d-bar); }
  /* The box is the work's ratio, set as --ar by the script, so it exists before the image decodes, as a tile's does;
     its width is capped where its height reaches the band, so max-height never binds. Not width/height attributes:
     preflight's height: auto beats that hint, and a definite width over an auto height under a max-height squashes
     the work (CSS2.2 §10.7; the stele drew 3.17x too wide). Nor width: auto, which falls to 300x150 until the image
     decodes and then jumps. Before any --ar both var() declarations are invalid, so the max-* rules alone apply. */
  .d-img { aspect-ratio: var(--ar); width: min(calc(100vw - 32px), calc((100dvh - 56px - var(--d-bar)) * var(--ar)));
    max-width: calc(100vw - 32px); max-height: calc(100dvh - 56px - var(--d-bar)); transform-origin: 0 0; cursor: grab;
    will-change: transform; }
  .d-btn { width: 44px; height: 44px; flex: none; border: 1px solid var(--room-edge); background: var(--room);
    color: var(--room-ink); font: 15px/1 var(--font-mono); cursor: pointer; }
  @media (hover: hover) { .d-btn:hover { border-color: var(--room-edge-hover); } }
  .d-btn:focus-visible { outline: 2px solid var(--room-focus); outline-offset: 2px; }
  .d-close { position: fixed; top: 6px; left: 16px; z-index: 2; }
  /* The bar is a solid strip of the room's ground, so a zoomed work passes under it and never under the line. */
  .d-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 2; display: flex; align-items: center; gap: 8px;
    height: var(--d-bar); padding: 0 16px; background: var(--room); }
  .d-line { flex: 1; min-width: 0; font-size: 13px; line-height: 1.4; color: var(--room-ink);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dark[data-line-off] .d-line { visibility: hidden; }
  .d-count { font: 12px/1 var(--font-mono); color: var(--room-ink-2); margin-right: 4px; }
  .d-ctl { display: flex; gap: 8px; }
  .d-info[aria-pressed='false'] { color: var(--room-ink-2); }
  /* On a phone the bar takes two rows: the line, wrapped to at most two lines, with the count beside it, then the
     squares at the right. Five 44px squares and four 8px gaps are 252px, inside a 320px screen's 288; two 13px/1.4
     lines (36.4) + the 8px row gap + 44 + 2 x 6px of padding are 100.4px, inside the 104. */
  @media (max-width: 640px) {
    .dark { --d-bar: 104px; }
    .d-bar { flex-wrap: wrap; align-content: center; padding: 6px 16px; row-gap: 8px; }
    .d-line { flex: 1 1 0; white-space: normal; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
      line-clamp: 2; }
    .d-ctl { flex-basis: 100%; justify-content: flex-end; }
  }
</style>

<script>
  import { onPageView } from '../scripts/pageView';
  import { justifyRows } from '../lib/justify';
  import { prefersReducedMotion } from '../lib/motion';
  import { ART } from '../lib/motionTiming';
  import {
    DOUBLE_TAP, ZOOM, holdMs, isDoubleTap, wheelScale, zoomAbout, type Tap, type Zoom,
  } from '../lib/artPage';

  const LINE_KEY = 'art.dark-line';
  // The keys that zoom, by the factor each zooms by: 0 resets, as zoomAbout fits the work at any scale up to 1.
  const KEY_ZOOM = new Map([['+', ZOOM.key], ['=', ZOOM.key], ['-', 1 / ZOOM.key], ['_', 1 / ZOOM.key], ['0', 0]]);

  onPageView<HTMLElement>('main.art', (main) => {
    const reduce = prefersReducedMotion();
    const timers: number[] = [];

    // ── The opening: a phrase, clicked or focused, brings its work onto the mat. The new work is decoded first, so
    // the cross-fade never fades in an empty mat; a later phrase supersedes a swap still waiting.
    const phrases = Array.from(main.querySelectorAll<HTMLAnchorElement>('.phrase'));
    const figs = new Map(Array.from(main.querySelectorAll<HTMLElement>('.mw')).map((f) => [f.dataset.work ?? '', f]));
    const live = main.querySelector<HTMLElement>('[data-live]');
    let cur = main.querySelector<HTMLElement>('.mw.is-on')?.dataset.work ?? '';
    let seq = 0;
    // aria-current="true" or none: an empty value would read as false.
    const current = (el: Element, on: boolean): void => {
      if (on) el.setAttribute('aria-current', 'true'); else el.removeAttribute('aria-current');
    };
    const swap = (key: string, say = true): void => {
      const next = figs.get(key), prev = figs.get(cur);
      if (!next) return;
      // Any swap still waiting is dropped, and every work but the shown one and this one leaves the mat.
      const t = ++seq;
      figs.forEach((f, k) => { if (k !== cur && k !== key) { f.hidden = true; f.classList.remove('is-on'); } });
      if (key === cur) return;
      // Unseen until it is decoded, and out of reach while unseen.
      next.inert = true;
      next.hidden = false;
      const img = next.querySelector('img');
      if (img) img.loading = 'eager';
      (img ? img.decode() : Promise.resolve()).catch(() => {}).then(() => {
        if (t !== seq) return;
        cur = key;
        phrases.forEach((a) => current(a, a.dataset.work === cur));
        prev?.classList.remove('is-on');
        next.classList.add('is-on');
        if (prev) prev.inert = true;
        next.inert = false;
        // The polite live region reads the shown work's description, when the reader asked for it: a turn is not read.
        if (live && say) live.textContent = next.querySelector<HTMLElement>('.mat-btn')?.dataset.alt ?? '';
        const hide = (): void => { if (prev && cur !== prev.dataset.work) prev.hidden = true; };
        if (reduce) hide(); else timers.push(window.setTimeout(hide, ART.swap));
      });
    };
    phrases.forEach((a) => {
      const key = a.dataset.work ?? '';
      a.addEventListener('click', (e) => { e.preventDefault(); swap(key); });
      a.addEventListener('focus', () => swap(key));
    });

    // ── The turns: each sentence is shown for its words (holdMs), then the next, its first work brought onto the
    // mat. It is motion that starts on its own and lasts past five seconds, so WCAG 2.2.2 asks for a way to stop
    // it: Pause, and a number, which shows that sentence and stays. The pointer resting on the words holds the
    // turn, and a work taken (a phrase or the mat, clicked or focused) stops the turns until Play, so a turn never
    // hides what the reader is on. Under reduced motion they never start, and Pause is hidden; the numbers still work.
    const sentences = Array.from(main.querySelectorAll<HTMLElement>('.sentence'));
    const nums = Array.from(main.querySelectorAll<HTMLButtonElement>('[data-turn]'));
    // The controls are rendered only when there is more than one sentence.
    const play = main.querySelector<HTMLButtonElement>('.turns-play');
    if (play) {
      let shown = 0, timer = 0, held = false, playing = !reduce;
      const show = (i: number, say: boolean): void => {
        shown = i;
        sentences.forEach((s, k) => { s.classList.toggle('is-on', k === i); s.inert = k !== i; });
        nums.forEach((b, k) => current(b, k === i));
        const lead = sentences[i].querySelector<HTMLElement>('.phrase')?.dataset.work;
        if (lead) swap(lead, say);
      };
      const arm = (): void => {
        clearTimeout(timer);
        if (!playing || held) return;
        const next = (): void => { show((shown + 1) % sentences.length, false); arm(); };
        timer = window.setTimeout(next, holdMs(sentences[shown].textContent ?? ''));
        timers.push(timer);
      };
      const setPlaying = (p: boolean): void => { playing = p; play.textContent = p ? 'Pause' : 'Play'; arm(); };
      play.addEventListener('click', () => setPlaying(!playing));
      nums.forEach((b, k) => b.addEventListener('click', () => { setPlaying(false); show(k, true); }));
      const take = (e: Event): void => {
        if (e.target instanceof Element && e.target.closest('.phrase, .mat-btn')) setPlaying(false);
      };
      main.addEventListener('focusin', take);
      main.addEventListener('click', take);
      const words = main.querySelector<HTMLElement>('.words');
      words?.addEventListener('pointerenter', () => { held = true; arm(); });
      words?.addEventListener('pointerleave', () => { held = false; arm(); });
      setPlaying(playing);
    }

    // ── The dark room: a list of works (each opener carries data-zoom and the rest), stepped through by prev/next and
    // the arrow keys, with the label line under the work. Escape is the dialog's own.
    const dlg = main.querySelector<HTMLDialogElement>('dialog.dark');
    const img = dlg?.querySelector<HTMLImageElement>('.d-img');
    if (dlg && img) {
      let list: HTMLElement[] = [];
      let at = 0;
      let opener: HTMLElement | null = null;
      // The zoom, translate(x, y) scale(s) about the image's top-left: every open and every step starts at 1x, with
      // no pointer down and no tap before it. Every zoom goes through zoomAbout (lib/artPage.ts), then tf().
      let z: Zoom = { x: 0, y: 0, s: 1 };
      // The pointers down, by id: where each is now, where it went down, whether that was on the work, and whether it
      // ever took part in a pinch. `last` is the previous tap, for a double-tap.
      const pts = new Map<number, { x: number; y: number; x0: number; y0: number; onImg: boolean; multi: boolean }>();
      let last: Tap | null = null;
      const tf = (): void => { img.style.transform = `translate(${z.x}px,${z.y}px) scale(${z.s})`; };
      const show = (): void => {
        const el = list[at];
        if (!el) return;
        // The box is the work's ratio before it decodes (.d-img's rule says how).
        img.style.setProperty('--ar', el.dataset.ar ?? '');
        // BLANK IT FIRST, before the new src and before showModal(): set in the same tick over the old one, the
        // browser keeps painting the PREVIOUS work until the new one arrives, so every open after the first showed the
        // wrong work for the length of its fetch. No src paints nothing, which is honest, and the box from --ar keeps
        // that from shifting anything. Not `opacity: 0`: nothing the reader came for rests invisible, and a failed
        // decode would leave the room blank for good.
        img.removeAttribute('src');
        img.alt = el.dataset.alt ?? '';
        z = { x: 0, y: 0, s: 1 };
        tf();
        pts.clear();
        last = null;
        img.src = el.dataset.zoom ?? '';
        const line = dlg.querySelector('.d-line');
        if (line) line.textContent = el.dataset.line ?? '';
        const count = dlg.querySelector('.d-count');
        if (count) count.textContent = list.length > 1 ? `${at + 1} / ${list.length}` : '';
        dlg.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => { b.hidden = list.length < 2; });
      };
      const openList = (els: HTMLElement[], el: HTMLElement): void => {
        list = els;
        if (!list.length) return;
        at = Math.max(0, list.indexOf(el));
        show();
        if (!dlg.open) {
          // Safari does not focus a clicked button, so the opener is the element clicked unless focus is elsewhere.
          const a = document.activeElement;
          opener = a instanceof HTMLElement && a !== document.body ? a : el;
          dlg.showModal();
        }
      };
      const step = (d: number): void => { if (list.length > 1) { at = (at + d + list.length) % list.length; show(); } };
      // What each opener steps through: the mat, every work the sentences name, in their order (the mat's figures are
      // rendered in it); a block, both calligraphy works; a tile, every photograph.
      for (const sel of ['.mat-btn', '.cal', '.tile-btn']) {
        const els = Array.from(main.querySelectorAll<HTMLElement>(sel));
        els.forEach((b) => b.addEventListener('click', () => openList(els, b)));
      }
      // The label line, hidden or shown, is remembered for the session.
      const info = dlg.querySelector<HTMLElement>('.d-info');
      const setLine = (shown: boolean): void => {
        dlg.toggleAttribute('data-line-off', !shown);
        info?.setAttribute('aria-pressed', String(shown));
        try { sessionStorage.setItem(LINE_KEY, shown ? 'on' : 'off'); } catch { /* private mode: not remembered */ }
      };
      let stored: string | null = null;
      try { stored = sessionStorage.getItem(LINE_KEY); } catch { /* private mode */ }
      setLine(stored !== 'off');
      info?.addEventListener('click', () => setLine(dlg.hasAttribute('data-line-off')));
      dlg.querySelector('.d-close')?.addEventListener('click', () => dlg.close());
      dlg.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step))));
      // The ground closes it, and nothing else. A click goes to the nearest common ancestor of where the pointer went
      // down and where it came up, so a press that begins on the work or the bar and ends on the ground is a click on
      // the dialog too: only one that also began on the ground closes it, and only as a tap (the pointers, below).
      let downOnGround = false;
      dlg.addEventListener('pointerdown', (e) => { downOnGround = e.target === dlg; });
      dlg.addEventListener('click', (e) => { if (downOnGround && e.target === dlg) dlg.close(); });
      // Focus goes back to what opened it.
      dlg.addEventListener('close', () => { img.removeAttribute('src'); opener?.focus({ preventScroll: true }); opener = null; });
      // ── The zoom, to ZOOM.max. The keys and the squares zoom about the image's centre as fitted, the middle of the
      // room, however far the work is panned: zoomAbout's point is from the transformed top-left, which the pan has
      // moved by (z.x, z.y). The wheel, a gesture and a double-tap zoom about a point on the screen (zoomAt).
      const zoomBy = (f: number): void => {
        z = zoomAbout(z, z.s * f, img.offsetWidth / 2 - z.x, img.offsetHeight / 2 - z.y);
        tf();
      };
      const zoomAt = (s: number, cx: number, cy: number): void => {
        const r = img.getBoundingClientRect();
        z = zoomAbout(z, s, cx - r.left, cy - r.top);
        tf();
      };
      dlg.querySelectorAll<HTMLElement>('[data-zoom-by]').forEach((b) => b.addEventListener('click', () => {
        zoomBy(b.dataset.zoomBy === 'in' ? ZOOM.key : 1 / ZOOM.key);
      }));
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
        // With a modifier it is the browser's own zoom, which stays the reader's.
        const f = KEY_ZOOM.get(e.key);
        if (f === undefined || e.ctrlKey || e.metaKey || e.altKey) return;
        e.preventDefault();
        zoomBy(f);
      });
      // The wheel zooms about the cursor, by distance (wheelScale). Not passive, so a trackpad pinch's ctrl+wheel
      // never zooms the page.
      dlg.addEventListener('wheel', (e) => {
        e.preventDefault();
        zoomAt(z.s * wheelScale(e.deltaY, e.deltaMode), e.clientX, e.clientY);
      }, { passive: false });
      // Desktop Safari sends a trackpad pinch as WebKit's gesture events, not as ctrl+wheel, and touch-action does
      // nothing for a trackpad: unprevented, the pinch zooms the page, bar and all, and it stays zoomed after Escape.
      // So both are prevented, and each change scales the work by its own step of the gesture's scale, about the
      // cursor, so a clamp at 1x or 6x leaves no dead zone. iOS sends them for a touch pinch too, beside the pointers
      // that already zoom it (below), so with a pointer down they only prevent. GestureEvent is WebKit's alone and not
      // in lib.dom, so its three fields read here are typed here. Unverified in Safari when written (no Safari on the
      // machine): one trackpad pinch in the owner's pass is its check.
      type Gesture = Event & { scale: number; clientX: number; clientY: number };
      let gScale = 1;
      dlg.addEventListener('gesturestart', (e) => { e.preventDefault(); gScale = 1; });
      dlg.addEventListener('gesturechange', (e) => {
        e.preventDefault();
        const g = e as Gesture;
        if (!pts.size) zoomAt(z.s * g.scale / gScale, g.clientX, g.clientY);
        gScale = g.scale || gScale;
      });

      // ── Pointers, on the whole room but its buttons: two pinch the work about their midpoint, one pans it once it
      // is zoomed, and two taps on the work toggle 1x and 3x. Only the work captures a pointer: one captured on the
      // dialog would retarget its click there and close the room on every tap.
      // The pinch's last reading, the two pointers' distance and midpoint, re-read on every down, up and move: each
      // move scales by its own step, so a clamp at 1x or 6x leaves no dead zone, and lifting one finger of two pans on
      // with no jump.
      let pinch = { dist: 1, x: 0, y: 0 };
      const pair = (): { dist: number; x: number; y: number } => {
        const [a, b] = pts.values();
        return { dist: Math.hypot(b.x - a.x, b.y - a.y), x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      };
      const rebase = (): void => {
        if (pts.size < 2) return;
        pinch = pair();
        pts.forEach((p) => { p.multi = true; });
        last = null;
      };
      dlg.addEventListener('pointerdown', (e) => {
        if (e.button !== 0 || (e.target instanceof Element && e.target.closest('button'))) return;
        const onImg = e.target === img;
        if (onImg) img.setPointerCapture(e.pointerId);
        pts.set(e.pointerId, { x: e.clientX, y: e.clientY, x0: e.clientX, y0: e.clientY, onImg, multi: false });
        rebase();
      });
      dlg.addEventListener('pointermove', (e) => {
        const p = pts.get(e.pointerId);
        if (!p) return;
        const dx = e.clientX - p.x, dy = e.clientY - p.y;
        p.x = e.clientX;
        p.y = e.clientY;
        if (pts.size > 1) {
          // Pan by the midpoint's movement, then scale about where it now is: the point of the work that was under
          // the fingers stays under them. After the pan the top-left has moved as far as the midpoint has, so the
          // point, from the moved top-left, is the old midpoint from the old one. Two pointers within a pixel of each
          // other have no distance to scale by (a reading of 0 would snap the work to 1x, and a step from one under a
          // pixel would jump it to 6x), so a step either end of which reads under 1px only pans.
          const q = pair(), r = img.getBoundingClientRect();
          const k = q.dist >= 1 && pinch.dist >= 1 ? q.dist / pinch.dist : 1;
          z = zoomAbout({ x: z.x + q.x - pinch.x, y: z.y + q.y - pinch.y, s: z.s }, z.s * k,
            pinch.x - r.left, pinch.y - r.top);
          pinch = q;
          tf();
        } else if (z.s > 1) {
          z = { x: z.x + dx, y: z.y + dy, s: z.s };
          tf();
        }
      });
      const up = (e: PointerEvent): void => {
        const p = pts.get(e.pointerId);
        if (!p) return;
        pts.delete(e.pointerId);
        // A tap is a pointer that never pinched and went up within DOUBLE_TAP.px of where it went down. Anything else
        // was a drag or a pinch, which does not close the room even when it began and ended on the ground.
        const tap = e.type === 'pointerup' && !p.multi && Math.hypot(e.clientX - p.x0, e.clientY - p.y0) < DOUBLE_TAP.px;
        if (!tap) downOnGround = false;
        else if (p.onImg) {
          const t = { t: e.timeStamp, x: e.clientX, y: e.clientY };
          if (isDoubleTap(last, t)) {
            zoomAt(z.s > 1 ? 1 : ZOOM.toggle, t.x, t.y);
            last = null;
          } else last = t;
        }
        rebase();
      };
      dlg.addEventListener('pointerup', up);
      dlg.addEventListener('pointercancel', up);
    }

    // Leaving drops a swap still decoding, clears every timer (the next turn, and those that hide a replaced work),
    // and closes the dark room, which releases the scroll lock (its :has() stops matching).
    const stop = (): void => { seq += 1; timers.forEach((t) => clearTimeout(t)); if (dlg?.open) dlg.close(); };

    // ── The rows: justified at the stylesheet's --row-h, gap and --pad. A tile is its photograph's ratio times the
    // row's height, plus its mat; justifyRows takes the mat's padding into the gap and off the width, so every row
    // fills exactly. Widths are floored to 0.01px so a full row's sum never overflows into a wrap. W is the fractional
    // width (.rows has no padding or border): clientWidth rounds, and a column 921.6px wide (1024px window) read as 922
    // overflowed every row by ~0.4px, wrapping its last tile.
    const rows = main.querySelector<HTMLElement>('.rows');
    if (!rows) return stop;
    const tiles = Array.from(rows.querySelectorAll<HTMLElement>('.tile'));
    const ars = tiles.map((t) => parseFloat(t.style.getPropertyValue('--ar')) || 1);
    let lastW = 0;
    const layout = (): void => {
      const W = rows.getBoundingClientRect().width;
      if (!W || W === lastW) return;
      lastW = W;
      const cs = getComputedStyle(rows);
      const H = parseFloat(cs.getPropertyValue('--row-h'));
      const pad = parseFloat(cs.getPropertyValue('--pad'));
      const gap = parseFloat(cs.columnGap);
      justifyRows(ars, W - 2 * pad, H, gap + 2 * pad).forEach((r) => r.indices.forEach((i) => {
        tiles[i].style.width = `${Math.floor((ars[i] * r.height + 2 * pad) * 100) / 100}px`;
      }));
    };
    layout();
    const ro = new ResizeObserver(layout);
    ro.observe(rows);

    // ── The one fade: a tile whose image has not arrived when this starts is held (data-pending) until it loads or
    // errors, then fades in over ART.tileFade. An image already loaded is not held, so it never flips.
    tiles.forEach((t) => {
      const img = t.querySelector('img');
      if (!img || (img.complete && img.naturalWidth > 0)) return;
      t.setAttribute('data-pending', '');
      const done = (): void => t.removeAttribute('data-pending');
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    });

    return () => { ro.disconnect(); stop(); };
  });
</script>
