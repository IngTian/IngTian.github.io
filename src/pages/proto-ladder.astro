---
// PROTO LADDER — a diagnostic route, not a design proposal.
//
// Why this exists: the first tune landed BELOW the perceptual threshold. Measured
// against the shipped page, the content zone differed by a mean of 2.5/255 with
// only ~1.5% of pixels changed by more than 8 — literally invisible, which is
// why "I don't see the difference" was the correct read.
//
// You cannot calibrate an effect you can't see. So this page shows the same
// content at every fluid strength (including a deliberately TOO-STRONG ceiling),
// and the paper craft at 1× and 3× so the letterpress and typography are legible
// at all. Pick a level here; that becomes the shipped value.
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidSky from '../components/proto/FluidSky.astro';
import { name, roles, phd, rolesSub, bio } from '../data/profile';

let bioHtml = bio.text;
for (const phrase of bio.strong) {
  bioHtml = bioHtml.replace(phrase, `<strong class="font-medium text-ink-2">${phrase}</strong>`);
}

// Notes carry the MEASURED delta from level 0, so the numbers on screen are the
// real ones rather than my guesses.
const LEVELS = [
  { n: 0, label: 'off', note: 'the shipped sky — your current site' },
  { n: 1, label: 'subtle', note: 'op .30 · amp .30 · measured Δ 5.6/255' },
  { n: 2, label: 'medium', note: 'op .48 · amp .40 · measured Δ 13.2/255' },
  { n: 3, label: 'strong', note: 'op .68 · amp .78 · measured Δ 25.8/255' },
  { n: 4, label: 'too much', note: 'op .90 · amp 1.15 · measured Δ 78.5/255 — the ceiling' },
] as const;
---

<BaseLayout title="PROTO LADDER — calibrate the strength" veilOnLoad={false} noindex={true}>
  <div class="ladder-intro">
    <p class="li-kicker">Diagnostic</p>
    <h1 class="li-title">Find the level you can actually see</h1>
    <p class="li-body">
      You were right that there was no difference — but it wasn't a taste gap, it was a
      <strong>bug</strong>. The old build composited a mid-grey field with <code>soft-light</code>,
      which is near-identity: levels 1–3 all measured <strong>0.3–0.4/255</strong>, then
      jumped to 51 at level 4. A 110× cliff between neighbours is the signature of an effect
      that isn't compositing at all. Two more bugs sat behind it — <code>position: fixed</code>
      made all five panels cover the whole viewport, and a stray backtick in a comment silently
      broke the shader build. Now the ladder is monotonic:
      <strong>5.6 → 13.2 → 25.8 → 78.5</strong>. Scroll, then tell me the number that reads as
      <em>alive but still restrained</em>. Level 4 is meant to be too much.
    </p>
  </div>

  {LEVELS.map((lv) => (
    <section class="rung" data-rung={String(lv.n)}>
      <div class="rung-sky descent">
        <FluidSky strength={lv.n as 0 | 1 | 2 | 3 | 4} mode="contained" />
        <div class="rung-tag">
          <span class="rt-num">{lv.n}</span>
          <span class="rt-label">{lv.label}</span>
          <span class="rt-note">{lv.note}</span>
        </div>
      </div>
    </section>
  ))}

  <!-- ── Paper craft, shown at a size where it's actually visible ─────────── -->
  <section class="craft">
    <p class="li-kicker">Paper craft · why you couldn't see it</p>
    <h2 class="li-title">It's real, but it lives at 1–2px on text</h2>
    <p class="li-body">
      The letterpress, the raised initial, the rules — all operating at glyph scale while your
      eye reads a full-screen composition. Left is actual size; right is the same thing at 3×.
    </p>

    <div class="craft-grid">
      <div class="craft-cell">
        <p class="cc-label">actual size</p>
        <div class="craft-sheet">
          <p class="folio"><span class="folio-num">I</span><span class="folio-em">—</span><span>Heights</span></p>
          <div class="head-rule"></div>
          <h3 class="press">{name.first} <em>{name.last}</em></h3>
          <p class="press-role">{roles}</p>
          <p class="press-sub">{phd} &nbsp;·&nbsp; {rolesSub}</p>
          <p class="bio-prose" set:html={bioHtml}></p>
        </div>
      </div>

      <div class="craft-cell">
        <p class="cc-label">3× — the craft, legible</p>
        <div class="craft-sheet zoom">
          <p class="folio"><span class="folio-num">I</span><span class="folio-em">—</span><span>Heights</span></p>
          <div class="head-rule"></div>
          <h3 class="press">{name.first} <em>{name.last}</em></h3>
          <p class="press-role">{roles}</p>
          <p class="bio-prose short" set:html={bioHtml}></p>
        </div>
      </div>
    </div>
  </section>

  <!-- live strength override -->
  <div class="ladder-panel" data-ladder>
    <p class="lp-title">force all</p>
    {[0, 1, 2, 3, 4].map((n) => (
      <button type="button" data-force={String(n)}>{n}</button>
    ))}
    <button type="button" data-force="auto" class="on">auto</button>
  </div>
</BaseLayout>

<style>
  .ladder-intro {
    max-width: 62ch;
    margin: 0 auto;
    padding: 12vh 7vw 6vh;
  }
  .li-kicker {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase;
    color: var(--seal); margin: 0 0 0.9rem;
  }
  .li-title {
    font-family: var(--font-display), Georgia, serif;
    font-size: clamp(26px, 4vw, 40px); line-height: 1.18;
    color: var(--ink-1); margin: 0 0 1.1rem; font-weight: 500;
  }
  .li-body {
    font-family: var(--font-body), system-ui, sans-serif;
    font-size: 15px; line-height: 1.7; color: var(--ink-2); margin: 0;
  }
  .li-body strong { color: var(--ink-1); font-weight: 600; }

  /* Each rung is a tall slab carrying its own full descent gradient, so the
     fluid has the real sky to modulate rather than a flat swatch. */
  .rung { position: relative; }
  .rung-sky {
    position: relative;
    height: 72vh;
    overflow: hidden;
    isolation: isolate;   /* keep each rung's blend local to itself */
  }
  .rung-tag {
    position: absolute; left: 7vw; top: 50%; transform: translateY(-50%);
    z-index: 5; display: flex; align-items: baseline; gap: 0.9rem;
    flex-wrap: wrap; max-width: 80vw;
  }
  .rt-num {
    font-family: var(--font-display), Georgia, serif;
    font-size: clamp(48px, 7vw, 84px); line-height: 1;
    color: var(--ink-1); opacity: 0.9;
  }
  .rt-label {
    font-family: var(--font-display), Georgia, serif; font-style: italic;
    font-size: clamp(18px, 2.4vw, 26px); color: var(--ink-2);
  }
  .rt-note {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px; letter-spacing: 0.04em; color: var(--ink-3);
  }

  /* ── craft comparison ─────────────────────────────────────────────────── */
  .craft {
    max-width: 1100px; margin: 0 auto; padding: 12vh 7vw 16vh;
  }
  .craft-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 2.5rem;
    align-items: start;
  }
  @media (max-width: 900px) { .craft-grid { grid-template-columns: 1fr; } }
  .cc-label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--ink-4); margin: 0 0 0.7rem;
  }
  .craft-sheet {
    background: linear-gradient(178deg, #f4efe4, #f0eadf 60%, #ece4d6);
    padding: 26px 28px 30px;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(22,20,15,0.10),
      0 10px 30px -12px rgba(22,20,15,0.22),
      inset 0 0 60px rgba(90,84,74,0.06);
    overflow: hidden;
  }
  .craft-sheet.zoom { transform-origin: top left; }
  .craft-sheet.zoom > * { zoom: 2.1; }

  .folio {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 9.5px; letter-spacing: 0.26em; text-transform: uppercase;
    color: color-mix(in oklab, var(--ink-3) 82%, transparent);
    display: flex; align-items: center; margin: 0;
  }
  .folio-num { color: var(--seal); }
  .folio-em { margin: 0 0.7em; opacity: 0.5; }

  /* A real editorial head rule — heavier than a hairline border. */
  .head-rule {
    height: 2px; background: var(--ink-1); opacity: 0.8;
    margin: 8px 0 18px;
  }

  .press {
    font-family: var(--font-display), Georgia, serif;
    font-size: 44px; line-height: 0.92; letter-spacing: -0.025em;
    color: var(--ink-1); margin: 0; padding-bottom: 0.1em; font-weight: 500;
    text-shadow:
      0 1px 0    color-mix(in oklab, var(--paper) 92%, white),
      0 -1px 1px color-mix(in oklab, var(--ink-1) 26%, transparent),
      0 2px 4px  color-mix(in oklab, var(--ink-1) 10%, transparent);
  }
  .press em { font-style: italic; color: var(--ink-3); }
  .press-role {
    font-family: var(--font-display), Georgia, serif; font-style: italic;
    font-size: 15px; color: var(--ink-3); margin: 10px 0 0;
  }
  .press-sub {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase;
    color: color-mix(in oklab, var(--ink-3) 88%, transparent); margin: 6px 0 0;
  }
  .bio-prose {
    font-family: var(--font-body), system-ui, sans-serif;
    font-size: 12.5px; line-height: 1.62; color: var(--ink-2);
    margin: 18px 0 0; max-width: 46ch;
  }
  .bio-prose.short { max-width: 30ch; }
  /* the raised initial */
  .bio-prose::first-letter {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.9em; font-weight: 500; line-height: 1;
    color: var(--ink-1); vertical-align: -0.06em;
  }

  /* ── ladder control ───────────────────────────────────────────────────── */
  .ladder-panel {
    position: fixed; left: 14px; bottom: 14px; z-index: 9998;
    display: flex; align-items: center; gap: 5px;
    padding: 9px 11px; border-radius: 9px;
    background: rgba(22, 20, 15, 0.74);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .lp-title {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 8.5px; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(239, 233, 221, 0.5); margin: 0 4px 0 0;
  }
  .ladder-panel button {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px; padding: 4px 9px; border-radius: 20px; cursor: pointer;
    color: rgba(239, 233, 221, 0.5); background: transparent;
    border: 1px solid rgba(239, 233, 221, 0.22);
    transition: color 0.25s, border-color 0.25s, background-color 0.25s;
  }
  .ladder-panel button.on {
    color: var(--on-accent); background: var(--ochre); border-color: var(--ochre);
  }
  @media (prefers-reduced-motion: reduce) {
    .ladder-panel button { transition: none; }
  }
</style>

<script>
  // Force every rung to one strength (or back to its own), so a single level can
  // be judged across the whole gradient rather than in a 72vh slice.
  function initLadder(): void {
    const panel = document.querySelector<HTMLElement>('[data-ladder]');
    if (!panel) return;
    const btns = Array.from(panel.querySelectorAll<HTMLButtonElement>('button[data-force]'));
    panel.addEventListener('click', (e: MouseEvent) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-force]');
      if (!btn) return;
      const v = btn.dataset.force;
      if (!v) return;
      btns.forEach((b) => b.classList.remove('on'));
      btn.classList.add('on');
      if (v === 'auto') delete document.documentElement.dataset.fluidStrength;
      else document.documentElement.dataset.fluidStrength = v;
    });
  }
  document.addEventListener('astro:page-load', initLadder);
</script>
