---
// /writing — the writing as a base you can search, not a listing of everything. The owner: "a base you can search …
// we might have lots of writings". On the paper sheet, as the research routes are ("the background should be
// cleaner and more or less like the research panel feeling"): page="paper", no veil, no sky and no rail, since the
// search is its navigation. Sans for the structure, the owner's pick of the two prototyped ("i like sans").
//
// IT GROWS BY COUNT WITHOUT CHANGING LAYOUT. 0 pieces: the header and the cow. 1+: the lead (the newest featured
// piece, else the newest) and the cards of the rest. SEARCH_FROM+ (data/writing.ts): the controls between them, a
// search over each card's words and a chip per kind. The pieces come through pieces(), the one seam to the markdown.
import BaseLayout from '../layouts/BaseLayout.astro';
import PlushCow from '../components/PlushCow.astro';
import PieceCard from '../components/writing/PieceCard.astro';
import { getCollection } from 'astro:content';
import { CHARTER, KINDS, KIND_KEYS, SEARCH_FROM, leadAndRest, pieces } from '../data/writing';
import { COW_LINES_WRITING } from '../data/cowGlyph';

const list = pieces(await getCollection('writing'));
const n = list.length;
const { lead, rest } = leadAndRest(list);

// The CHARTER is the header: its first clause the headline, the rest the subtitle, so it is said once.
const [headline, ...tail] = CHARTER.split(' — ');
const sub = tail.join(' — ').replace(/^./, (c) => c.toUpperCase());

// A chip per kind that has a piece, with its count at build time; an empty kind has no chip.
const chips = KIND_KEYS.map((k) => ({ k, ...KINDS[k], count: list.filter((p) => p.kind === k).length })).filter((c) => c.count > 0);
---
<BaseLayout
  title="Writing — Ing Tian"
  description="Notes, explainers and methods by Ing Tian (Zeying Tian): working notes from the PhD reading in multi-period portfolio optimization, single ideas with the mathematics left in, and how a trading system is built and tested."
  page="paper"
  veil={false}
>
  <main class="wb">
    <header>
      <a class="back" href="/">← back</a>
      <p class="wb-badge">
        <svg viewBox="0 0 10 12" width="10" height="12" aria-hidden="true" focusable="false">
          <path d="M1.5 1h7v10L5 8.4 1.5 11z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
        </svg>
        Writing
      </p>
      <h1 class="wb-h1">{headline}.</h1>
      <p class="wb-sub">{sub}</p>
    </header>

    {/* Nothing published: a cow holding the space, the owner's ruling, rather than a scaffold of what will one day
        fill it. */}
    {n === 0 && (
      <div class="wb-cow">
        <PlushCow size="large" lines={COW_LINES_WRITING} label="A cow, holding the space until something is written here. Press it." />
      </div>
    )}

    {lead && <PieceCard piece={lead} lead />}

    {rest.length > 0 && (
      <section class="wb-more" aria-label="More writing">
        {n >= SEARCH_FROM && (
          <div class="wb-ctl">
            <div class="wb-chips" role="group" aria-label="Kinds">
              <button type="button" class="wb-chip" data-kind="all" aria-pressed="true">All <span class="wb-c">{n}</span></button>
              {chips.map((c) => (
                <button type="button" class="wb-chip" data-kind={c.k} aria-pressed="false" title={c.gloss}>{c.label} <span class="wb-c">{c.count}</span></button>
              ))}
            </div>
            <search class="wb-search">
              <label class="wb-field">
                <span class="sr-only">Search the writing</span>
                <svg class="wb-glass" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
                  <circle cx="6" cy="6" r="4.5" fill="none" stroke="currentColor" stroke-width="1.3" />
                  <path d="M9.4 9.4L13 13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                </svg>
                <input type="search" placeholder={`Search ${n} pieces`} autocomplete="off" spellcheck="false" />
                <kbd class="wb-kbd" aria-hidden="true">/</kbd>
              </label>
              <p class="wb-status" role="status">{n} of {n}</p>
            </search>
          </div>
        )}
        <ul class="wb-grid" role="list">
          {rest.map((p) => <PieceCard piece={p} />)}
        </ul>
        <p class="wb-none" hidden>No piece matches that search.</p>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .wb { max-width: 1240px; margin: 0 auto; padding: 15vh clamp(22px, 5vw, 72px) 96px; font-family: var(--font-body); color: var(--ink-2); }
  .wb :focus-visible { outline: 2px solid var(--ochre); outline-offset: 2px; border-radius: 2px; }
  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }

  /* ── the header: the badge, the headline, the subtitle ── */
  .wb-badge { display: inline-flex; align-items: center; gap: 8px; margin: 28px 0 0; padding: 6px 12px;
    font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-1);
    border: 1px solid rgba(var(--hairline-rgb), 0.4); border-radius: 999px; }
  .wb-h1 { margin: 18px 0 0; max-width: 15em; font: 800 clamp(40px, 5.4vw, 72px)/1 var(--font-body);
    letter-spacing: -0.035em; color: var(--ink-1); text-wrap: balance; }
  .wb-sub { margin: 20px 0 0; max-width: 36em; font-size: 19px; line-height: 1.5; color: var(--ink-3); text-wrap: pretty; }
  .wb-cow { margin-top: clamp(24px, 5vh, 56px); }
  .wb > :global(.wc-lead) { margin-top: 64px; }

  /* ── the controls (SEARCH_FROM+): chips, then the search. Without a script they do nothing, so they do not show,
     and every card does. ── */
  .wb-more { margin-top: 72px; padding-top: 28px; border-top: 1px solid rgba(var(--hairline-rgb), 0.3); }
  .wb-ctl { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 16px 32px; margin-bottom: 36px; }
  @media (scripting: none) { .wb-ctl { display: none; } }
  .wb-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .wb-chip { height: 34px; padding: 0 14px; font: 500 13px/1 var(--font-body); color: var(--ink-2); background: none; cursor: pointer;
    border: 1px solid rgba(var(--hairline-rgb), 0.4); border-radius: 999px; }
  .wb-c { margin-left: 4px; font: 11px/1 var(--font-mono); color: var(--ink-3); }
  @media (hover: hover) { .wb-chip:hover { border-color: var(--ink-1); } }
  .wb-chip[aria-pressed='true'] { color: var(--sheet-ground); background: var(--ink-1); border-color: var(--ink-1); }
  .wb-chip[aria-pressed='true'] .wb-c { color: inherit; opacity: 0.7; }
  .wb-search { flex: 0 1 320px; }
  .wb-field { position: relative; display: block; }
  .wb-field input { width: 100%; height: 38px; padding: 0 34px; font: 14px var(--font-body); color: var(--ink-1);
    background: var(--sheet-ground); border: 1px solid rgba(var(--hairline-rgb), 0.4); border-radius: 999px; }
  .wb-field input::placeholder { color: var(--ink-3); }
  .wb-field input:focus-visible { outline-offset: 2px; border-radius: 999px; }
  .wb-glass { position: absolute; left: 13px; top: 12px; color: var(--ink-3); pointer-events: none; }
  .wb-kbd { position: absolute; right: 12px; top: 10px; padding: 2px 6px; font: 11px/1 var(--font-mono); color: var(--ink-3);
    border: 1px solid rgba(var(--hairline-rgb), 0.35); border-radius: 4px; pointer-events: none; }
  .wb-field input:focus ~ .wb-kbd, .wb-field input:not(:placeholder-shown) ~ .wb-kbd { opacity: 0; }
  @media (hover: none) { .wb-kbd { display: none; } }
  .wb-status { margin: 8px 0 0; padding-left: 14px; font: 11px/1.4 var(--font-mono); color: var(--ink-3); }
  .wb-none { margin: 8px 0 0; font-size: 16px; color: var(--ink-3); }

  /* ── the cards (components/writing/PieceCard.astro): three columns, two from 1100px down, one on a phone ── */
  .wb-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 28px; }

  @media (max-width: 1100px) { .wb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .wb { padding-top: 12vh; }
    .wb-grid { grid-template-columns: minmax(0, 1fr); gap: 44px; }
    .wb-search { flex-basis: 100%; }
  }
</style>

<script>
  // The filter (SEARCH_FROM+ pieces): a chip picks a kind, the search AND-matches its words as substrings of each
  // card's data-q (lib/writingSearch's shows), and the status reads "k of N". A lead that does not match dims and goes
  // inert in place, so the controls under the reader's cursor never jump. Esc clears; "/" focuses the search unless
  // focus is already in a field. Through onPageView, so it answers the first keystroke before window `load`.
  import { onPageView } from '../scripts/pageView';
  import { shows } from '../lib/writingSearch';

  onPageView<HTMLElement>('.wb-ctl', (ctl) => {
    const root = ctl.closest('.wb');
    const maybeInput = ctl.querySelector<HTMLInputElement>('input[type="search"]');
    const maybeStatus = ctl.querySelector<HTMLElement>('[role="status"]');
    const maybeNone = root?.querySelector<HTMLElement>('.wb-none');
    if (!root || !maybeInput || !maybeStatus || !maybeNone) return undefined;
    const input = maybeInput, status = maybeStatus, none = maybeNone;
    const items = [...root.querySelectorAll<HTMLElement>('[data-q]')];
    const chips = [...ctl.querySelectorAll<HTMLButtonElement>('[data-kind]')];
    let kind = 'all';

    const apply = (): void => {
      let k = 0;
      for (const el of items) {
        const ok = shows(el.dataset.q ?? '', el.dataset.k ?? '', input.value, kind);
        if (el.classList.contains('wc-lead')) { el.classList.toggle('is-out', !ok); el.inert = !ok; }
        else el.hidden = !ok;
        if (ok) k += 1;
      }
      status.textContent = `${k} of ${items.length}`;
      none.hidden = k > 0;
    };
    const pick = (next: string): void => {
      kind = next;
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.kind === next));
      apply();
    };

    input.addEventListener('input', apply);
    for (const c of chips) c.addEventListener('click', () => pick(c.dataset.kind ?? 'all'));
    ctl.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || (!input.value && kind === 'all')) return;
      e.preventDefault();
      input.value = '';
      pick('all');
    });
    // The one listener outside the swapped <body>: the rest leave with it.
    const ac = new AbortController();
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey || !input.getClientRects().length) return;
      const t = e.target;
      if (t instanceof HTMLElement && (t.isContentEditable || t.closest('input, textarea, select'))) return;
      e.preventDefault();
      input.focus();
    }, { signal: ac.signal });
    return () => ac.abort();
  });
</script>
