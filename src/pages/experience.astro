---
// /experience — the full record, one wide panel per organisation: its mark, name, tagline and span; its roles and
// facts; what the work was. The incoming PhD leads, then research, then engineering newest first, then the degree:
// the site's identity hierarchy is load-bearing (CLAUDE.md, Identity & voice). It borrows the paper register
// (page="paper", as /art does): no sky, no veil.
//
// Each mark is the organisation's logo as pixel cells (data/experienceMarks.ts), drawn in the sheet's inks; a
// panel's hover or focus cross-fades it into the logo's own colours and fades the same mark in, enlarged, behind
// the panel. Both are CSS, by opacity (EXPERIENCE in lib/motionTiming.ts); the page has no script.
//
// The facts come from data/profile.ts (organisations, and the timeline's roles, which name their organisation),
// so editing the record means editing data, never this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import SideRail from '../components/SideRail.astro';
import { awards, organisations, timeline } from '../data/profile';
import { MARKS } from '../data/experienceMarks';
import { REPRO } from '../data/papers/rl-bhrp';
import { chartRows, orgPeriod, runs } from '../lib/experience';
import { experienceSectionId, experienceStops } from '../lib/pageStops';

const N = 24;
const panels = organisations.map((o) => {
  const roles = timeline.filter((t) => t.org === o.key);
  if (!roles.length) throw new Error(`experience: ${o.key} has no role in the timeline`);
  const mark = MARKS[o.key];
  if (!mark) throw new Error(`experience: ${o.key} has no mark in data/experienceMarks.ts`);
  const rows = mark.rows ?? chartRows(REPRO.rl, N);
  // The logo's colours as custom properties: --b<role> on the light sheet, --b<role>-d on the dark.
  const brand = (['k', 'm', 's'] as const)
    .flatMap((r) => [mark.brand.light[r] && `--b${r}:${mark.brand.light[r]}`, mark.brand.dark[r] && `--b${r}-d:${mark.brand.dark[r]}`])
    .filter(Boolean).join(';');
  return { ...o, roles, period: orgPeriod(roles.map((r) => r.period)), cells: runs(rows), n: rows.length, brand };
});
const orphans = timeline.filter((t) => !organisations.some((o) => o.key === t.org));
if (orphans.length) throw new Error(`experience: no organisation for ${orphans.map((t) => `${t.role} (${t.org})`).join(', ')}`);
---
<BaseLayout
  title="Experience — Ing Tian"
  description="The full record — roles and education. Incoming PhD in Operations Research at the University of Toronto; quantitative research and ML systems at Electronic Arts, TikTok, Amazon and Ericsson AI Lab."
  page="paper"
  veil={false}
>
  <main class="xp">
    <SideRail stops={experienceStops(organisations)} />
    <div class="xp-wrap">
      <header class="xp-head">
        <a class="back" href="/">← back</a>
        <h1>Experience</h1>
        <p class="lede">The full record. Research first, engineering second — the order they matter in, not the order they happened.</p>
      </header>

      <div class="panels">
        {panels.map((p) => (
          <article class="panel" id={experienceSectionId(p.key)} aria-labelledby={`${experienceSectionId(p.key)}-name`} style={p.brand}>
            <svg class="ground brand" viewBox={`0 0 ${p.n} ${p.n}`} shape-rendering="crispEdges" aria-hidden="true"
                 preserveAspectRatio="xMaxYMid meet">
              {p.cells.map((r) => <rect class={r.c} x={r.x} y={r.y} width={r.w} height="1" />)}
            </svg>
            <div class="who">
              {/* The mark twice over, in the sheet's inks (.ink) and in the logo's colours (.brand), cross-faded. */}
              <svg class="mark" viewBox={`0 0 ${p.n} ${p.n}`} shape-rendering="crispEdges" aria-hidden="true">
                {(['ink', 'brand'] as const).map((g) => (
                  <g class={g}>{p.cells.map((r) => <rect class={r.c} x={r.x} y={r.y} width={r.w} height="1" />)}</g>
                ))}
              </svg>
              <h2 id={`${experienceSectionId(p.key)}-name`}>{p.name}</h2>
              <p class="tag">{p.tagline}</p>
              <p class="when">{p.period}</p>
            </div>
            <dl class="facts">
              {p.roles.map((r) => (
                <div>
                  <dt>{r.kind === 'education' ? 'Degree' : 'Position'}</dt>
                  <dd>{r.role}{p.roles.length > 1 && `, ${r.period}`}</dd>
                </div>
              ))}
              {p.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.href
                    ? <a href={f.href} {...(f.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{f.value}</a>
                    : f.value}</dd>
                </div>
              ))}
            </dl>
            <div class="what">
              {p.roles.map((r) => <p>{p.roles.length > 1 && <strong>{r.role}. </strong>}{r.detail}</p>)}
            </div>
          </article>
        ))}
      </div>

      <section class="recog" id="x-recognition" aria-labelledby="x-recognition-h">
        <h2 id="x-recognition-h">Recognition</h2>
        <ul>
          {awards.map((a) => (
            <li><span class="year">{a.year}</span><span>{a.title}{a.gloss && <span class="gloss"> · {a.gloss}</span>}</span></li>
          ))}
        </ul>
      </section>

      <footer class="xp-foot"><a class="back" href="/">← back to the descent</a></footer>
    </div>
  </main>
</BaseLayout>

<style>
  .xp { min-height: 100vh; --panel: rgba(var(--hairline-rgb), 0.045); --panel-edge: rgba(var(--hairline-rgb), 0.16); }
  .xp-wrap { max-width: 1480px; margin: 0 auto; padding: 13vh clamp(22px, 5vw, 72px) 14vh; }
  /* Clears SideRail where it shows (it hides at 1100px and below), as /projects does: the rail's longest labels
     here ("Independent", "Recognition") are as long as /projects' "The workshop". */
  @media not all and (max-width: 1100px) { .xp-wrap { padding-left: clamp(190px, 13vw, 230px); } }
  .back { font: 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--seal); } }
  /* The reference's heavy grotesk, in the system UI face: no webfont. */
  .xp-head h1 { margin: 18px 0 0; font: 800 clamp(56px, 8vw, 120px)/0.95 var(--font-body); letter-spacing: -0.035em;
    text-transform: uppercase; color: var(--ink-1); }
  .lede { margin: 18px 0 0; max-width: 52ch; font-size: 16px; line-height: 1.6; color: var(--ink-3); }

  /* ── THE PANELS: the organisation, its facts, what the work was, in three columns; two at 1100px and under (the
     work under both), one at 640px. */
  .panels { display: grid; gap: 8px; margin-top: 56px; }
  .panel { position: relative; overflow: hidden; display: grid; gap: 40px;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.15fr) minmax(0, 1.9fr);
    padding: 44px 40px; background: var(--panel); border: 1px solid var(--panel-edge); border-radius: 14px; }
  .panel > :not(.ground) { position: relative; }

  /* A mark is 24 cells at 3px. */
  .mark { display: block; width: 72px; height: 72px; margin-bottom: 18px; }
  .ink .k { fill: var(--ink-1); }
  .ink .m { fill: var(--ink-3); }
  .ink .s { fill: var(--seal); }
  /* The logo's colours, from the panel's --b* (the sheet's ink where a role has none). */
  .brand .k { fill: var(--bk, var(--ink-1)); }
  .brand .m { fill: var(--bm, var(--ink-3)); }
  .brand .s { fill: var(--bs, var(--seal)); }
  :global(html[data-theme='dark']) .brand .k { fill: var(--bk-d, var(--bk, var(--ink-1))); }
  :global(html[data-theme='dark']) .brand .m { fill: var(--bm-d, var(--bm, var(--ink-3))); }
  :global(html[data-theme='dark']) .brand .s { fill: var(--bs-d, var(--bs, var(--seal))); }

  .who h2 { margin: 0; font: 700 clamp(30px, 2.6vw, 44px)/1.05 var(--font-body); letter-spacing: -0.02em; color: var(--ink-1); }
  .tag { margin: 14px 0 0; font-size: 15px; color: var(--ink-2); }
  .when { margin: 6px 0 0; font: 13px/1.4 var(--font-mono); color: var(--ink-3); }

  .facts { margin: 6px 0 0; display: grid; gap: 14px; align-content: start; }
  .facts > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; }
  .facts dt { font-size: 14px; color: var(--ink-3); }
  .facts dd { margin: 0; font-size: 14.5px; font-weight: 600; color: var(--ink-1); }
  .facts a { color: inherit; text-underline-offset: 3px; }
  @media (hover: hover) { .facts a:hover { color: var(--seal); } }
  .facts a:focus-visible { outline: 2px solid var(--seal); outline-offset: 2px; }

  .what p { margin: 0 0 14px; max-width: 62ch; font-size: 15.5px; line-height: 1.62; color: var(--ink-2); }
  .what p:last-child { margin-bottom: 0; }
  .what strong { font-weight: 600; color: var(--ink-1); }

  /* ── THE HOVER, opacity only, on a pointer's hover or a keyboard's focus inside the panel: the mark cross-fades
     from ink into its colours (EXPERIENCE.mark), and the enlarged mark fades in behind the panel's right side
     (EXPERIENCE.ground). Under reduced motion both change at once. */
  .mark .brand { opacity: 0; }
  .ground { position: absolute; right: -4%; top: -12%; height: 124%; width: auto; aspect-ratio: 1; opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .mark g { transition: opacity 320ms ease-out; }
    .ground { transition: opacity 420ms ease-out; }
  }
  .panel:focus-within .mark .brand { opacity: 1; }
  .panel:focus-within .mark .ink { opacity: 0; }
  .panel:focus-within .ground { opacity: 0.14; }
  @media (hover: hover) {
    .panel:hover .mark .brand { opacity: 1; }
    .panel:hover .mark .ink { opacity: 0; }
    .panel:hover .ground { opacity: 0.14; }
  }

  .recog { margin-top: 12vh; max-width: 900px; }
  .recog h2 { margin: 0 0 12px; font: 12px/1 var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); }
  .recog ul { list-style: none; margin: 0; padding: 0; }
  .recog li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--panel-edge);
    font-size: 15px; color: var(--ink-2); }
  .recog .year { font: 13px/1.5 var(--font-mono); color: var(--ink-3); }
  .recog .gloss { color: var(--ink-3); }
  .xp-foot { margin-top: 14vh; }

  @media (max-width: 1100px) {
    .panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .what { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .panel { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 28px 22px; }
    .facts > div, .recog li { grid-template-columns: 6rem 1fr; }
  }
</style>
